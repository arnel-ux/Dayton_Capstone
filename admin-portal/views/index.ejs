        function renderClusterTabs() {
            const tabsWrap = document.getElementById('clusterTabs');
            tabsWrap.innerHTML = serviceClusters.map((cluster, i) => `
                <button type="button" class="cluster-tab-btn${i === activeClusterIndex ? ' active' : ''}" data-index="${i}">
                    <i class="fas ${cluster.icon}"></i> ${cluster.label}
