        Chart.register({
            id: 'centerText',
            beforeDraw: function(chart) {
                if (chart.config.type !== 'doughnut' || !chart.config.options.elements.center) return;
                var width = chart.width, height = chart.height, ctx = chart.ctx;
                ctx.restore();

                // The chart cards now float directly on the hero photo/gradient (no
                // opaque card background), which is always dark — so chart text
                // always uses the light-on-dark palette, independent of the site's
                // light/dark toggle.
                var isDark = true;
                var fontSize = (height / 200).toFixed(2);
                ctx.textBaseline = "middle";

                var centerConfig = chart.config.options.elements.center;
                var targetText = centerConfig.text;
                var targetNumber = parseFloat(targetText);

                if (chart.centerAnim === undefined) { chart.centerAnim = { start: performance.now() }; }

                var elapsed = performance.now() - chart.centerAnim.start;
                var duration = chart.config.options.animation.duration || 8000;
                var progress = Math.min(elapsed / duration, 1);
                var ease = 1 - Math.pow(1 - progress, 4);

                var displayPercent;
                if (progress >= 1) { displayPercent = targetText; }
                else {
                    var currentNumber = Math.floor(targetNumber * ease);
                    displayPercent = currentNumber + '%';
                    requestAnimationFrame(() => chart.draw());
                }

                ctx.font = "800 " + fontSize + "em Inter";
                ctx.fillStyle = isDark ? '#f8fafc' : '#1e293b';
                var textX = Math.round((width - ctx.measureText(displayPercent).width) / 2),
                    textY = height / 2 - (height * 0.08);
                ctx.fillText(displayPercent, textX, textY);

                var subText = centerConfig.subText;
                if(subText) {
                    ctx.font = "600 " + (fontSize/3).toFixed(2) + "em Inter";
                    ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
                    var subX = Math.round((width - ctx.measureText(subText).width) / 2);
                    ctx.fillText(subText, subX, textY + (height*0.15));
                }

                var subText2 = centerConfig.subText2;
                if(subText2) {
                    ctx.font = "700 " + (fontSize/3.5).toFixed(2) + "em Inter";
                    ctx.fillStyle = isDark ? '#4ADE80' : '#16A34A';
                    var subX2 = Math.round((width - ctx.measureText(subText2).width) / 2);
                    ctx.fillText(subText2, subX2, textY + (height*0.25));
                }
                ctx.save();
            }
        });

        // Soft drop-shadow behind Chart.js tooltips for a premium feel.
        Chart.register({
            id: 'tooltipShadow',
            beforeTooltipDraw(chart) {
                const ctx = chart.ctx;
                ctx.save();
                ctx.shadowColor = 'rgba(37, 29, 58, 0.22)';
                ctx.shadowBlur = 22;
                ctx.shadowOffsetY = 10;
            },
            afterTooltipDraw(chart) {
                chart.ctx.restore();
            }
        });

        // Builds a soft navy → gold-tinted vertical gradient for bar fills.
        function barGradient(context, colorStart, colorEnd) {
            const { ctx, chartArea } = context.chart;
            if (!chartArea) return colorStart;
            const gradient = ctx.createLinearGradient(0, chartArea.bottom, 0, chartArea.top);
            gradient.addColorStop(0, colorStart);
            gradient.addColorStop(1, colorEnd);
            return gradient;
        }

