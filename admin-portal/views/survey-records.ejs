<script>
    const SQD_ITEMS = [
        "SQD0. I am satisfied with the service that I availed.",
        "SQD1. I spent a reasonable amount of time for my transaction.",
        "SQD2. The office followed the transaction's requirements and steps based on the information provided.",
        "SQD3. The steps (including payment) I needed to do for my transaction were easy and simple.",
        "SQD4. I easily found information about my transaction from the office or its website.",
        "SQD5. I paid a reasonable amount of fees for my transaction.",
        "SQD6. I feel the office was fair to everyone, or 'walang palakasan', during my transaction.",
        "SQD7. I was treated courteously by the staff.",
        "SQD8. I got what I needed from the government office."
    ];
    const SQD_RATING_LABELS = { '5': 'Strongly Agree', '4': 'Agree', '3': 'Neutral', '2': 'Disagree', '1': 'Strongly Disagree' };
    const TOPIC_TAXONOMY = <%- JSON.stringify(TOPIC_TAXONOMY) %>;
    const SENTIMENT_VALUES = <%- JSON.stringify(SENTIMENT_VALUES) %>;

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str == null ? '' : String(str);
        return div.innerHTML;
    }

    // --- AI Analysis view/edit (Survey Result modal) --------------------------
    // Authoritative "currently saved/effective" analysis for whichever survey
    // response the modal has open — Cancel and every re-open of "Edit Analysis"
    // reads from this, never from whatever happens to still be sitting in the
    // <select> elements, so an unsaved edit can never leak into the next edit
    // session.
    let currentAnalysis = null;

    function analysisViewItem(label, valueHtml) {
        return `
            <div class="result-item">
                <div class="label">${label}</div>
                <div class="value">${valueHtml}</div>
            </div>
        `;
    }

    function sentimentBadgeClass(sentiment) {
        const lower = (sentiment || '').toLowerCase();
        if (lower.includes('positive')) return 'bg-sentiment-positive';
        if (lower.includes('negative')) return 'bg-sentiment-negative';
        return 'bg-sentiment-neutral';
    }

    function renderSentimentBadge(sentiment) {
        if (!sentiment) return '<span class="sentiment-badge bg-sentiment-none">N/A</span>';
        return `<span class="sentiment-badge ${sentimentBadgeClass(sentiment)}">${escapeHtml(sentiment)}</span>`;
    }

    // Best-effort mirror of server.js's /survey-records badge-color rules, for
    // instant visual feedback on the row right after a save — the next full
    // page load/refresh always re-derives the authoritative class from the
    // server, this is cosmetic only.
    function topicBadgeClass(topic) {
        const lower = (topic || '').toLowerCase();
        if (lower.startsWith('unclassified')) return 'bg-unclassified';
        if (lower.includes('restroom') || lower.includes('cleanliness')) return 'bg-cr';
        if (lower.includes('aircon') || lower.includes('cooling')) return 'bg-aircon';
        if (lower.includes('facility') || lower.includes('equipment') || lower.includes('furniture') || lower.includes('seating') || lower.includes('power') || lower.includes('lighting')) return 'bg-facility';
        if (lower.includes('staff') || lower.includes('fairness') || lower.includes('courtesy') || lower.includes('competence')) return 'bg-staff';
        if (lower.includes('transaction')) return 'bg-transaction';
        if (lower.includes('payment') || lower.includes('fees')) return 'bg-payment';
        if (lower.includes('document') || lower.includes('credential') || lower.includes('enrollment') || lower.includes('registration')) return 'bg-docs';
        if (lower.includes('online') || lower.includes('portal') || lower.includes('internet')) return 'bg-online';
        if (lower.includes('health') || lower.includes('medical') || lower.includes('guidance') || lower.includes('counseling') || lower.includes('scholarship')) return 'bg-health';
        return 'bg-general';
    }

    function populateSelect(selectEl, options, selectedValue) {
        selectEl.innerHTML = options.map(opt => `<option value="${escapeHtml(opt)}">${escapeHtml(opt)}</option>`).join('');
        if (selectedValue && options.includes(selectedValue)) selectEl.value = selectedValue;
    }

    // Resets the three <select> elements to exactly currentAnalysis — called
    // every time "Edit Analysis" is opened, so a previously-cancelled,
    // never-saved edit can never resurface.
    function resetAnalysisEditor() {
        const sentimentSelect = document.getElementById('analysisSentimentSelect');
        const topicSelect = document.getElementById('analysisTopicSelect');
        const subtopicSelect = document.getElementById('analysisSubtopicSelect');
        if (!sentimentSelect || !topicSelect || !subtopicSelect || !currentAnalysis) return;

        populateSelect(sentimentSelect, SENTIMENT_VALUES, currentAnalysis.sentiment);
        populateSelect(topicSelect, Object.keys(TOPIC_TAXONOMY), currentAnalysis.topic);
        populateSelect(subtopicSelect, TOPIC_TAXONOMY[topicSelect.value] || [], currentAnalysis.subtopic);

        topicSelect.onchange = () => {
            populateSelect(subtopicSelect, TOPIC_TAXONOMY[topicSelect.value] || [], null);
        };
    }

    function initAnalysisEditor(s) {
        currentAnalysis = {
            sentiment: s.effectiveSentiment,
            topic: s.effectiveTopic,
            subtopic: s.effectiveSubtopic,
        };
        toggleAnalysisEdit(false);
    }

    function toggleAnalysisEdit(show) {
        const viewMode = document.getElementById('analysisViewMode');
        const editMode = document.getElementById('analysisEditMode');
        const editActions = document.getElementById('analysisEditActions');
        const editBtn = document.getElementById('analysisEditBtn');
        if (!viewMode || !editMode) return;
        if (show) resetAnalysisEditor();
        viewMode.style.display = show ? 'none' : '';
        editMode.style.display = show ? '' : 'none';
        editActions.style.display = show ? 'flex' : 'none';
        editBtn.style.display = show ? 'none' : '';
    }

    function saveAnalysis(id) {
        const sentimentSelect = document.getElementById('analysisSentimentSelect');
        const topicSelect = document.getElementById('analysisTopicSelect');
        const subtopicSelect = document.getElementById('analysisSubtopicSelect');
        const saveBtn = document.getElementById('analysisSaveBtn');
        const payload = {
            sentiment: sentimentSelect.value,
            topic: topicSelect.value,
            subtopic: subtopicSelect.value,
        };

        saveBtn.disabled = true;
        fetch('/api/admin/survey-response/' + encodeURIComponent(id) + '/analysis', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
        })
            .then(res => res.json().then(data => ({ ok: res.ok, data })))
            .then(({ ok, data }) => {
                if (!ok || !data.success) throw new Error(data.message || 'Failed to save analysis.');

                currentAnalysis = { ...payload };

                document.getElementById('analysisViewMode').innerHTML =
                    analysisViewItem('Sentiment', renderSentimentBadge(payload.sentiment)) +
                    analysisViewItem('Topic', escapeHtml(payload.topic)) +
                    analysisViewItem('Subtopic', escapeHtml(payload.subtopic));

                toggleAnalysisEdit(false);
                AppAlert.toast('success', 'Analysis updated successfully.');

                // Reflect the correction in the underlying table row immediately,
                // without a full page reload — the next real refresh re-derives
                // this from the server the same way.
                const row = document.querySelector(`.record-row[data-id="${id}"]`);
                if (row) {
                    const topicBadge = row.querySelector('.topic-badge');
                    const sentimentBadge = row.querySelector('.sentiment-badge');
                    if (topicBadge) {
                        topicBadge.textContent = payload.topic;
                        topicBadge.title = payload.topic;
                        topicBadge.className = 'topic-badge ' + topicBadgeClass(payload.topic);
                    }
                    if (sentimentBadge) {
                        sentimentBadge.textContent = payload.sentiment;
                        sentimentBadge.className = 'sentiment-badge ' + sentimentBadgeClass(payload.sentiment);
                    }
                    row.dataset.sentiment = payload.sentiment.toLowerCase();
                }
            })
            .catch(err => {
                console.error('Error saving analysis:', err);
                AppAlert.toast('error', err.message || 'Could not save this analysis. Please try again.');
            })
            .finally(() => {
                saveBtn.disabled = false;
            });
    }

    function openViewResult(id) {
        const modalEl = document.getElementById('viewResultModal');
        const bodyEl = document.getElementById('viewResultBody');
        const footerEl = document.getElementById('viewResultFooter');
        const reportBtn = document.getElementById('generateReportBtn');
        footerEl.style.display = 'none';
        reportBtn.onclick = () => openClientReport(id);
        bodyEl.innerHTML = `
            <div class="text-center py-5 text-muted">
                <i class="fas fa-spinner fa-spin fa-2x mb-3"></i>
                <p class="mb-0">Loading answers...</p>
            </div>
        `;
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        fetch('/api/admin/survey-response/' + encodeURIComponent(id))
            .then(res => res.json())
            .then(data => {
                if (!data.success) throw new Error(data.message || 'Failed to load this survey.');
                const s = data.survey;

                const sqdRows = SQD_ITEMS.map((label, idx) => {
                    const val = s['sqd' + idx];
                    let badge;
                    if (val === null || val === undefined) {
                        badge = `<span class="sqd-badge sqd-badge-unanswered">&mdash;</span>`;
                    } else if (Number(val) === 0) {
                        badge = `<span class="sqd-badge sqd-badge-na">N/A</span>`;
                    } else {
                        const text = SQD_RATING_LABELS[String(val)] || val;
                        badge = `<span class="sqd-badge sqd-badge-${val}">${escapeHtml(String(val))} &middot; ${escapeHtml(text)}</span>`;
                    }
                    return `
                        <div class="result-sqd-row">
                            <span class="result-sqd-statement">${escapeHtml(label)}</span>
                            ${badge}
                        </div>
                    `;
                }).join('');

                const ccItem = (label, value) => `
                    <div class="result-item">
                        <div class="label">${label}</div>
                        <div class="value">${escapeHtml(value || 'N/A')}</div>
                    </div>
                `;

                bodyEl.innerHTML = `
                    <div class="result-detail-head">
                        <div class="result-detail-icon"><i class="fas fa-building"></i></div>
                        <div>
                            <div class="result-office">${escapeHtml(s.respondent_name || 'Anonymous')}</div>
                            <div class="result-meta">${escapeHtml(s.office_name)} &middot; ${escapeHtml(s.cluster_name || 'General')} &middot; ${escapeHtml(s.formatted_date)}</div>
                        </div>
                        <span class="result-badge"><i class="fas fa-check-circle me-1"></i>Completed</span>
                    </div>

                    <div class="result-section">
                        <div class="result-section-header"><i class="fas fa-clock"></i> Visit Details</div>
                        <div class="result-grid">
                            ${ccItem('Date &amp; Time of Office Visit', s.office_visited_time_formatted)}
                            ${ccItem('Google Account', s.google_email)}
                        </div>
                    </div>

                    <div class="result-section">
                        <div class="result-section-header"><i class="fas fa-file-alt"></i> Citizen's Charter</div>
                        <div class="result-grid">
                            ${ccItem('CC1 &mdash; Awareness', s.cc1)}
                            ${ccItem('CC2 &mdash; Visibility', s.cc2)}
                            ${ccItem('CC3 &mdash; Helpfulness', s.cc3)}
                        </div>
                    </div>

                    <div class="result-section">
                        <div class="result-section-header"><i class="fas fa-star"></i> Service Quality Dimensions</div>
                        ${sqdRows}
                    </div>

                    <div class="result-section">
                        <div class="result-section-header"><i class="fas fa-comment-dots"></i> Suggestions / Comments</div>
                        <div class="result-item">
                            <div class="value">${escapeHtml(s.comments && s.comments !== 'N/A' ? s.comments : 'No comments provided.')}</div>
                        </div>
                    </div>

                    <div class="result-section mb-0" id="analysisSection">
                        <div class="result-section-header d-flex align-items-center justify-content-between">
                            <span><i class="fas fa-robot"></i> AI Analysis</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="analysisEditBtn" onclick="toggleAnalysisEdit(true)">
                                <i class="fas fa-pen me-1"></i> Edit Analysis
                            </button>
                        </div>

                        <div id="analysisViewMode" class="result-grid">
                            ${analysisViewItem('Sentiment', renderSentimentBadge(s.effectiveSentiment))}
                            ${ccItem('Topic', s.effectiveTopic || 'N/A')}
                            ${ccItem('Subtopic', s.effectiveSubtopic || 'N/A')}
                        </div>

                        <div id="analysisEditMode" class="result-grid" style="display:none;">
                            <div class="result-item">
                                <div class="label">Sentiment</div>
                                <select class="form-select form-select-sm" id="analysisSentimentSelect"></select>
                            </div>
                            <div class="result-item">
                                <div class="label">Topic</div>
                                <select class="form-select form-select-sm" id="analysisTopicSelect"></select>
                            </div>
                            <div class="result-item">
                                <div class="label">Subtopic</div>
                                <select class="form-select form-select-sm" id="analysisSubtopicSelect"></select>
                            </div>
                        </div>
                        <div id="analysisEditActions" class="d-flex gap-2 justify-content-end mt-3" style="display:none;">
                            <button type="button" class="btn btn-sm btn-secondary" onclick="toggleAnalysisEdit(false)">Cancel</button>
                            <button type="button" class="btn btn-sm btn-primary" id="analysisSaveBtn" onclick="saveAnalysis(${s.id})">Save Changes</button>
                        </div>
                    </div>
                `;
                footerEl.style.display = 'flex';
                initAnalysisEditor(s);
            })
            .catch(err => {
                console.error('Error loading survey result:', err);
                bodyEl.innerHTML = '<p class="text-danger mb-0 text-center py-4"><i class="fas fa-exclamation-triangle me-1"></i> Could not load this survey\'s answers. Please try again.</p>';
            });
    }

    // Long office names are shown as an acronym (e.g. "Office of the Vice President for Academic Affairs" -> "OVPAA")
    // with the full name available as a hover tooltip, so the table stays compact and readable.
    const OFFICE_NAME_MAX_LENGTH = 25;
    const OFFICE_ACRONYM_STOPWORDS = ['of', 'the', 'and', 'for', 'in', 'a', 'an'];

    function officeAcronym(name) {
        return name
            .split(/\s+/)
            .map(w => w.replace(/[^A-Za-z]/g, ''))
            .filter(w => w && !OFFICE_ACRONYM_STOPWORDS.includes(w.toLowerCase()))
            .map(w => w[0].toUpperCase())
            .join('');
    }

    document.querySelectorAll('.office-name-cell').forEach(cell => {
        const fullName = cell.getAttribute('data-full') || '';
        if (fullName.length > OFFICE_NAME_MAX_LENGTH) {
            const acronym = officeAcronym(fullName);
            if (acronym.length >= 2) {
                // The acronym span becomes the single tooltip trigger for this cell —
                // clear the td's own title/data-bs-toggle so hovering doesn't fire two
                // overlapping tooltips for the same office name.
                cell.removeAttribute('title');
                cell.removeAttribute('data-bs-toggle');
                cell.removeAttribute('data-bs-placement');
                cell.innerHTML = `<span class="office-acronym" title="${escapeHtml(fullName)}" data-bs-toggle="tooltip" data-bs-placement="top">${escapeHtml(acronym)}</span>`;
            }
        }
    });

    // Bootstrap tooltips for every truncatable cell (office, name, comments, topic,
    // time). Run after the acronym pass above so dynamically-created spans are
    // picked up too. Bootstrap reads the plain `title` attribute on init and moves
    // it to `data-bs-original-title` (removing `title`), so there's no duplicate
    // native browser tooltip once this runs — and if this script somehow fails,
    // the native `title` tooltip is still there as a fallback.
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

    // Sort by: name, date, sentiment, or office. Reorders the record rows within
    // each office group (all four modes) and, for "office", also reorders the
    // office groups themselves alphabetically. "Default" restores server order
    // (grouped by office cluster, newest response first).
    const SENTIMENT_SORT_ORDER = { positive: 1, neutral: 2, negative: 3 };

    function initSorting() {
        const sortSelect = document.getElementById('sortSelect');
        const scrollContainer = document.querySelector('.scroll-container');
        if (!sortSelect || !scrollContainer) return;

        const originalSectionOrder = Array.from(document.querySelectorAll('.office-section'));
        const originalRowOrder = new Map();
        originalSectionOrder.forEach(section => {
            originalRowOrder.set(section, Array.from(section.querySelectorAll('.record-row')));
        });

        sortSelect.addEventListener('change', function() {
            const mode = sortSelect.value;
            const sections = Array.from(document.querySelectorAll('.office-section'));

            if (mode === 'office') {
                sections.sort((a, b) => a.querySelector('.office-group-header span').innerText.localeCompare(b.querySelector('.office-group-header span').innerText));
            } else {
                sections.sort((a, b) => originalSectionOrder.indexOf(a) - originalSectionOrder.indexOf(b));
            }

            sections.forEach(section => {
                const tbody = section.querySelector('tbody');
                let rows = Array.from(tbody.querySelectorAll('.record-row'));

                if (mode === 'name') {
                    rows.sort((a, b) => a.dataset.name.toLowerCase().localeCompare(b.dataset.name.toLowerCase()));
                } else if (mode === 'date_desc') {
                    rows.sort((a, b) => new Date(b.dataset.date) - new Date(a.dataset.date));
                } else if (mode === 'date_asc') {
                    rows.sort((a, b) => new Date(a.dataset.date) - new Date(b.dataset.date));
                } else if (mode === 'sentiment') {
                    rows.sort((a, b) => (SENTIMENT_SORT_ORDER[a.dataset.sentiment] || 9) - (SENTIMENT_SORT_ORDER[b.dataset.sentiment] || 9));
                } else {
                    rows = originalRowOrder.get(section) || rows;
                }

                rows.forEach(row => tbody.appendChild(row));
                section.parentElement.appendChild(section);
            });
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        initSorting();

        const searchInput = document.getElementById('searchInput');
        const officeSections = document.querySelectorAll('.office-section');
        const noResults = document.getElementById('noResults');

        searchInput.addEventListener('keyup', function() {
            const query = searchInput.value.toLowerCase();
            let totalFound = 0;

            officeSections.forEach(section => {
                const rows = section.querySelectorAll('.record-row');
                const officeTitle = section.querySelector('.office-group-header span').innerText.toLowerCase();
                let foundInOffice = 0;

                rows.forEach(row => {
                    const rowText = row.innerText.toLowerCase();
                    if (rowText.includes(query) || officeTitle.includes(query)) {
                        row.style.display = "";
                        foundInOffice++;
                        totalFound++;
                    } else {
                        row.style.display = "none";
                    }
                });

                section.style.display = foundInOffice > 0 ? "" : "none";
            });

            noResults.style.display = totalFound === 0 ? "block" : "none";
        });
    });

    // Generate Report: computes and displays one client's own SQD score using the
    // exact same formula/template as the aggregate /report page, scoped to this
    // respondent only, right here on the Survey Records page (no page navigation).
    function openClientReport(id) {
        const modalEl = document.getElementById('clientReportModal');
        const loadingEl = document.querySelector('#clientReportBody > .text-center');
        const contentEl = document.getElementById('clientReportContentToExport');
        loadingEl.style.display = 'block';
        contentEl.style.display = 'none';

        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        fetch('/api/report-data', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ respondentId: id })
        })
            .then(res => res.json())
            .then(data => {
                const stats = data.stats || {};
                const clientName = stats.respondent_name || 'Anonymous';
                const officeName = stats.office_name || 'N/A';
                const periodLabel = stats.period_year_quarter || 'N/A';
                const periodText = `${periodLabel}${stats.response_date ? ' — Submitted ' + stats.response_date : ''}`;

                document.getElementById('cr_officeName1').innerText = `${clientName} — ${officeName}`;
                document.getElementById('cr_period1').innerText = periodText;
                document.getElementById('cr_officeName2').innerText = `${clientName} — ${officeName}`;
                document.getElementById('cr_period2').innerText = periodText;

                // Service availed (italic subtitle under the office name) — only
                // this single-respondent report has one real service to show;
                // hidden entirely when this respondent didn't record one.
                const serviceLineEl = document.getElementById('cr_serviceLine1');
                if (stats.service_availed) {
                    serviceLineEl.textContent = stats.service_availed;
                    serviceLineEl.classList.remove('d-none');
                } else {
                    serviceLineEl.textContent = '';
                    serviceLineEl.classList.add('d-none');
                }

                updateClientReportTable(stats);
                updateClientCommentsTable(data.comments);

                loadingEl.style.display = 'none';
                contentEl.style.display = 'block';
            })
            .catch(err => {
                console.error('Error generating client report:', err);
                loadingEl.innerHTML = '<p class="text-danger mb-0 text-center py-4"><i class="fas fa-exclamation-triangle me-1"></i> Could not generate this client\'s report. Please try again.</p>';
            });
    }

    function getClientReportInterpretation(score) {
        if (score >= 95) return "Outstanding";
        if (score >= 90) return "Very Satisfactory";
        if (score >= 80) return "Satisfactory";
        if (score >= 60) return "Fair";
        return "Poor";
    }

    // A dimension nobody could rate — no respondents at all, or every respondent
    // marked it N/A — has no percentage to show. Printing 0.00%/Poor would read as
    // "rated, and rated badly", so these cells print N/A instead, the same way the
    // SQD 0 / SQD 1-8 bucket tables already do.
    function sqdAnswerableCount(stats, prefix) {
        return ['sa', 'a', 'n', 'd', 'sd'].reduce((sum, b) => sum + (parseInt(stats[`${prefix}_${b}`]) || 0), 0);
    }

    function updateClientReportTable(stats) {
        const totalResp = stats.total_respondents || 0;
        document.getElementById('cr_totalRespondents1').innerText = totalResp;
        document.getElementById('cr_totalRespondents2').innerText = totalResp;

        let overallAnswerable = 0;
        for (let i = 1; i <= 8; i++) {
            const answerable = sqdAnswerableCount(stats, `sqd${i}`);
            overallAnswerable += answerable;
            const scoreEl = document.getElementById(`cr_sqd${i}_score`);
            const interpEl = document.getElementById(`cr_sqd${i}_interp`);
            if (answerable === 0) {
                scoreEl.innerText = 'N/A';
                interpEl.innerText = 'N/A';
            } else {
                const score = parseFloat(stats[`sqd${i}`] || 0);
                scoreEl.innerText = score.toFixed(2) + '%';
                interpEl.innerText = getClientReportInterpretation(score);
            }
        }

        const overall = parseFloat(stats.overall_score || 0);
        document.getElementById('cr_overall_score').innerText = overallAnswerable === 0 ? 'N/A' : overall.toFixed(2) + '%';
        document.getElementById('cr_overall_interp').innerText = overallAnswerable === 0 ? 'N/A' : getClientReportInterpretation(overall).toUpperCase();
    }

    function updateClientCommentsTable(comments) {
        const tbody = document.getElementById('cr_commentsBody');
        tbody.innerHTML = '';

        let pos = 0, neu = 0, neg = 0;
        let topics = {};

        if (!comments || comments.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">NO WRITTEN COMMENTS AND SUGGESTIONS REFLECTED IN ANY OF THE INSTRUMENTS</td></tr>`;
            document.getElementById('cr_aiPos').innerText = '0';
            document.getElementById('cr_aiNeu').innerText = '0';
            document.getElementById('cr_aiNeg').innerText = '0';
            document.getElementById('cr_aiDomTopic').innerText = 'N/A';
        } else {
            comments.forEach((c, index) => {
                // A NULL topic means this was a blank/"N/A"-style comment
                // with genuinely nothing to classify (see
                // isNoFeedbackComment in server.js) — shown as "No feedback",
                // excluded from the Positive/Neutral/Negative tally and the
                // dominant-topic count below rather than silently counted as
                // a fabricated "Neutral"/"General" opinion.
                const noFeedback = c.topic === null || c.topic === undefined;
                let aiSentiment = noFeedback ? 'No feedback' : (c.sentiment || 'Neutral');
                let aiTopic = noFeedback ? 'No feedback' : (c.topic || 'General');

                if (!noFeedback) {
                    if (aiSentiment === 'Positive') pos++;
                    else if (aiSentiment === 'Negative') neg++;
                    else neu++;
                    topics[aiTopic] = (topics[aiTopic] || 0) + 1;
                }

                let badgeClass = 'bg-neu';
                if (aiSentiment === 'Positive') badgeClass = 'bg-pos';
                if (aiSentiment === 'Negative') badgeClass = 'bg-neg';

                tbody.innerHTML += `<tr>
                    <td class="text-center">${index + 1}</td>
                    <td>${escapeHtml(c.comments)}</td>
                    <td class="text-center"><span class="topic-pill">${escapeHtml(aiTopic)}</span></td>
                    <td class="text-center"><span class="badge-sentiment ${badgeClass}">${escapeHtml(aiSentiment)}</span></td>
                </tr>`;
            });

            document.getElementById('cr_aiPos').innerText = pos;
            document.getElementById('cr_aiNeu').innerText = neu;
            document.getElementById('cr_aiNeg').innerText = neg;

            let domTopic = 'N/A';
            let maxCount = 0;
            for (const [key, value] of Object.entries(topics)) {
                if (value > maxCount) { maxCount = value; domTopic = key; }
            }
            document.getElementById('cr_aiDomTopic').innerText = domTopic;
        }
    }

    function downloadClientReportPDF() {
        // Two report identities share this one PDF: the SQD numerical summary
        // (always exactly one page) and AI Feedback Sentiment & Topic Analytics
        // (can span several pages) — page 1 always belongs to the SQD section,
        // every later page to AI Feedback. See public/js/pdf-repeating-header.js.
        const serviceLineEl = document.getElementById('cr_serviceLine1');
        const sqdHeader = {
            title: 'Client Satisfaction Measurement Survey Result',
            subtitle: document.getElementById('cr_officeName1').textContent.trim(),
            subtitleUnderline: true,
            serviceLine: (!serviceLineEl.classList.contains('d-none') ? serviceLineEl.textContent.trim() : ''),
            metaLines: [
                { label: 'Period Covered:', value: document.getElementById('cr_period1').textContent.trim() },
                { label: 'Number of Respondents:', value: document.getElementById('cr_totalRespondents1').textContent.trim() }
            ],
            docCode: 'CSPC-F-CQA-06'
        };
        const aiHeader = {
            title: 'AI Feedback Sentiment & Topic Analytics',
            subtitle: document.getElementById('cr_officeName2').textContent.trim(),
            subtitleUnderline: true,
            period: 'Period Covered: ' + document.getElementById('cr_period2').textContent.trim(),
            meta: 'Analyzed Feedbacks: ' + document.getElementById('cr_totalRespondents2').textContent.trim()
        };

        // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
        // html2pdf's margin array is [top, left, bottom, right] (not CSS order);
        // top is overridden by exportRepeatingHeaderPdf to reserve space for the
        // redrawn header.
        const opt = {
            margin: [0, 0.5, 0.25, 0.25],
            filename: 'CSM_Client_Report.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, letterRendering: true, scrollY: 0, backgroundColor: '#ffffff' },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' },
            pagebreak: { mode: ['css', 'legacy'], avoid: ['.page-footer', '.signature-section', '.sqd-interpretation-standalone', '.sqd-signature-grid', 'tr'] }
        };

        exportRepeatingHeaderPdf({
            elementId: 'clientReportContentToExport',
            filename: opt.filename,
            opt,
            headerHeightIn: 2.7,
            headerHideSelectors: ['.report-header-block', '.sqd-report-title', '.sqd-office-name', '.sqd-service-line', '.sqd-meta-block', '.report-title', '.office-title', '.meta-info'],
            getHeaderForPage: (pageNum) => (pageNum === 1 ? sqdHeader : aiHeader),
            avoidSplitSelector: '.sqd-signature-grid'
        });
    }

    function downloadClientReportCSV() {
        let csv = [];
        const rows = document.querySelectorAll("#clientReportContentToExport .report-table tr");

        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 0; j < cols.length; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/(\s\s)/gm, " ");
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }

        const csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
        const downloadLink = document.createElement("a");
        downloadLink.download = "CSM_Client_Data.csv";
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
    }
</script>

</body>
</html>