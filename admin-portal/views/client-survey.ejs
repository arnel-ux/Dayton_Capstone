<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSM Survey - CSPC</title>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2554c7">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/icon.svg">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="/js/offline-db.js"></script>
    <script src="/js/pwa-client.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Brand + neutral palette — refined institutional blue on slate neutrals */
            --bs-primary: #2554c7;
            --bs-primary-rgb: 37, 84, 199;
            --brand: #2554c7;
            --brand-dark: #1c3f9c;
            --ink-900: #0f172a;
            --ink-800: #1e293b;
            --ink-600: #475569;
            --ink-400: #94a3b8;
            --surface: #ffffff;
            --page-bg: #eef1f6;
            --line: #e2e8f0;
            --line-soft: #edf1f7;
            --ring: rgba(37, 84, 199, 0.15);
            --sidebar-w: 264px;
            --topbar-h: 68px;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            scroll-behavior: smooth;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: var(--page-bg);
            color: var(--ink-800);
            transition: background 0.3s ease-in-out, color 0.3s ease-in-out;
        }

        /* =========================================================
           DASHBOARD SHELL — sidebar + topbar + content
        ========================================================= */
        .app-shell { display: flex; min-height: 100vh; }

        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--ink-900);
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 1040;
            transition: transform 0.3s ease;
        }
        [data-bs-theme="dark"] .sidebar { background: #0a101c; }

        .sidebar-brand {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 1.4rem 1.4rem 1.2rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-brand img { width: 42px; height: 42px; border-radius: 50%; background: #fff; padding: 3px; flex-shrink: 0; }
        .sidebar-brand-text { line-height: 1.25; }
        .sidebar-brand-text .t1 { font-size: 0.8rem; font-weight: 700; color: #fff; letter-spacing: 0.3px; }
        .sidebar-brand-text .t2 { font-size: 0.7rem; color: #94a3b8; }

        .sidebar-nav { flex-grow: 1; padding: 1.25rem 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; }
        .sidebar-nav .nav-item-link {
            display: flex; align-items: center; gap: 0.8rem;
            padding: 0.7rem 0.9rem; border-radius: 10px;
            color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: 0.9rem;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .sidebar-nav .nav-item-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .sidebar-nav .nav-item-link:hover:not(.disabled) { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar-nav .nav-item-link.active { background: var(--brand); color: #fff; box-shadow: 0 6px 16px -6px rgba(37,84,199,0.7); }
        .sidebar-nav .nav-item-link.disabled { color: #64748b; cursor: not-allowed; }
        .sidebar-nav .soon-badge {
            margin-left: auto; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3px;
            background: rgba(148,163,184,0.15); color: #94a3b8; padding: 0.15rem 0.5rem; border-radius: 50px;
        }

        .sidebar-footer { padding: 1rem 1.4rem 1.4rem; border-top: 1px solid rgba(255,255,255,0.08); }
        .sidebar-footer .signed-in-email { font-size: 0.72rem; color: #94a3b8; margin-bottom: 0.6rem; word-break: break-all; }
        .sidebar-footer .btn-logout-side {
            width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            background: rgba(239,68,68,0.12); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25);
            border-radius: 10px; padding: 0.55rem; font-weight: 600; font-size: 0.82rem; transition: all 0.15s ease;
        }
        .sidebar-footer .btn-logout-side:hover { background: rgba(239,68,68,0.22); color: #fecaca; }

        .sidebar-backdrop {
            display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.55);
            z-index: 1035; backdrop-filter: blur(2px);
        }

        .main-content {
            flex-grow: 1; min-width: 0; margin-left: var(--sidebar-w); display: flex; flex-direction: column;
            transition: margin-left 0.35s cubic-bezier(.4,0,.2,1);
        }

        /* Persistent desktop sidebar collapse — same slide-away transform as the
           mobile overlay, but without the backdrop, and it reclaims the space
           instead of overlaying content (so the survey can go truly full-screen). */
        .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
        .app-shell.sidebar-collapsed .main-content { margin-left: 0; }

        .topbar {
            position: sticky; top: 0; z-index: 1020;
            height: var(--topbar-h);
            background: var(--surface);
            border-bottom: 1px solid var(--line-soft);
            display: flex; align-items: center; gap: 1rem;
            padding: 0 1.25rem;
        }
        .topbar-hamburger, .btn-sidebar-toggle {
            display: none; align-items: center; justify-content: center;
            width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line);
            background: var(--surface); color: var(--ink-800); font-size: 1.1rem;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .btn-sidebar-toggle { display: inline-flex; }
        .btn-sidebar-toggle:hover { border-color: var(--brand); color: var(--brand); background: var(--ring); }
        .topbar-title { font-weight: 700; color: var(--ink-900); font-size: 1rem; margin: 0; }
        .topbar-title small { display: block; font-weight: 500; font-size: 0.72rem; color: var(--ink-600); }
        .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 0.6rem; }
        .lang-toggle-group { display: flex; gap: 0.4rem; }

        .btn-fullscreen {
            display: inline-flex; align-items: center; justify-content: center;
            width: 38px; height: 38px; border-radius: 10px;
            border: 1px solid var(--line); background: var(--surface); color: var(--ink-800);
            font-size: 1rem; transition: all 0.2s ease;
        }
        .btn-fullscreen:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-1px); background: var(--ring); }
        .btn-fullscreen:active { transform: translateY(0) scale(0.94); }

        .content-body { padding: 1.75rem 1.5rem 3rem; flex-grow: 1; }

        /* =========================================================
           SPA VIEW SWITCHING — Take Survey / Profile / History
        ========================================================= */
        .app-view { display: none; }
        .app-view.active { display: block; animation: fadeIn .4s ease; }

        .view-card {
            border-radius: 20px;
            background: var(--surface) !important;
            border: 1px solid var(--line-soft);
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 24px 48px -16px rgba(15, 23, 42, 0.14);
            max-width: 880px;
            margin: 0 auto;
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        [data-bs-theme="dark"] .view-card { box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }

        .view-header { text-align: center; padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line-soft); }
        .view-header .view-icon {
            width: 56px; height: 56px; border-radius: 16px; margin: 0 auto 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
            background: var(--ring); color: var(--brand);
        }

        /* ---- Profile view ---- */
        .profile-field-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line-soft); }
        .profile-field-row:last-child { border-bottom: none; }
        .profile-field-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-600); }
        .profile-field-value { font-weight: 600; color: var(--ink-900); }
        .profile-locked-badge {
            display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.72rem; font-weight: 700;
            color: var(--ink-400); background: var(--line-soft); padding: 0.25rem 0.65rem; border-radius: 50px;
        }
        .profile-unset { color: var(--ink-400); font-style: italic; font-weight: 500; }

        /* ---- History view ---- */
        .history-item {
            border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem 1.3rem;
            display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
            background: var(--surface);
        }
        .history-item:hover { border-color: var(--brand); box-shadow: 0 8px 20px -12px rgba(37,84,199,0.35); transform: translateY(-2px); }
        .history-item + .history-item { margin-top: 0.9rem; }
        .history-office { font-weight: 700; color: var(--ink-900); margin-bottom: 0.15rem; }
        .history-meta { font-size: 0.78rem; color: var(--ink-600); }
        .history-badge {
            font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px;
            background: rgba(34,197,94,0.12); color: #16a34a; white-space: nowrap;
        }
        [data-bs-theme="dark"] .history-badge { background: rgba(34,197,94,0.18); color: #4ade80; }

        .empty-state { text-align: center; padding: 3.5rem 1.5rem; color: var(--ink-600); }
        .empty-state i { font-size: 2.75rem; color: var(--ink-400); margin-bottom: 1rem; display: block; }
        .empty-state p { max-width: 360px; margin: 0.5rem auto 0; font-size: 0.9rem; }

        .spinner-block { text-align: center; padding: 3rem 1rem; color: var(--ink-600); }

        /* ---- Review & Confirmation (Stage 5) ---- */
        .review-section { margin-bottom: 1.75rem; }
        .review-section-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 0.9rem;
        }
        .review-section-header h5 { margin: 0; font-weight: 700; color: var(--ink-900); font-size: 0.95rem; text-transform: uppercase; letter-spacing: .03em; }
        .btn-edit-section {
            font-size: 0.78rem; font-weight: 700; padding: 0.3rem 0.85rem; border-radius: 50px;
            background: var(--ring); color: var(--brand); border: 1px solid transparent; transition: all .15s ease;
        }
        .btn-edit-section:hover { background: var(--brand); color: #fff; transform: translateY(-1px); }

        .review-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
        .review-item {
            background: #f8fafc; border: 1px solid var(--line); border-radius: 12px; padding: 0.8rem 1rem;
        }
        [data-bs-theme="dark"] .review-item { background: #101827; }
        .review-item .label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--ink-400); margin-bottom: 0.2rem; }
        .review-item .value { font-weight: 600; color: var(--ink-900); font-size: 0.9rem; word-break: break-word; }
        .review-item.full { grid-column: 1 / -1; }

        .review-sqd-row {
            display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
            padding: 0.65rem 0; border-bottom: 1px dashed var(--line);
        }
        .review-sqd-row:last-child { border-bottom: none; }
        .review-sqd-statement { font-size: 0.85rem; color: var(--ink-800); }
        .review-sqd-rating {
            font-size: 0.78rem; font-weight: 700; white-space: nowrap; padding: 0.25rem 0.7rem; border-radius: 50px;
            background: var(--ring); color: var(--brand);
        }

        @media (max-width: 576px) {
            .review-grid { grid-template-columns: 1fr; }
            .profile-field-row { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
        }

        @media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); box-shadow: 0 0 40px rgba(0,0,0,0.35); }
            .sidebar.show { transform: translateX(0); }
            .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
            .sidebar-backdrop.show { display: block; }
            .main-content { margin-left: 0; }
            .topbar-hamburger { display: inline-flex; }
            .btn-sidebar-toggle { display: none; }
        }

        #sqd-body td {
            padding-top: 1.1rem;
            padding-bottom: 1.1rem;
        }

        .page { display: none; }
        .active { display: block; animation: fadeIn .4s ease; }
        .active.dir-fwd { animation: slideInFwd .45s cubic-bezier(.22,.61,.36,1); }
        .active.dir-back { animation: slideInBack .45s cubic-bezier(.22,.61,.36,1); }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideInFwd {
            from { opacity: 0; transform: translateX(28px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes slideInBack {
            from { opacity: 0; transform: translateX(-28px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Subtle padlock icon shown next to labels of previously-answered, locked fields */
        .lock-icon {
            font-size: 0.85rem;
            color: var(--ink-400);
            cursor: help;
            vertical-align: middle;
        }

        /* Dim disabled/locked inputs so it's obvious they can't be edited */
        .form-control:disabled,
        .form-select:disabled {
            background-color: #f1f5f9;
            opacity: 0.8;
            cursor: not-allowed;
        }

        /* Grey out offices whose survey is already completed, and mark them
           so the browser's native tooltip (title attr) makes the reason clear */
        #officeSelect option:disabled {
            color: #9ca3af;
            font-style: italic;
            background-color: #f1f5f9;
        }

        .locked-field {
            opacity: 0.75;
        }

        .locked-field .radio-custom {
            cursor: not-allowed;
        }

        .radio-custom {
            width: 19px;
            height: 19px;
            accent-color: var(--brand);
            cursor: pointer;
        }

        /* ---- Card shell — full-screen survey canvas, not a small boxed card ---- */
        /* When the Take Survey view is the active one, drop the content-body's own
           padding so the survey fills the viewport edge-to-edge; Profile/History
           keep their normal padded, centered card look. */
        .content-body:has(#view-survey.active) { padding: 0; }
        .survey-card {
            border-radius: 0;
            background: var(--surface) !important;
            border: none;
            border-top: 1px solid var(--line-soft);
            box-shadow: none;
            max-width: 100%;
            width: 100%;
            margin: 0;
            min-height: calc(100vh - var(--topbar-h));
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        /* Inner content still reads comfortably instead of stretching edge-to-edge on wide screens */
        .survey-card > .card-body { max-width: 900px; margin: 0 auto; width: 100%; }

        /* ---- Multi-step progress tracker ---- */
        .survey-progress { padding: 0 6px; }
        .progress-steps { position: relative; display: flex; justify-content: space-between; }
        .progress-track {
            position: absolute; top: 15px; left: 17px; right: 17px; height: 4px;
            border-radius: 50px; background: var(--line); z-index: 0; overflow: hidden;
        }
        .progress-fill {
            position: absolute; top: 0; left: 0; height: 100%; width: 0%;
            background: linear-gradient(90deg, var(--brand), #4d7ce8);
            border-radius: 50px; transition: width 0.5s cubic-bezier(.65,0,.35,1);
        }
        .progress-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.4rem; flex: 1; }
        .step-dot {
            width: 34px; height: 34px; border-radius: 50%; background: var(--surface);
            border: 2.5px solid var(--line); color: var(--ink-400);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.85rem; transition: all 0.3s ease;
        }
        .step-dot i { display: none; font-size: 1rem; }
        .step-label {
            font-size: 0.72rem; font-weight: 600; color: var(--ink-400);
            text-align: center; letter-spacing: 0.2px; transition: color 0.3s ease;
        }
        .progress-step.completed .step-dot {
            background: var(--brand); border-color: var(--brand); color: #fff;
        }
        .progress-step.completed .step-dot span { display: none; }
        .progress-step.completed .step-dot i { display: inline-block; }
        .progress-step.completed .step-label { color: var(--ink-800); }
        .progress-step.active .step-dot {
            border-color: var(--brand); color: var(--brand);
            box-shadow: 0 0 0 6px var(--ring);
            animation: stepPulse 1.8s ease-in-out infinite;
        }
        .progress-step.active .step-label { color: var(--brand); font-weight: 700; }

        @keyframes stepPulse {
            0%, 100% { box-shadow: 0 0 0 5px var(--ring); }
            50% { box-shadow: 0 0 0 9px transparent; }
        }

        @media (max-width: 480px) {
            .step-label { display: none; }
            .step-dot { width: 28px; height: 28px; font-size: 0.75rem; }
        }

        .text-heading { color: var(--ink-900) !important; }
        .text-dark { color: var(--ink-800) !important; }
        .text-secondary, .text-muted { color: var(--ink-600) !important; }

        .section-title {
            border-left: 4px solid var(--brand);
            padding-left: 14px;
        }

        .section-title h4 { letter-spacing: .02em; }

        /* ---- Soft question/info blocks (formerly bg-light) ---- */
        .qa-block {
            background: #f8fafc;
            border: 1px solid var(--line) !important;
            border-radius: 16px !important;
        }

        .option-card {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 15px 16px;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
            cursor: pointer;
            background: var(--surface);
        }

        .option-card:hover {
            background: #f5f8ff;
            border-color: #b6c8f2;
            transform: translateY(-2px) scale(1.005);
            box-shadow: 0 8px 20px -12px rgba(37, 84, 199, 0.35);
        }

        .option-card:has(input:checked) {
            background: #eef3fe;
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--ring), 0 8px 20px -10px rgba(37, 84, 199, 0.4);
            transform: scale(1.01);
        }

        .option-card:active { transform: scale(0.99); }

        .form-check-input {
            transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        }
        .form-check-input:checked {
            transform: scale(1.08);
        }

        /* ---- Form controls ---- */
        .form-control, .form-select {
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: .65rem .9rem;
            color: var(--ink-800);
            background-color: var(--surface);
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 4px var(--ring);
            outline: none;
        }

        .form-check-input {
            border: 1.5px solid var(--ink-400);
            border-radius: 5px;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 4px var(--ring);
            border-color: var(--brand);
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .form-label { color: var(--ink-800); }

        /* ---- Buttons ---- */
        .btn {
            border-radius: 8px;
            transition: transform .12s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease;
        }

        .btn-primary {
            background: var(--brand);
            border-color: var(--brand);
        }

        .btn-primary:hover, .btn-primary:focus {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
            transform: translateY(-1px);
            box-shadow: 0 8px 20px -8px rgba(37, 84, 199, 0.55);
        }

        .btn-outline-primary, .btn-outline-secondary {
            border-color: var(--line);
            color: var(--ink-800);
        }

        .btn-outline-primary:hover, .btn-outline-secondary:hover {
            transform: translateY(-1px);
        }

        .btn:disabled { transform: none; }

        /* ---- SQD table ---- */
        .table td, .table th { vertical-align: middle; }
        textarea { resize: none; }

        #sqd-table-wrap {
            border: 1px solid var(--line) !important;
            border-radius: 16px !important;
            overflow: hidden;
        }

        #sqd-table-wrap table { margin-bottom: 0; }

        #sqd-table-wrap thead th {
            background: var(--ink-900);
            color: #f1f5f9;
            font-weight: 600;
            border-color: var(--ink-900);
            padding: 0.9rem 0.6rem;
        }

        #sqd-body td.text-start {
            font-size: 0.9rem;
            line-height: 1.45;
            padding-left: 1.25rem;
            padding-right: 1rem;
            color: var(--ink-800);
        }

        #sqd-body tr { transition: background 0.15s ease; }
        #sqd-body tr:nth-child(even) { background: rgba(37, 84, 199, 0.025); }
        #sqd-body tr:hover { background: rgba(37, 84, 199, 0.06); }
        [data-bs-theme="dark"] #sqd-body tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }
        [data-bs-theme="dark"] #sqd-body tr:hover { background: rgba(96, 141, 255, 0.08); }

        #sqd-body .radio-custom { width: 20px; height: 20px; transition: transform 0.15s ease; }
        #sqd-body .radio-custom:hover { transform: scale(1.2); }
        #sqd-body .radio-custom:checked { transform: scale(1.25); }

        #sqd-table-wrap thead th { transition: background 0.15s ease, transform 0.15s ease; cursor: default; }
        #sqd-table-wrap thead th:not(:first-child):hover { transform: scale(1.06); }

        #sqd-body td:not(.text-start) { transition: background 0.2s ease; border-radius: 6px; }
        #sqd-body td:not(.text-start):has(.radio-custom:checked) { background: rgba(37, 84, 199, 0.1); }
        #sqd-body td:has(input[value="5"]:checked),
        #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.14) !important; }
        #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.16) !important; }
        #sqd-body td:has(input[value="2"]:checked),
        #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.14) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="5"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="2"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.22) !important; }

        /* --- DARK MODE STYLES --- */
        [data-bs-theme="dark"] {
            --page-bg: #0b1220;
            --surface: #161f2e;
            --line: #2a3444;
            --line-soft: #22293a;
            --ink-900: #f1f5f9;
            --ink-800: #e2e8f0;
            --ink-600: #94a3b8;
            --ink-400: #64748b;
            --ring: rgba(96, 141, 255, 0.25);
        }
        [data-bs-theme="dark"] body { color: var(--ink-800); }
        [data-bs-theme="dark"] .survey-card { box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }
        [data-bs-theme="dark"] .qa-block { background: #101827; }
        [data-bs-theme="dark"] .bg-white { background-color: var(--surface) !important; }
        [data-bs-theme="dark"] .option-card { background: #101827; color: var(--ink-800); }
        [data-bs-theme="dark"] .option-card:hover { background: #17233a; border-color: var(--brand); }
        [data-bs-theme="dark"] .option-card:has(input:checked) { background: #17233a; }
        [data-bs-theme="dark"] .bg-primary-subtle { background-color: rgba(37, 84, 199, 0.18) !important; }
        [data-bs-theme="dark"] .form-select, [data-bs-theme="dark"] .form-control { background-color: #101827; color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] .table { --bs-table-bg: transparent; --bs-table-color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] #sqd-table-wrap thead th { background: #050a13; }
        [data-bs-theme="dark"] #terms-box { background-color: var(--surface) !important; border-color: var(--line) !important; }

        summary { list-style: none; outline: none; }
        summary::-webkit-details-marker { display: none; }
    </style>
</head>

<body>

<div class="app-shell">

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="clientSidebar">
        <div class="sidebar-brand">
            <img src="/images/cspc-logo.png" alt="CSPC Logo">
            <div class="sidebar-brand-text">
                <div class="t1">CQA Client Portal</div>
                <div class="t2">CSPC Nabua, Cam. Sur</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="#" data-view="survey" class="nav-item-link active" onclick="return switchView('survey');"><i class="bi bi-clipboard2-check-fill"></i> Take Survey</a>
            <a href="#" data-view="profile" class="nav-item-link" onclick="return switchView('profile');"><i class="bi bi-person-fill"></i> Profile</a>
            <a href="#" data-view="history" class="nav-item-link" onclick="return switchView('history');"><i class="bi bi-clock-history"></i> History</a>
        </nav>

        <div class="sidebar-footer">
            <div class="signed-in-email" title="Signed in with Google">
                <i class="bi bi-google me-1"></i><%= typeof clientEmail !== 'undefined' ? clientEmail : '' %>
            </div>
            <button type="button" class="btn-logout-side" onclick="logout()"><i class="bi bi-box-arrow-right"></i> Logout</button>
        </div>
    </aside>

    <div class="main-content">

        <header class="topbar">
            <button type="button" class="topbar-hamburger" onclick="toggleSidebar()" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>
            <button type="button" id="btn-sidebar-collapse" class="btn-sidebar-toggle" onclick="toggleSidebarCollapse()" title="Collapse sidebar — focus on the survey" aria-label="Collapse sidebar">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
            <div class="topbar-title">
                Client Satisfaction Survey
                <small data-i18n="gov_rep">Republic of the Philippines</small>
            </div>
            <div class="topbar-actions">
                <button id="btn-fullscreen" type="button" onclick="toggleFullscreen()" class="btn-fullscreen" title="Toggle full screen" aria-label="Toggle full screen">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                <button id="btn-theme" type="button" onclick="toggleTheme()" class="btn bg-transparent border-0 text-body shadow-none fw-semibold d-flex align-items-center gap-1">
                    🌙 Dark
                </button>
                <div class="lang-toggle-group">
                    <button id="btn-en" type="button" onclick="setLanguage('en')" class="btn btn-primary btn-sm fw-semibold shadow-sm">English</button>
                    <button id="btn-tl" type="button" onclick="setLanguage('tl')" class="btn bg-transparent border btn-sm fw-semibold shadow-sm text-body">Tagalog</button>
                </div>
            </div>
        </header>

        <div class="content-body">

        <div class="app-view active" id="view-survey">
        <div class="card border-0 survey-card">
        <div class="card-body p-4 p-md-5 position-relative">

            <div class="text-center border-bottom pb-4 mb-5">
                <div class="mb-3">
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" style="width: 92px; height: auto;" class="mb-3">
                </div>
                <p class="small text-secondary text-uppercase mb-1" style="letter-spacing:.08em;" data-i18n="gov_rep">Republic of the Philippines</p>
                <h3 class="fw-semibold text-uppercase mb-0 text-heading">Camarines Sur Polytechnic Colleges</h3>
                <p class="text-secondary fst-italic mb-0">Nabua, Camarines Sur</p>

                <div class="bg-primary-subtle rounded-4 p-3 mt-4">
                    <h4 class="fw-semibold text-heading text-uppercase mb-0" data-i18n="form_title">Client Satisfaction Measurement (CSM) Survey</h4>
                </div>
            </div>

            <div class="survey-progress mb-5" id="surveyProgress">
                <div class="progress-steps">
                    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
                    <div class="progress-step active" data-step="1">
                        <div class="step-dot"><span>1</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Terms</div>
                    </div>
                    <div class="progress-step" data-step="2">
                        <div class="step-dot"><span>2</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Client Info</div>
                    </div>
                    <div class="progress-step" data-step="3">
                        <div class="step-dot"><span>3</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Citizen's Charter</div>
                    </div>
                    <div class="progress-step" data-step="4">
                        <div class="step-dot"><span>4</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">SQD Rating</div>
                    </div>
                    <div class="progress-step" data-step="5">
                        <div class="step-dot"><span>5</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Review</div>
                    </div>
                </div>
            </div>

            <form id="surveyForm">

                <div id="stage1" class="page active">
                    <div class="qa-block p-4 text-center mb-4">
                        <h4 class="fw-semibold text-heading mb-3" data-i18n="s1_head">Help us serve you better!</h4>
                        <p class="text-secondary mb-0 fs-6" data-i18n="s1_desc"></p>
                    </div>

                    <div id="terms-box" class="mb-4 bg-white border rounded-4 p-4">
                        <div class="text-center mb-3">
                            <span class="fw-semibold text-heading fs-5" data-i18n="terms_title">Terms and Conditions</span>
                            <p class="text-secondary small mb-0 mt-2" data-i18n="terms_summary"></p>
                        </div>

                        <ul id="terms-points-list" class="text-secondary small mb-3 ps-4"></ul>

                        <div class="text-center mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#termsModal" title="Read the full Terms and Conditions / Privacy Policy">
                                <span data-i18n="terms_read_btn"></span>
                            </button>
                        </div>

                        <div class="form-check d-flex align-items-start gap-2 justify-content-center border-top pt-3">
                            <input class="form-check-input mt-1" type="checkbox" id="agreeTermsStage1">
                            <label class="form-check-label text-dark fs-6" for="agreeTermsStage1">
                                <span data-i18n="terms_checkbox">I Agree to the Terms &amp; Conditions and Privacy Policy</span>
                            </label>
                        </div>
                    </div>

                    <button type="button" id="btnStartSurvey" onclick="navigate(2)" class="btn btn-primary w-100 py-3 fw-semibold" disabled>
                        <span data-i18n="btn_start"></span>
                    </button>
                </div>

                <div id="stage2" class="page">
                    <div class="section-title mb-4">
                        <h4 class="fw-semibold text-heading text-uppercase mb-0" data-i18n="client_prof">Client Profile</h4>
                    </div>

                    <div class="row g-4">
                        <!-- IDINAGDAG: Pangalan -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6">Name / Pangalan (Optional)</label>
                            <input type="text" name="respondent_name" class="form-control" placeholder="e.g. Juan Dela Cruz">
                        </div>

                        <!-- Signed-in Google account (used to enforce 1 survey per office). Visually hidden
                             per design request — the value is still bound, readonly, and submitted with the
                             form normally; `d-none` only removes it from layout/view, not from FormData. -->
                        <div class="col-md-6 d-none">
                            <label class="form-label fw-semibold text-dark fs-6">Google Account</label>
                            <input type="email" name="email" class="form-control" value="<%= typeof clientEmail !== 'undefined' ? clientEmail : '' %>" readonly>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_client_type"></label>
                            <!-- IDINAGDAG ANG name="client_type" AT value="" -->
                            <select name="client_type" class="form-select">
                                <option value="Citizen" data-i18n="opt_citizen"></option>
                                <option value="Business" data-i18n="opt_business"></option>
                                <option value="Government" data-i18n="opt_gov"></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_sex"></label>
                            <i id="gender-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <div id="gender-field-group" class="d-flex flex-wrap gap-4 pt-2">
                                <label class="d-flex align-items-center gap-2 text-dark">
                                    <!-- PINALITAN ANG name="sex" NG name="gender" AT NAGDAGDAG NG value="Male" -->
                                    <input type="radio" name="gender" value="Male" class="radio-custom">
                                    <span data-i18n="lbl_male"></span>
                                </label>
                                <label class="d-flex align-items-center gap-2 text-dark">
                                    <!-- PINALITAN ANG name="sex" NG name="gender" AT NAGDAGDAG NG value="Female" -->
                                    <input type="radio" name="gender" value="Female" class="radio-custom">
                                    <span data-i18n="lbl_female"></span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_age"></label>
                            <i id="age-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <!-- IDINAGDAG ANG name="age" AT value="" SA MGA OPTIONS -->
                            <select name="age" class="form-select">
                                <option value="" selected disabled data-i18n="opt_sel_age"></option>
                                <option value="18 and below" data-i18n="opt_18_below"></option>
                                <option value="19-24">19-24</option>
                                <option value="25-39">25-39</option>
                                <option value="40-59">40-59</option>
                                <option value="60 and above" data-i18n="opt_60_above"></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_date"></label>
                            <input type="date" id="surveyDate" name="survey_date" class="form-control">
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_region"></label>
                            <i id="region-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <!-- IDINAGDAG ANG name="region" AT value="" SA MGA OPTIONS -->
                            <select name="region" class="form-select">
                                <option value="" disabled selected data-i18n="opt_select_region"></option>
                                <option value="NCR - National Capital Region">NCR - National Capital Region</option>
                                <option value="CAR - Cordillera Administrative Region">CAR - Cordillera Administrative Region</option>
                                <option value="Region I - Ilocos Region">Region I - Ilocos Region</option>
                                <option value="Region II - Cagayan Valley">Region II - Cagayan Valley</option>
                                <option value="Region III - Central Luzon">Region III - Central Luzon</option>
                                <option value="Region IV-A - CALABARZON">Region IV-A - CALABARZON</option>
                                <option value="MIMAROPA Region">MIMAROPA Region</option>
                                <option value="Region V - Bicol Region">Region V - Bicol Region</option>
                                <option value="Region VI - Western Visayas">Region VI - Western Visayas</option>
                                <option value="Region VII - Central Visayas">Region VII - Central Visayas</option>
                                <option value="Region VIII - Eastern Visayas">Region VIII - Eastern Visayas</option>
                                <option value="Region IX - Zamboanga Peninsula">Region IX - Zamboanga Peninsula</option>
                                <option value="Region X - Northern Mindanao">Region X - Northern Mindanao</option>
                                <option value="Region XI - Davao Region">Region XI - Davao Region</option>
                                <option value="Region XII - SOCCSKSARGEN">Region XII - SOCCSKSARGEN</option>
                                <option value="Region XIII - Caraga">Region XIII - Caraga</option>
                                <option value="BARMM - Bangsamoro">BARMM - Bangsamoro Autonomous Region in Muslim Mindanao</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_office"></label>
                            <select id="officeSelect" name="office_id" class="form-select fs-6" required>
                                <option value="" selected disabled data-i18n="s1_ph">Select Office...</option>
                                <% if (typeof offices !== 'undefined') { %>
                                    <% const taken = typeof takenOfficeIds !== 'undefined' ? takenOfficeIds : []; %>
                                    <% offices.forEach(office => { %>
                                        <% const isTaken = taken.includes(office.id); %>
                                        <option
                                            value="<%= office.id %>"
                                            <% if (isTaken) { %>disabled title="Survey already completed for this office"<% } %>
                                        ><%= isTaken ? '✓ ' : '' %><%= office.office_name %> (<%= office.cluster_name %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_service"></label>
                            <select name="service_availed" id="serviceSelect" class="form-select fs-6" disabled>
                                <option value="" selected disabled>Select Service...</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-4 mt-5">
                        <button type="button" onclick="navigate(1)" class="btn btn-outline-secondary fw-semibold" data-i18n="btn_back"></button>
                        <button type="button" id="btnNextStage2" onclick="goNext(3)" class="btn btn-primary fw-semibold px-5" data-i18n="btn_next"></button>
                    </div>
                </div>

                <div id="stage3" class="page">
                    <div class="section-title mb-4">
                        <h4 class="fw-semibold text-heading text-uppercase mb-0" data-i18n="cc_title"></h4>
                        <p class="text-secondary mt-2 mb-2" data-i18n="cc_desc"></p>
                    </div>

                    <div class="qa-block p-4 mb-4">
                        <p class="fw-semibold text-dark" data-i18n="cc1_q"></p>
                        <div class="d-grid gap-3">
                            <label class="option-card d-flex gap-3 text-dark">
                                <input type="radio" name="cc1" value="I know what a CC is and I saw this office's CC." class="radio-custom mt-1">
                                <span data-i18n="cc1_1"></span>
                            </label>
                            <label class="option-card d-flex gap-3 text-dark">
                                <input type="radio" name="cc1" value="I know what a CC is but I did not see this office's CC." class="radio-custom mt-1">
                                <span data-i18n="cc1_2"></span>
                            </label>
                            <label class="option-card d-flex gap-3 text-dark">
                                <input type="radio" name="cc1" value="I learned of the CC only when I saw this office's CC." class="radio-custom mt-1">
                                <span data-i18n="cc1_3"></span>
                            </label>
                            <label class="option-card d-flex gap-3 text-dark">
                                <input type="radio" name="cc1" value="I do not know what a CC is and I did not see one in this office" class="radio-custom mt-1">
                                <span data-i18n="cc1_4"></span>
                            </label>
                        </div>
                    </div>

                    <div class="qa-block p-4 mb-4">
                        <p class="fw-semibold text-dark" data-i18n="cc2_q"></p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc2" value="Easy to see" class="radio-custom">
                                    <span data-i18n="cc2_1"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc2" value="Somewhat easy to see" class="radio-custom">
                                    <span data-i18n="cc2_2"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc2" value="Difficult to see" class="radio-custom">
                                    <span data-i18n="cc2_3"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc2" value="Not visible at all" class="radio-custom">
                                    <span data-i18n="cc2_4"></span>
                                </label>
                            </div>
                            <div class="col-12">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc2" value="N/A" class="radio-custom">
                                    <span data-i18n="cc2_5"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="qa-block p-4">
                        <p class="fw-semibold text-dark" data-i18n="cc3_q"></p>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc3" value="Helped very much" class="radio-custom">
                                    <span data-i18n="cc3_1"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc3" value="Did not help" class="radio-custom">
                                    <span data-i18n="cc3_2"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc3" value="Somewhat helped" class="radio-custom">
                                    <span data-i18n="cc3_3"></span>
                                </label>
                            </div>
                            <div class="col-md-6">
                                <label class="option-card d-flex gap-3 align-items-center text-dark">
                                    <input type="radio" name="cc3" value="N/A" class="radio-custom">
                                    <span data-i18n="cc3_4"></span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-4 mt-5">
                        <button type="button" onclick="navigate(2)" class="btn btn-outline-secondary fw-semibold" data-i18n="btn_back"></button>
                        <button type="button" id="btnNextStage3" onclick="goNext(4)" class="btn btn-primary fw-semibold px-5" data-i18n="btn_next"></button>
                    </div>
                </div>

                <div id="stage4" class="page">
                    <div class="section-title mb-4">
                        <h4 class="fw-semibold text-heading text-uppercase mb-0" data-i18n="sqd_title"></h4>
                        <p class="text-secondary mt-2 mb-0" data-i18n="sqd_desc"></p>
                    </div>

                    <div id="sqd-table-wrap" class="table-responsive bg-white">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="text-center">
                            <tr>
                                <th class="text-start" data-i18n="th_statement"></th>
                                <th>🤩 5<br><small data-i18n="th_sa"></small></th>
                                <th>😊 4<br><small data-i18n="th_a"></small></th>
                                <th>😐 3<br><small data-i18n="th_n"></small></th>
                                <th>☹️ 2<br><small data-i18n="th_d"></small></th>
                                <th>😡 1<br><small data-i18n="th_sd"></small></th>
                                <th>N/A</th>
                            </tr>
                            </thead>
                            <tbody id="sqd-body"></tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <label class="form-label fw-semibold fst-italic text-dark" data-i18n="lbl_sugg"></label>
                        <textarea name="comments" class="form-control" rows="5"></textarea>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-4 mt-5">
                        <button type="button" onclick="navigate(3)" class="btn btn-outline-secondary fw-semibold" data-i18n="btn_back"></button>
                        <button type="button" id="btnNextStage4" onclick="goNext(5)" class="btn btn-primary fw-semibold px-5" data-i18n="btn_next"></button>
                    </div>
                </div>

                <div id="stage5" class="page">
