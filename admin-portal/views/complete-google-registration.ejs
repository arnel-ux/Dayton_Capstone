<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <link rel="stylesheet" href="/css/auth.css">
    <style>
        /* ---- Registration progress ----
           The Register tab on /login promises a two-step flow ("sign up with
           your email, then fill in the registration form"). This is step 2, so
           it says so — landing on a fresh card with no continuity was what made
           the hand-off from Google feel like a separate, unexplained page. */
        .reg-progress {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            margin-bottom: 0.85rem;
        }
        .reg-progress-step {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.3rem 0.7rem;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            line-height: 1.3;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #94a3b8;
        }
        .reg-progress-step.is-done {
            background: #ecfdf5;
            border-color: #a7f3d0;
            color: #047857;
        }
        .reg-progress-step.is-current {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border-color: transparent;
            color: #ffffff;
        }
        .reg-progress-sep { color: #cbd5e1; font-size: 0.7rem; }

        @media (max-width: 480px) {
            .reg-progress { gap: 0.3rem; margin-bottom: 0.7rem; }
            .reg-progress-step { font-size: 0.68rem; padding: 0.28rem 0.6rem; }
        }
        @media (max-height: 780px) {
            .reg-progress { margin-bottom: 0.55rem; }
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/alerts.css">
</head>
<body>

    <div class="bg-blurred" style="--auth-hero-image: url('<%- heroImageUrl %>')"></div>
    <div class="bg-overlay"></div>

    <a href="/login" class="btn-home" title="Back to Login" aria-label="Back to Login">
        <i class="fas fa-arrow-left"></i>
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Finish Registration</h2>
        </div>

        <div class="card-custom">

            <div class="reg-progress" aria-label="Registration progress">
                <span class="reg-progress-step is-done"><i class="fas fa-circle-check" aria-hidden="true"></i> 1. Email verified</span>
                <span class="reg-progress-sep" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                <span class="reg-progress-step is-current"><i class="fas fa-key" aria-hidden="true"></i> 2. Register account</span>
            </div>

            <div class="text-center mb-2">
                <% if (typeof photo !== 'undefined' && photo) { %>
                    <img src="<%= photo %>" alt="Google profile photo" referrerpolicy="no-referrer" class="cqa-logo mb-1" style="border-radius: 50%; object-fit: cover; aspect-ratio: 1;">
                <% } else { %>
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1">
                <% } %>
                <h4 class="fw-bold text-dark mb-0">Register Your Account</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Your email is confirmed. Set a password to finish registering your CQA account.</p>
            </div>

            <form action="/complete-google-registration" method="POST" id="completeRegistrationForm">
                <div class="field-group">
                    <label class="field-label" for="regName">Name</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" id="regName" class="form-control" value="<%= name %>" readonly title="Name from your Google account">
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regEmail">Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                        <input type="text" id="regEmail" class="form-control" value="<%= email %>" readonly title="Email from your Google account">
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regPassword">Create Password</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="regPassword" class="form-control" placeholder="At least 8 characters" minlength="8" required title="Create a password for future logins" autocomplete="new-password" data-pw-strength>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regConfirmPassword">Confirm Password</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="confirmPassword" id="regConfirmPassword" class="form-control" placeholder="Re-enter your password" minlength="8" required title="Confirm your password" autocomplete="new-password">
                    </div>
                </div>

                <button type="submit" class="btn btn-login w-100" title="Create your account">
                    <i class="fas fa-user-plus me-2"></i> Create Account
                </button>

                <p class="text-muted text-xsmall text-center mt-3 mb-0">
                    You'll use this password to log in next time — the standard Email and Password form on the login page.
                </p>
            </form>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const regErrorMsg = new URLSearchParams(window.location.search).get('error');
        if (regErrorMsg) {
            AppAlert.error(regErrorMsg, 'Could Not Create Account');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        document.getElementById('completeRegistrationForm').addEventListener('submit', (e) => {
            const password = e.target.password.value;
            const confirmPassword = e.target.confirmPassword.value;
            if (password.length < 8) {
                e.preventDefault();
                AppAlert.warning('Password must be at least 8 characters long.', 'Password Too Short');
                return;
            }
            if (password !== confirmPassword) {
                e.preventDefault();
                AppAlert.warning('The passwords you entered do not match.', 'Passwords Do Not Match');
            }
        });
    </script>
</body>
</html>
