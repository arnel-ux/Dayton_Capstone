<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2554c7">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/icon.svg">
    <style>
        /* Reset and Base Styles */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden; /* Para walang lumabas na scrollbar */
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* 1. The Blurred Background Image */
        .bg-blurred {
            position: fixed; 
            top: -5%; left: -5%; right: -5%; bottom: -5%; 
            background-image: url('https://spims.cspc.edu.ph/assets/img/background.jpg'); 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(1px);
            z-index: -1;
        }

        /* 2. The Dark Overlay */
        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(15, 23, 42, 0.6); /* Dark navy tint */
            z-index: -1;
        }

        /* 3. Perfect Centering Wrapper */
        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column; /* Para magpatong ang titles at card */
            align-items: center;    /* Centers vertically/horizontally */
            justify-content: center;   
            z-index: 1;
            padding: 1rem;
        }

        /* --- BAGONG DAGDAG NA HEADER STYLES & ANIMATIONS --- */
        
        /* Keyframes para sa Fade & Slide Up Animation */
        @keyframes fadeSlideUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-container {
            text-align: center;
            margin-bottom: 2.25rem;
            max-width: 800px; /* Para hindi masyadong humaba sa malaking screen */
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 2rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
            line-height: 1.25;

            /* Apply animation (Mauuna) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #e2e8f0;
            font-weight: 400;
            font-style: italic; /* Ibang style as requested */
            font-size: 1.05rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 1rem;

            /* Apply animation (Pangalawa, may delay na 0.3s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            padding: 0.4rem 1rem;
            background: rgba(37, 84, 199, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            backdrop-filter: blur(6px);
            margin-bottom: 0;

            /* Apply animation (Pangatlo, may delay na 0.6s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        /* Responsive para sa Titles */
        @media (max-width: 600px) {
            .main-title {
                font-size: 1.4rem;
            }
            .sub-title {
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }
            .portal-text {
                font-size: 1.1rem;
            }
        }
        /* -------------------------------------- */

        /* 4. Card Styling — soft glassmorphism, refined shadow (still square-ish) */
        .card-custom {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 1.75rem;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;

            width: 390px;
            height: 390px;

            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.75rem 2.5rem;
            transition: box-shadow 0.3s ease;
        }

        /* Responsive para sa mobile card */
        @media (max-width: 400px) {
            .card-custom {
                width: 92vw;
                height: 92vw; /* Keep it square on mobile */
                padding: 1.5rem 1.75rem;
            }
        }

        .card-custom .cqa-logo {
            width: 62px;
            height: auto;
        }

        .card-custom h4 {
            color: #0f172a;
            font-size: 1.15rem;
            letter-spacing: 0.2px;
        }

        .card-custom .divider-soft {
            width: 42px;
            height: 3px;
            background: #2554c7;
            border-radius: 50px;
            margin: 0.6rem auto 0.85rem;
        }

        /* Google Button Styling */
        .btn-google {
            background-color: #ffffff;
            color: #334155;
            border: 1.5px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            font-weight: 600;
            font-size: 0.98rem;
            transition: all 0.25s ease;
            border-radius: 10px;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #2554c7;
            box-shadow: 0 6px 16px -4px rgba(37, 84, 199, 0.25);
            transform: translateY(-1px);
        }

        .btn-google:active {
            transform: translateY(0);
        }

        .btn-google img {
            width: 21px;
            height: 21px;
        }

        /* Extra small text helper */
        .text-xsmall {
            font-size: 0.75rem;
        }
    </style>
</head>
<body>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <div class="login-wrapper">
        
        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Client Portal</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-3">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-3">
                <h4 class="fw-bold mb-0">Client Login</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Sign in to your CQA Dashboard</p>
            </div>

            <div class="text-center mb-4">
                <p class="text-muted mb-0" style="font-size: 0.85rem; line-height: 1.5;">
                    Please sign in using your personal or academic Gmail account to access the survey portal.
                </p>
            </div>

            <a href="/auth/google" class="text-decoration-none">
                <button type="button" class="btn btn-google w-100 py-3 shadow-sm">
                    <img src="https://www.freepnglogos.com/uploads/google-logo-png/google-logo-png-google-icon-logo-png-transparent-svg-vector-bie-supply-14.png" alt="Google Logo">
                    Sign in with Google
                </button>
            </a>

        </div>
    </div>

    <script>
        // Offline session bypass: if a survey was already opened once while
        // signed in, its session is cached in localStorage (see
        // client-survey.ejs). Reopening the app with no connection skips the
        // Google sign-in (which needs the network) and goes straight back to
        // the survey — served from the service worker's cache.
        (function () {
            if (navigator.onLine) return;
            try {
                const cached = JSON.parse(localStorage.getItem('cspc_client_session') || 'null');
                if (cached && cached.email) {
                    window.location.href = '/client-survey';
                }
            } catch (e) { /* no cached session — fall through to the normal Google sign-in */ }
        })();

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }
    </script>

    <%- include('layout/theme-toggle') %>
</body>
</html>