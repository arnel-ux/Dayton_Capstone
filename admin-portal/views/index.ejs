<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CQA - Public Transparency Portal</title>
    <script>
        (function () {
            try {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                    document.addEventListener('DOMContentLoaded', function () {
                        document.body.classList.add('dark-mode');
                    });
                }
            } catch (e) {}
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Animation stack: GSAP + ScrollTrigger for scroll-driven reveals/parallax (native scroll, no smooth-scroll library) -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

    <style>
        :root {
            --navy-950: #060e21;
            --navy-900: #0a1f44;
            --navy-800: #0e2a5e;
            --navy-700: #12305c;
            --gold-500: #f4b400;
            --gold-400: #ffc72c;
            --gold-300: #ffdd7a;
            --gold-deep: #8a5a00; /* dark amber — passes AA contrast on light backgrounds */

            /* ---- Base-8 spacing scale — every margin/padding/gap below resolves to one of these ---- */
            --sp-1: 0.5rem;   /* 8px */
            --sp-2: 1rem;     /* 16px */
            --sp-3: 1.5rem;   /* 24px */
            --sp-4: 2rem;     /* 32px */
            --sp-5: 2.5rem;   /* 40px */
            --sp-6: 3rem;     /* 48px */
            --sp-7: 3.5rem;   /* 56px */
            --sp-8: 4rem;     /* 64px */
            --sp-10: 5rem;    /* 80px */
            --sp-12: 6rem;    /* 96px */

            /* ---- Typography scale ---- */
            --fs-xs: 0.75rem;
            --fs-sm: 0.875rem;
            --fs-base: 1rem;
            --fs-lg: 1.125rem;
            --fs-xl: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
            --fs-2xl: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
            --fs-3xl: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
            --fs-hero: clamp(2.25rem, 1.4rem + 4vw, 4.5rem);
        }

        /* --- GENERAL LAYOUT --- */
        html { scroll-behavior: smooth; }
        body, html {
            margin: 0; padding: 0; font-family: 'Inter', sans-serif; color: #1e293b;
            font-size: var(--fs-base); line-height: 1.6;
        }
        h1, h2, h3, h4, h5, h6 { line-height: 1.2; }

        .bg-image {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background:url('<%- landingContent.hero.imageUrl %>');
            background-size: cover; background-position: center; z-index: -2;
        }

        .bg-overlay {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            background: linear-gradient(180deg, rgba(6,14,33,0.92) 0%, rgba(10,31,68,0.85) 100%); z-index: -1;
        }

        body.dark-mode .bg-overlay { background: linear-gradient(180deg, rgba(4,8,18,0.95) 0%, rgba(6,14,33,0.92) 100%); }
        body:not(.dark-mode) .page-content { background: #f4f6fb; }
        body.dark-mode .page-content { background: #0b1526; }

        .page-content { position: relative; z-index: 1; }

        /* --- SITE NAV LINKS --- */
        .site-nav { display: flex; align-items: center; justify-content: center; gap: var(--sp-3); margin: 0 var(--sp-2); }
        .site-nav a { color: rgba(255,255,255,0.85); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); letter-spacing: 0.4px; text-transform: uppercase; position: relative; padding-bottom: 4px; }
        .site-nav a::after { content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 2px; background: var(--gold-400); transition: width 0.25s ease; }
        .site-nav a:hover { color: #fff; }
        .site-nav a:hover::after { width: 100%; }

        /* --- FIXED HEADER --- */
        .sticky-top-section {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            background: rgba(10, 31, 68, 0.85);
            backdrop-filter: blur(16px) saturate(150%); -webkit-backdrop-filter: blur(16px) saturate(150%);
            border-bottom: 1px solid rgba(244, 180, 0, 0.25);
            box-shadow: 0 4px 25px rgba(0,0,0,0.35);
            padding: var(--sp-2) var(--sp-4);
            display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--sp-2);
        }

        body.dark-mode .sticky-top-section { background: rgba(4, 8, 18, 0.92); border-bottom: 1px solid rgba(244, 180, 0, 0.15); }

        .nav-left { display: flex; align-items: center; justify-content: flex-start; gap: var(--sp-2); }
        .nav-left img { width: 48px; height: 48px; object-fit: contain; }
        .header-text-container { display: flex; flex-direction: column; justify-content: center; }
        .header-title { font-size: var(--fs-lg); font-weight: 800; color: #ffffff; margin: 0; text-transform: uppercase; letter-spacing: 0.5px; text-shadow: 0 2px 5px rgba(0,0,0,0.5); line-height: 1.3; }
        .header-subtitle { font-size: var(--fs-sm); color: var(--gold-400); font-weight: 600; margin: 0; letter-spacing: 1px; line-height: 1.4; }

        .nav-right { display: flex; align-items: center; justify-content: flex-end; gap: var(--sp-2); }
        .period-select {
            padding: var(--sp-1) var(--sp-2); border-radius: 50px; border: 1px solid rgba(255,255,255,0.4);
            background: rgba(255, 255, 255, 0.1); color: white; font-weight: 600; font-size: var(--fs-sm);
            outline: none; cursor: pointer;
        }
        .period-select:hover { border-color: var(--gold-400); background: rgba(255, 255, 255, 0.2); }
        .period-select option { background: var(--navy-900); color: white; }

        .auth-buttons { display: flex; align-items: center; gap: var(--sp-2); }
        .auth-buttons .btn { border-radius: 50px; font-weight: 700; padding: var(--sp-1) var(--sp-3); font-size: var(--fs-sm); }
        .btn-admin { background: linear-gradient(135deg, var(--gold-500), var(--gold-400)); color: var(--navy-950); border: none; box-shadow: 0 4px 14px rgba(244, 180, 0, 0.45); position: relative; will-change: transform; }
        .btn-admin:hover { filter: brightness(1.08); color: var(--navy-950); }

        /* --- SPACER for fixed header --- */
        #header-spacer { width: 100%; }

        /* --- SECTION HEADING HELPER --- */
        .section-eyebrow { display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-1); font-size: var(--fs-xs); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: var(--gold-500); margin-bottom: var(--sp-1); line-height: 1.4; }
        .section-eyebrow::before { content: ''; width: 28px; height: 2px; background: var(--gold-500); display: inline-block; flex-shrink: 0; }
        .section-title { font-family: 'Playfair Display', serif; font-weight: 800; font-size: var(--fs-3xl); color: var(--navy-900); margin: 0 0 var(--sp-3); }
        body.dark-mode .section-title { color: #f8fafc; }

        /* ---------------------------------------------------------------
           PERFORMANCE UTILITIES
           Every animated interaction below moves ONLY transform/opacity.
           Glow/lift effects use a pseudo-element whose OPACITY fades in —
           the box-shadow value itself is static, so nothing repaints the
           shadow geometry on hover.
        --------------------------------------------------------------- */
        .magnetic { display: inline-flex; will-change: transform; }

        .glow-card { position: relative; isolation: isolate; will-change: transform; }
        .glow-card::after {
            content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
            background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(255,199,44,0.65), transparent 45%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor; mask-composite: exclude;
            opacity: 0; transition: opacity 0.35s ease; pointer-events: none; z-index: 2; will-change: opacity;
        }
        .glow-card:hover::after { opacity: 1; }
        .glow-card:hover { transform: translateY(-6px); }

        .pop-glow { position: relative; will-change: transform; }
        .pop-glow::before {
            content: ''; position: absolute; inset: -6px; border-radius: inherit;
            box-shadow: 0 14px 34px rgba(244,180,0,0.45);
            opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: -1; will-change: opacity;
        }
        .pop-glow:hover::before { opacity: 1; }

        /* =========================================================
           HERO SECTION — minimal, static background, pure CSS entrance
           (no JS required at all for this section: everything below is a
           plain @keyframes fade-up with a staggered animation-delay)
        ========================================================= */
        .hero-section {
            min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
            position: relative; text-align: center; padding: var(--sp-12) var(--sp-4) var(--sp-12);
            background:
                linear-gradient(180deg, rgba(6,14,33,0.88) 0%, rgba(10,31,68,0.82) 100%),
                url('<%- landingContent.hero.imageUrl %>');
            background-size: cover;
            background-position: center;
        }
        body.dark-mode .hero-section {
            background:
                linear-gradient(180deg, rgba(4,8,18,0.92) 0%, rgba(6,14,33,0.88) 100%),
                url('<%- landingContent.hero.imageUrl %>');
            background-size: cover;
            background-position: center;
        }

        .hero-content { max-width: 55rem; }

        @keyframes heroFadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .hero-eyebrow, .hero-title, .hero-subtitle, .hero-cta-group {
            opacity: 0; animation: heroFadeUp 0.6s ease-out forwards;
        }
        .hero-eyebrow { animation-delay: 0.1s; }
        .hero-title { animation-delay: 0.25s; }
        .hero-subtitle { animation-delay: 0.45s; }
        .hero-cta-group { animation-delay: 0.6s; }

        .hero-eyebrow { color: var(--gold-400); justify-content: center; }
        .hero-eyebrow::before { background: var(--gold-400); }

        .hero-title { font-family: 'Playfair Display', serif; font-weight: 800; font-size: var(--fs-hero); color: #f8fafc; line-height: 1.15; margin: var(--sp-2) 0 var(--sp-3); text-shadow: 0 4px 20px rgba(0,0,0,0.4); }
        .hero-title .line { display: block; }
        .hero-title .gold-text { color: var(--gold-400); font-weight: 800; }

        .hero-subtitle { max-width: 42.5rem; margin: 0 auto var(--sp-5); color: rgba(255,255,255,0.8); font-size: var(--fs-lg); line-height: 1.6; font-weight: 400; }
        .hero-cta-group { display: flex; align-items: center; justify-content: center; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-6); }

        .btn-hero { border-radius: 50px; font-weight: 700; font-size: var(--fs-sm); padding: var(--sp-2) var(--sp-4); text-decoration: none; display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-1); }
        .btn-hero-primary { background: linear-gradient(135deg, var(--gold-500), var(--gold-400)); color: var(--navy-950); box-shadow: 0 10px 30px rgba(244,180,0,0.4); }
        .btn-hero-primary:hover { filter: brightness(1.08); }
        .btn-hero-secondary { background: rgba(255,255,255,0.06); color: #fff; border: 1px solid rgba(255,255,255,0.35); }
        .btn-hero-secondary:hover { background: rgba(255,255,255,0.14); border-color: var(--gold-400); }

        .hero-scroll-cue {
            /* Centered via left/right/margin-auto (not transform: translateX), because the
               fade-in animation below also animates `transform` (translateY) — and a CSS
               animation replaces the whole transform value, so a static translateX(-50%)
               here would get wiped out the moment the animation runs. */
            position: absolute; bottom: var(--sp-4); left: 0; right: 0; margin-left: auto; margin-right: auto; width: max-content;
            color: rgba(255,255,255,0.6); font-size: var(--fs-xs); letter-spacing: 2.5px; text-transform: uppercase;
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--sp-1); font-weight: 700;
            opacity: 0; animation: heroFadeUp 0.6s ease-out forwards; animation-delay: 0.8s;
        }

        @keyframes heroCueBounce {
            0%, 100% { transform: translateY(0); opacity: 0.6; }
            50% { transform: translateY(8px); opacity: 1; }
        }
        .hero-scroll-cue-icon { display: inline-block; animation: heroCueBounce 2s ease-in-out infinite; }

        @media (max-width: 36rem) {
            .hero-section { padding: var(--sp-10) var(--sp-2) var(--sp-8); }
        }
        @media (prefers-reduced-motion: reduce) {
            .hero-eyebrow, .hero-title, .hero-subtitle, .hero-cta-group, .hero-scroll-cue { animation: none; opacity: 1; }
            .hero-scroll-cue-icon { animation: none; }
        }

        /* =========================================================
           ABOUT SECTION
        ========================================================= */
        .about-section { padding: var(--sp-10) var(--sp-4); scroll-margin-top: 6.5rem; }
        .about-grid { max-width: 75rem; margin: 0 auto; display: grid; grid-template-columns: 21.25rem 1fr; gap: var(--sp-7); align-items: center; }

        .profile-card {
            background: linear-gradient(160deg, var(--navy-900), var(--navy-700));
            border-radius: var(--sp-3); padding: var(--sp-4) var(--sp-3) var(--sp-3); text-align: center;
            box-shadow: 0 20px 45px rgba(10,31,68,0.35); border: 1px solid rgba(244,180,0,0.25);
            position: relative; overflow: hidden;
        }
        .profile-card::before {
            content: ''; position: absolute; top: -40%; right: -30%; width: 220px; height: 220px;
            background: radial-gradient(circle, rgba(244,180,0,0.25), transparent 70%); border-radius: 50%;
        }

        .profile-avatar {
            width: 140px; height: 140px; margin: 0 auto var(--sp-2); border-radius: 50%;
            background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
            display: flex; align-items: center; justify-content: center;
            font-size: 3.5rem; color: var(--navy-950); border: 4px solid rgba(255,255,255,0.85);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3); position: relative; z-index: 1;
        }
        .profile-name { color: #fff; font-weight: 800; font-size: var(--fs-lg); margin: 0; letter-spacing: 0.4px; position: relative; z-index: 1; line-height: 1.3; }
        .profile-role { color: var(--gold-300); font-weight: 600; font-size: var(--fs-sm); margin: var(--sp-1) 0 var(--sp-2); position: relative; z-index: 1; line-height: 1.4; }
        .profile-divider { width: 60px; height: 2px; background: rgba(244,180,0,0.5); margin: 0 auto var(--sp-2); position: relative; z-index: 1; }
        .profile-contact { display: flex; flex-direction: column; align-items: center; gap: var(--sp-1); font-size: var(--fs-sm); color: rgba(255,255,255,0.85); position: relative; z-index: 1; }
        .profile-contact span { display: flex; align-items: center; justify-content: center; gap: var(--sp-1); }
        .profile-contact a { color: var(--gold-300); text-decoration: none; }
        .profile-contact a:hover { text-decoration: underline; }
        .profile-contact i { width: 16px; color: var(--gold-400); text-align: center; }

        .about-text { color: #1e293b; }
        body.dark-mode .about-text { color: #e2e8f0; }
        .about-text p { font-size: var(--fs-lg); line-height: 1.75; font-weight: 400; margin: 0; }
        .about-badges { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
        .about-badge {
            display: inline-flex; align-items: center; justify-content: center; gap: var(--sp-1); padding: var(--sp-1) var(--sp-2); border-radius: 50px;
            background: rgba(10,31,68,0.06); border: 1px solid rgba(10,31,68,0.15); color: var(--navy-900);
            font-weight: 700; font-size: var(--fs-sm); will-change: transform;
        }
        body.dark-mode .about-badge { background: rgba(244,180,0,0.08); border-color: rgba(244,180,0,0.25); color: var(--gold-300); }
        .about-badge i { color: var(--gold-500); }
        .about-badge:hover { transform: translateY(-3px); }

        @media (max-width: 54rem) {
            .about-grid { grid-template-columns: 1fr; text-align: center; }
            .profile-card { max-width: 21.25rem; margin: 0 auto; }
            .about-badges { justify-content: center; }
        }

        /* =========================================================
           ORGANIZATIONAL STRUCTURE SECTION
        ========================================================= */
        .org-section { padding: var(--sp-6) var(--sp-4) var(--sp-10); scroll-margin-top: 6.5rem; text-align: center; }
        .org-wrap { max-width: 75rem; margin: 0 auto; }

        .org-tree { display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .org-node {
            display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--sp-1);
            background: #ffffff; border-radius: var(--sp-2); padding: var(--sp-2) var(--sp-3); width: 13.75rem;
            box-shadow: 0 10px 25px rgba(10,31,68,0.12); border: 1px solid rgba(10,31,68,0.08);
        }
        body.dark-mode .org-node { background: rgba(20, 33, 61, 0.95); border-color: rgba(244,180,0,0.12); }

        .org-avatar {
            width: 58px; height: 58px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--navy-800), var(--navy-900)); color: var(--gold-400); font-size: var(--fs-xl);
            border: 2px solid var(--gold-400); will-change: transform;
        }
        .org-node:hover .org-avatar { transform: scale(1.08); }
        .org-node.top .org-avatar { background: linear-gradient(135deg, var(--gold-400), var(--gold-500)); color: var(--navy-950); border-color: var(--navy-900); }
        .org-name { font-weight: 800; font-size: var(--fs-sm); color: var(--navy-900); margin: 0; line-height: 1.35; }
        body.dark-mode .org-name { color: #f8fafc; }
        .org-role { font-size: var(--fs-xs); font-weight: 600; color: #64748b; margin: 0; line-height: 1.5; }
        body.dark-mode .org-role { color: #94a3b8; }

        .org-connector { width: 2px; height: var(--sp-3); background: var(--gold-500); }

        .org-team-box {
            border: 2px dashed rgba(244,180,0,0.5); border-radius: var(--sp-3); padding: var(--sp-5) var(--sp-3) var(--sp-3);
            width: 100%; position: relative;
        }
        .org-team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4) var(--sp-3); justify-items: center; align-items: start; }
        .org-team-row + .org-team-row { margin-top: var(--sp-4); }
        .org-student-aide {
            margin-top: var(--sp-4); display: inline-flex; align-items: center; justify-content: center; padding: var(--sp-1) var(--sp-4);
            border-radius: 50px; background: var(--navy-900); color: #fff; font-weight: 700; font-size: var(--fs-sm);
            box-shadow: 0 8px 20px rgba(10,31,68,0.25);
        }

        @media (max-width: 54rem) {
            .org-team-grid { grid-template-columns: 1fr; gap: var(--sp-3); }
            .org-node { width: 100%; max-width: 16.25rem; }
        }

        /* =========================================================
           OUR SERVICES SECTION — flat accordion, one row per unit
           Cluster > Office > Services. Clusters are plain horizontal tabs
           (no framework, no extra JS libs); offices inside the active
           cluster render as a flat accordion. Expand/collapse animates a
           single grid-template-rows value — cheap even with ~40 offices.
        ========================================================= */
        .services-section {
            padding: var(--sp-10) var(--sp-4); scroll-margin-top: 6rem;
            background: linear-gradient(180deg, var(--navy-950) 0%, var(--navy-900) 100%);
        }
        .services-header { text-align: center; max-width: 47.5rem; margin: 0 auto var(--sp-6); }
        .services-header .section-eyebrow { color: var(--gold-400); justify-content: center; }
        .services-header .section-eyebrow::before { background: var(--gold-400); }
        .services-header .section-title { color: #fff; }
        .services-header p { color: rgba(255,255,255,0.65); font-size: var(--fs-base); line-height: 1.6; margin: 0; }

        .services-wrap { max-width: 50rem; margin: 0 auto; }

        /* --- Cluster tabs (level 1) --- */
        .cluster-tabs { display: flex; flex-wrap: wrap; align-items: stretch; justify-content: center; gap: var(--sp-2); margin: 0 0 var(--sp-4); }
        .cluster-tab-btn {
            flex: 1 1 11rem; display: flex; align-items: center; justify-content: center; gap: var(--sp-2);
            padding: var(--sp-2) var(--sp-3); border-radius: 50px; background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.68); font-weight: 700;
            font-size: var(--fs-sm); font-family: inherit; cursor: pointer; text-align: center;
        }
        .cluster-tab-btn i { color: var(--gold-400); flex-shrink: 0; }
        .cluster-tab-btn:hover { background: rgba(255,255,255,0.08); color: #fff; }
        .cluster-tab-btn.active {
            background: linear-gradient(135deg, rgba(244,180,0,0.22), rgba(244,180,0,0.06));
            border-color: rgba(244,180,0,0.5); color: #fff;
        }

        /* --- Offices within the active cluster (level 2, accordion) --- */
        .services-accordion { display: flex; flex-direction: column; gap: var(--sp-2); }

        .accordion-item { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--sp-2); }
        .accordion-item.open { border-color: rgba(244,180,0,0.3); }

        .accordion-header {
            width: 100%; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-2);
            padding: var(--sp-2) var(--sp-3); background: transparent; border: none; border-radius: var(--sp-2);
            color: #fff; text-align: left; cursor: pointer; font-family: inherit;
        }
        .accordion-header:hover { background: rgba(255,255,255,0.05); }

        .accordion-header-left { display: flex; align-items: center; justify-content: flex-start; gap: var(--sp-2); min-width: 0; }
        .accordion-icon {
            width: 36px; height: 36px; border-radius: var(--sp-1); background: linear-gradient(135deg, var(--gold-400), var(--gold-500));
            display: flex; align-items: center; justify-content: center; color: var(--navy-950); font-size: var(--fs-sm); flex-shrink: 0;
        }
        .accordion-text { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
        .accordion-name { font-weight: 700; font-size: var(--fs-sm); color: #fff; line-height: 1.4; }
        .accordion-count { font-size: var(--fs-xs); color: rgba(255,255,255,0.5); font-weight: 600; line-height: 1.5; }

        .accordion-chevron { color: var(--gold-400); flex-shrink: 0; transition: transform 0.3s ease; will-change: transform; }
        .accordion-item.open .accordion-chevron { transform: rotate(180deg); }

        .accordion-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s ease; }
        .accordion-item.open .accordion-panel { grid-template-rows: 1fr; }
        .accordion-panel-inner { overflow: hidden; }

        .accordion-list { list-style: none; margin: 0; padding: 0 var(--sp-3) var(--sp-3); display: flex; flex-direction: column; gap: var(--sp-1); }
        .accordion-list li { display: flex; align-items: flex-start; gap: var(--sp-1); font-size: var(--fs-sm); color: rgba(255,255,255,0.68); line-height: 1.6; }
        .accordion-list i { color: var(--gold-400); font-size: 0.55rem; margin-top: 0.5rem; flex-shrink: 0; }

        @media (max-width: 36rem) {
            .services-section { padding: var(--sp-6) var(--sp-2); }
        }

        /* =========================================================
           DASHBOARD SECTION — transform-driven marquee (no scrollLeft)
        ========================================================= */
        .dashboard-section { padding: var(--sp-2) 0 var(--sp-10); scroll-margin-top: 6rem; }
        .dashboard-toolbar { display: flex; justify-content: center; max-width: 75rem; margin: 0 auto var(--sp-4); padding: 0 var(--sp-4); }
        .dashboard-period-select {
            border-color: rgba(15, 23, 42, 0.2); background: rgba(15, 23, 42, 0.04); color: var(--navy-900);
        }
        .dashboard-period-select:hover { border-color: var(--gold-500); background: rgba(15, 23, 42, 0.08); }
        .dashboard-period-select option { background: #ffffff; color: var(--navy-900); }
        body.dark-mode .dashboard-period-select { border-color: rgba(255,255,255,0.4); background: rgba(255, 255, 255, 0.1); color: white; }
        body.dark-mode .dashboard-period-select option { background: var(--navy-900); color: white; }
        .dashboard-header-block { text-align: center; max-width: 43.75rem; margin: 0 auto var(--sp-4); padding: 0 var(--sp-4); }
        .dashboard-header-block p { color: #64748b; font-size: var(--fs-base); line-height: 1.7; margin: 0; }
        body.dark-mode .dashboard-header-block p { color: #94a3b8; }

        .dashboard-container {
            display: flex; align-items: center; width: 100%; position: relative; overflow: hidden;
            background: rgba(255,255,255,0.45); backdrop-filter: blur(20px) saturate(140%); -webkit-backdrop-filter: blur(20px) saturate(140%);
            border: 1px solid rgba(10,31,68,0.06); border-radius: var(--sp-4); margin: 0 auto; max-width: 87.5rem;
        }
        body.dark-mode .dashboard-container { background: rgba(15, 23, 42, 0.45); border-color: rgba(244,180,0,0.08); }

        .charts-track {
            display: flex; gap: var(--sp-4); padding: var(--sp-4); align-items: stretch;
            will-change: transform; touch-action: pan-y;
        }

        .chart-card {
            background: #ffffff; border: none; border-radius: var(--sp-3); box-shadow: 0 10px 40px rgba(10, 31, 68, 0.08);
            display: flex; flex-direction: column; height: 70vh; min-width: 45vw; flex-shrink: 0;
            opacity: 0; transform: translateY(60px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
            border: 1px solid rgba(10,31,68,0.04); will-change: transform, opacity;
        }
        .chart-card.visible { opacity: 1; transform: translateY(0); }
        .chart-card:hover { transform: translateY(-8px); }

        body.dark-mode .chart-card { background: rgba(30, 41, 59, 0.95); backdrop-filter: blur(10px); box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45); border-color: rgba(244,180,0,0.06); }

        .card-header-custom { padding: var(--sp-3) var(--sp-4) var(--sp-2); border-bottom: 1px solid rgba(10,31,68,0.04); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; gap: var(--sp-2); }
        body.dark-mode .card-header-custom { border-bottom: 1px solid rgba(255,255,255,0.05); }

        .chart-title { font-size: var(--fs-lg); font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #52627a; margin: 0; line-height: 1.3; }
        body.dark-mode .chart-title { color: #e2e8f0; }

        .btn-back-custom { font-size: var(--fs-sm); font-weight: 600; padding: var(--sp-1) var(--sp-2); border-radius: var(--sp-1); }
        .canvas-container { position: relative; flex-grow: 1; padding: var(--sp-2) var(--sp-4) var(--sp-4); display: flex; justify-content: center; align-items: center; }
        .hint-text { font-size: var(--fs-sm); color: #a3adc2; margin-top: var(--sp-1); font-weight: 500; line-height: 1.5; }
        body.dark-mode .hint-text { color: #64748b; }

        /* =========================================================
           FOOTER
        ========================================================= */
        .site-footer {
            background: linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 100%);
            color: rgba(255,255,255,0.65); position: relative; overflow: hidden;
        }
        .site-footer::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, transparent, var(--gold-400), transparent);
        }
        .footer-main { max-width: 75rem; margin: 0 auto; padding: var(--sp-8) var(--sp-4) var(--sp-5); display: grid; grid-template-columns: 1.4fr 1fr 1.2fr 1fr; gap: var(--sp-5); }

        .footer-brand-logo { display: flex; align-items: center; justify-content: flex-start; gap: var(--sp-2); margin-bottom: var(--sp-2); }
        .footer-brand-logo img { width: 42px; height: 42px; object-fit: contain; }
        .footer-brand-title { color: #fff; font-weight: 800; font-size: var(--fs-base); margin: 0; line-height: 1.35; }
        .footer-brand-title span { display: block; color: var(--gold-400); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.5px; margin-top: 2px; }
        .footer-desc { font-size: var(--fs-sm); line-height: 1.7; color: rgba(255,255,255,0.55); margin: 0; }

        .footer-heading { color: #fff; font-weight: 800; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 1px; margin-bottom: var(--sp-3); position: relative; padding-bottom: var(--sp-1); line-height: 1.4; }
        .footer-heading::after { content: ''; position: absolute; left: 0; bottom: 0; width: 32px; height: 2px; background: var(--gold-400); }

        .footer-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-2); }
        .footer-links a { color: rgba(255,255,255,0.62); text-decoration: none; font-size: var(--fs-sm); font-weight: 500; display: inline-flex; align-items: center; justify-content: flex-start; gap: var(--sp-1); will-change: transform; }
        .footer-links a i { font-size: var(--fs-xs); color: var(--gold-400); will-change: transform; }
        .footer-links a:hover { color: var(--gold-300); transform: translateX(4px); }

        .footer-contact { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
        .footer-contact li { display: flex; align-items: flex-start; justify-content: flex-start; gap: var(--sp-2); font-size: var(--fs-sm); color: rgba(255,255,255,0.62); line-height: 1.5; }
        .footer-contact i { color: var(--gold-400); font-size: var(--fs-base); width: 16px; margin-top: 2px; flex-shrink: 0; text-align: center; }
        .footer-contact a { color: rgba(255,255,255,0.62); text-decoration: none; }
        .footer-contact a:hover { color: var(--gold-300); }

        .footer-socials { display: flex; align-items: center; justify-content: flex-start; gap: var(--sp-2); margin-top: var(--sp-1); }
        .footer-socials a {
            width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; font-size: var(--fs-base);
            will-change: transform;
        }
        .footer-socials a:hover {
            background: linear-gradient(135deg, var(--gold-500), var(--gold-400)); color: var(--navy-950);
            border-color: transparent;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1); padding: var(--sp-3) var(--sp-4); text-align: center;
            font-size: var(--fs-sm); color: rgba(255,255,255,0.5); line-height: 1.6;
        }
        .footer-bottom strong { color: var(--gold-400); }

        @media (max-width: 62rem) {
            .footer-main { grid-template-columns: 1fr 1fr; gap: var(--sp-5) var(--sp-4); }
        }
        @media (max-width: 36rem) {
            .footer-main { grid-template-columns: 1fr; padding: var(--sp-6) var(--sp-3) var(--sp-4); gap: var(--sp-4); text-align: center; }
            .footer-heading::after { left: 50%; transform: translateX(-50%); }
            .footer-brand-logo { justify-content: center; }
            .footer-links { align-items: center; }
            .footer-socials { justify-content: center; }
            .footer-contact li { justify-content: center; text-align: left; }
        }

        @media (max-width: 62rem) {
            .chart-card { min-width: 80vw; height: 60vh; }
            .sticky-top-section { flex-direction: column; align-items: flex-start; }
            .nav-right { width: 100%; justify-content: space-between; }
            .site-nav { display: none; }
        }
        @media (max-width: 36rem) {
            .header-text-container { display: none; }
            .chart-card { min-width: 90vw; height: 60vh; }
            .about-section, .org-section { padding-left: var(--sp-2); padding-right: var(--sp-2); }
        }

        /* Respect reduced-motion preference: kill parallax/float, keep instant states */
        @media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
        }
    </style>
</head>
<body>

    <div class="bg-image"></div>
    <div class="bg-overlay"></div>

    <div class="sticky-top-section" id="siteHeader">
        <div class="nav-left">
            <img src="<%= landingContent.branding.logoUrl %>" alt="Camarines Sur Polytechnic Colleges Logo">
            <div class="header-text-container">
                <h1 class="header-title"><%= landingContent.branding.title %></h1>
                <p class="header-subtitle"><%= landingContent.branding.subtitle %></p>
            </div>
        </div>

        <nav class="site-nav">
            <a href="#about">About</a>
            <a href="#structure">Structure</a>
            <a href="#services">Services</a>
            <a href="#dashboard">Dashboard</a>
        </nav>

        <div class="nav-right">
            <div class="auth-buttons">
                <a href="/login" class="btn btn-admin magnetic"><i class="fas fa-sign-in-alt me-1 d-none d-sm-inline"></i> <%= landingContent.branding.loginLabel %></a>
            </div>
        </div>
    </div>

    <div id="header-spacer"></div>

    <div class="page-content">

        <!-- ================= HERO SECTION ================= -->
        <section class="hero-section" id="hero">
            <div class="hero-content">
                <span class="section-eyebrow hero-eyebrow"><%= landingContent.hero.eyebrow %></span>
                <h1 class="hero-title">
                    <span class="line"><%= landingContent.hero.titleLine1 %></span>
                    <span class="line"><%= landingContent.hero.titleLine2 %></span>
                </h1>
                <p class="hero-subtitle">
                    <%= landingContent.hero.subtext %>
                </p>
                <div class="hero-cta-group">
                    <a href="<%= landingContent.hero.cta1Link %>" class="btn-hero btn-hero-primary magnetic"><i class="fas fa-chart-pie"></i> <%= landingContent.hero.cta1Text %></a>
                    <a href="<%= landingContent.hero.cta2Link %>" class="btn-hero btn-hero-secondary magnetic"><i class="fas fa-layer-group"></i> <%= landingContent.hero.cta2Text %></a>
                </div>
            </div>

            <div class="hero-scroll-cue">
                <span class="hero-scroll-cue-text">Scroll</span>
                <i class="fas fa-chevron-down hero-scroll-cue-icon"></i>
            </div>
        </section>

        <!-- ================= ABOUT CQA SECTION ================= -->
        <section class="about-section" id="about">
            <div class="about-grid">
                <div class="profile-card glow-card" data-reveal="fade-right">
                    <div class="profile-avatar"><i class="fas fa-user-tie"></i></div>
                    <p class="profile-name"><%= landingContent.about.headName %></p>
                    <p class="profile-role"><%= landingContent.about.headRole %></p>
                    <div class="profile-divider"></div>
                    <div class="profile-contact">
                        <span><i class="fas fa-envelope"></i> <a href="mailto:<%= landingContent.about.headEmail %>"><%= landingContent.about.headEmail %></a></span>
                        <span><i class="fas fa-phone"></i> <%= landingContent.about.headPhone %></span>
                    </div>
                </div>

                <div class="about-text" data-reveal="fade-up" data-reveal-delay="150">
                    <span class="section-eyebrow"><%= landingContent.about.eyebrow %></span>
                    <h2 class="section-title"><%= landingContent.about.title %></h2>
                    <p>
                        <%= landingContent.about.paragraph %>
                    </p>
                    <div class="about-badges">
                        <span class="about-badge pop-glow"><i class="fas fa-award"></i> <%= landingContent.about.badge1 %></span>
                        <span class="about-badge pop-glow"><i class="fas fa-shield-halved"></i> <%= landingContent.about.badge2 %></span>
                        <span class="about-badge pop-glow"><i class="fas fa-chart-line"></i> <%= landingContent.about.badge3 %></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= ORGANIZATIONAL STRUCTURE SECTION ================= -->
        <section class="org-section" id="structure">
            <div class="org-wrap">
                <span class="section-eyebrow"><%= landingContent.org.eyebrow %></span>
                <h2 class="section-title"><%= landingContent.org.title %></h2>

                <div class="org-tree">
                    <div class="org-node top glow-card" data-reveal="zoom-in">
                        <div class="org-avatar"><i class="fas fa-user-graduate"></i></div>
                        <p class="org-name"><%= landingContent.org.lead1Name %></p>
                        <p class="org-role"><%= landingContent.org.lead1Role %></p>
                    </div>
                    <div class="org-connector"></div>

                    <div class="org-node top glow-card" data-reveal="zoom-in" data-reveal-delay="100">
                        <div class="org-avatar"><i class="fas fa-user-graduate"></i></div>
                        <p class="org-name"><%= landingContent.org.lead2Name %></p>
                        <p class="org-role"><%= landingContent.org.lead2Role %></p>
                    </div>
                    <div class="org-connector"></div>

                    <div class="org-node top glow-card" data-reveal="zoom-in" data-reveal-delay="200">
                        <div class="org-avatar"><i class="fas fa-user-tie"></i></div>
                        <p class="org-name"><%= landingContent.org.lead3Name %></p>
                        <p class="org-role"><%= landingContent.org.lead3Role %></p>
                    </div>
                    <div class="org-connector"></div>

                    <div class="org-team-box">
                        <div class="org-team-grid org-team-row">
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="0">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team1Name %></p>
                                <p class="org-role"><%= landingContent.org.team1Role %></p>
                            </div>
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="100">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team2Name %></p>
                                <p class="org-role"><%= landingContent.org.team2Role %></p>
                            </div>
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="200">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team3Name %></p>
                                <p class="org-role"><%= landingContent.org.team3Role %></p>
                            </div>
                        </div>

                        <div class="org-team-grid org-team-row">
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="0">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team4Name %></p>
                                <p class="org-role"><%= landingContent.org.team4Role %></p>
                            </div>
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="100">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team5Name %></p>
                                <p class="org-role"><%= landingContent.org.team5Role %></p>
                            </div>
                            <div class="org-node glow-card" data-reveal="fade-up" data-reveal-delay="200">
                                <div class="org-avatar"><i class="fas fa-user"></i></div>
                                <p class="org-name"><%= landingContent.org.team6Name %></p>
                                <p class="org-role"><%= landingContent.org.team6Role %></p>
                            </div>
                        </div>

                        <div class="org-student-aide" data-reveal="fade-up" data-reveal-delay="300"><i class="fas fa-user-graduate me-2"></i><%= landingContent.org.aideLabel %></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= OUR SERVICES SECTION ================= -->
        <section class="services-section" id="services">
            <div class="services-header" data-reveal="fade-up">
                <span class="section-eyebrow"><%= landingContent.services.eyebrow %></span>
                <h2 class="section-title"><%= landingContent.services.title %></h2>
                <p><%= landingContent.services.desc %></p>
            </div>

            <div class="services-wrap" data-reveal="fade-up">
                <div class="cluster-tabs" id="clusterTabs"></div>
                <div class="services-accordion" id="servicesAccordion"></div>
            </div>
        </section>

        <!-- ================= TRANSPARENCY DASHBOARD ================= -->
        <section class="dashboard-section" id="dashboard">
            <div class="dashboard-header-block">
                <span class="section-eyebrow">Data &amp; Transparency</span>
                <h2 class="section-title">Transparency Dashboard</h2>
                <p>Live satisfaction survey results across clusters and offices. Hover to see details, click to drill down.</p>
            </div>

            <div class="dashboard-toolbar">
                <select id="periodSelect" class="period-select dashboard-period-select" onchange="changePeriod()">
                    <option value="p1">Jan - Jun 2026</option>
                    <option value="p2">Jul - Dec 2026</option>
                </select>
            </div>

            <div class="dashboard-container">
                <div class="charts-track" id="chartsTrack">

                    <div class="chart-card" id="card-c1">
                        <div class="card-header-custom">
                            <div>
                                <h3 id="c1-title" class="chart-title" data-main="Overall Ratings" data-drill="Total Overall Rating">Overall Ratings</h3>
                                <div class="hint-text"><i class="fas fa-hand-pointer me-1"></i>Hover to see details • Click to drilldown</div>
                            </div>
                            <button id="c1-back" onclick="goBack('c1')" class="btn btn-sm btn-primary btn-back-custom d-none"><i class="fas fa-arrow-left me-1"></i> BACK</button>
                        </div>
                        <div class="canvas-container"><canvas id="c1" style="cursor: pointer;"></canvas></div>
                    </div>

                    <div class="chart-card" id="card-c2">
                        <div class="card-header-custom">
                            <div>
                                <h3 id="c2-title" class="chart-title" data-main="Satisfaction by Cluster" data-drill="Cluster Rating">Satisfaction by Cluster</h3>
                                <div class="hint-text"><i class="fas fa-hand-pointer me-1"></i>Hover to see details • Click to drilldown</div>
                            </div>
                            <button id="c2-back" onclick="goBack('c2')" class="btn btn-sm btn-primary btn-back-custom d-none"><i class="fas fa-arrow-left me-1"></i> BACK</button>
                        </div>
                        <div class="canvas-container"><canvas id="c2" style="cursor: pointer;"></canvas></div>
                    </div>

                    <div class="chart-card" id="card-c3">
                        <div class="card-header-custom">
                            <div>
                                <h3 id="c3-title" class="chart-title" data-main="Satisfaction By Office" data-drill="Office Rating">Satisfaction By Office</h3>
                                <div class="hint-text"><i class="fas fa-hand-pointer me-1"></i>Hover to see details • Click to drilldown</div>
                            </div>
                            <button id="c3-back" onclick="goBack('c3')" class="btn btn-sm btn-primary btn-back-custom d-none"><i class="fas fa-arrow-left me-1"></i> BACK</button>
                        </div>
                        <div class="canvas-container"><canvas id="c3" style="cursor: pointer;"></canvas></div>
                    </div>

                    <div class="chart-card" id="card-c4">
                        <div class="card-header-custom">
                            <div>
                                <h3 id="c4-title" class="chart-title" data-main="CC Awareness" data-drill="CC Awareness Breakdown">CC Awareness</h3>
                                <div class="hint-text"><i class="fas fa-hand-pointer me-1"></i>Click chart for details</div>
                            </div>
                            <button id="c4-back" onclick="goBack('c4')" class="btn btn-sm btn-primary btn-back-custom d-none"><i class="fas fa-arrow-left me-1"></i> BACK</button>
                        </div>
                        <div class="canvas-container"><canvas id="c4" style="cursor: pointer;"></canvas></div>
                    </div>

                </div>
            </div>
        </section>

        <footer class="site-footer" data-reveal="fade-up">
            <div class="footer-main">
                <div class="footer-col footer-brand">
                    <div class="footer-brand-logo">
                        <img src="<%= landingContent.branding.logoUrl %>" alt="CSPC Logo">
                        <p class="footer-brand-title"><%= landingContent.branding.title %><span><%= landingContent.about.title %></span></p>
                    </div>
                    <p class="footer-desc">
                        <%= landingContent.footer.desc %>
                    </p>
                </div>

                <div class="footer-col">
                    <h4 class="footer-heading">Quick Links</h4>
                    <ul class="footer-links">
                        <li><a href="#about"><i class="fas fa-chevron-right"></i> About Us</a></li>
                        <li><a href="#structure"><i class="fas fa-chevron-right"></i> Governance</a></li>
                        <li><a href="#services"><i class="fas fa-chevron-right"></i> Our Services</a></li>
                        <li><a href="#dashboard"><i class="fas fa-chevron-right"></i> Transparency Dashboard</a></li>
                        <li><a href="/login"><i class="fas fa-chevron-right"></i> Admin Login</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4 class="footer-heading">Contact Us</h4>
