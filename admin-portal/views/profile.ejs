<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        .profile-hero {
            position: relative;
            border-radius: 1rem;
            padding: 2.5rem 2rem 2rem;
            background: linear-gradient(120deg, #251d3a 0%, #251d3a 55%, #2a2550 100%);
            overflow: hidden;
            color: #fff;
            isolation: isolate;
        }
        .profile-hero::before,
        .profile-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            z-index: -1;
        }
        .profile-hero::before {
            width: 260px;
            height: 260px;
            top: -120px;
            right: -60px;
        }
        .profile-hero::after {
            width: 160px;
            height: 160px;
            bottom: -80px;
            left: 10%;
            background: rgba(255, 255, 255, 0.06);
        }
        .profile-avatar-ring {
            width: 108px;
            height: 108px;
            border-radius: 50%;
            padding: 4px;
            background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.35));
            flex-shrink: 0;
        }
        .profile-avatar-ring img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            border: 3px solid #fff;
        }
        .profile-hero-name {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 0.15rem;
        }
        .profile-hero-username {
            font-size: 0.92rem;
            color: rgba(255, 255, 255, 0.78);
            font-weight: 500;
        }
        .profile-hero-username::before {
            content: "@";
            opacity: 0.7;
        }
        .btn-hero-photo {
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.35);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.4rem 0.9rem;
            border-radius: 999px;
            transition: background 0.15s ease;
        }
        .btn-hero-photo:hover {
            background: rgba(255, 255, 255, 0.24);
            color: #fff;
        }

        .info-tile {
            border: 1px solid #eef0f5;
            border-radius: 0.85rem;
            padding: 1.1rem 1.25rem;
            background: #fff;
            display: flex;
            align-items: center;
            gap: 0.9rem;
            height: 100%;
            transition: border-color 0.15s ease, transform 0.15s ease;
        }
        .info-tile:hover {
            border-color: rgba(37, 29, 58, 0.25);
            transform: translateY(-2px);
        }
        .info-tile-icon {
            width: 42px;
            height: 42px;
            border-radius: 0.65rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .info-tile-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #94a3b8;
            font-weight: 700;
            margin-bottom: 0.1rem;
        }
        .info-tile-value {
            font-size: 0.98rem;
            font-weight: 600;
            color: #251d3a;
        }

        .security-card {
            border: 1px solid #eef0f5;
            border-radius: 0.85rem;
            background: #fff;
            padding: 1.25rem 1.4rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
    
        /* --- Dark theme ---
           .profile-hero and .btn-hero-photo are already a navy gradient
           with white text, so they need nothing: the header looks the same
           in both themes, which is what keeps the page identifiable after
           the toggle. Only the two white tiles below it are restated. */
        html[data-bs-theme="dark"] .info-tile,
        html[data-bs-theme="dark"] .security-card {
            background: #141d30;
            border-color: #263045;
        }
        html[data-bs-theme="dark"] .info-tile:hover {
            border-color: rgba(148, 163, 184, 0.4);
        }
        html[data-bs-theme="dark"] .info-tile-label { color: #94a3b8; }
        /* Navy ink on a navy card is the one combination that fails
           outright here — the value is the content of the tile, so it goes
           to the brightest text color on the page. */
        html[data-bs-theme="dark"] .info-tile-value { color: #f1f5f9; }
        /* The avatar ring is white in light mode to separate the photo from
           the navy hero. Against the same hero in dark that is still
           correct, so only the outer glow is toned down. */
        html[data-bs-theme="dark"] .profile-avatar-ring {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.18));
        }
</style>
</head>
<body data-connection-alerts>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <%
            const admin = typeof currentAdmin !== 'undefined' && currentAdmin ? currentAdmin : {
                fullname: 'Admin', username: 'admin', gender: 'Male'
            };
            const avatarBg = admin.gender === 'Female' ? 'ec4899' : '0a1f44';
            const memberSince = admin.created_at ? new Date(admin.created_at).toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric', timeZone: displayTimeZone }) : null;
            const avatarSrc = admin.photo_url
                ? admin.photo_url
                : `https://ui-avatars.com/api/?name=${encodeURIComponent(admin.fullname)}&background=${avatarBg}&color=fff&bold=true&size=120`;
        %>
        <div class="container-fluid p-4" style="max-width: 900px;">
            <script>document.getElementById('pageTitle').innerText = 'My Profile';</script>

            <div class="profile-hero d-flex align-items-center gap-4 flex-wrap mb-4">
                <div class="profile-avatar-ring">
                    <img id="profilePreview" src="<%= avatarSrc %>" alt="Profile Avatar">
                </div>
                <div class="flex-grow-1">
                    <div class="profile-hero-name"><%= admin.fullname %></div>
                    <div class="profile-hero-username mb-3"><%= admin.username %></div>
                    <input type="file" id="imageUpload" accept="image/*" style="display: none;">
                    <button id="btnChangePhoto" class="btn btn-hero-photo">
                        <i class="fas fa-camera me-2"></i>Change Photo
                    </button>
                </div>
            </div>

            <h6 class="fw-bold text-uppercase text-muted mb-3" style="font-size: 0.78rem; letter-spacing: 0.06em;">Account Information</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="info-tile">
                        <div class="info-tile-icon" style="background: #eef2fa; color: #251d3a;"><i class="fas fa-user"></i></div>
                        <div>
                            <div class="info-tile-label">Username</div>
                            <div class="info-tile-value"><%= admin.username %></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="info-tile">
                        <div class="info-tile-icon" style="background: #ecfeff; color: #0891b2;"><i class="fas fa-venus-mars"></i></div>
                        <div>
                            <div class="info-tile-label">Gender</div>
                            <div class="info-tile-value"><%= admin.gender %></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="info-tile">
                        <div class="info-tile-icon" style="background: #f0fdf4; color: #16a34a;"><i class="fas fa-building"></i></div>
                        <div>
                            <div class="info-tile-label">Office</div>
                            <div class="info-tile-value">Center for Quality Assurance</div>
                        </div>
                    </div>
                </div>
                <% if (memberSince) { %>
                <div class="col-md-4">
                    <div class="info-tile">
                        <div class="info-tile-icon" style="background: #fff7ed; color: #ea580c;"><i class="fas fa-calendar-check"></i></div>
                        <div>
                            <div class="info-tile-label">Member Since</div>
                            <div class="info-tile-value"><%= memberSince %></div>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>

            <h6 class="fw-bold text-uppercase text-muted mb-3" style="font-size: 0.78rem; letter-spacing: 0.06em;">Security</h6>
            <div class="security-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="info-tile-icon" style="background: #fef2f2; color: #dc2626;"><i class="fas fa-lock"></i></div>
                    <div>
                        <div class="fw-semibold" style="color: #251d3a;">Password</div>
                        <div class="text-muted small">Keep your account secure with a strong password.</div>
                    </div>
                </div>
                <a href="/password" class="btn btn-outline-primary btn-sm px-3">
                    <i class="fas fa-key me-2"></i>Manage Password
                </a>
            </div>

            <p class="text-muted small mt-4 mb-0"><i class="fas fa-info-circle me-1"></i> To change your name or gender, contact a Super Admin under Manage Admins.</p>
        </div>
    </div>
</div>

<%- include('layout/footer') %>
<%- include('layout/theme-toggle') %>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const btnChangePhoto = document.getElementById('btnChangePhoto');
    const imageUpload = document.getElementById('imageUpload');
    const profilePreview = document.getElementById('profilePreview');
    const originalBtnHtml = btnChangePhoto.innerHTML;

    btnChangePhoto.addEventListener('click', function() {
        imageUpload.click();
    });

    imageUpload.addEventListener('change', async function(event) {
        const file = event.target.files[0];
        if (!file) return;

        // Preview immediately while the upload is in flight.
        const reader = new FileReader();
        reader.onload = function(e) { profilePreview.src = e.target.result; };
        reader.readAsDataURL(file);

        btnChangePhoto.disabled = true;
        btnChangePhoto.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Uploading...';

        try {
            const formData = new FormData();
            formData.append('photo', file);

            const response = await fetch('/api/profile/photo', { method: 'POST', body: formData });
            const data = await response.json();

            if (!response.ok || !data.success) {
                AppAlert.error(data.message || 'Failed to upload photo.');
                return;
            }

            // Swap in the saved URL (with a cache-buster) so a refresh shows the same photo.
            profilePreview.src = data.url + '?t=' + Date.now();
        } catch (err) {
            console.error('Error uploading profile photo:', err);
            // fromError shows offline wording when the device is actually offline.
            AppAlert.fromError(err, 'Could not upload your photo. Please try again.');
        } finally {
            btnChangePhoto.disabled = false;
            btnChangePhoto.innerHTML = originalBtnHtml;
            imageUpload.value = '';
        }
    });
});
</script>

</body>
</html>
