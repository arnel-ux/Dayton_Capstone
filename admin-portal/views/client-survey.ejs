<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSM Survey - CSPC</title>
    <script>
        (function () {
            try {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#2554c7">
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icons/icon.svg">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="/js/offline-db.js"></script>
    <script src="/js/pwa-client.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Brand + neutral palette — refined institutional blue on slate neutrals */
            --bs-primary: #2554c7;
            --bs-primary-rgb: 37, 84, 199;
            --brand: #2554c7;
            --brand-dark: #1c3f9c;
            --brand-light: #4d7ce8;
            --accent: #d4af37;
            --ink-900: #0f172a;
            --ink-800: #1e293b;
            --ink-600: #475569;
            --ink-400: #94a3b8;
            --surface: #ffffff;
            --page-bg: #eef1f6;
            --line: #e2e8f0;
            --line-soft: #edf1f7;
            --ring: rgba(37, 84, 199, 0.15);
            --sidebar-w: 272px;
            --topbar-h: 72px;
            --shadow-soft: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px -12px rgba(15,23,42,.10);
            --shadow-lift: 0 4px 10px -4px rgba(15,23,42,.10), 0 24px 48px -20px rgba(15,23,42,.18);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            scroll-behavior: smooth;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            color: var(--ink-800);
            transition: color 0.3s ease-in-out;
        }

        /* ---- Fixed, blurred campus backdrop (same treatment as the public
           landing page) sitting behind the whole app shell ---- */
        .survey-bg-image {
            position: fixed; inset: 0; z-index: -2;
            background: url('https://spims.cspc.edu.ph/assets/img/background.jpg') center/cover no-repeat;
        }
        .survey-bg-overlay {
            position: fixed; inset: 0; z-index: -1;
            background: linear-gradient(180deg, rgba(15,23,42,0.55) 0%, rgba(10,20,40,0.75) 100%);
        }
        [data-bs-theme="dark"] .survey-bg-overlay {
            background: linear-gradient(180deg, rgba(4,8,18,0.78) 0%, rgba(6,14,33,0.88) 100%);
        }

        /* =========================================================
           DASHBOARD SHELL — sidebar + topbar + content
        ========================================================= */
        .app-shell { display: flex; min-height: 100vh; }

        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: linear-gradient(190deg, #131c30 0%, var(--ink-900) 55%, #0c1424 100%);
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 1040;
            box-shadow: 4px 0 24px -8px rgba(0,0,0,0.25);
            transition: transform 0.3s ease;
        }
        [data-bs-theme="dark"] .sidebar { background: linear-gradient(190deg, #0d1524 0%, #0a101c 55%, #070c16 100%); }

        .sidebar-brand {
            display: flex; align-items: center; gap: 0.8rem;
            padding: 1.6rem 1.5rem 1.35rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-brand img { width: 44px; height: 44px; object-fit: contain; flex-shrink: 0; }
        .sidebar-brand-text { line-height: 1.3; }
        .sidebar-brand-text .t1 { font-size: 0.84rem; font-weight: 700; color: #fff; letter-spacing: 0.3px; }
        .sidebar-brand-text .t2 { font-size: 0.7rem; color: #8996ac; margin-top: 0.1rem; }

        .sidebar-nav { flex-grow: 1; padding: 1.5rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
        .sidebar-nav-label {
            font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em;
            color: #5b6a85; padding: 0 0.9rem; margin-bottom: 0.6rem;
        }
        .sidebar-nav .nav-item-link {
            display: flex; align-items: center; gap: 0.85rem;
            padding: 0.72rem 0.95rem; border-radius: 11px;
            color: #b6c0d4; text-decoration: none; font-weight: 600; font-size: 0.9rem;
            position: relative;
            transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }
        .sidebar-nav .nav-item-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .sidebar-nav .nav-item-link:hover:not(.disabled) { background: rgba(255,255,255,0.07); color: #fff; transform: translateX(2px); }
        .sidebar-nav .nav-item-link.active {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff; box-shadow: 0 8px 20px -8px rgba(37,84,199,0.8);
        }
        .sidebar-nav .nav-item-link.disabled { color: #55627a; cursor: not-allowed; }
        .sidebar-nav .soon-badge {
            margin-left: auto; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3px;
            background: rgba(148,163,184,0.15); color: #94a3b8; padding: 0.15rem 0.5rem; border-radius: 50px;
        }

        .sidebar-footer { padding: 1.1rem 1.5rem 1.5rem; border-top: 1px solid rgba(255,255,255,0.08); }
        .sidebar-footer .signed-in-email {
            font-size: 0.72rem; color: #8996ac; margin-bottom: 0.75rem; word-break: break-all;
            display: flex; align-items: center; gap: 0.4rem;
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px; padding: 0.55rem 0.7rem;
        }
        .sidebar-footer .btn-logout-side {
            width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            background: rgba(239,68,68,0.12); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25);
            border-radius: 11px; padding: 0.6rem; font-weight: 600; font-size: 0.82rem; transition: all 0.15s ease;
        }
        .sidebar-footer .btn-logout-side:hover { background: rgba(239,68,68,0.22); color: #fecaca; transform: translateY(-1px); }

        .sidebar-backdrop {
            display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.55);
            z-index: 1035; backdrop-filter: blur(2px);
        }

        .main-content {
            flex-grow: 1; min-width: 0; margin-left: var(--sidebar-w); display: flex; flex-direction: column;
            transition: margin-left 0.35s cubic-bezier(.4,0,.2,1);
        }

        /* Persistent desktop sidebar collapse — same slide-away transform as the
           mobile overlay, but without the backdrop, and it reclaims the space
           instead of overlaying content (so the survey can go truly full-screen). */
        .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
        .app-shell.sidebar-collapsed .main-content { margin-left: 0; }

        .topbar {
            position: sticky; top: 0; z-index: 1020;
            height: var(--topbar-h);
            background: var(--surface);
            border-bottom: 1px solid var(--line-soft);
            box-shadow: 0 1px 0 rgba(15,23,42,0.02), 0 6px 18px -14px rgba(15,23,42,0.25);
            display: flex; align-items: center; gap: 1.1rem;
            padding: 0 1.5rem;
            backdrop-filter: saturate(1.1);
        }
        .topbar-hamburger, .btn-sidebar-toggle {
            display: none; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--line);
            background: var(--surface); color: var(--ink-800); font-size: 1.1rem;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .btn-sidebar-toggle { display: inline-flex; }
        .btn-sidebar-toggle:hover { border-color: var(--brand); color: var(--brand); background: var(--ring); }
        .topbar-title { font-weight: 700; color: var(--ink-900); font-size: 1.05rem; margin: 0; letter-spacing: -.01em; }
        .topbar-title small { display: block; font-weight: 500; font-size: 0.72rem; color: var(--ink-600); margin-top: 0.1rem; }
        .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 0.7rem; }
        .lang-toggle-group { display: flex; gap: 0.4rem; background: var(--page-bg); border: 1px solid var(--line-soft); padding: 0.25rem; border-radius: 50px; }
        .lang-toggle-group .btn { border-radius: 50px !important; padding: 0.35rem 0.9rem; }

        .btn-fullscreen {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 11px;
            border: 1px solid var(--line); background: var(--surface); color: var(--ink-800);
            font-size: 1rem; transition: all 0.2s ease;
        }
        .btn-fullscreen:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-1px); background: var(--ring); }
        .btn-fullscreen:active { transform: translateY(0) scale(0.94); }

        .content-body { padding: 2rem 1.75rem 3.5rem; flex-grow: 1; }

        /* =========================================================
           SPA VIEW SWITCHING — Take Survey / Profile / History
        ========================================================= */
        .app-view { display: none; }
        .app-view.active { display: block; animation: fadeIn .4s ease; }

        .view-card {
            border-radius: 22px;
            background: rgba(255,255,255,0.88) !important;
            backdrop-filter: blur(22px) saturate(140%);
            -webkit-backdrop-filter: blur(22px) saturate(140%);
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 24px 60px -20px rgba(10,20,40,0.5);
            max-width: 900px;
            margin: 0 auto;
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        [data-bs-theme="dark"] .view-card {
            background: rgba(15,23,42,0.82) !important;
            border-color: rgba(255,255,255,0.08);
            box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5);
        }

        /* ---- Home view — landing screen shown right after login ---- */
        .home-card { max-width: 1100px; position: relative; overflow: hidden; }
        .home-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
            background: linear-gradient(90deg, var(--brand-dark), var(--brand), var(--accent), var(--brand-light));
            background-size: 200% 100%; animation: heroBarShift 8s linear infinite;
        }
        @media (prefers-reduced-motion: reduce) { .home-card::before { animation: none; } }
        .home-hero { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line-soft); }
        .home-hero .survey-hero-logo { width: 72px; height: 72px; }

        /* ---- Brand intro — round CSPC mark pops in dead-center, then the
           name slides up into frame beneath it (~1s total), before the
           subtitle settles in ---- */
        .brand-intro {
            display: flex; flex-direction: column; align-items: center; text-align: center; margin: 0 auto;
        }
        .brand-intro-mark {
            opacity: 0;
            animation: brandMarkPop 0.35s cubic-bezier(.34,1.56,.64,1) forwards;
        }
        .brand-intro-name {
            opacity: 0; margin-top: 0.75rem;
            animation: brandNameSlide 0.4s ease-out forwards;
            animation-delay: 0.18s;
        }
        .brand-intro-name .survey-hero-eyebrow { justify-content: center; }
        @keyframes brandMarkPop {
            0% { opacity: 0; transform: scale(.5) rotate(-10deg); }
            65% { opacity: 1; transform: scale(1.08) rotate(2deg); }
            100% { opacity: 1; transform: scale(1) rotate(0deg); }
        }
        @keyframes brandNameSlide {
            0% { opacity: 0; transform: translateY(16px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .home-subtitle-anim {
            opacity: 0;
            animation: homeFadeUp 0.3s ease-out forwards;
            animation-delay: 0.55s;
        }
        @media (prefers-reduced-motion: reduce) {
            .brand-intro-mark, .brand-intro-name, .home-subtitle-anim { animation: none; opacity: 1; }
        }

        .home-info-card {
            height: 100%; position: relative; overflow: hidden;
            background: #f8fafc; border: 1px solid var(--line); border-left: 4px solid var(--brand);
            border-radius: 16px; padding: 1.75rem;
            box-shadow: 0 6px 18px -14px rgba(15,23,42,0.25);
            transition: box-shadow .25s ease, transform .25s ease, border-color .25s ease;
        }
        .home-info-card:hover {
            box-shadow: 0 14px 34px -16px rgba(37,84,199,0.4);
            transform: translateY(-4px);
            border-left-color: var(--accent);
        }
        [data-bs-theme="dark"] .home-info-card { background: #101827; border-left-color: var(--brand-light); }
        .home-info-icon {
            width: 48px; height: 48px; border-radius: 12px; margin-bottom: 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
            background: var(--ring); color: var(--brand);
            transition: transform .3s ease, background .3s ease, color .3s ease;
        }
        .home-info-card:hover .home-info-icon {
            transform: scale(1.1) rotate(-4deg);
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff;
        }
        .home-info-card h5 { font-weight: 700; color: var(--ink-900); margin-bottom: 0.6rem; }
        .home-info-card p { color: var(--ink-600); font-size: 0.92rem; line-height: 1.65; margin-bottom: 0; }

        .home-feature-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
        .home-feature-chip {
            display: inline-flex; align-items: center; gap: 0.4rem;
            font-size: 0.72rem; font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 50px;
            background: var(--ring); color: var(--brand);
            transition: transform .2s ease, background .2s ease, color .2s ease;
        }
        .home-feature-chip:hover {
            background: var(--brand); color: #fff; transform: translateY(-2px);
        }
        [data-bs-theme="dark"] .home-feature-chip { background: rgba(96,141,255,0.15); }

        /* ---- Entrance animation — staggered fade + rise for hero and cards ---- */
        .home-anim { opacity: 0; animation: homeFadeUp .25s ease-out forwards; }
        @keyframes homeFadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @media (prefers-reduced-motion: reduce) { .home-anim { animation: none; opacity: 1; } }

        /* ---- Responsive tuning for smaller screens ---- */
        @media (max-width: 767.98px) {
            .home-hero .survey-hero-logo { width: 60px; height: 60px; }
            .home-hero h2 { font-size: 1.5rem; }
            .home-info-card { padding: 1.35rem; }
        }
        @media (max-width: 575.98px) {
            .home-card > .card-body { padding: 1.5rem 1.1rem !important; }
            .home-feature-row { gap: 0.4rem; }
            .home-feature-chip { font-size: 0.68rem; padding: 0.35rem 0.65rem; }
        }

        .view-header { text-align: center; padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line-soft); }
        .view-header .view-icon {
            width: 56px; height: 56px; border-radius: 16px; margin: 0 auto 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
            background: var(--ring); color: var(--brand);
        }

        /* ---- Profile view ---- */
        .profile-view-card { overflow: hidden; }
        .profile-hero {
            display: flex; align-items: center; gap: 1.1rem;
            padding: 1.75rem clamp(1.25rem, 4vw, 3rem);
            background: var(--surface);
            border-bottom: 1px solid var(--line-soft);
        }
        .profile-hero-avatar {
            width: 60px; height: 60px; border-radius: 50%; flex-shrink: 0;
            background: var(--ring); color: var(--brand);
            display: flex; align-items: center; justify-content: center; font-size: 1.55rem;
        }
        .profile-hero-text h3 { margin: 0 0 0.15rem; font-weight: 700; color: var(--ink-900); }
        .profile-hero-text p { margin: 0; color: var(--ink-600); font-size: 0.86rem; }

        .profile-body { padding: clamp(1.25rem, 4vw, 2.5rem); }

        .profile-section-label {
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
            color: var(--ink-400); margin-bottom: 0.9rem;
        }

        .profile-section-header {
            display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem;
        }
        .profile-section-header .profile-section-label { margin-bottom: 0; }

        .btn-edit-profile {
            display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0;
            font-size: 0.82rem; font-weight: 700; padding: 0.45rem 1rem; border-radius: 50px;
            background: transparent; color: var(--brand); border: 1.5px solid var(--brand);
            transition: all .15s ease;
        }
        .btn-edit-profile:hover { background: var(--brand); color: #fff; transform: translateY(-1px); box-shadow: 0 8px 18px -8px rgba(37,84,199,0.6); }
        .btn-edit-profile:active { transform: translateY(0); }

        .profile-info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
        @media (max-width: 640px) { .profile-info-grid { grid-template-columns: 1fr; } }

        .profile-info-card {
            display: flex; align-items: flex-start; gap: 0.85rem;
            background: var(--surface); border: 1px solid var(--line-soft); border-radius: 14px; padding: 1.1rem 1.2rem;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .profile-info-card:hover { border-color: var(--line); box-shadow: 0 4px 14px -8px rgba(15,23,42,0.12); }
        [data-bs-theme="dark"] .profile-info-card { background: #101827; }

        /* Name is the prominent, editable field — span both grid columns and give it
           slightly more visual weight than the locked, read-only fields beside it. */
        .profile-info-card-name { grid-column: 1 / -1; background: var(--ring); border-color: transparent; }
        [data-bs-theme="dark"] .profile-info-card-name { background: rgba(37,84,199,0.14); }
        .profile-info-card-name .profile-info-value { font-size: 1.05rem; }

        .profile-info-icon {
            width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: var(--ring); color: var(--brand); font-size: 1.05rem;
        }
        .profile-info-card-name .profile-info-icon { background: var(--surface); }
        .profile-info-text { min-width: 0; }
        .profile-info-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--ink-400); margin-bottom: 0.25rem; }
        .profile-info-value { font-weight: 600; color: var(--ink-900); word-break: break-word; }

        .profile-edit-card {
            background: var(--surface); border: 1px solid var(--line-soft); border-radius: 16px; padding: 1.6rem;
        }
        .profile-divider { border: none; border-top: 1px solid var(--line-soft); margin: 2.25rem 0; }

        .profile-locked-badge {
            display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; font-weight: 600;
            color: var(--ink-800);
        }
        .profile-locked-badge i { font-size: 0.7rem; color: var(--ink-400); }
        .profile-unset { color: var(--ink-400); font-style: italic; font-weight: 500; font-size: 0.86rem; }

        /* ---- History view ---- */
        .history-item {
            border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem 1.3rem;
            display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
            background: var(--surface);
        }
        .history-item:hover { border-color: var(--brand); box-shadow: 0 8px 20px -12px rgba(37,84,199,0.35); transform: translateY(-2px); }
        .history-item + .history-item { margin-top: 0.9rem; }
        .history-office { font-weight: 700; color: var(--ink-900); margin-bottom: 0.15rem; }
        .history-meta { font-size: 0.78rem; color: var(--ink-600); }
        .history-badge {
            font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px;
            background: rgba(34,197,94,0.12); color: #16a34a; white-space: nowrap;
        }
        [data-bs-theme="dark"] .history-badge { background: rgba(34,197,94,0.18); color: #4ade80; }

        /* ---- History detail modal ---- */
        .history-detail-head {
            display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap;
            padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line-soft);
        }
        .history-detail-icon {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.15rem;
            background: var(--ring); color: var(--brand);
        }

        .review-sqd-list { background: #f8fafc; border: 1px solid var(--line); border-radius: 12px; padding: 0.3rem 1rem; }
        [data-bs-theme="dark"] .review-sqd-list { background: #101827; }

        .sqd-rating-badge {
            display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap;
            font-size: 0.78rem; font-weight: 700; padding: 0.3rem 0.75rem 0.3rem 0.4rem; border-radius: 50px;
        }
        .sqd-rating-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 20px; height: 20px; border-radius: 50%; font-size: 0.72rem;
            background: rgba(255,255,255,0.6);
        }
        [data-bs-theme="dark"] .sqd-rating-num { background: rgba(15,23,42,0.35); }
        .sqd-rating-5, .sqd-rating-4 { background: rgba(34,197,94,0.14); color: #16a34a; }
        .sqd-rating-3 { background: rgba(234,179,8,0.16); color: #b45309; }
        .sqd-rating-2, .sqd-rating-1 { background: rgba(239,68,68,0.14); color: #dc2626; }
        [data-bs-theme="dark"] .sqd-rating-5, [data-bs-theme="dark"] .sqd-rating-4 { background: rgba(34,197,94,0.22); color: #4ade80; }
        [data-bs-theme="dark"] .sqd-rating-3 { background: rgba(234,179,8,0.22); color: #fbbf24; }
        [data-bs-theme="dark"] .sqd-rating-2, [data-bs-theme="dark"] .sqd-rating-1 { background: rgba(239,68,68,0.22); color: #f87171; }
        .sqd-rating-na, .sqd-rating-unanswered { background: var(--line-soft); color: var(--ink-600); }

        .empty-state { text-align: center; padding: 3.5rem 1.5rem; color: var(--ink-600); }
        .empty-state i { font-size: 2.75rem; color: var(--ink-400); margin-bottom: 1rem; display: block; }
        .empty-state p { max-width: 360px; margin: 0.5rem auto 0; font-size: 0.9rem; }

        .spinner-block { text-align: center; padding: 3rem 1rem; color: var(--ink-600); }

        /* ---- Review & Confirmation (Stage 5) ---- */
        .review-section { margin-bottom: 1.75rem; }
        .review-section-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 0.9rem;
        }
        .review-section-header h5 { margin: 0; font-weight: 700; color: var(--ink-900); font-size: 0.95rem; text-transform: uppercase; letter-spacing: .03em; }
        .btn-edit-section {
            font-size: 0.78rem; font-weight: 700; padding: 0.3rem 0.85rem; border-radius: 50px;
            background: var(--ring); color: var(--brand); border: 1px solid transparent; transition: all .15s ease;
        }
        .btn-edit-section:hover { background: var(--brand); color: #fff; transform: translateY(-1px); }

        .review-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
        .review-item {
            background: #f8fafc; border: 1px solid var(--line); border-radius: 12px; padding: 0.9rem 1.1rem;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .review-item:hover { border-color: #c7d5f2; box-shadow: 0 4px 14px -10px rgba(37,84,199,0.3); }
        #terms-box { box-shadow: var(--shadow-soft); }
        .review-section + .review-section { padding-top: 1.75rem; border-top: 1px dashed var(--line); }
        [data-bs-theme="dark"] .review-item { background: #101827; }
        .review-item .label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--ink-400); margin-bottom: 0.2rem; }
        .review-item .value { font-weight: 600; color: var(--ink-900); font-size: 0.9rem; word-break: break-word; }
        .review-item.full { grid-column: 1 / -1; }

        .review-sqd-row {
            display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
            padding: 0.65rem 0; border-bottom: 1px dashed var(--line);
        }
        .review-sqd-row:last-child { border-bottom: none; }
        .review-sqd-statement { font-size: 0.85rem; color: var(--ink-800); }
        .review-sqd-rating {
            font-size: 0.78rem; font-weight: 700; white-space: nowrap; padding: 0.25rem 0.7rem; border-radius: 50px;
            background: var(--ring); color: var(--brand);
        }

        @media (max-width: 576px) {
            .review-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); box-shadow: 0 0 40px rgba(0,0,0,0.35); }
            .sidebar.show { transform: translateX(0); }
            .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
            .sidebar-backdrop.show { display: block; }
            .main-content { margin-left: 0; }
            .topbar-hamburger { display: inline-flex; }
            .btn-sidebar-toggle { display: none; }
        }

        #sqd-body td {
            padding-top: 1.1rem;
            padding-bottom: 1.1rem;
        }

        .page { display: none; }
        .active { display: block; animation: fadeIn .4s ease; }
        .active.dir-fwd { animation: slideInFwd .45s cubic-bezier(.22,.61,.36,1); }
        .active.dir-back { animation: slideInBack .45s cubic-bezier(.22,.61,.36,1); }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideInFwd {
            from { opacity: 0; transform: translateX(28px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes slideInBack {
            from { opacity: 0; transform: translateX(-28px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Subtle padlock icon shown next to labels of previously-answered, locked fields */
        .lock-icon {
            font-size: 0.85rem;
            color: var(--ink-400);
            cursor: help;
            vertical-align: middle;
        }

        /* Dim disabled/locked inputs so it's obvious they can't be edited */
        .form-control:disabled,
        .form-select:disabled {
            background-color: #f1f5f9;
            opacity: 0.8;
            cursor: not-allowed;
        }

        /* Grey out offices whose survey is already completed, and mark them
           so the browser's native tooltip (title attr) makes the reason clear */
        #officeSelect option:disabled {
            color: #9ca3af;
            font-style: italic;
            background-color: #f1f5f9;
        }

        .locked-field {
            opacity: 0.75;
        }

        .locked-field .radio-custom {
            cursor: not-allowed;
        }

        .radio-custom {
            width: 19px;
            height: 19px;
            accent-color: var(--brand);
            cursor: pointer;
        }

        /* ---- Card shell — full-screen survey canvas, not a small boxed card ---- */
        /* When the Take Survey view is the active one, drop the content-body's own
           padding so the survey fills the viewport edge-to-edge; Profile/History
           keep their normal padded, centered card look. */
        .content-body:has(#view-survey.active) { padding: 2rem 1.75rem 3.5rem; }
        .survey-card {
            border-radius: 22px;
            background: rgba(255,255,255,0.88) !important;
            backdrop-filter: blur(22px) saturate(140%);
            -webkit-backdrop-filter: blur(22px) saturate(140%);
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 24px 60px -20px rgba(10,20,40,0.5);
            max-width: 940px;
            width: 100%;
            margin: 0 auto;
            min-height: 0;
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        [data-bs-theme="dark"] .survey-card {
            background: rgba(15,23,42,0.82) !important;
            border-color: rgba(255,255,255,0.08);
        }
        /* Inner content still reads comfortably instead of stretching edge-to-edge on wide screens */
        .survey-card > .card-body { max-width: 820px; margin: 0 auto; width: 100%; }

        @media (max-width: 575.98px) {
            .content-body:has(#view-survey.active) { padding: 0.75rem; }
            .survey-card { border-radius: 16px; }
        }

        /* ---- "In progress" survey (Stage 2 onward) ----
           Clicking START SURVEY widens the card to a full working canvas, but
           it always stays a contained, rounded card floating over the campus
           backdrop rather than going edge-to-edge. */
        .app-shell.survey-inprogress .survey-card {
            max-width: 1180px;
            min-height: calc(100vh - var(--topbar-h) - 4rem);
        }
        .app-shell.survey-inprogress .survey-card > .card-body { max-width: 1100px; }

        /* ---- Decorative accent bar + soft color orbs on the card shell ---- */
        .survey-card { position: relative; overflow: hidden; }
        .survey-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
            background: linear-gradient(90deg, var(--brand-dark), var(--brand), var(--accent), var(--brand-light));
            background-size: 200% 100%; animation: heroBarShift 8s linear infinite;
        }
        @keyframes heroBarShift { 0% { background-position: 0% 0; } 100% { background-position: 200% 0; } }
        .survey-card::after {
            content: ''; position: absolute; top: -120px; right: -120px; width: 320px; height: 320px;
            border-radius: 50%; background: radial-gradient(circle, rgba(37,84,199,0.16), transparent 70%);
            pointer-events: none; z-index: 0;
        }
        .survey-card > .card-body { position: relative; z-index: 1; }
        @media (prefers-reduced-motion: reduce) { .survey-card::before { animation: none; } }

        /* ---- Survey hero header (logo + institution + form title) ---- */
        .survey-hero { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line-soft); }
        .survey-hero-logo-wrap {
            display: flex; align-items: center; justify-content: center;
            width: 100%; margin-bottom: 0.75rem;
        }
        .survey-hero-logo {
            width: 84px; height: 84px; object-fit: contain; display: block; margin: 0 auto;
        }
        .survey-hero-eyebrow {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-size: 0.72rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
            color: var(--accent); margin-bottom: 0.35rem;
        }
        .survey-hero-eyebrow::before, .survey-hero-eyebrow::after { content: ''; width: 22px; height: 2px; background: var(--accent); display: inline-block; }
        .survey-hero-title { font-family: 'Playfair Display', serif; letter-spacing: 0.01em; }
        .survey-hero-badge {
            position: relative; display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1.5rem;
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff; border-radius: 50px; padding: 0.85rem 2rem;
            box-shadow: 0 10px 28px -10px rgba(37,84,199,0.6);
            overflow: hidden;
        }
        .survey-hero-badge i { font-size: 1.05rem; }
        .survey-hero-badge h4 { color: #fff; letter-spacing: .02em; }

        /* ---- Multi-step progress tracker ---- */
        .survey-progress {
            padding: 1.1rem 1.4rem;
            background: var(--page-bg);
            border: 1px solid var(--line-soft);
            border-radius: 16px;
        }
        .progress-steps { position: relative; display: flex; justify-content: space-between; }
        .progress-track {
            position: absolute; top: 15px; left: 17px; right: 17px; height: 4px;
            border-radius: 50px; background: var(--line); z-index: 0; overflow: hidden;
        }
        .progress-fill {
            position: absolute; top: 0; left: 0; height: 100%; width: 0%;
            background: linear-gradient(90deg, var(--brand), #4d7ce8);
            border-radius: 50px; transition: width 0.5s cubic-bezier(.65,0,.35,1);
        }
        .progress-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.45rem; flex: 1; }
        .step-dot {
            width: 34px; height: 34px; border-radius: 50%; background: var(--surface);
            border: 2.5px solid var(--line); color: var(--ink-400);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.85rem; transition: all 0.3s ease;
            box-shadow: 0 2px 6px -2px rgba(15,23,42,0.08);
        }
        .step-dot i { display: none; font-size: 1rem; }
        .step-label {
            font-size: 0.72rem; font-weight: 600; color: var(--ink-400);
            text-align: center; letter-spacing: 0.2px; transition: color 0.3s ease;
        }
        .progress-step.completed .step-dot {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            border-color: var(--brand); color: #fff;
            box-shadow: 0 4px 12px -4px rgba(37,84,199,0.55);
        }
        .progress-step.completed .step-dot span { display: none; }
        .progress-step.completed .step-dot i { display: inline-block; }
        .progress-step.completed .step-label { color: var(--ink-800); }
        .progress-step.active .step-dot {
            border-color: var(--brand); color: var(--brand);
            box-shadow: 0 0 0 6px var(--ring);
            animation: stepPulse 1.8s ease-in-out infinite;
        }
        .progress-step.active .step-label { color: var(--brand); font-weight: 700; }

        @keyframes stepPulse {
            0%, 100% { box-shadow: 0 0 0 5px var(--ring); }
            50% { box-shadow: 0 0 0 9px transparent; }
        }

        @media (max-width: 480px) {
            .step-label { display: none; }
            .step-dot { width: 28px; height: 28px; font-size: 0.75rem; }
        }

        .text-heading { color: var(--ink-900) !important; }
        .text-dark { color: var(--ink-800) !important; }
        .text-secondary, .text-muted { color: var(--ink-600) !important; }

        .section-title {
            border-left: 4px solid var(--brand);
            padding-left: 16px;
            padding-top: 2px;
            padding-bottom: 2px;
        }

        .section-title h4 { letter-spacing: .02em; }
        .section-title p { max-width: 62ch; }

        /* ---- Soft question/info blocks (formerly bg-light) ---- */
        .qa-block {
            background: #f8fafc;
            border: 1px solid var(--line) !important;
            border-left: 4px solid var(--brand) !important;
            border-radius: 16px !important;
            box-shadow: 0 6px 18px -14px rgba(15,23,42,0.25);
            transition: box-shadow .2s ease, transform .2s ease;
        }
        .qa-block:hover { box-shadow: 0 10px 26px -16px rgba(37,84,199,0.35); }
        .qa-block + .qa-block { margin-top: 1.1rem; }
        .qa-block > p:first-child { margin-bottom: 1.1rem; }
        [data-bs-theme="dark"] .qa-block { border-left-color: var(--brand-light) !important; }

        .option-card {
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 16px 18px 16px 16px;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease, transform .15s ease;
            cursor: pointer;
            background: var(--surface);
            line-height: 1.45;
            position: relative;
        }

        .option-card:hover {
            background: #f5f8ff;
            border-color: #b6c8f2;
            transform: translateY(-2px) scale(1.005);
            box-shadow: 0 8px 20px -12px rgba(37, 84, 199, 0.35);
        }

        .option-card:has(input:checked) {
            background: #eef3fe;
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--ring), 0 8px 20px -10px rgba(37, 84, 199, 0.4);
            transform: scale(1.01);
        }
        .option-card:has(input:checked)::after {
            content: '\f26e'; font-family: 'bootstrap-icons'; position: absolute; top: 10px; right: 12px;
            color: var(--brand); font-size: 1rem; animation: optionPop .25s ease;
        }
        @keyframes optionPop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        [data-bs-theme="dark"] .option-card:has(input:checked) { background: rgba(37,84,199,0.16); }

        .option-card:active { transform: scale(0.99); }

        .form-check-input {
            transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        }
        .form-check-input:checked {
            transform: scale(1.08);
        }

        /* ---- Form controls ---- */
        .form-control, .form-select {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: .7rem .95rem;
            color: var(--ink-800);
            background-color: var(--surface);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .row.g-4 > * { padding-top: 0.15rem; }
        .form-label { margin-bottom: .5rem; font-size: .88rem; letter-spacing: .01em; }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 4px var(--ring);
            outline: none;
        }

        .form-check-input {
            border: 1.5px solid var(--ink-400);
            border-radius: 5px;
        }

        /* The generic border-radius above squares off Bootstrap's pill-shaped
           switch knob (e.g. the Autofill toggle) — restore it here so the
           switch still renders/slides like a switch instead of a checkbox. */
        .form-switch .form-check-input {
            border-radius: 2em;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 4px var(--ring);
            border-color: var(--brand);
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .form-label { color: var(--ink-800); }

        /* ---- Buttons ---- */
        .btn {
            border-radius: 50px;
            font-weight: 600;
            transition: transform .12s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--brand), var(--brand-dark));
            border: 1.5px solid var(--brand-dark);
            box-shadow: 0 4px 12px -4px rgba(37, 84, 199, 0.45);
        }

        .btn-primary:hover, .btn-primary:focus {
            background: linear-gradient(135deg, var(--brand-dark), var(--brand-dark));
            border: 1.5px solid var(--brand-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px -8px rgba(37, 84, 199, 0.6);
        }
        .btn-primary:active { transform: translateY(0); }

        .btn-outline-primary, .btn-outline-secondary {
            border-color: var(--line);
            color: var(--ink-800);
        }

        .btn-outline-primary:hover, .btn-outline-secondary:hover {
            transform: translateY(-1px);
        }

        .btn:disabled { transform: none; }

        /* ---- SQD table ---- */
        .table td, .table th { vertical-align: middle; }
        textarea { resize: none; }

        #sqd-table-wrap {
            border: 1px solid var(--line) !important;
            border-radius: 16px !important;
            overflow: hidden;
        }

        #sqd-table-wrap table { margin-bottom: 0; }

        #sqd-table-wrap thead th {
            background: var(--ink-900);
            color: #f1f5f9;
            font-weight: 600;
            border-color: var(--ink-900);
            padding: 0.9rem 0.6rem;
        }

        #sqd-body td.text-start {
            font-size: 0.9rem;
            line-height: 1.45;
            padding-left: 1.25rem;
            padding-right: 1rem;
            color: var(--ink-800);
        }

        #sqd-body tr { transition: background 0.15s ease; }
        #sqd-body tr:nth-child(even) { background: rgba(37, 84, 199, 0.025); }
        #sqd-body tr:hover { background: rgba(37, 84, 199, 0.06); }
        [data-bs-theme="dark"] #sqd-body tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }
        [data-bs-theme="dark"] #sqd-body tr:hover { background: rgba(96, 141, 255, 0.08); }

        #sqd-body .radio-custom { width: 20px; height: 20px; transition: transform 0.15s ease; }
        #sqd-body .radio-custom:hover { transform: scale(1.2); }
        #sqd-body .radio-custom:checked { transform: scale(1.25); }

        #sqd-table-wrap thead th { transition: background 0.15s ease, transform 0.15s ease; cursor: default; }
        #sqd-table-wrap thead th:not(:first-child):hover { transform: scale(1.06); }

        #sqd-body td:not(.text-start) { transition: background 0.2s ease; border-radius: 6px; }
        #sqd-body td:not(.text-start):has(.radio-custom:checked) { background: rgba(37, 84, 199, 0.1); }
        #sqd-body td:has(input[value="5"]:checked),
        #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.14) !important; }
        #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.16) !important; }
        #sqd-body td:has(input[value="2"]:checked),
        #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.14) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="5"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="2"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.22) !important; }

        /* --- DARK MODE STYLES --- */
        [data-bs-theme="dark"] {
            --page-bg: #0b1220;
            --surface: #161f2e;
            --line: #2a3444;
            --line-soft: #22293a;
            --ink-900: #f1f5f9;
            --ink-800: #e2e8f0;
            --ink-600: #94a3b8;
            --ink-400: #64748b;
            --ring: rgba(96, 141, 255, 0.25);
        }
        [data-bs-theme="dark"] body { color: var(--ink-800); }
        [data-bs-theme="dark"] .survey-card { box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }
        [data-bs-theme="dark"] .qa-block { background: #101827; }
        [data-bs-theme="dark"] .bg-white { background-color: var(--surface) !important; }
        [data-bs-theme="dark"] .option-card { background: #101827; color: var(--ink-800); }
        [data-bs-theme="dark"] .option-card:hover { background: #17233a; border-color: var(--brand); }
        [data-bs-theme="dark"] .option-card:has(input:checked) { background: #17233a; }
        [data-bs-theme="dark"] .bg-primary-subtle { background-color: rgba(37, 84, 199, 0.18) !important; }
        [data-bs-theme="dark"] .form-select, [data-bs-theme="dark"] .form-control { background-color: #101827; color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] .table { --bs-table-bg: transparent; --bs-table-color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] #sqd-table-wrap thead th { background: #050a13; }
        [data-bs-theme="dark"] #terms-box { background-color: var(--surface) !important; border-color: var(--line) !important; }
        [data-bs-theme="dark"] .review-item { background: #101827; }
        [data-bs-theme="dark"] .review-item:hover { border-color: var(--brand); }
        [data-bs-theme="dark"] .survey-progress { background: #101827; border-color: var(--line); }

        summary { list-style: none; outline: none; }
        summary::-webkit-details-marker { display: none; }
    </style>
</head>

<body>

<div class="survey-bg-image"></div>
<div class="survey-bg-overlay"></div>

<div class="app-shell">

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="clientSidebar">
        <div class="sidebar-brand">
            <img src="/images/cspc-logo.png" alt="CSPC Logo">
            <div class="sidebar-brand-text">
                <div class="t1">CQA Client Portal</div>
                <div class="t2">CSPC Nabua, Cam. Sur</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="#" data-view="home" class="nav-item-link active" onclick="return switchView('home');"><i class="bi bi-house-door-fill"></i> Home</a>
