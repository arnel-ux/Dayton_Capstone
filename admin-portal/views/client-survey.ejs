                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <label class="form-label fw-semibold text-dark fs-6 mb-0" data-i18n="lbl_service"></label>
                                <span id="serviceProgressBadge" class="service-progress-badge d-none"></span>
