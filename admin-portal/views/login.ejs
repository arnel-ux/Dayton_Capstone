<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/offline-pill.css">
    <style>
        /* ------------------------------------------------------------------
           /login only. Everything shared with the other auth pages — backdrop,
           wrapper, card, fields, buttons, notices, and the density ladder that
           keeps these pages inside the fold — lives in /css/auth.css. Only the
           three things this page alone has are here: the reCAPTCHA widget, the
           Login/Register switch, and offline mode.
           ------------------------------------------------------------------ */

        /* ---- reCAPTCHA ----
           Google's checkbox widget is a fixed 304x78px iframe — wider than the
           card's content area on every phone. Scaling it down and shrinking its
           layout box by the same factor keeps it inside the card instead of
           poking out past the edge. */
        @media (max-width: 480px) {
            .g-recaptcha {
                transform: scale(0.85);
                transform-origin: 0 0;
                width: 258px;
                height: 66px;
            }
        }

        /* Narrowest phones (320-375px): at 0.85 the widget can still run past
           the card's content width once the card itself has shrunk — measured
           as low as ~226px on a 320px-wide viewport. Same iframe, smaller box;
           none of Google's own widget text is hidden. */
        @media (max-width: 375px) {
            .g-recaptcha {
                transform: scale(0.74);
                transform-origin: 0 0;
                width: 225px;
                height: 58px;
            }
        }

        /* The tightest combinations left — a 360x640-class handset, or a browser
           window dragged very short. The widget is Google's, so the only lever
           is its scale; below this it stops being comfortably tappable, which is
           why the ladder ends here. */
        @media (max-height: 680px), (max-width: 360px) {
            .g-recaptcha {
                transform: scale(0.64);
                transform-origin: 0 0;
                width: 195px;
                height: 50px;
            }
        }

        /* ---- Login / Register switch ----
           This one card serves two flows, so the control has to read as a
           SWITCH (a track with a sliding thumb) rather than as two plain
           buttons: the thing a first-time visitor must grasp instantly is that
           Register is this same card in a different mode, not another page they
           are being sent off to. Sized in rem/% only, so the same markup holds
           from a 320px phone up to the desktop card. */
        .auth-switch {
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            padding: 4px;
            margin-bottom: 0.85rem;
            background: #f1f5f9;
            border: 1.5px solid #e2e8f0;
            border-radius: 50px;
        }

        /* Thumb width is calc(50% - 4px), so translateX(100%) — i.e. by its OWN
           width — lands it exactly on the right half's inset position.
           Percentage-based, so it stays correct at every card width. */
        .auth-switch-thumb {
            position: absolute;
            top: 4px;
            left: 4px;
            bottom: 4px;
            width: calc(50% - 4px);
            border-radius: 50px;
            background: linear-gradient(135deg, #251d3a, #2a2550);
            box-shadow: 0 6px 14px -6px rgba(37, 29, 58, 0.65);
            transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .auth-switch[data-active="register"] .auth-switch-thumb {
            transform: translateX(100%);
        }

        .auth-switch-btn {
            position: relative;
            z-index: 1; /* above the thumb, so the label stays readable */
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            background: none;
            border: none;
            border-radius: 50px;
            padding: 0.5rem 0.4rem;
            min-height: 40px; /* comfortable tap target on a phone */
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: #64748b;
            transition: color 0.25s ease;
        }
        .auth-switch-btn[aria-selected="true"] { color: #ffffff; }
        .auth-switch-btn:focus-visible { outline: 2px solid #ffcc00; outline-offset: 2px; }

        /* Panels swap with .d-none — no absolute positioning, so the card's
           height follows whichever panel is showing instead of being pinned to
           the taller one. */
        .auth-panel { animation: fadeSlideUp 0.35s ease-out both; }

        /* ---- Register panel ----
           Deliberately not a set of name/email/password fields: an account is
           only ever created off an email Google has actually verified (see
           /auth/google/callback -> /complete-google-registration in server.js),
           so this panel explains that the email step comes first and then starts
           it. An email field here would look like it registered something. */
        .reg-emails {
            display: flex;
            flex-wrap: wrap;
            gap: 0.4rem;
            margin-bottom: 0.7rem;
        }
        .reg-email-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            flex: 1 1 auto;
            padding: 0.35rem 0.7rem;
            border-radius: 50px;
            background: #eef2ff;
            border: 1px solid #e0e7ff;
            color: #3730a3;
            font-size: 0.72rem;
            font-weight: 700;
            line-height: 1.3;
            text-align: center;
        }
        .reg-email-chip i { font-size: 0.78rem; }

        .btn-register-google {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border: none;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            min-height: 44px;
            padding: 0.6rem 1rem;
            font-weight: 700;
            font-size: 0.9rem;
            color: #ffffff;
            text-decoration: none;
            box-shadow: 0 8px 18px -6px rgba(37, 29, 58, 0.55);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }
        .btn-register-google:hover {
            color: #ffffff;
            filter: brightness(1.08);
            transform: translateY(-1px);
            box-shadow: 0 12px 22px -6px rgba(37, 29, 58, 0.6);
        }
        .btn-register-google:active { transform: translateY(0); }
        .btn-register-google:focus-visible { outline: 2px solid #ffcc00; outline-offset: 2px; }
        .btn-register-google.disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

        /* White pill behind Google's multicoloured G — the raw logo on a navy
           button loses its blue stroke entirely. */
        .btn-register-google .g-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #ffffff;
            flex: none;
        }
        .btn-register-google .g-badge img { width: 15px; height: 15px; }

        .auth-swap-hint {
            margin: 0.7rem 0 0;
            text-align: center;
            font-size: 0.78rem;
            color: #64748b;
        }
        .auth-swap-hint button {
            background: none;
            border: none;
            padding: 0.25rem 0.3rem;
            font-size: 0.78rem;
            font-weight: 700;
            color: #251d3a;
            text-decoration: underline;
        }

        /* ---- Offline layout ----
           The online fold fits EXACTLY (see the density ladder in auth.css), and
           offline adds the pill (~34px) and the "Take Survey Offline" button
           (~72px) on top of it. Rather than compressing everything further,
           offline hides the blocks that genuinely CANNOT work with zero network
           — the reCAPTCHA never loads, the password check needs the server, and
           /auth/google (for signing in AND for registering) needs the redirect.
           That frees far more height than the offline extras take, so the
           offline card is shorter than the online one and the fold stays clear.
           Everything here is keyed on a class toggled by the same
           navigator.onLine listener as the pill — nothing is removed, only
           hidden, so the form comes straight back when connectivity returns. */
        body.is-offline #loginForm,
        body.is-offline .divider-or,
        body.is-offline #googleSignInBtn,
        body.is-offline .auth-switch,
        body.is-offline #registerPanel,
        body.is-offline .auth-swap-hint {
            display: none !important;
        }

        /* Both of these exist to explain why SIGNING IN is currently blocked —
           one for an unresolved previous-session logout, one for a server that
           isn't answering. Offline the sign-in form is gone entirely and
           #offlineLoginNotice already says why, so leaving them visible stacked
           a second and third amber box saying "You're offline…" above it.
           Hidden in CSS only, never cleared: the pending-logout guard re-runs
           attempt() on the 'online' event. */
        body.is-offline #pendingLogoutNotice,
        body.is-offline #serverUnavailableNotice {
            display: none !important;
        }

        /* No form under it, so the button is the card's last element — its mb-3
           would leave a dangling gap above the card's bottom padding. */
        body.is-offline #offlineSurveyBtn { margin-bottom: 0 !important; }

        /* The home button is bottom-centre at every size and in both states now
           (see /css/auth.css), so the overrides that used to pull it back down
           here for the offline layout are gone — there is nothing left to undo. */

        /* ---- Fold trims for the two step lists ---- */
        @media (max-width: 480px) {
            .auth-switch { margin-bottom: 0.7rem; }
            .auth-switch-btn { font-size: 0.76rem; letter-spacing: 0.5px; }
            /* Side by side, each of these two labels wraps to three cramped
               lines on a phone — full width reads better. */
            .reg-email-chip { font-size: 0.7rem; flex-basis: 100%; }
            .reg-emails { gap: 0.3rem; margin-bottom: 0.55rem; }
            .auth-steps { padding: 0.65rem 0.7rem; margin-bottom: 0.7rem; }
            .auth-step p { font-size: 0.78rem; line-height: 1.35; }
            .auth-step + .auth-step { margin-top: 0.45rem; }
            .btn-register-google { font-size: 0.88rem; }
        }

        /* Same "short viewport OR phone" pairing as /css/auth.css — see the
           note there on why height alone was not enough. */
        @media (max-height: 900px), (max-width: 480px) {
            /* The steps are the point of the Register panel and stay; the
               footnote is reassurance, and it is the one block here that can go
               when the fold gets tight — the same trade the rest of the card's
               short-viewport rules make. */
            .auth-steps-foot { display: none; }
            .auth-steps { padding: 0.6rem 0.7rem; margin-bottom: 0.55rem; }
            .auth-step p { font-size: 0.76rem; }
            .auth-switch { margin-bottom: 0.5rem; padding: 3px; }
            .auth-switch-thumb { top: 3px; left: 3px; bottom: 3px; width: calc(50% - 3px); }
            .auth-switch-btn { min-height: 34px; font-size: 0.72rem; }
            .btn-register-google { min-height: 40px; padding-block: 0.5rem; }
            .auth-swap-hint { margin-top: 0.5rem; font-size: 0.72rem; }
        }

        @media (max-height: 680px), (max-width: 360px) {
            .auth-switch { margin-bottom: 0.3rem; }
            .auth-switch-btn { min-height: 30px; }
            .reg-emails { margin-bottom: 0.45rem; }
            .btn-register-google { min-height: 38px; padding-block: 0.45rem; }
            /* This card carries the most of any auth page — switch, two fields,
               reCAPTCHA, two buttons — so the last few pixels come out of the
               spacing between them rather than out of any control. */
            .card-custom h4 { font-size: 0.9rem; }
            .card-custom .divider-soft { margin: 0.2rem auto 0.25rem; }
            .field-group { margin-bottom: 0.25rem; }
            /* "Sign in to your account" / "Sign up first with your CSPC or
               personal email" — the switch sitting directly beneath it already
               says which of the two modes you are in, so at this size the line
               is the most repeated thing on the card and the least missed. */
            #cardSubtitle { display: none; }
        }
        /* Smallest phones — narrow (<=360px) or small-and-short. The two email
           chips stack full-width here, two rows for a point step 1 makes in the
           same breath ("your CSPC email or a personal email"). They are the
           cheapest thing on the panel to drop and the only one that is a pure
           restatement. */
        @media (max-width: 360px), (max-width: 480px) and (max-height: 700px) {
            .reg-emails { display: none; }
        }

        /* Short desktop windows — see the matching tiers at the foot of
           /css/auth.css. The widget is the most obvious casualty of the phone
           trims on a wide screen: at 64% it renders as a fuzzy miniature beside
           full-size inputs. There is width to spare here, so it goes back to the
           size Google draws it at — ~28px of what those tiers reclaim, spent on
           the one element that actually looked broken. */
        @media (min-width: 768px) and (max-height: 820px) {
            .g-recaptcha {
                transform: none;
                width: auto;
                height: auto;
            }
            #cardSubtitle { display: block; }
            .reg-emails { display: flex; }
        }

        @media (min-width: 768px) and (max-height: 700px) {
            /* The switch keeps its full 4px track and a real tap height even in
               the tightest desktop tier — it is the control that tells a new
               visitor Register exists, and a squashed one reads as a label. */
            .auth-switch { margin-bottom: 0.7rem; padding: 4px; }
            .auth-switch-thumb { top: 4px; left: 4px; bottom: 4px; width: calc(50% - 4px); }
            .auth-switch-btn { min-height: 38px; font-size: 0.74rem; }
            .auth-steps { padding: 0.65rem 0.8rem; margin-bottom: 0.7rem; }
            .auth-step p { font-size: 0.78rem; }
            .auth-step + .auth-step { margin-top: 0.5rem; }
            .reg-emails { margin-bottom: 0.6rem; }
            .reg-email-chip { font-size: 0.7rem; padding: 0.3rem 0.65rem; }
            .btn-register-google { min-height: 42px; padding-block: 0.55rem; }
        }

        @media (min-width: 768px) and (min-height: 701px) and (max-height: 780px) {
            .auth-switch { margin-bottom: 0.85rem; padding: 4px; }
            .auth-switch-thumb { top: 4px; left: 4px; bottom: 4px; width: calc(50% - 4px); }
            .auth-switch-btn { min-height: 40px; font-size: 0.76rem; }
            .auth-steps { padding: 0.75rem 0.85rem; margin-bottom: 0.85rem; }
            .auth-step p { font-size: 0.8rem; }
            .btn-register-google { min-height: 44px; padding-block: 0.6rem; }
        }

        @media (min-width: 768px) and (min-height: 781px) and (max-height: 900px) {
            .auth-switch { margin-bottom: 1rem; padding: 4px; }
            .auth-switch-thumb { top: 4px; left: 4px; bottom: 4px; width: calc(50% - 4px); }
            .auth-switch-btn { min-height: 40px; font-size: 0.78rem; }
            .auth-steps { padding: 0.75rem 0.85rem; margin-bottom: 0.85rem; }
            .auth-step p { font-size: 0.82rem; }
            .auth-steps-foot { display: flex; }
            .btn-register-google { min-height: 44px; padding-block: 0.6rem; }
        }

        /* ---- Desktop breathing room for "How registration works" ----
           The three steps inherit a rhythm that is sized for a phone fold, and
           on a wide screen that reads as one dense block: the numbers, the
           lines and the panel edge all sit a couple of pixels apart. The air
           goes back INSIDE the block — padding, the gap after the heading, the
           gap between steps and the line-height — while the outer
           margin-bottom moves only slightly, so the button under it and the
           fixed home button keep the clearance the density ladder gives them.

           Bounded by min-width: 768px (no phone or tablet sees it) and split by
           height for the same reason every tier above is: a 1366x768 laptop has
           no pixels to spare, so tier 1 (<=700px) is deliberately left exactly
           as it was. Each tier below adds only what its own budget allows, and
           the Register panel is the shorter of the two panels anyway — it has
           no reCAPTCHA, no fields and no second button — so this spends slack
           the fold already had rather than borrowing from it. */
        @media (min-width: 768px) and (min-height: 701px) and (max-height: 780px) {
            .reg-emails { margin-bottom: 0.7rem; }
            .auth-steps { padding: 0.85rem 0.9rem; margin-bottom: 0.9rem; }
            .auth-steps-title { margin-bottom: 0.65rem; }
            .auth-step { gap: 0.65rem; }
            .auth-step + .auth-step { margin-top: 0.6rem; }
            .auth-step p { line-height: 1.45; }
        }

        @media (min-width: 768px) and (min-height: 781px) and (max-height: 900px) {
            .reg-emails { margin-bottom: 0.8rem; }
            .auth-steps { padding: 0.95rem 1rem; margin-bottom: 0.95rem; }
            .auth-steps-title { margin-bottom: 0.75rem; }
            .auth-step { gap: 0.7rem; }
            .auth-step + .auth-step { margin-top: 0.7rem; }
            .auth-step p { line-height: 1.5; }
            .auth-steps-foot { margin-top: 0.8rem; padding-top: 0.7rem; }
        }

        @media (min-width: 768px) and (min-height: 901px) {
            .reg-emails { margin-bottom: 0.85rem; }
            .auth-steps { padding: 1.05rem 1.1rem; margin-bottom: 1rem; }
            .auth-steps-title { margin-bottom: 0.85rem; }
            .auth-step { gap: 0.75rem; }
            .auth-step + .auth-step { margin-top: 0.85rem; }
            .auth-step p { line-height: 1.55; }
            .auth-steps-foot { margin-top: 0.9rem; padding-top: 0.8rem; }
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/alerts.css">
</head>
<body>

    <div class="bg-blurred" style="--auth-hero-image: url('<%- heroImageUrl %>')"></div>
    <div class="bg-overlay"></div>

    <a href="/" class="btn-home" title="Return to Home Page" aria-label="Return to Home Page">
        <i class="fas fa-home"></i>
    </a>

    <div class="login-wrapper">

        <!-- Above the header, centred: the first thing in the column, so it is
             the first thing read and nothing can sit on it. -->
        <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection.">
            <span class="dot"></span><span class="label">Viewing Offline</span>
        </span>

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text" id="portalBadge">Login Portal</h2>
        </div>

        <!-- The gap between the heading and the card. An element rather than a
             margin because it has to GROW into spare space and STOP at a cap —
             see .auth-gap in /css/auth.css for why a plain margin (too tight on
             a roomy screen) and an auto margin (too loose on a short card)
             each got one of those two halves wrong. Presentational only. -->
        <div class="auth-gap" aria-hidden="true"></div>

        <div class="card-custom">

            <div class="text-center mb-2">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                <h4 class="fw-bold text-dark mb-0" id="cardTitle">CQA Portal Login</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0" id="cardSubtitle">Sign in to your account</p>
            </div>

            <!-- Blocks starting a NEW login while an old session's server-
                 side logout is still unresolved — see the race condition
                 explained on guardLoginAgainstPendingLogout() below. Reuses
                 the same .offline-login-notice/.notice-retry-btn styling as
                 #serverUnavailableNotice (an existing reusable pattern, not
                 a new one) rather than introducing another notice design. -->
            <div id="pendingLogoutNotice" class="offline-login-notice d-none">
                <i id="pendingLogoutNoticeIcon" class="fas fa-hourglass-half"></i>
                <span id="pendingLogoutNoticeText">Finishing your previous session…</span>
                <button type="button" id="pendingLogoutRetryBtn" class="notice-retry-btn d-none">Retry</button>
            </div>

            <div id="serverUnavailableNotice" class="offline-login-notice d-none">
                <i id="serverUnavailableNoticeIcon" class="fas fa-triangle-exclamation"></i>
                <span id="serverUnavailableNoticeText">Server temporarily unavailable. Please try again.</span>
                <button type="button" class="notice-retry-btn" onclick="checkServerHealth()">Retry</button>
            </div>

            <!-- Says WHY the username/password form is gone while offline, so
                 the shortened card doesn't just look broken. Reuses the
                 existing .offline-login-notice pattern. -->
            <div id="offlineLoginNotice" class="offline-login-notice d-none">
                <i class="fas fa-wifi"></i>
                <span>You're offline. Signing in needs a connection — but you can still answer the survey now.</span>
            </div>

            <!-- The two steps mirror the real flow: this button leads to
                 /survey-offline, whose form requires BOTH a registered email
                 and that account's password (client-survey.ejs, offlineMode
                 branch). Neither is checked on this device — verification
                 happens at POST /api/offline-surveys/verify-and-sync once
                 connectivity returns — which is exactly why the warning about
                 getting them right belongs here, up front, and not after the
                 user has already filled in the whole survey. -->
            <div id="offlineStepsGuide" class="auth-steps d-none">
                <p class="auth-steps-title">How to answer the survey offline</p>

                <div class="auth-step">
                    <span class="step-num" aria-hidden="true">1</span>
                    <p>Tap <strong>Take Survey Offline</strong> below to open the survey form.</p>
                </div>

                <div class="auth-step">
                    <span class="step-num" aria-hidden="true">2</span>
                    <p>Enter the <strong>email and password of your registered CQA account</strong>, then answer the survey. Both must be correct — that account is how your response gets saved to you.</p>
                </div>

                <p class="auth-steps-foot">
                    <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    <span>Answers are saved on this device and sync automatically once you're back online.</span>
                </p>
            </div>

            <!-- Offline: signing in for real always needs the server (there is
                 no way to check a password with zero network access), so this
                 replaces the login form entirely rather than pretending it can
                 still work. Leads to the unauthenticated /survey-offline flow,
                 whose own account/password verification happens once back
                 online — see offline-db.js / pwa-client.js. -->
            <a href="/survey-offline" id="offlineSurveyBtn" class="btn btn-login w-100 d-none text-decoration-none mb-3" title="Complete the survey now — your account is verified once you're back online">
                <i class="fas fa-clipboard-list me-2"></i> Take Survey Offline
            </a>

            <!-- LOGIN / REGISTER SWITCH
                 Registering and logging in are two different jobs that were
                 previously indistinguishable on this page: the only entry
                 point for a brand-new client was the "Sign in with Google"
                 button at the very bottom, under the OR divider, whose label
                 says "sign IN" — so a first-time visitor had no way to tell
                 that this was also where they sign UP. The switch names both
                 states up front and puts them on equal footing. -->
            <div class="auth-switch" id="authSwitch" data-active="login" role="tablist" aria-label="Login or Register">
                <span class="auth-switch-thumb" aria-hidden="true"></span>
                <button type="button" class="auth-switch-btn" id="loginTabBtn" role="tab" aria-selected="true" aria-controls="loginPanel" data-tab="login" title="Sign in to an account you already created">
                    <i class="fas fa-right-to-bracket" aria-hidden="true"></i> Login
                </button>
                <button type="button" class="auth-switch-btn" id="registerTabBtn" role="tab" aria-selected="false" aria-controls="registerPanel" data-tab="register" title="Create a new account">
                    <i class="fas fa-user-plus" aria-hidden="true"></i> Register
                </button>
            </div>

            <div id="loginPanel" class="auth-panel" role="tabpanel" aria-labelledby="loginTabBtn">

            <!-- UNIFIED LOGIN FORM (POST REQUEST) -->
            <form action="/auth-login" method="POST" id="loginForm">
                <div class="field-group">
                    <label class="field-label" for="usernameInput">Username or Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" name="username" id="usernameInput" class="form-control" placeholder="Enter your username or email" required title="Username or Email" autocomplete="off" list="usernameSuggestions">
                        <datalist id="usernameSuggestions"></datalist>
                    </div>
                    <p class="field-hint mb-0">Use the password you set when you registered.</p>
                </div>

                <div class="field-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="field-label mb-0" for="passwordInput">Password</label>
                        <a href="/forgot-password" class="forgot-link" title="Reset your password">Forgot Password?</a>
                    </div>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <!-- The show/hide toggle and the strength meter are both
                             injected by public/js/alerts.js — the toggle for any
                             password input, the meter because of data-pw-strength.
                             Adding them by hand here too is what produced a second,
                             empty toggle button next to the real one. -->
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required title="Password" autocomplete="current-password" data-pw-strength>
                    </div>
                </div>

                <% if (recaptchaSiteKey) { %>
                <div class="field-group d-flex justify-content-center" id="recaptchaWrap">
                    <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>" data-callback="enableLoginSubmit" data-expired-callback="disableLoginSubmit" data-error-callback="disableLoginSubmit"></div>
                </div>
                <% } %>

                <!-- RECAPTCHA_SITE_KEY unset (e.g. local dev without it configured yet):
                     the widget above never renders, so the button starts enabled instead
                     of being permanently stuck disabled with no way to ever pass a check
                     that isn't even shown. Once a real key is set in .env, this reverts to
                     the normal disabled-until-verified behavior. -->
                <button type="submit" class="btn btn-login w-100" id="loginSubmitBtn" <%= recaptchaSiteKey ? 'disabled' : '' %> title="Sign in to your account">
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </form>

            <div class="divider-or">
                <hr>
                <span>OR</span>
                <hr>
            </div>

            <!-- GOOGLE SIGN-IN (Clients) -->
            <a href="/auth/google" class="btn btn-google w-100" id="googleSignInBtn" title="Sign in as a client with your Google account">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google">
                Sign in with Google
            </a>

            </div><!-- /#loginPanel -->

            <!-- REGISTER PANEL
                 Deliberately NOT a set of name/email/password fields. An
                 account is only ever created off an email Google has actually
                 verified (/auth/google/callback stashes the verified address
                 in the session and hands over to /complete-google-registration,
                 which is where the real registration form lives) — so the one
                 honest thing this panel can do is explain that the email step
                 comes first, then start it. Typing an email into a form here
                 would look like it registered something and would not. -->
            <div id="registerPanel" class="auth-panel d-none" role="tabpanel" aria-labelledby="registerTabBtn">

                <div class="reg-emails">
                    <span class="reg-email-chip"><i class="fas fa-graduation-cap" aria-hidden="true"></i> CSPC email (@my.cspc.edu.ph)</span>
                    <span class="reg-email-chip"><i class="fas fa-envelope" aria-hidden="true"></i> Personal email (Gmail)</span>
                </div>

                <div class="auth-steps">
                    <p class="auth-steps-title">How registration works</p>

                    <div class="auth-step">
                        <span class="step-num" aria-hidden="true">1</span>
                        <p>Sign up using your <strong>CSPC email</strong> or a <strong>personal email</strong> through Google. This is how we confirm the email is really yours.</p>
                    </div>

                    <div class="auth-step">
                        <span class="step-num" aria-hidden="true">2</span>
                        <p>After you sign in, the <strong>account registration form</strong> opens — your name and email are already filled in, and you just <strong>set your password</strong>.</p>
                    </div>

                    <div class="auth-step">
                        <span class="step-num" aria-hidden="true">3</span>
                        <p>Done. From then on you can log in from the <strong>Login</strong> tab with that same email and password.</p>
                    </div>

                    <p class="auth-steps-foot">
                        <i class="fas fa-shield-halved" aria-hidden="true"></i>
                        <span>Your password is set by you here — Google never shares your Google password with this system.</span>
                    </p>
                </div>

                <a href="/auth/google" class="btn-register-google" id="registerGoogleBtn" title="Sign up using your CSPC or personal email">
                    <span class="g-badge"><img src="https://developers.google.com/identity/images/g-logo.png" alt=""></span>
                    Sign up with Email (Google)
                </a>

            </div><!-- /#registerPanel -->

        </div>
    </div>

    <script>
        // Marks a real landing on the login page in THIS browser tab (sessionStorage
        // is tab-scoped, so this can never bleed into a different tab or a different
        // admin's browser) so that if the user later presses Forward, the shared
        // bfcache guard (public/js/main.js) redirects back here instead of letting
        // the browser silently restore a previously-cached authenticated admin page.
        // Deliberately NOT done by destroying the server-side session here — see the
        // "must NOT destroy any session" comment on the /login route in server.js:
        // admin.sid is shared by every tab in the browser, so that would log out
        // every OTHER open admin tab too.
        try { sessionStorage.setItem('__loginBoundary', window.location.pathname); } catch (e) {}
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="/js/offline-db.js"></script>
    <script src="/js/connection-prompt.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        // The Login button stays disabled until the "I'm not a robot" checkbox
        // is checked (grecaptcha calls these on the global scope by name).
        function enableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = false;
        }
        function disableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = true;
        }
    </script>
    <script>
        // ==========================================
        // LOGIN / REGISTER TAB SWITCH
        //
        // Runs BEFORE the query-param script below on purpose: that one
        // calls history.replaceState(..., location.pathname) to scrub the
        // error/status flags out of the URL, which also drops ?tab=register.
        // Reading the tab here first is what lets the server keep linking
        // straight to the Register state (e.g. the "no account found for
        // that email, please register" redirects in server.js).
        // ==========================================
        (function () {
            const switcher = document.getElementById('authSwitch');
            const tabButtons = Array.prototype.slice.call(document.querySelectorAll('.auth-switch-btn'));
            const panels = {
                login: document.getElementById('loginPanel'),
                register: document.getElementById('registerPanel')
            };
            if (!switcher || !panels.login || !panels.register) return;

            const cardTitle = document.getElementById('cardTitle');
            const cardSubtitle = document.getElementById('cardSubtitle');
            const portalBadge = document.getElementById('portalBadge');

            const COPY = {
                login: {
                    title: 'CQA Portal Login',
                    subtitle: 'Sign in to your account',
                    badge: 'Login Portal'
                },
                register: {
                    title: 'Create Your Account',
                    subtitle: 'Sign up first with your CSPC or personal email',
                    badge: 'Register Portal'
                }
            };

            function setAuthTab(tab, opts) {
                const options = opts || {};
                const active = tab === 'register' ? 'register' : 'login';

                switcher.setAttribute('data-active', active);

                tabButtons.forEach(function (btn) {
                    const isActive = btn.getAttribute('data-tab') === active;
                    btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    // Only the selected tab stays in the tab order; the arrow
                    // keys below move between them, which is how a tablist is
                    // expected to behave for keyboard users.
                    btn.setAttribute('tabindex', isActive ? '0' : '-1');
                });

                panels.login.classList.toggle('d-none', active !== 'login');
                panels.register.classList.toggle('d-none', active !== 'register');

                const copy = COPY[active];
                if (cardTitle) cardTitle.textContent = copy.title;
                if (cardSubtitle) cardSubtitle.textContent = copy.subtitle;
                if (portalBadge) portalBadge.textContent = copy.badge;

                // Keeps the address bar honest, so a reload / shared link comes
                // back to the same tab the user was looking at.
                try {
                    const url = new URL(window.location.href);
                    if (active === 'register') {
                        url.searchParams.set('tab', 'register');
                    } else {
                        url.searchParams.delete('tab');
                    }
                    window.history.replaceState({}, document.title, url.pathname + url.search);
                } catch (e) { /* non-critical */ }

                // Moving focus into the newly-shown panel helps a keyboard
                // user, but on a phone focusing the username field pops the
                // on-screen keyboard the moment someone merely taps "Login" to
                // look at it — which covers half the card. Wide viewports only.
                if (options.focus && window.matchMedia('(min-width: 768px)').matches) {
                    const target = active === 'login'
                        ? document.getElementById('usernameInput')
                        : document.getElementById('registerGoogleBtn');
                    if (target) target.focus({ preventScroll: true });
                }
            }

            tabButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    setAuthTab(btn.getAttribute('data-tab'), { focus: true });
                });
                btn.addEventListener('keydown', function (e) {
                    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
                    e.preventDefault();
                    const next = btn.getAttribute('data-tab') === 'login' ? 'register' : 'login';
                    setAuthTab(next);
                    const nextBtn = document.querySelector('.auth-switch-btn[data-tab="' + next + '"]');
                    if (nextBtn) nextBtn.focus();
                });
            });

            // The "No account yet? / Already registered?" links at the foot of
            // each panel — same switch, reached from where the user is looking.
            document.querySelectorAll('[data-auth-goto]').forEach(function (link) {
                link.addEventListener('click', function () {
                    setAuthTab(link.getAttribute('data-auth-goto'), { focus: true });
                });
            });

            const requestedTab = new URLSearchParams(window.location.search).get('tab');
            setAuthTab(requestedTab === 'register' ? 'register' : 'login');
        })();
    </script>

    <script>
        const loginQueryParams = new URLSearchParams(window.location.search);
        const loginErrorMsg = loginQueryParams.get('error');

        // Freeform error text (invalid credentials, server errors, the
        // new-tab auth guards in header.ejs/client-survey.ejs/office-approvals.ejs) —
        // unrelated to the semantic session states below, untouched.
        if (loginErrorMsg) {
            AppAlert.error(loginErrorMsg, 'Login Failed');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Explicit semantic session states — one flash param, one accurate
        // message each, shared by both the Admin and Client login flows on
        // this same page. Deliberately NOT collapsed into the freeform
        // `error` message above: manual logout, session expiration, login-
        // required, and a real cross-device/tab session replacement are four
        // different events (see ensureAdminAuth/ensureClientAuth/`/logout`
        // in server.js) and must never share one ambiguous flag or wording —
        // in particular, an ordinary session timeout must never be reported
        // as "logged in on another device," which requires actual evidence
        // (a real newer login) to say, not just "the old session is gone."
        const loginStatus = loginQueryParams.get('status');
        const STATUS_MESSAGES = {
            logged_out: { type: 'success', title: 'Logged Out', text: 'You have been logged out successfully.' },
            session_expired: { type: 'warning', title: 'Session Expired', text: 'Your session has expired. Please log in again.' },
            login_required: { type: 'info', title: 'Login Required', text: 'Please log in to continue.' },
            session_replaced: { type: 'warning', title: 'Signed In Elsewhere', text: 'Your session ended because this account was signed in from another device or browser.' }
        };
        if (loginStatus && STATUS_MESSAGES[loginStatus]) {
            const s = STATUS_MESSAGES[loginStatus];
            // logged_out reuses the same AppAlert toast design as the Client
            // Profile "updated successfully" notification; the other three
            // are less routine/more worth reading, so they use the standard
            // (non-auto-dismissing until acknowledged for warning/info)
            // AppAlert modal instead of a corner toast.
            if (s.type === 'success') {
                AppAlert.toastSuccess(s.text, { title: s.title });
            } else {
                AppAlert[s.type](s.text, s.title);
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Native browser autofill remembers every value ever typed into a text
        // input (including plain admin usernames), so it's disabled above via
        // autocomplete="off". Instead we keep our own suggestion list that only
        // ever stores values that look like an email (i.e. contain '@'), so
        // admin usernames never show up as a suggestion here.
        (function () {
            const STORAGE_KEY = 'cqa_username_suggestions';
            const MAX_SUGGESTIONS = 10;

            function loadSuggestions() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    const list = raw ? JSON.parse(raw) : [];
                    return Array.isArray(list) ? list.filter(v => typeof v === 'string' && v.includes('@')) : [];
                } catch (e) {
                    return [];
                }
            }

            function saveSuggestion(value) {
                if (!value || !value.includes('@')) return;
                const list = loadSuggestions().filter(v => v.toLowerCase() !== value.toLowerCase());
                list.unshift(value);
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_SUGGESTIONS)));
                } catch (e) { /* ignore storage errors */ }
            }

            function renderDatalist() {
                const datalist = document.getElementById('usernameSuggestions');
                if (!datalist) return;
                datalist.innerHTML = '';
                loadSuggestions().forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    datalist.appendChild(option);
                });
            }

            renderDatalist();

            const form = document.getElementById('loginForm');
            const usernameInput = document.getElementById('usernameInput');
            if (form && usernameInput) {
                form.addEventListener('submit', function () {
                    saveSuggestion(usernameInput.value.trim());
                });
            }
        })();

        // Pressing Enter while in the username field moves focus to the
        // password field instead of submitting the form right away.
        (function () {
            const usernameInput = document.getElementById('usernameInput');
            const passwordInput = document.getElementById('passwordInput');
            if (usernameInput && passwordInput) {
                usernameInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        passwordInput.focus();
                    }
                });
            }
        })();
    </script>

    <script>
        // CONNECTIVITY — owned by /js/connection-prompt.js.
        //
        // This page previously keyed everything on navigator.onLine alone,
        // and that is the bug the reported screenshots caught: a phone with
        // 4G bars but no working route showed the amber "slow or unstable"
        // chip and left the sign-in form sitting there, with no prompt and no
        // offline route offered — on the one page a client actually lands on
        // from the survey link. See connection-prompt.js for the three
        // observations it now treats as the same problem.
        //
        // The page's own /api/health probe is gone with it: two independent
        // probes could disagree about the same connection, so the module owns
        // the probe and this page just renders the state it is handed.
        // Two levels, deliberately not one:
        //
        //   OFFLINE (navigator.onLine false) keeps the existing .is-offline
        //   layout — the sign-in form, the OR divider and the Google button
        //   are hidden outright, because with no network at all none of them
        //   can do anything and a dead form is worse than no form.
        //
        //   WEAK only ADDS the offline route alongside the form; it never
        //   takes the form away. A slow connection may still finish a
        //   sign-in, the latency threshold is a judgement call that can
        //   misfire on a merely-bad-day network, and removing someone's login
        //   form on a false positive is a far worse failure than showing them
        //   an extra button they can ignore. So weak persuades, offline
        //   decides.
        function applyConnectionState(unusable, offline) {
            const pill = document.getElementById('offlineIndicator');
            if (pill) pill.classList.toggle('is-visible', offline);

            const offlineSurveyBtn = document.getElementById('offlineSurveyBtn');
            if (offlineSurveyBtn) offlineSurveyBtn.classList.toggle('d-none', !unusable);

            const offlineLoginNotice = document.getElementById('offlineLoginNotice');
            if (offlineLoginNotice) {
                offlineLoginNotice.classList.toggle('d-none', !unusable);
                const noticeText = offlineLoginNotice.querySelector('span');
                // The stock wording says "You're offline", which would be a
                // plain falsehood in the weak case — the form is still right
                // there and still worth trying.
                if (noticeText) {
                    noticeText.textContent = offline
                        ? "You're offline. Signing in needs a connection — but you can still answer the survey now."
                        : 'Your connection is too weak to sign in reliably. You can keep trying, or answer the survey offline now.';
                }
            }

            const offlineStepsGuide = document.getElementById('offlineStepsGuide');
            if (offlineStepsGuide) offlineStepsGuide.classList.toggle('d-none', !unusable);

            // Drives the offline layout rules in the <style> block, which is
            // what keeps the offline card short enough to fit the fold
            // without scrolling. Offline only — see above.
            document.body.classList.toggle('is-offline', offline);
        }

        function updateOfflineIndicator() {
            const offline = !navigator.onLine;
            applyConnectionState(
                window.ConnectionPrompt ? ConnectionPrompt.isUnusable() : offline,
                offline
            );
        }
        window.addEventListener('online', updateOfflineIndicator);
        window.addEventListener('offline', updateOfflineIndicator);
        updateOfflineIndicator();

        function setServerNotice(kind, message) {
            const notice = document.getElementById('serverUnavailableNotice');
            const icon = document.getElementById('serverUnavailableNoticeIcon');
            const text = document.getElementById('serverUnavailableNoticeText');
            if (!notice) return;
            if (!kind) {
                notice.classList.add('d-none');
                return;
            }
            notice.classList.remove('d-none');
            notice.classList.toggle('is-error', kind === 'error');
            if (icon) icon.className = kind === 'error' ? 'fas fa-circle-exclamation' : 'fas fa-wifi';
            if (text) text.textContent = message;
        }

        // Kept as a named global because #serverUnavailableNotice's Retry
        // button calls it inline.
        function checkServerHealth() {
            if (window.ConnectionPrompt) ConnectionPrompt.probe();
        }

        if (window.ConnectionPrompt) {
            ConnectionPrompt.init({
                context: 'login',
                onState: function (state) {
                    if (state === ConnectionPrompt.STATE_SERVER_DOWN) {
                        setServerNotice('error', 'The service is temporarily unavailable. Please try again shortly.');
                    } else {
                        // Nothing amber for weak or offline. Weak already has
                        // #offlineLoginNotice saying the same thing in the
                        // card itself, right above the offline button that
                        // does something about it, and the style block hides
                        // this notice entirely under .is-offline — so an
                        // amber chip here is either a duplicate or invisible.
                        setServerNotice(null);
                    }
                    updateOfflineIndicator();
                }
            });
        }

        // ==========================================
        // PENDING-LOGOUT / NEW-LOGIN RACE GUARD
        //
        // The race this closes: an old session goes offline, gets flagged
        // pending (cspc_client_pending_logout, set in client-survey.ejs),
        // and the /logout confirmation fails on a flaky reconnect — the
        // marker correctly stays set. If the user could start a brand new
        // login on THIS page in that window, and the stale pending
        // /logout call finally reached the server AFTER the new session
        // was created, it would destroy the NEW session instead of the old
        // one — /logout?scope=client just destroys whatever session the
        // request's client.sid cookie currently points to, and by then
        // that cookie is the new login's, not the old one. There is no way
        // to tell "old" and "new" apart from the cookie alone.
        //
        // The fix is to never let a new login start while the marker is
        // unresolved: Google sign-in and the password form are both
        // blocked until attemptPendingClientLogout() (offline-db.js)
        // positively confirms the old session is gone, at which point the
        // marker is cleared and it's safe to authenticate. This also means
        // a stale marker can no longer coexist with a freshly-created
        // session by the time /client-survey is reached — so its own
        // existing showBackOnlineTransition()/attemptPendingClientLogout()
        // handling (unchanged) never sees that combination either.
        // ==========================================
        (function () {
            const notice = document.getElementById('pendingLogoutNotice');
            const icon = document.getElementById('pendingLogoutNoticeIcon');
            const text = document.getElementById('pendingLogoutNoticeText');
            const retryBtn = document.getElementById('pendingLogoutRetryBtn');
            // Both Google entry points — "Sign in with Google" on the Login
            // tab and "Sign up with Email (Google)" on the Register tab — hit
            // the same /auth/google redirect and would create the same new
            // session, so the guard has to cover both or the Register tab
            // becomes a way around it.
            const googleBtns = Array.prototype.slice.call(
                document.querySelectorAll('#googleSignInBtn, #registerGoogleBtn')
            );
            const loginForm = document.getElementById('loginForm');
            let blocked = false;

            function setNotice(kind, message, showRetry) {
                if (!notice) return;
                notice.classList.toggle('d-none', !message);
                notice.classList.toggle('is-error', kind === 'error');
                if (icon) icon.className = kind === 'error' ? 'fas fa-triangle-exclamation' : 'fas fa-hourglass-half';
                if (text) text.textContent = message || '';
                if (retryBtn) retryBtn.classList.toggle('d-none', !showRetry);
            }

            function setBlocked(isBlocked) {
                blocked = isBlocked;
                googleBtns.forEach(function (btn) {
                    btn.classList.toggle('disabled', isBlocked);
                });
            }

            function warnBlocked(e) {
                if (!blocked) return;
                e.preventDefault();
                if (window.AppAlert) AppAlert.warning('Please wait until your previous session finishes closing before signing in.', 'One Moment');
            }

            function attempt() {
                if (typeof hasPendingClientLogout !== 'function' || !hasPendingClientLogout()) {
                    setBlocked(false);
                    setNotice(null, '', false);
                    return;
                }
                if (!navigator.onLine) {
                    setBlocked(true);
                    setNotice('warning', "You're offline. Reconnect to finish closing your previous session before signing in.", false);
                    return;
                }
                setBlocked(true);
                setNotice('warning', 'Finishing your previous session…', false);
                attemptPendingClientLogout().then(function (success) {
                    if (success) {
                        setBlocked(false);
                        setNotice(null, '', false);
                    } else {
                        // Does NOT claim the old session is gone — it isn't,
                        // yet. Stays blocked; no automatic retry loop, just
                        // the Retry button plus the next 'online' event.
                        setNotice('error', "We couldn't close your previous session because the connection is unstable. Please retry once your connection improves.", true);
                    }
                });
            }

            if (retryBtn) retryBtn.addEventListener('click', attempt);
            googleBtns.forEach(function (btn) {
                btn.addEventListener('click', warnBlocked);
            });
            if (loginForm) loginForm.addEventListener('submit', warnBlocked);
            window.addEventListener('online', attempt);

            attempt();
        })();

        // REMOVED: this used to bounce straight to /client-survey while
        // offline whenever a cached cspc_client_session existed — meant as
        // a convenience ("resume the survey app instead of re-deciding
        // between Login and Take Survey Offline"). That convenience is what
        // made the offline overlay's own Login/Dashboard buttons "blink and
        // do nothing": clicking either one navigates here (or to /), and
        // this redirect immediately bounced right back to /client-survey's
        // cached shell, whose own load-time check re-shows the exact same
        // "You're Offline" overlay — a loop, not a shortcut. And since
        // landing on /client-survey while offline shows that same overlay
        // immediately anyway (see client-survey.ejs), this redirect never
        // actually saved a step even in the cases it didn't loop — it only
        // ever added one. A cached client-side session flag was never proof
        // the live authenticated portal is usable while offline; removing
        // this is what lets this page (and /) stay reachable on their own
        // terms, as the offline overlay's Login/Dashboard buttons require.

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }
    </script>
</body>
</html>