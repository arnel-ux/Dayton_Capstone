// I-render ang SQD Table na may tamang value (5, 4, 3, 2, 1, 0) para sa Database
function renderSQD() {
    const tbody = document.getElementById('sqd-body');
    tbody.innerHTML = '';
    
    i18n[currentLang].sqd_items.forEach((item, index) => {
        tbody.innerHTML += `
            <tr>
                <td class="text-start">${item}</td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="5" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="4" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="3" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="2" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="1" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="0" class="radio-custom"></td>
            </tr>
        `;
    });
}

// Renders the bulleted Terms & Conditions summary points for the current language
function renderTermsPoints() {
    const list = document.getElementById('terms-points-list');
    if (!list) return;
    list.innerHTML = '';
    (i18n[currentLang].terms_points || []).forEach(point => {
        const li = document.createElement('li');
        li.textContent = point;
        list.appendChild(li);
    });
}

function updateTranslations() {
    document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (i18n[currentLang][key]) {
            el.innerHTML = i18n[currentLang][key];
        }
    });
}

function setLanguage(lang) {
    currentLang = lang;
    document.getElementById('btn-en').className = lang === 'en' ? 'btn btn-primary btn-sm fw-bold shadow-sm' : 'btn bg-transparent border btn-sm fw-bold shadow-sm text-body';
    document.getElementById('btn-tl').className = lang === 'tl' ? 'btn btn-primary btn-sm fw-bold shadow-sm' : 'btn bg-transparent border btn-sm fw-bold shadow-sm text-body';
    updateTranslations();
    renderSQD();
    renderTermsPoints();
}

// =====================================
// FORM SUBMISSION PAPUNTA SA SERVER.JS
// =====================================
function submitAll(event) {
    if (event) event.preventDefault();

    // Re-validate every stage (Terms, Profile, CC, SQD) before allowing submission
    for (let stage = 1; stage <= 4; stage++) {
        if (!validateStage(stage)) {
            navigate(stage);
            return;
        }
    }

    const formElement = document.getElementById('surveyForm');
    const formData = new FormData(formElement);
    const data = Object.fromEntries(formData.entries());

    // 2. Magbigay ng default value kung blangko ang tinype o hindi sinagutan ang dropdown
    data.respondent_name = data.respondent_name?.trim() || 'Anonymous';
    data.email = data.email?.trim() || 'Not Specified';
    data.client_type = data.client_type || 'Citizen';
    data.age = data.age || 'Not Specified';
    data.gender = data.gender || 'Not Specified';
    data.region = data.region || 'Not Specified';
    data.topic = 'General'; 

    data.cc1 = data.cc1 || '';
    data.cc2 = data.cc2 || '';
    data.cc3 = data.cc3 || '';

    // Siguraduhing may default number kapag walang nai-check sa table
    for(let i=0; i<=8; i++) {
        data[`sqd${i}`] = parseInt(data[`sqd${i}`] || 5);
    }

    // 3. IPAPASA ANG MGA SAGOT DIREKTA SA API
    fetch('/submit-survey', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(resData => {
        if (resData.success) {
            // Confetti Animation kapag tagumpay
            const duration = 3000;
            const animationEnd = Date.now() + duration;
            const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };
            const interval = setInterval(function(){
                const timeLeft = animationEnd - Date.now();
                if(timeLeft <= 0) return clearInterval(interval);
                const particleCount = 50 * (timeLeft / duration);
                confetti({ ...defaults, particleCount, origin: { x: Math.random() * 0.3, y: Math.random() - 0.2 } });
                confetti({ ...defaults, particleCount, origin: { x: 0.7 + Math.random() * 0.3, y: Math.random() - 0.2 } });
            }, 250);

            // Itago ang form at ipakita ang Thank You Page
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            document.getElementById('thank-you-page').classList.add('active');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
            alert("Nagkaroon ng problema: " + (resData.message || 'Database error'));
        }
    })
    .catch(err => {
        console.error("Error submitting survey:", err);
        alert("May problema sa server. Subukang i-refresh ang pahina.");
    });
}

