<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="/js/pdf-repeating-header.js"></script>
    <!-- Shared CQA report letterhead/footer/pagination rules (views/layout/report-header.ejs,
         views/layout/report-footer.ejs) — see public/css/report.css. -->
    <link rel="stylesheet" href="/css/report.css">

    <style>
        /* Custom Styles for Print-like Report */
        /* Unconditional (not just @media print) so html2pdf's 'css' pagebreak
           mode actually sees it — it inspects the normal/screen stylesheet, not
           @media print, when deciding where to cut pages. This guarantees the
           AI Feedback section always starts its own PDF page, so the repeating
           header in downloadPDF() below can reliably assume page 1 = the SQD
           section and every later page = AI Feedback. */
        .page-break { page-break-before: always; }
        /* No outer border/shadow — html2pdf captures this element as-is (it isn't
           limited to @media print), so any border/shadow here would print as a
           box around the official page, not just show on the on-screen preview. */
        .report-container {
            background: #fff;
            padding: 18px;
            color: #000;
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 0 auto;
            box-sizing: border-box;
        }

        .report-title { text-align: center; font-weight: bold; font-size: 15px; margin: 10px 0 5px; }
        .office-title { text-align: center; font-weight: bold; text-decoration: underline; text-transform: uppercase; font-size: 15px; margin-bottom: 0; max-width: 100%; white-space: normal; overflow-wrap: anywhere; }
        .sub-title { text-align: center; font-style: italic; font-size: 13px; margin-bottom: 16px; }

        .meta-info { font-size: 13px; margin-bottom: 8px; }
        .meta-info span { display: inline-block; width: 200px; }

        /* Table Styles */
        .report-table { width: 100%; table-layout: fixed; border-collapse: collapse; margin-bottom: 14px; font-size: 13px; }
        .report-table th, .report-table td { border: 1px solid #000; padding: 4px 7px; vertical-align: middle; line-height: 1.3; }
        .report-table th { text-align: center; font-weight: bold; }
        .header-blue { background-color: #8faadc !important; -webkit-print-color-adjust: exact; }
        
        /* AI Analytics Styles */
        .ai-summary-box {
            background-color: #f8f9fa;
            border-left: 4px solid #6c9bd2;
            padding: 12px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            justify-content: space-between;
            -webkit-print-color-adjust: exact;
        }
        .badge-sentiment { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .bg-pos { background-color: #dcfce7 !important; color: #166534 !important; -webkit-print-color-adjust: exact; }
        .bg-neg { background-color: #fee2e2 !important; color: #991b1b !important; -webkit-print-color-adjust: exact; }
        .bg-neu { background-color: #f1f5f9 !important; color: #334155 !important; -webkit-print-color-adjust: exact; }
        .topic-pill { background-color: #e8f0fe !important; color: #0056b3 !important; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; -webkit-print-color-adjust: exact; }

        .text-center { text-align: center; }
        .fw-bold { font-weight: bold; }
        
        /* Signatures — the SQD numerical-summary page's own lower section (Prepared/
           Interpretation/Noted/Reviewed) is styled by .sqd-report-footer-layout in
           public/css/report.css instead; .signature-section below is only the AI
           Feedback page's plain two-column Prepared/Reviewed row. */
        .signature-section { display: flex; justify-content: space-between; margin-top: 18px; font-size: 13px; }
        .sig-block { width: 45%; }
        .sig-name { font-weight: bold; margin-top: 14px; margin-bottom: 0; }
        .sig-title { margin: 0; }

        /* Page break for printing (letterhead/footer/page-setup rules live in
           public/css/report.css so they stay identical across every SQD report).
           page-break-inside: avoid on .report-container keeps the numerical-summary
           page from splitting across two printed sheets, matching CSPC's one-page
           official CSM survey result format. */
        @media print {
            .no-print { display: none !important; }
            .report-container { border: none; box-shadow: none; max-width: 100%; padding: 0; display: block; page-break-after: always; page-break-inside: avoid; break-inside: avoid; overflow: visible; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body data-connection-alerts>
<div id="wrapper">
    <%- include('layout/sidebar') %>
    <div id="content">
        <%- include('layout/navbar') %>
        <div class="container-fluid p-0">
            
            <div class="card card-custom mb-4 no-print">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">Report Parameters</h6>
                    <form class="row g-3" id="reportForm">
                        <div class="col-md-3">
                            <label class="form-label text-muted">Quarter</label>
                            <select class="form-select bg-light" id="selectQuarter">
                                <option value="1st Quarter">1st Quarter</option>
                                <option value="2nd Quarter">2nd Quarter</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted">Period Covered</label>
                            <select class="form-select bg-light" id="selectPeriod">
                                <option value="">All Periods</option>
                                <% if (typeof periodOptions !== 'undefined') { %>
                                    <% periodOptions.forEach(function(opt) { %>
                                        <option value="<%= opt.value %>"><%= opt.label %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Filter by Office</label>
                            <select class="form-select bg-light" id="selectOffice">
                                <option value="" selected disabled>Select Office</option>
                                <% if (typeof offices !== 'undefined' && offices.length > 0) { %>
                                    <% offices.forEach(function(office) { %>
                                        <option value="<%= office.office_name %>"><%= office.office_name %></option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-primary w-100" onclick="generateReport()"><i class="fas fa-sync-alt me-2"></i> Generate</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card card-custom" id="emptyState">
                <div class="card-body p-5 text-center text-muted">
                    <i class="fas fa-chart-bar fa-3x mb-3 text-light"></i>
                    <h5>No Report Generated Yet</h5>
                    <p>Select your parameters above and click generate to view data.</p>
                </div>
            </div>

            <div id="generatedReportWrapper" style="display: none;">
                <div class="d-flex justify-content-end gap-2 mb-3 px-4 no-print">
                    <button class="btn btn-danger" onclick="downloadPDF()"><i class="fas fa-file-pdf me-2"></i> Download PDF</button>
                    <button class="btn btn-success" onclick="downloadCSV()"><i class="fas fa-file-csv me-2"></i> Download CSV</button>
                </div>

                <div id="reportContentToExport">
                    
                    <!-- PANG-UNANG PAHINA (NUMERICAL SUMMARY) -->
                    <div class="report-container" style="display: block; margin-bottom: 30px;">
                        <%- include('layout/report-header', { showSQDFormCode: true, docCode: 'CSPC-F-CQA-06' }) %>

                        <div class="sqd-report-title">CLIENT SATISFACTION MEASUREMENT SURVEY RESULT</div>
                        <p class="sqd-office-name" id="displayOfficeName1"></p>

                        <div class="sqd-meta-block">
                            <div class="sqd-meta-row"><span class="sqd-meta-label">Period Covered:</span> <span class="sqd-meta-value" id="displayPeriod1"></span></div>
                            <div class="sqd-meta-row"><span class="sqd-meta-label">Number of Respondents:</span> <span class="sqd-meta-value" id="totalRespondents1">0</span></div>
                        </div>

                        <table class="report-table" id="tableData1">
                            <thead>
                                <tr class="header-blue">
                                    <th rowspan="2" style="width: 60%;">SERVICE QUALITY DIMENSIONS<br><span style="font-weight: normal;">(Mga Dimensyon sa Kalidad na Serbisyo)</span></th>
                                    <th colspan="2">COMPUTATION</th>
                                </tr>
                                <tr class="header-blue">
                                    <th style="width: 20%;">PERCENTAGE</th>
                                    <th style="width: 20%;">RATING</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1. Responsiveness (Pagtugon)/(Pagsimbag)</td>
                                    <td class="text-center" id="sqd1_score">0.00%</td>
                                    <td class="text-center" id="sqd1_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>2. Reliability (Quality)/Mapagkakatiwalaan</td>
                                    <td class="text-center" id="sqd2_score">0.00%</td>
                                    <td class="text-center" id="sqd2_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>3. Access & Facilities/Akses/Gamit at Pasilidad</td>
                                    <td class="text-center" id="sqd3_score">0.00%</td>
                                    <td class="text-center" id="sqd3_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>4. Communication/Komunikasyon</td>
                                    <td class="text-center" id="sqd4_score">0.00%</td>
                                    <td class="text-center" id="sqd4_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>5. Costs (Gastos)/ Kantidad</td>
                                    <td class="text-center" id="sqd5_score">0.00%</td>
                                    <td class="text-center" id="sqd5_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>6. Integrity/(Integredad)</td>
                                    <td class="text-center" id="sqd6_score">0.00%</td>
                                    <td class="text-center" id="sqd6_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>7. Assurance (Kasiguruhan)</td>
                                    <td class="text-center" id="sqd7_score">0.00%</td>
                                    <td class="text-center" id="sqd7_interp">Poor</td>
                                </tr>
                                <tr>
                                    <td>8. Outcome (Resulta)</td>
                                    <td class="text-center" id="sqd8_score">0.00%</td>
                                    <td class="text-center" id="sqd8_interp">Poor</td>
                                </tr>
                                <tr class="header-blue fw-bold">
                                    <td class="text-end" style="padding-right: 20px;">OVERALL SCORE</td>
                                    <td class="text-center" id="overall_score">0.00%</td>
                                    <td class="text-center" id="overall_interp">POOR</td>
                                </tr>
                            </tbody>
                        </table>

                        <%- include('layout/sqd-report-footer') %>

                        <!-- No Effectivity/Rev./Page-label footer here on purpose: CSPC-F-CQA-06's
                             official Client Satisfaction Measurement Survey Result format (unlike
                             cluster-detail.ejs, survey-records.ejs and print.ejs, which legitimately
                             print that footer) doesn't include it. -->
                    </div>

                    <!-- PANGALAWANG PAHINA (WRITTEN COMMENTS & AI ANALYTICS) -->
                    <div class="report-container page-break" style="display: block;">
                        <%- include('layout/report-header', { showSQDFormCode: false }) %>

                        <div class="report-title">AI FEEDBACK SENTIMENT & TOPIC ANALYTICS</div>
                        <p class="office-title" id="displayOfficeName2"></p>

                        <div class="meta-info mt-4">
                            <div><span>Period Covered:</span> <strong id="displayPeriod2"></strong></div>
                            <div><span>Analyzed Feedbacks:</span> <strong id="totalRespondents2">0</strong></div>
                        </div>

                        <!-- AI Summary Box -->
                        <div class="ai-summary-box mt-3">
                            <div><strong>AI Sentiment Breakdown:</strong></div>
                            <div>Positive: <span id="aiPos" class="fw-bold" style="color: #166534;">0</span></div>
                            <div>Neutral: <span id="aiNeu" class="fw-bold" style="color: #334155;">0</span></div>
                            <div>Negative: <span id="aiNeg" class="fw-bold" style="color: #991b1b;">0</span></div>
                            <div>| &nbsp; Dominant Topic: <span id="aiDomTopic" class="fw-bold" style="color: #0056b3;">N/A</span></div>
                        </div>

                        <table class="report-table" style="margin-bottom: 50px;">
                            <thead>
                                <tr class="header-blue">
                                    <th style="width: 10%;">NO.</th>
                                    <th style="width: 50%;">WRITTEN COMMENTS/SUGGESTIONS</th>
                                    <th style="width: 20%;">AI MODELED TOPIC</th>
                                    <th style="width: 20%;">AI SENTIMENT</th>
                                </tr>
                            </thead>
                            <tbody id="commentsBody">
                                <!-- Dinamikong ipapasok dito ng JS ang mga komento -->
                            </tbody>
                        </table>

                        <div class="signature-section">
                            <div class="sig-block">
                                <div>Prepared by:</div>
                                <p class="sig-name">JUVY M. BUSTAMANTE, JD</p>
                                <p class="sig-title">AOV-CQA</p>
                                
                                <div style="margin-top: 30px;">Noted by:</div>
                                <p class="sig-name">AMADO A. OLIVA JR., PhD</p>
                                <p class="sig-title">SUC President III</p>
                            </div>
                            <div class="sig-block">
                                <div>Reviewed by:</div>
                                <p class="sig-name">JOCELYN O. JINTALAN, DBA</p>
                                <p class="sig-title">ISO Chair</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('layout/footer') %>

<script>
    async function generateReport() {
        const selectedOffice = document.getElementById('selectOffice').value;
        if (!selectedOffice) {
            AppAlert.error("Please select a specific office before generating a report.");
            return;
        }
        const selectedQuarter = document.getElementById('selectQuarter').value;
        const selectedPeriodSelect = document.getElementById('selectPeriod');
        const selectedPeriod = selectedPeriodSelect.value;
        const selectedPeriodLabel = selectedPeriodSelect.options[selectedPeriodSelect.selectedIndex].text;
        const displayPeriodText = `${selectedQuarter}, ${selectedPeriodLabel}`;

        document.getElementById('displayOfficeName1').innerText = selectedOffice;
        document.getElementById('displayPeriod1').innerText = displayPeriodText;
        document.getElementById('displayOfficeName2').innerText = selectedOffice;
        document.getElementById('displayPeriod2').innerText = displayPeriodText;

        try {
            const response = await fetch('/api/report-data', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ office: selectedOffice, periodCovered: selectedPeriod })
            });
            const data = await response.json();

            updateReportTable(data.stats);
            updateCommentsTable(data.comments);

            document.getElementById('emptyState').style.display = 'none';
            document.getElementById('generatedReportWrapper').style.display = 'block';
            document.getElementById('generatedReportWrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });

        } catch (err) {
            console.error("Error generating report:", err);
            AppAlert.error("Failed to fetch report data.");
        }
    }

    function getInterpretation(score) {
        if (score >= 95) return "Outstanding";
        if (score >= 90) return "Very Satisfactory";
        if (score >= 80) return "Satisfactory";
        if (score >= 60) return "Fair";
        return "Poor";
    }

    // A dimension nobody could rate — no respondents at all, or every respondent
    // marked it N/A — has no percentage to show. Printing 0.00%/Poor would read as
    // "rated, and rated badly", so these cells print N/A instead, the same way the
    // SQD 0 / SQD 1-8 bucket tables already do.
    function sqdAnswerableCount(stats, prefix) {
        return ['sa', 'a', 'n', 'd', 'sd'].reduce((sum, b) => sum + (parseInt(stats[`${prefix}_${b}`]) || 0), 0);
    }

    function updateReportTable(stats) {
        const totalResp = stats.total_respondents || 0;
        document.getElementById('totalRespondents1').innerText = totalResp;
        document.getElementById('totalRespondents2').innerText = totalResp;

        let overallAnswerable = 0;
        for (let i = 1; i <= 8; i++) {
            const answerable = sqdAnswerableCount(stats, `sqd${i}`);
            overallAnswerable += answerable;
            const scoreEl = document.getElementById(`sqd${i}_score`);
            const interpEl = document.getElementById(`sqd${i}_interp`);
            if (answerable === 0) {
                scoreEl.innerText = 'N/A';
                interpEl.innerText = 'N/A';
            } else {
                const score = parseFloat(stats[`sqd${i}`] || 0);
                scoreEl.innerText = score.toFixed(2) + '%';
                interpEl.innerText = getInterpretation(score);
            }
        }

        const overall = parseFloat(stats.overall_score || 0);
        document.getElementById('overall_score').innerText = overallAnswerable === 0 ? 'N/A' : overall.toFixed(2) + '%';
        document.getElementById('overall_interp').innerText = overallAnswerable === 0 ? 'N/A' : getInterpretation(overall).toUpperCase();
    }

    function updateCommentsTable(comments) {
        const tbody = document.getElementById('commentsBody');
        tbody.innerHTML = '';
        
        let pos = 0, neu = 0, neg = 0;
        let topics = {};

        if (!comments || comments.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="text-center py-4 text-muted">NO WRITTEN COMMENTS AND SUGGESTIONS REFLECTED IN ANY OF THE INSTRUMENTS</td></tr>`;
            document.getElementById('aiPos').innerText = '0';
            document.getElementById('aiNeu').innerText = '0';
            document.getElementById('aiNeg').innerText = '0';
            document.getElementById('aiDomTopic').innerText = 'N/A';
        } else {
            comments.forEach((c, index) => {
                // Tally AI Analytics
                let aiSentiment = c.sentiment || 'Neutral';
                if (aiSentiment === 'Positive') pos++;
                else if (aiSentiment === 'Negative') neg++;
                else neu++;

                let aiTopic = c.topic || 'General Feedback';
                topics[aiTopic] = (topics[aiTopic] || 0) + 1;

                // Set Badge Colors
                let badgeClass = 'bg-neu';
                if (aiSentiment === 'Positive') badgeClass = 'bg-pos';
                if (aiSentiment === 'Negative') badgeClass = 'bg-neg';

                tbody.innerHTML += `<tr>
                    <td class="text-center">${index + 1}</td>
                    <td>${c.comments}</td>
                    <td class="text-center"><span class="topic-pill">${aiTopic}</span></td>
                    <td class="text-center"><span class="badge-sentiment ${badgeClass}">${aiSentiment}</span></td>
                </tr>`;
            });

            // Update AI Analytics Box
            document.getElementById('aiPos').innerText = pos;
            document.getElementById('aiNeu').innerText = neu;
            document.getElementById('aiNeg').innerText = neg;

            // Find Dominant Topic
            let domTopic = 'N/A';
            let maxCount = 0;
            for (const [key, value] of Object.entries(topics)) {
                if (value > maxCount) { maxCount = value; domTopic = key; }
            }
            document.getElementById('aiDomTopic').innerText = domTopic;
        }
    }

    function downloadPDF() {
        // Two report identities share this one PDF: the SQD numerical summary
        // (always exactly one page — the table is a fixed 8 rows) and AI Feedback
        // Sentiment & Topic Analytics (can span several pages if there are many
        // comments). Page 1 always belongs to the SQD section; every later page
        // belongs to AI Feedback — see public/js/pdf-repeating-header.js and the
        // unconditional .page-break rule above that guarantees this split.
        const sqdHeader = {
            title: 'Client Satisfaction Measurement Survey Result',
            subtitle: document.getElementById('displayOfficeName1').textContent.trim(),
            subtitleUnderline: true,
            metaLines: [
                { label: 'Period Covered:', value: document.getElementById('displayPeriod1').textContent.trim() },
                { label: 'Number of Respondents:', value: document.getElementById('totalRespondents1').textContent.trim() }
            ],
            docCode: 'CSPC-F-CQA-06'
        };
        const aiHeader = {
            title: 'AI Feedback Sentiment & Topic Analytics',
            subtitle: document.getElementById('displayOfficeName2').textContent.trim(),
            subtitleUnderline: true,
            period: 'Period Covered: ' + document.getElementById('displayPeriod2').textContent.trim(),
            meta: 'Analyzed Feedbacks: ' + document.getElementById('totalRespondents2').textContent.trim()
        };

        // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
        // html2pdf's margin array is [top, left, bottom, right] (not CSS order);
        // top is overridden by exportRepeatingHeaderPdf to reserve space for the
        // redrawn header.
        const opt = {
            margin:       [0, 0.5, 0.25, 0.25],
            filename:     'CSM_Report.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true, letterRendering: true, scrollY: 0, backgroundColor: '#ffffff' },
            jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' },
            pagebreak:    { mode: ['css', 'legacy'], avoid: ['.signature-section', '.sqd-interpretation-standalone', '.sqd-signature-grid', 'tr'] }
        };

        exportRepeatingHeaderPdf({
            elementId: 'reportContentToExport',
            filename: opt.filename,
            opt,
            headerHeightIn: 2.4,
            headerHideSelectors: ['.report-header-block', '.sqd-report-title', '.sqd-office-name', '.sqd-meta-block', '.report-title', '.office-title', '.meta-info'],
            getHeaderForPage: (pageNum) => (pageNum === 1 ? sqdHeader : aiHeader),
            avoidSplitSelector: '.sqd-signature-grid'
        });
    }

    function downloadCSV() {
        let csv = [];
        const rows = document.querySelectorAll(".report-table tr");
        
        for (let i = 0; i < rows.length; i++) {
            let row = [], cols = rows[i].querySelectorAll("td, th");
            for (let j = 0; j < cols.length; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/(\s\s)/gm, " ");
                data = data.replace(/"/g, '""'); 
                row.push('"' + data + '"');
            }
            csv.push(row.join(","));
        }

        const csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
        const downloadLink = document.createElement("a");
        downloadLink.download = "CSM_Data.csv";
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = "none";
        document.body.appendChild(downloadLink);
        downloadLink.click();
    }
</script>
</body>
</html>
