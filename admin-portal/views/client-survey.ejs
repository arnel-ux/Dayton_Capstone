                            <span class="home-feature-chip"><i class="bi bi-file-earmark-check-fill"></i> <span data-i18n="home_chip_arta">RA 11032 / ARTA-mandated</span></span>
                            <span class="home-feature-chip"><i class="bi bi-clock-fill"></i> <span data-i18n="home_chip_quick">Takes only a few minutes</span></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        </div>
        </div>

        <div class="app-view" id="view-survey">
        <div class="card border-0 survey-card">
        <div class="card-body p-4 p-md-5 position-relative">

            <div class="survey-hero text-center mb-5">
                <div class="survey-hero-logo-wrap">
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="survey-hero-logo">
                </div>
                <div class="survey-hero-eyebrow" data-i18n="gov_rep">Republic of the Philippines</div>
                <h3 class="fw-bold text-uppercase mb-0 text-heading survey-hero-title">Camarines Sur Polytechnic Colleges</h3>
                <p class="text-secondary fst-italic mb-4">Nabua, Camarines Sur</p>

                <div class="survey-hero-badge">
                    <i class="bi bi-clipboard2-check-fill"></i>
                    <h4 class="fw-semibold text-uppercase mb-0" data-i18n="form_title">Client Satisfaction Measurement (CSM) Survey</h4>
                </div>
            </div>

            <div class="survey-progress mb-5" id="surveyProgress">
