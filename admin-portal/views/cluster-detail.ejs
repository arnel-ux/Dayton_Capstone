<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Shared CQA report letterhead/footer/pagination rules (views/layout/report-header.ejs,
         views/layout/report-footer.ejs) — see public/css/report.css. -->
    <link rel="stylesheet" href="/css/report.css">

    <style>
        :root { --primary-gradient: linear-gradient(135deg, #251d3a 0%, #2a2550 100%); --glass-bg: #ffffff; --navy: #251d3a; }
        body { background-color: #f1f5f9; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--navy); overflow-x: hidden; }
        html[data-bs-theme="dark"] body { background-color: #0b1526; color: #e2e8f0; }
        html[data-bs-theme="dark"] .chart-card,
        html[data-bs-theme="dark"] .stat-box,
        html[data-bs-theme="dark"] .filter-bar { background: #141d30; }
        html[data-bs-theme="dark"] .stat-box h3 { color: #e2e8f0; }
        html[data-bs-theme="dark"] .stat-box p,
        html[data-bs-theme="dark"] .filter-bar label { color: #94a3b8; }
        html[data-bs-theme="dark"] .filter-bar select,
        html[data-bs-theme="dark"] .filter-bar .form-select { background-color: #1e293b; color: #e2e8f0; border-color: #263045; }
        @keyframes fadeInUp { 0% { opacity: 0; transform: translateY(30px); } 100% { opacity: 1; transform: translateY(0); } }
        .animated-intro { animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .hero-header { text-align: center; padding: 1rem 1rem 0.5rem 1rem; }
        .status-badge { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(90deg, #10b981, #059669); color: white; padding: 6px 20px; border-radius: 50px; font-weight: bold; font-size: 0.9rem; }
        .chart-card { background: white; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 25px; margin-top: 20px; }

        /* Matches the metric-switch toggle used on the main admin dashboard's
           Cluster Performance Analytics chart, so both pages read the same. */
        .chart-toggle-group { display: inline-flex; background: rgba(15, 23, 42, 0.05); border-radius: 10px; padding: 4px; gap: 4px; flex-shrink: 0; }
        html[data-bs-theme="dark"] .chart-toggle-group { background: rgba(255, 255, 255, 0.08); }
        .chart-toggle-btn {
            border: none; background: transparent; padding: 7px 16px; border-radius: 8px;
            font-size: 0.78rem; font-weight: 700; color: #64748b; cursor: pointer; transition: all 0.15s ease;
        }
        .chart-toggle-btn:hover { color: #251d3a; }
        .chart-toggle-btn.active { background: #251d3a; color: #fff; box-shadow: 0 2px 6px rgba(37, 29, 58, 0.25); }
        html[data-bs-theme="dark"] .chart-toggle-btn { color: #94a3b8; }
        html[data-bs-theme="dark"] .chart-toggle-btn:hover { color: #e2e8f0; }
        .stats-container { display: flex; justify-content: center; gap: 20px; margin-top: 20px; flex-wrap: wrap; }
        .stat-box { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-width: 200px; text-align: center; border-bottom: 4px solid #251d3a; }
        .stat-box h3 { font-size: 2rem; font-weight: 800; margin-bottom: 5px; color: #1e293b; }
        .stat-box p { margin: 0; color: #64748b; font-size: 0.9rem; text-transform: uppercase; font-weight: 600; }

        .filter-bar {
            display: flex; flex-wrap: wrap; align-items: center; gap: 14px;
            background: white; border-radius: 16px; padding: 18px 22px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-top: 20px;
        }
        .filter-bar .filter-group { display: flex; flex-direction: column; gap: 4px; flex: 0 1 auto; }
        .filter-bar label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; }
        .filter-bar .btn-generate { margin-left: auto; flex-shrink: 0; align-self: flex-end; }
        /* Fixed (not min-) width keeps long office names from auto-expanding the
           <select> and pushing the Generate Report button onto its own line. */
        .filter-bar .filter-group select {
            width: 230px;
            max-width: 100%;
            text-overflow: ellipsis;
            white-space: nowrap;
            overflow: hidden;
        }

        /* --- Office Report (mirrors report.ejs exactly) --- */
        .report-container {
            background: #fff; padding: 40px; color: #000; font-family: Arial, sans-serif;
            max-width: 900px; margin: 0 auto; border: 1px solid #ccc; box-shadow: 0 0 10px rgba(0,0,0,0.1);
            box-sizing: border-box;
        }
        .report-title { text-align: center; font-weight: bold; font-size: 15px; margin: 10px 0 5px; }
        .office-title { text-align: center; font-weight: bold; text-decoration: underline; text-transform: uppercase; font-size: 15px; margin-bottom: 0; }
        .cqa-title { text-align: center; font-weight: bold; text-decoration: underline; font-size: 14px; margin-top: 3px; }
        .office-name-line { text-align: center; font-style: italic; font-size: 13px; margin-bottom: 3px; }
        /* One office's SQD 0 / SQD 1-8 section within the "Number of Respondents,
           All Offices" packet — separated visually and kept off a print page break. */
        .office-block { margin: 18px 0; padding-top: 10px; border-top: 1px dashed #ccc; page-break-inside: avoid; }
        .office-block:first-child { border-top: none; padding-top: 0; margin-top: 8px; }
        .section-title { font-weight: bold; font-size: 13px; text-transform: uppercase; margin: 16px 0 8px; padding-bottom: 3px; border-bottom: 1px solid #ccc; }
        .meta-info { font-size: 13px; margin-bottom: 8px; }
        .meta-info span { display: inline-block; width: 200px; }
        .report-table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 12px; }
        .report-table th, .report-table td { border: 1px solid #000; padding: 4px 7px; }
        .report-table th { text-align: center; font-weight: bold; }
        .header-blue { background-color: #8faadc !important; -webkit-print-color-adjust: exact; }
        .overall-row { font-weight: bold; background-color: #bdd7ee !important; -webkit-print-color-adjust: exact; }
        .total-row { font-weight: bold; background-color: #f2f2f2 !important; -webkit-print-color-adjust: exact; }
        .text-end { text-align: right; }
        /* SQD Result Report tables specifically — centered rows and roomier cells,
           matching the CQA Excel template's layout (the office-header/comments
           tables elsewhere on this page keep their own left-aligned styling). */
        #sqdReportTables .report-table th, #sqdReportTables .report-table td,
        #multiOfficeReportBody .report-table th, #multiOfficeReportBody .report-table td { padding: 8px 10px; }
        #sqdReportTables .report-table td:first-child,
        #multiOfficeReportBody .report-table td:first-child { text-align: center; }
        .ai-summary-box { background-color: #f8f9fa; border-left: 4px solid #6c9bd2; padding: 12px; margin-bottom: 15px; font-size: 13px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; -webkit-print-color-adjust: exact; }
        .badge-sentiment { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .bg-pos { background-color: #dcfce7 !important; color: #166534 !important; -webkit-print-color-adjust: exact; }
        .bg-neg { background-color: #fee2e2 !important; color: #991b1b !important; -webkit-print-color-adjust: exact; }
        .bg-neu { background-color: #f1f5f9 !important; color: #334155 !important; -webkit-print-color-adjust: exact; }
        .topic-pill { background-color: #e8f0fe !important; color: #0056b3 !important; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; -webkit-print-color-adjust: exact; }
        .interpretation-box { font-size: 13px; margin-left: 50%; margin-bottom: 14px; }
        .interpretation-box table { border: none; }
        .interpretation-box td { padding: 1px 10px; border: none; }
        .signature-section { display: flex; justify-content: space-between; margin-top: 18px; font-size: 13px; }
        .sig-block { width: 45%; }
        .noted-block { margin-top: 14px; font-size: 13px; }
        .sig-name { font-weight: bold; margin-top: 14px; margin-bottom: 0; }
        .sig-title { margin: 0; }
        /* Letterhead/footer/page-setup rules live in public/css/report.css so they
           stay identical across every SQD report. page-break-inside: avoid on
           .report-container keeps each page (numerical summary, AI feedback) from
           splitting across two printed sheets. */
        @media print {
            #wrapper > *:not(#content), .no-print { display: none !important; }
            #content, .container-fluid { padding: 0 !important; margin: 0 !important; }
            .report-container { border: none; box-shadow: none; max-width: 100%; padding: 0; display: block; page-break-after: always; page-break-inside: avoid; break-inside: avoid; overflow: visible; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body>
    <div id="wrapper">
        <%- include('layout/sidebar') %>
        <div id="content">
            <%- include('layout/navbar') %>

            <div class="container-fluid px-4 py-4 animated-intro">
                <div class="hero-header">
                    <div class="status-badge">
                        <i class="fas fa-check-circle"></i> Active Reporting
                    </div>
                    <h2 class="fw-bold mt-3 mb-1"><%= clusterName %></h2>
                    <p class="text-muted">Real-time satisfaction ratings and respondent volume per office.</p>
                </div>

                <form class="filter-bar" method="GET" action="/cluster/<%= clusterId %>">
                    <div class="filter-group">
                        <label for="periodCovered">Period Covered</label>
                        <select id="periodCovered" name="periodCovered" class="form-select form-select-sm" title="Filter by period covered" onchange="this.form.submit()">
                            <option value="">All Periods</option>
                            <% if (typeof periodOptions !== 'undefined') { %>
                                <% periodOptions.forEach(opt => { %>
                                    <option value="<%= opt.value %>" <%= selectedPeriod === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="officeFilter">Select Office</label>
                        <select id="officeFilter" name="office" class="form-select form-select-sm" title="Filter by office">
                            <option value="">All Offices</option>
                            <% if (typeof officesInCluster !== 'undefined') { %>
                                <% officesInCluster.forEach(o => { %>
                                    <option value="<%= o.id %>"><%= o.office_name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="reportType">Report to Generate</label>
                        <select id="reportType" name="reportType" class="form-select form-select-sm" title="Choose which report to generate">
                            <option value="sqd" selected>SQD Result Report</option>
                            <option value="respondents">Number of Respondents</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary btn-generate" onclick="renderOfficeReport()" title="Generate a report based on the selected filters">
                        <i class="fas fa-file-invoice me-2"></i> Generate Report
                    </button>
                </form>

                <div class="stats-container">
                    <div class="stat-box" style="border-bottom-color: #ffcc00;">
                        <h3 id="overallRating">0%</h3>
                        <p>Average Rating</p>
                    </div>
                    <div class="stat-box" style="border-bottom-color: #251d3a;">
                        <h3 id="totalResp">0</h3>
                        <p>Total Respondents</p>
                    </div>
                    <div class="stat-box" style="border-bottom-color: #10b981;">
                        <h3 id="totalOffices">0</h3>
                        <p>Offices Evaluated</p>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <h5 class="fw-bold mb-0">Office Ratings Distribution</h5>
                        <div class="chart-toggle-group" role="group" aria-label="Switch chart metric">
                            <button type="button" class="chart-toggle-btn active" data-metric="respondents">Respondents</button>
                            <button type="button" class="chart-toggle-btn" data-metric="rating">Satisfaction Rating</button>
                        </div>
                    </div>
                    <div style="height: 450px; position: relative;">
                        <canvas id="clusterChart"></canvas>
                    </div>
                </div>

                <div id="officeReportEmptyState" class="chart-card text-center text-muted py-5">
                    <i class="fas fa-chart-bar fa-3x mb-3 text-light"></i>
                    <h5>No Report Generated Yet</h5>
                    <p class="mb-0">Select a period covered and/or office above, then click "Generate Report" to view the detailed CSM report.</p>
                </div>

                <div id="officeReportWrapper" class="d-none">
                    <div class="chart-card">
                        <div class="d-flex justify-content-end gap-2 mb-3 no-print">
                            <button class="btn btn-danger btn-sm" onclick="downloadOfficeReportPDF()"><i class="fas fa-file-pdf me-2"></i> Download PDF</button>
                            <button class="btn btn-success btn-sm" onclick="downloadOfficeReportCSV()"><i class="fas fa-file-csv me-2"></i> Download CSV</button>
                            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-2"></i> Print</button>
                        </div>

                        <div id="officeReportContentToExport">
                        <!-- PAGE 1: NUMERICAL SUMMARY -->
                        <div class="report-container" style="margin-bottom: 30px;">
                            <%- include('layout/report-header', { docCode: 'CSPC-F-CQA-06' }) %>

                            <div class="report-title" id="officeReportMainTitle1">CLIENT SATISFACTION MEASUREMENT SURVEY RESULT</div>
                            <div class="cqa-title">CENTER FOR QUALITY ASSURANCE</div>
                            <p class="office-name-line" id="officeReportTitle1"></p>

                            <div class="meta-info mt-4">
                                <div><span>Period Covered:</span> <strong id="officeReportPeriod1"></strong></div>
                                <div><span>Number of Respondents:</span> <strong id="officeReportTotal1">0</strong></div>
                            </div>

                            <!-- SQD Result Report: the official Percentage/Rating scorecard
                                 (live from /api/report-data's sqd1..sqd8/overall_score %s). -->
                            <div id="percentageReportTable">
                                <table class="report-table">
                                    <thead>
                                        <tr class="header-blue">
                                            <th rowspan="2" style="width: 60%;">SERVICE QUALITY DIMENSIONS<br><span style="font-weight: normal;">(Mga Dimensyon sa Kalidad na Serbisyo)</span></th>
                                            <th colspan="2">COMPUTATION</th>
                                        </tr>
                                        <tr class="header-blue">
                                            <th style="width: 20%;">PERCENTAGE</th>
                                            <th style="width: 20%;">RATING</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>1. Responsiveness (Pagtugon)/(Pagsimbag)</td><td class="text-center" id="off_sqd1_score">0.00%</td><td class="text-center" id="off_sqd1_interp">Poor</td></tr>
                                        <tr><td>2. Reliability (Quality)/Mapagkakatiwalaan</td><td class="text-center" id="off_sqd2_score">0.00%</td><td class="text-center" id="off_sqd2_interp">Poor</td></tr>
                                        <tr><td>3. Access & Facilities/Akses/Gamit at Pasilidad</td><td class="text-center" id="off_sqd3_score">0.00%</td><td class="text-center" id="off_sqd3_interp">Poor</td></tr>
                                        <tr><td>4. Communication/Komunikasyon</td><td class="text-center" id="off_sqd4_score">0.00%</td><td class="text-center" id="off_sqd4_interp">Poor</td></tr>
                                        <tr><td>5. Costs (Gastos)/ Kantidad</td><td class="text-center" id="off_sqd5_score">0.00%</td><td class="text-center" id="off_sqd5_interp">Poor</td></tr>
                                        <tr><td>6. Integrity/(Integredad)</td><td class="text-center" id="off_sqd6_score">0.00%</td><td class="text-center" id="off_sqd6_interp">Poor</td></tr>
                                        <tr><td>7. Assurance (Kasiguruhan)</td><td class="text-center" id="off_sqd7_score">0.00%</td><td class="text-center" id="off_sqd7_interp">Poor</td></tr>
                                        <tr><td>8. Outcome (Resulta)</td><td class="text-center" id="off_sqd8_score">0.00%</td><td class="text-center" id="off_sqd8_interp">Poor</td></tr>
                                        <tr class="header-blue fw-bold">
                                            <td class="text-end" style="padding-right: 20px;">OVERALL SCORE</td>
                                            <td class="text-center" id="off_overall_score">0.00%</td>
                                            <td class="text-center" id="off_overall_interp">POOR</td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div class="interpretation-box">
                                    <div class="fw-bold mb-1">INTERPRETATION OF RESULTS</div>
                                    <table>
                                        <tr><td>95.0% to 100%</td><td>Outstanding</td></tr>
                                        <tr><td>90.0% to 94.9%</td><td>Very Satisfactory</td></tr>
                                        <tr><td>80.0% to 89.9%</td><td>Satisfactory</td></tr>
                                        <tr><td>60.0% to 79.9%</td><td>Fair</td></tr>
                                        <tr><td>Below 60.0%</td><td>Poor</td></tr>
                                    </table>
                                </div>
                            </div>

                            <!-- "Number of Respondents" + one office selected: SQD 0 / SQD 1-8
                                 rating-bucket breakdown (live from /api/report-data). -->
                            <div id="sqdReportTables" class="d-none">
                                <div class="section-title">SQD 0 Results</div>
                                <table class="report-table">
                                    <thead>
                                        <tr class="header-blue">
                                            <th>Service Quality</th>
                                            <th>Strongly Agree</th>
                                            <th>Agree</th>
                                            <th>Neither Agree or Disagree</th>
                                            <th>Disagree</th>
                                            <th>Strongly Disagree</th>
                                            <th>N/A</th>
                                            <th>Total Responses</th>
                                            <th>Overall</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sqd0Body"></tbody>
                                </table>

                                <div class="section-title">SQD 1-8 Results</div>
                                <table class="report-table">
                                    <thead>
                                        <tr class="header-blue">
                                            <th>Service Quality</th>
                                            <th>Strongly Agree</th>
                                            <th>Agree</th>
                                            <th>Neither Agree or Disagree</th>
                                            <th>Disagree</th>
                                            <th>Strongly Disagree</th>
                                            <th>N/A</th>
                                            <th>Total Responses</th>
                                            <th>Overall</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sqd18Body"></tbody>
                                </table>
                            </div>

                            <!-- "Number of Respondents" + ALL OFFICES: one full SQD 0 / SQD 1-8
                                 section per office in the cluster (from /api/report-data-by-cluster),
                                 built client-side into this container by renderMultiOfficeReport(). -->
                            <div id="multiOfficeReportBody" class="d-none"></div>

                            <div class="signature-section">
                                <div class="sig-block">
                                    <div>Prepared by:</div>
                                    <p class="sig-name">JUVY M. BUSTAMANTE, JD</p>
                                    <p class="sig-title">AOV-CQA</p>
                                </div>
                                <div class="sig-block">
                                    <div>Reviewed by:</div>
                                    <p class="sig-name">JOCELYN O. JINTALAN, DBA</p>
                                    <p class="sig-title">ISO Chair</p>
                                </div>
                            </div>
                            <div class="noted-block">
                                <div>Noted by:</div>
                                <p class="sig-name">AMADO A. OLIVA JR., PhD</p>
                                <p class="sig-title">SUC President III</p>
                            </div>

                            <!-- Effectivity/Rev./Page footer: only the SQD Result Report is CSPC's
                                 official CSM survey result format that requires it — the "Number of
                                 Respondents" report reuses this same page but must not show it, so
                                 renderOfficeReport() toggles this wrapper's visibility by reportType
                                 rather than hiding it globally. -->
                            <div id="officeReportFooter1">
                                <%- include('layout/report-footer', { pageLabel: 'Page 1 of 2', footerId: 'footerPageLabel1' }) %>
                            </div>
                        </div>

                        <!-- PAGE 2: WRITTEN COMMENTS & AI ANALYTICS (SQD Result Report only) -->
                        <div class="report-container page-break" id="reportPage2">
                            <%- include('layout/report-header', { docCode: 'CSPC-F-CQA-06' }) %>

                            <div class="report-title">AI FEEDBACK SENTIMENT & TOPIC ANALYTICS</div>
                            <p class="office-title" id="officeReportTitle2"></p>

                            <div class="meta-info mt-4">
                                <div><span>Period Covered:</span> <strong id="officeReportPeriod2"></strong></div>
                                <div><span>Analyzed Feedbacks:</span> <strong id="officeReportTotal2">0</strong></div>
                            </div>

                            <div class="ai-summary-box mt-3">
                                <div><strong>AI Sentiment Breakdown:</strong></div>
                                <div>Positive: <span id="off_aiPos" class="fw-bold" style="color: #166534;">0</span></div>
                                <div>Neutral: <span id="off_aiNeu" class="fw-bold" style="color: #334155;">0</span></div>
                                <div>Negative: <span id="off_aiNeg" class="fw-bold" style="color: #991b1b;">0</span></div>
                                <div>| &nbsp; Dominant Topic: <span id="off_aiDomTopic" class="fw-bold" style="color: #0056b3;">N/A</span></div>
                            </div>

                            <table class="report-table" style="margin-bottom: 50px;">
                                <thead>
                                    <tr class="header-blue">
                                        <th style="width: 10%;">NO.</th>
                                        <th style="width: 50%;">WRITTEN COMMENTS/SUGGESTIONS</th>
                                        <th style="width: 20%;">AI MODELED TOPIC</th>
                                        <th style="width: 20%;">AI SENTIMENT</th>
                                    </tr>
                                </thead>
                                <tbody id="officeReportCommentsBody"></tbody>
                            </table>

                            <div class="signature-section">
                                <div class="sig-block">
                                    <div>Prepared by:</div>
                                    <p class="sig-name">JUVY M. BUSTAMANTE, JD</p>
                                    <p class="sig-title">AOV-CQA</p>
                                </div>
                                <div class="sig-block">
                                    <div>Reviewed by:</div>
                                    <p class="sig-name">JOCELYN O. JINTALAN, DBA</p>
                                    <p class="sig-title">ISO Chair</p>
                                </div>
                            </div>
                            <div class="noted-block">
                                <div>Noted by:</div>
                                <p class="sig-name">AMADO A. OLIVA JR., PhD</p>
                                <p class="sig-title">SUC President III</p>
                            </div>

                            <!-- No Effectivity/Rev./Page footer on the AI Feedback page — not part
                                 of CSPC's official CSM survey result format. -->
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('layout/footer') %>

    <script>
        // Tumatanggap ng real-time query mula sa server.js tuwing niloload ang page (already
        // period-filtered server-side). Declared at script scope (not inside the
        // DOMContentLoaded closure below) so the Number of Respondents report — built by
        // renderOfficeReport() further down — can reuse it without a second request.
        const currentData = <%- typeof data !== 'undefined' ? JSON.stringify(data) : '[]' %>;

        document.addEventListener("DOMContentLoaded", function() {
            Chart.register(ChartDataLabels);
            const ctx = document.getElementById('clusterChart').getContext('2d');
            let chartInstance;

            function updateDashboardUI(dataArray) {
                let totalResp = 0, sumRating = 0, validOffices = 0, evaluatedOffices = 0;
                dataArray.forEach(d => {
                    const resp = parseInt(d.resp) || 0;
                    totalResp += resp;
                    if (resp > 0) evaluatedOffices++;
                    let r = parseFloat(d.rating) || 0;
                    if(r > 0) { sumRating += r; validOffices++; }
                });

                // Real-time calculation sa cards
                document.getElementById('totalResp').innerText = totalResp.toLocaleString();
                document.getElementById('overallRating').innerText = (validOffices > 0 ? (sumRating / validOffices).toFixed(2) : 0.00) + '%';
                // "Evaluated" means it actually received survey responses, not just
                // that it exists in this cluster (dataArray includes every office via
                // a LEFT JOIN, even ones with zero submissions).
                document.getElementById('totalOffices').innerText = evaluatedOffices;
            }

            // Matches the main dashboard's Cluster Performance Analytics chart:
            // one metric on screen at a time (toggled), instead of cramming
            // respondent counts and a 0-100% rating onto the same bars.
            const officeMetrics = {
                respondents: {
                    label: 'Total Respondents',
                    data: (dataArray) => dataArray.map(d => parseInt(d.resp) || 0),
                    color: 'rgba(37, 29, 58, 0.85)',
                    border: '#251d3a',
                    axisTitle: 'Number of Respondents',
                    max: undefined
                },
                rating: {
                    label: 'Satisfaction Rating (%)',
                    data: (dataArray) => dataArray.map(d => parseFloat(d.rating) || 0),
                    color: 'rgba(255, 204, 0, 0.85)',
                    border: '#ffcc00',
                    axisTitle: 'Satisfaction %',
                    max: 100
                }
            };
            let currentMetric = 'respondents';

            function renderChart(dataArray) {
                if (chartInstance) chartInstance.destroy();
                const metric = officeMetrics[currentMetric];
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: dataArray.map(d => d.label),
                        datasets: [{
                            label: metric.label,
                            data: metric.data(dataArray),
                            backgroundColor: metric.color,
                            borderColor: metric.border,
                            borderWidth: 1,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            datalabels: {
                                anchor: 'end', align: 'end', color: '#1e293b',
                                font: { weight: '800', size: 11 },
                                formatter: function(value) {
                                    if (value === 0) return '';
                                    return currentMetric === 'rating' ? value + '%' : value;
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a', padding: 12, displayColors: false,
                                callbacks: {
                                    title: (item) => `🏢 Office: ${dataArray[item[0].dataIndex].fullName}`,
                                    label: (item) => `${metric.label}: ${item.raw}${currentMetric === 'rating' ? '%' : ''}`
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true, max: metric.max,
                                title: { display: true, text: metric.axisTitle, font: { weight: 'bold' } },
                                grid: { borderDash: [4, 4] }
                            },
                            x: { grid: { display: false }, ticks: { font: { weight: '700' } } }
                        }
                    }
                });
            }

            document.querySelectorAll('.chart-toggle-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (btn.classList.contains('active')) return;
                    document.querySelectorAll('.chart-toggle-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentMetric = btn.getAttribute('data-metric');
                    renderChart(currentData);
                });
            });

            updateDashboardUI(currentData);
            renderChart(currentData);
        });

        // --- OFFICE-LEVEL REPORT (mirrors report.ejs's generateReport pipeline) ---
        const CLUSTER_NAME = <%- JSON.stringify(clusterName) %>;

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str === null || str === undefined ? '' : String(str);
            return div.innerHTML;
        }

        // SQD 1-8 dimension labels, in column order — mirrors SQD_DIMENSIONS in server.js.
        const SQD_DIMENSION_LABELS = [
            { col: 'sqd1', label: 'Responsiveness' },
            { col: 'sqd2', label: 'Reliability' },
            { col: 'sqd3', label: 'Access & Facility' },
            { col: 'sqd4', label: 'Communication' },
            { col: 'sqd5', label: 'Costs' },
            { col: 'sqd6', label: 'Integrity' },
            { col: 'sqd7', label: 'Assurance' },
            { col: 'sqd8', label: 'Outcome' }
        ];

        // Builds one rating-breakdown row from its raw bucket counts — same formula as
        // buildSqdBucketRow() in server.js (kept in sync manually since this runs client-side).
        function buildBucketRow(label, b) {
            const total = b.sa + b.a + b.n + b.d + b.sd + b.na;
            const answerable = total - b.na;
            const overall = answerable > 0 ? Math.round((b.sa + b.a) / answerable * 100) + '%' : 'N/A';
            return { label, ...b, total, overall };
        }

        function bucketsFromStats(stats, prefix) {
            return {
                sa: parseInt(stats[`${prefix}_sa`]) || 0,
                a: parseInt(stats[`${prefix}_a`]) || 0,
                n: parseInt(stats[`${prefix}_n`]) || 0,
                d: parseInt(stats[`${prefix}_d`]) || 0,
                sd: parseInt(stats[`${prefix}_sd`]) || 0,
                na: parseInt(stats[`${prefix}_na`]) || 0
            };
        }

        function bucketRowHtml(r, rowClass) {
            return `<tr${rowClass ? ` class="${rowClass}"` : ''}>
                <td>${escapeHtml(r.label)}</td>
                <td class="text-center">${r.sa}</td>
                <td class="text-center">${r.a}</td>
                <td class="text-center">${r.n}</td>
                <td class="text-center">${r.d}</td>
                <td class="text-center">${r.sd}</td>
                <td class="text-center">${r.na}</td>
                <td class="text-center">${r.total}</td>
                <td class="text-center">${r.overall}</td>
            </tr>`;
        }

        function renderOfficeReport() {
            const officeSelect = document.getElementById('officeFilter');
            const periodSelect = document.getElementById('periodCovered');
            const reportTypeSelect = document.getElementById('reportType');
            const officeId = officeSelect.value;
            const periodCovered = periodSelect.value;
            const reportType = reportTypeSelect.value;

            const officeLabel = officeId
                ? officeSelect.options[officeSelect.selectedIndex].text
                : `ALL OFFICES — ${CLUSTER_NAME.toUpperCase()}`;
            const periodLabel = periodCovered
                ? periodSelect.options[periodSelect.selectedIndex].text
                : 'All Periods';

            // Per the official CQA report template: "CLIENT SATISFACTION MEASUREMENT
            // SURVEY RESULT" for the SQD Result Report, "NUMBER OF RESPONDENTS" for
            // the respondents-count report — both sit above the CENTER FOR QUALITY
            // ASSURANCE / office-name lines.
            const mainTitleEl = document.getElementById('officeReportMainTitle1');
            mainTitleEl.classList.remove('d-none');
            mainTitleEl.innerText = reportType === 'respondents'
                ? 'NUMBER OF RESPONDENTS'
                : 'CLIENT SATISFACTION MEASUREMENT SURVEY RESULT';
            document.getElementById('officeReportTitle1').innerText = officeLabel;
            document.getElementById('officeReportTitle2').innerText = officeLabel;
            document.getElementById('officeReportPeriod1').innerText = periodLabel;
            document.getElementById('officeReportPeriod2').innerText = periodLabel;

            // Written Comments & AI Analytics only exists alongside the SQD Result Report —
            // Number of Respondents is a pure SQD-numbers packet, single office or all of them.
            const hasPage2 = reportType !== 'respondents';
            document.getElementById('reportPage2').classList.toggle('d-none', !hasPage2);
            // Page 1's footer label follows suit — "Page 1 of 2" when the AI Feedback page
            // is also printing, "Page 1 of 1" when this is the only page.
            document.getElementById('footerPageLabel1').innerText = hasPage2 ? 'Page 1 of 2' : 'Page 1 of 1';
            // Effectivity/Rev./Page footer is CSPC's official CSM survey result footer —
            // the SQD Result Report only. Number of Respondents reuses this same page
            // but must not show it (page 2's AI Feedback report never shows it either,
            // so it has no footer markup at all).
            document.getElementById('officeReportFooter1').classList.toggle('d-none', reportType !== 'sqd');

            // Three mutually exclusive report bodies:
            //  - percentageReportTable: SQD Result Report (official Percentage/Rating scorecard)
            //  - sqdReportTables:       Number of Respondents + one office (SQD 0/1-8 bucket breakdown)
            //  - multiOfficeReportBody: Number of Respondents + All Offices (that same breakdown, per office)
            const isAllOfficesPacket = reportType === 'respondents' && !officeId;
            const isBucketSingle = reportType === 'respondents' && !!officeId;
            document.getElementById('percentageReportTable').classList.toggle('d-none', reportType !== 'sqd');
            document.getElementById('sqdReportTables').classList.toggle('d-none', !isBucketSingle);
            document.getElementById('multiOfficeReportBody').classList.toggle('d-none', !isAllOfficesPacket);

            if (isAllOfficesPacket) {
                renderMultiOfficeReport(periodCovered, periodLabel);
                return;
            }

            fetch('/api/report-data', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cluster: CLUSTER_NAME, officeId: officeId, periodCovered: periodCovered })
            })
                .then(res => res.json())
                .then(data => {
                    if (reportType === 'sqd') {
                        updatePercentageTable(data.stats || {});
                    } else {
                        updateOfficeReportStats(data.stats || {});
                    }
                    updateOfficeReportComments(data.comments || []);

                    // Report + export buttons only become visible after a successful generate.
                    document.getElementById('officeReportEmptyState').classList.add('d-none');
                    document.getElementById('officeReportWrapper').classList.remove('d-none');
                    document.getElementById('officeReportWrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });
                })
                .catch(() => {
                    document.getElementById('officeReportCommentsBody').innerHTML =
                        '<tr><td colspan="4" class="text-center text-danger py-4">Failed to load report data.</td></tr>';
                    document.getElementById('officeReportEmptyState').classList.add('d-none');
                    document.getElementById('officeReportWrapper').classList.remove('d-none');
                    document.getElementById('officeReportWrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
        }

        function getOfficeReportInterpretation(score) {
            if (score >= 95) return 'Outstanding';
            if (score >= 90) return 'Very Satisfactory';
            if (score >= 80) return 'Satisfactory';
            if (score >= 60) return 'Fair';
            return 'Poor';
        }

        // SQD Result Report's Percentage/Rating table. Uses the same sqd1..sqd8/overall_score
        // %s that sqdScoreExpr() already computes server-side (unchanged formula) — the only
        // addition here is reading each dimension's own bucket counts (also already in the
        // same /api/report-data response) to tell "0% because everyone disagreed" apart from
        // "0% because everyone answered N/A", so a fully-N/A dimension prints N/A instead of
        // a misleading 0.00%/Poor.
        function updatePercentageTable(stats) {
            const totalResp = stats.total_respondents || 0;
            document.getElementById('officeReportTotal1').innerText = totalResp;
            document.getElementById('officeReportTotal2').innerText = totalResp;

            let overallAnswerable = 0;
            SQD_DIMENSION_LABELS.forEach((d, idx) => {
                const i = idx + 1;
                const b = bucketsFromStats(stats, d.col);
                const answerable = b.sa + b.a + b.n + b.d + b.sd;
                overallAnswerable += answerable;

                const scoreEl = document.getElementById(`off_sqd${i}_score`);
                const interpEl = document.getElementById(`off_sqd${i}_interp`);
                // No valid answers for this dimension — either zero respondents overall, or
                // every respondent marked it N/A. Same convention as the SQD 0/1-8 bucket
                // tables: show N/A rather than a misleading 0.00% / Poor.
                if (answerable === 0) {
                    scoreEl.innerText = 'N/A';
                    interpEl.innerText = 'N/A';
                } else {
                    const score = parseFloat(stats[d.col] || 0);
                    scoreEl.innerText = score.toFixed(2) + '%';
                    interpEl.innerText = getOfficeReportInterpretation(score);
                }
            });

            const overall = parseFloat(stats.overall_score || 0);
            const overallEl = document.getElementById('off_overall_score');
            const overallInterpEl = document.getElementById('off_overall_interp');
            if (overallAnswerable === 0) {
                overallEl.innerText = 'N/A';
                overallInterpEl.innerText = 'N/A';
            } else {
                overallEl.innerText = overall.toFixed(2) + '%';
                overallInterpEl.innerText = getOfficeReportInterpretation(overall).toUpperCase();
            }
        }

        // "Number of Respondents", ALL OFFICES: fetches every office's own SQD bucket
        // breakdown from /api/report-data-by-cluster and prints the full CQA SQD 0 /
        // SQD 1-8 template once per office, back to back — matching the official
        // multi-office report format.
        function renderMultiOfficeReport(periodCovered, periodLabel) {
            const container = document.getElementById('multiOfficeReportBody');
            container.innerHTML = '<p class="text-center text-muted py-3">Loading…</p>';
            document.getElementById('officeReportEmptyState').classList.add('d-none');
            document.getElementById('officeReportWrapper').classList.remove('d-none');
            document.getElementById('officeReportWrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });

            fetch('/api/report-data-by-cluster', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cluster: CLUSTER_NAME, periodCovered: periodCovered })
            })
                .then(res => res.json())
                .then(data => {
                    const offices = data.offices || [];
                    const totalAll = offices.reduce((sum, o) => sum + (o.totalRespondents || 0), 0);
                    document.getElementById('officeReportTotal1').innerText = totalAll;

                    if (offices.length === 0) {
                        container.innerHTML = '<p class="text-center text-muted py-3">No offices found for this cluster.</p>';
                        return;
                    }

                    container.innerHTML = offices.map(o => `
                        <div class="office-block">
                            <p class="office-name-line">${escapeHtml(o.officeName)}</p>
                            <div class="meta-info">
                                <div><span>Period Covered:</span> <strong>${escapeHtml(periodLabel)}</strong></div>
                                <div><span>Number of Respondents:</span> <strong>${o.totalRespondents}</strong></div>
                            </div>
                            <div class="section-title">SQD 0 Results</div>
                            <table class="report-table">
                                <thead><tr class="header-blue">
                                    <th>Service Quality</th><th>Strongly Agree</th><th>Agree</th>
                                    <th>Neither Agree or Disagree</th><th>Disagree</th><th>Strongly Disagree</th>
                                    <th>N/A</th><th>Total Responses</th><th>Overall</th>
                                </tr></thead>
                                <tbody>${bucketRowHtml(o.sqd0Row)}</tbody>
                            </table>
                            <div class="section-title">SQD 1-8 Results</div>
                            <table class="report-table">
                                <thead><tr class="header-blue">
                                    <th>Service Quality</th><th>Strongly Agree</th><th>Agree</th>
                                    <th>Neither Agree or Disagree</th><th>Disagree</th><th>Strongly Disagree</th>
                                    <th>N/A</th><th>Total Responses</th><th>Overall</th>
                                </tr></thead>
                                <tbody>${o.sqdRows.map(r => bucketRowHtml(r)).join('')}${bucketRowHtml(o.overallRow, 'overall-row')}</tbody>
                            </table>
                        </div>
                    `).join('');
                })
                .catch(() => {
                    container.innerHTML = '<p class="text-center text-danger py-3">Failed to load report data.</p>';
                });
        }

        function updateOfficeReportStats(stats) {
            const totalResp = stats.total_respondents || 0;
            document.getElementById('officeReportTotal1').innerText = totalResp;
            document.getElementById('officeReportTotal2').innerText = totalResp;

            const sqd0Row = buildBucketRow('SQD 0', bucketsFromStats(stats, 'sqd0'));
            document.getElementById('sqd0Body').innerHTML = bucketRowHtml(sqd0Row);

            const dimRows = SQD_DIMENSION_LABELS.map(d => buildBucketRow(d.label, bucketsFromStats(stats, d.col)));
            const overallTotals = dimRows.reduce((acc, r) => {
                acc.sa += r.sa; acc.a += r.a; acc.n += r.n; acc.d += r.d; acc.sd += r.sd; acc.na += r.na;
                return acc;
            }, { sa: 0, a: 0, n: 0, d: 0, sd: 0, na: 0 });
            const overallRow = buildBucketRow('OVERALL', overallTotals);

            document.getElementById('sqd18Body').innerHTML =
                dimRows.map(r => bucketRowHtml(r)).join('') + bucketRowHtml(overallRow, 'overall-row');
        }

        function updateOfficeReportComments(comments) {
            const tbody = document.getElementById('officeReportCommentsBody');

            if (!comments || comments.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-muted">NO WRITTEN COMMENTS AND SUGGESTIONS REFLECTED IN ANY OF THE INSTRUMENTS</td></tr>';
                document.getElementById('off_aiPos').innerText = '0';
                document.getElementById('off_aiNeu').innerText = '0';
                document.getElementById('off_aiNeg').innerText = '0';
                document.getElementById('off_aiDomTopic').innerText = 'N/A';
                return;
            }

            let pos = 0, neu = 0, neg = 0;
            const topics = {};
            let rows = '';

            comments.forEach((c, index) => {
                const sentiment = c.sentiment || 'Neutral';
                if (sentiment === 'Positive') pos++;
                else if (sentiment === 'Negative') neg++;
                else neu++;

                const topic = c.topic || 'General Feedback';
                topics[topic] = (topics[topic] || 0) + 1;

                let badgeClass = 'bg-neu';
                if (sentiment === 'Positive') badgeClass = 'bg-pos';
                if (sentiment === 'Negative') badgeClass = 'bg-neg';

                rows += `<tr>
                    <td class="text-center">${index + 1}</td>
                    <td>${escapeHtml(c.comments)}</td>
                    <td class="text-center"><span class="topic-pill">${escapeHtml(topic)}</span></td>
                    <td class="text-center"><span class="badge-sentiment ${badgeClass}">${escapeHtml(sentiment)}</span></td>
                </tr>`;
            });

            tbody.innerHTML = rows;
            document.getElementById('off_aiPos').innerText = pos;
            document.getElementById('off_aiNeu').innerText = neu;
            document.getElementById('off_aiNeg').innerText = neg;

            let domTopic = 'N/A', maxCount = 0;
            for (const [key, value] of Object.entries(topics)) {
                if (value > maxCount) { maxCount = value; domTopic = key; }
            }
            document.getElementById('off_aiDomTopic').innerText = domTopic;
        }

        function downloadOfficeReportPDF() {
            const element = document.getElementById('officeReportContentToExport');
            const officeSelect = document.getElementById('officeFilter');
            const officeLabel = officeSelect.value ? officeSelect.options[officeSelect.selectedIndex].text : 'All_Offices';
            // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
            // html2pdf's margin array is [top, left, bottom, right] (not CSS order).
            const opt = {
                margin: [0.5, 0.5, 0.25, 0.25],
                filename: `CSM_Report_${officeLabel.replace(/\s+/g, '_')}.pdf`,
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, letterRendering: true, scrollY: 0 },
                jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' },
                pagebreak: { mode: ['css', 'legacy'], avoid: ['.report-header-block', '.page-footer', '.signature-section', '.office-block', 'tr'] }
            };
            html2pdf().set(opt).from(element).save();
        }

        function downloadOfficeReportCSV() {
            const csv = [];
            const rows = document.querySelectorAll('#officeReportContentToExport .report-table tr');

            rows.forEach(row => {
                const cols = row.querySelectorAll('td, th');
                const line = [];
                cols.forEach(col => {
                    let data = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').replace(/(\s\s)/gm, ' ');
                    data = data.replace(/"/g, '""');
                    line.push('"' + data + '"');
                });
                csv.push(line.join(','));
            });

            const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
            const downloadLink = document.createElement('a');
            downloadLink.download = 'CSM_Data.csv';
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = 'none';
            document.body.appendChild(downloadLink);
            downloadLink.click();
        }

    </script>
</body>
</html>