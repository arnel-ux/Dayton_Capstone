<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --primary-indigo: #251d3a;
            --primary-indigo-hover: #2a2550;
            --accent-indigo: #3452a5;
            --bg-body: #f4f6fa;
            --text-main: #334155;
            --text-heading: #0f172a;
            --text-muted: #64748b;
            --text-faint: #94a3b8;
            --card-bg: #ffffff;
            --surface-subtle: #f8fafc;
            --border-subtle: #e5e9f0;
            --border-strong: #dde3ec;

            /* 4 / 8 / 12 / 16 / 20 / 24 / 32px spacing scale */
            --sp-1: 4px;
            --sp-2: 8px;
            --sp-3: 12px;
            --sp-4: 16px;
            --sp-5: 20px;
            --sp-6: 24px;
            --sp-8: 32px;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;

            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 6px 16px rgba(15, 23, 42, 0.06);
        }

        html[data-bs-theme="dark"] {
            --bg-body: #0b1526;
            --text-main: #cbd5e1;
            --text-heading: #f1f5f9;
            --text-muted: #94a3b8;
            --text-faint: #64748b;
            --card-bg: #141d30;
            --surface-subtle: #1a2438;
            --border-subtle: #263045;
            --border-strong: #2c3a54;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.35);
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: var(--text-main);
            overflow-x: hidden;
        }

        html[data-bs-theme="dark"] .records-card { background: var(--card-bg); }
        html[data-bs-theme="dark"] .office-group-header { background: var(--surface-subtle); }

        /* --- Page header --- */
        .page-header {
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            color: white;
            padding: var(--sp-6) var(--sp-6);
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            box-shadow: var(--shadow-md);
            margin-bottom: var(--sp-6);
        }
        .page-header h2 { font-size: 1.4rem; letter-spacing: 0.2px; }
        .page-header .page-subtitle { font-size: 0.85rem; color: rgba(255,255,255,0.72); }

        .btn-back {
            background: rgba(255, 255, 255, 0.08);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.22);
            padding: var(--sp-2) var(--sp-4);
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 600;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .btn-back:hover { background: white; color: var(--primary-indigo); }

        /* --- Records card --- */
        .records-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            padding: var(--sp-6);
            margin-bottom: var(--sp-8);
            border: 1px solid var(--border-subtle);
        }

        /* --- Search toolbar --- */
        .search-toolbar { margin-bottom: var(--sp-5); }
        .search-bar {
            max-width: 420px;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-strong);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }
        .search-bar .input-group-text {
            background: var(--card-bg);
            border: none;
            color: var(--text-faint);
            padding-left: var(--sp-4);
        }
        .search-bar .form-control {
            background: var(--card-bg);
            color: var(--text-main);
            border: none;
            padding: var(--sp-3) var(--sp-3) var(--sp-3) var(--sp-2);
            font-size: 0.9rem;
        }
        .search-bar .form-control:focus { box-shadow: none; background: var(--card-bg); color: var(--text-main); }
        .search-hint { color: var(--text-faint); font-size: 0.75rem; margin-top: var(--sp-3); }

        .scroll-container {
            max-height: 700px;
            overflow-y: auto;
            border-radius: var(--radius-md);
            padding-right: var(--sp-1);
        }

        .scroll-container::-webkit-scrollbar { width: 8px; }
        .scroll-container::-webkit-scrollbar-track { background: var(--surface-subtle); border-radius: 10px; }
        .scroll-container::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
        html[data-bs-theme="dark"] .scroll-container::-webkit-scrollbar-thumb { background: #334155; }

        /* --- Office groups --- */
        .office-section {
            margin-bottom: var(--sp-5);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-md);
            overflow: hidden;
        }
        .office-group-header {
            background: var(--surface-subtle);
            padding: var(--sp-3) var(--sp-5);
            font-weight: 800;
            color: var(--primary-indigo);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-size: 0.78rem;
            border-left: 4px solid var(--primary-indigo);
            position: sticky;
            top: 0;
            z-index: 10;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        html[data-bs-theme="dark"] .office-group-header { color: #93c5fd; border-left-color: #93c5fd; }

        /* Table uses a fixed layout with deliberate column widths (set via <colgroup>) so
           thead/tbody columns always line up and one long cell can never distort row height. */
        .table-scroll-x { overflow-x: auto; }
        .table { width: 100%; min-width: 800px; margin-bottom: 0; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
        /* Action column gets a hard floor so "View Result" (icon + text) can never be
           clipped by the fixed table layout, regardless of container width — the
           percentage in <colgroup> only governs the *extra* room on wide screens. */
        .table th:nth-child(7),
        .table td:nth-child(7) { min-width: 184px; }
        .table thead th {
            background: var(--card-bg);
            padding: var(--sp-3) var(--sp-5);
            font-size: 0.68rem;
            font-weight: 700;
            color: var(--text-faint);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            border-bottom: 2px solid var(--border-subtle);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .table tbody td {
            padding: var(--sp-3) var(--sp-5);
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
            font-size: 0.86rem;
            color: var(--text-main);
            height: 52px;
            overflow: hidden;
        }
        .table tbody tr:last-child td { border-bottom: none; }
        .table tbody tr.record-row:hover td { background: var(--surface-subtle); }

        /* Single-line ellipsis truncation shared by any cell whose content must never
           wrap or grow the row — the full value stays available via the title tooltip. */
        .cell-truncate {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .respondent-name { font-weight: 700; color: var(--text-heading); }
        .name-cell { max-width: 100%; }
        .office-name-cell { max-width: 100%; }
        .office-acronym {
            letter-spacing: 0.4px;
            cursor: default;
            border-bottom: 1px dashed var(--border-strong);
        }

        .comments-cell {
            max-width: 100%;
            color: var(--text-muted);
            cursor: default;
        }

        .action-cell { text-align: center; white-space: nowrap; }

        .topic-badge {
            display: inline-block;
            max-width: 100%;
            font-size: 0.65rem;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
            cursor: default;
        }
        .topic-cell { text-align: center; }

        .bg-cr { background-color: #fee2e2; color: #ef4444; }
        .bg-aircon { background-color: #e0f2fe; color: #0ea5e9; }
        .bg-general { background-color: #f1f5f9; color: #64748b; }
        .bg-facility { background-color: #fef3c7; color: #d97706; }
        .bg-staff { background-color: #ede9fe; color: #7c3aed; }
        .bg-payment { background-color: #dcfce7; color: #16a34a; }
        .bg-docs { background-color: #dbeafe; color: #2563eb; }
        .bg-online { background-color: #cffafe; color: #0891b2; }
        .bg-health { background-color: #fce7f3; color: #db2777; }

        .sentiment-badge { font-size: 0.65rem; padding: 4px 12px; border-radius: 999px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; display: inline-block; white-space: nowrap; }
        .bg-sentiment-positive { background-color: #dcfce7; color: #15803d; }
        .bg-sentiment-negative { background-color: #fee2e2; color: #b91c1c; }
        .bg-sentiment-neutral { background-color: #e2e8f0; color: #334155; }

        html[data-bs-theme="dark"] .topic-badge,
        html[data-bs-theme="dark"] .sentiment-badge { filter: brightness(0.92) saturate(0.9); }

        /* Wider, left-aligned tooltip for long comments so wrapped text stays readable
           instead of Bootstrap's default narrow 200px bubble. */
        .tooltip-wide-comment .tooltip-inner { max-width: 320px; text-align: left; }

        #noResults { display: none; padding: var(--sp-8) var(--sp-6); text-align: center; color: var(--text-faint); }
        #noResults i { color: var(--border-strong); }
        .empty-state { text-align: center; padding: var(--sp-8) var(--sp-6); color: var(--text-muted); }

        .btn-view-result,
        .btn-view-result:visited {
            background-color: var(--primary-indigo) !important;
            color: #fff !important;
            border: 1px solid var(--primary-indigo) !important;
            font-size: 0.76rem;
            font-weight: 700;
            padding: var(--sp-2) var(--sp-3);
            border-radius: var(--radius-sm);
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 128px;
            transition: background-color 0.15s ease, transform 0.15s ease;
        }
        .btn-view-result:hover,
        .btn-view-result:focus,
        .btn-view-result:focus-visible,
        .btn-view-result:active {
            background-color: var(--primary-indigo-hover) !important;
            border-color: var(--primary-indigo-hover) !important;
            color: #fff !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(37, 29, 58, 0.3) !important;
        }

        .modal-title-icon { color: var(--primary-indigo); }
        html[data-bs-theme="dark"] .modal-title-icon { color: #93c5fd; }

        /* --- View Result modal --- */
        .result-detail-head {
            display: flex; align-items: center; gap: var(--sp-4);
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            color: #fff; border-radius: var(--radius-md); padding: var(--sp-4) var(--sp-5); margin-bottom: var(--sp-5);
        }
        .result-detail-icon {
            width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
            background: rgba(255,255,255,0.14); display: flex; align-items: center; justify-content: center; font-size: 1rem;
        }
        .result-office { font-weight: 800; font-size: 1rem; line-height: 1.3; }
        .result-meta { font-size: 0.78rem; color: rgba(255,255,255,0.72); }
        .result-badge {
            margin-left: auto; font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
            background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.3);
            padding: var(--sp-1) var(--sp-3); border-radius: 999px; white-space: nowrap;
        }

        .result-section { margin-bottom: var(--sp-5); }
        .result-section-header {
            font-weight: 800; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.4px;
            color: var(--primary-indigo); margin-bottom: var(--sp-3); display: flex; align-items: center; gap: var(--sp-2);
        }
        html[data-bs-theme="dark"] .result-section-header { color: #93c5fd; }

        .result-grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-3); }
        @media (min-width: 576px) {
            .result-grid { grid-template-columns: repeat(3, 1fr); }
        }
        .result-item {
            background: var(--surface-subtle); border-radius: var(--radius-sm); padding: var(--sp-3) var(--sp-4); border: 1px solid var(--border-subtle);
        }
        .result-item .label { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; color: var(--text-faint); margin-bottom: 3px; }
        .result-item .value { font-size: 0.88rem; font-weight: 600; color: var(--text-heading); }

        .result-sqd-row {
            display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3);
            padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-sm); background: var(--surface-subtle); border: 1px solid var(--border-subtle); margin-bottom: var(--sp-2);
        }
        .result-sqd-statement { font-size: 0.83rem; color: var(--text-main); flex: 1; }

        .sqd-badge {
            flex-shrink: 0; font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; white-space: nowrap;
        }
        .sqd-badge-5, .sqd-badge-4 { background: #dcfce7; color: #15803d; }
        .sqd-badge-3 { background: #e2e8f0; color: #334155; }
        .sqd-badge-2, .sqd-badge-1 { background: #fee2e2; color: #b91c1c; }
        .sqd-badge-na, .sqd-badge-unanswered { background: #f1f5f9; color: #94a3b8; }
        html[data-bs-theme="dark"] .sqd-badge { filter: brightness(0.92) saturate(0.9); }

        /* Generate Report modal — fills the content area (same wide layout/format as the
           official /report page) but docks to the right of the sidebar instead of covering
           the whole viewport, so the sidebar stays visible/usable while the report is open. */
        .client-report-dialog {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            left: var(--sidebar-width, 260px);
            margin: 0;
            max-width: none;
            width: auto;
            height: 100vh;
        }
        .client-report-dialog .modal-content {
            height: 100%;
            border-radius: 0;
        }
        .client-report-dialog .modal-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }
        @media (max-width: 991.98px) {
            .client-report-dialog { left: 0; }
        }
        .client-report-header {
            justify-content: space-between;
            padding: 16px 24px;
            background: #fff;
            border-bottom: 1px solid #e5e7eb;
        }
        html[data-bs-theme="dark"] .client-report-header { background: #141d30; border-bottom-color: #263045; }
        .client-report-header .modal-title { font-size: 1.05rem; color: #251d3a; }
        html[data-bs-theme="dark"] .client-report-header .modal-title { color: #e2e8f0; }
        .client-report-header .vr { opacity: 0.25; align-self: stretch; }
        .client-report-body {
            background: #e5e9f0;
            padding: 32px 24px;
        }
        html[data-bs-theme="dark"] .client-report-body { background: #0d1420; }
        .report-container {
            background: #fff;
            padding: 40px;
            color: #000;
            font-family: Arial, sans-serif;
            max-width: 900px;
            margin: 0 auto 30px;
            border: 1px solid #ccc;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #6c9bd2;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .report-header-center { text-align: center; flex-grow: 1; }
        .report-header-center p { margin: 0; font-size: 14px; }
        .report-header-center .inst-name { font-weight: bold; font-size: 16px; }
        .doc-code { font-size: 12px; font-weight: bold; }
        .report-title { text-align: center; font-weight: bold; font-size: 16px; margin: 20px 0; }
        .office-title { text-align: center; font-weight: bold; text-decoration: underline; text-transform: uppercase; font-size: 16px; margin-bottom: 0; }
        .meta-info { font-size: 14px; margin-bottom: 10px; }
        .meta-info span { display: inline-block; width: 200px; }
        .report-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 14px; }
        .report-table th, .report-table td { border: 1px solid #000; padding: 5px 8px; }
        .report-table th { text-align: center; font-weight: bold; }
        .header-blue { background-color: #8faadc !important; -webkit-print-color-adjust: exact; }
        .ai-summary-box {
            background-color: #f8f9fa;
            border-left: 4px solid #6c9bd2;
            padding: 12px;
            margin-bottom: 15px;
            font-size: 13px;
            display: flex;
            justify-content: space-between;
            -webkit-print-color-adjust: exact;
        }
        .badge-sentiment { padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .bg-pos { background-color: #dcfce7 !important; color: #166534 !important; -webkit-print-color-adjust: exact; }
        .bg-neg { background-color: #fee2e2 !important; color: #991b1b !important; -webkit-print-color-adjust: exact; }
        .bg-neu { background-color: #f1f5f9 !important; color: #334155 !important; -webkit-print-color-adjust: exact; }
        .topic-pill { background-color: #e8f0fe !important; color: #0056b3 !important; padding: 4px 8px; border-radius: 12px; font-size: 11px; font-weight: bold; -webkit-print-color-adjust: exact; }
        .text-center { text-align: center; }
        .fw-bold { font-weight: bold; }
        .interpretation-box { font-size: 14px; margin-left: 50%; margin-bottom: 40px; }
        .interpretation-box table { border: none; }
        .interpretation-box td { padding: 2px 10px; border: none; }
        .signature-section { display: flex; justify-content: space-between; margin-top: 40px; font-size: 14px; }
        .sig-block { width: 45%; }
        .sig-name { font-weight: bold; margin-top: 30px; margin-bottom: 0; }
        .sig-title { margin: 0; }
        .page-footer { margin-top: 50px; font-size: 12px; font-weight: bold; border-top: 2px solid #6c9bd2; padding-top: 5px; display: flex; justify-content: space-between; }
        @media (max-width: 767.98px) {
            .page-header { padding: var(--sp-5) var(--sp-4); border-radius: 0 0 var(--radius-md) var(--radius-md); }
            .records-card { padding: var(--sp-4); }
            .search-bar { max-width: 100%; }
            .result-badge { margin-left: 0; }
            .result-detail-head { flex-wrap: wrap; }
        }

        @media print {
            body > *:not(#clientReportModal) { display: none !important; }
            #clientReportModal { position: static !important; display: block !important; }
            #clientReportModal .modal-dialog { max-width: 100% !important; margin: 0 !important; }
            #clientReportModal .modal-content { border: none !important; box-shadow: none !important; }
            .no-print { display: none !important; }
            .report-container { border: none; box-shadow: none; max-width: 100%; padding: 0; display: block; page-break-after: always; }
            .page-break { page-break-before: always; }
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="page-header">
            <div class="container-fluid d-md-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1 text-white"><i class="fas fa-database me-2"></i>Institutional Survey Records</h2>
                    <p class="mb-0 page-subtitle">Comprehensive logs sorted by Academic Colleges</p>
                </div>
                <div class="mt-3 mt-md-0">
                    <a href="/dashboard" class="btn btn-back">
                        <i class="fas fa-chevron-left me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>

        <div class="container-fluid px-4">
            <div class="records-card">

                <div class="search-toolbar">
                    <div class="input-group search-bar">
                        <span class="input-group-text"><i class="fas fa-search text-primary"></i></span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Search by name, college, or concern..." title="Search survey records">
                    </div>
                    <p class="search-hint mb-0">Search results filter by name, topic, or office college.</p>
                </div>

                <div class="scroll-container">
                    <div id="noResults">
                        <i class="fas fa-search fa-3x mb-3 opacity-20"></i>
                        <h5>No matching records found</h5>
                    </div>

                    <% if (typeof recordsByCluster !== 'undefined' && Object.keys(recordsByCluster).length > 0) { %>
                        <% Object.keys(recordsByCluster).forEach(cluster => { %>
                            <div class="office-section">
                                <div class="office-group-header">
                                    <span><%= cluster.toUpperCase() %></span>
                                </div>
                                <div class="table-scroll-x">
                                <table class="table">
                                    <colgroup>
                                        <col style="width: 12%;">
                                        <col style="width: 14%;">
                                        <col style="width: 10%;">
                                        <col style="width: 21%;">
                                        <col style="width: 15%;">
                                        <col style="width: 11%;">
                                        <col style="width: 17%;">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Office</th>
                                            <th>Name</th>
                                            <th class="text-center">Time of Office Visit</th>
                                            <th>Comments</th>
                                            <th class="text-center">Topic</th>
                                            <th class="text-center">Sentiment</th>
                                            <th class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% recordsByCluster[cluster].forEach(record => { %>
                                            <tr class="record-row">
                                                <td class="office-name-cell text-muted small" data-full="<%= record.officeName %>" title="<%= record.officeName %>" data-bs-toggle="tooltip" data-bs-placement="top"><span class="cell-truncate"><%= record.officeName %></span></td>
                                                <td class="name-cell" title="<%= record.name %>" data-bs-toggle="tooltip" data-bs-placement="top"><span class="respondent-name cell-truncate"><%= record.name %></span></td>
                                                <td class="text-center text-muted small text-nowrap" title="<%= record.officeVisitedTime %>" data-bs-toggle="tooltip" data-bs-placement="top"><%= record.officeVisitedTime %></td>
                                                <td class="comments-cell text-muted small" title="<%= record.comments %>" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-custom-class="tooltip-wide-comment"><span class="cell-truncate"><%= record.comments %></span></td>
                                                <td class="topic-cell"><span class="topic-badge <%= record.topicClass %>" title="<%= record.topic %>" data-bs-toggle="tooltip" data-bs-placement="top"><%= record.topic %></span></td>
                                                <td class="text-center"><span class="sentiment-badge <%= record.sentimentClass %>"><%= record.sentiment %></span></td>
                                                <td class="action-cell">
                                                    <button type="button" class="btn btn-view-result" onclick="openViewResult(<%= record.id %>)" title="View this respondent's full survey answers">
                                                        <i class="fas fa-eye me-1"></i> View Result
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">
                            <i class="fas fa-inbox fa-3x mb-3 opacity-20"></i>
                            <p class="text-muted mb-0">No survey records available yet. Responses will dynamically load here.</p>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</div>

