                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 60vh; overflow-y: auto; font-size: 0.85rem; line-height: 1.6;" data-i18n="terms_full">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary px-4" data-bs-dismiss="modal" title="Close this dialog" data-i18n="terms_modal_close">I Understand</button>
            </div>
        </div>
    </div>
</div>

<!-- Survey History Detail Modal -->
<div class="modal fade" id="historyDetailModal" tabindex="-1" aria-labelledby="historyDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="historyDetailModalLabel"><i class="bi bi-file-earmark-text me-1"></i> Your Answers</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" title="Close"></button>
            </div>
            <div class="modal-body" id="historyDetailBody" style="max-height: 70vh; overflow-y: auto;">
                <div class="spinner-block">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 mb-0">Loading your answers…</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" title="Close this dialog">Close</button>
            </div>
        </div>
    </div>
</div>

<% if (showOnboarding) { %>
<!-- First-time Setup Wizard, an interactive spotlight tour shown once after registration.
     The dimmed ring glides to the real control each step talks about instead of a plain modal.
     Steps live in ONBOARDING_STEPS. -->
<div id="onboardingWizard" class="ob-root" hidden role="dialog" aria-modal="true" aria-labelledby="obTitle">
    <div class="ob-blocker"></div>
    <div id="obRing" class="ob-ring"></div>
    <div id="obCard" class="ob-card">
        <div class="ob-card-top">
            <span class="ob-step-count" id="obCount"></span>
            <button type="button" class="ob-skip" onclick="finishOnboarding()" title="Skip this tour">Skip Tour</button>
        </div>
        <div class="ob-icon-wrap"><i id="obIcon" class="bi bi-stars"></i></div>
        <h5 class="ob-title" id="obTitle"></h5>
        <p class="ob-text" id="obText"></p>
        <div class="ob-dots" id="onboardingDots"></div>
        <div class="ob-actions">
            <button type="button" class="btn btn-outline-secondary ob-btn" id="onboardingBackBtn" onclick="onboardingStep(-1)" hidden>Back</button>
            <button type="button" class="btn btn-primary ob-btn ob-next" id="onboardingNextBtn" onclick="onboardingStep(1)">Next</button>
        </div>
    </div>
</div>
<style>
    .ob-root { position: fixed; inset: 0; z-index: 2000; }
    .ob-root[hidden] { display: none; }
    .ob-blocker { position: absolute; inset: 0; }   /* swallows clicks on the page behind */

    /* Huge box-shadow darkens everything except the cut-out, which travels between controls. */
    .ob-ring {
        position: fixed; top: 50%; left: 50%; width: 0; height: 0;
        border-radius: 12px; pointer-events: none;
        box-shadow: 0 0 0 100vmax rgba(8, 12, 24, 0.68);
        transition: top .65s cubic-bezier(.65,0,.25,1), left .65s cubic-bezier(.65,0,.25,1),
                    width .65s cubic-bezier(.65,0,.25,1), height .65s cubic-bezier(.65,0,.25,1),
                    border-radius .65s ease;
    }
    .ob-root.ob-nofx .ob-ring, .ob-root.ob-nofx .ob-card { transition: none; }
    .ob-ring::after {
        content: ''; position: absolute; inset: -3px; border-radius: inherit;
        border: 2px solid #60a5fa; opacity: 0;
    }
    .ob-ring.has-target::after { opacity: 1; animation: obPulse 1.6s ease-out infinite; }
    @keyframes obPulse {
        0%   { box-shadow: 0 0 0 0 rgba(96,165,250,.65); }
        100% { box-shadow: 0 0 0 14px rgba(96,165,250,0); }
    }

    .ob-card {
        position: fixed; width: min(360px, calc(100vw - 24px));
        background: var(--bs-body-bg, #fff); color: var(--bs-body-color, #1e293b);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 16px; padding: 1rem 1.15rem 1.05rem;
        box-shadow: 0 18px 50px rgba(0,0,0,.35);
        transition: top .65s cubic-bezier(.65,0,.25,1), left .65s cubic-bezier(.65,0,.25,1);
        max-height: calc(100vh - 24px); overflow-y: auto;
    }
    .ob-card.is-swapping .ob-icon-wrap, .ob-card.is-swapping .ob-title, .ob-card.is-swapping .ob-text { opacity: 0; transform: translateY(6px); }
    .ob-icon-wrap, .ob-title, .ob-text { transition: opacity .28s ease, transform .28s ease; }
    .ob-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; }
    .ob-step-count { font-size: .75rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--bs-secondary-color, #6c757d); }
    .ob-skip { background: none; border: 0; color: var(--bs-secondary-color, #6c757d); font-size: .85rem; padding: .35rem .25rem; min-height: 36px; }
    .ob-skip:hover { color: var(--bs-body-color); text-decoration: underline; }
    .ob-icon-wrap { font-size: 1.7rem; color: var(--bs-primary); line-height: 1; margin-bottom: .35rem; }
    .ob-title { font-weight: 700; margin: 0 0 .3rem; font-size: 1.1rem; }
    .ob-text { color: var(--bs-secondary-color, #6c757d); font-size: .92rem; margin: 0 0 .85rem; }
    .ob-text strong { color: var(--bs-body-color); }
    .ob-dots { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: .85rem; }
    .onboarding-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bs-secondary-bg, #dee2e6); transition: background-color .2s ease, width .2s ease; }
    .onboarding-dot.active { background: var(--bs-primary); width: 20px; border-radius: 4px; }
    .ob-actions { display: flex; gap: .5rem; }
    .ob-btn { min-height: 42px; }
    .ob-next { margin-left: auto; padding-left: 1.4rem; padding-right: 1.4rem; }

    @media (prefers-reduced-motion: reduce) {
        .ob-ring, .ob-card, .ob-icon-wrap, .ob-title, .ob-text { transition: none; }
        .ob-ring.has-target::after { animation: none; }
    }
</style>
<% } %>

<% if (offlineMode) { %>
<!-- BACK-ONLINE PROMPT, /survey-offline only, the mirror of the offline transition below.
     An overlay instead of an inline banner so it's never scrolled out of view.
     Reuses .offline-transition-overlay/.offline-transition-card's green variant.
     Never auto-navigates or reloads, and is dismissable since coming back online is safe. -->
<div id="backOnlineBanner" class="offline-transition-overlay is-back-online" hidden role="dialog" aria-modal="true" aria-labelledby="backOnlineTitle">
    <div class="offline-transition-card">
        <div class="offline-transition-icon"><i class="bi bi-wifi"></i></div>
        <h4 id="backOnlineTitle">You're Back Online</h4>
        <p>Your internet connection has been restored. Offline responses will synchronize automatically when eligible.</p>
        <div class="offline-transition-actions">
            <!-- This button leads and is the only visually-primary action: it
                 is the one choice that costs the user nothing. The others
                 navigate away from a survey that may be half-answered, and
                 the RAM-only password does not survive that navigation — so
                 the safe option is the one that should be easiest to hit, and
                 the one focus lands on when this opens. Reconnecting is not a
                 reason to leave the page; it just means the queued responses
                 can sync.

                 Labelled "Continue Survey" everywhere, never "Stay Here":
                 this is the same action the authenticated page's offline
                 overlay already calls Continue Survey, and one wording for
                 one action is what keeps the two connectivity dialogs
                 readable as the same system. "Stay Here" also understates it
                 mid-attempt — what the user gets back is their part-filled
                 form, not merely the current page. -->
            <button type="button" class="btn btn-primary fw-semibold" onclick="dismissBackOnlineBanner()">Continue Survey</button>
            <button type="button" class="btn btn-outline-primary fw-semibold" onclick="confirmLeaveOfflineSurvey('/')">Go to Dashboard</button>
            <!-- Hidden while the survey view is open since offering Login mid-attempt would
                 abandon answers already entered for no gain. -->
            <button type="button" id="backOnlineLoginBtn" class="btn btn-outline-secondary fw-semibold" onclick="confirmLeaveOfflineSurvey('/login')">Login</button>
        </div>
    </div>
</div>
<% } %>

<% if (!offlineMode) { %>
<!-- ONLINE-SESSION OFFLINE TRANSITION, authenticated /client-survey only.
     Full-screen cover that hides account-specific content and offers only routes that
     work without a session, since there's no way to really check login state while offline.
     See the script block near the end of body for how it's driven. -->
<div id="onlineOfflineTransition" class="offline-transition-overlay" hidden role="alertdialog" aria-modal="true" aria-labelledby="offlineTransitionTitle">
    <div class="offline-transition-card">
        <div class="offline-transition-icon"><i id="offlineTransitionIcon" class="bi bi-wifi-off"></i></div>
        <h4 id="offlineTransitionTitle">You're Offline</h4>
        <p id="offlineTransitionDesc">Your internet connection has been lost. Online account features are temporarily unavailable.</p>
        <!-- Shown only when hasUnsavedSurveyProgress() is true when the overlay opens. -->
        <p id="offlineTransitionProgressNote" class="offline-transition-progress-note" hidden>Your current survey progress has been saved on this device. You can continue answering it offline.</p>
        <div class="offline-transition-actions">
            <!-- Primary action when a real in-progress attempt exists, dismisses the overlay in place. -->
            <button type="button" id="continueSurveyBtn" class="btn btn-primary fw-semibold" onclick="dismissOfflineTransitionForContinue()" hidden>Continue Survey</button>
            <!-- Home/Profile/History only, since there's no survey attempt in play there,
                 the honest action is just to stay on the view they were already on. -->
            <button type="button" id="offlineTransitionStayHereBtn" class="btn btn-primary fw-semibold" onclick="dismissOfflineTransitionForContinue()" hidden>Stay Here</button>
            <!-- leaveFromOfflineOverlay, not confirmLeaveOfflineSurvey, since the draft
                 already autosaved before this overlay ever showed. None of these three
                 destinations need a live session. -->
            <a href="/" class="btn btn-outline-primary fw-semibold" onclick="return leaveFromOfflineOverlay('/', event);">Back to Dashboard</a>
            <a href="/survey-offline" id="offlineTransitionGoOfflineSurveyBtn" class="btn btn-primary fw-semibold" onclick="return leaveFromOfflineOverlay('/survey-offline', event);">Go to Offline Survey</a>
            <a href="/login" class="btn btn-outline-secondary fw-semibold" onclick="return leaveFromOfflineOverlay('/login', event);">Login</a>
        </div>
    </div>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
<% if (!offlineMode) { %>
// Forces a hard reload if the browser restores this page from bfcache, so the server's
// session check actually runs again. Only for the authenticated render.
// __loginBoundary marks that this tab has stepped back to login before, sending it there
// instead of just reloading. Cleared once the page loads for real.
window.addEventListener('pageshow', function (event) {
    var navEntries = (window.performance && performance.getEntriesByType) ? performance.getEntriesByType('navigation') : [];
    var isBackForwardNav = navEntries.length > 0 && navEntries[0].type === 'back_forward';
    var loginBoundary = null;
    try { loginBoundary = sessionStorage.getItem('__loginBoundary'); } catch (e) {}

    if (event.persisted || isBackForwardNav) {
        if (loginBoundary) {
            window.location.replace(loginBoundary);
        } else {
            window.location.reload();
        }
    } else if (loginBoundary) {
        try { sessionStorage.removeItem('__loginBoundary'); } catch (e) {}
    }
});

// Backup for the guard above. A no-op unload listener opts this page out of bfcache
// entirely, so Back/Forward is always a real network request.
window.addEventListener('unload', function () {});
<% } %>

document.getElementById('surveyDate').valueAsDate = new Date();

// Caps the office-visit picker at now and defaults it to now when empty.
function initDefaultOfficeVisitedTime() {
    const dtInput = document.getElementById('officeVisitedTime');
    if (!dtInput) return;
    const now = new Date();
    const localNow = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    dtInput.max = localNow;
    if (!dtInput.value) dtInput.value = localNow;
}
initDefaultOfficeVisitedTime();
let currentLang = 'en';

// Home view is active by default on load, no switchView() call fires for it.

// =====================================
// DEPENDENT "SERVICE AVAILED" DROPDOWN
// =====================================
// Keyed by office_id, e.g. { "3": ["Service A", ...] }.
const officeServices = <%- JSON.stringify(typeof officeServices !== 'undefined' ? officeServices : {}) %>;
// "officeId::serviceName" -> message, for services this account can't re-survey yet.
const blockedCombos = <%- JSON.stringify(typeof blockedCombos !== 'undefined' ? blockedCombos : {}) %>;
// "officeId::serviceName" -> epoch ms this account becomes eligible again. Drives the live countdown.
const blockedUntil = <%- JSON.stringify(typeof blockedUntil !== 'undefined' ? blockedUntil : {}) %>;
// "officeId::serviceName" -> the service's cadence string, or null if one-time only.
const serviceAvailability = <%- JSON.stringify(typeof serviceAvailability !== 'undefined' ? serviceAvailability : {}) %>;

function populateServiceSelect(officeId) {
    const serviceSelect = document.getElementById('serviceSelect');
    if (!serviceSelect) return;

    serviceSelect.innerHTML = '';

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select Service...';
    placeholder.disabled = true;
    placeholder.selected = true;
    serviceSelect.appendChild(placeholder);

    const services = officeServices[officeId] || [];
    services.forEach(service => {
        const opt = document.createElement('option');
        opt.value = service;
        const blockedMessage = blockedCombos[officeId + '::' + service];
        if (blockedMessage) {
            opt.disabled = true;
            opt.title = blockedMessage;
            opt.textContent = '✓ ' + service;
        } else {
            opt.textContent = service;
        }
        serviceSelect.appendChild(opt);
    });

    serviceSelect.disabled = services.length === 0;
}

// =====================================
// LIVE "AVAILABLE AGAIN IN..." COUNTDOWN
// =====================================
// Counts down to blockedUntil for the picked office/service, ticking every second.
// Falls back to the static blockedCombos message when there's no timestamp to count down to.
let availabilityCountdownTimer = null;

function formatCountdown(msRemaining) {
    const totalSeconds = Math.max(0, Math.floor(msRemaining / 1000));
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    if (days > 0) return `${days}d ${hours}h ${minutes}m`;
    if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
    if (minutes > 0) return `${minutes}m ${seconds}s`;
    return `${seconds}s`;
}

// Collapses the longer blockedCombos strings down to a short label for the notice line.
function shortAvailabilityText(message) {
    if (/Awaiting the office/.test(message)) return 'Pending office review';
    if (/already evaluated/i.test(message)) return 'Already evaluated';
    return message;
}

// "1/3 answered" pill, office-wide so it shows as soon as a multi-service office is picked.
function updateServiceProgressBadge(officeId) {
    const badge = document.getElementById('serviceProgressBadge');
    if (!badge) return;

    const services = officeServices[officeId] || [];
    if (services.length <= 1) {
        badge.classList.add('d-none');
        return;
    }

    const answered = services.filter(s => blockedCombos[officeId + '::' + s]).length;
    if (answered === 0) {
        badge.classList.add('d-none');
        return;
    }

    badge.textContent = `${answered}/${services.length} answered`;
    badge.classList.remove('d-none');
}

function updateAvailabilityNotice() {
    if (availabilityCountdownTimer) {
        clearInterval(availabilityCountdownTimer);
        availabilityCountdownTimer = null;
    }

    const notice = document.getElementById('availabilityNotice');
    const noticeText = document.getElementById('availabilityNoticeText');
    const officeSelect = document.getElementById('officeSelect');
    const serviceSelect = document.getElementById('serviceSelect');
    if (!notice || !noticeText || !officeSelect || !serviceSelect) return;

    const officeId = officeSelect.value;
    updateServiceProgressBadge(officeId);

    const services = officeServices[officeId] || [];

    // Single-service offices surface availability right away, multi-service ones wait for a pick.
    const service = services.length === 1 ? services[0] : serviceSelect.value;
    if (!officeId || !service) {
        notice.classList.add('d-none');
        return;
    }

    const key = officeId + '::' + service;
    const untilTs = blockedUntil[key];
    const message = blockedCombos[key];

    if (untilTs) {
        const tick = () => {
            const remaining = untilTs - Date.now();
            if (remaining <= 0) {
                clearInterval(availabilityCountdownTimer);
                availabilityCountdownTimer = null;
                // Countdown hit zero, unblock live instead of needing a reload.
                delete blockedUntil[key];
                delete blockedCombos[key];
                populateServiceSelect(officeId);
                updateAvailabilityNotice();
                return;
            }
            noticeText.textContent = `Available again in ${formatCountdown(remaining)}`;
        };
        tick();
        availabilityCountdownTimer = setInterval(tick, 1000);
        notice.classList.remove('d-none');
    } else if (message) {
        noticeText.textContent = shortAvailabilityText(message);
        notice.classList.remove('d-none');
    } else {
        notice.classList.add('d-none');
    }
}

document.getElementById('officeSelect').addEventListener('change', function () {
    populateServiceSelect(this.value);
    updateAvailabilityNotice();
});

document.getElementById('serviceSelect').addEventListener('change', updateAvailabilityNotice);

// Handles the browser restoring a previously selected office without firing a change event.
(function initServiceSelectState() {
    const officeSelect = document.getElementById('officeSelect');
    if (officeSelect && officeSelect.value) {
        populateServiceSelect(officeSelect.value);
        updateAvailabilityNotice();
    }
})();

// Demographics saved from this account's FIRST-EVER survey submission (Region, Age, Sex).
// Once set, these are pre-filled and locked so the client can never change them again.
// Escapes "/" so a stored value can't contain a literal close-script sequence and end the tag early.
let savedClientProfile = <%- JSON.stringify(typeof clientProfile !== 'undefined' && clientProfile ? clientProfile : null).replace(/\//g, '\\u002f') %>;

// Caches the confirmed session identity so client-login.ejs can skip straight back here while offline.
const CLIENT_SESSION_KEY = 'cspc_client_session';
const currentClientEmail = <%- JSON.stringify(typeof clientEmail !== 'undefined' ? clientEmail : null) %>;

// True only on /survey-offline, where there's no session, so submissions queue for sync instead of posting directly.
const OFFLINE_MODE = <%- JSON.stringify(!!offlineMode) %>;

if (currentClientEmail) {
    try {
        localStorage.setItem(CLIENT_SESSION_KEY, JSON.stringify({ email: currentClientEmail, cachedAt: Date.now() }));
    } catch (e) { /* localStorage unavailable, offline session bypass just won't apply */ }
}

// ==========================================
// ONLINE-SESSION OFFLINE TRANSITION, authenticated /client-survey only.
// Driven by navigator.onLine and the online/offline events, not by fetch results.
// The pending-logout marker lives in offline-db.js and is shared with the other client pages.
// ==========================================

// ==========================================
// ACTIVE ONLINE SURVEY DRAFT, autosave/restore bridge into the offline outbox.
// Authenticated only. One draft ID per survey attempt, reused across autosaves and restores.
// ==========================================
let activeSurveyDraftId = null;
let activeSurveyDraftRestored = false;
// Set when the back-online flow synced and logged out silently without interrupting the user.
let backOnlinePromptSuppressed = false;

function currentSurveyStageNumber() {
    const activePage = document.querySelector('#surveyForm .page.active');
    return activePage ? parseInt(activePage.id.replace('stage', ''), 10) : 1;
}

// Collects form values the same way submitAll() does for a real submission.
function collectDraftableSurveyValues() {
    const form = document.getElementById('surveyForm');
    if (!form) return {};
    return buildSafeOfflineSurveyPayload(Object.fromEntries(new FormData(form).entries()));
}

// Immediate save, used before the offline overlay shows and when restoring/discarding.
// Ordinary typing uses the debounced wrapper below instead.
function autosaveActiveSurveyDraftNow() {
    if (OFFLINE_MODE || !currentClientEmail) return;
    if (!hasUnsavedSurveyProgress()) return; // touching nothing isn't progress
    if (!activeSurveyDraftId) {
        activeSurveyDraftId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : generateOfflineSubmissionId();
    }
    saveActiveSurveyDraft(currentClientEmail, {
        draftId: activeSurveyDraftId,
        stage: currentSurveyStageNumber(),
        values: collectDraftableSurveyValues(),
        termsAccepted: true, // hasUnsavedSurveyProgress() already implies stage > 1, i.e. Terms was passed
        language: typeof currentLang !== 'undefined' ? currentLang : 'en',
        createdOrUpdatedAt: new Date().toISOString()
    }).catch(err => console.error('[Survey Draft] Autosave failed:', err));
}

let autosaveDraftTimer = null;
function autosaveActiveSurveyDraftDebounced() {
    if (OFFLINE_MODE) return;
    clearTimeout(autosaveDraftTimer);
    autosaveDraftTimer = setTimeout(autosaveActiveSurveyDraftNow, 800);
}

// Wired to the whole form so every field type triggers autosave from one place.
if (!OFFLINE_MODE) {
    const surveyFormEl = document.getElementById('surveyForm');
    if (surveyFormEl) {
        surveyFormEl.addEventListener('input', autosaveActiveSurveyDraftDebounced);
        surveyFormEl.addEventListener('change', autosaveActiveSurveyDraftDebounced);
    }
}

// Called once the draft becomes a real submission, or the user starts over.
function discardActiveSurveyDraft() {
    activeSurveyDraftId = null;
    if (!OFFLINE_MODE && currentClientEmail) {
        clearActiveSurveyDraft(currentClientEmail).catch(err => console.error('[Survey Draft] Failed to clear draft:', err));
    }
}

// Restores an in-progress draft found on page load.
function restoreActiveSurveyDraftIntoForm(draft) {
    const values = draft.values || {};
    Object.keys(values).forEach(name => {
        const field = document.querySelector(`#surveyForm [name="${CSS.escape(name)}"]`);
        if (!field) return;
        if (field.type === 'radio' || field.type === 'checkbox') {
            const target = document.querySelector(`#surveyForm [name="${CSS.escape(name)}"][value="${CSS.escape(String(values[name]))}"]`);
            if (target) target.checked = true;
        } else {
            field.value = values[name];
        }
    });

    if (draft.termsAccepted) {
        const termsBox = document.getElementById('agreeTermsStage1');
        if (termsBox) termsBox.checked = true;
        const startBtn = document.getElementById('btnStartSurvey');
        if (startBtn) startBtn.disabled = false;
    }

    activeSurveyDraftId = draft.draftId || null;
    activeSurveyDraftRestored = true;
    const targetStage = draft.stage && draft.stage > 1 ? draft.stage : 1;
    if (targetStage > 1) navigate(targetStage);

    // Office/Service is a dependent dropdown, so the service list needs repopulating manually here.
    if (values.office_id) {
        populateServiceSelect(values.office_id);
        if (values.service_availed) {
            const serviceSelect = document.getElementById('serviceSelect');
            if (serviceSelect) serviceSelect.value = values.service_availed;
        }
        updateAvailabilityNotice();
    }

    if (window.AppAlert) AppAlert.toastInfo('Your saved survey has been restored.');
}

if (!OFFLINE_MODE && currentClientEmail) {
    getActiveSurveyDraft(currentClientEmail).then(draft => {
        if (draft && draft.values && Object.keys(draft.values).length) {
            restoreActiveSurveyDraftIntoForm(draft);
        }
    }).catch(err => console.error('[Survey Draft] Restore failed:', err));
}

// Shows the "You're offline" state and marks the pending logout so a later reload re-evaluates it.
// Saves the draft before showing the overlay, so answers are safe first.
function showOfflineTransition() {
    if (OFFLINE_MODE) return;
    autosaveActiveSurveyDraftNow();

    const overlay = document.getElementById('onlineOfflineTransition');
    if (!overlay) return;
    setPendingClientLogout();
    overlay.classList.remove('is-back-online');
    const icon = document.getElementById('offlineTransitionIcon');
    const title = document.getElementById('offlineTransitionTitle');
    const desc = document.getElementById('offlineTransitionDesc');
    const progressNote = document.getElementById('offlineTransitionProgressNote');
    const continueBtn = document.getElementById('continueSurveyBtn');
    const stayHereBtn = document.getElementById('offlineTransitionStayHereBtn');
    const goOfflineSurveyBtn = document.getElementById('offlineTransitionGoOfflineSurveyBtn');
    if (icon) icon.className = 'bi bi-wifi-off';
    if (title) title.textContent = "You're Offline";

    // Which view the user was on decides what this offers. Home/Profile/History get "Stay Here"
    // since there's no survey in progress there. Take Survey gets Continue Survey or Go Offline.
    const onSurveyView = !!document.querySelector('#view-survey.active');

    if (desc) {
        desc.textContent = onSurveyView
            ? 'Your internet connection has been lost. Online account features are temporarily unavailable.'
            : 'Your internet connection has been lost. Online account features are temporarily unavailable — you can keep viewing what was already loaded on this device.';
    }

    // Continue Survey only shows when there's real unfinished progress, not just an empty open form.
    const hasRealProgress = onSurveyView && hasUnsavedSurveyProgress();
    if (progressNote) progressNote.hidden = !hasRealProgress;
    if (continueBtn) continueBtn.hidden = !hasRealProgress;
    if (stayHereBtn) stayHereBtn.hidden = onSurveyView;
    if (goOfflineSurveyBtn) goOfflineSurveyBtn.hidden = !onSurveyView;
    // Keeps exactly one primary action visible: Continue Survey when available, Go Offline otherwise.
    if (goOfflineSurveyBtn) {
        goOfflineSurveyBtn.classList.toggle('btn-primary', !hasRealProgress);
        goOfflineSurveyBtn.classList.toggle('btn-outline-primary', hasRealProgress);
    }

    overlay.hidden = false;
}

// Hides the overlay so the user can keep answering. Pending logout marker stays as is.
function dismissOfflineTransitionForContinue() {
    const overlay = document.getElementById('onlineOfflineTransition');
    if (overlay) overlay.hidden = true;
}

// Connectivity is back but a server-side logout is still pending, so this never silently
// drops the user back into the authenticated view until the logout is confirmed.
async function showBackOnlineTransition() {
    if (OFFLINE_MODE) return;
    const overlay = document.getElementById('onlineOfflineTransition');
    if (!overlay) return;

    // Step 1: try to sync any survey queued while offline before the session goes away.
    if (typeof window.syncOfflineSurveysFromPage === 'function') {
        try { await window.syncOfflineSurveysFromPage(); } catch (e) { /* handled by the outbox check below */ }
    }

    // Step 2: confirm the outbox is actually empty before logging out.
    if (typeof getAuthenticatedOutboxSurveys === 'function') {
        try {
            const stillQueued = await getAuthenticatedOutboxSurveys();
            if (stillQueued && stillQueued.length > 0) return;
        } catch (e) {
            return; // can't confirm the queue is clear, don't log out yet
        }
    }

    // Step 3: safe to log out. Don't interrupt an in-progress Continue Survey attempt though.
    const continuingSurvey = overlay.hidden && activeSurveyDraftId && document.querySelector('#view-survey.active');
    if (continuingSurvey) {
        // Surfaced later by showThankYou() / switchView() once the attempt is done.
        backOnlinePromptSuppressed = true;
    } else {
        overlay.classList.add('is-back-online');
        const icon = document.getElementById('offlineTransitionIcon');
        const title = document.getElementById('offlineTransitionTitle');
        const desc = document.getElementById('offlineTransitionDesc');
        if (icon) icon.className = 'bi bi-wifi';
        if (title) title.textContent = "You're Back Online";
        if (desc) desc.textContent = 'For your security, please sign in again to continue using your account.';
        overlay.hidden = false;
    }

    attemptPendingClientLogout();
}

if (!OFFLINE_MODE) {
    window.addEventListener('offline', showOfflineTransition);
    window.addEventListener('online', function () {
        // A brief reconnect blip that never actually went offline shouldn't trigger this.
        if (hasPendingClientLogout()) showBackOnlineTransition();
    });

    // Re-evaluates state on page load too, not just on the next offline/online event.
    if (!navigator.onLine) {
        showOfflineTransition();
    } else if (hasPendingClientLogout()) {
        showBackOnlineTransition();
    }
}

// Silently refreshes this account's cached offline profile/eligibility snapshot into IndexedDB.
function refreshOfflineAccountContext() {
    if (OFFLINE_MODE || !currentClientEmail || !navigator.onLine) return;
    if (typeof saveOfflineAccountContext !== 'function') return;
    fetchWithTimeout('/api/client/offline-context', {}, 8000)
        .then(res => res.json())
        .then(data => {
            if (data && data.success) return saveOfflineAccountContext(data);
        })
        .catch(err => console.error('[Offline Context] Refresh failed:', err));
}
if (!OFFLINE_MODE) {
    window.addEventListener('load', refreshOfflineAccountContext);
}

// ==========================================
// NOTIFICATION BELL, authenticated client pages only.
// Renders what the server returns, never trusts a client-asserted identity.
// ==========================================
function timeAgo(isoString) {
    const then = new Date(isoString).getTime();
    if (isNaN(then)) return '';
    const diffSec = Math.max(0, Math.floor((Date.now() - then) / 1000));
    if (diffSec < 60) return 'Just now';
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return diffMin + (diffMin === 1 ? ' minute ago' : ' minutes ago');
    const diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return diffHr + (diffHr === 1 ? ' hour ago' : ' hours ago');
    const diffDay = Math.floor(diffHr / 24);
    if (diffDay === 1) return 'Yesterday';
    if (diffDay < 7) return diffDay + ' days ago';
    return new Date(isoString).toLocaleDateString('en-PH', { dateStyle: 'medium' });
}

// Panel state kept client-side so filtering doesn't round-trip to the server.
const notifState = { items: [], filter: 'all', expanded: new Set() };

let notifRenderedSignature = '';
function renderNotifications(notifications) {
    notifState.items = Array.isArray(notifications) ? notifications : [];
    // Skips re-rendering an unchanged list so scroll position doesn't reset on every poll.
    const signature = notifState.items.map(n => n.id + ':' + (n.is_read ? 1 : 0)).join(',');
    if (signature === notifRenderedSignature) return;
    notifRenderedSignature = signature;
    // Drops ids that no longer exist from the expanded set.
    const alive = new Set(notifState.items.map(n => String(n.id)));
    notifState.expanded.forEach(id => { if (!alive.has(id)) notifState.expanded.delete(id); });
    renderNotifList();
}

function renderNotifList() {
    const list = document.getElementById('notifList');
    if (!list) return;

    const all = notifState.items;
    const unreadCount = all.filter(n => !n.is_read).length;
    updateNotifPanelChrome(all.length, unreadCount);

    // "All" sorts unread items to the top since that's what someone opens the bell for.
    const visible = notifState.filter === 'unread'
        ? all.filter(n => !n.is_read)
        : all.slice().sort((a, b) => Number(!!a.is_read) - Number(!!b.is_read));

    if (!visible.length) {
        const empty = document.createElement('div');
        empty.className = 'notif-empty';
        const icon = document.createElement('i');
        icon.className = notifState.filter === 'unread' ? 'bi bi-check2-circle' : 'bi bi-bell-slash';
        empty.appendChild(icon);
        empty.appendChild(document.createTextNode(
            notifState.filter === 'unread'
                ? (all.length ? "You're all caught up — nothing unread." : 'No notifications yet.')
                : 'No notifications yet.'
        ));
        list.replaceChildren(empty);
        return;
    }

    list.replaceChildren(...visible.map(buildNotifItem));
}

function buildNotifItem(n) {
    const id = String(n.id);
    const isUnread = !n.is_read;
    const isExpanded = notifState.expanded.has(id);

    const item = document.createElement('div');
    item.className = 'notif-item' + (isUnread ? ' is-unread' : '') + (isExpanded ? ' expanded' : '');

    // Read state shows through multiple cues (rail, tint, icon, pill) for accessibility.
    const icon = document.createElement('span');
    icon.className = 'notif-item-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.innerHTML = isUnread ? '<i class="bi bi-bell-fill"></i>' : '<i class="bi bi-check2"></i>';
    item.appendChild(icon);

    const body = document.createElement('div');
    body.className = 'notif-item-body';

    const titleRow = document.createElement('button');
    titleRow.type = 'button';
    titleRow.className = 'notif-item-title-row';
    titleRow.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
    titleRow.addEventListener('click', () => {
        const nowExpanded = !item.classList.contains('expanded');
        item.classList.toggle('expanded', nowExpanded);
        titleRow.setAttribute('aria-expanded', nowExpanded ? 'true' : 'false');
        if (nowExpanded) notifState.expanded.add(id); else notifState.expanded.delete(id);
        if (!n.is_read) {
            // Updates the local copy first so the UI reacts immediately, not after the request.
            n.is_read = 1;
            notifRenderedSignature = notifState.items.map(x => x.id + ':' + (x.is_read ? 1 : 0)).join(',');
            markNotificationRead(n.id);
            item.classList.remove('is-unread');
            icon.innerHTML = '<i class="bi bi-check2"></i>';
            const pill = item.querySelector('.notif-status');
            if (pill) { pill.className = 'notif-status is-read'; pill.textContent = 'Read'; }
            updateNotifPanelChrome(notifState.items.length, notifState.items.filter(x => !x.is_read).length);
        }
    });

    const title = document.createElement('span');
    title.className = 'notif-item-title';
    title.textContent = n.title;
    titleRow.appendChild(title);

    const chevron = document.createElement('i');
    chevron.className = 'bi bi-chevron-down notif-item-chevron';
    chevron.setAttribute('aria-hidden', 'true');
    titleRow.appendChild(chevron);

    body.appendChild(titleRow);

    const message = document.createElement('div');
    message.className = 'notif-item-message';
    const messageInner = document.createElement('div');
    messageInner.textContent = n.message;
    message.appendChild(messageInner);
    body.appendChild(message);

    const meta = document.createElement('div');
    meta.className = 'notif-item-meta';
    const status = document.createElement('span');
    status.className = 'notif-status ' + (isUnread ? 'is-new' : 'is-read');
    status.textContent = isUnread ? 'New' : 'Read';
    meta.appendChild(status);
    const time = document.createElement('span');
    time.className = 'notif-item-time';
    time.textContent = timeAgo(n.created_at);
    meta.appendChild(time);
    body.appendChild(meta);

    item.appendChild(body);

    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'notif-item-delete';
    delBtn.setAttribute('aria-label', 'Delete notification');
    delBtn.innerHTML = '<i class="bi bi-trash3"></i>';
    delBtn.addEventListener('click', (e) => { e.stopPropagation(); deleteNotification(n.id); });
    item.appendChild(delBtn);

    return item;
}

// Updates the header count pill, tab counts, and bulk action buttons from these two numbers.
function updateNotifPanelChrome(total, unread) {
    const headerCount = document.getElementById('notifHeaderCount');
    if (headerCount) {
        headerCount.textContent = unread + ' new';
        headerCount.hidden = unread === 0;
    }
    const allCount = document.getElementById('notifTabCountAll');
    if (allCount) allCount.textContent = String(total);
    const unreadTabCount = document.getElementById('notifTabCountUnread');
    if (unreadTabCount) unreadTabCount.textContent = String(unread);
    const markAll = document.getElementById('notifMarkAllBtn');
    if (markAll) markAll.disabled = unread === 0;
    const clearAll = document.getElementById('notifClearAllBtn');
    if (clearAll) clearAll.disabled = total === 0;
}

function setNotificationFilter(filter) {
    notifState.filter = filter === 'unread' ? 'unread' : 'all';
    document.querySelectorAll('.notif-tab').forEach(tab => {
        const active = tab.getAttribute('data-notif-filter') === notifState.filter;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    renderNotifList();
    const list = document.getElementById('notifList');
    if (list) list.scrollTop = 0;
}

function updateNotifBadge(count) {
    const badge = document.getElementById('notifUnreadBadge');
    if (!badge) return;
    if (count > 0) {
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.hidden = false;
    } else {
        badge.hidden = true;
    }
}

let notificationsLoaded = false;
function loadNotifications() {
    if (OFFLINE_MODE || !navigator.onLine) return;
    fetchWithTimeout('/api/client/notifications', {}, 8000)
        .then(res => res.json())
        .then(data => {
            if (!data || !data.success) return;
            notificationsLoaded = true;
            renderNotifications(data.notifications || []);
            updateNotifBadge(data.unreadCount || 0);
        })
        .catch(err => console.error('[Notifications] Failed to load:', err));
}

// Moves #notifPanel and its backdrop to direct children of body the first time it opens,
// so it isn't clipped by the topbar's own stacking context.
function getNotifBackdrop() {
    let backdrop = document.getElementById('notifBackdrop');
    if (!backdrop) {
        backdrop = document.createElement('div');
        backdrop.id = 'notifBackdrop';
        backdrop.className = 'notif-backdrop';
        backdrop.hidden = true;
        backdrop.addEventListener('click', closeNotificationPanel);
        document.body.appendChild(backdrop);
    }
    return backdrop;
}

function positionNotifPanel(panel, bell) {
    if (panel.parentElement !== document.body) {
        document.body.appendChild(panel);
    }
    // Clears leftover inline coordinates on narrow screens so the CSS-anchored sheet layout wins.
    if (window.innerWidth <= 576) {
        panel.style.top = '';
        panel.style.right = '';
        panel.style.left = '';
        return;
    }
    const gap = 8;
    const rect = bell ? bell.getBoundingClientRect() : null;
    const bottom = rect ? rect.bottom : 64;
    const right = rect ? Math.max(16, window.innerWidth - rect.right) : 16;
    panel.style.top = Math.round(bottom + gap) + 'px';
    panel.style.right = Math.round(right) + 'px';
    panel.style.left = 'auto';
}

function repositionNotifPanelIfOpen() {
    const panel = document.getElementById('notifPanel');
    if (!panel || panel.hidden) return;
    positionNotifPanel(panel, document.getElementById('btn-notif-bell'));
}

function openNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel) return;
    positionNotifPanel(panel, bell);
    const backdrop = getNotifBackdrop();
    backdrop.hidden = false;
    // Next frame so the opacity transition actually runs from 0.
    requestAnimationFrame(() => backdrop.classList.add('is-open'));
    panel.hidden = false;
    if (bell) bell.classList.add('is-active');
    bell && bell.setAttribute('aria-expanded', 'true');
    document.body.classList.add('notif-panel-open');
    // Always opens on "All" so a leftover "Unread" filter doesn't show an empty panel.
    setNotificationFilter('all');
    // Refreshes behind the initial paint since the poll can be a bit stale.
    loadNotifications();
}

function closeNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel || panel.hidden) return;
    panel.hidden = true;
    const backdrop = document.getElementById('notifBackdrop');
    if (backdrop) { backdrop.classList.remove('is-open'); backdrop.hidden = true; }
    if (bell) { bell.classList.remove('is-active'); bell.setAttribute('aria-expanded', 'false'); }
    document.body.classList.remove('notif-panel-open');
}

function toggleNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    if (!panel) return;
    if (panel.hidden) openNotificationPanel(); else closeNotificationPanel();
}
// Kept registered permanently since repositionNotifPanelIfOpen() no-ops when the panel is hidden.
window.addEventListener('resize', repositionNotifPanelIfOpen);
window.addEventListener('scroll', repositionNotifPanelIfOpen, true);

document.addEventListener('click', (e) => {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel || panel.hidden) return;
    if (panel.contains(e.target) || (bell && bell.contains(e.target))) return;
    closeNotificationPanel();
});

document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const panel = document.getElementById('notifPanel');
    if (panel && !panel.hidden) closeNotificationPanel();
});

function markNotificationRead(id) {
    fetchWithTimeout('/api/client/notifications/' + encodeURIComponent(id) + '/read', { method: 'PATCH' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to mark read:', err));
}

function markAllNotificationsRead() {
    fetchWithTimeout('/api/client/notifications/read-all', { method: 'PATCH' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to mark all read:', err));
}

async function deleteNotification(id) {
    let confirmed;
    if (window.AppAlert && typeof AppAlert.confirm === 'function') {
        confirmed = await AppAlert.confirm('Delete this notification?', { title: 'Delete Notification?', confirmText: 'Delete' });
    } else {
        confirmed = window.confirm('Delete this notification?');
    }
    if (!confirmed) return;
    fetchWithTimeout('/api/client/notifications/' + encodeURIComponent(id), { method: 'DELETE' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to delete:', err));
}

async function clearAllNotifications() {
    let confirmed;
    const text = 'This will remove notifications from your notification inbox. It will NOT delete your surveys or change their status.';
    if (window.AppAlert && typeof AppAlert.confirm === 'function') {
        confirmed = await AppAlert.confirm(text, { title: 'Clear all notifications?', confirmText: 'Clear All' });
    } else {
        confirmed = window.confirm('Clear all notifications? ' + text);
    }
    if (!confirmed) return;
    fetchWithTimeout('/api/client/notifications', { method: 'DELETE' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to clear all:', err));
}

if (!OFFLINE_MODE) {
    window.addEventListener('load', loadNotifications);
    // Polls while the page is open since there's no realtime push. Pauses when the tab is hidden.
    setInterval(() => {
        if (document.visibilityState === 'visible') loadNotifications();
    }, 45000);
}

// ==========================================
// /survey-offline only. Applies a cached account context once a known email is typed.
// Purely a UX convenience, the server still enforces eligibility at sync time.
// ==========================================
let offlineContextInjectedKeys = [];

function clearInjectedOfflineEligibility() {
    offlineContextInjectedKeys.forEach(key => {
        delete blockedCombos[key];
        delete blockedUntil[key];
    });
    offlineContextInjectedKeys = [];
}

function setOfflineAccountContextNote(text) {
    const note = document.getElementById('offlineAccountContextNote');
    if (note) note.textContent = text;
}

function applyOfflineAccountContext(identifier) {
    if (!OFFLINE_MODE) return;
    if (typeof getOfflineAccountContext !== 'function') return;

    clearInjectedOfflineEligibility();
    unlockProfileFields();

    if (!identifier) {
        setOfflineAccountContextNote('');
        return;
    }

    getOfflineAccountContext(identifier).then(context => {
        // Only applies if the email field still matches, in case it changed while this was in flight.
        const currentIdentifier = (document.getElementById('offlineEmailInput')?.value || '').trim().toLowerCase();
        if (currentIdentifier !== identifier) return;

        if (!context) {
            // Reassures a returning user that anything typed here only applies to this offline response.
            setOfflineAccountContextNote(
                'Account information is not available offline on this device. You may complete the required profile information for this offline response. ' +
                'When internet connectivity returns, your registered account will be verified, and any existing profile information saved in your registered account will take precedence.'
            );
            return;
        }

        if (context.profile) {
            applyLockedProfile({ region: context.profile.region, age: context.profile.age, sex: context.profile.sex });
        }

        (context.services || []).forEach(svc => {
            if (svc.eligible) return;
            const key = svc.officeId + '::' + svc.serviceName;
            blockedCombos[key] = svc.cooldownUntil ? 'Available again soon.' : 'Currently unavailable for another response.';
            if (svc.cooldownUntil) {
                const ts = new Date(svc.cooldownUntil).getTime();
                if (!isNaN(ts)) blockedUntil[key] = ts;
            }
            offlineContextInjectedKeys.push(key);
        });

        const officeSelect = document.getElementById('officeSelect');
        if (officeSelect && officeSelect.value) {
            populateServiceSelect(officeSelect.value);
        }
        updateAvailabilityNotice();

        const cachedDate = context.cachedAt ? new Date(context.cachedAt) : null;
        const cachedText = cachedDate && !isNaN(cachedDate.getTime())
            ? ' (last updated ' + cachedDate.toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) + ')'
            : '';
        setOfflineAccountContextNote(
            'Account information found on this device' + cachedText + '. Your profile is shown read-only below, and known unavailable services are disabled — both are re-verified against the server once you\'re back online.'
        );
    }).catch(err => {
        console.error('[Offline Context] Lookup failed:', err);
    });
}

if (OFFLINE_MODE) {
    const offlineEmailInput = document.getElementById('offlineEmailInput');
    if (offlineEmailInput) {
        // Listens on blur and change, not input, so it doesn't query IndexedDB on every keystroke.
        const handleEmailFieldSettled = function () {
            applyOfflineAccountContext(this.value.trim().toLowerCase());
        };
        offlineEmailInput.addEventListener('blur', handleEmailFieldSettled);
        offlineEmailInput.addEventListener('change', handleEmailFieldSettled);
    }
}

// Persistent "Viewing Offline" pill that flips live with navigator.onLine.
function updateOfflineIndicator() {
    const el = document.getElementById('offlineIndicator');
    if (el) el.classList.toggle('is-visible', !navigator.onLine);
}
window.addEventListener('online', updateOfflineIndicator);
window.addEventListener('offline', updateOfflineIndicator);
document.addEventListener('DOMContentLoaded', updateOfflineIndicator);
updateOfflineIndicator();

// ==========================================
// BACK-ONLINE PROMPT, offline mode only. Never auto-navigates, the user decides.
// ==========================================
function showBackOnlineBanner() {
    if (!OFFLINE_MODE) return;
    const banner = document.getElementById('backOnlineBanner');
    if (!banner || !banner.hidden) return;

    // Login is hidden once the survey view is open. Re-checked every open since the user can move around.
    const loginBtn = document.getElementById('backOnlineLoginBtn');
    if (loginBtn) loginBtn.hidden = !!document.querySelector('#view-survey.active');

    banner.hidden = false;
    // Moves focus into the dialog for screen readers and keyboard users.
    const firstBtn = banner.querySelector('.offline-transition-actions .btn');
    if (firstBtn) firstBtn.focus();
}
function dismissBackOnlineBanner() {
    const banner = document.getElementById('backOnlineBanner');
    if (banner) banner.hidden = true;
}

// Backdrop tap and Escape both mean "Stay Here", the safe choice that leaves the survey untouched.
(function () {
    const banner = document.getElementById('backOnlineBanner');
    if (!banner) return;
    banner.addEventListener('click', function (e) {
        if (e.target === banner) dismissBackOnlineBanner();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !banner.hidden) dismissBackOnlineBanner();
    });
})();

// True once the user is past Stage 1, meaning there's unsaved progress worth warning about.
function hasUnsavedSurveyProgress() {
    const activePage = document.querySelector('#surveyForm .page.active');
    if (!activePage) return false;
    const stage = parseInt(activePage.id.replace('stage', ''), 10);
    return stage > 1;
}

// Confirms before leaving if there's unsaved progress. Used by the dashboard link and back-online banner buttons.
function confirmLeaveOfflineSurvey(url, event) {
    if (event) event.preventDefault();
    (async () => {
        try {
            if (hasUnsavedSurveyProgress()) {
                let confirmed;
                if (window.AppAlert && typeof AppAlert.confirm === 'function') {
                    confirmed = await AppAlert.confirm(
                        'You have unfinished survey information. Leaving this page may discard the unfinished form.',
                        { title: 'Leave Offline Survey?', confirmText: 'Leave' }
                    );
                } else {
                    confirmed = window.confirm('You have unfinished survey information. Leaving this page may discard the unfinished form.');
                }
                if (!confirmed) return;
            }
        } catch (err) {
            // Fails open and navigates anyway so the button isn't left dead. The draft is autosaved regardless.
            console.error('[Offline Nav] Leave confirmation failed, navigating anyway:', err);
        }
        window.location.href = url;
    })();
    return false;
}

// The "You're Offline" overlay's own navigation buttons. No confirm needed here since the draft is already saved.
function leaveFromOfflineOverlay(url, event) {
    // Marks the same one-shot offline intent as the public connection prompt, so /survey-offline doesn't show "You're Back Online".
    if (url && url.indexOf('/survey-offline') === 0 && typeof ConnectionPrompt !== 'undefined') {
        ConnectionPrompt.markOfflineIntent();
    }
    if (event) event.preventDefault();
    // Defensive re-save in case something was typed between the overlay opening and this click.
    try { autosaveActiveSurveyDraftNow(); } catch (err) {
        console.error('[Offline Nav] Draft autosave before leaving failed:', err);
    }
    window.location.href = url;
    return false;
}

if (OFFLINE_MODE) {
    // Re-checks on load too, confirmed with a real server ping since navigator.onLine can lie.
    // Skips entirely if the visitor deliberately chose to go offline.
    const arrivedByDeliberateChoice = (typeof ConnectionPrompt !== 'undefined')
        ? ConnectionPrompt.consumeOfflineIntent()
        : false;

    function showBackOnlineBannerIfReachable() {
        if (typeof ConnectionPrompt === 'undefined') {
            // Module unavailable, so falls back to the plain navigator.onLine check.
            if (navigator.onLine) showBackOnlineBanner();
            return;
        }
        ConnectionPrompt.isReachable().then(function (reachable) {
            if (reachable) showBackOnlineBanner();
        });
    }

    if (!arrivedByDeliberateChoice && navigator.onLine) showBackOnlineBannerIfReachable();
    // 'online' just means the network interface is up, not that the server is reachable.
    window.addEventListener('online', showBackOnlineBannerIfReachable);

    // Retries a pending logout here too, in case the server still thinks an old session is valid.
    if (navigator.onLine && hasPendingClientLogout()) attemptPendingClientLogout();
    window.addEventListener('online', function () {
        if (hasPendingClientLogout()) attemptPendingClientLogout();
    });
}

// Remembers what this account last typed for Name/Client Type/Age/Region, reused on Autofill.
// Keyed per email so different people sharing a browser never see each other's answers.
const CLIENT_AUTOFILL_KEY = currentClientEmail
    ? 'cspc_client_autofill_profile_' + currentClientEmail.toLowerCase()
    : null;

function saveAutofillProfile(data) {
    if (!CLIENT_AUTOFILL_KEY) return;
    try {
        localStorage.setItem(CLIENT_AUTOFILL_KEY, JSON.stringify({
            respondent_name: data.respondent_name || '',
            client_type: data.client_type || '',
            age: data.age || '',
            region: data.region || ''
        }));
    } catch (e) { /* localStorage unavailable, autofill just won't persist */ }
}

// Fills Name/Client Type/Age/Region from this account's last locally-saved answers.
// Only called from the Autofill switch, never on page load, and never overwrites a filled or locked field.
// opts.skipName skips the name when the server already answered for it.
function applyAutofillFromLocalStorage(opts) {
    opts = opts || {};
    if (!CLIENT_AUTOFILL_KEY) return;
    let saved;
    try { saved = JSON.parse(localStorage.getItem(CLIENT_AUTOFILL_KEY)); } catch (e) { saved = null; }
    if (!saved) return;

    if (!opts.skipName) {
        const nameInput = document.querySelector('input[name="respondent_name"]');
        if (nameInput && !nameInput.disabled && !nameInput.value && saved.respondent_name) {
            nameInput.value = saved.respondent_name;
        }
    }

    const clientTypeSelect = document.querySelector('select[name="client_type"]');
    if (clientTypeSelect && !clientTypeSelect.disabled && !clientTypeSelect.value && saved.client_type) {
        clientTypeSelect.value = saved.client_type;
    }

    const ageSelect = document.querySelector('select[name="age"]');
    if (ageSelect && !ageSelect.disabled && !ageSelect.value && saved.age) {
        ageSelect.value = saved.age;
    }

    const regionSelect = document.querySelector('select[name="region"]');
    if (regionSelect && !regionSelect.disabled && !regionSelect.value && saved.region) {
        regionSelect.value = saved.region;
    }
}

// Fills and locks Region/Age/Gender from a saved profile, either the server-rendered one
// or one read from IndexedDB offline context.
function applyLockedProfile(profile) {
    profile = profile || savedClientProfile;
    if (!profile) return;

    // Name is never prefilled here, only by the explicit Autofill switch. Respondents stay anonymous by default.

    if (profile.region) {
        const regionSelect = document.querySelector('select[name="region"]');
        if (regionSelect) {
            regionSelect.value = profile.region;
            regionSelect.disabled = true;
        }
        const note = document.getElementById('region-lock-note');
        if (note) note.classList.remove('d-none');
    }

    if (profile.age) {
        const ageSelect = document.querySelector('select[name="age"]');
        if (ageSelect) {
            ageSelect.value = profile.age;
            ageSelect.disabled = true;
        }
        const note = document.getElementById('age-lock-note');
        if (note) note.classList.remove('d-none');
    }

    // Offline context uses `sex`, the authenticated profile uses `gender`, so this accepts either.
    const genderValue = profile.gender || profile.sex;
    if (genderValue) {
        const genderSelect = document.querySelector('select[name="gender"]');
        if (genderSelect) {
            genderSelect.value = genderValue;
            genderSelect.disabled = true;
        }
        const note = document.getElementById('gender-lock-note');
        if (note) note.classList.remove('d-none');
    }

    // Activates Bootstrap tooltips on any lock icons just revealed
    document.querySelectorAll('.lock-icon:not(.d-none)').forEach(el => {
        bootstrap.Tooltip.getOrCreateInstance(el);
    });
}

// Reverses applyLockedProfile. Offline mode only, when the typed email changes to an uncached one.
function unlockProfileFields() {
    const regionSelect = document.querySelector('select[name="region"]');
    if (regionSelect) regionSelect.disabled = false;
    document.getElementById('region-lock-note')?.classList.add('d-none');

    const ageSelect = document.querySelector('select[name="age"]');
    if (ageSelect) ageSelect.disabled = false;
    document.getElementById('age-lock-note')?.classList.add('d-none');

    const genderSelect = document.querySelector('select[name="gender"]');
    if (genderSelect) genderSelect.disabled = false;
    document.getElementById('gender-lock-note')?.classList.add('d-none');
}

// Snapshot of Name/Sex/Age/Region taken before the switch is turned on, restored if turned back off.
let autofillSnapshot = null;

// Tells the client plainly if Autofill found no saved name, instead of leaving it blank silently.
function notifyIfNoAutofillName() {
    const nameInput = document.querySelector('input[name="respondent_name"]');
    if (nameInput && !nameInput.value && window.AppAlert && typeof AppAlert.toastInfo === 'function') {
        AppAlert.toastInfo('No name is saved in your profile.');
    }
}

// Updates the local profile copy once a finalized submission locks Region/Age/Sex in the database,
// so later applyLockedProfile() calls this session lock them without a reload.
// Only for finalized submissions, pending ones don't touch client_accounts yet.
function rememberLockedDemographics(submitted) {
    if (!submitted) return;
    const base = savedClientProfile || {};
    savedClientProfile = Object.assign({}, base, {
        // Write-once, mirrors the server: the first submission's value wins and later ones can't replace it.
        region: base.region || submitted.region || null,
        age: base.age || submitted.age || null,
        gender: base.gender || submitted.gender || null
    });
    applyLockedProfile(savedClientProfile);
}

// Toggling on fills Name/Sex/Age/Region from the saved profile. Toggling off restores the prior values.
function toggleAutofillClientProfile(enabled) {
    if (enabled) {
        autofillSnapshot = {
            respondent_name: document.querySelector('input[name="respondent_name"]')?.value ?? '',
            region: document.querySelector('select[name="region"]')?.value ?? '',
            age: document.querySelector('select[name="age"]')?.value ?? '',
            gender: document.querySelector('select[name="gender"]')?.value ?? ''
        };

        fetchWithTimeout('/api/client-profile', {}, 5000)
            .then(res => res.json())
            .then(data => {
                const p = (data.success && data.profile) ? data.profile : {};

                const nameInput = document.querySelector('input[name="respondent_name"]');
                if (nameInput && !nameInput.disabled && p.respondent_name) nameInput.value = p.respondent_name;

                const regionSelect = document.querySelector('select[name="region"]');
                if (regionSelect && !regionSelect.disabled && p.region) regionSelect.value = p.region;

                const ageSelect = document.querySelector('select[name="age"]');
                if (ageSelect && !ageSelect.disabled && p.age) ageSelect.value = p.age;

                const genderSelect = document.querySelector('select[name="gender"]');
                if (genderSelect && !genderSelect.disabled && p.gender) genderSelect.value = p.gender;

                // Shows Region/Age/Sex as locked once the account has submitted before, since the
                // server will overwrite them anyway. Also keeps the page's own profile copy current.
                if (p.region || p.age || p.gender) {
                    savedClientProfile = Object.assign({}, savedClientProfile, {
                        region: p.region || (savedClientProfile && savedClientProfile.region) || null,
                        age: p.age || (savedClientProfile && savedClientProfile.age) || null,
                        gender: p.gender || (savedClientProfile && savedClientProfile.gender) || null
                    });
                    applyLockedProfile(savedClientProfile);
                }

                // Falls back to locally-remembered answers only where the server didn't provide one.
                applyAutofillFromLocalStorage({ skipName: true });
                notifyIfNoAutofillName();
            })
            .catch(err => {
                console.error('Error autofilling profile:', err);
                // Server unreachable, so a locally-cached name is an acceptable substitute here.
                applyAutofillFromLocalStorage();
                notifyIfNoAutofillName();
            });
    } else if (autofillSnapshot) {
        const nameInput = document.querySelector('input[name="respondent_name"]');
        if (nameInput && !nameInput.disabled) nameInput.value = autofillSnapshot.respondent_name;

        const regionSelect = document.querySelector('select[name="region"]');
        if (regionSelect && !regionSelect.disabled) regionSelect.value = autofillSnapshot.region;

        const ageSelect = document.querySelector('select[name="age"]');
        if (ageSelect && !ageSelect.disabled) ageSelect.value = autofillSnapshot.age;

        const genderSelect = document.querySelector('select[name="gender"]');
        if (genderSelect && !genderSelect.disabled) genderSelect.value = autofillSnapshot.gender;

        autofillSnapshot = null;
    }
}

