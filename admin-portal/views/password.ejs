<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        /* Custom UI Enhancements */
        .card-custom {
            border: none;
            box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.05);
            border-radius: 0.75rem;
            overflow: hidden;
        }
        .security-sidebar {
            background: linear-gradient(135deg, #0a1f44 0%, #12305c 100%);
            color: white;
            padding: 3rem 2rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .password-toggle {
            cursor: pointer;
            background-color: #f8f9fa;
            border-left: none;
        }
        .form-control-custom {
            border-right: none;
        }
        .form-control-custom:focus + .input-group-text {
            border-color: #86b7fe;
        }
        .security-list li {
            margin-bottom: 1rem;
            font-size: 0.95rem;
            opacity: 0.9;
        }
        .error-text {
            color: #dc3545;
            font-size: 0.85rem;
            margin-top: 0.25rem;
            display: none;
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid p-4">
            <script>document.getElementById('pageTitle').innerText = 'Security Settings';</script>

            <div class="card card-custom">
                <div class="row g-0">
                    
                    <div class="col-lg-5 col-xl-4 d-none d-lg-block">
                        <div class="security-sidebar">
                            <div class="text-center mb-4">
                                <i class="fas fa-shield-alt fa-4x text-white mb-3" style="opacity: 0.9;"></i>
                                <h3 class="fw-bold">Account Security</h3>
                                <p class="text-white-50">Keep your account safe and secure</p>
                            </div>
                            <hr class="border-white opacity-25 mb-4">
                            <h5 class="fw-semibold mb-3"><i class="fas fa-lightbulb me-2 text-warning"></i> Password Tips:</h5>
                            <ul class="list-unstyled security-list">
                                <li><i class="fas fa-check-circle me-2 text-success"></i> Use at least 8 characters long.</li>
                                <li><i class="fas fa-check-circle me-2 text-success"></i> Combine uppercase and lowercase letters.</li>
                                <li><i class="fas fa-check-circle me-2 text-success"></i> Include numbers and special characters (e.g., !@#$%).</li>
                                <li><i class="fas fa-check-circle me-2 text-success"></i> Do not use common words or personal info like birthdays.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-lg-7 col-xl-8">
                        <div class="card-body p-4 p-md-5">
                            <h4 class="fw-bold mb-1"><i class="fas fa-key me-2 text-primary"></i>Change Password</h4>
                            <p class="text-muted mb-4">Ensure your account is using a long, random password to stay secure.</p>
                            
                            <div id="successAlert" class="alert alert-success d-none mb-4" role="alert">
                                <i class="fas fa-check-circle me-2"></i> Password successfully updated!
                            </div>
                            <div id="errorAlert" class="alert alert-danger d-none mb-4" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i><span id="errorAlertText">Something went wrong.</span>
                            </div>

                            <form id="passwordForm">
                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-secondary">Current Password</label>
                                    <div class="input-group">
                                        <div class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-lock"></i></div>
                                        <input type="password" id="currentPassword" class="form-control form-control-custom bg-light" required placeholder="Enter current password">
                                        <span class="input-group-text password-toggle" onclick="togglePassword('currentPassword', 'eyeCurrent')">
                                            <i class="fas fa-eye" id="eyeCurrent"></i>
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-secondary">New Password</label>
                                    <div class="input-group">
                                        <div class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-key"></i></div>
                                        <input type="password" id="newPassword" class="form-control form-control-custom bg-light" required placeholder="Enter new password">
                                        <span class="input-group-text password-toggle" onclick="togglePassword('newPassword', 'eyeNew')">
                                            <i class="fas fa-eye" id="eyeNew"></i>
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-secondary">Confirm New Password</label>
                                    <div class="input-group">
                                        <div class="input-group-text bg-light text-muted border-end-0"><i class="fas fa-check-double"></i></div>
                                        <input type="password" id="confirmPassword" class="form-control form-control-custom bg-light" required placeholder="Re-type new password">
                                        <span class="input-group-text password-toggle" onclick="togglePassword('confirmPassword', 'eyeConfirm')">
                                            <i class="fas fa-eye" id="eyeConfirm"></i>
                                        </span>
                                    </div>
                                    <div id="matchError" class="error-text"><i class="fas fa-exclamation-circle me-1"></i> Passwords do not match.</div>
                                </div>

                                <div class="d-flex justify-content-end mt-5 pt-3 border-top">
                                    <button type="button" class="btn btn-light me-2 px-4" onclick="document.getElementById('passwordForm').reset()">Cancel</button>
                                    <button type="submit" id="btnUpdatePassword" class="btn btn-primary px-4 shadow-sm">
                                        <i class="fas fa-save me-2"></i>Update Password
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>

<script>
    // Function to toggle password visibility
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        
        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    // Form Submission and Validation Logic
    document.addEventListener("DOMContentLoaded", function() {
        const passwordForm = document.getElementById("passwordForm");
        const currentPassword = document.getElementById("currentPassword");
        const newPassword = document.getElementById("newPassword");
        const confirmPassword = document.getElementById("confirmPassword");
        const matchError = document.getElementById("matchError");
        const successAlert = document.getElementById("successAlert");
        const errorAlert = document.getElementById("errorAlert");
        const errorAlertText = document.getElementById("errorAlertText");
        const btnUpdatePassword = document.getElementById("btnUpdatePassword");

        // Real-time checking if passwords match while typing in "Confirm Password"
        confirmPassword.addEventListener('input', function() {
            if (confirmPassword.value !== newPassword.value && confirmPassword.value !== "") {
                matchError.style.display = "block";
                confirmPassword.classList.add("is-invalid");
            } else {
                matchError.style.display = "none";
                confirmPassword.classList.remove("is-invalid");
            }
        });

        // Handle form submission
        passwordForm.addEventListener("submit", async function(event) {
            event.preventDefault(); // Prevent default page reload

            successAlert.classList.add("d-none");
            errorAlert.classList.add("d-none");

            // Final check bago isubmit
            if (newPassword.value !== confirmPassword.value) {
                matchError.style.display = "block";
                confirmPassword.classList.add("is-invalid");
                confirmPassword.focus();
                return;
            }

            btnUpdatePassword.disabled = true;
            btnUpdatePassword.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Updating...';

            try {
                const response = await fetch('/password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        currentPassword: currentPassword.value,
                        newPassword: newPassword.value
                    })
                });
                const data = await response.json();

                if (!response.ok || !data.success) {
                    errorAlertText.innerText = data.message || 'Failed to update password.';
                    errorAlert.classList.remove("d-none");
                    return;
                }

                // Matagumpay — ipakita ang success message at i-reset ang form
                successAlert.classList.remove("d-none");
                passwordForm.reset();

                // I-reset din ang mga eye icons pabalik sa default
                document.querySelectorAll('.password-toggle i').forEach(icon => {
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                });

                setTimeout(() => {
                    successAlert.classList.add("d-none");
                }, 4000);
            } catch (err) {
                console.error('Error updating password:', err);
                errorAlertText.innerText = 'Network error. Please try again.';
                errorAlert.classList.remove("d-none");
            } finally {
                btnUpdatePassword.disabled = false;
                btnUpdatePassword.innerHTML = '<i class="fas fa-save me-2"></i>Update Password';
            }
        });
    });
</script>

</body>
</html>