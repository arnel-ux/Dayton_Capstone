<!--
    Global dark mode toggle. Include this ONCE per page (already wired into
    layout/footer.ejs for every page that uses the sidebar layout).
    Standalone pages (index.ejs, login.ejs, client-survey.ejs, etc.) include
    it directly — see DARK_MODE_GUIDE for the full list.
-->
<button id="themeToggleBtn" class="theme-toggle-btn" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
    <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
</button>

<style>
    .theme-toggle-btn {
        position: fixed;
        bottom: calc(20px + env(safe-area-inset-bottom, 0px));
        right: calc(20px + env(safe-area-inset-right, 0px));
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid rgba(15, 23, 42, 0.08);
        background: #ffffff;
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        cursor: pointer;
        z-index: 1080;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.12);
        transition: background-color 0.25s ease, color 0.25s ease,
                    border-color 0.25s ease, box-shadow 0.25s ease,
                    transform 0.15s ease;
    }
    .theme-toggle-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
    }
    .theme-toggle-btn:active { transform: translateY(0) scale(0.94); }
    .theme-toggle-btn:focus-visible {
        outline: 2px solid #251d3a;
        outline-offset: 2px;
    }

    .theme-toggle-btn .theme-icon {
        position: absolute;
        width: 16px;
        height: 16px;
        transition: opacity 0.3s ease, transform 0.4s ease;
    }
    .theme-toggle-btn .theme-icon-moon { opacity: 1; transform: rotate(0deg) scale(1); }
    .theme-toggle-btn .theme-icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.5); }

    html[data-bs-theme="dark"] .theme-toggle-btn {
        background: #1e293b;
        color: #f8fafc;
        border-color: rgba(255, 255, 255, 0.12);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    }
    html[data-bs-theme="dark"] .theme-toggle-btn .theme-icon-moon { opacity: 0; transform: rotate(90deg) scale(0.5); }
    html[data-bs-theme="dark"] .theme-toggle-btn .theme-icon-sun  { opacity: 1; transform: rotate(0deg) scale(1); }

    @media (max-width: 576px) {
        .theme-toggle-btn {
            /* Was 34px — under the 40-44px target. Bumped to 42px and given
               a touch more inset so it clears the safe area and never sits
               flush against the corner over History badges/CC/SQD options/
               Next-Back-Submit buttons/the notification panel, none of
               which are ever positioned in this same bottom-right corner. */
            bottom: calc(14px + env(safe-area-inset-bottom, 0px));
            right: calc(12px + env(safe-area-inset-right, 0px));
            width: 40px; height: 40px;
        }
        .theme-toggle-btn .theme-icon { width: 18px; height: 18px; }
    }
</style>

<script>
    (function () {
        function applyTheme(theme) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            document.body.classList.toggle('dark-mode', theme === 'dark');
        }

        var saved = 'light';
        try { saved = localStorage.getItem('theme') || 'light'; } catch (e) {}
        applyTheme(saved);

        var btn = document.getElementById('themeToggleBtn');
        if (!btn) return;

        btn.addEventListener('click', function () {
            var isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
            var next = isDark ? 'light' : 'dark';
            applyTheme(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
            document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
        });
    })();
</script>
