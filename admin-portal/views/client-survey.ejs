        <div class="app-view" id="view-survey">
        <div class="card border-0 survey-card">
        <div class="card-body p-4 p-md-5 position-relative">

            <div class="view-page-title">
                <span class="vpt-icon"><i class="bi bi-clipboard2-check-fill"></i></span>
                <div class="vpt-text">
                    <h1 class="vpt-name">Client Satisfaction Survey</h1>
                </div>

                <!-- Language switch — moved out of the app header and onto this
                     line, because it only ever affects THIS form's wording. It
                     now sits where what it changes is: beside the survey's own
                     title. Being inside the survey view also means it appears
                     and disappears with that view on its own, with no JS
                     showing/hiding it per view.

                     One control, not two buttons: a switch reads as "one of
                     two", which is what a language choice is. The flag in the
                     track is the language currently in effect, so the control
                     says which language you are reading in even before you
                     read the labels; the knob's side says the same thing again
                     for anyone who can't rely on the flag colours. Flags are
                     inline SVG, not an icon font or a CDN image, so they still
                     render with no network — this form is used offline. -->
                <div class="lang-switch" id="lang-toggle-group">
                    <span class="lang-switch-label is-active" id="lang-label-en" aria-hidden="true">EN</span>
                    <button type="button" class="lang-switch-track" id="langSwitchTrack"
                            role="switch" aria-checked="false"
                            aria-label="Survey language — English or Tagalog"
                            title="Switch survey language (English / Tagalog)"
                            onclick="setLanguage(currentLang === 'en' ? 'tl' : 'en')">
                        <span class="lang-switch-flag is-en" aria-hidden="true">
                            <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" focusable="false"><defs><clipPath id="langFlagUkClip"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath></defs><path d="M0,0 v30 h60 v-30 z" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#langFlagUkClip)" stroke="#C8102E" stroke-width="4"/><path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/><path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6"/></svg>
                        </span>
                        <span class="lang-switch-flag is-tl" aria-hidden="true">
                            <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" focusable="false"><path d="M0,0 h60 v15 h-60 z" fill="#0038A8"/><path d="M0,15 h60 v15 h-60 z" fill="#CE1126"/><path d="M0,0 L25.98,15 L0,30 Z" fill="#fff"/><circle cx="7.6" cy="15" r="3.1" fill="#FCD116"/><path d="M7.6,8.7 L8.7,13.1 L12.6,10.8 L10.3,14.7 L14.7,15 L10.3,15.3 L12.6,19.2 L8.7,16.9 L7.6,21.3 L6.5,16.9 L2.6,19.2 L4.9,15.3 L0.5,15 L4.9,14.7 L2.6,10.8 L6.5,13.1 Z" fill="#FCD116"/><path d="M3.20,2.00L3.56,3.11L4.72,3.11L3.78,3.79L4.14,4.89L3.20,4.21L2.26,4.89L2.62,3.79L1.68,3.11L2.84,3.11Z" fill="#FCD116"/><path d="M3.20,24.80L3.56,25.91L4.72,25.91L3.78,26.59L4.14,27.69L3.20,27.01L2.26,27.69L2.62,26.59L1.68,25.91L2.84,25.91Z" fill="#FCD116"/><path d="M21.40,13.40L21.76,14.51L22.92,14.51L21.98,15.19L22.34,16.29L21.40,15.61L20.46,16.29L20.82,15.19L19.88,14.51L21.04,14.51Z" fill="#FCD116"/></svg>
                        </span>
                        <span class="lang-switch-knob"></span>
                    </button>
                    <span class="lang-switch-label" id="lang-label-tl" aria-hidden="true">TL</span>
                </div>
            </div>

            <div class="survey-hero text-center mb-5">
                <div class="survey-hero-logo-wrap">
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="survey-hero-logo">
                </div>
                <div class="survey-hero-eyebrow" data-i18n="gov_rep">Republic of the Philippines</div>
                <h3 class="fw-bold text-uppercase mb-0 text-heading survey-hero-title">Camarines Sur Polytechnic Colleges</h3>
                <p class="text-secondary fst-italic mb-4">Nabua, Camarines Sur</p>

                <div class="survey-hero-badge">
                    <i class="bi bi-clipboard2-check-fill"></i>
                    <h4 class="fw-semibold text-uppercase mb-0" data-i18n="form_title">Client Satisfaction Measurement (CSM) Survey</h4>
                </div>
            </div>

            <div class="survey-progress mb-5" id="surveyProgress">
                <div class="progress-steps">
                    <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
                    <div class="progress-step active" data-step="1">
                        <div class="step-dot"><span>1</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Terms</div>
                    </div>
                    <div class="progress-step" data-step="2">
                        <div class="step-dot"><span>2</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Client Info</div>
                    </div>
                    <div class="progress-step" data-step="3">
                        <div class="step-dot"><span>3</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Citizen's Charter</div>
                    </div>
                    <div class="progress-step" data-step="4">
                        <div class="step-dot"><span>4</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">SQD Rating</div>
                    </div>
                    <div class="progress-step" data-step="5">
                        <div class="step-dot"><span>5</span><i class="bi bi-check-lg"></i></div>
