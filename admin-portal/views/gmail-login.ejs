<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Reset and Base Styles */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden; 
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* 1. The Blurred Background Image */
        .bg-blurred {
            position: fixed; 
            top: -5%; left: -5%; right: -5%; bottom: -5%; 
            background-image: url('https://spims.cspc.edu.ph/assets/img/background.jpg'); 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(1px);
            z-index: -1;
        }

        /* 2. The Dark Overlay */
        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(15, 23, 42, 0.6); 
            z-index: -1;
        }

        /* 3. Perfect Centering Wrapper */
        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column; 
            align-items: center;    
            justify-content: center;   
            z-index: 1;
            padding: 1rem;
        }

        /* Header Animations & Styles */
        @keyframes fadeSlideUp {
            0% { opacity: 0; transform: translateY(30px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .header-container {
            text-align: center;
            margin-bottom: 2rem;
            max-width: 800px; 
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 2rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.5rem;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #f8fafc;
            font-weight: 400;
            font-style: italic; 
            font-size: 1.1rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 1.2rem;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            color: #ffff; 
            font-weight: 700;
            font-size: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        @media (max-width: 600px) {
            .main-title { font-size: 1.4rem; }
            .sub-title { font-size: 0.9rem; margin-bottom: 1rem; }
            .portal-text { font-size: 1.1rem; }
        }

        /* 4. Card Styling */
        .card-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 380px; 
            height: auto; /* Iniba sa auto para mag-fit ang form */
            min-height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 2rem 2.5rem; 
        }

        @media (max-width: 400px) {
            .card-custom {
                width: 90vw;
                padding: 1.5rem;
            }
        }

        /* Google Mock Form Styles */
        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 0.95rem;
        }

        .form-control:focus {
            border-color: #0b57d0; /* Google blue */
            box-shadow: 0 0 0 0.25rem rgba(11, 87, 208, 0.25);
        }

        .btn-google-login {
            background-color: #0b57d0; /* Google Primary Blue */
            color: white;
            border-radius: 50px; /* Pill shape like modern Google */
            padding: 0.6rem 1.5rem;
            font-weight: 600;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-google-login:hover {
            background-color: #0842a0;
            color: white;
        }

        .text-xsmall { font-size: 0.8rem; }
    </style>
</head>
<body>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <div class="login-wrapper">
        
        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Client Portal</h2>
        </div>

        <div class="card-custom">
            
            <div class="text-center mb-4">
                <img src="https://www.freepnglogos.com/uploads/google-logo-png/google-logo-png-google-icon-logo-png-transparent-svg-vector-bie-supply-14.png" alt="Google Logo" style="width: 45px; margin-bottom: 10px;">
                <h4 class="fw-normal text-dark mb-1" style="font-size: 1.5rem;">Sign in</h4>
                <p class="text-muted mb-0" style="font-size: 0.9rem;">to continue to CQA Survey Portal</p>
            </div>
            
            <form action="/client-survey" method="GET">
                
                <div class="mb-3">
                    <input type="email" class="form-control" placeholder="Email or phone" required>
                </div>
                
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="Enter your password" required>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="#" class="text-decoration-none fw-semibold" style="color: #0b57d0; font-size: 0.85rem;">Forgot email?</a>
                    <button type="submit" class="btn btn-google-login shadow-sm">
                        Login
                    </button>
                </div>
                
            </form>
            
        </div>
    </div>

</body>
</html>