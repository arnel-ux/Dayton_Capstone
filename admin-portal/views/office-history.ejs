<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // New-tab auto-login guard: office sessions ride the same hand-rolled
        // admin-session cookie as admin logins, so a brand new tab that merely
        // inherited that cookie (typed the URL, duplicated the tab, opened a
        // bookmark) would otherwise land here fully "logged in" without ever
        // having submitted office credentials in THAT tab. sessionStorage is
        // scoped per tab (never copied to a freshly opened one), so it's used
        // here purely as a "did this tab actually authenticate" marker: /office-login's
        // redirect tags the very next page load with ?loggedin=1, which this
        // script converts into the marker before the URL is cleaned up. Same
        // pattern as /office-approvals, the admin dashboard (layout/header.ejs)
        // and /client-survey.
        // Note: this is a client-side UX guard, not a security boundary — the
        // page markup briefly reaches the browser before this (first) script
        // redirects it away, so it doesn't stop someone with devtools/view-source
        // open on that same already-logged-in machine.
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.has('loggedin')) {
                    sessionStorage.setItem('cqa_office_tab_ok', '1');
                    params.delete('loggedin');
                    var cleanedSearch = params.toString();
                    var cleanedUrl = window.location.pathname + (cleanedSearch ? '?' + cleanedSearch : '') + window.location.hash;
                    window.history.replaceState({}, '', cleanedUrl);
                } else if (sessionStorage.getItem('cqa_office_tab_ok') !== '1') {
                    window.location.replace('/office-login?error=' + encodeURIComponent('Please log in to continue.'));
                }
            } catch (e) { /* sessionStorage unavailable (privacy mode, etc.) — fail open */ }
        })();
    </script>
    <%- include('layout/header', { forceLightMode: true }) %>
    <%
        // Office names are sometimes stored as "Full Name (CODE)". Pull the
        // parenthesized short code, when present, for a small office badge.
        // Falls back to nothing (no badge) when the office name has no code.
        function extractOfficeCode(name) {
            if (!name) return null;
            var match = String(name).match(/\(([^)]+)\)\s*$/);
            return match ? match[1].trim() : null;
        }

        var officeCode = extractOfficeCode(typeof officeName !== 'undefined' ? officeName : null);
    %>
    <style>
        /* ==========================================================
           BASE / LAYOUT
           ========================================================== */
        * { box-sizing: border-box; }
        html, body {
            overflow-x: hidden;
        }
        body {
            background: #f0f3f9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            color: #0f172a;
        }

        /* ==========================================================
           SIDEBAR (off-canvas, toggled from the topbar's upper-left
           hamburger button — Pending / History live on separate pages,
           navigated between via this sidebar)
           ========================================================== */
        .sidebar-toggle-btn {
            width: 40px;
            height: 40px;
            flex: 0 0 auto;
            border-radius: 10px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.22);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            cursor: pointer;
            transition: background 0.15s ease;
        }
        .sidebar-toggle-btn:hover { background: rgba(255,255,255,0.22); }
        .sidebar-toggle-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

        .sidebar-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.45);
            z-index: 29;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        .sidebar-backdrop.show { opacity: 1; visibility: visible; }

        .office-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 270px;
            max-width: 82vw;
            background: #ffffff;
            z-index: 30;
            box-shadow: 10px 0 32px -12px rgba(15, 23, 42, 0.35);
            transform: translateX(-100%);
            transition: transform 0.25s ease;
            display: flex;
            flex-direction: column;
        }
        .office-sidebar.show { transform: translateX(0); }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding: 1.15rem 1.25rem;
            background: linear-gradient(135deg, #1e1738, #2d1f57 55%, #241a44);
            color: #ffffff;
            flex: 0 0 auto;
        }
        .sidebar-header .sidebar-title {
            font-weight: 800;
            font-size: 0.92rem;
            letter-spacing: 0.2px;
        }
        .sidebar-close-btn {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.25);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex: 0 0 auto;
        }
        .sidebar-close-btn:hover { background: rgba(255,255,255,0.24); }
        .sidebar-close-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

        .sidebar-nav {
            padding: 0.9rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.75rem 0.9rem;
            border-radius: 10px;
            color: #475569;
            font-weight: 700;
            font-size: 0.87rem;
            text-decoration: none;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .sidebar-link i:first-child { width: 18px; text-align: center; color: #7c6bb0; flex: 0 0 auto; }
        .sidebar-link:hover { background: #f4f4fd; color: #2d1f57; }
        .sidebar-link.active { background: linear-gradient(135deg, #2d1f57, #4b3a86); color: #fff; }
        .sidebar-link.active i:first-child { color: #fff; }
        .sidebar-count {
            margin-left: auto;
            font-size: 0.66rem;
            font-weight: 700;
            background: #eef2ff;
            color: #3730a3;
            padding: 0.1rem 0.55rem;
            border-radius: 50px;
            flex: 0 0 auto;
        }
        .sidebar-link.active .sidebar-count { background: rgba(255,255,255,0.25); color: #fff; }

        /* ==========================================================
           TOPBAR
           ========================================================== */
        .topbar {
            background: linear-gradient(135deg, #1e1738, #2d1f57 55%, #241a44);
            color: #ffffff;
            padding: 0.9rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: 0 4px 18px -6px rgba(0,0,0,0.35);
            position: sticky;
            top: 0;
            z-index: 20;
        }
        .topbar-left {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            min-width: 0;
        }
        .topbar-icon {
            width: 42px;
            height: 42px;
            flex: 0 0 auto;
            margin-top: 0.1rem;
            border-radius: 12px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.18);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
        }
        .topbar-titles { min-width: 0; }
        .topbar h1 {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin: 0 0 0.2rem;
            line-height: 1.2;
            color: #b7aee6;
        }
        .topbar .sub {
            font-size: 0.98rem;
            font-weight: 700;
            color: #ffffff;
            line-height: 1.3;
            overflow-wrap: break-word;
            max-width: 100%;
        }
        .office-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            color: #d9d4f2;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 0.18rem 0.6rem;
            border-radius: 50px;
            margin-top: 0.35rem;
            white-space: nowrap;
        }
        .office-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #a78bfa;
            flex: 0 0 auto;
        }
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex: 0 0 auto;
        }
        .portal-status {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.72rem;
            font-weight: 600;
            color: #d9d4f2;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.16);
            padding: 0.35rem 0.7rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .portal-status .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.25);
        }

        /* "Viewing offline" pill — same amber style, font-size and padding
           as index.ejs / login.ejs / office-approvals.ejs for a consistent
           look across the whole system. Its own centered row under the
           topbar, not squeezed next to Logout/portal-status, so it never
           overlaps or covers those on narrow screens. */
        .offline-pill-row { text-align: center; background: #f0f3f9; }
        .offline-pill-row:has(.offline-pill.is-visible) { padding: 0.6rem 1rem 0; }
        .offline-pill {
            display: none;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .offline-pill.is-visible { display: inline-flex; }
        .offline-pill .dot {
            width: 7px; height: 7px; border-radius: 50%; background: #d97706; flex: none;
            animation: offlinePulse 1.6s ease-in-out infinite;
        }
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
        .btn-logout {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.35);
            color: #fff;
            border-radius: 50px;
            padding: 0.45rem 1.1rem;
            font-size: 0.82rem;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            transition: background 0.15s ease, transform 0.15s ease;
        }
        .btn-logout:hover { background: rgba(255,255,255,0.24); color: #fff; transform: translateY(-1px); }
        .btn-logout:focus-visible {
            outline: 2px solid #fff;
            outline-offset: 2px;
        }

        /* ==========================================================
           PAGE HEADER
           ========================================================== */
        .content-wrap {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 1.25rem 3rem;
        }
        .page-header {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.75rem 0 1.25rem;
        }
        .page-header h2 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1a1436;
            margin: 0 0 0.3rem;
        }
        .page-header p {
            font-size: 0.9rem;
            color: #64748b;
            margin: 0;
            max-width: 46ch;
        }
        .pending-badge {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #ffffff;
            border: 1px solid #e5e7f0;
            border-radius: 14px;
            padding: 0.7rem 1.1rem;
            box-shadow: 0 6px 18px -10px rgba(30, 23, 56, 0.25);
            flex: 0 0 auto;
        }
        .pending-badge .icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2d1f57, #4b3a86);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex: 0 0 auto;
        }
        .pending-badge .num {
            font-size: 1.25rem;
            font-weight: 800;
            color: #1a1436;
            line-height: 1.1;
        }
        .pending-badge .label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #94a3b8;
        }

        /* ==========================================================
           HISTORY TABLE
           ========================================================== */
        .approvals-table-card {
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            box-shadow: 0 6px 20px -12px rgba(15, 23, 42, 0.18);
            overflow: hidden;
        }
        .approvals-table-scroll {
            overflow-x: auto;
        }
        .approvals-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 920px;
        }
        .approvals-table col.col-respondent { width: 18%; }
        .approvals-table col.col-service { width: 20%; }
        .approvals-table col.col-status { width: 13%; }
        .approvals-table col.col-reason { width: 22%; }
        .approvals-table col.col-email { width: 17%; }
        .approvals-table col.col-reviewed { width: 15%; }

        .approvals-table thead th {
            background: #f8f9fc;
            border-bottom: 1px solid #e9ebf3;
            font-size: 0.66rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #94a3b8;
            padding: 0.8rem 1rem;
            text-align: left;
            white-space: nowrap;
        }
        .approvals-table thead th i { color: #7c6bb0; margin-right: 0.4rem; }
        .approvals-table tbody tr.data-row {
            border-bottom: 1px solid #f0f1f7;
            animation: rowIn 0.3s ease both;
        }
        .approvals-table tbody tr.data-row:nth-child(4n+1) { background: #fbfbfe; }
        .approvals-table tbody tr.data-row:hover { background: #f4f4fd; }
        .approvals-table tbody tr.data-row:last-child { border-bottom: none; }
        @keyframes rowIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @media (prefers-reduced-motion: reduce) {
            .approvals-table tbody tr.data-row { animation: none; }
        }
        .approvals-table td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            font-size: 0.84rem;
            color: #1a1436;
            line-height: 1.35;
        }
        .respondent-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; min-width: 0; }
        .cell-label-inline {
            font-size: 0.64rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #94a3b8;
        }
        .toggle-chevron { display: none; }
        .respondent-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: #14102b;
            margin: 0;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .cell-value {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            cursor: default;
        }
        .cell-value.wrap-value {
            white-space: normal;
            overflow-wrap: break-word;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .cell-sub {
            font-size: 0.76rem;
            color: #94a3b8;
            font-weight: 600;
            white-space: nowrap;
            margin-top: 0.15rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .status-badge.approved { color: #166534; background: #dcfce7; border: 1px solid #bbf7d0; }
        .status-badge.declined { color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; }
        .status-badge i { font-size: 0.58rem; }
        .decline-reason-note {
            font-size: 0.76rem;
            color: #94a3b8;
            font-style: italic;
            margin-top: 0.3rem;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* ==========================================================
           EMPTY STATE
           ========================================================== */
        .empty-state {
            text-align: center;
            padding: 3.5rem 1.5rem;
            color: #64748b;
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            margin-top: 1rem;
        }
        .empty-state .icon-wrap {
            width: 68px;
            height: 68px;
            margin: 0 auto 1.1rem;
            border-radius: 50%;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state .icon-wrap i { font-size: 1.8rem; color: #4338ca; }
        .empty-state h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1a1436;
            margin-bottom: 0.4rem;
        }
        .empty-state p {
            font-size: 0.88rem;
            margin: 0 auto 1rem;
            max-width: 40ch;
        }

        /* ==========================================================
           RESPONSIVE
           ========================================================== */
        @media (max-width: 767px) {
            .topbar { padding: 0.75rem 1rem; align-items: flex-start; }
            .topbar-left { flex: 1 1 auto; min-width: 0; }
            .topbar h1 { font-size: 0.66rem; }
            .topbar .sub { font-size: 0.86rem; }
            .topbar-right { flex: 0 0 auto; padding-top: 0.1rem; gap: 0.5rem; }
            .portal-status { display: none; }
            .btn-logout { padding: 0.4rem 0.85rem; font-size: 0.78rem; }
            .content-wrap { padding: 0 0.85rem 2.5rem; }
            .page-header { padding-top: 1.25rem; gap: 0.85rem; }
            .page-header h2 { font-size: 1.3rem; }
            .page-header p { font-size: 0.84rem; max-width: 100%; }
            .pending-badge { width: 100%; }

            /* Card-style responsive table — same pattern as /office-approvals:
               each row reflows into its own bordered card with the header
               label shown inline above each value (via the td's data-label). */
            .approvals-table-scroll { overflow-x: visible; }
            .approvals-table { min-width: 0; table-layout: auto; }
            .approvals-table thead { display: none; }
            .approvals-table, .approvals-table tbody,
            .approvals-table tr, .approvals-table td { display: block; width: 100%; }
            .approvals-table tbody tr.data-row {
                border: 1px solid #e9ebf3;
                border-radius: 14px;
                padding: 0.9rem 1rem;
                margin: 0.85rem;
                background: #ffffff;
            }
            .approvals-table td {
                padding: 0.55rem 0;
                border-bottom: 1px solid #f0f1f7;
                white-space: normal;
            }
            .approvals-table td:last-child { border-bottom: none; padding-bottom: 0; }
            .approvals-table td:first-child { padding-top: 0; }
            .approvals-table td[data-label]::before {
                content: attr(data-label);
                display: block;
                font-size: 0.64rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.45px;
                color: #94a3b8;
                margin-bottom: 0.3rem;
            }

            .approvals-table .cell-value,
            .approvals-table .respondent-name {
                white-space: normal;
                overflow: visible;
                text-overflow: unset;
                overflow-wrap: break-word;
            }
            .approvals-table .cell-value.wrap-value { -webkit-line-clamp: unset; }

            /* --- History list accordion ---------------------------------
               Same collapsed-by-default pattern as the Pending list: each
               card shows only Respondent + Google Account (side by side);
               tapping it expands the same card to reveal Service Availed,
               Status, Decline Reason and Reviewed date. Keeps a long
               history from turning into a wall of scrolling. */
            .history-table.approvals-table tbody tr.data-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                column-gap: 0.85rem;
            }
            .history-table .col-order-respondent { grid-column: 1; order: 1; min-width: 0; }
            .history-table .col-order-email { grid-column: 2; order: 2; min-width: 0; }
            .history-table .col-order-service { grid-column: 1 / -1; order: 3; }
            .history-table .col-order-status { grid-column: 1 / -1; order: 4; }
            .history-table .col-order-reason { grid-column: 1 / -1; order: 5; }
            .history-table .col-order-reviewed { grid-column: 1 / -1; order: 6; }

            .approvals-table td.collapsible-detail { display: none; }
            .approvals-table tr.data-row.expanded td.collapsible-detail { display: block; }

            .row-summary-toggle { cursor: pointer; }
            /* Respondent's and Google Account's own auto-generated labels
               are replaced by explicit ones (Google Account's paired with
               the chevron on the same line, flex row — not absolute
               positioning, which is fragile and didn't reliably render). */
            .history-table td.col-order-respondent::before { display: none; }
            .history-table td.col-order-email::before { display: none; }
            .email-header-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                width: 100%;
            }
            .toggle-chevron {
                display: inline-block;
                flex: 0 0 auto;
                color: #94a3b8;
                font-size: 0.8rem;
                transition: transform 0.2s ease;
            }
            tr.data-row.expanded .toggle-chevron { transform: rotate(180deg); color: #4b3a86; }

            .history-table .col-order-respondent,
            .history-table .col-order-email {
                border-bottom: none !important;
                padding-top: 0 !important;
                padding-bottom: 0.3rem !important;
            }
            .history-table .col-order-email .cell-value {
                font-size: 0.88rem;
                color: #64748b;
                font-weight: 600;
            }
            .history-table tr.data-row.expanded .col-order-respondent,
            .history-table tr.data-row.expanded .col-order-email {
                border-bottom: 1px solid #f0f1f7 !important;
                padding-bottom: 0.55rem !important;
                margin-bottom: 0.3rem;
            }
        }

        @media (max-width: 420px) {
            .topbar-icon { width: 36px; height: 36px; font-size: 0.9rem; }
        }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="topbar-left">
            <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle sidebar menu" aria-expanded="false" aria-controls="officeSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-icon"><i class="fas fa-clipboard-check"></i></div>
            <div class="topbar-titles">
                <h1>Survey Approvals</h1>
                <div class="sub" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= officeName %>"><%= officeName %></div>
                <% if (officeCode) { %>
                    <span class="office-badge"><span class="dot"></span> OFFICE: <%= officeCode %></span>
                <% } %>
            </div>
        </div>
        <div class="topbar-right">
            <span class="portal-status"><span class="dot"></span> Approval Portal</span>
            <a href="/office-logout" class="btn-logout" id="officeLogoutBtn"><i class="fas fa-sign-out-alt me-1"></i> Logout</a>
        </div>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <aside class="office-sidebar" id="officeSidebar">
        <div class="sidebar-header">
            <span class="sidebar-title">Menu</span>
            <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close sidebar menu">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="/office-approvals" class="sidebar-link">
                <i class="fas fa-hourglass-half"></i> Pending
                <span class="sidebar-count"><%= pendingCount || 0 %></span>
            </a>
            <a href="/office-approvals/history" class="sidebar-link active">
                <i class="fas fa-clock-rotate-left"></i> History
                <span class="sidebar-count"><%= history ? history.length : 0 %></span>
            </a>
        </nav>
    </aside>

    <div class="offline-pill-row">
        <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection — showing the last data loaded while you were connected.">
            <span class="dot"></span><span class="label">Viewing Offline</span>
        </span>
    </div>

    <div class="content-wrap">

        <div class="page-header">
            <div>
                <h2>Approval History</h2>
                <p>Submissions you have approved or declined for your office.</p>
            </div>
            <div class="pending-badge">
                <div class="icon"><i class="fas fa-clock-rotate-left"></i></div>
                <div>
                    <div class="num"><%= history ? history.length : 0 %></div>
                    <div class="label">Total Records</div>
                </div>
            </div>
        </div>

        <% if (!history || history.length === 0) { %>
            <div class="empty-state">
                <div class="icon-wrap"><i class="fas fa-clock-rotate-left"></i></div>
                <h3>No approval history yet.</h3>
                <p>Submissions you approve or decline for your office will be listed here for reference.</p>
            </div>
        <% } else { %>
            <div class="approvals-table-card">
                <div class="approvals-table-scroll">
                    <table class="approvals-table history-table">
                        <colgroup>
                            <col class="col-respondent"><col class="col-service"><col class="col-status">
                            <col class="col-reason"><col class="col-email"><col class="col-reviewed">
                        </colgroup>
                        <thead>
                            <tr>
                                <th><i class="fas fa-user"></i>Respondent</th>
                                <th><i class="fas fa-clipboard-list"></i>Service Availed</th>
                                <th><i class="fas fa-flag"></i>Status</th>
                                <th><i class="fas fa-comment-dots"></i>Decline Reason</th>
                                <th><i class="fas fa-envelope"></i>Google Account</th>
                                <th><i class="fas fa-calendar-check"></i>Reviewed</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% history.forEach(function(sub) { %>
                                <tr class="data-row">
                                    <td data-label="Respondent" class="col-order-respondent">
                                        <div class="respondent-cell row-summary-toggle" role="button" tabindex="0" aria-expanded="false">
                                            <span class="cell-label-inline">Respondent</span>
                                            <div class="respondent-name" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.respondentName %>">
                                                <%= sub.respondentName %>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="Service Availed" class="collapsible-detail col-order-service">
                                        <div class="cell-value wrap-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.serviceAvailed || 'Not specified' %>">
                                            <%= sub.serviceAvailed || 'Not specified' %>
                                        </div>
                                    </td>
                                    <td data-label="Status" class="collapsible-detail col-order-status">
                                        <% if (sub.status === 'approved') { %>
                                            <span class="status-badge approved"><i class="fas fa-check-circle"></i> Approved</span>
                                        <% } else { %>
                                            <span class="status-badge declined"><i class="fas fa-times-circle"></i> Declined</span>
                                        <% } %>
                                    </td>
                                    <td data-label="Decline Reason" class="collapsible-detail col-order-reason">
                                        <% if (sub.status === 'declined' && sub.declineReason) { %>
                                            <div class="decline-reason-note" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.declineReason %>">
                                                <%= sub.declineReason %>
                                            </div>
                                        <% } else { %>
                                            <span class="cell-sub">—</span>
                                        <% } %>
                                    </td>
                                    <td data-label="Google Account" class="row-summary-toggle col-order-email" role="button" tabindex="0" aria-expanded="false">
                                        <div class="email-header-row">
                                            <span class="cell-label-inline">Google Account</span>
                                            <i class="fas fa-chevron-down toggle-chevron" aria-hidden="true"></i>
                                        </div>
                                        <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.googleEmail %>">
                                            <%= sub.googleEmail %>
                                        </div>
                                    </td>
                                    <td data-label="Reviewed" class="collapsible-detail col-order-reviewed">
                                        <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top"
                                             title="<%= sub.reviewedAt ? new Date(sub.reviewedAt).toLocaleString('en-PH', { dateStyle: 'full', timeStyle: 'medium' }) : '' %>">
                                            <%= sub.reviewedAt ? new Date(sub.reviewedAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) : '—' %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('layout/footer') %>
    <script>
        (function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el, { trigger: 'hover focus' });
            });

            // "Viewing offline" pill — same pattern as index.ejs/login.ejs.
            function updateOfflineIndicator() {
                var pill = document.getElementById('offlineIndicator');
                if (pill) pill.classList.toggle('is-visible', !navigator.onLine);
            }
            window.addEventListener('online', updateOfflineIndicator);
            window.addEventListener('offline', updateOfflineIndicator);
            updateOfflineIndicator();

            // Sidebar: off-canvas panel toggled from the topbar's upper-left
            // hamburger button — same behavior as /office-approvals.
            var sidebar = document.getElementById('officeSidebar');
            var sidebarBackdrop = document.getElementById('sidebarBackdrop');
            var sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            var sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
            function openSidebar() {
                if (!sidebar) return;
                sidebar.classList.add('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.add('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'true');
            }
            function closeSidebar() {
                if (!sidebar) return;
                sidebar.classList.remove('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.remove('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'false');
            }
            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener('click', function () {
                    if (sidebar && sidebar.classList.contains('show')) closeSidebar();
                    else openSidebar();
                });
            }
            if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
            if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Mobile history-list accordion: same collapsed-by-default
            // pattern as the Pending list — a card starts showing only
            // Respondent + Google Account; tapping it expands the same
            // card in place to reveal Service Availed, Status, Decline
            // Reason and Reviewed date. Purely a CSS class toggle — the
            // ".collapsible-detail" cells are only actually hidden inside
            // the mobile media query, so this is a no-op on desktop.
            document.querySelectorAll('.row-summary-toggle').forEach(function (el) {
                function toggleRow() {
                    var row = el.closest('tr.data-row');
                    if (!row) return;
                    var expanded = !row.classList.contains('expanded');
                    row.classList.toggle('expanded', expanded);
                    row.querySelectorAll('.row-summary-toggle').forEach(function (t) {
                        t.setAttribute('aria-expanded', String(expanded));
                    });
                }
                el.addEventListener('click', toggleRow);
                el.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRow(); }
                });
            });

            var logoutBtn = document.getElementById('officeLogoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var href = logoutBtn.getAttribute('href');
                    AppAlert.confirm('Are you sure you want to logout?', { title: 'Logout?', confirmText: 'Yes, logout', danger: false })
                        .then(function (confirmed) {
                            if (confirmed) window.location.href = href;
                        });
                });
            }
        })();
    </script>
</body>
</html>
