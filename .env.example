# Copy to .env (same folder as docker-compose.yml) and fill in the values.
# .env is gitignored — never commit it; this repository is public.

# --- Ports / environment ---
APP_PORT=3000
# "production" makes session cookies HTTPS-only: serve the site over HTTPS
# (proxy sending X-Forwarded-Proto). Use "development" only for plain-HTTP testing.
NODE_ENV=production
TRUST_PROXY=loopback, linklocal, uniquelocal

# --- Database (created automatically by the db container) ---
DB_ROOT_PASSWORD=
DB_NAME=cqa_db
DB_USER=cqa
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- Session ---
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# --- Google OAuth (client login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the new public URL and registered in Google Cloud Console, e.g.
# https://cqa.cspc.edu.ph/auth/google/callback
GOOGLE_CALLBACK_URL=

# --- Mail (leave blank to disable receipt emails) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- reCAPTCHA (keys must allow the new domain) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- AI comment analysis (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
