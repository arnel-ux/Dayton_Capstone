<%- include('layout/footer') %>

<script>
    // Small wrapper so every call site doesn't need its own typeof-check —
    // falls back to a plain alert() if AppAlert.js failed to load.
    function notify(kind, message) {
        if (typeof AppAlert !== 'undefined') {
            AppAlert[kind](message);
        } else {
            alert(message);
        }
    }

    // ---------------------------------------------------------------------
    // LOAD — the server already pre-fills every field's `value`/textarea
    // content straight from landing-data.json on page render (see
    // content-management route in server.js), so a normal page load needs no
    // JS here at all. This function exists for the "Discard" button: it
    // re-fetches the last-SAVED state and snaps the form back to it,
    // discarding whatever the admin typed but didn't submit.
    //
    // IMPORTANT: only <input>/<textarea> elements carry `data-field` — the
    // upload-zone <div>s use `data-upload-field` instead, specifically so
    // they're never mistaken for a real form value here (a <div> has no
    // `.value`) or in submitContentForm()/uploadZoneFile() below.
    // ---------------------------------------------------------------------
    function loadContent() {
        fetch('/api/content')
            .then(res => res.json())
            .then(data => {
                if (!data.success) throw new Error(data.message || 'Failed to load content.');
                const content = data.content;

                document.querySelectorAll('input[data-field], textarea[data-field]').forEach(el => {
                    const form = el.closest('form[data-section]');
                    if (!form) return;
                    const section = form.getAttribute('data-section');
                    const field = el.getAttribute('data-field');
                    const value = content[section] && content[section][field];
                    if (value !== undefined) el.value = value;
                });

                document.querySelectorAll('[data-upload-field]').forEach(zone => {
                    const section = zone.getAttribute('data-section');
                    const field = zone.getAttribute('data-upload-field');
                    const value = content[section] && content[section][field];
                    const img = zone.querySelector('.cm-upload-preview');
                    if (img && value) {
                        img.src = value;
                        img.classList.remove('d-none');
                    }
                });
            })
            .catch(err => {
                console.error('Error loading landing page content:', err);
                notify('error', 'Could not reload saved content.');
            });
    }

    // ---------------------------------------------------------------------
    // SAVE — called from each form's onsubmit="return submitContentForm(...)"
    // ---------------------------------------------------------------------
    function submitContentForm(event, form) {
        event.preventDefault();
        const section = form.getAttribute('data-section');
        const payload = {};
        form.querySelectorAll('input[data-field], textarea[data-field]').forEach(el => {
            payload[el.getAttribute('data-field')] = el.value;
        });

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Saving…';

        fetch(`/api/content/${section}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) throw new Error(data.message || 'Could not save changes.');
                notify('success', 'Changes saved! The landing page is now updated.');
            })
            .catch(err => {
                console.error(`Error saving "${section}":`, err);
                notify('error', err.message || 'Could not save changes. Please try again.');
            })
            .finally(() => {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            });

        return false;
    }

    // ---------------------------------------------------------------------
    // UPLOAD — a zone's own hidden <input type="file"> is used for both the
    // click-to-browse and the drag-and-drop path, so there is exactly one
    // upload code path regardless of how the file was chosen.
    // ---------------------------------------------------------------------
    function uploadZoneFile(zone, file) {
        const section = zone.getAttribute('data-section');
        const field = zone.getAttribute('data-upload-field');
        if (!file.type.startsWith('image/')) {
            return notify('error', 'Please choose an image file (PNG, JPG, WebP, or SVG).');
        }

        const icon = zone.querySelector('.cm-upload-icon');
        const originalIconClass = icon.className;
        icon.className = 'fas fa-spinner fa-spin cm-upload-icon';

        const formData = new FormData();
        formData.append('image', file);

        fetch(`/api/content/${section}/upload/${field}`, { method: 'POST', body: formData })
            .then(res => res.json())
            .then(data => {
                if (!data.success) throw new Error(data.message || 'Upload failed.');

                const img = zone.querySelector('.cm-upload-preview');
                if (img) {
                    img.src = data.url;
                    img.classList.remove('d-none');
                }

                // Keep the "Or paste an image URL" text input (same `data-field`
                // name as this zone's `data-upload-field`, in the same form) in
                // sync, so Save Changes submits the freshly uploaded URL even if
                // the admin never touches that text box.
                const form = zone.closest('form');
                const urlInput = form && form.querySelector(`input[data-field="${field}"]`);
                if (urlInput) urlInput.value = data.url;

                notify('success', 'Image uploaded and saved.');
            })
            .catch(err => {
                console.error('Error uploading image:', err);
                notify('error', err.message || 'Could not upload image. Please try again.');
            })
            .finally(() => {
                icon.className = originalIconClass;
            });
    }

    document.addEventListener('DOMContentLoaded', () => {
        // NOTE: loadContent() is intentionally NOT called here. Every field's
        // value is already rendered server-side from landing-data.json (see
        // the value attributes bound to landingContent fields above), so it's
        // already correct and fresh the instant the page loads. loadContent()
        // is kept only for the "Discard" buttons below, which need to re-pull
        // the last-saved state after the admin has typed unsaved edits.

        // --- Tab switching ---
        const navLinks = document.querySelectorAll('.cm-nav-link');
        const sections = document.querySelectorAll('.cm-content-section');

        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                navLinks.forEach(l => l.classList.remove('active'));
                sections.forEach(s => s.classList.remove('active'));

                link.classList.add('active');
                const targetId = link.getAttribute('data-target');
                document.getElementById(targetId).classList.add('active');
            });
        });

        // --- Discard buttons: reload the saved values, dropping unsaved edits ---
        document.querySelectorAll('.cm-form-actions .btn-light').forEach(btn => {
            btn.addEventListener('click', loadContent);
        });

        // --- Drag-and-drop / click-to-browse image upload ---
        const uploadZones = document.querySelectorAll('.cm-upload-zone');
        uploadZones.forEach(zone => {
            const fileInput = zone.querySelector('input[type="file"]');

            zone.addEventListener('dragover', (e) => {
                e.preventDefault();
                zone.classList.add('dragover');
            });
            zone.addEventListener('dragleave', () => {
                zone.classList.remove('dragover');
            });
            zone.addEventListener('drop', (e) => {
                e.preventDefault();
                zone.classList.remove('dragover');
                if (e.dataTransfer.files && e.dataTransfer.files[0]) {
                    uploadZoneFile(zone, e.dataTransfer.files[0]);
                }
            });
            zone.addEventListener('click', () => fileInput.click());
            fileInput.addEventListener('change', () => {
                if (fileInput.files && fileInput.files[0]) {
                    uploadZoneFile(zone, fileInput.files[0]);
                }
                fileInput.value = ''; // allow re-selecting the same file later
            });
        });
    });
</script>
</body>
