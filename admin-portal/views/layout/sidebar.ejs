<%
    // currentPath is set globally in server.js via res.locals.currentPath
    const _path = typeof currentPath !== 'undefined' ? currentPath : '';
    const isClusterPage = _path.startsWith('/cluster');
    const clusterLinks = [
        { href: '/cluster/office-of-the-president', icon: 'fa-building', label: 'Office of the President' },
        { href: '/cluster/admin-finance', icon: 'fa-money-check-alt', label: 'Admin & Finance' },
        { href: '/cluster/research-innovation', icon: 'fa-lightbulb', label: 'Research & Innovation' },
        { href: '/cluster/academic', icon: 'fa-graduation-cap', label: 'Academic Cluster' }
    ];
    const mainLinks = [
        { href: '/dashboard', icon: 'fa-th-large', label: 'Dashboard' },
        { href: '/profile', icon: 'fa-user-circle', label: 'Profile' },
        { href: '/password', icon: 'fa-key', label: 'Manage Password' },
        { href: '/survey', icon: 'fa-clipboard-list', label: 'Survey Management' },
        { href: '/offices', icon: 'fa-building', label: 'Manage Offices' },
        { href: '/report', icon: 'fa-file-export', label: 'Generate Report' }
    ];
%>
<nav id="sidebar">
    <div class="sidebar-header d-flex flex-column align-items-center text-center pt-4 pb-3 border-bottom border-secondary">
        <img src="https://cspc.edu.ph/wp-content/uploads/2022/03/Camarines_Sur_Polytechnic_Colleges_Logo.png" class="sidebar-logo mb-2 shadow-sm">
        <div>
            <h4 class="m-0 fw-bold text-white">CQA PORTAL</h4>
            <small class="sidebar-subtitle">Admin System</small>
        </div>
    </div>

    <ul class="list-unstyled components mt-3">
        <li class="nav-item">
            <a href="/dashboard" class="d-flex align-items-center<%= _path === '/dashboard' ? ' active' : '' %>">
                <i class="fas fa-th-large me-3"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="#statisticsSubmenu" data-bs-toggle="collapse" aria-expanded="<%= isClusterPage ? 'true' : 'false' %>" class="dropdown-toggle d-flex align-items-center<%= isClusterPage ? ' active' : '' %>">
                <i class="fas fa-chart-pie me-3"></i>
                <span>All Cluster</span>
                <i class="fas fa-chevron-down ms-auto rotate-icon"></i>
            </a>
            <ul class="collapse list-unstyled submenu-bg<%= isClusterPage ? ' show' : '' %>" id="statisticsSubmenu">
                <% clusterLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>" class="d-flex align-items-center<%= _path === link.href ? ' active' : '' %>">
                            <i class="fas <%= link.icon %> submenu-icon"></i>
                            <span><%= link.label %></span>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </li>

        <% mainLinks.slice(1).forEach(link => { %>
            <li class="nav-item">
                <a href="<%= link.href %>" class="d-flex align-items-center<%= _path === link.href ? ' active' : '' %>">
                    <i class="fas <%= link.icon %> me-3"></i> <span><%= link.label %></span>
                </a>
            </li>
        <% }) %>
    </ul>
</nav>

<style>
    #sidebar ul li a {
        padding: 12px 20px;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.92rem;
        font-weight: 500;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        border-left: 3px solid transparent;
    }

    .sidebar-logo {
        width: 64px;
        height: 64px;
        background-color: #fff;
        border-radius: 50%;
        padding: 4px;
        object-fit: contain;
    }

    .sidebar-subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .rotate-icon {
        font-size: 0.75rem;
        transition: transform 0.3s ease;
    }
    #sidebar ul li a[aria-expanded="true"] .rotate-icon {
        transform: rotate(180deg);
    }

    .submenu-bg {
        background: rgba(0, 0, 0, 0.18);
    }

    #statisticsSubmenu li a {
        padding: 9px 12px 9px 48px !important;
        font-size: 0.85rem;
        background: transparent;
        border-left: none;
    }

    .submenu-icon {
        width: 18px;
        margin-right: 12px;
        text-align: center;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
    }

    .nav-item i {
        width: 18px;
        text-align: center;
        font-size: 0.9rem;
    }

    #sidebar ul li a:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
    }

    /* Active state: current page/cluster is clearly highlighted, not just on hover */
    #sidebar ul li a.active {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        border-left-color: #818cf8;
        font-weight: 600;
    }
    #statisticsSubmenu li a.active {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }
</style>
