        let activeClusterIndex = 0;

        function renderClusterTabs() {
            const tabsWrap = document.getElementById('clusterTabs');
            tabsWrap.innerHTML = serviceClusters.map((cluster, i) => `
                <button type="button" class="cluster-tab-btn${i === activeClusterIndex ? ' active' : ''}" data-index="${i}">
                    <i class="fas ${cluster.icon}"></i> ${cluster.label}
                </button>
            `).join('');

            tabsWrap.querySelectorAll('.cluster-tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    activeClusterIndex = parseInt(btn.dataset.index, 10);
                    tabsWrap.querySelectorAll('.cluster-tab-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    renderServicesAccordion();
                });
            });
        }

        // Renders the office and service levels for whichever cluster tab is active.
        function renderServicesAccordion() {
            const wrap = document.getElementById('servicesAccordion');
            const cluster = serviceClusters[activeClusterIndex];

            wrap.innerHTML = cluster.offices.map(o => `
                <div class="accordion-item">
                    <button type="button" class="accordion-header" aria-expanded="false">
                        <span class="accordion-header-left">
