<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <style>
        /* ============================================================
           Mirrors login.ejs's design system (same classes, same values)
           so /login, /forgot-password, and /reset-password all read as
           one application. See login.ejs for the source of truth.
           ============================================================ */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .bg-blurred {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url('<%- heroImageUrl %>');
            background-size: cover;
            /* The CSPC monument sits in the upper half of this photo — on a
               tall mobile viewport, centering it vertically cropped the
               monument almost entirely out of frame. Anchoring to the top
               keeps it in view. */
            background-position: top center;
            background-repeat: no-repeat;
            z-index: -2;
        }

        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(180deg, rgba(37, 29, 58,0.92) 0%, rgba(37, 29, 58,0.85) 100%);
            z-index: -1;
        }

        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            max-height: 100dvh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 1rem;
            padding-top: clamp(0.6rem, 2.5vh, 1.75rem);
            padding-bottom: 5rem;
            z-index: 1;
            overflow-y: auto; /* safety fallback: scroll instead of clipping on short viewports */
        }

        @keyframes fadeSlideUp {
            0% { opacity: 0; transform: translateY(30px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .header-container {
            text-align: center;
            margin-bottom: 1.1rem;
            max-width: 800px;
            flex-shrink: 0;
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.5rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.35rem;
            letter-spacing: 0.3px;
            line-height: 1.25;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #e2e8f0;
            font-weight: 400;
            font-style: italic;
            font-size: 0.85rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.6rem;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2.2px;
            padding: 0.3rem 0.9rem;
            background: rgba(255, 204, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            backdrop-filter: blur(6px);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        @media (max-width: 600px) {
            .main-title { font-size: 1.15rem; }
            .sub-title { font-size: 0.78rem; margin-bottom: 0.5rem; }
            .portal-text { font-size: 0.65rem; }
        }

        .card-custom {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 1.75rem;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
            width: 400px;
            height: auto;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.5rem 2.25rem;
            opacity: 0;
            animation: fadeSlideUp 0.7s ease-out 0.15s forwards;
        }

        /* NOTE: the fixed 400px card (plus the wrapper's 1rem/16px side
           padding) needs >= 432px of viewport to avoid overflowing — common
           phones (375/390/393/412/414/428/430px) are all narrower than that,
           and html/body has overflow:hidden, so the card was getting clipped
           on real phones instead of shrinking. Raised from 400px to 480px so
           every common phone width is covered. */
        @media (max-width: 480px) {
            .card-custom {
                width: 92vw;
                height: auto;
                padding: 1.35rem 1.5rem;
            }

            /* ---- Touch targets + readability (mirrors login.ejs's mobile
               fixes so every auth page feels consistent) ----
               16px input font-size avoids iOS Safari's auto-zoom-on-focus —
               important here since there are TWO password fields in a row,
               so a zoom-jump on the first tap would be doubly disruptive.
               Taller input/button padding brings both to a comfortable
               >=44px tap height. */
            .input-modern .form-control {
                font-size: 16px;
                padding: 0.8rem 0.85rem 0.8rem 0;
            }
            .input-modern .input-icon { width: 2.8rem; font-size: 1rem; }
            .field-group { margin-bottom: 1rem; }
            .field-label { font-size: 0.74rem; margin-bottom: 0.4rem; }
            .field-hint { font-size: 0.74rem; margin-top: 0.4rem; }
            .btn-login { padding: 0.9rem 1rem; font-size: 0.95rem; }
            .sub-title { font-size: 0.85rem; }
            .portal-text { font-size: 0.7rem; padding: 0.35rem 1rem; }
            .verified-notice { font-size: 0.8rem; padding: 0.8rem 0.9rem; }
        }

        .card-custom .cqa-logo {
            width: 46px;
            height: auto;
        }

        .card-custom h4 {
            color: #0f172a;
            font-size: 1.05rem;
            letter-spacing: 0.2px;
        }

        .card-custom .divider-soft {
            width: 36px;
            height: 3px;
            background: #ffcc00;
            border-radius: 50px;
            margin: 0.4rem auto 0.55rem;
        }

        .field-group {
            margin-bottom: 0.75rem;
        }

        .field-label {
            display: block;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 0.3rem;
        }

        .input-modern {
            position: relative;
            display: flex;
            align-items: center;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .input-modern:focus-within {
            border-color: #251d3a;
            background: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(37, 29, 58, 0.15);
        }

        .input-modern .input-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.6rem;
            flex-shrink: 0;
            color: #94a3b8;
            font-size: 0.9rem;
            transition: color 0.2s ease;
        }

        .input-modern:focus-within .input-icon {
            color: #251d3a;
        }

        .input-modern .form-control {
            border: none;
            background: transparent;
            padding: 0.55rem 0.85rem 0.55rem 0;
            font-size: 0.88rem;
            box-shadow: none !important;
        }

        .input-modern .form-control:focus {
            outline: none;
            box-shadow: none;
        }

        .field-hint {
            font-size: 0.68rem;
            color: #94a3b8;
            margin-top: 0.3rem;
            line-height: 1.35;
        }

        .btn-login {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border: none;
            border-radius: 0.75rem;
            padding: 0.6rem 1rem;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.2px;
            color: #ffffff;
            box-shadow: 0 8px 18px -6px rgba(37, 29, 58, 0.55);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

        .btn-login:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 12px 22px -6px rgba(37, 29, 58, 0.6);
            color: #ffffff;
        }

        .btn-login:active {
            transform: translateY(0);
        }

        .btn-login:focus-visible {
            outline: 2px solid #251d3a;
            outline-offset: 2px;
        }

        .text-xsmall {
            font-size: 0.75rem;
        }

        /* Back-to-login button — floating circular icon button, centered
           at the bottom of the viewport so it reads as a proper
           mobile-friendly FAB instead of a text pill up by the header. */
        .btn-home {
            position: fixed;
            bottom: 1.25rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            font-size: 1.05rem;
            backdrop-filter: blur(6px);
            box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.45);
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-home:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            transform: translateX(-50%) translateY(-2px);
        }
        .btn-home:focus-visible {
            outline: 2px solid #ffffff;
            outline-offset: 2px;
        }

        /* One genuinely new component — login.ejs has no equivalent banner —
           sized off the same .text-xsmall/0.75rem-radius scale as everything
           else here rather than inventing an unrelated scale. */
        .verified-notice {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            border-radius: 0.75rem;
            padding: 0.7rem 0.85rem;
            font-size: 0.75rem;
            line-height: 1.5;
            margin-bottom: 0.9rem;
        }
        .verified-notice i {
            margin-top: 0.15rem;
        }
    </style>
</head>
<body>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <a href="/login" class="btn-home" title="Back to Login" aria-label="Back to Login">
        <i class="fas fa-arrow-left"></i>
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Reset Password</h2>
        </div>

        <div class="card-custom">

            <% if (mode === 'invalid') { %>
                <div class="text-center mb-2">
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                    <h4 class="fw-bold text-dark mb-0">Link Expired</h4>
                    <div class="divider-soft"></div>
                </div>
                <p class="text-muted text-xsmall text-center mb-3"><%= error %></p>
                <a href="/forgot-password" class="btn btn-login w-100">
                    <i class="fas fa-redo me-2"></i> Request a New Link
                </a>
            <% } else { %>
                <div class="text-center mb-2">
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                    <h4 class="fw-bold text-dark mb-0">Set a New Password</h4>
                    <div class="divider-soft"></div>
                    <p class="text-muted text-xsmall mb-0">For <strong><%= email %></strong></p>
                </div>

                <% if (mode === 'google') { %>
                    <div class="verified-notice">
                        <i class="fas fa-shield-check"></i>
                        <span>Verified with your real Google account — set your new password below.</span>
                    </div>
                <% } %>

                <form action="/reset-password" method="POST" id="resetForm">
                    <input type="hidden" name="mode" value="<%= mode %>">
                    <input type="hidden" name="email" value="<%= email %>">
                    <% if (mode === 'token') { %>
                        <input type="hidden" name="token" value="<%= token %>">
                    <% } %>

                    <div class="field-group">
                        <label class="field-label" for="newPasswordInput">New Password</label>
                        <div class="input-modern">
                            <span class="input-icon"><i class="fas fa-lock"></i></span>
                            <input type="password" name="password" id="newPasswordInput" class="form-control" placeholder="At least 8 characters" minlength="8" required>
                        </div>
                    </div>

                    <div class="field-group">
                        <label class="field-label" for="confirmPasswordInput">Confirm New Password</label>
                        <div class="input-modern">
                            <span class="input-icon"><i class="fas fa-lock"></i></span>
                            <input type="password" name="confirmPassword" id="confirmPasswordInput" class="form-control" placeholder="Re-enter your new password" minlength="8" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-login w-100">
                        <i class="fas fa-check-circle me-2"></i> Update Password
                    </button>
                </form>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const resetErrorMsg = new URLSearchParams(window.location.search).get('error');
        if (resetErrorMsg && '<%= mode %>' !== 'invalid') {
            AppAlert.error(resetErrorMsg, 'Could Not Reset Password');
            window.history.replaceState({}, document.title, window.location.pathname + window.location.search.replace(/[?&]error=[^&]*/, ''));
        }

        const resetFormEl = document.getElementById('resetForm');
        if (resetFormEl) {
            resetFormEl.addEventListener('submit', (e) => {
                const password = e.target.password.value;
                const confirmPassword = e.target.confirmPassword.value;
                if (password.length < 8) {
                    e.preventDefault();
                    AppAlert.warning('Password must be at least 8 characters long.', 'Password Too Short');
                    return;
                }
                if (password !== confirmPassword) {
                    e.preventDefault();
                    AppAlert.warning('The passwords you entered do not match.', 'Passwords Do Not Match');
                }
            });
        }
    </script>
</body>
</html>
