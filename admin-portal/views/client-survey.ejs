        sqd: "Paki-rate ang lahat ng Service Quality Dimensions (SQD0 hanggang SQD8) bago mag-submit."
    }
};

// Validates the fields belonging to a given stage. Returns true if the stage is complete.
function validateStage(stageNum) {
    const t = validationMessages[currentLang] || validationMessages.en;

    if (stageNum === 1) {
        const terms = document.getElementById('agreeTermsStage1');
        if (!terms || !terms.checked) {
            AppAlert.warning(t.terms);
            terms && terms.focus();
            return false;
        }
        return true;
    }

    if (stageNum === 2) {
        const requiredSelectors = [
            'select[name="client_type"]',
            'select[name="age"]',
            'input[name="survey_date"]',
            'select[name="region"]',
            'select[name="office_id"]',
            'select[name="service_availed"]'
        ];
        for (const sel of requiredSelectors) {
            const el = document.querySelector(sel);
            if (!el || !el.value || !el.value.trim()) {
                AppAlert.warning(t.profile);
                if (el) el.focus();
                return false;
            }
        }
        if (!document.querySelector('input[name="gender"]:checked')) {
            AppAlert.warning(t.profile);
            return false;
        }
        return true;
    }

    if (stageNum === 3) {
        for (const name of ['cc1', 'cc2', 'cc3']) {
            if (!document.querySelector(`input[name="${name}"]:checked`)) {
                AppAlert.warning(t.cc);
                return false;
            }
        }
        return true;
    }

    if (stageNum === 4) {
        for (let i = 0; i <= 8; i++) {
            if (!document.querySelector(`input[name="sqd${i}"]:checked`)) {
                AppAlert.warning(t.sqd);
                return false;
            }
        }
        return true;
    }

    return true;
}

// Navigation Function — validates the current stage before allowing forward movement
// =====================================
// SMART EDIT — Stage 5 "Edit" jumps straight to a stage; that stage's "Next"
// button then turns into "Save & Return to Review" and jumps straight back,
// bypassing whatever intermediate stages sit between them.
// =====================================
let editReturnTarget = null;

// New short label only — does NOT touch the protected i18n dictionary above/below.
const UX_LABELS = {
    en: { save_return: 'Save & Return to Review' },
    tl: { save_return: 'I-save at Bumalik sa Review' }
};

function goEditStage(stage) {
    editReturnTarget = 5;
    navigate(stage);
}

// Used by the Stage 2/3/4 "Next" buttons. Normal flow: goes to normalTarget.
// If the user got here via an Edit link from Stage 5: goes straight back to
// Stage 5 instead, and clears the flag so the button reverts to normal next time.
function goNext(normalTarget) {
    if (editReturnTarget) {
        const target = editReturnTarget;
        editReturnTarget = null;
        navigate(target);
    } else {
        navigate(normalTarget);
    }
}

function updateNextButtonLabel(stage) {
    const btnIds = { 2: 'btnNextStage2', 3: 'btnNextStage3', 4: 'btnNextStage4' };
    const btn = document.getElementById(btnIds[stage]);
    if (!btn) return;

    if (editReturnTarget) {
        const label = (UX_LABELS[currentLang] || UX_LABELS.en).save_return;
        btn.innerHTML = '<i class="bi bi-arrow-return-left me-1"></i> ' + label;
    } else {
        btn.innerHTML = '<span data-i18n="btn_next"></span>';
        const span = btn.querySelector('[data-i18n]');
        if (span && i18n[currentLang] && i18n[currentLang].btn_next) span.textContent = i18n[currentLang].btn_next;
    }
}

function navigate(stage) {
    const activePage = document.querySelector('#surveyForm .page.active');
    const currentStage = activePage ? parseInt(activePage.id.replace('stage', ''), 10) : null;

    if (currentStage && stage > currentStage) {
        if (!validateStage(currentStage)) return;
    }

    // Entering Stage 2 (Profile) is the natural "survey has started" moment —
    // request full screen here so it fires whether the user clicked
    // START SURVEY or arrived via any other path that calls navigate(2).
    if (stage === 2) enterFullscreen();

    // From Stage 2 onward the survey drops its boxed/contained card look and
    // goes edge-to-edge — sidebar tucked away — so it reads as a full-screen
    // form instead of content sitting inside a small rectangle. Stage 1
    // (Terms) keeps the centered hero-card presentation.
    const shell = document.querySelector('.app-shell');
    if (shell) shell.classList.toggle('survey-inprogress', stage >= 2);
    if (stage >= 2) setSidebarCollapsed(true);

    // Entering the Review stage — rebuild the summary from whatever is
    // currently in the form so "Edit" + coming back always reflects the latest answers.
    if (stage === 5) renderReviewSummary();

    const direction = currentStage && stage < currentStage ? 'dir-back' : 'dir-fwd';

    document.querySelectorAll('.page').forEach(page => page.classList.remove('active', 'dir-fwd', 'dir-back'));
    const targetPage = document.getElementById('stage' + stage);
    targetPage.classList.add('active', direction);

    updateProgressStepper(stage);
    updateNextButtonLabel(stage);
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

