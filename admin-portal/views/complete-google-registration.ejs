<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/offline-pill.css">
    <style>
        /* ---- Registration progress ----
           The Register tab on /login promises a two-step flow ("sign up with
           your email, then fill in the registration form"). This is step 2, so
           it says so — landing on a fresh card with no continuity was what made
           the hand-off from Google feel like a separate, unexplained page. */
        .reg-progress {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            margin-bottom: 0.85rem;
        }
        .reg-progress-step {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0.3rem 0.7rem;
            border-radius: 50px;
            font-size: var(--fs-2xs);
            font-weight: 700;
            letter-spacing: var(--tr-wide);
            line-height: 1.35;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            color: #94a3b8;
        }
        .reg-progress-step.is-done {
            background: #ecfdf5;
            border-color: #a7f3d0;
            color: #047857;
        }
        .reg-progress-step.is-current {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border-color: transparent;
            color: #ffffff;
        }
        .reg-progress-sep { color: #cbd5e1; font-size: var(--fs-2xs); }

        @media (max-width: 480px) {
            .reg-progress { gap: 0.3rem; margin-bottom: 0.7rem; }
            .reg-progress-step { font-size: 0.68rem; padding: 0.28rem 0.6rem; }
        }
        /* Same "short viewport OR phone" pairing as /css/auth.css. This card is
           the tallest of the auth set — two read-only fields, two password
           fields and the progress chips — so it needs the last few pixels
           trimmed here to clear a 360x740 phone without scrolling. */
        @media (max-height: 900px), (max-width: 480px) {
            .reg-progress { margin-bottom: 0.5rem; }
            .reg-progress-step { font-size: 0.66rem; padding: 0.25rem 0.55rem; }
            /* The "you'll use this password next time" footnote — kept, but it
               does not need a full 1rem of air above it on a phone. */
            #completeRegistrationForm p.text-xsmall { margin-top: 0.55rem !important; font-size: 0.7rem; }
        }

        /* Tightest sizes: the footnote goes. It restates what the Register tab
           on /login already said before the user got here, and it is the only
           block on this card that is not a field, a label or a button. */
        @media (max-height: 680px), (max-width: 360px) {
            #completeRegistrationForm p.text-xsmall { display: none; }
            .reg-progress { margin-bottom: 0.4rem; }
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/alerts.css">
</head>
<body>

    <div class="bg-blurred" style="--auth-hero-image: url('<%- heroImageUrl %>')"></div>
    <div class="bg-overlay"></div>

    <a href="/login" class="btn-home" title="Back to Login" aria-label="Back to Login">
        <i class="fas fa-arrow-left"></i>
    </a>

    <div class="login-wrapper">

        <!-- Same floating chip, same position in the column, as /login and
             /client-login. These pages exist to submit
             a form to the server, so being offline on one of them means the
             submit cannot work — and they were the three that said nothing
             about it, leaving the only feedback a failed submit. Inside
             .login-wrapper, because auth.css keeps the hero clear of the chip
             with :has(), which only looks at descendants. -->
        <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection — finishing your registration needs an internet connection.">
            <span class="dot"></span><span class="label">Viewing Offline</span>
        </span>

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Finish Registration</h2>
        </div>

        <!-- The gap between the heading and the card. An element rather than a
             margin because it has to GROW into spare space and STOP at a cap —
             see .auth-gap in /css/auth.css for why a plain margin (too tight on
             a roomy screen) and an auto margin (too loose on a short card)
             each got one of those two halves wrong. Presentational only. -->
        <div class="auth-gap" aria-hidden="true"></div>

        <div class="card-custom">

            <div class="reg-progress" aria-label="Registration progress">
                <span class="reg-progress-step is-done"><i class="fas fa-circle-check" aria-hidden="true"></i> 1. Email verified</span>
                <span class="reg-progress-sep" aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                <span class="reg-progress-step is-current"><i class="fas fa-key" aria-hidden="true"></i> 2. Register account</span>
            </div>

            <div class="text-center mb-2">
                <% if (typeof photo !== 'undefined' && photo) { %>
                    <img src="<%= photo %>" alt="Google profile photo" referrerpolicy="no-referrer" class="cqa-logo mb-1" style="border-radius: 50%; object-fit: cover; aspect-ratio: 1;">
                <% } else { %>
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1">
                <% } %>
                <h4 class="fw-bold text-dark mb-0">Register Your Account</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Your email is confirmed. Set a password to finish registering your CQA account.</p>
            </div>

            <form action="/complete-google-registration" method="POST" id="completeRegistrationForm">
                <div class="field-group">
                    <label class="field-label" for="regName">Name</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" id="regName" class="form-control" value="<%= name %>" readonly title="Name from your Google account">
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regEmail">Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                        <input type="text" id="regEmail" class="form-control" value="<%= email %>" readonly title="Email from your Google account">
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regPassword">Create Password</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="regPassword" class="form-control" placeholder="At least 8 characters" minlength="8" required title="Create a password for future logins" autocomplete="new-password" data-pw-strength>
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="regConfirmPassword">Confirm Password</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="confirmPassword" id="regConfirmPassword" class="form-control" placeholder="Re-enter your password" minlength="8" required title="Confirm your password" autocomplete="new-password">
                    </div>
                </div>

                <button type="submit" class="btn btn-login w-100" title="Create your account">
                    <i class="fas fa-user-plus me-2"></i> Create Account
                </button>

                <p class="text-muted text-xsmall text-center mt-3 mb-0">
                    You'll use this password to log in next time — the standard Email and Password form on the login page.
                </p>
            </form>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const regErrorMsg = new URLSearchParams(window.location.search).get('error');
        if (regErrorMsg) {
            AppAlert.error(regErrorMsg, 'Could Not Create Account');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        document.getElementById('completeRegistrationForm').addEventListener('submit', (e) => {
            const password = e.target.password.value;
            const confirmPassword = e.target.confirmPassword.value;
            if (password.length < 8) {
                e.preventDefault();
                AppAlert.warning('Password must be at least 8 characters long.', 'Password Too Short');
                return;
            }
            if (password !== confirmPassword) {
                e.preventDefault();
                AppAlert.warning('The passwords you entered do not match.', 'Passwords Do Not Match');
            }
        });
    </script>
    <script>
        // The shared connectivity chip, identical to the one on every other
        // auth page: navigator.onLine only, toggling the one class
        // /css/offline-pill.css keys its visibility off. No inline styles and
        // no d-none, so there is exactly one way this element is ever shown.
        (function () {
            function updateOfflineIndicator() {
                var pill = document.getElementById('offlineIndicator');
                if (pill) pill.classList.toggle('is-visible', !navigator.onLine);
            }
            window.addEventListener('online', updateOfflineIndicator);
            window.addEventListener('offline', updateOfflineIndicator);
            updateOfflineIndicator();
        })();
    </script>
</body>
</html>
