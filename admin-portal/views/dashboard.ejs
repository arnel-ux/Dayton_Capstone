                </div>
                <div class="col-xl-6">
                    <div class="side-panel-card">
                        <p class="section-eyebrow mb-1">ACTIONABLE INSIGHT</p>
                        <h6 class="fw-bold text-dark mb-1"><i class="fas fa-arrow-trend-down text-danger me-1"></i> Offices Needing Attention</h6>
