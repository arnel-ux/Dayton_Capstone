    document.body.style.overflow = 'auto';
}

function downloadOverallClusterPDF() {
    // Same one-identity document as the PER CLUSTER export (see downloadPDF) — same
    // three columns and the same repeated header; only the subtitle differs, plus the
    // closing OVERALL row this table adds at the very end.
    const periodText = document.querySelector('#printableOverallClusterDocument .print-period')?.textContent.trim() || '';
    const header = { title: 'Client Satisfaction Measurement Survey Result', subtitle: 'Overall Cluster', period: periodText };

    const opt = {
        margin:       [0, 0.5, 0.45, 0.5],
        filename:     'CSPC-CSM-Overall-Cluster-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false, letterRendering: true, scrollY: 0, backgroundColor: '#ffffff' },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' },
        pagebreak:    { mode: ['css', 'legacy'], avoid: ['.cluster-row', '.cluster-total-row', '.cluster-report-signatures', 'tr'] }
    };

    exportRepeatingHeaderPdf({
        elementId: 'printableOverallClusterDocument',
        filename: opt.filename,
        opt,
        headerHeightIn: 2.15,
        headerHideSelectors: ['.report-header-block', '.print-title', '.print-period', '.cluster-report-table thead'],
        getHeaderForPage: () => header,
        avoidSplitSelector: '.cluster-report-signatures',
        columnHeader: {
            startYIn: 1.85,
            columns: [
                { label: 'NAME OF OFFICE', widthPct: 0.64, align: 'center' },
                { label: 'OVERALL SCORE', widthPct: 0.16, align: 'center' },
                { label: 'INTERPRETATION', widthPct: 0.20, align: 'center' }
            ]
        }
    });
}

function openDashboardReportModal() {
    document.getElementById('dashboardReportModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function closeDashboardReportModal() {
    document.getElementById('dashboardReportModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

function downloadDashboardReportPDF() {
    const element = document.getElementById('printableDashboardReportDocument');
    // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
    // html2pdf's margin array is [top, left, bottom, right] (not CSS order).
    const opt = {
        margin:       [0.5, 0.5, 0.25, 0.25],
        filename:     'CSPC-Dashboard-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false, letterRendering: true, scrollY: 0 },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' },
        pagebreak:    { mode: ['css', 'legacy'], avoid: ['.report-header-block', '.page-footer', '.print-footer', 'tr'] }
    };
    html2pdf().set(opt).from(element).save();
}
</script>

</body>
</html>
