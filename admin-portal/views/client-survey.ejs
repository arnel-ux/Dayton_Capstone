        if (i18n[currentLang][key]) {
            el.setAttribute("placeholder", i18n[currentLang][key]);
        }
    });
}

function setLanguage(lang) {
    currentLang = lang;
    // The switch renders entirely from aria-checked (knob position, which
    // flag is visible) — the state a screen reader reads IS the state the
    // CSS draws, so the two can't drift apart. The labels either side are
    // aria-hidden: the switch's own aria-label names the control, and
    // announcing a stray "EN"/"TL" beside it would only repeat it.
    const track = document.getElementById('langSwitchTrack');
    if (track) track.setAttribute('aria-checked', lang === 'tl' ? 'true' : 'false');
    const enLabel = document.getElementById('lang-label-en');
    const tlLabel = document.getElementById('lang-label-tl');
    if (enLabel) enLabel.classList.toggle('is-active', lang === 'en');
    if (tlLabel) tlLabel.classList.toggle('is-active', lang === 'tl');
    updateTranslations();
    renderSQD();
    renderTermsPoints();

    // Re-apply the current stage's Next-button label in the new language —
    // covers both the normal "Next"/"Susunod" text and the Smart Edit
    // "Save & Return to Review" label, which isn't part of the data-i18n scan above.
    const activePage = document.querySelector('#surveyForm .page.active');
    if (activePage) updateNextButtonLabel(parseInt(activePage.id.replace('stage', ''), 10));
}

// Converts an <input type="time"> value ("HH:MM") into a human-readable
// 12-hour string ("9:35 AM") for display on Review & Confirmation.
function formatTimeForDisplay(rawTime) {
    if (!rawTime) return '—';
    const parts = rawTime.split(':');
    if (parts.length < 2) return rawTime;
    let hours = parseInt(parts[0], 10);
    const minutes = parts[1];
    if (isNaN(hours)) return rawTime;
    const period = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12;
    if (hours === 0) hours = 12;
    return `${hours}:${minutes} ${period}`;
}

// Converts an <input type="date"> value ("YYYY-MM-DD") into "Mon DD, YYYY".
function formatDateForDisplay(rawDate) {
    if (!rawDate) return '—';
    const parts = rawDate.split('-');
    if (parts.length !== 3) return rawDate;
    const d = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
    if (isNaN(d.getTime())) return rawDate;
    return d.toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric' });
}

// Converts an <input type="datetime-local"> value ("YYYY-MM-DDTHH:MM") into
// "Mon DD, YYYY, h:mm AM/PM". The office visit can happen on a different day
// than the survey is actually filled out, so this reads the visit's own
// date+time picker rather than assuming it matches today.
function formatDateTimeForDisplay(rawDateTime) {
    if (!rawDateTime) return '—';
    const [rawDate, rawTime] = rawDateTime.split('T');
    const timePart = formatTimeForDisplay(rawTime);
    if (!rawDate) return timePart;
    return `${formatDateForDisplay(rawDate)}, ${timePart}`;
}

