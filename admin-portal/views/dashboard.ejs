<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #0a1f44 0%, #12305c 100%);
            --bg-body: #f4f6fb;
            --border-soft: rgba(15, 23, 42, 0.06);
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --card-bg: #ffffff;
        }

        html[data-bs-theme="dark"] {
            --bg-body: #0b1526;
            --border-soft: rgba(255, 255, 255, 0.08);
            --text-dark: #e2e8f0;
            --text-muted: #94a3b8;
            --card-bg: #141d30;
        }

        body { background-color: var(--bg-body); font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-dark); }

        html[data-bs-theme="dark"] .stat-card,
        html[data-bs-theme="dark"] .cluster-mini-card,
        html[data-bs-theme="dark"] .chart-container-main,
        html[data-bs-theme="dark"] .filter-bar,
        html[data-bs-theme="dark"] .modal-report-container {
            background: var(--card-bg);
        }
        html[data-bs-theme="dark"] .form-select { background-color: var(--card-bg); color: var(--text-dark); }
        html[data-bs-theme="dark"] .badge.bg-light { background-color: #1e293b !important; color: var(--text-muted) !important; }

        .page-heading { letter-spacing: -0.02em; }

        /* Modern Header Card */
        .overall-header-card {
            background: linear-gradient(135deg, #0a1f44 0%, #12305c 100%);
            color: white; border-radius: 16px; position: relative;
            box-shadow: 0 8px 24px -4px rgba(10, 31, 68, 0.35);
            overflow: hidden;
        }
        .overall-header-card::after {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(circle at 85% 15%, rgba(255,255,255,0.08), transparent 55%);
            pointer-events: none;
        }

        /* Interactive Summary Statistics Cards */
        .stat-card {
            background: white; border: 1px solid var(--border-soft); border-radius: 16px;
            transition: box-shadow 0.2s ease, border-color 0.2s ease; height: 100%; text-decoration: none !important;
            display: flex; flex-direction: column; color: inherit;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }
        .stat-card:hover { border-color: rgba(10, 31, 68, 0.25); box-shadow: 0 8px 20px -6px rgba(10, 31, 68, 0.18); }

        /* Makes "View Details" read as an obvious clickable pill instead of plain small text */
        .view-details-pill {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(10, 31, 68, 0.08);
            color: #0a1f44 !important;
            font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em;
            padding: 4px 12px; border-radius: 999px;
            transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }
        .stat-card:hover .view-details-pill {
            background: #0a1f44; color: #fff !important; transform: translateX(2px);
        }
        html[data-bs-theme="dark"] .view-details-pill { background: rgba(244, 180, 0, 0.12); color: #ffc72c !important; }
        html[data-bs-theme="dark"] .stat-card:hover .view-details-pill { background: #f4b400; color: #0a1f44 !important; }

        /* Cluster Mini Summary Cards */
        .cluster-mini-card {
            background: white; border: 1px solid var(--border-soft);
            border-left: 4px solid #f4b400; border-radius: 12px;
            padding: 20px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); height: 100%;
            transition: box-shadow 0.2s ease;
        }
        .cluster-mini-card:hover { box-shadow: 0 6px 16px -6px rgba(15, 23, 42, 0.12); }

        .chart-container-main {
            background: white; border: 1px solid var(--border-soft);
            border-radius: 16px; padding: 28px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        .filter-bar {
            background: white; border: 1px solid var(--border-soft);
            border-radius: 14px; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        .section-eyebrow {
            font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; color: var(--text-muted);
        }

        .count-up { font-size: 2.25rem; font-weight: 800; letter-spacing: -0.02em; }

        /* --- REPORT MODAL INTERFACE STYLES --- */
        #reportModal {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 9999; overflow-y: auto; padding: 20px;
        }
        .modal-report-container {
            background: white;
            max-width: 900px; margin: 30px auto; border-radius: 15px; padding: 40px; position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .modal-controls {
            display: flex; gap: 10px; justify-content: flex-end; margin-bottom: 20px;
            padding-bottom: 15px; border-bottom: 1px solid #eee;
        }

        /* Official Document Layout Styles for PDF/Print */
        .header-container { display: flex; align-items: center; margin-bottom: 5px; }
        .logo-img { width: 70px; height: auto; margin-right: 15px; }
        .header-text { line-height: 1.2; color: #000; text-align: left; }
        .republic { font-size: 14px; margin: 0; }
        .college-name { font-size: 18px; font-weight: bold; margin: 0; text-transform: uppercase; }
        .address { font-size: 13px; margin: 0; }
        .header-line { border-bottom: 2px solid #5B9BD5; margin-top: 5px; margin-bottom: 20px; display: flex; justify-content: flex-end; }
        .form-code { font-size: 11px; font-weight: bold; color: #000; }
        .print-title { text-align: center; font-weight: bold; font-size: 16px; margin-bottom: 5px; color: #000; text-transform: uppercase; }
        .print-period { text-align: center; font-size: 14px; font-weight: bold; margin-bottom: 20px; color: #000; }
        
        .print-table { width: 100%; border-collapse: collapse; font-size: 12px; color: #000; margin-top: 15px; }
        .print-table th { background-color: #5B9BD5 !important; color: white !important; border: 1px solid black; padding: 8px; text-align: center; text-transform: uppercase; }
        .print-table td { border: 1px solid black; padding: 6px 8px; vertical-align: middle; }
        .cluster-row { background-color: #D9D9D9 !important; font-weight: bold; }
        .total-row { font-weight: bold; background-color: #f2f2f2 !important; }
        .num-col { text-align: center; width: 50px; }
        .score-col { text-align: center; width: 150px; font-weight: bold; }
        .inter-col { text-align: center; width: 150px; font-weight: bold; }
        
        .print-footer { margin-top: 40px; display: flex; justify-content: space-between; font-size: 13px; color: #000; }
        .sign-block { width: 45%; }
        .sign-name { font-weight: bold; text-decoration: underline; margin-top: 35px; margin-bottom: 2px; text-transform: uppercase; }

        @media print {
            #wrapper, .modal-controls { display: none !important; }
            #reportModal { display: block !important; position: absolute; background: white; padding: 0; left: 0; top: 0; width: 100%; }
            .modal-report-container { margin: 0; box-shadow: none; max-width: 100%; padding: 0; }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid px-4 py-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h4 class="page-heading fw-bold text-dark mb-0">Dashboard Overview</h4>
                    <p class="text-muted small mb-0">Institution-wide client satisfaction summary</p>
                </div>
                <button onclick="openReportModal()" class="btn btn-primary shadow-sm px-4" title="Generate a printable institutional report">
                    <i class="fas fa-file-invoice me-2"></i> Generate Report
                </button>
            </div>

            <form action="/dashboard" method="GET" class="filter-bar d-flex flex-wrap align-items-end gap-3 mb-4 p-3">
                <div>
                    <label for="periodCovered" class="form-label section-eyebrow mb-1">Period Covered</label>
                    <select id="periodCovered" name="periodCovered" class="form-select form-select-sm" title="Filter records by period covered" onchange="this.form.submit()">
                        <option value="">All Periods</option>
                        <% if (typeof periodOptions !== 'undefined') { %>
                            <% periodOptions.forEach(opt => { %>
                                <option value="<%= opt.value %>" <%= selectedPeriod === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <% if (typeof hasQueryParam !== 'undefined' && hasQueryParam) { %>
                    <a href="/dashboard" class="btn btn-outline-secondary btn-sm px-3" title="Clear the period filter"><i class="fas fa-times me-1"></i> Clear</a>
                <% } %>
            </form>

            <div class="row g-4 mb-4">
                <div class="col-xl-8 col-lg-7">
                    <div class="overall-header-card p-4 h-100">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="text-uppercase text-indigo-300 fw-bold mb-2 small" style="letter-spacing: 2px;">Overall Institutional Rating</h6>
                                <div class="d-flex align-items-baseline">
                                    <h1 class="display-4 fw-bold mb-0"><%= typeof satisfactionRate !== 'undefined' ? satisfactionRate : '0.00' %></h1>
                                    <span class="fs-3 ms-2 opacity-50">%</span>
                                </div>
                                <div class="mt-3">
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill fw-semibold">
                                        <i class="fas fa-certificate me-1"></i> LEVEL 4 <%= typeof dashboardData !== 'undefined' ? dashboardData.overallLevel : 'OUTSTANDING' %>
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                                <div class="p-3 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-10">
                                    <small class="opacity-75 d-block mb-1">Period Covered</small>
                                    <h6 class="mb-0 fw-bold"><i class="far fa-calendar-check me-2"></i><%= typeof dashboardData !== 'undefined' ? dashboardData.periodCoveredLabel : 'All Periods' %></h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-5">
                    <a href="/survey-records" class="stat-card p-4">
                        <div class="d-flex align-items-center mb-2">
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary me-3">
                                <i class="fas fa-clipboard-check fa-xl"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-0 small text-uppercase">Total Completed Surveys</h6>
                                <span class="view-details-pill mt-1">View Details <i class="fas fa-arrow-right ms-1"></i></span>
                            </div>
                        </div>
                        <h2 class="count-up mb-0 text-dark"><%= typeof totalRespondents !== 'undefined' ? totalRespondents : '0' %></h2>
                        <div class="progress mt-3" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Aggregate data from <strong><%= typeof totalOffices !== 'undefined' ? totalOffices : '0' %> registered offices</strong></p>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="chart-container-main">
                        <div class="d-md-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Cluster Performance Analytics</h5>
                                <p class="text-muted small mb-0">Total respondents per cluster</p>
                            </div>
                            <div class="d-flex gap-3 small fw-bold mt-2 mt-md-0">
                                <div><i class="fas fa-square text-primary me-1"></i> Respondents Volume</div>
                            </div>
                        </div>
                        <div style="height: 350px; position: relative;">
                            <canvas id="clusterAnalyticsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof clusterCards !== 'undefined' && clusterCards.length > 0) { %>
                <div class="row g-4">
                    <% clusterCards.forEach(card => { %>
                        <div class="col-xl-3 col-md-6">
                            <div class="cluster-mini-card" style="border-left: 5px solid <%= card.color || '#0a1f44' %>;">
                                <h6 class="text-muted fw-bold small text-uppercase mb-2"><%= card.name %></h6>
                                <span class="badge bg-light text-secondary border rounded-pill small"><i class="fas fa-users me-1"></i><%= card.respondents %> Respondents</span>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="row g-4">
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #0a1f44;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Office of the President</h6><span class="badge bg-light text-secondary border rounded-pill small">0 Respondents</span></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #10b981;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Admin & Finance</h6><span class="badge bg-light text-secondary border rounded-pill small">0 Respondents</span></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #f59e0b;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Research & Innovation</h6><span class="badge bg-light text-secondary border rounded-pill small">0 Respondents</span></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #8b5cf6;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Academic Cluster</h6><span class="badge bg-light text-secondary border rounded-pill small">0 Respondents</span></div></div>
                </div>
            <% } %>

        </div>
    </div>
</div>

<div id="reportModal">
    <div class="modal-report-container shadow-lg">
        <div class="modal-controls">
            <button onclick="downloadPDF()" class="btn btn-danger btn-sm px-3"><i class="fas fa-file-pdf me-1"></i> Export PDF</button>
            <button onclick="window.print()" class="btn btn-secondary btn-sm px-3"><i class="fas fa-print me-1"></i> Print</button>
            <button onclick="closeReportModal()" class="btn btn-dark btn-sm px-3">Close</button>
        </div>

        <div id="printableReportDocument">
            <div class="header-container">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="logo-img">
                <div class="header-text">
                    <p class="republic">Republic of the Philippines</p>
                    <p class="college-name">Camarines Sur Polytechnic Colleges</p>
                    <p class="address">Nabua, Camarines Sur</p>
                </div>
            </div>
            <div class="header-line">
                <span class="form-code">CSPC-CQA-CSM-F01</span>
            </div>

            <h5 class="print-title">Client Satisfaction Measurement (CSM) Institutional Report</h5>
            <p class="print-period">Period Covered: <%= typeof dashboardData !== 'undefined' ? dashboardData.periodCoveredLabel : 'All Periods' %></p>

            <table class="print-table">
                <thead>
                    <tr>
                        <th class="num-col">No.</th>
                        <th>Office / Functional Unit Name</th>
                        <th class="score-col">Average Satisfaction Rating</th>
                        <th class="inter-col">Qualitative Interpretation</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof reportData !== 'undefined' && reportData.length > 0) { %>
                        <% reportData.forEach(cluster => { %>
                            <tr class="cluster-row">
                                <td colspan="4"><%= cluster.clusterName %></td>
                            </tr>
                            <% cluster.offices.forEach((office, index) => { %>
                                <tr>
                                    <td class="num-col"><%= index + 1 %></td>
                                    <td><%= office.name %></td>
                                    <td class="score-col"><%= office.score %>%</td>
                                    <td class="inter-col">
                                        <span class="text-uppercase"><%= office.interpretation %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">No survey response submissions loaded yet for this active period.</td>
                        </tr>
                    <% } %>
                    <tr class="total-row">
                        <td colspan="2" class="text-end">OVERALL INSTITUTIONAL SCORE:</td>
                        <td class="score-col"><%= typeof satisfactionRate !== 'undefined' ? satisfactionRate : '0.00' %>%</td>
                        <td class="inter-col"><%= typeof dashboardData !== 'undefined' ? dashboardData.overallLevel : 'OUTSTANDING' %></td>
                    </tr>
                </tbody>
            </table>

            <div class="print-footer">
                <div class="sign-block">
                    <p class="mb-0 text-muted">Prepared and Certified by:</p>
                    <p class="sign-name">DR. LAILANI R. MEDINA</p>
                    <p class="mb-0 text-secondary small">Director, Corporate Quality Assurance (CQA)</p>
                </div>
                <div class="sign-block text-end">
                    <p class="mb-0 text-muted">Noted and Approved by:</p>
                    <p class="sign-name">DR. AMADO A. OLIVA JR.</p>
                    <p class="mb-0 text-secondary small">College President</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>

<script>
document.addEventListener("DOMContentLoaded", function() {
    
    // --- 1. NUMBER ANIMATION INCREMENT EFFECT ---
    document.querySelectorAll('.count-up').forEach(el => {
        const target = +el.innerText.replace(/[^0-9.]/g, '');
        let curr = 0;
        const speed = target / 40;
        
        const up = () => {
            curr += speed;
            if(curr < target) {
                el.innerHTML = target % 1 === 0 ? Math.ceil(curr).toLocaleString() : curr.toFixed(2);
                setTimeout(up, 20);
            } else { 
                el.innerHTML = target % 1 === 0 ? target.toLocaleString() : target.toFixed(2); 
            }
        };
        if(target > 0) up();
    });

    // --- 2. CHART.JS CONFIGURATION & RENDER PIPELINE ---
    const chartLabels = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.labels) : JSON.stringify(['Office of President', 'Admin & Finance', 'Research & Innov.', 'Academic Affairs', 'Other Offices']) %>;
    const chartRespondents = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.respondents) : JSON.stringify([0, 0, 0, 0, 0]) %>;

    const ctx = document.getElementById('clusterAnalyticsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: chartLabels,
            datasets: [
                {
                    label: 'Respondents Count (Volume)',
                    data: chartRespondents,
                    backgroundColor: 'rgba(10, 31, 68, 0.85)',
                    hoverBackgroundColor: '#f4b400',
                    borderRadius: 8,
                    maxBarThickness: 56
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 12,
                    cornerRadius: 10,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return `Respondents: ${context.raw.toLocaleString()}`;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    title: { display: true, text: 'Total Respondents', font: { weight: 'bold' } },
                    grid: { color: '#f1f5f9' }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { weight: '600' } }
                }
            }
        }
    });
});

// --- 3. CONTROLS MANAGEMENT FUNCTIONS FOR POPUP REPORT MODAL ---
function openReportModal() {
    document.getElementById('reportModal').style.display = 'block';
    document.body.style.overflow = 'hidden'; 
}

function closeReportModal() {
    document.getElementById('reportModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

function downloadPDF() {
    const element = document.getElementById('printableReportDocument');
    const opt = {
        margin:       [0.5, 0.5, 0.5, 0.5],
        filename:     'CSPC-CSM-Institutional-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
    };
    html2pdf().set(opt).from(element).save();
}
</script>

</body>
</html>