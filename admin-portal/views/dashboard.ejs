                            <div style="height: 330px; position: relative;" class="mb-3">
                                <canvas id="bottomOfficesChart"></canvas>
                            </div>
                            <% bottomOffices.forEach(o => { %>
                                <div class="rank-item">
                                    <div class="rank-left">
