<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <!-- Deliberately no <link rel="manifest">: this project must stay a
         plain website, never an installable PWA (no "Add to Home Screen" /
         install prompt). The service worker below still provides offline
         caching — that's independent of installability, manifest.json is
         what Chrome/Edge actually key the install criteria on. -->
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/offline-pill.css">
    <style>
        /* The single Google button is this page's whole form, so it is sized
           up a little from the shared .btn-google (which sits under an OR
           divider next to a password form on /login). */
        .btn-google { font-size: 0.98rem; gap: 12px; min-height: 48px; }
        .btn-google img { width: 21px; height: 21px; }

        /* Blocked while a previous session's server-side logout is still
           unresolved — see the race guard in the script at the bottom. */
        #clientGoogleSignInBtn.is-blocked { opacity: 0.55; cursor: not-allowed; }

        /* The offline route out of this page. It had none: signing in with
           Google is the only control here and it cannot work without a
           reachable network, so an unusable connection left this page as a
           dead end — the visitor could see the survey portal's front door and
           had no way through it. Shown whenever the connection is unusable in
           either sense (navigator.onLine false, OR a /api/health probe that
           can't get through while the browser still claims to be online), and
           never auto-navigated to — the visitor clicks it themselves, same
           rule as the landing page's copy. */
        .offline-survey-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            width: 100%;
            margin-top: 0.85rem;
            padding: 0.6rem 1.1rem;
            border-radius: 10px;
            background: #251d3a;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.85rem;
            text-decoration: none;
            box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.35);
            transition: transform 0.15s ease;
        }
        .offline-survey-btn:hover { color: #ffffff; transform: translateY(-1px); }
        .offline-survey-btn.d-none { display: none; }
    </style>
</head>
<body>

    <div class="bg-blurred" style="--auth-hero-image: url('<%- heroImageUrl %>')"></div>
    <div class="bg-overlay"></div>

    <!-- Every other auth page has this; this one was the odd one out, leaving a
         visitor who landed here by mistake with no way back except the browser
         button. -->
    <a href="/" class="btn-home" title="Return to Home Page" aria-label="Return to Home Page">
        <i class="fas fa-home"></i>
    </a>

    <div class="login-wrapper">
        
        <!-- Above the header, centred: the first thing in the column, so it is
             the first thing read and nothing can sit on it. -->
        <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection.">
            <span class="dot"></span><span class="label">Viewing Offline</span>
        </span>

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Client Portal</h2>
        </div>

        <!-- The gap between the heading and the card. An element rather than a
             margin because it has to GROW into spare space and STOP at a cap —
             see .auth-gap in /css/auth.css for why a plain margin (too tight on
             a roomy screen) and an auto margin (too loose on a short card)
             each got one of those two halves wrong. Presentational only. -->
        <div class="auth-gap" aria-hidden="true"></div>

        <div class="card-custom">

            <div class="text-center mb-2">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                <h4 class="fw-bold text-dark mb-0">Client Login</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Sign in to your CQA Dashboard</p>
            </div>

            <div class="text-center mb-4">
                <p class="text-muted mb-0" style="font-size: 0.85rem; line-height: 1.5;">
                    Please sign in using your personal or academic Gmail account to access the survey portal.
                </p>
            </div>

            <!-- Blocks starting a NEW login here while an old session's
                 server-side logout is still unresolved — see the JS
                 comment near the bottom of this file for the exact race
                 this prevents. -->
            <div id="pendingLogoutNotice" class="pending-logout-notice d-none">
                <i id="pendingLogoutNoticeIcon" class="fas fa-hourglass-half"></i>
                <span id="pendingLogoutNoticeText">Finishing your previous session…</span>
                <button type="button" id="pendingLogoutRetryBtn" class="notice-retry-btn d-none">Retry</button>
            </div>

            <a href="/auth/google" class="btn btn-google w-100" id="clientGoogleSignInBtn" title="Sign in with your Google account">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google">
                Sign in with Google
            </a>

            <!-- Visibility is driven from updateOfflineIndicator() below. Sits
                 under the sign-in button, not above it: signing in properly is
                 still the better outcome whenever it is actually possible, so
                 this is the fallback, not the headline. -->
            <a href="/survey-offline" id="offlineSurveyBtn" class="offline-survey-btn d-none" title="Complete the survey now — your account is verified once you're back online">
                <i class="fas fa-clipboard-list"></i> Take Survey Offline
            </a>

        </div>
    </div>

    <!-- WEAK-CONNECTION PROMPT — same dialog, same wording and the same
         trigger as the landing page's; see showWeakConnectionPrompt() below
         and /css/offline-pill.css for the styling. It matters more here than
         anywhere else: Google sign-in is a full round trip to a third party,
         so it is the first thing a weak connection breaks, and until now this
         page's only response was to sit there looking normal while the button
         did nothing. -->
    <div id="weakConnectionPrompt" class="weak-connection-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="weakConnectionTitle">
        <div class="weak-connection-card">
            <div class="weak-connection-icon"><i class="fas fa-wifi"></i></div>
            <h4 id="weakConnectionTitle">Your Connection Is Weak</h4>
            <p>Your internet is too slow or unstable to sign in right now. You can take the survey offline instead — your answers are saved on this device and submitted automatically once your connection improves.</p>
            <div class="weak-connection-actions">
                <a href="/survey-offline" class="wc-btn-primary"><i class="fas fa-clipboard-list"></i> Take Offline Survey</a>
                <button type="button" class="wc-btn-secondary" onclick="dismissWeakConnectionPrompt()">Stay Online</button>
            </div>
        </div>
    </div>

    <script>
        // Marks a real landing on the login page in THIS browser tab (sessionStorage
        // is tab-scoped, so this can never bleed into a different tab or a different
        // client's browser) so that if the user later presses Forward, the matching
        // bfcache guard in client-survey.ejs redirects back here instead of letting
        // the browser silently restore a previously-cached authenticated survey page.
        // Deliberately NOT done by destroying the server-side session here — see the
        // "must NOT destroy any session" comment on the /login route in server.js:
        // a shared session cookie means that would log out every OTHER open tab too.
        try { sessionStorage.setItem('__loginBoundary', window.location.pathname); } catch (e) {}
    </script>
    <!-- Needed for attemptPendingClientLogout() below (a previously-offline
         session's server-side logout may still be pending) — this page
         didn't load it before since it had no other use for offline-db.js. -->
    <script src="/js/offline-db.js"></script>
    <script>
        // ==========================================
        // CONNECTIVITY — two separate signals, deliberately.
        //
        //   navigator.onLine false  -> no network at all. The chip and the
        //                              "Take Survey Offline" button.
        //   /api/health unreachable -> a connection the browser still calls
        //     while onLine is true     "online" but which nothing gets
        //                              through. This is the one that used to
        //                              be invisible here, and it is the state
        //                              that actually stranded people: Google
        //                              sign-in is a third-party round trip,
        //                              so it is the first thing to break, and
        //                              the page gave no sign anything was
        //                              wrong and offered no alternative.
        //
        // Same probe, same 4s budget and the same three outcomes as the
        // landing page's checkServerHealth() — one behaviour across both
        // entry points, so a visitor who bounces between them isn't told two
        // different stories about the same connection.
        // ==========================================
        let weakConnectionDetected = false;
        // "Stay Online" was chosen on this page load: stops the popup
        // re-opening by itself. The offline button stays up regardless for as
        // long as the connection is unusable, so the route is still one click
        // away without the dialog nagging.
        let weakConnectionPromptDismissed = false;

        function updateOfflineIndicator() {
            const offline = !navigator.onLine;
            const el = document.getElementById('offlineIndicator');
            if (el) el.classList.toggle('is-visible', offline);
            const offlineSurveyBtn = document.getElementById('offlineSurveyBtn');
            if (offlineSurveyBtn) offlineSurveyBtn.classList.toggle('d-none', !offline && !weakConnectionDetected);
        }

        function showWeakConnectionPrompt() {
            if (weakConnectionPromptDismissed) return;
            const prompt = document.getElementById('weakConnectionPrompt');
            if (prompt) prompt.hidden = false;
        }

        function hideWeakConnectionPrompt() {
            const prompt = document.getElementById('weakConnectionPrompt');
            if (prompt) prompt.hidden = true;
        }

        // "Stay Online" — re-probes straight away so a connection that has
        // since recovered clears the offline button immediately instead of
        // leaving the page looking broken to someone who just said they want
        // to keep waiting for it.
        function dismissWeakConnectionPrompt() {
            weakConnectionPromptDismissed = true;
            hideWeakConnectionPrompt();
            checkClientConnectionHealth();
        }

        async function checkClientConnectionHealth() {
            // Nothing to probe with, and nothing to add: navigator.onLine
            // already covers this case on its own, below.
            if (!navigator.onLine) return;
            if (typeof fetchWithTimeout !== 'function') return;
            try {
                const res = await fetchWithTimeout('/api/health', {}, 4000);
                // res.ok or not, a response came back, so the connection
                // itself is usable — a failing service is not a reason to
                // push someone into an offline survey that would only queue
                // behind that same service.
                weakConnectionDetected = false;
                weakConnectionPromptDismissed = false;
                hideWeakConnectionPrompt();
            } catch (err) {
                weakConnectionDetected = true;
                updateOfflineIndicator();
                showWeakConnectionPrompt();
                return;
            }
            updateOfflineIndicator();
        }

        window.addEventListener('online', function () {
            updateOfflineIndicator();
            checkClientConnectionHealth();
        });
        // Losing the network outright supersedes the weak state: the chip and
        // the offline button both run off navigator.onLine from here, and the
        // popup's "too slow to sign in" wording would be wrong for a
        // connection that is simply gone. Cleared, not just hidden, so a
        // recovery back to a merely-weak connection can ask again.
        window.addEventListener('offline', function () {
            weakConnectionDetected = false;
            weakConnectionPromptDismissed = false;
            hideWeakConnectionPrompt();
            updateOfflineIndicator();
        });
        updateOfflineIndicator();
        checkClientConnectionHealth();

        // ==========================================
        // PENDING-LOGOUT / NEW-LOGIN RACE GUARD — same mechanism and same
        // reasoning as login.ejs's copy of this block: a stale pending
        // /logout call that only lands AFTER a brand new login succeeded
        // would destroy the NEW session (client.sid is just whatever
        // cookie the request currently carries — there's no way to tell
        // "old" and "new" apart from it alone). Blocking the one login
        // control this page has (Google sign-in) until
        // attemptPendingClientLogout() (offline-db.js) positively confirms
        // the old session is gone prevents that outright.
        // ==========================================
        (function () {
            const notice = document.getElementById('pendingLogoutNotice');
            const icon = document.getElementById('pendingLogoutNoticeIcon');
            const text = document.getElementById('pendingLogoutNoticeText');
            const retryBtn = document.getElementById('pendingLogoutRetryBtn');
            const googleBtn = document.getElementById('clientGoogleSignInBtn');
            let blocked = false;

            function setNotice(kind, message, showRetry) {
                if (!notice) return;
                notice.classList.toggle('d-none', !message);
                notice.classList.toggle('is-error', kind === 'error');
                if (icon) icon.className = kind === 'error' ? 'fas fa-triangle-exclamation' : 'fas fa-hourglass-half';
                if (text) text.textContent = message || '';
                if (retryBtn) retryBtn.classList.toggle('d-none', !showRetry);
            }

            function setBlocked(isBlocked) {
                blocked = isBlocked;
                if (googleBtn) googleBtn.classList.toggle('is-blocked', isBlocked);
            }

            function attempt() {
                if (typeof hasPendingClientLogout !== 'function' || !hasPendingClientLogout()) {
                    setBlocked(false);
                    setNotice(null, '', false);
                    return;
                }
                if (!navigator.onLine) {
                    setBlocked(true);
                    setNotice('warning', "You're offline. Reconnect to finish closing your previous session before signing in.", false);
                    return;
                }
                setBlocked(true);
                setNotice('warning', 'Finishing your previous session…', false);
                attemptPendingClientLogout().then(function (success) {
                    if (success) {
                        setBlocked(false);
                        setNotice(null, '', false);
                    } else {
                        // Does not claim the old session is closed — it
                        // isn't yet. Stays blocked; Retry + the next
                        // 'online' event are the only retries, no loop.
                        setNotice('error', "We couldn't close your previous session because the connection is unstable. Please retry once your connection improves.", true);
                    }
                });
            }

            if (retryBtn) retryBtn.addEventListener('click', attempt);
            if (googleBtn) {
                googleBtn.addEventListener('click', function (e) {
                    if (blocked) e.preventDefault();
                });
            }
            window.addEventListener('online', attempt);

            attempt();
        })();

        // REMOVED: this used to bounce straight to /client-survey while
        // offline whenever a cached cspc_client_session existed. That's
        // exactly what made the offline overlay's Login/Dashboard buttons
        // "blink and do nothing" — navigating here (or to /) immediately
        // redirected right back to /client-survey's cached shell, which
        // shows the same offline overlay again on its own anyway. A cached
        // client-side flag was never proof the live authenticated portal is
        // usable offline; see login.ejs's identical removal for the fuller
        // explanation.

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }
    </script>
</body>
</html>