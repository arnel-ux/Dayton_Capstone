<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            --bg-body: #f1f5f9;
        }

        body { background-color: var(--bg-body); font-family: 'Plus Jakarta Sans', sans-serif; }

        /* Modern Header Card */
        .overall-header-card {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
            color: white; border-radius: 20px; position: relative; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        /* Interactive Summary Statistics Cards */
        .stat-card {
            background: white; border: 1px solid rgba(0,0,0,0.05); border-radius: 18px;
            transition: all 0.3s ease; height: 100%; text-decoration: none !important;
            display: flex; flex-direction: column; color: inherit;
        }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.1); }

        /* Cluster Mini Summary Cards */
        .cluster-mini-card {
            background: white;
            border-left: 5px solid #4f46e5; border-radius: 12px;
            padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.02); height: 100%;
        }

        .chart-container-main {
            background: white;
            border-radius: 20px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .count-up { font-size: 2.5rem; font-weight: 800; }

        /* --- REPORT MODAL INTERFACE STYLES --- */
        #reportModal {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 9999; overflow-y: auto; padding: 20px;
        }
        .modal-report-container {
            background: white;
            max-width: 900px; margin: 30px auto; border-radius: 15px; padding: 40px; position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .modal-controls {
            display: flex; gap: 10px; justify-content: flex-end; margin-bottom: 20px;
            padding-bottom: 15px; border-bottom: 1px solid #eee;
        }

        /* Official Document Layout Styles for PDF/Print */
        .header-container { display: flex; align-items: center; margin-bottom: 5px; }
        .logo-img { width: 70px; height: auto; margin-right: 15px; }
        .header-text { line-height: 1.2; color: #000; text-align: left; }
        .republic { font-size: 14px; margin: 0; }
        .college-name { font-size: 18px; font-weight: bold; margin: 0; text-transform: uppercase; }
        .address { font-size: 13px; margin: 0; }
        .header-line { border-bottom: 2px solid #5B9BD5; margin-top: 5px; margin-bottom: 20px; display: flex; justify-content: flex-end; }
        .form-code { font-size: 11px; font-weight: bold; color: #000; }
        .print-title { text-align: center; font-weight: bold; font-size: 16px; margin-bottom: 5px; color: #000; text-transform: uppercase; }
        .print-period { text-align: center; font-size: 14px; font-weight: bold; margin-bottom: 20px; color: #000; }
        
        .print-table { width: 100%; border-collapse: collapse; font-size: 12px; color: #000; margin-top: 15px; }
        .print-table th { background-color: #5B9BD5 !important; color: white !important; border: 1px solid black; padding: 8px; text-align: center; text-transform: uppercase; }
        .print-table td { border: 1px solid black; padding: 6px 8px; vertical-align: middle; }
        .cluster-row { background-color: #D9D9D9 !important; font-weight: bold; }
        .total-row { font-weight: bold; background-color: #f2f2f2 !important; }
        .num-col { text-align: center; width: 50px; }
        .score-col { text-align: center; width: 150px; font-weight: bold; }
        .inter-col { text-align: center; width: 150px; font-weight: bold; }
        
        .print-footer { margin-top: 40px; display: flex; justify-content: space-between; font-size: 13px; color: #000; }
        .sign-block { width: 45%; }
        .sign-name { font-weight: bold; text-decoration: underline; margin-top: 35px; margin-bottom: 2px; text-transform: uppercase; }

        @media print {
            #wrapper, .modal-controls { display: none !important; }
            #reportModal { display: block !important; position: absolute; background: white; padding: 0; left: 0; top: 0; width: 100%; }
            .modal-report-container { margin: 0; box-shadow: none; max-width: 100%; padding: 0; }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid px-4 py-4">
            
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
                <div>
                    <h4 class="fw-bold text-dark mb-0">Dashboard Overview</h4>
                    <p class="text-muted small mb-0">Institution-wide client satisfaction summary</p>
                </div>
                <button onclick="openReportModal()" class="btn btn-primary shadow-sm px-4" title="Generate a printable institutional report">
                    <i class="fas fa-file-invoice me-2"></i> Generate Report
                </button>
            </div>

            <form action="/dashboard" method="GET" class="d-flex flex-wrap align-items-end gap-3 mb-4 p-3 bg-white rounded-4 shadow-sm">
                <div>
                    <label for="semester" class="form-label small fw-bold text-muted text-uppercase mb-1">Semester</label>
                    <select id="semester" name="semester" class="form-select form-select-sm" title="Filter records by semester" onchange="this.form.submit()">
                        <option value="">All Semesters</option>
                        <% if (typeof semesterOptions !== 'undefined') { %>
                            <% semesterOptions.forEach(opt => { %>
                                <option value="<%= opt.value %>" <%= selectedSemester === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                <% if (typeof selectedSemester !== 'undefined' && selectedSemester) { %>
                    <a href="/dashboard" class="btn btn-outline-secondary btn-sm px-3" title="Clear the semester filter"><i class="fas fa-times me-1"></i> Clear</a>
                <% } %>
            </form>

            <div class="row g-4 mb-4">
                <div class="col-xl-8 col-lg-7">
                    <div class="overall-header-card p-4 h-100">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="text-uppercase text-indigo-300 fw-bold mb-2 small" style="letter-spacing: 2px;">Overall Institutional Rating</h6>
                                <div class="d-flex align-items-baseline">
                                    <h1 class="display-3 fw-bold mb-0"><%= typeof satisfactionRate !== 'undefined' ? satisfactionRate : '0.00' %></h1>
                                    <span class="fs-2 ms-2 opacity-50">%</span>
                                </div>
                                <div class="mt-3">
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill">
                                        <i class="fas fa-certificate me-1"></i> LEVEL 4 <%= typeof dashboardData !== 'undefined' ? dashboardData.overallLevel : 'OUTSTANDING' %>
                                    </span>
                                </div>
                            </div>
 
                            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                                <div class="p-3 bg-white bg-opacity-10 rounded-4">
                                    <small class="opacity-75 d-block mb-1">Current Data Year</small>
                                    <h6 class="mb-0 fw-bold"><i class="far fa-calendar-check me-2"></i><%= typeof dashboardData !== 'undefined' ? dashboardData.academicYear : 'A.Y. 2026-2027' %></h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-5">
                    <a href="/survey-records" class="stat-card p-4 shadow-sm border-0">
                        <div class="d-flex align-items-center mb-2">
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary me-3">
                                <i class="fas fa-clipboard-check fa-xl"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-0 small text-uppercase">Total Completed Surveys</h6>
                                <small class="text-primary small fw-bold">View Details <i class="fas fa-external-link-alt ms-1"></i></small>
                            </div>
                        </div>
                        <h2 class="count-up mb-0 text-dark"><%= typeof totalRespondents !== 'undefined' ? totalRespondents : '0' %></h2>
                        <div class="progress mt-3" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: 100%"></div>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Aggregate data from <strong><%= typeof totalOffices !== 'undefined' ? totalOffices : '0' %> registered offices</strong></p>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="chart-container-main">
                        <div class="d-md-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Cluster Performance Analytics</h5>
                                <p class="text-muted small mb-0">Comparison of Volume (Respondents) vs Quality (Satisfaction Rate)</p>
                            </div>
                            <div class="d-flex gap-3 small fw-bold mt-2 mt-md-0">
                                <div><i class="fas fa-square text-primary me-1"></i> Respondents Volume</div>
                                <div><i class="fas fa-minus text-success me-1" style="font-weight:900;"></i> Satisfaction Rating %</div>
                            </div>
                        </div>
                        <div style="height: 350px; position: relative;">
                            <canvas id="clusterAnalyticsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <% if (typeof clusterCards !== 'undefined' && clusterCards.length > 0) { %>
                <div class="row g-4">
                    <% clusterCards.forEach(card => { %>
                        <div class="col-xl-3 col-md-6">
                            <div class="cluster-mini-card" style="border-left: 5px solid <%= card.color || '#4f46e5' %>;">
                                <h6 class="text-muted fw-bold small text-uppercase mb-1"><%= card.name %></h6>
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3 class="fw-bold mb-0 text-dark"><span class="count-up"><%= card.rating %></span><span class="fs-6 opacity-50">%</span></h3>
                                    <span class="badge bg-light text-secondary border rounded-pill small"><i class="fas fa-users me-1"></i><%= card.respondents %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="row g-4">
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #4f46e5;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Office of the President</h6><div class="d-flex justify-content-between align-items-center"><h3 class="fw-bold mb-0">0.00%</h3><span class="badge bg-light text-secondary border rounded-pill small">0 Res.</span></div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #10b981;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Admin & Finance</h6><div class="d-flex justify-content-between align-items-center"><h3 class="fw-bold mb-0">0.00%</h3><span class="badge bg-light text-secondary border rounded-pill small">0 Res.</span></div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #f59e0b;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Research & Innovation</h6><div class="d-flex justify-content-between align-items-center"><h3 class="fw-bold mb-0">0.00%</h3><span class="badge bg-light text-secondary border rounded-pill small">0 Res.</span></div></div></div>
                    <div class="col-xl-3 col-md-6"><div class="cluster-mini-card" style="border-left-color: #8b5cf6;"><h6 class="text-muted small fw-bold text-uppercase mb-2">Academic Cluster</h6><div class="d-flex justify-content-between align-items-center"><h3 class="fw-bold mb-0">0.00%</h3><span class="badge bg-light text-secondary border rounded-pill small">0 Res.</span></div></div></div>
                </div>
            <% } %>

        </div>
    </div>
</div>

<div id="reportModal">
    <div class="modal-report-container shadow-lg">
        <div class="modal-controls">
            <button onclick="downloadPDF()" class="btn btn-danger btn-sm px-3"><i class="fas fa-file-pdf me-1"></i> Export PDF</button>
            <button onclick="window.print()" class="btn btn-secondary btn-sm px-3"><i class="fas fa-print me-1"></i> Print</button>
            <button onclick="closeReportModal()" class="btn btn-dark btn-sm px-3">Close</button>
        </div>

        <div id="printableReportDocument">
            <div class="header-container">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="logo-img">
                <div class="header-text">
                    <p class="republic">Republic of the Philippines</p>
                    <p class="college-name">Camarines Sur Polytechnic Colleges</p>
                    <p class="address">Nabua, Camarines Sur</p>
                </div>
            </div>
            <div class="header-line">
                <span class="form-code">CSPC-CQA-CSM-F01</span>
            </div>

            <h5 class="print-title">Client Satisfaction Measurement (CSM) Institutional Report</h5>
            <p class="print-period">Evaluation Period: <%= typeof dashboardData !== 'undefined' ? dashboardData.academicYear : 'A.Y. 2026-2027' %></p>

            <table class="print-table">
                <thead>
                    <tr>
                        <th class="num-col">No.</th>
                        <th>Office / Functional Unit Name</th>
                        <th class="score-col">Average Satisfaction Rating</th>
                        <th class="inter-col">Qualitative Interpretation</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof reportData !== 'undefined' && reportData.length > 0) { %>
                        <% reportData.forEach(cluster => { %>
                            <tr class="cluster-row">
                                <td colspan="4"><%= cluster.clusterName %></td>
                            </tr>
                            <% cluster.offices.forEach((office, index) => { %>
                                <tr>
                                    <td class="num-col"><%= index + 1 %></td>
                                    <td><%= office.name %></td>
                                    <td class="score-col"><%= office.score %>%</td>
                                    <td class="inter-col">
                                        <span class="text-uppercase"><%= office.interpretation %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="text-center py-3 text-muted">No survey response submissions loaded yet for this active period.</td>
                        </tr>
                    <% } %>
                    <tr class="total-row">
                        <td colspan="2" class="text-end">OVERALL INSTITUTIONAL SCORE:</td>
                        <td class="score-col"><%= typeof satisfactionRate !== 'undefined' ? satisfactionRate : '0.00' %>%</td>
                        <td class="inter-col"><%= typeof dashboardData !== 'undefined' ? dashboardData.overallLevel : 'OUTSTANDING' %></td>
                    </tr>
                </tbody>
            </table>

            <div class="print-footer">
                <div class="sign-block">
                    <p class="mb-0 text-muted">Prepared and Certified by:</p>
                    <p class="sign-name">DR. LAILANI R. MEDINA</p>
                    <p class="mb-0 text-secondary small">Director, Corporate Quality Assurance (CQA)</p>
                </div>
                <div class="sign-block text-end">
                    <p class="mb-0 text-muted">Noted and Approved by:</p>
                    <p class="sign-name">DR. AMADO A. OLIVA JR.</p>
                    <p class="mb-0 text-secondary small">College President</p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>

<script>
document.addEventListener("DOMContentLoaded", function() {
    
    // --- 1. NUMBER ANIMATION INCREMENT EFFECT ---
    document.querySelectorAll('.count-up').forEach(el => {
        const target = +el.innerText.replace(/[^0-9.]/g, '');
        let curr = 0;
        const speed = target / 40;
        
        const up = () => {
            curr += speed;
            if(curr < target) {
                el.innerHTML = target % 1 === 0 ? Math.ceil(curr).toLocaleString() : curr.toFixed(2);
                setTimeout(up, 20);
            } else { 
                el.innerHTML = target % 1 === 0 ? target.toLocaleString() : target.toFixed(2); 
            }
        };
        if(target > 0) up();
    });

    // --- 2. CHART.JS CONFIGURATION & RENDER PIPELINE ---
    const chartLabels = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.labels) : JSON.stringify(['Office of President', 'Admin & Finance', 'Research & Innov.', 'Academic Affairs', 'Other Offices']) %>;
    const chartRespondents = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.respondents) : JSON.stringify([0, 0, 0, 0, 0]) %>;
    const chartRatings = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.ratings) : JSON.stringify([0, 0, 0, 0, 0]) %>;

    const ctx = document.getElementById('clusterAnalyticsChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: chartLabels,
            datasets: [
                {
                    label: 'Respondents Count (Volume)',
                    data: chartRespondents,
                    backgroundColor: 'rgba(79, 70, 229, 0.85)',
                    borderColor: '#4f46e5',
                    borderWidth: 1,
                    borderRadius: 8,
                    yAxisID: 'y'
                },
                {
                    label: 'Satisfaction Rate % (Quality)',
                    data: chartRatings,
                    type: 'line',
                    borderColor: '#10b981',
                    backgroundColor: '#10b981',
                    borderWidth: 3,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#10b981',
                    pointRadius: 6,
                    pointHoverRadius: 8,
                    tension: 0.3,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 15,
                    cornerRadius: 10,
                    callbacks: {
                        label: function(context) {
                            if (context.dataset.type === 'line') {
                                return `Satisfaction: ${context.raw}%`;
                            }
                            return `Respondents: ${context.raw.toLocaleString()}`;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    position: 'left',
                    title: { display: true, text: 'Total Volume of Respondents', font: { weight: 'bold' } },
                    grid: { color: '#f1f5f9' }
                },
                y1: {
                    position: 'right',
                    min: 0,
                    max: 100,
                    title: { display: true, text: 'Satisfaction Percentage (%)', font: { weight: 'bold' } },
                    grid: { drawOnChartArea: false },
                    ticks: { callback: function(value) { return value + '%'; } }
                },
                x: {
                    grid: { display: false },
                    ticks: { font: { weight: '600' } }
                }
            }
        }
    });
});

// --- 3. CONTROLS MANAGEMENT FUNCTIONS FOR POPUP REPORT MODAL ---
function openReportModal() {
    document.getElementById('reportModal').style.display = 'block';
    document.body.style.overflow = 'hidden'; 
}

function closeReportModal() {
    document.getElementById('reportModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

function downloadPDF() {
    const element = document.getElementById('printableReportDocument');
    const opt = {
        margin:       [0.5, 0.5, 0.5, 0.5],
        filename:     'CSPC-CSM-Institutional-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
    };
    html2pdf().set(opt).from(element).save();
}
</script>

</body>
</html>