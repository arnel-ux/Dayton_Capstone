                                        <div>
                                            <div class="rank-name"><%= o.name %></div>
                                            <div class="rank-sub"><%= o.cluster %> &middot; <%= o.respondents %> respondents</div>
                                        </div>
                                    </div>
                                    <span class="rank-score bad"><%= o.score.toFixed(2) %>%</span>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="empty-state-mini">
                                <i class="fas fa-chart-simple"></i>
                                <p>Not enough data yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

