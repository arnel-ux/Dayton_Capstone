<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Shared CQA report letterhead/footer/pagination rules (views/layout/report-header.ejs,
         views/layout/report-footer.ejs) — see public/css/report.css. -->
    <link rel="stylesheet" href="/css/report.css">
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            --bg-body: #f1f5f9;
            --text-main: #1f2937;
            --card-bg: #ffffff;
        }

        html[data-bs-theme="dark"] {
            --bg-body: #0b1526;
            --text-main: #e2e8f0;
            --card-bg: #141d30;
        }

        body { background-color: var(--bg-body); font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-main); }

        html[data-bs-theme="dark"] .stat-card,
        html[data-bs-theme="dark"] .cluster-mini-card,
        html[data-bs-theme="dark"] .chart-container-main {
            background: var(--card-bg);
        }

        .overall-header-card {
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            color: white;
            border-radius: 20px;
            position: relative;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .stat-card {
            background: white;
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 18px;
            transition: all 0.3s ease;
            height: 100%;
            text-decoration: none !important;
            display: flex;
            flex-direction: column;
            color: inherit;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .cluster-mini-card {
            background: white;
            border-left: 5px solid #ffcc00;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
            height: 100%;
        }

        .chart-container-main {
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .count-up { font-size: 2.5rem; font-weight: 800; }

        /* PRINT STYLING - Hidden by default */
        #print-area { display: none; }

        @media print {
            #wrapper { display: none !important; } /* Tago ang dashboard */
            #print-area { 
                display: block !important; 
                background-color: white;
            }
            body { background-color: white !important; }
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            /* Letter-size @page rule lives in public/css/report.css, shared with
               every other SQD report. */
        }

        /* Iyong Report Styles */
        /* Letterhead (report-header-block/etc.) and page-footer rules live in
           public/css/report.css, shared with every other SQD report — as does the
           cluster table (.cluster-report-table) and signature/legend block
           (.cluster-report-signatures) rendered by layout/report-cluster-table.ejs
           and layout/report-signatories.ejs below. */
        .print-title { text-align: center; font-weight: bold; font-size: 13pt; line-height: 1.3; margin: 10px 0 6px; }
        .print-period { text-align: center; font-size: 10.5pt; font-weight: bold; margin: 0 0 16px; }

        @media print {
            #print-area { box-sizing: border-box; overflow: visible; }
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid px-4 py-4">
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">Analytics Dashboard</h4>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8 col-lg-7">
                    <div class="overall-header-card p-4 h-100">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h6 class="text-uppercase text-indigo-300 fw-bold mb-2 small" style="letter-spacing: 2px;">Overall Institutional Rating</h6>
                                <div class="d-flex align-items-baseline">
                                    <h1 class="display-3 fw-bold mb-0"><%= typeof overallRating !== 'undefined' ? overallRating : '0.00' %></h1>
                                    <span class="fs-2 ms-2 opacity-50">%</span>
                                </div>
                                <div class="mt-3">
                                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 rounded-pill">
                                        <i class="fas fa-certificate me-1"></i> <%= (typeof overallInterpretation !== 'undefined' ? overallInterpretation : 'Poor').toUpperCase() %>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                                <div class="p-3 bg-white bg-opacity-10 rounded-4">
                                    <small class="opacity-75 d-block mb-1">Period Covered</small>
                                    <h6 class="mb-0 fw-bold"><i class="far fa-calendar-check me-2"></i><%= typeof periodLabel !== 'undefined' ? periodLabel : 'All Periods' %></h6>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-5">
                    <a href="/survey-records" class="stat-card p-4 shadow-sm border-0">
                        <div class="d-flex align-items-center mb-2">
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-primary me-3">
                                <i class="fas fa-clipboard-check fa-xl"></i>
                            </div>
                            <div>
                                <h6 class="text-muted fw-bold mb-0 small text-uppercase">Total Completed Surveys</h6>
                                <small class="text-primary small fw-bold">View Details <i class="fas fa-external-link-alt ms-1"></i></small>
                            </div>
                        </div>
                        <h2 class="count-up mb-0 text-dark"><%= typeof totalRespondents !== 'undefined' ? totalRespondents : 0 %></h2>
                        <div class="progress mt-3" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: <%= typeof overallRating !== 'undefined' ? overallRating : 0 %>%"></div>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Aggregate data from <strong><%= typeof clusterCards !== 'undefined' ? clusterCards.length : 0 %> main clusters</strong>, <strong><%= typeof totalOffices !== 'undefined' ? totalOffices : 0 %> offices</strong></p>
                    </a>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <div class="chart-container-main">
                        <div class="d-md-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Cluster Performance Analytics</h5>
                                <p class="text-muted small">Comparison of volume (Respondents) vs Quality (Satisfaction Rate)</p>
                            </div>
                            <div class="d-flex gap-3 small fw-bold">
                                <div><i class="fas fa-square text-primary me-1"></i> Respondents</div>
                                <div><i class="fas fa-line text-success me-1"></i> Satisfaction %</div>
                            </div>
                        </div>
                        <div style="height: 380px;">
                            <canvas id="clusterAnalyticsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold text-dark text-uppercase mb-3 small" style="letter-spacing: 1px;">Cluster Summary Breakdown</h6>
            <div class="row g-4">
                <% if (typeof clusterCards !== 'undefined' && clusterCards.length > 0) { %>
                    <% clusterCards.forEach(card => { %>
                        <div class="col-xl-3 col-md-6">
                            <div class="cluster-mini-card" style="border-left-color: <%= card.color %>;">
                                <h6 class="text-muted small fw-bold text-uppercase mb-2"><%= card.name %></h6>
                                <div class="d-flex justify-content-between align-items-end">
                                    <h3 class="fw-bold mb-0"><%= card.rating %>%</h3>
                                    <div class="text-end">
                                        <span class="badge bg-light text-secondary border"><%= card.respondents %> Res.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12">
                        <p class="text-muted text-center py-4 mb-0">No survey response submissions loaded yet for this period.</p>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>

<div id="print-area">
    <%- include('layout/report-header', { showSQDFormCode: false }) %>

    <p class="print-title">Client Satisfaction Measurement Survey Result<br>Per Cluster</p>
    <p class="print-period">Period covered : <%= typeof periodLabel !== 'undefined' ? periodLabel : 'All Periods' %></p>

    <%- include('layout/report-cluster-table', { reportData: typeof reportData !== 'undefined' ? reportData : [] }) %>

    <%- include('layout/report-signatories') %>

    <%- include('layout/report-footer') %>
</div>

<%- include('layout/footer') %>

<script>
document.addEventListener("DOMContentLoaded", function() {
    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
    
    const ctx = document.getElementById('clusterAnalyticsChart').getContext('2d');
    const barGradient = ctx.createLinearGradient(0, 0, 0, 400);
    barGradient.addColorStop(0, '#251d3a');
    barGradient.addColorStop(1, '#2a2550');

    const chartLabels = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.labels) : '[]' %>;
    const chartRespondents = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.respondents) : '[]' %>;
    const chartRatings = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.ratings) : '[]' %>;

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: chartLabels,
            datasets: [
                {
                    label: 'Respondent Volume',
                    data: chartRespondents,
                    backgroundColor: barGradient,
                    borderRadius: 10,
                    barThickness: 50,
                    yAxisID: 'y',
                    order: 2
                },
                {
                    label: 'Satisfaction Rating (%)',
                    data: chartRatings,
                    type: 'line',
                    borderColor: '#10b981',
                    borderWidth: 4,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#10b981',
                    pointBorderWidth: 3,
                    pointRadius: 6,
                    tension: 0.4,
                    yAxisID: 'y1',
                    order: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { beginAtZero: true, position: 'left' },
                y1: { position: 'right', beginAtZero: true, max: 100 }
            }
        }
    });

    // Count-up animation
    document.querySelectorAll('.count-up').forEach(el => {
        const target = +el.innerText;
        let curr = 0;
        const up = () => {
            curr += (target / 40);
            if(curr < target) {
                el.innerText = Math.ceil(curr).toLocaleString();
                setTimeout(up, 25);
            } else { el.innerText = target.toLocaleString(); }
        };
        up();
    });
});
</script>

</body>
</html>