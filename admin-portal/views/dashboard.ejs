<script>
document.addEventListener("DOMContentLoaded", function() {

    const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // --- 0b. NATIVE HOVER TOOLTIP FOR TRUNCATED CHART AXIS LABELS ---
    // Chart.js clips long category labels (office/cluster names) that don't
    // fit the tick area and gives them no tooltip of their own — only bars
    // get one. This watches mouse position over the label zone and swaps in
    // the full text as a native title attribute so it still shows on hover.
    function enableAxisLabelTooltips(chart, canvas, labels, axis) {
        canvas.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const area = chart.chartArea;
            if (!area) return;
            const inLabelZone = axis === 'y' ? mx < area.left : my > area.bottom;
            if (!inLabelZone) { if (canvas.title) canvas.title = ''; return; }

            const scale = axis === 'y' ? chart.scales.y : chart.scales.x;
            const cursorPos = axis === 'y' ? my : mx;
            let closestIdx = -1, minDist = Infinity;
            labels.forEach((_, i) => {
                const pixel = scale.getPixelForTick(i);
                const dist = Math.abs(pixel - cursorPos);
                if (dist < minDist) { minDist = dist; closestIdx = i; }
            });
            canvas.title = (closestIdx >= 0 && minDist < 18) ? labels[closestIdx] : '';
        });
        canvas.addEventListener('mouseleave', () => { canvas.title = ''; });
    }

    // Shortens a long axis label so Chart.js never tries to draw more text
    // than the tick area can hold (which is what was clipping names like
    // "Research and Development Services Office" off the left/right edge).
    function truncateLabel(text, maxLen) {
        if (!text || text.length <= maxLen) return text;
        return text.slice(0, maxLen - 1).trimEnd() + '…';
    }

    // Wraps a long label into several shorter lines (returned as an array)
    // so Chart.js's tooltip box — which sizes itself to its widest line —
    // stays narrow enough to fit on-canvas instead of getting cut off.
    function wrapLabel(text, maxCharsPerLine) {
        if (!text) return text;
        const words = text.split(' ');
        const lines = [];
        let current = '';
        words.forEach(word => {
            const candidate = current ? `${current} ${word}` : word;
            if (candidate.length > maxCharsPerLine && current) {
                lines.push(current);
                current = word;
            } else {
                current = candidate;
            }
        });
        if (current) lines.push(current);
        return lines;
    }

    // --- 0. SHARED EASED NUMBER ANIMATION (rAF-driven, respects reduced motion) ---
    function animateNumber(el, target, opts) {
        opts = opts || {};
        const decimals = opts.decimals || 0;
        const duration = opts.duration || 1000;
        const format = opts.format || function (n) { return decimals ? n.toFixed(decimals) : Math.round(n).toLocaleString(); };
        const onUpdate = opts.onUpdate || function () {};

        if (prefersReducedMotion || !(target > 0)) {
            el.innerHTML = format(target);
            onUpdate(target);
            return;
        }

        const start = performance.now();
        function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

        function tick(now) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const value = target * easeOutCubic(progress);
            el.innerHTML = format(value);
            onUpdate(value);
            if (progress < 1) requestAnimationFrame(tick);
            else { el.innerHTML = format(target); onUpdate(target); }
        }
        requestAnimationFrame(tick);
    }

    // --- 1. TOTAL SURVEYS COUNT-UP ---
    document.querySelectorAll('.count-up').forEach(el => {
        const target = +el.innerText.replace(/[^0-9.]/g, '');
        animateNumber(el, target, { duration: 1000 });
    });

    // --- 2. HERO SCORE + RADIAL GAUGE ---
    const heroScoreEl = document.getElementById('heroScoreValue');
    const heroGaugeFill = document.getElementById('heroGaugeFill');
    if (heroScoreEl) {
        const target = parseFloat(heroScoreEl.getAttribute('data-target')) || 0;
        const circumference = 339.29;
        const clampedPct = Math.max(0, Math.min(100, target));
        if (heroGaugeFill) {
            if (prefersReducedMotion) {
                heroGaugeFill.style.transition = 'none';
                heroGaugeFill.style.strokeDashoffset = String(circumference * (1 - clampedPct / 100));
            } else {
                // kick the transition after paint so it animates from the full offset
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        heroGaugeFill.style.strokeDashoffset = String(circumference * (1 - clampedPct / 100));
                    });
                });
            }
        }
        animateNumber(heroScoreEl, target, { decimals: 2, duration: 1100 });
    }

    // --- 4. SCROLL REVEAL + TOPIC BAR FILL (IntersectionObserver) ---
    const revealTargets = document.querySelectorAll('.reveal-section');
    if ('IntersectionObserver' in window && !prefersReducedMotion) {
        const revealObserver = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                    // Charts inside a .reveal-section are created (and finish
                    // their entrance animation) at page-load time, while the
                    // section itself still sits at opacity:0 — so the draw-in
                    // animation happens invisibly before the user ever scrolls
                    // here. Replaying it exactly when the section fades into
                    // view makes it actually visible.
                    entry.target.querySelectorAll('canvas').forEach(canvasEl => {
                        const chartInstance = typeof Chart !== 'undefined' && Chart.getChart ? Chart.getChart(canvasEl) : null;
                        if (chartInstance) {
                            chartInstance.reset();
                            chartInstance.update();
                        }
                    });
                }
            });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        revealTargets.forEach(el => revealObserver.observe(el));
    } else {
        revealTargets.forEach(el => el.classList.add('is-visible'));
    }

    // --- 5. CHART.JS CONFIGURATION & RENDER PIPELINE ---
    const chartLabels = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.labels) : JSON.stringify(['Office of President', 'Admin & Finance', 'Research & Innov.', 'Academic Affairs', 'Other Offices']) %>;
    const chartRespondents = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.respondents) : JSON.stringify([0, 0, 0, 0, 0]) %>;
    const chartRatings = <%- typeof chartData !== 'undefined' ? JSON.stringify(chartData.ratings) : JSON.stringify([0, 0, 0, 0, 0]) %>;

    const ctx = document.getElementById('clusterAnalyticsChart').getContext('2d');
    const barGradientGold = ctx.createLinearGradient(0, 0, 0, 320);
    barGradientGold.addColorStop(0, '#ffcc00');
    barGradientGold.addColorStop(1, '#ffcc00');
    const barGradientNavy = ctx.createLinearGradient(0, 0, 0, 320);
    barGradientNavy.addColorStop(0, '#2a2550');
    barGradientNavy.addColorStop(1, '#251d3a');

    // Cluster Performance chart: Respondents (Volume) and Satisfaction Rating
    // are two separate metrics on very different scales (raw counts vs. a
    // 0-100% score), so instead of cramming them into one dual-axis chart
    // they're rendered one at a time — the toggle above the chart switches
    // which metric is showing, re-drawing (and re-animating) the bars.
    const clusterMetrics = {
        respondents: {
            label: 'Respondents (Volume)',
            data: chartRespondents,
            color: barGradientNavy,
            hoverColor: '#2a2550',
            axisTitle: 'Total Respondents',
            max: undefined,
            tooltip: (v) => `Respondents: ${v.toLocaleString()}`,
            subtitle: 'Respondent volume per cluster'
        },
        rating: {
            label: 'Satisfaction Rating (%)',
            data: chartRatings,
            color: barGradientGold,
            hoverColor: '#ffcc00',
            axisTitle: 'Satisfaction Rating (%)',
            max: 100,
            tooltip: (v) => `Satisfaction: ${v}%`,
            subtitle: 'Satisfaction rating per cluster'
        }
    };

    let clusterChart = null;
    const clusterSubtitleEl = document.getElementById('clusterChartSubtitle');

    function renderClusterChart(metricKey) {
        const metric = clusterMetrics[metricKey];
        if (clusterSubtitleEl) clusterSubtitleEl.textContent = metric.subtitle;

        if (clusterChart) {
            clusterChart.data.datasets[0].label = metric.label;
            clusterChart.data.datasets[0].data = metric.data;
            clusterChart.data.datasets[0].backgroundColor = metric.color;
            clusterChart.data.datasets[0].hoverBackgroundColor = metric.hoverColor;
            clusterChart.options.scales.y.title.text = metric.axisTitle;
            clusterChart.options.scales.y.max = metric.max;
            clusterChart.options.plugins.tooltip.callbacks.label = (context) => metric.tooltip(context.raw);
            clusterChart.reset();
            clusterChart.update();
            return;
        }

        clusterChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: metric.label,
                    data: metric.data,
                    backgroundColor: metric.color,
                    hoverBackgroundColor: metric.hoverColor,
                    borderRadius: 8,
                    borderSkipped: false,
                    barPercentage: 0.55,
                    categoryPercentage: 0.6,
                    maxBarThickness: 48
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: prefersReducedMotion ? false : { duration: 1000, easing: 'easeOutQuart' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleFont: { weight: '700', family: "'Plus Jakarta Sans', sans-serif" },
                        bodyFont: { family: "'Plus Jakarta Sans', sans-serif" },
                        padding: 12,
                        cornerRadius: 10,
                        displayColors: false,
                        callbacks: { label: (context) => metric.tooltip(context.raw) }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: metric.max,
                        title: { display: true, text: metric.axisTitle, font: { weight: 'bold' } },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { weight: '600' } }
                    }
                }
            }
        });
    }

    renderClusterChart('respondents');

    document.querySelectorAll('.chart-toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            if (btn.classList.contains('active')) return;
            document.querySelectorAll('.chart-toggle-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderClusterChart(btn.getAttribute('data-metric'));
        });
    });

    // --- 6. SENTIMENT DOUGHNUT ---
    const sentimentCtx = document.getElementById('sentimentChart').getContext('2d');
    new Chart(sentimentCtx, {
        type: 'doughnut',
        data: {
            labels: ['Positive', 'Neutral', 'Negative'],
            datasets: [{
                data: [
                    <%= sentimentBreakdown.Positive %>,
                    <%= sentimentBreakdown.Neutral %>,
                    <%= sentimentBreakdown.Negative %>
                ],
                backgroundColor: ['#ffcc00', '#2a2550', '#251d3a'],
                borderColor: '#fff',
                borderWidth: 3,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            animation: prefersReducedMotion ? false : { duration: 900, easing: 'easeOutQuart' },
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#0f172a',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const pct = total ? Math.round((context.raw / total) * 100) : 0;
                            return `${context.label}: ${context.raw} (${pct}%)`;
                        }
                    }
                }
            }
        }
    });

    // --- 7. PIE CHART: Respondent Share by Cluster ---
    const clusterShareEl = document.getElementById('clusterShareChart');
    if (clusterShareEl) {
        const clusterShareLabels = <%- typeof clusterCards !== 'undefined' ? JSON.stringify(clusterCards.map(c => c.name)) : '[]' %>;
        const clusterShareData = <%- typeof clusterCards !== 'undefined' ? JSON.stringify(clusterCards.map(c => Number(c.respondents) || 0)) : '[]' %>;
        const clusterShareColors = <%- typeof clusterCards !== 'undefined' ? JSON.stringify(clusterCards.map(c => c.color || '#251d3a')) : '[]' %>;

        new Chart(clusterShareEl.getContext('2d'), {
            type: 'pie',
            data: {
                labels: clusterShareLabels,
                datasets: [{
                    data: clusterShareData,
                    backgroundColor: clusterShareColors,
                    borderColor: '#fff',
                    borderWidth: 2,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: prefersReducedMotion ? false : { duration: 900, easing: 'easeOutQuart' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = total ? Math.round((context.raw / total) * 100) : 0;
                                return `${context.label}: ${context.raw.toLocaleString()} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        // Compact custom legend (dot + name + value + %) instead of Chart.js's
        // auto-wrapping legend, which crowded this card when it sat in a
        // narrow 4-across row.
        const legendEl = document.getElementById('clusterShareLegend');
        if (legendEl) {
            const shareTotal = clusterShareData.reduce((a, b) => a + b, 0);
            const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            legendEl.innerHTML = clusterShareLabels.map((label, i) => {
                const value = clusterShareData[i];
                const pct = shareTotal ? Math.round((value / shareTotal) * 100) : 0;
                const safeLabel = escapeHtml(label);
                return `<div class="chart-legend-row">
                    <span class="legend-dot" style="background:${clusterShareColors[i]};"></span>
                    <span class="legend-name" title="${safeLabel}">${safeLabel}</span>
                    <span class="legend-value">${value.toLocaleString()}</span>
                    <span class="legend-pct">${pct}%</span>
                </div>`;
            }).join('');
        }
    }

    // --- 9. SMOOTH STACKED AREA CHART: Recent Submissions by Office ---
    // Groups the same recent-submissions data the old timeline showed by
    // office, keeping the sentiment breakdown (each area layer is a
    // sentiment count) instead of a flat activity feed.
    const recentSubEl = document.getElementById('recentSubmissionsChart');
    if (recentSubEl) {
        const recentOffices = <%- typeof recentSubmissions !== 'undefined' ? JSON.stringify(recentSubmissions.map(r => r.officeName)) : '[]' %>;
        const recentSentiments = <%- typeof recentSubmissions !== 'undefined' ? JSON.stringify(recentSubmissions.map(r => r.sentiment)) : '[]' %>;

        const officeTally = {};
        recentOffices.forEach((office, i) => {
            if (!officeTally[office]) officeTally[office] = { Positive: 0, Neutral: 0, Negative: 0 };
            const sentiment = recentSentiments[i];
            if (officeTally[office][sentiment] !== undefined) officeTally[office][sentiment]++;
        });
        const officeNames = Object.keys(officeTally);

        const recentSubChart = new Chart(recentSubEl.getContext('2d'), {
            type: 'line',
            data: {
                labels: officeNames,
                datasets: [
                    { label: 'Positive', data: officeNames.map(o => officeTally[o].Positive), borderColor: '#ffcc00', backgroundColor: 'rgba(255, 204, 0, 0.35)', fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#ffcc00', pointBorderColor: '#fff', pointBorderWidth: 1.5 },
                    { label: 'Neutral', data: officeNames.map(o => officeTally[o].Neutral), borderColor: '#2a2550', backgroundColor: 'rgba(42, 37, 80, 0.35)', fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#2a2550', pointBorderColor: '#fff', pointBorderWidth: 1.5 },
                    { label: 'Negative', data: officeNames.map(o => officeTally[o].Negative), borderColor: '#251d3a', backgroundColor: 'rgba(37, 29, 58, 0.35)', fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#251d3a', pointBorderColor: '#fff', pointBorderWidth: 1.5 }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                animation: prefersReducedMotion ? false : { duration: 1000, easing: 'easeOutQuart' },
                plugins: {
                    legend: {
                        display: true, position: 'top', align: 'end',
                        labels: { boxWidth: 10, usePointStyle: true, pointStyle: 'circle', font: { size: 11, weight: '600', family: "'Plus Jakarta Sans', sans-serif" } }
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            title: (items) => wrapLabel(officeNames[items[0].dataIndex], 26),
                            label: (context) => `${context.dataset.label}: ${context.raw}`
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true, grid: { display: false },
                        ticks: { font: { size: 11, weight: '600' }, callback: (value, index) => truncateLabel(officeNames[index], 14) }
                    },
                    y: { stacked: true, beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#f1f5f9' } }
                }
            }
        });
        enableAxisLabelTooltips(recentSubChart, recentSubEl, officeNames, 'x');
    }

    // --- 10. HORIZONTAL BAR CHARTS: Top / Bottom Performing Offices ---
    function renderRankChart(canvasId, offices, barColor) {
        const el = document.getElementById(canvasId);
        if (!el || !offices.length) return;
        const labels = offices.map(o => o.name);
        const chart = new Chart(el.getContext('2d'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    data: offices.map(o => o.score),
                    backgroundColor: barColor,
                    borderRadius: 4,
                    barPercentage: 0.6,
                    categoryPercentage: 0.7
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                animation: prefersReducedMotion ? false : { duration: 1000, easing: 'easeOutQuart' },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            title: (items) => wrapLabel(labels[items[0].dataIndex], 26),
                            label: (context) => `${context.raw.toFixed(2)}%`
                        }
                    }
                },
                scales: {
                    x: { beginAtZero: true, max: 100, grid: { color: '#f1f5f9' }, ticks: { callback: (v) => v + '%' } },
                    y: {
                        grid: { display: false },
                        ticks: { font: { size: 11, weight: '600' }, autoSkip: false, callback: (value, index) => truncateLabel(labels[index], 20) }
                    }
                }
            }
        });
        enableAxisLabelTooltips(chart, el, labels, 'y');
    }

    renderRankChart('topOfficesChart', <%- typeof topOffices !== 'undefined' ? JSON.stringify(topOffices.map(o => ({ name: o.name, score: o.score }))) : '[]' %>, '#ffcc00');
    renderRankChart('bottomOfficesChart', <%- typeof bottomOffices !== 'undefined' ? JSON.stringify(bottomOffices.map(o => ({ name: o.name, score: o.score }))) : '[]' %>, '#251d3a');
});

// --- 7. CONTROLS MANAGEMENT FUNCTIONS FOR POPUP REPORT MODAL ---
function openReportModal() {
    document.getElementById('reportModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function closeReportModal() {
    document.getElementById('reportModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

function downloadPDF() {
    const element = document.getElementById('printableReportDocument');
    // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
    // html2pdf's margin array is [top, left, bottom, right] (not CSS order).
    const opt = {
        margin:       [0.5, 0.5, 0.25, 0.25],
        filename:     'CSPC-CSM-Institutional-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false, letterRendering: true, scrollY: 0 },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' },
        pagebreak:    { mode: ['css', 'legacy'], avoid: ['.report-header-block', '.page-footer', '.print-footer', 'tr'] }
    };
    html2pdf().set(opt).from(element).save();
}

function openDashboardReportModal() {
    document.getElementById('dashboardReportModal').style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function closeDashboardReportModal() {
    document.getElementById('dashboardReportModal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

function downloadDashboardReportPDF() {
    const element = document.getElementById('printableDashboardReportDocument');
    // Letter (8.5in x 11in) portrait, matching CSPC's official print spec.
    // html2pdf's margin array is [top, left, bottom, right] (not CSS order).
    const opt = {
        margin:       [0.5, 0.5, 0.25, 0.25],
        filename:     'CSPC-Dashboard-Report.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false, letterRendering: true, scrollY: 0 },
        jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' },
        pagebreak:    { mode: ['css', 'legacy'], avoid: ['.report-header-block', '.page-footer', '.print-footer', 'tr'] }
    };
    html2pdf().set(opt).from(element).save();
}
</script>

</body>
</html>
