<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // New-tab auto-login guard: office sessions ride the same hand-rolled
        // admin-session cookie as admin logins, so a brand new tab that merely
        // inherited that cookie (typed the URL, duplicated the tab, opened a
        // bookmark) would otherwise land here fully "logged in" without ever
        // having submitted office credentials in THAT tab. sessionStorage is
        // scoped per tab (never copied to a freshly opened one), so it's used
        // here purely as a "did this tab actually authenticate" marker: the
        // login redirect tags the very next page load with ?loggedin=1, which this
        // script converts into the marker before the URL is cleaned up. Same
        // pattern as /office-approvals, the admin dashboard (layout/header.ejs)
        // and /client-survey.
        // Note: this is a client-side UX guard, not a security boundary — the
        // page markup briefly reaches the browser before this (first) script
        // redirects it away, so it doesn't stop someone with devtools/view-source
        // open on that same already-logged-in machine.
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.has('loggedin')) {
                    sessionStorage.setItem('cqa_office_tab_ok', '1');
                    params.delete('loggedin');
                    var cleanedSearch = params.toString();
                    var cleanedUrl = window.location.pathname + (cleanedSearch ? '?' + cleanedSearch : '') + window.location.hash;
                    window.history.replaceState({}, '', cleanedUrl);
                } else if (sessionStorage.getItem('cqa_office_tab_ok') !== '1') {
                    window.location.replace('/login?error=' + encodeURIComponent('Please log in to continue.'));
                }
            } catch (e) { /* sessionStorage unavailable (privacy mode, etc.) — fail open */ }
        })();
    </script>
    <%- include('layout/header') %>
    <%
    %>
    <style>
        /* ==========================================================
           BASE / LAYOUT
           ========================================================== */
        * { box-sizing: border-box; }
        /* overflow-x must be `clip`, never `hidden`, here. `hidden` turns
           html/body into a scroll container, and a scroll container is what
           .topbar's `position: sticky` then sticks to instead of the
           viewport — which is why the header scrolled away with the page.
           `clip` cuts off the same horizontal overflow without creating
           that scroll container, so sticky keeps working.
           overflow-y is pinned to `visible` so the pair can never fall back
           to the scroll-container behaviour in a browser that lacks `clip`. */
        html, body {
            overflow-x: clip;
            overflow-y: visible;
        }
        body {
            background: #f0f3f9;
            font-family: var(--font-ui);
            min-height: 100vh;
            color: #0f172a;
        }

        /* "Viewing offline" pill — same amber style, font-size and padding
           as index.ejs / login.ejs / office-approvals.ejs for a consistent
           look across the whole system. Its own centered row under the
           topbar, not squeezed next to Logout/portal-status, so it never
           overlaps or covers those on narrow screens. */
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

        /* ==========================================================
           PAGE HEADER
           ========================================================== */
        .content-wrap {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 1.25rem 3rem;
        }
        .page-header {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.75rem 0 1.25rem;
        }
        .page-header h2 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1a1436;
            margin: 0 0 0.3rem;
        }
        .page-header p {
            font-size: 0.9rem;
            color: #64748b;
            margin: 0;
            max-width: 46ch;
        }
        .pending-badge {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #ffffff;
            border: 1px solid #e5e7f0;
            border-radius: 14px;
            padding: 0.7rem 1.1rem;
            box-shadow: 0 6px 18px -10px rgba(30, 23, 56, 0.25);
            flex: 0 0 auto;
        }
        .pending-badge .icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2d1f57, #4b3a86);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex: 0 0 auto;
        }
        .pending-badge .num {
            font-size: 1.25rem;
            font-weight: 800;
            color: #1a1436;
            line-height: 1.1;
        }
        .pending-badge .label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #94a3b8;
        }

        /* ==========================================================
           HISTORY TABLE
           ========================================================== */
        .approvals-table-card {
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            box-shadow: 0 6px 20px -12px rgba(15, 23, 42, 0.18);
            overflow: hidden;
        }
        .approvals-table-scroll {
            overflow-x: auto;
        }
        .approvals-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 920px;
        }
        .approvals-table col.col-respondent { width: 18%; }
        .approvals-table col.col-service { width: 20%; }
        .approvals-table col.col-status { width: 13%; }
        .approvals-table col.col-reason { width: 22%; }
        .approvals-table col.col-email { width: 17%; }
        .approvals-table col.col-reviewed { width: 15%; }

        .approvals-table thead th {
            background: #f8f9fc;
            border-bottom: 1px solid #e9ebf3;
            font-size: 0.66rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #94a3b8;
            padding: 0.8rem 1rem;
            text-align: left;
            white-space: nowrap;
        }
        .approvals-table thead th i { color: #7c6bb0; margin-right: 0.4rem; }
        .approvals-table tbody tr.data-row {
            border-bottom: 1px solid #f0f1f7;
            animation: rowIn 0.3s ease both;
        }
        .approvals-table tbody tr.data-row:nth-child(4n+1) { background: #fbfbfe; }
        .approvals-table tbody tr.data-row:hover { background: #f4f4fd; }
        .approvals-table tbody tr.data-row:last-child { border-bottom: none; }
        @keyframes rowIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @media (prefers-reduced-motion: reduce) {
            .approvals-table tbody tr.data-row { animation: none; }
        }
        .approvals-table td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            font-size: 0.84rem;
            color: #1a1436;
            line-height: 1.35;
        }
        .respondent-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; min-width: 0; }
        .cell-label-inline {
            font-size: 0.64rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #94a3b8;
        }
        .toggle-chevron { display: none; }
        .respondent-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: #14102b;
            margin: 0;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        /* The same reference number the client is shown in their emailed
           decline notice (see sendSurveyDeclinedEmail in server.js). Printed
           here so a client who quotes "PSS-42" can actually be looked up —
           without it the number in that email matched nothing anywhere in
           this system. "PSS" = pending survey submission; it is the
           pending_survey_submissions row id, NOT the CSM reference, which
           only exists once a submission is approved and inserted into
           survey_responses. */
        .submission-ref {
            flex: 0 0 auto;
            align-self: flex-start;
            font-family: 'Courier New', Courier, monospace;
            font-size: 0.66rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            color: #64748b;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 5px;
            padding: 0.08rem 0.35rem;
            white-space: nowrap;
        }
        .cell-value {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            cursor: default;
        }
        .cell-value.wrap-value {
            white-space: normal;
            overflow-wrap: break-word;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .cell-sub {
            font-size: 0.76rem;
            color: #94a3b8;
            font-weight: 600;
            white-space: nowrap;
            margin-top: 0.15rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .status-badge.approved { color: #166534; background: #dcfce7; border: 1px solid #bbf7d0; }
        .status-badge.declined { color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; }
        .status-badge i { font-size: 0.58rem; }
        .decline-reason-note {
            font-size: 0.76rem;
            color: #94a3b8;
            font-style: italic;
            margin-top: 0.3rem;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* ==========================================================
           EMPTY STATE
           ========================================================== */
        .empty-state {
            text-align: center;
            padding: 3.5rem 1.5rem;
            color: #64748b;
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            margin-top: 1rem;
        }
        .empty-state .icon-wrap {
            width: 68px;
            height: 68px;
            margin: 0 auto 1.1rem;
            border-radius: 50%;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state .icon-wrap i { font-size: 1.8rem; color: #4338ca; }
        .empty-state h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1a1436;
            margin-bottom: 0.4rem;
        }
        .empty-state p {
            font-size: 0.88rem;
            margin: 0 auto 1rem;
            max-width: 40ch;
        }

        /* ==========================================================
           STATUS FILTER (phones only)
           ==========================================================
           The desktop table has a Status column that can be read down the
           page, so it needs no filter. A phone shows one card at a time, and
           "show me only the declined ones" is the other half of what a
           staffer comes to History for — so the two statuses get their own
           views of the same list here, without a second page or a round trip
           to the server. Hidden entirely on desktop. */
        .history-filter { display: none; }
        .history-filter-empty { display: none; }

        /* ==========================================================
           RESPONSIVE
           ========================================================== */
        @media (max-width: 767px) {
            .content-wrap { padding: 0 0.85rem 2.5rem; }
            .page-header { padding-top: 1.25rem; gap: 0.85rem; }
            .page-header h2 { font-size: 1.3rem; }
            .page-header p { font-size: 0.84rem; max-width: 100%; }
            .pending-badge { width: 100%; }

            /* --- Status filter chips ---------------------------------- */
            .history-filter {
                display: flex;
                gap: 0.4rem;
                margin: 0 0.85rem 0.25rem;
            }
            .hf-chip {
                flex: 1 1 0;
                min-width: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.35rem;
                padding: 0.5rem 0.4rem;
                border: 1px solid #e9ebf3;
                border-radius: 11px;
                background: #ffffff;
                color: #64748b;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.2px;
                line-height: 1;
                cursor: pointer;
                /* The tap target is the whole chip; 44px keeps it reachable
                   for a thumb without making the row look like a toolbar. */
                min-height: 44px;
            }
            .hf-chip .hf-count {
                font-size: 0.68rem;
                font-weight: 800;
                padding: 0.1rem 0.36rem;
                border-radius: 50px;
                background: #f1f2f8;
                color: #64748b;
            }
            .hf-chip.active { color: #ffffff; background: #4b3a86; border-color: #4b3a86; }
            .hf-chip.active .hf-count { background: rgba(255, 255, 255, 0.22); color: #ffffff; }
            /* Each status chip carries its own colour when selected, the same
               green/red the badges and the card edges use, so the chip, the
               accent and the badge all say the same thing. */
            .hf-chip.hf-approved.active { background: #16a34a; border-color: #16a34a; }
            .hf-chip.hf-declined.active { background: #dc2626; border-color: #dc2626; }
            /* A chip for a status this office has none of is shown, not
               hidden — "0 declined" is a real and useful answer — but it is
               dimmed and unusable so tapping it can't empty the list. */
            .hf-chip[disabled] { opacity: 0.45; cursor: default; }

            .approvals-table tbody tr.data-row.hf-hidden,
            .approvals-table-card.hf-hidden { display: none !important; }

            .history-filter-empty {
                display: none;
                margin: 0.85rem;
                padding: 1.1rem;
                border: 1px dashed #e9ebf3;
                border-radius: 14px;
                text-align: center;
                font-size: 0.84rem;
                color: #94a3b8;
            }
            .history-filter-empty.show { display: block; }

            /* Card-style responsive table — same pattern as /office-approvals:
               each row reflows into its own bordered card with the header
               label shown inline above each value (via the td's data-label). */
            .approvals-table-scroll { overflow-x: visible; }
            .approvals-table { min-width: 0; table-layout: auto; }
            .approvals-table thead { display: none; }
            .approvals-table, .approvals-table tbody,
            .approvals-table tr, .approvals-table td { display: block; width: 100%; }
            .approvals-table tbody tr.data-row {
                border: 1px solid #e9ebf3;
                border-radius: 14px;
                padding: 0.9rem 1rem;
                margin: 0.85rem;
                background: #ffffff;
            }
            .approvals-table td {
                padding: 0.55rem 0;
                border-bottom: 1px solid #f0f1f7;
                white-space: normal;
            }
            .approvals-table td:last-child { border-bottom: none; padding-bottom: 0; }
            .approvals-table td:first-child { padding-top: 0; }
            .approvals-table td[data-label]::before {
                content: attr(data-label);
                display: block;
                font-size: 0.64rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.45px;
                color: #94a3b8;
                margin-bottom: 0.3rem;
            }

            .approvals-table .cell-value,
            .approvals-table .respondent-name {
                white-space: normal;
                overflow: visible;
                text-overflow: unset;
                overflow-wrap: break-word;
            }
            .approvals-table .cell-value.wrap-value { -webkit-line-clamp: unset; }

            /* --- History list accordion ---------------------------------
               Same collapsed-by-default pattern as the Pending list: each
               card shows Respondent + Google Account (side by side) and the
               status; tapping it expands the same card to reveal Service
               Availed, Decline Reason and Reviewed date. Keeps a long
               history from turning into a wall of scrolling. */
            .history-table.approvals-table tbody tr.data-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                column-gap: 0.85rem;
            }
            .history-table .col-order-respondent { grid-column: 1; order: 1; min-width: 0; }
            .history-table .col-order-email { grid-column: 2; order: 2; min-width: 0; }
            /* Status sits in the COLLAPSED card, directly under the summary —
               see the block further down for why it is not behind the
               accordion with the rest. */
            .history-table .col-order-status { grid-column: 1 / -1; order: 3; }
            .history-table .col-order-service { grid-column: 1 / -1; order: 4; }
            .history-table .col-order-reason { grid-column: 1 / -1; order: 5; }
            .history-table .col-order-reviewed { grid-column: 1 / -1; order: 6; }

            .approvals-table td.collapsible-detail { display: none; }
            .approvals-table tr.data-row.expanded td.collapsible-detail { display: block; }

            .row-summary-toggle { cursor: pointer; }
            /* Respondent's and Google Account's own auto-generated labels
               are replaced by explicit ones (Google Account's paired with
               the chevron on the same line, flex row — not absolute
               positioning, which is fragile and didn't reliably render). */
            .history-table td.col-order-respondent::before { display: none; }
            .history-table td.col-order-email::before { display: none; }
            .email-header-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                width: 100%;
            }
            .toggle-chevron {
                display: inline-block;
                flex: 0 0 auto;
                color: #94a3b8;
                font-size: 0.8rem;
                transition: transform 0.2s ease;
            }
            tr.data-row.expanded .toggle-chevron { transform: rotate(180deg); color: #4b3a86; }

            /* The divider under the summary is permanent now (it used to
               appear only once expanded), because the status row below it is
               always there to be separated from. */
            .history-table .col-order-respondent,
            .history-table .col-order-email {
                border-bottom: 1px solid #f0f1f7 !important;
                padding-top: 0 !important;
                padding-bottom: 0.55rem !important;
            }
            .history-table .col-order-email .cell-value {
                font-size: 0.88rem;
                color: #64748b;
                font-weight: 600;
            }
            .history-table tr.data-row.expanded .col-order-respondent,
            .history-table tr.data-row.expanded .col-order-email {
                margin-bottom: 0.3rem;
            }

            /* --- Status, visible without expanding ------------------------
               The status IS what this page is for: "was this one approved or
               declined" is the question a staffer opens History to answer.
               Behind the accordion, every single row had to be tapped to
               learn the one thing being looked for, which made the collapsed
               list — the thing meant to make a long history scannable —
               unscannable. It stays in the card at all times, and the card
               carries the same answer as a colour down its left edge, so the
               list can be read without touching it.

               An inset shadow, not a left border: the dark-mode rules set
               border-color on this same card, so a coloured border would be
               repainted grey the moment the theme flipped. */
            .history-table tbody tr.data-row.status-approved { box-shadow: inset 4px 0 0 #16a34a; }
            .history-table tbody tr.data-row.status-declined { box-shadow: inset 4px 0 0 #dc2626; }

            .history-table td.col-order-status {
                border-bottom: none !important;
                padding-top: 0.55rem !important;
                padding-bottom: 0 !important;
            }
            /* No "STATUS" caption: the badge already reads "Approved" or
               "Declined", so the label would only repeat it. */
            .history-table td.col-order-status::before { display: none; }
            .history-table tr.data-row.expanded td.col-order-status {
                border-bottom: 1px solid #f0f1f7 !important;
                padding-bottom: 0.6rem !important;
            }
        }
    </style>
    <!-- After the block above on purpose: this file is the portal's shared
         shell (header + sidebar), and loading it last is what lets it override
         whatever each page still defines for those parts. -->
    <link rel="stylesheet" href="/css/office-shell.css">
    <link rel="stylesheet" href="/css/offline-pill.css">
</head>
<body data-connection-alerts>

    <%- include('layout/office-shell', {
            officeName: officeName,
            activeNav: 'history',
            pendingCount: (pendingCount || 0),
            historyCount: (typeof historyCount !== 'undefined' ? historyCount : (history ? history.length : 0))
        }) %>



    <div class="content-wrap">

        <div class="page-header">
            <div>
                <h2>Approval History</h2>
                <p>Submissions you have approved or declined for your office.</p>
            </div>
            <div class="pending-badge">
                <div class="icon"><i class="fas fa-clock-rotate-left"></i></div>
                <div>
                    <div class="num"><%= history ? history.length : 0 %></div>
                    <div class="label">Total Records</div>
                </div>
            </div>
        </div>

        <% if (!history || history.length === 0) { %>
            <div class="empty-state">
                <div class="icon-wrap"><i class="fas fa-clock-rotate-left"></i></div>
                <h3>No approval history yet.</h3>
                <p>Submissions you approve or decline for your office will be listed here for reference.</p>
            </div>
        <% } else { %>
            <%
               // Counted here rather than in the browser so the chips carry
               // real numbers in the very first paint, with no flash of "0".
               var nApproved = history.filter(function (h) { return h.status === 'approved'; }).length;
               var nDeclined = history.length - nApproved;
            %>
            <div class="history-filter" role="group" aria-label="Filter history by status">
                <button type="button" class="hf-chip active" data-filter="all" aria-pressed="true">All <span class="hf-count"><%= history.length %></span></button>
                <button type="button" class="hf-chip hf-approved" data-filter="approved" aria-pressed="false" <%= nApproved ? '' : 'disabled' %>>Approved <span class="hf-count"><%= nApproved %></span></button>
                <button type="button" class="hf-chip hf-declined" data-filter="declined" aria-pressed="false" <%= nDeclined ? '' : 'disabled' %>>Declined <span class="hf-count"><%= nDeclined %></span></button>
            </div>
            <div class="history-filter-empty" id="historyFilterEmpty" role="status"></div>
            <div class="approvals-table-card">
                <div class="approvals-table-scroll">
                    <table class="approvals-table history-table">
                        <colgroup>
                            <col class="col-respondent"><col class="col-service"><col class="col-status">
                            <col class="col-reason"><col class="col-email"><col class="col-reviewed">
                        </colgroup>
                        <thead>
                            <tr>
                                <th><i class="fas fa-user"></i>Respondent</th>
                                <th><i class="fas fa-clipboard-list"></i>Service Availed</th>
                                <th><i class="fas fa-flag"></i>Status</th>
                                <th><i class="fas fa-comment-dots"></i>Decline Reason</th>
                                <th><i class="fas fa-envelope"></i>Google Account</th>
                                <th><i class="fas fa-calendar-check"></i>Reviewed</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% history.forEach(function(sub) { %>
                                <tr class="data-row status-<%= sub.status === 'approved' ? 'approved' : 'declined' %>" data-status="<%= sub.status === 'approved' ? 'approved' : 'declined' %>">
                                    <td data-label="Respondent" class="col-order-respondent">
                                        <div class="respondent-cell row-summary-toggle" role="button" tabindex="0" aria-expanded="false">
                                            <span class="cell-label-inline">Respondent</span>
                                            <div class="respondent-name" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.respondentName %>">
                                                <%= sub.respondentName %>
                                            </div>
                                            <% if (sub.status === 'declined') { %>
                                                <span class="submission-ref" data-bs-toggle="tooltip" data-bs-placement="top" title="Reference number shown to this client in the decline email they received.">PSS-<%= sub.id %></span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td data-label="Service Availed" class="collapsible-detail col-order-service">
                                        <div class="cell-value wrap-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.serviceAvailed || 'Not specified' %>">
                                            <%= sub.serviceAvailed || 'Not specified' %>
                                        </div>
                                    </td>
                                    <td data-label="Status" class="col-order-status">
                                        <% if (sub.status === 'approved') { %>
                                            <span class="status-badge approved"><i class="fas fa-check-circle"></i> Approved</span>
                                        <% } else { %>
                                            <span class="status-badge declined"><i class="fas fa-times-circle"></i> Declined</span>
                                        <% } %>
                                    </td>
                                    <td data-label="Decline Reason" class="collapsible-detail col-order-reason">
                                        <% if (sub.status === 'declined' && sub.declineReason) { %>
                                            <div class="decline-reason-note" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.declineReason %>">
                                                <%= sub.declineReason %>
                                            </div>
                                        <% } else { %>
                                            <span class="cell-sub">—</span>
                                        <% } %>
                                    </td>
                                    <td data-label="Google Account" class="row-summary-toggle col-order-email" role="button" tabindex="0" aria-expanded="false">
                                        <div class="email-header-row">
                                            <span class="cell-label-inline">Google Account</span>
                                            <i class="fas fa-chevron-down toggle-chevron" aria-hidden="true"></i>
                                        </div>
                                        <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.googleEmail %>">
                                            <%= sub.googleEmail %>
                                        </div>
                                    </td>
                                    <td data-label="Reviewed" class="collapsible-detail col-order-reviewed">
                                        <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top"
                                             title="<%= sub.reviewedAt ? new Date(sub.reviewedAt).toLocaleString('en-PH', { dateStyle: 'full', timeStyle: 'medium', timeZone: displayTimeZone }) : '' %>">
                                            <%= sub.reviewedAt ? new Date(sub.reviewedAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short', timeZone: displayTimeZone }) : '—' %>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('layout/footer') %>
    <%- include('layout/theme-toggle') %>
    <script>
        (function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el, { trigger: 'hover focus' });
            });

            // "Viewing offline" pill — same pattern as index.ejs/login.ejs.
            function updateOfflineIndicator() {
                var pill = document.getElementById('offlineIndicator');
                if (pill) pill.classList.toggle('is-visible', !navigator.onLine);
            }
            window.addEventListener('online', updateOfflineIndicator);
            window.addEventListener('offline', updateOfflineIndicator);
            updateOfflineIndicator();

            // Sidebar: off-canvas panel toggled from the topbar's upper-left
            // hamburger button — same behavior as /office-approvals.
            var sidebar = document.getElementById('officeSidebar');
            var sidebarBackdrop = document.getElementById('sidebarBackdrop');
            var sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            var sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
            function openSidebar() {
                if (!sidebar) return;
                sidebar.classList.add('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.add('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'true');
            }
            function closeSidebar() {
                if (!sidebar) return;
                sidebar.classList.remove('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.remove('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'false');
            }
            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener('click', function () {
                    if (sidebar && sidebar.classList.contains('show')) closeSidebar();
                    else openSidebar();
                });
            }
            if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
            if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Status filter chips (phones only — the CSS hides the chips on
            // desktop, where the Status column is readable down the page).
            // Filters the rows already on the page: the whole history is
            // rendered either way, so switching is instant and works with no
            // connection, which matters for a portal staff open offline.
            (function () {
                var chips = document.querySelectorAll('.hf-chip');
                if (!chips.length) return;
                var rows = document.querySelectorAll('.history-table tbody tr.data-row');
                var emptyNote = document.getElementById('historyFilterEmpty');
                var card = document.querySelector('.approvals-table-card');

                function apply(filter) {
                    var shown = 0;
                    rows.forEach(function (row) {
                        var match = filter === 'all' || row.getAttribute('data-status') === filter;
                        row.classList.toggle('hf-hidden', !match);
                        if (match) shown++;
                        // A row hidden while expanded would come back
                        // expanded later, out of step with every other card.
                        if (!match) {
                            row.classList.remove('expanded');
                            row.querySelectorAll('.row-summary-toggle').forEach(function (t) {
                                t.setAttribute('aria-expanded', 'false');
                            });
                        }
                    });
                    if (emptyNote) {
                        emptyNote.textContent = shown ? '' : 'No ' + filter + ' submissions yet.';
                        emptyNote.classList.toggle('show', shown === 0);
                    }
                    // The card is the rows' container — with every row hidden it
                    // would otherwise stay behind as an empty bordered strip
                    // under the "none of these yet" note.
                    if (card) card.classList.toggle('hf-hidden', shown === 0);
                }

                chips.forEach(function (chip) {
                    chip.addEventListener('click', function () {
                        if (chip.hasAttribute('disabled')) return;
                        chips.forEach(function (c) {
                            var on = c === chip;
                            c.classList.toggle('active', on);
                            c.setAttribute('aria-pressed', String(on));
                        });
                        apply(chip.getAttribute('data-filter'));
                    });
                });
            })();

            // Mobile history-list accordion: same collapsed-by-default
            // pattern as the Pending list — a card starts showing
            // Respondent, Google Account and the status; tapping it expands
            // the same card in place to reveal Service Availed, Decline
            // Reason and Reviewed date. Purely a CSS class toggle — the
            // ".collapsible-detail" cells are only actually hidden inside
            // the mobile media query, so this is a no-op on desktop.
            document.querySelectorAll('.row-summary-toggle').forEach(function (el) {
                function toggleRow() {
                    var row = el.closest('tr.data-row');
                    if (!row) return;
                    var expanded = !row.classList.contains('expanded');
                    row.classList.toggle('expanded', expanded);
                    row.querySelectorAll('.row-summary-toggle').forEach(function (t) {
                        t.setAttribute('aria-expanded', String(expanded));
                    });
                }
                el.addEventListener('click', toggleRow);
                el.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRow(); }
                });
            });

            var logoutBtn = document.getElementById('officeLogoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var href = logoutBtn.getAttribute('href');
                    AppAlert.confirm('Are you sure you want to logout?', { title: 'Logout?', confirmText: 'Yes, logout', danger: false })
                        .then(function (confirmed) {
                            if (confirmed) window.location.href = href;
                        });
                });
            }
        })();
    </script>
</body>
</html>
