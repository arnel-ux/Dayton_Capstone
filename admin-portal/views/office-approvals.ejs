<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // New-tab auto-login guard: office sessions ride the same hand-rolled
        // admin-session cookie as admin logins, so a brand new tab that merely
        // inherited that cookie (typed the URL, duplicated the tab, opened a
        // bookmark) would otherwise land here fully "logged in" without ever
        // having submitted office credentials in THAT tab. sessionStorage is
        // scoped per tab (never copied to a freshly opened one), so it's used
        // here purely as a "did this tab actually authenticate" marker: /office-login's
        // redirect tags the very next page load with ?loggedin=1, which this
        // script converts into the marker before the URL is cleaned up. Same
        // pattern as the admin dashboard (layout/header.ejs) and /client-survey.
        // Note: this is a client-side UX guard, not a security boundary — the
        // page markup briefly reaches the browser before this (first) script
        // redirects it away, so it doesn't stop someone with devtools/view-source
        // open on that same already-logged-in machine.
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.has('loggedin')) {
                    sessionStorage.setItem('cqa_office_tab_ok', '1');
                    params.delete('loggedin');
                    var cleanedSearch = params.toString();
                    var cleanedUrl = window.location.pathname + (cleanedSearch ? '?' + cleanedSearch : '') + window.location.hash;
                    window.history.replaceState({}, '', cleanedUrl);
                } else if (sessionStorage.getItem('cqa_office_tab_ok') !== '1') {
                    window.location.replace('/office-login?error=' + encodeURIComponent('Please log in to continue.'));
                }
            } catch (e) { /* sessionStorage unavailable (privacy mode, etc.) — fail open */ }
        })();
    </script>
    <%- include('layout/header') %>
    <%
        // Display-only helpers. These never touch the underlying DB values —
        // they only format sub.officeVisitedTime / officeName for presentation.

        // client_profiles.office_visited_time is a MySQL DATETIME, arriving here
        // as "YYYY-MM-DD HH:mm:ss" — the client's own visit date+time, which can
        // be an earlier day than when they actually submitted the survey. Format
        // it directly rather than assuming it matches the submission's created_at.
        function formatVisitedDateTime12h(value) {
            if (!value) return null;
            var match = String(value).trim().match(/^(\d{4}-\d{2}-\d{2})[T ](\d{1,2}):(\d{2})/);
            if (!match) return null;
            var datePart = new Date(match[1] + 'T00:00:00').toLocaleDateString('en-PH', { dateStyle: 'medium' });
            var hours = parseInt(match[2], 10);
            var minutes = match[3];
            if (isNaN(hours)) return null;
            var suffix = hours >= 12 ? 'PM' : 'AM';
            var hours12 = hours % 12;
            if (hours12 === 0) hours12 = 12;
            return datePart + ', ' + hours12 + ':' + minutes + ' ' + suffix;
        }
    %>
    <style>
        /* ==========================================================
           BASE / LAYOUT
           ========================================================== */
        * { box-sizing: border-box; }
        /* overflow-x must be `clip`, never `hidden`, here. `hidden` turns
           html/body into a scroll container, and a scroll container is what
           .topbar's `position: sticky` then sticks to instead of the
           viewport — which is why the header scrolled away with the page.
           `clip` cuts off the same horizontal overflow without creating
           that scroll container, so sticky keeps working.
           overflow-y is pinned to `visible` so the pair can never fall back
           to the scroll-container behaviour in a browser that lacks `clip`. */
        html, body {
            overflow-x: clip;
            overflow-y: visible;
        }
        body {
            background: #f0f3f9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
            color: #0f172a;
        }

        /* "Viewing offline" pill — same amber style, font-size and padding
           as index.ejs / login.ejs for a consistent look across the whole
           system. Placed in its own centered row under the topbar instead
           of squeezed in next to Logout/the portal-status pill, so it never
           overlaps or covers those on narrow screens. */
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

        /* ==========================================================
           PAGE HEADER
           ========================================================== */
        .content-wrap {
            max-width: 1140px;
            margin: 0 auto;
            padding: 0 1.25rem 3rem;
        }
        .page-header {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.75rem 0 1.25rem;
        }
        .page-header h2 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1a1436;
            margin: 0 0 0.3rem;
        }
        .page-header p {
            font-size: 0.9rem;
            color: #64748b;
            margin: 0;
            max-width: 46ch;
        }
        .pending-badge {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: #ffffff;
            border: 1px solid #e5e7f0;
            border-radius: 14px;
            padding: 0.7rem 1.1rem;
            box-shadow: 0 6px 18px -10px rgba(30, 23, 56, 0.25);
            flex: 0 0 auto;
        }
        .pending-badge .icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2d1f57, #4b3a86);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex: 0 0 auto;
        }
        .pending-badge .num {
            font-size: 1.25rem;
            font-weight: 800;
            color: #1a1436;
            line-height: 1.1;
        }
        .pending-badge .label {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #94a3b8;
        }

        /* ==========================================================
           APPROVALS TABLE
           ========================================================== */
        .approvals-table-card {
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            box-shadow: 0 6px 20px -12px rgba(15, 23, 42, 0.18);
            overflow: hidden;
        }
        .approvals-table-scroll {
            overflow-x: auto;
        }
        .approvals-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: fixed;
            min-width: 920px;
        }
        .approvals-table col.col-respondent { width: 18%; }
        .approvals-table col.col-service { width: 20%; }
        .approvals-table col.col-visited { width: 15%; }
        .approvals-table col.col-submitted { width: 15%; }
        .approvals-table col.col-email { width: 17%; }
        .approvals-table col.col-actions { width: 15%; }
        .approvals-table col.col-status { width: 13%; }
        .approvals-table col.col-reason { width: 22%; }
        .approvals-table col.col-reviewed { width: 15%; }

        .approvals-table thead th {
            background: #f8f9fc;
            border-bottom: 1px solid #e9ebf3;
            font-size: 0.66rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.45px;
            color: #94a3b8;
            padding: 0.8rem 1rem;
            text-align: left;
            white-space: nowrap;
        }
        .approvals-table thead th.col-actions-head { text-align: right; }
        .approvals-table thead th i { color: #7c6bb0; margin-right: 0.4rem; }
        .approvals-table tbody tr.data-row {
            border-bottom: 1px solid #f0f1f7;
            animation: rowIn 0.3s ease both;
        }
        .approvals-table tbody tr.data-row:nth-child(4n+1) { background: #fbfbfe; }
        .approvals-table tbody tr.data-row:hover { background: #f4f4fd; }
        .approvals-table tbody tr.data-row:last-child { border-bottom: none; }
        @keyframes rowIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @media (prefers-reduced-motion: reduce) {
            .approvals-table tbody tr.data-row { animation: none; }
        }
        .approvals-table td {
            padding: 0.9rem 1rem;
            vertical-align: middle;
            font-size: 0.84rem;
            color: #1a1436;
            line-height: 1.35;
        }
        /* Desktop: the pill floats in the naturally-empty top area of the
           Respondent cell (that column's own row height is set by the much
           taller Actions column next to it, so there's already free space
           above the vertically-centered name) instead of sitting inline
           next to the name — keeping "Francis James Obis" itself exactly
           where it'd sit with no pill at all, aligned with Google Account.
           The mobile media query below switches this to its own stacked
           card layout with a differently-positioned floating badge. */
        .respondent-cell { display: flex; flex-direction: row; align-items: center; gap: 0.5rem; min-width: 0; }
        .col-order-respondent { position: relative; }
        /* "Respondent" / "Google Account" mini-labels only exist for the
           mobile card view (the desktop table already has real <th> column
           headers) — hidden here, shown again inside the media query. */
        .cell-label-inline { display: none; }
        .toggle-chevron { display: none; }
        .pending-pill {
            position: absolute;
            top: 0.5rem;
            left: 1rem;
            display: inline-flex;
            align-items: center;
            flex: 0 0 auto;
            gap: 0.35rem;
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #92400e;
            background: #fef3c7;
            border: 1px solid #fde68a;
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .pending-pill i { font-size: 0.55rem; }
        .respondent-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: #14102b;
            margin: 0;
            max-width: 100%;
            min-width: 0;
            flex: 1 1 auto;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .cell-value {
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            cursor: default;
        }
        .cell-value.wrap-value {
            white-space: normal;
            overflow-wrap: break-word;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .cell-sub {
            font-size: 0.76rem;
            color: #94a3b8;
            font-weight: 600;
            white-space: nowrap;
            margin-top: 0.15rem;
        }

        .time-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: #eef2ff;
            color: #3730a3;
            border: 1px solid #e0e7ff;
            font-weight: 700;
            font-size: 0.78rem;
            padding: 0.22rem 0.6rem;
            border-radius: 8px;
            white-space: nowrap;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .time-pill i { font-size: 0.7rem; flex: 0 0 auto; }

        /* ==========================================================
           HISTORY TABLE (status badges)
           ========================================================== */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.62rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 0.2rem 0.55rem;
            border-radius: 50px;
            white-space: nowrap;
        }
        .status-badge.approved { color: #166534; background: #dcfce7; border: 1px solid #bbf7d0; }
        .status-badge.declined { color: #991b1b; background: #fee2e2; border: 1px solid #fecaca; }
        .status-badge i { font-size: 0.58rem; }
        .decline-reason-note {
            font-size: 0.76rem;
            color: #94a3b8;
            font-style: italic;
            margin-top: 0.3rem;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* ==========================================================
           ACTIONS
           ========================================================== */
        .actions-row {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 0.5rem;
        }
        .actions-row form { display: block; width: 100%; }
        .btn-approve {
            background: #16a34a;
            border: 1px solid #16a34a;
            color: #fff;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.45rem 1rem;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 38px;
            width: 100%;
            transition: background 0.15s ease, box-shadow 0.15s ease, transform 0.1s ease;
            white-space: nowrap;
        }
        .btn-approve:hover { background: #15803d; color: #fff; box-shadow: 0 6px 16px -6px rgba(22,163,74,0.55); }
        .btn-approve:active { transform: translateY(1px); }
        .btn-approve:focus-visible { outline: 2px solid #16a34a; outline-offset: 2px; }

        .btn-decline {
            background: #fff;
            border: 1.5px solid #dc2626;
            color: #dc2626;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.45rem 1rem;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            min-height: 38px;
            width: 100%;
            transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
            white-space: nowrap;
        }
        .btn-decline:hover { background: #fef2f2; color: #b91c1c; border-color: #b91c1c; }
        .btn-decline:active { transform: translateY(1px); }
        .btn-decline:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
        .btn-decline[aria-expanded="true"] { background: #fef2f2; }

        .decline-panel {
            margin-top: 0.7rem;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 12px;
            padding: 0.9rem 1rem;
        }
        .decline-panel-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #991b1b;
            margin-bottom: 0.55rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .decline-form-row {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
        }
        .decline-form-row .form-control {
            flex: 1 1 220px;
            border-radius: 8px;
            border: 1px solid #fca5a5;
            font-size: 0.85rem;
        }
        .decline-form-row .form-control:focus {
            border-color: #dc2626;
            box-shadow: 0 0 0 0.2rem rgba(220,38,38,0.15);
        }
        .btn-confirm-decline {
            background: #dc2626;
            border: 1px solid #dc2626;
            color: #fff;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.5rem 1.1rem;
            border-radius: 8px;
            white-space: nowrap;
            min-height: 42px;
            transition: background 0.15s ease;
        }
        .btn-confirm-decline:hover { background: #b91c1c; color: #fff; }
        .btn-confirm-decline:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }

        /* ==========================================================
           EMPTY STATE
           ========================================================== */
        .empty-state {
            text-align: center;
            padding: 3.5rem 1.5rem;
            color: #64748b;
            background: #ffffff;
            border: 1px solid #e9ebf3;
            border-radius: 16px;
            margin-top: 1rem;
        }
        .empty-state .icon-wrap {
            width: 68px;
            height: 68px;
            margin: 0 auto 1.1rem;
            border-radius: 50%;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .empty-state .icon-wrap i { font-size: 1.8rem; color: #4338ca; }
        .empty-state h3 {
            font-size: 1.15rem;
            font-weight: 700;
            color: #1a1436;
            margin-bottom: 0.4rem;
        }
        .empty-state p {
            font-size: 0.88rem;
            margin: 0 auto 1rem;
            max-width: 40ch;
        }
        .caught-up-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            font-size: 0.72rem;
            font-weight: 700;
            color: #166534;
            background: #dcfce7;
            border: 1px solid #bbf7d0;
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
        }

        /* ==========================================================
           RESPONSIVE
           ========================================================== */
        @media (max-width: 767px) {
            .content-wrap { padding: 0 0.85rem 2.5rem; }
            .page-header { padding-top: 1.25rem; gap: 0.85rem; }
            .page-header h2 { font-size: 1.3rem; }
            .page-header p { font-size: 0.84rem; max-width: 100%; }
            .pending-badge { width: 100%; }

            /* --- Card-style responsive table --------------------------
               Below 767px a bordered/scrolling table is hard to use on a
               phone (tiny text, sideways scrolling). Instead each row is
               reflowed into its own bordered "card" with the header label
               shown inline above each value (via the td's data-label attr),
               same pattern used across the rest of the admin portal. */
            .approvals-table-scroll { overflow-x: visible; }
            .approvals-table { min-width: 0; table-layout: auto; }
            .approvals-table thead { display: none; }
            .approvals-table, .approvals-table tbody,
            .approvals-table tr, .approvals-table td { display: block; width: 100%; }
            .approvals-table tbody tr.data-row {
                border: 1px solid #e9ebf3;
                border-radius: 14px;
                padding: 0.9rem 1rem;
                margin: 0.85rem;
            }
            .approvals-table tbody tr.data-row:nth-child(4n+1) { background: #ffffff; }
            .approvals-table td {
                padding: 0.55rem 0;
                border-bottom: 1px solid #f0f1f7;
                white-space: normal;
            }
            .approvals-table td:last-child { border-bottom: none; padding-bottom: 0; }
            .approvals-table td:first-child { padding-top: 0; }
            .approvals-table td[data-label]::before {
                content: attr(data-label);
                display: block;
                font-size: 0.64rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.45px;
                color: #94a3b8;
                margin-bottom: 0.3rem;
            }
            .approvals-table td.no-label::before { content: none; }
            .approvals-table tr.decline-row td { padding: 0; border-bottom: none; }
            .approvals-table tr.decline-row td > div { margin: -0.5rem 0.85rem 0.85rem; }

            /* Full values instead of desktop's ellipsis-truncated single line —
               there's no adjacent column fighting for space anymore. */
            .approvals-table .cell-value,
            .approvals-table .respondent-name {
                white-space: normal;
                overflow: visible;
                text-overflow: unset;
                overflow-wrap: break-word;
            }
            .approvals-table .cell-value.wrap-value { -webkit-line-clamp: unset; }

            /* --- Pending list accordion --------------------------------
               With many pending requests each full card ate too much
               vertical space to scan. Collapsed by default, a pending row
               shows only the respondent name + Google account — laid out
               as two side-by-side columns instead of stacked, so the
               summary reads as one compact line pair instead of four.
               Tapping the row expands it in place to reveal the rest of
               the details (each spanning the full card width) plus the
               Approve/Decline actions. */
            .pending-table.approvals-table tbody tr.data-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                column-gap: 0.85rem;
                position: relative;
            }
            .pending-table .col-order-respondent { grid-column: 1; order: 1; position: static; min-width: 0; }
            .pending-table .col-order-email { grid-column: 2; order: 2; min-width: 0; }
            .pending-table .col-order-service { grid-column: 1 / -1; order: 3; }
            .pending-table .col-order-visited { grid-column: 1 / -1; order: 4; }
            .pending-table .col-order-submitted { grid-column: 1 / -1; order: 5; }
            .pending-table .col-order-actions { grid-column: 1 / -1; order: 6; }

            .approvals-table td.collapsible-detail { display: none; }
            .approvals-table tr.data-row.expanded td.collapsible-detail { display: block; }

            .row-summary-toggle { cursor: pointer; }
            /* Card view: pill sits above the name (not inline beside it —
               see the floating-badge rule further down) and the mini-label
               reappears above each value, since there's no <th> row here. */
            .respondent-cell { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
            .cell-label-inline { display: block; }
            /* Google Account's own auto-generated label is replaced by an
               explicit one paired with the chevron on the same line (flex
               row, not absolute positioning) — simpler and more reliable
               than pinning the chevron to a corner. */
            .pending-table td.col-order-email::before { display: none; }
            .email-header-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.5rem;
                width: 100%;
            }
            .toggle-chevron {
                display: inline-block;
                flex: 0 0 auto;
                color: #94a3b8;
                font-size: 0.8rem;
                transition: transform 0.2s ease;
            }
            tr.data-row.expanded .toggle-chevron { transform: rotate(180deg); color: #4b3a86; }

            /* Pending pill floats as a small badge overlapping the card's
               top-left corner — pulled out of the normal flow entirely —
               so it no longer pushes "Respondent" (and the name below it)
               down past where "Google Account" and its value sit. With the
               pill out of the way, Respondent/Google Account line up on
               the same row, and Name/Google Account value line up right
               beneath them. */
            .pending-table td.col-order-respondent::before { display: none; }
            .pending-table .pending-pill {
                position: absolute;
                top: -0.65rem;
                left: 0.9rem;
                z-index: 1;
            }

            /* Respondent + Google Account form one compact header pair when
               collapsed — no divider under them — and only gain a
               separating line once the row expands and details follow. */
            .pending-table .col-order-respondent,
            .pending-table .col-order-email {
                border-bottom: none !important;
                padding-top: 0 !important;
                padding-bottom: 0.3rem !important;
            }
            .pending-table .col-order-email .cell-value {
                font-size: 0.88rem;
                color: #64748b;
                font-weight: 600;
            }
            .pending-table tr.data-row.expanded .col-order-respondent,
            .pending-table tr.data-row.expanded .col-order-email {
                border-bottom: 1px solid #f0f1f7 !important;
                padding-bottom: 0.55rem !important;
                margin-bottom: 0.3rem;
            }

            .actions-row .btn-approve,
            .actions-row .btn-decline { flex: 1 1 auto; justify-content: center; }
            .decline-form-row { flex-direction: column; }
            .decline-form-row .form-control,
            .btn-confirm-decline { width: 100%; }
        }
    </style>
    <!-- After the block above on purpose: this file is the portal's shared
         shell (header + sidebar), and loading it last is what lets it override
         whatever each page still defines for those parts. -->
    <link rel="stylesheet" href="/css/office-shell.css">
    <link rel="stylesheet" href="/css/offline-pill.css">
</head>
<body data-connection-alerts>

    <%- include('layout/office-shell', {
            officeName: officeName,
            activeNav: 'pending',
            pendingCount: (submissions ? submissions.length : 0),
            historyCount: (historyCount || 0)
        }) %>



    <div class="content-wrap">

        <div class="page-header">
            <div>
                <h2>Survey Approval Requests</h2>
                <p>Review and verify pending client survey submissions for your office.</p>
            </div>
            <div class="pending-badge">
                <div class="icon"><i class="fas fa-hourglass-half"></i></div>
                <div>
                    <div class="num"><%= submissions ? submissions.length : 0 %></div>
                    <div class="label">Pending Approvals</div>
                </div>
            </div>
        </div>

        <div id="pendingTab">
            <% if (!submissions || submissions.length === 0) { %>
                <div class="empty-state">
                    <div class="icon-wrap"><i class="fas fa-inbox"></i></div>
                    <h3>No pending submissions right now.</h3>
                    <p>New personal-email survey submissions for your office will show up here for verification.</p>
                    <span class="caught-up-badge"><i class="fas fa-check-circle"></i> All caught up</span>
                </div>
            <% } else { %>
                <div class="approvals-table-card">
                    <div class="approvals-table-scroll">
                        <table class="approvals-table pending-table">
                            <colgroup>
                                <col class="col-respondent"><col class="col-service"><col class="col-visited">
                                <col class="col-submitted"><col class="col-email"><col class="col-actions">
                            </colgroup>
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user"></i>Respondent</th>
                                    <th><i class="fas fa-clipboard-list"></i>Service Availed</th>
                                    <th><i class="fas fa-clock"></i>Office Visited</th>
                                    <th><i class="fas fa-calendar-alt"></i>Submitted</th>
                                    <th><i class="fas fa-envelope"></i>Google Account</th>
                                    <th class="col-actions-head">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% submissions.forEach(function(sub) { %>
                                    <% officeVisitedDisplay = formatVisitedDateTime12h(sub.officeVisitedTime); %>
                                    <tr class="data-row">
                                        <td data-label="Respondent" class="col-order-respondent">
                                            <div class="respondent-cell row-summary-toggle" role="button" tabindex="0" aria-expanded="false">
                                                <span class="pending-pill"><i class="fas fa-circle"></i> Pending</span>
                                                <span class="cell-label-inline">Respondent</span>
                                                <div class="respondent-name" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.respondentName %>">
                                                    <%= sub.respondentName %>
                                                </div>
                                            </div>
                                        </td>
                                        <td data-label="Service Availed" class="collapsible-detail col-order-service">
                                            <div class="cell-value wrap-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.serviceAvailed || 'Not specified' %>">
                                                <%= sub.serviceAvailed || 'Not specified' %>
                                            </div>
                                        </td>
                                        <td data-label="Office Visited" class="collapsible-detail col-order-visited">
                                            <span class="time-pill"><i class="fas fa-clock"></i> <%= officeVisitedDisplay || sub.officeVisitedTime || '—' %></span>
                                        </td>
                                        <td data-label="Submitted" class="collapsible-detail col-order-submitted">
                                            <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top"
                                                 title="<%= new Date(sub.createdAt).toLocaleString('en-PH', { dateStyle: 'full', timeStyle: 'medium' }) %>">
                                                <%= new Date(sub.createdAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) %>
                                            </div>
                                        </td>
                                        <td data-label="Google Account" class="row-summary-toggle col-order-email" role="button" tabindex="0" aria-expanded="false">
                                            <div class="email-header-row">
                                                <span class="cell-label-inline">Google Account</span>
                                                <i class="fas fa-chevron-down toggle-chevron" aria-hidden="true"></i>
                                            </div>
                                            <div class="cell-value" data-bs-toggle="tooltip" data-bs-placement="top" title="<%= sub.googleEmail %>">
                                                <%= sub.googleEmail %>
                                            </div>
                                        </td>
                                        <td class="no-label collapsible-detail col-order-actions">
                                            <div class="actions-row">
                                                <form action="/office-approvals/<%= sub.id %>/approve" method="POST" class="m-0 approve-form" data-respondent="<%= sub.respondentName %>">
                                                    <button type="submit" class="btn-approve">
                                                        <i class="fas fa-check"></i> Approve
                                                    </button>
                                                </form>
                                                <button type="button" class="btn-decline" data-bs-toggle="collapse" data-bs-target="#declineForm<%= sub.id %>" aria-expanded="false" aria-controls="declineForm<%= sub.id %>">
                                                    <i class="fas fa-times"></i> Decline
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr class="decline-row" id="declineRow<%= sub.id %>" hidden>
                                        <td colspan="6" style="padding-top: 0;">
                                            <div class="collapse" id="declineForm<%= sub.id %>">
                                                <div class="decline-panel">
                                                    <div class="decline-panel-label"><i class="fas fa-exclamation-circle"></i> Reason for declining (optional)</div>
                                                    <form action="/office-approvals/<%= sub.id %>/decline" method="POST" class="decline-form-row decline-form" data-respondent="<%= sub.respondentName %>">
                                                        <input type="text" name="decline_reason" class="form-control" placeholder="Enter a reason for declining this submission" maxlength="255" aria-label="Reason for declining">
                                                        <button type="submit" class="btn-confirm-decline">Confirm Decline</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('layout/footer') %>
    <%- include('layout/theme-toggle') %>
    <script>
        (function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el, { trigger: 'hover focus' });
            });

            // "Viewing offline" pill — same pattern as index.ejs/login.ejs.
            function updateOfflineIndicator() {
                var pill = document.getElementById('offlineIndicator');
                if (pill) pill.classList.toggle('is-visible', !navigator.onLine);
            }
            window.addEventListener('online', updateOfflineIndicator);
            window.addEventListener('offline', updateOfflineIndicator);
            updateOfflineIndicator();

            // Sidebar: off-canvas panel toggled from the topbar's upper-left
            // hamburger button. Pending / History are separate pages now, so
            // this is just open/close, not a content switcher.
            var sidebar = document.getElementById('officeSidebar');
            var sidebarBackdrop = document.getElementById('sidebarBackdrop');
            var sidebarToggleBtn = document.getElementById('sidebarToggleBtn');
            var sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
            function openSidebar() {
                if (!sidebar) return;
                sidebar.classList.add('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.add('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'true');
            }
            function closeSidebar() {
                if (!sidebar) return;
                sidebar.classList.remove('show');
                if (sidebarBackdrop) sidebarBackdrop.classList.remove('show');
                if (sidebarToggleBtn) sidebarToggleBtn.setAttribute('aria-expanded', 'false');
            }
            if (sidebarToggleBtn) {
                sidebarToggleBtn.addEventListener('click', function () {
                    if (sidebar && sidebar.classList.contains('show')) closeSidebar();
                    else openSidebar();
                });
            }
            if (sidebarCloseBtn) sidebarCloseBtn.addEventListener('click', closeSidebar);
            if (sidebarBackdrop) sidebarBackdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Mobile pending-list accordion: a pending row starts collapsed
            // (name + Google account only); tapping either summary element
            // expands the same <tr> in place to reveal the rest of the details
            // and the Approve/Decline actions. Purely a CSS class toggle — the
            // ".collapsible-detail" cells are only actually hidden inside the
            // mobile media query, so this is a no-op visually on desktop.
            document.querySelectorAll('.row-summary-toggle').forEach(function (el) {
                function toggleRow() {
                    var row = el.closest('tr.data-row');
                    if (!row) return;
                    var expanded = !row.classList.contains('expanded');
                    row.classList.toggle('expanded', expanded);
                    row.querySelectorAll('.row-summary-toggle').forEach(function (t) {
                        t.setAttribute('aria-expanded', String(expanded));
                    });
                    // Collapsing the card while its decline-reason panel was
                    // open would otherwise leave that panel dangling below a
                    // collapsed card — close it too.
                    if (!expanded) {
                        var declineRow = row.nextElementSibling;
                        var declineForm = declineRow && declineRow.classList.contains('decline-row')
                            ? declineRow.querySelector('[id^="declineForm"]')
                            : null;
                        if (declineForm && window.bootstrap) {
                            var instance = bootstrap.Collapse.getInstance(declineForm);
                            if (instance) instance.hide();
                        }
                    }
                }
                el.addEventListener('click', toggleRow);
                el.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRow(); }
                });
            });

            // Toggle aria-expanded state on decline buttons in sync with the collapse,
            // and show/hide the wrapping <tr> — Bootstrap's collapse animates height,
            // which doesn't work on table rows, so the collapse lives on a <div>
            // inside the cell while the <tr> itself is just hidden/unhidden.
            document.querySelectorAll('[data-bs-target^="#declineForm"]').forEach(function (btn) {
                var target = document.querySelector(btn.getAttribute('data-bs-target'));
                if (!target) return;
                var row = target.closest('tr.decline-row');
                target.addEventListener('show.bs.collapse', function () { if (row) row.hidden = false; });
                target.addEventListener('shown.bs.collapse', function () { btn.setAttribute('aria-expanded', 'true'); });
                target.addEventListener('hidden.bs.collapse', function () {
                    btn.setAttribute('aria-expanded', 'false');
                    if (row) row.hidden = true;
                });
            });

            // Show the result of the last approve/decline redirect as a toast
            // (?success=... / ?error=... set by server.js), then clean the URL.
            AppAlert.autoShowFromQuery();

            var logoutBtn = document.getElementById('officeLogoutBtn');
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    var href = logoutBtn.getAttribute('href');
                    AppAlert.confirm('Are you sure you want to logout?', { title: 'Logout?', confirmText: 'Yes, logout', danger: false })
                        .then(function (confirmed) {
                            if (confirmed) window.location.href = href;
                        });
                });
            }

            // Approve: confirm first, then show a loading button state and let
            // the form submit normally (server still owns the redirect + the
            // real approve logic — this only adds a confirmation + feedback layer).
            document.querySelectorAll('form.approve-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (form.dataset.confirmed === '1') return; // already confirmed, let it through
                    e.preventDefault();
                    var respondent = form.dataset.respondent || 'this submission';
                    AppAlert.confirm(
                        'Are you sure you want to approve the survey submitted by ' + respondent + '?',
                        { title: 'Approve Survey Submission?', confirmText: 'Yes, approve', danger: false }
                    ).then(function (confirmed) {
                        if (!confirmed) return;
                        form.dataset.confirmed = '1';
                        AppAlert.setButtonLoading(form.querySelector('button[type="submit"]'), 'Approving...');
                        form.submit();
                    });
                });
            });

            // Decline: same confirm-then-submit pattern; the optional reason the
            // office staff typed is preserved since we submit the real form as-is.
            document.querySelectorAll('form.decline-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (form.dataset.confirmed === '1') return;
                    e.preventDefault();
                    var respondent = form.dataset.respondent || 'this submission';
                    AppAlert.confirm(
                        'Are you sure you want to decline the survey submitted by ' + respondent + '?',
                        { title: 'Decline Survey Submission?', confirmText: 'Yes, decline', danger: true }
                    ).then(function (confirmed) {
                        if (!confirmed) return;
                        form.dataset.confirmed = '1';
                        AppAlert.setButtonLoading(form.querySelector('button[type="submit"]'), 'Declining...');
                        form.submit();
                    });
                });
            });
        })();
    </script>
</body>
</html>
