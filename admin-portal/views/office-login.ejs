<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <link rel="stylesheet" href="/css/auth.css">
    <!-- The page renders an .offline-pill below, and this is the stylesheet that
         makes it one. Without it the chip had no `display: none` to start from,
         so "Viewing Offline" sat at the top of this page as unstyled black text
         permanently — online, offline, every visit — and the .is-visible class
         the script below toggles did nothing at all. -->
    <link rel="stylesheet" href="/css/offline-pill.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="/css/alerts.css">
</head>
<body>

    <div class="bg-blurred" style="--auth-hero-image: url('<%- heroImageUrl %>')"></div>
    <div class="bg-overlay"></div>

    <a href="/" class="btn-home" title="Return to Home Page" aria-label="Return to Home Page">
        <i class="fas fa-home"></i>
    </a>

    <div class="login-wrapper">

        <!-- Inside .login-wrapper, exactly as on /login and /client-login. The
             chip is position:fixed either way, so this is not about where it
             draws — it is that auth.css keeps the hero clear of the chip with
             `.login-wrapper:has(.offline-pill.is-visible)`, and :has() only
             looks at DESCENDANTS. Out here as a sibling of the wrapper it could
             never match, so this was the one auth page whose title still got
             sat on. -->
        <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection — signing in needs an internet connection to verify your account.">
            <span class="dot"></span><span class="label">Viewing Offline</span>
        </span>

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Office Staff Login</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-2">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                <h4 class="fw-bold text-dark mb-0">Office Approval Panel</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Review and verify client survey submissions for your office.</p>
            </div>

            <form action="/office-login" method="POST" id="officeLoginForm">
                <div class="field-group">
                    <label class="field-label" for="emailInput">Office Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-envelope"></i></span>
                        <input type="email" name="email" id="emailInput" class="form-control" placeholder="office@cspc.edu.ph" required autocomplete="off">
                    </div>
                </div>

                <div class="field-group">
                    <label class="field-label" for="passwordInput">Password</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required>
                    </div>
                </div>

                <button type="submit" class="btn btn-login w-100" title="Sign in to your account">
                    <i class="fas fa-sign-in-alt me-2"></i> Sign In
                </button>
            </form>

        </div>
    </div>

    <script>
        // Marks a real landing on the login page in THIS browser tab (sessionStorage
        // is tab-scoped, so this can never bleed into a different tab or a different
        // office's browser) so that if the user later presses Forward, the shared
        // bfcache guard (public/js/main.js) redirects back here instead of letting
        // the browser silently restore a previously-cached authenticated office page.
        // Deliberately NOT done by destroying the server-side session here — see the
        // "must NOT destroy any session" comment on the /login route in server.js:
        // admin.sid is shared by every tab in the browser, so that would log out
        // every OTHER open office/admin tab too.
        try { sessionStorage.setItem('__loginBoundary', window.location.pathname); } catch (e) {}
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const officeLoginParams = new URLSearchParams(window.location.search);
        const officeLoginError = officeLoginParams.get('error');
        if (officeLoginError) {
            AppAlert.error(officeLoginError, 'Login Failed');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Semantic session states, mirroring login.ejs's STATUS_MESSAGES so
        // the office side explains itself the same way the admin/client side
        // does. Before this, '/office-logout' redirected to '/login' and an
        // office user got no confirmation here at all — and being bounced
        // here by ensureOfficeAuth said nothing about why.
        const officeLoginStatus = officeLoginParams.get('status');
        const OFFICE_STATUS_MESSAGES = {
            logged_out: { type: 'success', title: 'Logged Out', text: 'You have been logged out successfully.' },
            session_expired: { type: 'warning', title: 'Session Expired', text: 'Your session has expired. Please log in again.' },
            login_required: { type: 'info', title: 'Login Required', text: 'Please log in to your office account to continue.' }
        };
        if (officeLoginStatus && OFFICE_STATUS_MESSAGES[officeLoginStatus]) {
            const s = OFFICE_STATUS_MESSAGES[officeLoginStatus];
            AppAlert.toast(s.type, s.text, { title: s.title });
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // "Viewing offline" pill — same pattern as index.ejs/login.ejs.
        function updateOfflineIndicator() {
            const pill = document.getElementById('offlineIndicator');
            if (pill) pill.classList.toggle('is-visible', !navigator.onLine);
        }
        window.addEventListener('online', updateOfflineIndicator);
        window.addEventListener('offline', updateOfflineIndicator);
        updateOfflineIndicator();
    </script>
</body>
</html>
