                            <span class="accordion-text">
                                <span class="accordion-name">${o.name}</span>
                                <span class="accordion-count">${o.services.length} Service${o.services.length > 1 ? 's' : ''}</span>
                            </span>
                        </span>
                        <i class="fas fa-chevron-down accordion-chevron"></i>
                    </button>
                    <div class="accordion-panel">
                        <div class="accordion-panel-inner">
