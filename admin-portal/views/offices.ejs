<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        .cluster-toggle {
            cursor: pointer;
            user-select: none;
            transition: background-color 0.2s ease;
        }

        .cluster-toggle:hover {
            background-color: #f8f9fc !important;
        }

        .cluster-icon {
            transition: transform 0.2s ease;
        }

        .cluster-toggle.collapsed .cluster-icon {
            transform: rotate(-90deg);
        }

        .archived-row {
            opacity: 0.55;
            background-color: #f8fafc;
        }
        .badge-archived {
            background-color: #fee2e2;
            color: #b91c1c;
            font-weight: 600;
            font-size: 0.7rem;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid p-0">
            <div class="card card-custom">

                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="fw-bold mb-0">Registered Offices</h6>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-switch me-2">
                            <input class="form-check-input" type="checkbox" id="showArchivedToggle" title="Show or hide archived offices">
                            <label class="form-check-label small text-muted" for="showArchivedToggle">Show Archived</label>
                        </div>
                        <button class="btn btn-secondary btn-sm me-2" title="Add a new cluster" data-bs-toggle="modal" data-bs-target="#addClusterModal">
                            <i class="fas fa-layer-group me-1"></i> Add Cluster
                        </button>
                        <button class="btn btn-primary btn-sm" title="Add a new office" data-bs-toggle="modal" data-bs-target="#addOfficeModal">
                            <i class="fas fa-plus me-1"></i> Add Office
                        </button>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">Office Name</th>
                                    <th class="py-3">Head / Director</th>
                                    <th class="py-3">Email Address</th>
                                    <th class="px-4 py-3 text-end">Actions</th>
                                </tr>
                            </thead>

                            <% 
                            let grouped = {};
                            // UNA: I-initialize ang lahat ng clusters mula sa clustersData para kahit walang office, lilitaw pa rin ang Cluster Header!
                            if (typeof clustersData !== 'undefined' && clustersData.length > 0) {
                                clustersData.forEach(c => {
                                    grouped[c.cluster_name] = [];
                                });
                            }
                            // PANGALAWANG HAKBANG: I-grupo ang mga offices sa kani-kanilang cluster
                            if (typeof officesData !== 'undefined' && officesData.length > 0) {
                                officesData.forEach(off => {
                                    if(!grouped[off.cluster_name]) grouped[off.cluster_name] = [];
                                    grouped[off.cluster_name].push(off);
                                });
                            }
                            %>

                            <% if (Object.keys(grouped).length > 0) { %>
                                <% Object.keys(grouped).forEach((cluster, index) => { 
                                    let targetId = 'cluster-' + index;
                                %>
                                    <tbody>
                                        <tr class="bg-light cluster-toggle" data-target="<%= targetId %>">
                                            <td colspan="4" class="px-4 py-3 fw-bold text-primary">
                                                <i class="fas fa-chevron-down me-2 cluster-icon"></i>
                                                <%= cluster %> 
                                                <span class="badge bg-secondary ms-2 fs-7 fw-normal"><%= grouped[cluster].length %> Office(s)</span>
                                            </td>
                                        </tr>
                                    </tbody>

                                    <tbody id="<%= targetId %>">
                                        <% if (grouped[cluster].length > 0) { %>
                                            <% grouped[cluster].forEach(office => { %>
                                                <tr class="<%= office.is_archived ? 'archived-row office-row-archived' : 'office-row-active' %>">
                                                    <td class="px-4 py-2 fw-semibold">
                                                        <%= office.office_name %>
                                                        <% if (office.is_archived) { %>
                                                            <span class="badge badge-archived ms-2">ARCHIVED</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-muted"><%= office.head_director %></td>
                                                    <td><%= office.email_address %></td>
                                                    <td class="px-4 py-2 text-end text-nowrap">
                                                        <button class="btn btn-sm btn-outline-primary me-1" title="Edit this office"
                                                                onclick="openEditModal('<%= office.id %>', '<%= office.cluster_name %>', '<%= office.office_name %>', '<%= office.head_director %>', '<%= office.email_address %>')">
                                                            <i class="fas fa-edit"></i> Edit
                                                        </button>
                                                        <% if (office.is_archived) { %>
                                                            <form action="/offices/restore/<%= office.id %>" method="POST" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Restore this office">
                                                                    <i class="fas fa-undo"></i> Restore
                                                                </button>
                                                            </form>
                                                        <% } else { %>
                                                            <form action="/offices/delete/<%= office.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Sigurado ka ba na gusto mong i-archive ang office na ito?');">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Archive this office">
                                                                    <i class="fas fa-box-archive"></i> Archive
                                                                </button>
                                                            </form>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-3 text-muted fst-italic">Walang rehistradong opisina sa cluster na ito. Magdagdag gamit ang "Add Office".</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                <% }) %>
                            <% } else { %>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Walang nahanap na mga cluster o opisina sa database.</td>
                                    </tr>
                                </tbody>
                            <% } %>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addClusterModal" tabindex="-1" aria-labelledby="addClusterModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/clusters/add" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="addClusterModalLabel">Add New Cluster</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <input type="text" name="cluster_name" class="form-control" placeholder="E.g., Research and Development Cluster" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Cluster</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="addOfficeModal" tabindex="-1" aria-labelledby="addOfficeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/offices/add" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="addOfficeModalLabel">Add New Office</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <select name="cluster_name" class="form-select" required>
                    <option value="" disabled selected>Select Cluster</option>
                    <% if (typeof clustersData !== 'undefined' && clustersData.length > 0) { %>
                        <% clustersData.forEach(cluster => { %>
                            <option value="<%= cluster.cluster_name %>"><%= cluster.cluster_name %></option>
                        <% }) %>
                    <% } else { %>
                        <option value="Office of the President Cluster">Office of the President Cluster</option>
                        <option value="Administrative and Finance Cluster">Administrative and Finance Cluster</option>
                        <option value="Academic Cluster">Academic Cluster</option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Office Name</label>
                <input type="text" name="office_name" class="form-control" placeholder="E.g., INTERNAL AUDIT UNIT" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Head / Director</label>
                <input type="text" name="head_director" class="form-control" value="Not Assigned">
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" name="email_address" class="form-control" placeholder="office@cspc.edu.ph" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Office</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editOfficeModal" tabindex="-1" aria-labelledby="editOfficeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/offices/edit" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="editOfficeModalLabel">Edit Office</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="id" id="edit_id">
            
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <select name="cluster_name" id="edit_cluster_name" class="form-select" required>
                    <% if (typeof clustersData !== 'undefined' && clustersData.length > 0) { %>
                        <% clustersData.forEach(cluster => { %>
                            <option value="<%= cluster.cluster_name %>"><%= cluster.cluster_name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Office Name</label>
                <input type="text" name="office_name" id="edit_office_name" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Head / Director</label>
                <input type="text" name="head_director" id="edit_head_director" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" name="email_address" id="edit_email_address" class="form-control" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Update Office</button>
          </div>
      </form>
    </div>
  </div>
</div>

<%- include('layout/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Archived offices ay tinatago by default; naka-toggle lang para makita.
        const archivedRows = document.querySelectorAll('.office-row-archived');
        archivedRows.forEach(row => row.style.display = 'none');

        const showArchivedToggle = document.getElementById('showArchivedToggle');
        if (showArchivedToggle) {
            showArchivedToggle.addEventListener('change', function () {
                archivedRows.forEach(row => {
                    row.style.display = this.checked ? '' : 'none';
                });
            });
        }

        const toggles = document.querySelectorAll('.cluster-toggle');
        toggles.forEach(toggle => {
            toggle.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const target = document.getElementById(targetId);
                if (!target) return;

                if (target.style.display === 'none') {
                    target.style.display = '';
                    this.classList.remove('collapsed');
                } else {
                    target.style.display = 'none';
                    this.classList.add('collapsed');
                }
            });
        });
    });

    function openEditModal(id, cluster, officeName, head, email) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_cluster_name').value = cluster;
        document.getElementById('edit_office_name').value = officeName;
        document.getElementById('edit_head_director').value = head;
        document.getElementById('edit_email_address').value = email;
        
        var editModal = new bootstrap.Modal(document.getElementById('editOfficeModal'));
        editModal.show();
    }
</script>
</body>
</html>