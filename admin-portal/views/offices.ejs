<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <style>
        .cluster-toggle {
            cursor: pointer;
            user-select: none;
            transition: background-color 0.2s ease;
        }

        .cluster-toggle:hover {
            background-color: #f8f9fc !important;
        }

        .cluster-icon {
            transition: transform 0.2s ease;
        }

        .cluster-toggle.collapsed .cluster-icon {
            transform: rotate(-90deg);
        }

        .archived-row {
            opacity: 0.55;
            background-color: #f8fafc;
        }

        /* Archived rows/clusters are hidden by default via CSS (not JS-on-load)
           so there's no flash of the full unfiltered table before script runs —
           the "Show Archived" toggle reveals them by adding body.show-archived. */
        tr.office-row-archived { display: none; }
        tbody.cluster-row-archived { display: none; }
        body.show-archived tr.office-row-archived { display: table-row; }
        body.show-archived tbody.cluster-row-archived { display: table-row-group; }
        .badge-archived {
            background-color: #fee2e2;
            color: #b91c1c;
            font-weight: 600;
            font-size: 0.7rem;
            letter-spacing: 0.5px;
        }

        /* CSM-style export table (mirrors the official "List of Services" format) */
        #csmExportContent {
            position: absolute;
            left: -9999px;
            top: 0;
        }
        .csm-export-container {
            background: #fff;
            padding: 20px 28px 30px;
            color: #1a1a1a;
            font-family: Arial, sans-serif;
            width: 940px;
            box-sizing: border-box;
        }
        .csm-export-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
            padding-bottom: 8px;
            margin-bottom: 14px;
        }
        .csm-export-title h4 {
            margin: 0;
            font-weight: 700;
            font-size: 16px;
            letter-spacing: 0.5px;
        }
        .csm-table-wrap { border: 2px solid #000; }
        .csm-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
        .csm-table th, .csm-table td {
            border: 1px solid #000;
            padding: 6px 10px;
            vertical-align: middle;
        }
        .csm-table thead th {
            background-color: #1F3864 !important;
            color: #fff !important;
            text-align: center;
            font-weight: 700;
            font-size: 12px;
            padding: 9px 10px;
            border-color: #000;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .csm-table td.csm-unit {
            font-weight: 700;
            color: #1F3864;
        }
        .csm-table td.csm-num { text-align: center; white-space: nowrap; }
        .csm-table td.csm-empty { text-align: center; font-style: italic; color: #666; }

        /* Printing: hide everything except the export table, let the browser paginate
           the table naturally (repeats the header row, never slices a row in half) —
           this replaced an html2pdf/html2canvas screenshot-and-slice approach that
           corrupted the layout past the first page or two of a long table. */
        @media print {
            body * { visibility: hidden; }
            #csmExportContent, #csmExportContent * { visibility: visible; }
            #csmExportContent {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
            }
            .csm-export-container { width: 100% !important; }
            .csm-table thead { display: table-header-group; }
            .csm-table tr { page-break-inside: avoid; }
            @page { size: landscape; margin: 0.4in; }
        }
    </style>
</head>
<body>
<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid p-0">
            <div class="card card-custom">

                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h6 class="fw-bold mb-0">Registered Offices</h6>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check form-switch me-2">
                            <input class="form-check-input" type="checkbox" id="showArchivedToggle" title="Show or hide archived offices">
                            <label class="form-check-label small text-muted" for="showArchivedToggle">Show Archived</label>
                        </div>
                        <button class="btn btn-outline-danger btn-sm me-2" type="button" title="Preview the list of offices and services before printing or downloading" onclick="openExportPreview();">
                            <i class="fas fa-file-export me-1"></i> Export
                        </button>
                        <button class="btn btn-secondary btn-sm me-2" title="Add a new cluster" data-bs-toggle="modal" data-bs-target="#addClusterModal">
                            <i class="fas fa-layer-group me-1"></i> Add Cluster
                        </button>
                        <button class="btn btn-primary btn-sm" title="Add a new office" data-bs-toggle="modal" data-bs-target="#addOfficeModal">
                            <i class="fas fa-plus me-1"></i> Add Office
                        </button>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">Office Name</th>
                                    <th class="py-3">Head / Director</th>
                                    <th class="py-3">Email Address</th>
                                    <th class="px-4 py-3 text-end">Actions</th>
                                </tr>
                            </thead>

                            <%
                            let grouped = {};
                            let clusterMeta = {};
                            // UNA: I-initialize ang lahat ng clusters mula sa clustersData para kahit walang office, lilitaw pa rin ang Cluster Header!
                            if (typeof clustersData !== 'undefined' && clustersData.length > 0) {
                                clustersData.forEach(c => {
                                    grouped[c.cluster_name] = [];
                                    clusterMeta[c.cluster_name] = c;
                                });
                            }
                            // PANGALAWANG HAKBANG: I-grupo ang mga offices sa kani-kanilang cluster
                            if (typeof officesData !== 'undefined' && officesData.length > 0) {
                                officesData.forEach(off => {
                                    if(!grouped[off.cluster_name]) grouped[off.cluster_name] = [];
                                    grouped[off.cluster_name].push(off);
                                });
                            }
                            %>

                            <% if (Object.keys(grouped).length > 0) { %>
                                <% Object.keys(grouped).forEach((cluster, index) => {
                                    let targetId = 'cluster-' + index;
                                    let meta = clusterMeta[cluster];
                                    let clusterArchived = meta ? !!meta.is_archived : false;
                                %>
                                    <tbody class="<%= clusterArchived ? 'archived-row cluster-row-archived' : 'cluster-row-active' %>">
                                        <tr class="bg-light cluster-toggle" data-target="<%= targetId %>" data-cluster="<%= cluster %>">
                                            <td colspan="3" class="px-4 py-3 fw-bold text-primary">
                                                <i class="fas fa-chevron-down me-2 cluster-icon"></i>
                                                <%= cluster %>
                                                <span class="badge bg-secondary ms-2 fs-7 fw-normal"><%= grouped[cluster].length %> Office(s)</span>
                                                <% if (clusterArchived) { %>
                                                    <span class="badge badge-archived ms-2">ARCHIVED</span>
                                                <% } %>
                                            </td>
                                            <td class="px-4 py-3 text-end text-nowrap">
                                                <% if (meta) { %>
                                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Edit this cluster"
                                                            onclick="event.stopPropagation(); openEditClusterModal('<%= meta.id %>', '<%= cluster %>')">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </button>
                                                    <% if (clusterArchived) { %>
                                                        <form action="/clusters/restore/<%= meta.id %>" method="POST" style="display:inline;" onclick="event.stopPropagation();">
                                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Restore this cluster">
                                                                <i class="fas fa-undo"></i> Restore
                                                            </button>
                                                        </form>
                                                        <form action="/clusters/permanent-delete/<%= meta.id %>" method="POST" style="display:inline;" class="permanent-delete-cluster-form" onclick="event.stopPropagation();">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Permanently delete this cluster">
                                                                <i class="fas fa-trash"></i> Delete
                                                            </button>
                                                        </form>
                                                    <% } else { %>
                                                        <form action="/clusters/delete/<%= meta.id %>" method="POST" style="display:inline;" class="archive-cluster-form" onclick="event.stopPropagation();">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Archive this cluster">
                                                                <i class="fas fa-box-archive"></i> Archive
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        </tr>
                                    </tbody>

                                    <tbody id="<%= targetId %>" class="<%= clusterArchived ? 'cluster-row-archived' : '' %>">
                                        <% if (grouped[cluster].length > 0) { %>
                                            <% grouped[cluster].forEach(office => { %>
                                                <tr class="<%= office.is_archived ? 'archived-row office-row-archived' : 'office-row-active' %>">
                                                    <td class="px-4 py-2 fw-semibold">
                                                        <%= office.office_name %>
                                                        <% if (office.is_archived) { %>
                                                            <span class="badge badge-archived ms-2">ARCHIVED</span>
                                                        <% } %>
                                                    </td>
                                                    <td class="text-muted"><%= office.head_director %></td>
                                                    <td><%= office.email_address %></td>
                                                    <td class="px-4 py-2 text-end text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 open-services-btn" title="Manage services availed at this office"
                                                                data-office-id="<%= office.id %>"
                                                                data-office-name="<%= office.office_name %>"
                                                                data-office-services="<%= JSON.stringify((typeof officeServicesData !== 'undefined' && officeServicesData[office.id]) || []) %>">
                                                            <i class="fas fa-list-check"></i> Services
                                                        </button>
                                                        <button class="btn btn-sm btn-outline-primary me-1" title="Edit this office"
                                                                onclick="openEditModal('<%= office.id %>', '<%= office.cluster_name %>', '<%= office.office_name %>', '<%= office.head_director %>', '<%= office.email_address %>')">
                                                            <i class="fas fa-edit"></i> Edit
                                                        </button>
                                                        <% if (office.is_archived) { %>
                                                            <form action="/offices/restore/<%= office.id %>" method="POST" style="display:inline;">
                                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Restore this office">
                                                                    <i class="fas fa-undo"></i> Restore
                                                                </button>
                                                            </form>
                                                            <form action="/offices/permanent-delete/<%= office.id %>" method="POST" style="display:inline;" class="permanent-delete-office-form">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Permanently delete this office">
                                                                    <i class="fas fa-trash"></i> Delete
                                                                </button>
                                                            </form>
                                                        <% } else { %>
                                                            <form action="/offices/delete/<%= office.id %>" method="POST" style="display:inline;" class="archive-office-form">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Archive this office">
                                                                    <i class="fas fa-box-archive"></i> Archive
                                                                </button>
                                                            </form>
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center py-3 text-muted fst-italic">Walang rehistradong opisina sa cluster na ito. Magdagdag gamit ang "Add Office".</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                <% }) %>
                            <% } else { %>
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">Walang nahanap na mga cluster o opisina sa database.</td>
                                    </tr>
                                </tbody>
                            <% } %>
                        </table>
                        <script>
                            // Runs immediately as this element parses (no defer) so a full MPA
                            // page load restores each cluster's collapsed state before first
                            // paint, instead of flashing the fully-expanded table open and then
                            // snapping shut once DOMContentLoaded fires (that flash was the
                            // navigation "glitch" into this page).
                            (function () {
                                try {
                                    var collapsedState = JSON.parse(localStorage.getItem('officeClusterCollapsed')) || {};
                                } catch (e) {
                                    var collapsedState = {};
                                }
                                document.querySelectorAll('.cluster-toggle').forEach(function (toggle) {
                                    var clusterName = toggle.getAttribute('data-cluster');
                                    if (!collapsedState[clusterName]) return;
                                    var target = document.getElementById(toggle.getAttribute('data-target'));
                                    if (!target) return;
                                    target.style.display = 'none';
                                    toggle.classList.add('collapsed');
                                });
                            })();
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden export table used by printOfficesList() (native print) and downloadOfficesPDF() (jsPDF-AutoTable reads this table directly) -->
<div id="csmExportContent">
    <div class="csm-export-container">
        <div class="csm-export-title">
            <h4>LIST OF OFFICES AND SERVICES OFFERED</h4>
            <h4><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></h4>
        </div>
        <div class="csm-table-wrap">
        <table class="csm-table">
            <thead>
                <tr>
                    <th style="width: 22%;">Responsible Unit</th>
                    <th style="width: 8%;">Service #</th>
                    <th>Services</th>
                </tr>
            </thead>
            <tbody>
                <%
                let exportCounter = 0;
                let exportOffices = (typeof officesData !== 'undefined') ? officesData.filter(o => !o.is_archived).sort((a, b) => a.office_name.localeCompare(b.office_name)) : [];
                %>
                <% if (exportOffices.length === 0) { %>
                    <tr><td colspan="3" class="csm-empty text-center">Walang nakatalang opisina.</td></tr>
                <% } %>
                <% exportOffices.forEach((office) => { %>
                    <%
                    let svcList = (typeof officeServicesData !== 'undefined' && officeServicesData[office.id]) || [];
                    let rowspan = svcList.length > 0 ? svcList.length : 1;
                    %>
                    <% if (svcList.length === 0) { %>
                        <tr>
                            <td class="csm-unit"><%= office.office_name %></td>
                            <td class="csm-num">&mdash;</td>
                            <td class="csm-empty">No services listed</td>
                        </tr>
                    <% } else { %>
                        <% svcList.forEach((svc, i) => { exportCounter++; %>
                            <tr>
                                <% if (i === 0) { %>
                                    <td class="csm-unit" rowspan="<%= rowspan %>"><%= office.office_name %></td>
                                <% } %>
                                <td class="csm-num"><%= exportCounter %></td>
                                <td><%= svc.service_name %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                <% }) %>
            </tbody>
        </table>
        </div>
    </div>
</div>

<!-- Preview modal: shows the export content on-screen so the user can review it before printing or downloading -->
<div class="modal fade" id="exportPreviewModal" tabindex="-1" aria-labelledby="exportPreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="exportPreviewModalLabel"><i class="fas fa-eye me-2"></i>Preview — List of Offices and Services</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body bg-light">
        <div style="overflow-x: auto; display: flex; justify-content: center;">
            <div id="exportPreviewBody"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-outline-primary" onclick="printOfficesList();"><i class="fas fa-print me-2"></i> Print</button>
        <button type="button" class="btn btn-danger" onclick="downloadOfficesPDF();"><i class="fas fa-file-pdf me-2"></i> Download PDF</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="addClusterModal" tabindex="-1" aria-labelledby="addClusterModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/clusters/add" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="addClusterModalLabel">Add New Cluster</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <input type="text" name="cluster_name" class="form-control" placeholder="E.g., Research and Development Cluster" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Cluster</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="editClusterModal" tabindex="-1" aria-labelledby="editClusterModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/clusters/edit" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="editClusterModalLabel">Edit Cluster</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="id" id="edit_cluster_id">
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <input type="text" name="cluster_name" id="edit_cluster_name_input" class="form-control" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Update Cluster</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="addOfficeModal" tabindex="-1" aria-labelledby="addOfficeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/offices/add" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="addOfficeModalLabel">Add New Office</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <select name="cluster_name" class="form-select" required>
                    <option value="" disabled selected>Select Cluster</option>
                    <% if (typeof clustersData !== 'undefined' && clustersData.length > 0) { %>
                        <% clustersData.filter(c => !c.is_archived).forEach(cluster => { %>
                            <option value="<%= cluster.cluster_name %>"><%= cluster.cluster_name %></option>
                        <% }) %>
                    <% } else { %>
                        <option value="Office of the president cluster">Office of the president cluster</option>
                        <option value="Administrative and Finance Cluster">Administrative and Finance Cluster</option>
                        <option value="Academic Cluster">Academic Cluster</option>
                        <option value="Reasearch, Innovation and Collaboration Cluster">Reasearch, Innovation and Collaboration Cluster</option>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Office Name</label>
                <input type="text" name="office_name" class="form-control" placeholder="E.g., INTERNAL AUDIT UNIT" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Head / Director</label>
                <input type="text" name="head_director" class="form-control" value="Not Assigned">
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" name="email_address" class="form-control" placeholder="office@cspc.edu.ph" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Service(s) Availed</label>
                <div id="addServiceRows">
                    <div class="input-group mb-2">
                        <input type="text" name="service_name" class="form-control" placeholder="E.g., Requesting for Clearance">
                        <button type="button" class="btn btn-outline-secondary" onclick="addServiceRow()" title="Add another service">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="form-text">Optional — pwede ka ring magdagdag ng services mamaya gamit ang "Services" button sa listahan.</div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save Office</button>
          </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="servicesModal" tabindex="-1" aria-labelledby="servicesModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="servicesModalLabel">Services Availed — <span id="servicesOfficeName"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ul id="servicesList" class="list-group mb-3"></ul>

        <form action="/services/add" method="POST" class="d-flex gap-2">
            <input type="hidden" name="office_id" id="servicesOfficeId">
            <input type="text" name="service_name" class="form-control" placeholder="E.g., Requesting for Clearance" required>
            <button type="submit" class="btn btn-primary text-nowrap"><i class="fas fa-plus me-1"></i> Add</button>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="editOfficeModal" tabindex="-1" aria-labelledby="editOfficeModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/offices/edit" method="POST">
          <div class="modal-header">
            <h5 class="modal-title fw-bold" id="editOfficeModalLabel">Edit Office</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="id" id="edit_id">
            
            <div class="mb-3">
                <label class="form-label fw-bold">Cluster Name</label>
                <select name="cluster_name" id="edit_cluster_name" class="form-select" required>
                    <% if (typeof clustersData !== 'undefined' && clustersData.length > 0) { %>
                        <% clustersData.forEach(cluster => { %>
                            <option value="<%= cluster.cluster_name %>"><%= cluster.cluster_name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Office Name</label>
                <input type="text" name="office_name" id="edit_office_name" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Head / Director</label>
                <input type="text" name="head_director" id="edit_head_director" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input type="email" name="email_address" id="edit_email_address" class="form-control" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Update Office</button>
          </div>
      </form>
    </div>
  </div>
</div>

<%- include('layout/footer') %>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Archived offices/clusters are hidden by default via the CSS in <head>
        // (no flash on load) — toggling this body class is all that's needed
        // to reveal/hide them.

        // Confirm before archiving an office (modern modal instead of window.confirm)
        document.querySelectorAll('.archive-office-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const confirmed = await AppAlert.confirm('Sigurado ka ba na gusto mong i-archive ang office na ito?', {
                    title: 'Archive this office?',
                    confirmText: 'Yes, archive it!'
                });
                if (confirmed) form.submit();
            });
        });

        // Confirm before archiving a cluster
        document.querySelectorAll('.archive-cluster-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const confirmed = await AppAlert.confirm('Sigurado ka ba na gusto mong i-archive ang cluster na ito? Ma-a-archive din ang lahat ng offices sa ilalim nito.', {
                    title: 'Archive this cluster?',
                    confirmText: 'Yes, archive it!'
                });
                if (confirmed) form.submit();
            });
        });

        // Confirm before permanently deleting an office (irreversible)
        document.querySelectorAll('.permanent-delete-office-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const confirmed = await AppAlert.confirm('Permanente itong tatanggalin sa database at hindi na maibabalik. Sigurado ka ba?', {
                    title: 'Permanently delete this office?',
                    confirmText: 'Yes, delete permanently!'
                });
                if (confirmed) form.submit();
            });
        });

        // Confirm before permanently deleting a cluster (irreversible, cascades to its offices)
        document.querySelectorAll('.permanent-delete-cluster-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const confirmed = await AppAlert.confirm('Permanente itong tatanggalin sa database kasama ang lahat ng offices sa ilalim nito, at hindi na maibabalik. Sigurado ka ba?', {
                    title: 'Permanently delete this cluster?',
                    confirmText: 'Yes, delete permanently!'
                });
                if (confirmed) form.submit();
            });
        });

        const showArchivedToggle = document.getElementById('showArchivedToggle');
        if (showArchivedToggle) {
            showArchivedToggle.addEventListener('change', function () {
                document.body.classList.toggle('show-archived', this.checked);
            });
        }

        // I-restore ang naka-save na collapsed state ng bawat cluster (per cluster name, hindi index)
        // para hindi na mag-reset sa "open" kapag nag-refresh o lumipat ng page.
        // (Initial state is already applied synchronously right after the table
        // markup above — this just wires up the click handler + persistence.)
        const COLLAPSE_KEY = 'officeClusterCollapsed';
        function loadCollapsedState() {
            try {
                return JSON.parse(localStorage.getItem(COLLAPSE_KEY)) || {};
            } catch (e) {
                return {};
            }
        }
        function saveCollapsedState(state) {
            localStorage.setItem(COLLAPSE_KEY, JSON.stringify(state));
        }

        const collapsedState = loadCollapsedState();
        const toggles = document.querySelectorAll('.cluster-toggle');

        toggles.forEach(toggle => {
            const targetId = toggle.getAttribute('data-target');
            const clusterName = toggle.getAttribute('data-cluster');
            const target = document.getElementById(targetId);
            if (!target) return;

            toggle.addEventListener('click', function () {
                if (target.style.display === 'none') {
                    target.style.display = '';
                    toggle.classList.remove('collapsed');
                    delete collapsedState[clusterName];
                } else {
                    target.style.display = 'none';
                    toggle.classList.add('collapsed');
                    collapsedState[clusterName] = true;
                }
                saveCollapsedState(collapsedState);
            });
        });
    });

    // Add Office modal — repeatable "Service(s) Availed" rows. Each row posts as
    // service_name[] alongside the office fields when the form is submitted.
    function addServiceRow() {
        const wrap = document.getElementById('addServiceRows');
        const row = document.createElement('div');
        row.className = 'input-group mb-2';
        row.innerHTML = `
            <input type="text" name="service_name" class="form-control" placeholder="E.g., Requesting for Clearance">
            <button type="button" class="btn btn-outline-danger" title="Remove this row">
                <i class="fas fa-minus"></i>
            </button>
        `;
        row.querySelector('button').addEventListener('click', () => row.remove());
        wrap.appendChild(row);
    }

    // Wired via data-* attributes (rather than inline onclick with interpolated
    // JSON) so an office name containing a quote/apostrophe can't break the markup.
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.open-services-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                let services = [];
                try { services = JSON.parse(btn.dataset.officeServices || '[]'); } catch (e) {}
                openServicesModal(btn.dataset.officeId, btn.dataset.officeName, services);
            });
        });
    });

    // Per-office "Services" modal — lists existing services (with delete) and a
    // quick add form, both wired to the /services/add and /services/delete routes.
    function openServicesModal(officeId, officeName, services) {
        document.getElementById('servicesOfficeId').value = officeId;
        document.getElementById('servicesOfficeName').textContent = officeName;

        const list = document.getElementById('servicesList');
        list.innerHTML = '';
        if (!services || services.length === 0) {
            list.innerHTML = '<li class="list-group-item text-muted fst-italic">Wala pang naitalang service sa office na ito.</li>';
        } else {
            services.forEach(svc => {
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';

                const nameSpan = document.createElement('span');
                nameSpan.textContent = svc.service_name;

                const form = document.createElement('form');
                form.action = `/services/delete/${svc.id}`;
                form.method = 'POST';
                form.className = 'delete-service-form';
                form.innerHTML = '<button type="submit" class="btn btn-sm btn-outline-danger" title="Remove this service"><i class="fas fa-trash"></i></button>';

                li.appendChild(nameSpan);
                li.appendChild(form);
                list.appendChild(li);
            });
        }

        list.querySelectorAll('.delete-service-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const confirmed = await AppAlert.confirm('Tanggalin ang service na ito?', {
                    title: 'Remove service?',
                    confirmText: 'Yes, remove it!'
                });
                if (confirmed) form.submit();
            });
        });

        var servicesModal = new bootstrap.Modal(document.getElementById('servicesModal'));
        servicesModal.show();
    }

    function openEditClusterModal(id, clusterName) {
        document.getElementById('edit_cluster_id').value = id;
        document.getElementById('edit_cluster_name_input').value = clusterName;

        var editClusterModal = new bootstrap.Modal(document.getElementById('editClusterModal'));
        editClusterModal.show();
    }

    // Clones the (hidden) export table into the preview modal so the user can
    // review the exact content before choosing to print or download it.
    function openExportPreview() {
        const source = document.querySelector('#csmExportContent .csm-export-container');
        const previewBody = document.getElementById('exportPreviewBody');
        previewBody.innerHTML = '';
        previewBody.appendChild(source.cloneNode(true));

        var previewModal = new bootstrap.Modal(document.getElementById('exportPreviewModal'));
        previewModal.show();
    }

    function printOfficesList() {
        // Native print pipeline — the table paginates by real row boundaries
        // (header repeats, rows never split mid-cell). User can pick "Save as
        // PDF" as the print destination if they just want a file.
        window.print();
    }

    function downloadOfficesPDF() {
        // jsPDF-AutoTable reads the actual <table> (including rowspans) and lays
        // it out as real PDF content — it paginates by row, never as a sliced
        // screenshot, so long tables stay intact across pages.
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'letter' });

        doc.autoTable({
            html: '#csmExportContent .csm-table',
            theme: 'grid',
            startY: 40,
            margin: { top: 40, left: 30, right: 30, bottom: 30 },
            styles: { fontSize: 9, cellPadding: 5, valign: 'middle', lineColor: [0, 0, 0], lineWidth: 0.75 },
            headStyles: { fillColor: [31, 56, 100], textColor: 255, halign: 'center', fontStyle: 'bold', fontSize: 10 },
            columnStyles: {
                0: { fontStyle: 'bold', textColor: [31, 78, 121], cellWidth: 170 },
                1: { halign: 'center', cellWidth: 55 }
            },
            didDrawPage: function () {
                doc.setFontSize(13);
                doc.setFont(undefined, 'bold');
                doc.text('LIST OF OFFICES AND SERVICES OFFERED', 30, 25);
            }
        });

        doc.save('Offices_and_Services.pdf');
    }

    function openEditModal(id, cluster, officeName, head, email) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_cluster_name').value = cluster;
        document.getElementById('edit_office_name').value = officeName;
        document.getElementById('edit_head_director').value = head;
        document.getElementById('edit_email_address').value = email;
        
        var editModal = new bootstrap.Modal(document.getElementById('editOfficeModal'));
        editModal.show();
    }
</script>
</body>
</html>