                        <p class="text-muted small mb-3">Highest satisfaction rating this period</p>
                        <% if (typeof topOffices !== 'undefined' && topOffices.length > 0) { %>
                            <div style="height: 330px; position: relative;" class="mb-3">
                                <canvas id="topOfficesChart"></canvas>
                            </div>
                            <% topOffices.forEach((o, i) => { %>
                                <div class="rank-item">
                                    <div class="rank-left">
                                        <span class="rank-badge <%= i === 0 ? 'medal-1' : (i === 1 ? 'medal-2' : (i === 2 ? 'medal-3' : '')) %>">
                                            <% if (i < 3) { %><i class="fas fa-medal"></i><% } else { %>#<%= i + 1 %><% } %>
                                        </span>
                                        <div>
                                            <div class="rank-name"><%= o.name %></div>
                                            <div class="rank-sub"><%= o.cluster %> &middot; <%= o.respondents %> respondents</div>
                                        </div>
                                    </div>
                                    <span class="rank-score good"><%= o.score.toFixed(2) %>%</span>
