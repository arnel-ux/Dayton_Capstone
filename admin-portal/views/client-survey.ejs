        <!-- ================= PROFILE VIEW ================= -->
        <div class="app-view" id="view-profile">
            <div class="card border-0 view-card profile-view-card">
                <div class="card-body p-0">

                    <!-- The card body is p-0 (the hero below runs edge to edge),
                         so this one strip carries its own horizontal padding. -->
                    <div class="view-page-title px-4 pt-4 px-md-5 pt-md-4 mb-0">
                        <span class="vpt-icon"><i class="bi bi-person-fill"></i></span>
                        <div class="vpt-text">
                            <h1 class="vpt-name">My Profile</h1>
                        </div>
                    </div>

                    <!-- Centered, portrait-style hero. The old layout was a small
                         60px avatar beside an <h3>My Profile</h3> — dropped back
                         then because the app header was rendering "My Profile" as
                         this view's title, making it the same words twice. The
                         title now lives in this card (the strip above) and the
                         header carries the portal's identity instead, so there is
                         still exactly one "My Profile" on screen. The avatar
                         carries the hero, and the identity underneath it (the
                         person's actual name and email) is the part that isn't
                         stated anywhere else on the page. -->
                    <div class="profile-hero">
                        <div class="profile-hero-avatar" id="pf-avatar"><i class="bi bi-person-fill"></i></div>
                        <div class="profile-hero-text">
                            <h3 id="pf-hero-name">&nbsp;</h3>
                            <p id="pf-hero-email">&nbsp;</p>
                        </div>
                    </div>

                    <div class="profile-body">

                        <div id="profileLoading" class="spinner-block">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-3 mb-0">Loading your profile…</p>
                        </div>

                        <div id="profileContent" class="d-none">

                            <div id="profileOfflineNote" class="history-meta mb-3 d-none"><i class="bi bi-wifi-off me-1"></i>Viewing offline — showing your last-loaded profile.</div>

                            <!-- ================= VIEW MODE ================= -->
                            <!-- Static account summary. Hidden (via .d-none) once Edit Profile is clicked. -->
                            <div id="profileViewMode">
                                <div class="profile-section-header">
                                    <div class="profile-section-label mb-0">Account Information</div>
                                    <button type="button" id="btnEditProfile" class="btn-edit-profile" onclick="enterProfileEditMode()">
                                        <i class="bi bi-pencil-fill me-1"></i> Edit Profile
                                    </button>
                                </div>
                                <div class="profile-info-grid">
                                    <div class="profile-info-card profile-info-card-name">
                                        <div class="profile-info-icon"><i class="bi bi-person-fill"></i></div>
                                        <div class="profile-info-text">
                                            <div class="profile-info-label" data-i18n="pf_lbl_name">Name</div>
                                            <div class="profile-info-value" id="pf-name-display">—</div>
                                        </div>
                                    </div>
                                    <div class="profile-info-card">
                                        <div class="profile-info-icon"><i class="bi bi-envelope-fill"></i></div>
                                        <div class="profile-info-text">
                                            <div class="profile-info-label">Email (Google Account)</div>
                                            <div class="profile-info-value" id="pf-email">—</div>
                                        </div>
                                    </div>
                                    <div class="profile-info-card">
                                        <div class="profile-info-icon"><i class="bi bi-geo-alt-fill"></i></div>
                                        <div class="profile-info-text">
                                            <div class="profile-info-label">Region of Residence</div>
                                            <div class="profile-info-value" id="pf-region"></div>
                                        </div>
                                    </div>
                                    <div class="profile-info-card">
                                        <div class="profile-info-icon"><i class="bi bi-calendar3"></i></div>
                                        <div class="profile-info-text">
                                            <div class="profile-info-label">Age Bracket</div>
                                            <div class="profile-info-value" id="pf-age"></div>
                                        </div>
                                    </div>
                                    <div class="profile-info-card">
                                        <div class="profile-info-icon"><i class="bi bi-gender-ambiguous"></i></div>
                                        <div class="profile-info-text">
                                            <div class="profile-info-label">Sex</div>
                                            <div class="profile-info-value" id="pf-gender"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ================= EDIT MODE ================= -->
                            <!-- Only Name is editable — Region/Age/Sex are locked for good after the
                                 client's first survey submission (see loadProfileView), so they are
                                 never turned into inputs here. Hidden by default; toggled by
                                 enterProfileEditMode() / exitProfileEditMode() below. -->
                            <div id="profileEditMode" class="d-none">
                                <div class="profile-section-label">Edit Details</div>
                                <form id="profileForm" onsubmit="return saveProfile(event);" class="profile-edit-card">
                                    <label class="form-label fw-semibold text-dark fs-6" for="pf-name-input" data-i18n="pf_lbl_name">Name</label>
                                    <input type="text" id="pf-name-input" class="form-control mb-3" placeholder="e.g. Juan Dela Cruz">
                                    <div class="d-flex gap-2">
                                        <button type="submit" id="pf-save-btn" class="btn btn-primary fw-semibold px-4">
                                            <i class="bi bi-check2-circle me-1"></i> Update
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary fw-semibold px-4" onclick="exitProfileEditMode()">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <!-- ================= SECURITY ================= -->
                            <!-- Password management. Collapsed by default so the
                                 profile still opens on the account summary rather
                                 than on a form nobody asked for yet. The toggle
                                 button and the strength meter are both injected by
                                 public/js/alerts.js (this page loads it) — the meter
                                 because of data-pw-strength on the new-password
                                 field. -->
                            <div id="profileSecurity" class="profile-security">
                                <div class="profile-section-header">
                                    <div class="profile-section-label mb-0">Password</div>
                                    <button type="button" id="btnTogglePassword" class="btn-edit-profile" onclick="togglePasswordPanel()">
                                        <i class="bi bi-shield-lock-fill me-1"></i> <span id="btnTogglePasswordText">Change Password</span>
                                    </button>
                                </div>

                                <p class="profile-security-hint" id="pf-password-hint">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Used to sign in with your email on the login page.
                                </p>

                                <form id="passwordForm" class="profile-password-card d-none" onsubmit="return saveClientPassword(event);">
                                    <div class="profile-field" id="currentPasswordField">
                                        <label class="profile-field-label" for="pf-current-password">Current Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                            <input type="password" id="pf-current-password" class="form-control" placeholder="Enter your current password" autocomplete="current-password">
                                        </div>
                                    </div>

                                    <div class="profile-field">
                                        <label class="profile-field-label" for="pf-new-password">New Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                            <input type="password" id="pf-new-password" class="form-control" placeholder="At least 8 characters" minlength="8" required autocomplete="new-password" data-pw-strength>
                                        </div>
                                    </div>

                                    <div class="profile-field">
                                        <label class="profile-field-label" for="pf-confirm-password">Confirm New Password</label>
                                        <div class="input-group">
                                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                            <input type="password" id="pf-confirm-password" class="form-control" placeholder="Re-enter your new password" minlength="8" required autocomplete="new-password">
                                        </div>
                                        <p class="profile-field-error d-none" id="pf-password-mismatch">
                                            <i class="bi bi-exclamation-circle me-1"></i> The two passwords don't match.
                                        </p>
                                    </div>

                                    <div class="d-flex gap-2 flex-wrap">
                                        <button type="submit" id="pf-password-save-btn" class="btn btn-primary fw-semibold px-4">
                                            <i class="bi bi-check2-circle me-1"></i> Update Password
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary fw-semibold px-4" onclick="togglePasswordPanel(false)">
                                            Cancel
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ================= HISTORY VIEW ================= -->
        <div class="app-view" id="view-history">
            <div class="card border-0 view-card">
                <div class="card-body p-4 p-md-5">
                    <!-- Was a centered .view-header block with the same icon,
