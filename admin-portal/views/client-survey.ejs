    document.getElementById('rv-comments').textContent = val('textarea[name="comments"]').trim() || '—';
}

// =====================================
// FORM SUBMISSION PAPUNTA SA SERVER.JS
// =====================================
async function submitAll(event) {
    if (event) event.preventDefault();

    // Re-validate every stage (Terms, Profile, CC, SQD) before allowing submission.
    // First pass runs with scroll suppressed — the stage being checked may not
    // be the one currently on screen (e.g. submitting from Review finds Stage 2
    // incomplete), and scrollIntoView on a still-hidden `.page` does nothing.
    // navigate() makes it visible, then the second call (scroll defaulted back
    // on) can actually bring the first missed field into view for real.
    for (let stage = 1; stage <= 4; stage++) {
        if (!validateStage(stage, false)) {
            navigate(stage);
            validateStage(stage);
            return;
        }
    }

    const formElement = document.getElementById('surveyForm');
    const formData = new FormData(formElement);
    const data = Object.fromEntries(formData.entries());

    // This attempt's stable id — reuses whatever autosaveActiveSurveyDraftNow()
    // already generated (the common case: virtually every attempt autosaves
    // at least once past Stage 1), or mints one now for the rare case of a
    // submit with no prior autosave. The server uses this as an idempotency
    // key (see client_submission_id in server.js) so a lost response
    // followed by a retry/resync can never insert two rows for the same
    // attempt. Also becomes the offline outbox record's own localId below,
    // via activeSurveyDraftId — one id, start to finish.
    if (!activeSurveyDraftId) activeSurveyDraftId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : generateOfflineSubmissionId();
    data.client_submission_id = activeSurveyDraftId;

    // 2. Magbigay ng default value kung blangko ang tinype o hindi sinagutan ang dropdown
    data.respondent_name = data.respondent_name?.trim() || 'Anonymous';
    data.email = data.email?.trim() || 'Not Specified';
    data.client_type = data.client_type || 'Citizen';
    data.age = data.age || 'Not Specified';
    data.gender = data.gender || 'Not Specified';
    data.region = data.region || 'Not Specified';
    data.topic = 'General Feedback';

    data.cc1 = data.cc1 || '';
    data.cc2 = data.cc2 || '';
    data.cc3 = data.cc3 || '';

    // Siguraduhing may default number kapag walang nai-check sa table
    for(let i=0; i<=8; i++) {
        data[`sqd${i}`] = parseInt(data[`sqd${i}`] || 5);
    }

    // Lock the just-submitted office+service in the dropdown right away so a
    // "Submit Again" run in the same session can't target it a second time
    // (mirrors the server-rendered blockedCombos disabling on page load).
    markServiceAsTaken(data.office_id, data.service_availed);

    // /survey-offline: no authenticated session exists on this page at all
    // (POST /submit-survey would just 401), so every submission here always
    // queues for POST /api/offline-surveys/verify-and-sync — regardless of
    // current connectivity. If we happen to already be online,
    // runOfflineVerificationFlow (kicked off right below) picks it up and
    // prompts for the account's password almost immediately; if genuinely
    // offline, it waits for the 'online' event like any other queued item.
    if (OFFLINE_MODE) {
        const passwordInput = document.getElementById('offlinePasswordInput');
        const password = passwordInput ? passwordInput.value : '';
        const identifier = (data.email || '').trim().toLowerCase();

        if (!identifier || !password) {
            if (window.AppAlert) {
                AppAlert.warning('Please enter both your registered email and password.');
            }
            return;
        }

        try {
            await queueUnverifiedOfflineSurvey(data);

            if (typeof window.rememberOfflineCredential === 'function') {
                window.rememberOfflineCredential(identifier, password);
            } else {
                // The survey is already safely saved to IndexedDB at this
                // point — a missing credential manager only costs a
                // re-entered password at reconnect (the modal fallback in
                // pwa-client.js still works), never the survey itself.
                console.error('[Offline Sync] Temporary credential manager unavailable');
            }

            // Only cleared now — after the survey is confirmed saved and
            // credential handling has been attempted, never before.
            if (passwordInput) passwordInput.value = '';

            if (window.AppAlert) {
                AppAlert.info(
                    "Your survey has been safely queued on this device. When internet connectivity becomes available, the system will automatically verify your registered account and synchronize your response. You normally will not need to enter your password again while this page remains open.\n\nIf this page is refreshed, closed, or the browser removes it from memory before synchronization, you may need to enter your password again.",
                    'Survey Saved Offline'
                );
            }

            // Deliberately no location.reload()/location.href/window.location
            // change here — that would destroy the RAM-held password before
            // it can ever be used. The document stays alive; showThankYou()
            // only updates the DOM in place.
            showThankYou();

            if (navigator.onLine && typeof window.attemptReconnectSync === 'function') {
                window.attemptReconnectSync();
            }
        } catch (err) {
            console.error('[Offline Queue] Failed to save survey', err);
            if (window.AppAlert) {
                AppAlert.error('The survey could not be saved offline. Please try again.');
            }
        }
        return;
    }

    // Offline (authenticated session): skip the network call entirely and
    // queue the survey locally — it will be replayed automatically once the
    // connection returns.
    if (!navigator.onLine) {
        saveAutofillProfile(data);
        // Carries over the SAME id the in-progress draft was autosaved
        // under (if any) — "one survey attempt = one ID" end to end — and
        // clears the now-superseded draft record once the completed
        // submission is safely in the durable outbox instead.
        queueSurveyOffline(data, data.email, activeSurveyDraftId).then(record => {
            discardActiveSurveyDraft();
            return record;
        }).then(showThankYou);
        return;
    }

    // 3. IPAPASA ANG MGA SAGOT DIREKTA SA API
    // Timeout-guarded: on a flaky connection (as opposed to a clean offline
    // failure) a bare fetch() can hang far longer than a client should be
    // expected to wait — forcing a fast failure here means it falls through
    // to the offline queue below instead of leaving them on a spinner.
    fetchWithTimeout('/submit-survey', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    }, 8000)
    .then(response => response.json().then(resData => ({ status: response.status, resData })))
    .then(({ status, resData }) => {
        if (resData.success) {
            saveAutofillProfile(data);
            // Server confirmed the submission — this is the one point where
            // clearing any in-progress draft is actually correct (item 37:
            // only on confirmed success or explicit discard).
            discardActiveSurveyDraft();
            // Personal-email accounts land in the office's approval queue instead
            // of being recorded immediately — let the client know before the
            // normal Thank You screen (see /submit-survey's isCspcEmail branch).
            if (resData.pending) {
                AppAlert.info(resData.message || "Submitted! The office you visited will verify your visit before this is recorded.", 'Awaiting Verification');
            }
            // Cooldown eligibility for the just-answered service changes
            // immediately — refresh the cached offline-context snapshot so a
            // later offline visit doesn't show it as still available.
            refreshOfflineAccountContext();
            showThankYou();
        } else if (status === 401) {
            // The session ended between opening this form and clicking
            // Submit — most likely the pending-logout lifecycle resolving
            // while this tab sat idle online. The answers are still good;
            // there's just no live session left to take the normal
            // authenticated route. Queue them the same as any other
            // unreachable-server case instead of dead-ending on an error
            // and losing what was just answered.
            console.warn('[Submit] Session no longer valid at submit time — queuing offline instead.');
            saveAutofillProfile(data);
            queueSurveyOffline(data, data.email, activeSurveyDraftId).then(record => {
                discardActiveSurveyDraft();
                return record;
            }).then(showThankYou);
        } else {
            AppAlert.error("Nagkaroon ng problema: " + (resData.message || 'Database error'));
        }
    })
    .catch(err => {
        // A rejected fetch here (as opposed to a JSON error response above) means
        // the request never reached the server — most likely a lost connection.
        console.error("Error submitting survey:", err);
        saveAutofillProfile(data);
        // Carries over the SAME id the in-progress draft was autosaved
        // under (if any) — "one survey attempt = one ID" end to end — and
        // clears the now-superseded draft record once the completed
        // submission is safely in the durable outbox instead.
        queueSurveyOffline(data, data.email, activeSurveyDraftId).then(record => {
            discardActiveSurveyDraft();
            return record;
        }).then(showThankYou);
    });
}

// Confetti + swap to the Thank You page — shared by both the normal
// (online) success path and the offline-queued path above.
function showThankYou() {
    const duration = 3000;
    const animationEnd = Date.now() + duration;
    const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };
    const interval = setInterval(function(){
        const timeLeft = animationEnd - Date.now();
        if(timeLeft <= 0) return clearInterval(interval);
        const particleCount = 50 * (timeLeft / duration);
        confetti({ ...defaults, particleCount, origin: { x: Math.random() * 0.3, y: Math.random() - 0.2 } });
        confetti({ ...defaults, particleCount, origin: { x: 0.7 + Math.random() * 0.3, y: Math.random() - 0.2 } });
    }, 250);

    document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
    document.getElementById('thank-you-page').classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    const progressEl = document.getElementById('surveyProgress');
    if (progressEl) progressEl.style.display = 'none';
    exitFullscreen();

    // The interrupted attempt just finished (submitted or safely queued) —
    // if a "please sign in again" screen was held back earlier so it
    // wouldn't interrupt them mid-answer, this is the moment to show it.
    if (backOnlinePromptSuppressed) {
        backOnlinePromptSuppressed = false;
        if (typeof showBackOnlineTransition === 'function') showBackOnlineTransition();
    }
}

// Mirrors isCspcEmail in server.js exactly — a @cspc.edu.ph/@my.cspc.edu.ph
// account's submission is finalized immediately server-side (no review
// step at all, see the /submit-survey handler), so its resubmission cooldown
// starts counting from right now. Any other account's submission instead
// goes to pending_survey_submissions and only starts counting once/if the
// office approves it — a time this page can't know in advance.
function isCspcAccountEmail(email) {
    if (typeof email !== 'string') return false;
    const normalized = email.toLowerCase().trim();
    return normalized.endsWith('@cspc.edu.ph') || normalized.endsWith('@my.cspc.edu.ph');
}

function markServiceAsTaken(officeId, serviceName) {
    if (!officeId || !serviceName) return;
    const key = officeId + '::' + serviceName;
    const stepDays = { daily: 1, weekly: 7, monthly: 30, yearly: 365 }[serviceAvailability[key]];

    if (isCspcAccountEmail(currentClientEmail) && stepDays) {
        // Finalized right now, on a known cadence — the exact same math as
        // nextEligibleTimestamp in server.js, just anchored to "now" instead
        // of a stored created_at, since that's exactly what finalizing
        // immediately means. Shows the real countdown right away instead of
        // a vague placeholder. blockedCombos still gets a (now-unused-for-
        // display, since blockedUntil takes priority in updateAvailabilityNotice)
        // fallback string — populateServiceSelect's disabled/checkmark/title
        // logic keys off blockedCombos alone, so this also has to be set for
        // the option to actually lock in the dropdown.
        blockedUntil[key] = Date.now() + stepDays * 86400000;
        blockedCombos[key] = 'You can answer this again soon.';
    } else {
        // Either a one-time-only service (no cadence to count down to) or
        // an account whose submission still needs office review (no known
        // start time for the cooldown yet) — fall back to a static message
        // until the next page load re-derives the real state from the
        // server.
        blockedCombos[key] = isCspcAccountEmail(currentClientEmail)
            ? 'You have already evaluated this service.'
            : "Awaiting the office's review, or already evaluated.";
        delete blockedUntil[key];
    }

    // Re-render the service dropdown if it's currently showing this office's
    // services, so the just-submitted one shows disabled immediately.
    const officeSelect = document.getElementById('officeSelect');
    if (officeSelect && String(officeSelect.value) === String(officeId)) {
        populateServiceSelect(officeId);
        updateAvailabilityNotice();
    }
}

// "Submit Again" from the Thank You page — resets the form and drops the
// client straight back into a fresh survey (Stage 1) without touching the
// session, unlike the old location.reload() which bounced to the Home view
// and read to the user as if they'd been logged out.
function startNewSurvey() {
    const form = document.getElementById('surveyForm');
    if (form) form.reset();

    // A fresh attempt needs a fresh draft identity — the previous one was
    // already discarded (discardActiveSurveyDraft()) right after its
    // submission was confirmed/queued, before this function is ever called.
    activeSurveyDraftId = null;
    activeSurveyDraftRestored = false;

    // form.reset() clears values but not the `disabled` attribute on
    // already-locked profile fields, and doesn't restore today's date.
    document.getElementById('surveyDate').valueAsDate = new Date();
    document.getElementById('officeVisitedTime').value = '';
    initDefaultOfficeVisitedTime();
    applyLockedProfile();
    populateServiceSelect('');
    updateAvailabilityNotice();

    editReturnTarget = null;

    const progressEl = document.getElementById('surveyProgress');
    if (progressEl) progressEl.style.display = '';

    switchView('survey');
    navigate(1);
}

async function logout(){
    // Logout is a plain navigation to /logout?scope=client — network-
    // dependent, and /logout is not a precached route (unlike /login,
    // /survey-offline, / — see service-worker.js), so attempting it while
    // offline previously just failed the navigation outright (the browser's
    // own connection-error page, or a misleading "Logout failed"). Offline,
    // there is no server round-trip to make right now anyway: perform the
    // same local transition used elsewhere in this file when connectivity
    // drops, and let showBackOnlineTransition() actually reach /logout for
    // real the next time this tab sees connectivity return.
    if (!navigator.onLine) {
        // Deliberately does not claim the server session IS closed — only a
        // confirmed response from attemptPendingClientLogout() (fired by
        // showOfflineTransition() below, and retried by any page that later
        // sees this pending marker) gets to make that true.
        const confirmedOffline = await AppAlert.confirm(
            "You're offline, so Logout can't reach the server right now. You'll be signed out of this device immediately, and the app will try to close the server session automatically as soon as you're back online.",
            { title: 'Logout While Offline?', confirmText: 'Yes, logout' }
        );
        if (!confirmedOffline) return;
        try { localStorage.removeItem(CLIENT_SESSION_KEY); } catch (e) {}
        showOfflineTransition();
        return;
    }

    const confirmed = await AppAlert.confirm("Are you sure you want to logout?", {
        title: 'Logout?',
        confirmText: 'Yes, logout'
    });
    if (confirmed) {
        try { localStorage.removeItem(CLIENT_SESSION_KEY); } catch (e) {}
        // Hits the server's /logout route so the session (req.session.clientEmail /
        // passport user) is actually cleared — otherwise the Back button could
        // still land on the survey without signing in again.
        window.location.href = '/logout?scope=client';
    }
}

// Toggle the Start Survey button based on the Stage 1 Terms & Conditions checkbox
document.getElementById('agreeTermsStage1').addEventListener('change', function () {
    document.getElementById('btnStartSurvey').disabled = !this.checked;
});

// ==========================================
// First-time Setup Wizard (see showOnboarding in server.js's /client-survey
// route, and the #onboardingWizardModal markup this drives)
// ==========================================
const ONBOARDING_STEP_COUNT = 5;
let onboardingCurrentStep = 1;

function renderOnboardingStep() {
    document.querySelectorAll('.onboarding-step').forEach(el => {
        const isActive = Number(el.getAttribute('data-onboarding-step')) === onboardingCurrentStep;
        el.hidden = !isActive;
        el.classList.toggle('active', isActive);
    });
    document.querySelectorAll('.onboarding-dot').forEach(el => {
        el.classList.toggle('active', Number(el.getAttribute('data-dot')) === onboardingCurrentStep);
    });
    const backBtn = document.getElementById('onboardingBackBtn');
    const nextBtn = document.getElementById('onboardingNextBtn');
    if (backBtn) backBtn.hidden = onboardingCurrentStep === 1;
    if (nextBtn) nextBtn.textContent = onboardingCurrentStep === ONBOARDING_STEP_COUNT ? 'Get Started' : 'Next';
}

function onboardingStep(delta) {
    const next = onboardingCurrentStep + delta;
    if (next > ONBOARDING_STEP_COUNT) {
        finishOnboarding();
        return;
    }
    onboardingCurrentStep = Math.min(Math.max(next, 1), ONBOARDING_STEP_COUNT);
    renderOnboardingStep();
}

// Called on Finish AND on Skip Tour — both mean "don't show this again",
// so both hit the same endpoint. Best-effort: even if the request fails
// (e.g. connectivity), the modal still closes rather than trapping the user;
// it will simply be offered again on this account's next /client-survey load.
async function finishOnboarding() {
    const modalEl = document.getElementById('onboardingWizardModal');
    const instance = modalEl && bootstrap.Modal.getOrCreateInstance(modalEl);
    if (instance) instance.hide();
    try {
        await fetch('/api/onboarding-complete', { method: 'POST' });
    } catch (e) { /* best-effort — see comment above */ }
}

<% if (showOnboarding) { %>
// Called directly (not on DOMContentLoaded) — this script block sits right
// before </body>, after #onboardingWizardModal in the markup, matching the
// rest of this file's "Initial Load Setup" calls just below.
renderOnboardingStep();
(function () {
    const modalEl = document.getElementById('onboardingWizardModal');
    if (modalEl) new bootstrap.Modal(modalEl).show();
})();
<% } %>

// Initial Load Setup
setLanguage('en');
applyLockedProfile();
updateProgressStepper(1);
updateFullscreenButton();

</script>

<%- include('layout/theme-toggle') %>
</body>
</html>