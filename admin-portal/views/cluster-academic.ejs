<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
    
    <style>
        :root { --primary-gradient: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%); --glass-bg: #ffffff; --navy: #0f172a; }
        body { background-color: #f1f5f9; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--navy); overflow-x: hidden; }
        @keyframes fadeInUp { 0% { opacity: 0; transform: translateY(30px); } 100% { opacity: 1; transform: translateY(0); } }
        .animated-intro { animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
        .hero-header { text-align: center; padding: 1rem 1rem 0.5rem 1rem; }
        .status-badge { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(90deg, #10b981, #059669); color: white; padding: 6px 20px; border-radius: 50px; font-weight: bold; font-size: 0.9rem; }
        .chart-card { background: white; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); padding: 25px; margin-top: 20px; }
        .stats-container { display: flex; justify-content: center; gap: 20px; margin-top: 20px; flex-wrap: wrap; }
        .stat-box { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); min-width: 200px; text-align: center; border-bottom: 4px solid #2563eb; }
        .stat-box h3 { font-size: 2rem; font-weight: 800; margin-bottom: 5px; color: #1e293b; }
        .stat-box p { margin: 0; color: #64748b; font-size: 0.9rem; text-transform: uppercase; font-weight: 600; }

        .filter-bar {
            display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px;
            background: white; border-radius: 16px; padding: 18px 22px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-top: 20px;
        }
        .filter-bar .filter-group { display: flex; flex-direction: column; gap: 4px; }
        .filter-bar label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; }
        .filter-bar .btn-generate { margin-left: auto; }
    </style>
</head>
<body>
    <div id="wrapper">
        <%- include('layout/sidebar') %>
        <div id="content">
            <%- include('layout/navbar') %>

            <div class="container-fluid px-4 py-4 animated-intro">
                <div class="hero-header">
                    <div class="status-badge">
                        <i class="fas fa-check-circle"></i> Active Reporting
                    </div>
                    <h2 class="fw-bold mt-3 mb-1">Academic Affairs Cluster</h2>
                    <p class="text-muted">Real-time satisfaction ratings and respondent volume per office.</p>
                </div>

                <form class="filter-bar" method="GET" action="/cluster/academic">
                    <div class="filter-group">
                        <label for="semester">Semester</label>
                        <select id="semester" name="semester" class="form-select form-select-sm" title="Filter by semester" onchange="this.form.submit()">
                            <option value="">All Semesters</option>
                            <% if (typeof semesterOptions !== 'undefined') { %>
                                <% semesterOptions.forEach(opt => { %>
                                    <option value="<%= opt.value %>" <%= selectedSemester === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary btn-generate" onclick="generateClusterReport('Academic Affairs Cluster')" title="Generate a report based on the selected filters">
                        <i class="fas fa-file-invoice me-2"></i> Generate Report
                    </button>
                </form>

                <div class="stats-container">
                    <div class="stat-box" style="border-bottom-color: #7c3aed;">
                        <h3 id="overallRating">0%</h3>
                        <p>Average Rating</p>
                    </div>
                    <div class="stat-box" style="border-bottom-color: #2563eb;">
                        <h3 id="totalResp">0</h3>
                        <p>Total Respondents</p>
                    </div>
                    <div class="stat-box" style="border-bottom-color: #10b981;">
                        <h3 id="totalOffices">0</h3>
                        <p>Offices Evaluated</p>
                    </div>
                </div>

                <div class="chart-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Office Ratings Distribution</h5>
                    </div>
                    <div style="height: 450px; position: relative;">
                        <canvas id="clusterChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('layout/footer') %>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const currentData = <%- typeof data !== 'undefined' ? JSON.stringify(data) : '[]' %>;
            
            Chart.register(ChartDataLabels);
            const ctx = document.getElementById('clusterChart').getContext('2d');
            let chartInstance;

            function updateDashboardUI(dataArray) {
                let totalResp = 0, sumRating = 0, validOffices = 0;
                dataArray.forEach(d => {
                    totalResp += parseInt(d.resp) || 0;
                    let r = parseFloat(d.rating) || 0;
                    if(r > 0) { sumRating += r; validOffices++; }
                });
                
                document.getElementById('totalResp').innerText = totalResp.toLocaleString();
                document.getElementById('overallRating').innerText = (validOffices > 0 ? (sumRating / validOffices).toFixed(2) : 0.00) + '%';
                document.getElementById('totalOffices').innerText = dataArray.length;
            }

            function renderChart(dataArray) {
                if (chartInstance) chartInstance.destroy();
                chartInstance = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: dataArray.map(d => d.label),
                        datasets: [
                            {
                                label: 'Total Respondents',
                                data: dataArray.map(d => parseInt(d.resp) || 0),
                                backgroundColor: 'rgba(59, 130, 246, 0.85)', // Blue
                                borderColor: '#3b82f6',
                                borderWidth: 1,
                                borderRadius: 6,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Satisfaction Rating (%)',
                                data: dataArray.map(d => parseFloat(d.rating) || 0),
                                backgroundColor: 'rgba(124, 58, 237, 0.85)', // Indigo
                                borderColor: '#7c3aed',
                                borderWidth: 1,
                                borderRadius: 6,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: true, position: 'top' },
                            datalabels: { 
                                anchor: 'end', align: 'end', color: '#1e293b', 
                                font: { weight: '800', size: 11 },
                                formatter: function(value, context) {
                                    if(context.datasetIndex === 1) return value + '%';
                                    if(value === 0) return '';
                                    return value; 
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a', padding: 12, displayColors: false,
                                callbacks: {
                                    title: (item) => `🏢 Office: ${dataArray[item[0].dataIndex].fullName}`
                                }
                            }
                        },
                        scales: {
                            y: { 
                                type: 'linear', position: 'left', beginAtZero: true,
                                title: { display: true, text: 'Number of Respondents', font: {weight: 'bold'} },
                                grid: { borderDash: [4, 4] }
                            },
                            y1: { 
                                type: 'linear', position: 'right', beginAtZero: true, max: 110,
                                title: { display: true, text: 'Satisfaction %', font: {weight: 'bold'} },
                                grid: { drawOnChartArea: false },
                                ticks: { display: false }
                            },
                            x: { grid: { display: false }, ticks: { font: { weight: '700' } } }
                        }
                    }
                });
            }

            updateDashboardUI(currentData);
            renderChart(currentData);
        });

        function generateClusterReport(clusterTitle) {
            const semesterSelect = document.getElementById('semester');
            const semester = (semesterSelect && semesterSelect.selectedIndex >= 0)
                ? semesterSelect.options[semesterSelect.selectedIndex].text
                : 'All Semesters';
            const overallRating = document.getElementById('overallRating').innerText;
            const totalResp = document.getElementById('totalResp').innerText;
            const totalOffices = document.getElementById('totalOffices').innerText;

            const reportWindow = window.open('', '_blank', 'width=800,height=900');
            reportWindow.document.write(`
                <html>
                <head>
                    <title>${clusterTitle} Report</title>
                    <style>
                        body { font-family: Arial, sans-serif; padding: 40px; color: #1e293b; }
                        h2 { margin-bottom: 4px; }
                        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                        th, td { border: 1px solid #94a3b8; padding: 8px 12px; text-align: left; }
                        th { background: #e2e8f0; }
                    </style>
                </head>
                <body>
                    <h2>${clusterTitle}</h2>
                    <p>Generated on ${new Date().toLocaleString()}</p>
                    <table>
                        <tr><th>Semester</th><td>${semester}</td></tr>
                        <tr><th>Average Rating</th><td>${overallRating}</td></tr>
                        <tr><th>Total Respondents</th><td>${totalResp}</td></tr>
                        <tr><th>Offices Evaluated</th><td>${totalOffices}</td></tr>
                    </table>
                </body>
                </html>
            `);
            reportWindow.document.close();
            reportWindow.focus();
            reportWindow.print();
        }
    </script>
</body>
</html>