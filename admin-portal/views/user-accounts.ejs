<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        /* Same token set and spacing scale as survey-records.ejs. */
        :root {
            --primary-indigo: #251d3a;
            --accent-indigo: #3452a5;
            --bg-body: #f4f6fa;
            --text-main: #334155;
            --text-heading: #0f172a;
            --text-muted: #64748b;
            --text-faint: #94a3b8;
            --card-bg: #ffffff;
            --surface-subtle: #f8fafc;
            --border-subtle: #e5e9f0;
            --border-strong: #dde3ec;

            --sp-1: 4px;
            --sp-2: 8px;
            --sp-3: 12px;
            --sp-4: 16px;
            --sp-5: 20px;
            --sp-6: 24px;
            --sp-8: 32px;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;

            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 6px 16px rgba(15, 23, 42, 0.06);

            /* Shared grid used by both the column headings and the account rows. */
            --account-grid: 40px minmax(0, 1fr) 132px 168px;
        }

        html[data-bs-theme="dark"] {
            --bg-body: #0b1526;
            --text-main: #cbd5e1;
            --text-heading: #f1f5f9;
            --text-muted: #94a3b8;
            --text-faint: #64748b;
            --card-bg: #141d30;
            --surface-subtle: #1a2438;
            --border-subtle: #263045;
            --border-strong: #2c3a54;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.35);
        }

        body {
            background-color: var(--bg-body);
            font-family: var(--font-ui);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* --- Page header --- */
        .page-header {
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            color: #fff;
            padding: var(--sp-6);
            border-radius: 0 0 var(--radius-lg) var(--radius-lg);
            box-shadow: var(--shadow-md);
            margin-bottom: var(--sp-6);
        }
        .page-header h2 { font-size: 1.4rem; letter-spacing: 0.2px; }
        .page-header .page-subtitle { font-size: 0.85rem; color: rgba(255, 255, 255, 0.72); }

        .btn-back {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.22);
            padding: var(--sp-2) var(--sp-4);
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 600;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .btn-back:hover { background: #fff; color: var(--primary-indigo); }

        /* Stat tiles use an auto-fit grid so they stay equal width at every breakpoint. */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: var(--sp-4);
            margin-bottom: var(--sp-5);
        }
        .stat-tile {
            display: flex;
            align-items: center;
            gap: var(--sp-4);
            background: var(--card-bg);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            padding: var(--sp-4) var(--sp-5);
        }
        .stat-icon {
            flex: 0 0 auto;
            width: 42px;
            height: 42px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            background: rgba(52, 82, 165, 0.1);
            color: var(--accent-indigo);
        }
        html[data-bs-theme="dark"] .stat-icon { background: rgba(109, 150, 255, 0.14); color: #b9cbff; }
        .stat-text { min-width: 0; }
        .stat-value {
            display: block;
            font-size: 1.35rem;
            font-weight: 800;
            line-height: 1.15;
            color: var(--text-heading);
            font-variant-numeric: tabular-nums;
        }
        .stat-label {
            display: block;
            font-size: 0.73rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* --- Accounts card --- */
        .accounts-card {
            background: var(--card-bg);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            margin-bottom: var(--sp-8);
            overflow: hidden;
        }

        /* Title on its own line, controls on the next, so they have room to breathe. */
        .accounts-toolbar {
            display: flex;
            flex-direction: column;
            gap: var(--sp-4);
            padding: var(--sp-5) var(--sp-6);
            border-bottom: 1px solid var(--border-subtle);
        }
        .accounts-toolbar-title { min-width: 0; }
        .accounts-toolbar-title h6 {
            margin: 0;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-heading);
        }
        .accounts-toolbar-title p {
            margin: 3px 0 0;
            font-size: 0.76rem;
            color: var(--text-faint);
        }

        .accounts-controls {
            display: flex;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: var(--sp-3);
        }

        /* Label above field for each control, keeps them on the same baseline. */
        .control-field {
            display: flex;
            flex-direction: column;
            gap: var(--sp-1);
            flex: 0 1 200px;
            min-width: 170px;
        }
        .control-field.is-search { flex: 1 1 260px; min-width: 220px; }
        .control-label {
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-faint);
        }

        .search-bar {
            display: flex;
            align-items: center;
            flex: 1 1 auto;
            min-width: 0;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-md);
            background: var(--card-bg);
            padding: 0 var(--sp-3);
        }
        .search-bar i { color: var(--text-faint); font-size: 0.85rem; }
        .search-bar input {
            flex: 1 1 auto;
            min-width: 0;
            border: 0;
            outline: none;
            background: transparent;
            color: var(--text-main);
            font-size: 0.88rem;
            padding: var(--sp-3) var(--sp-2);
        }
        .search-bar input::placeholder { color: var(--text-faint); }
        .search-bar:focus-within {
            border-color: var(--primary-indigo);
            box-shadow: 0 0 0 3px rgba(37, 29, 58, 0.08);
        }

        .control-select {
            appearance: none;
            -webkit-appearance: none;
            width: 100%;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-md);
            background-color: var(--card-bg);
            color: var(--text-main);
            font-size: 0.86rem;
            font-weight: 600;
            padding: var(--sp-3) calc(var(--sp-6) + var(--sp-1)) var(--sp-3) var(--sp-3);
            /* Caret drawn with gradients so it follows the text color in dark mode. */
            background-image: linear-gradient(45deg, transparent 50%, var(--text-faint) 50%),
                              linear-gradient(135deg, var(--text-faint) 50%, transparent 50%);
            background-position: calc(100% - 18px) 52%, calc(100% - 13px) 52%;
            background-size: 5px 5px, 5px 5px;
            background-repeat: no-repeat;
            cursor: pointer;
        }
        .control-select:focus {
            outline: none;
            border-color: var(--primary-indigo);
            box-shadow: 0 0 0 3px rgba(37, 29, 58, 0.08);
        }
        /* Native option list is drawn by the OS, needs colors spelled out for dark mode. */
        html[data-bs-theme="dark"] .control-select option { background-color: #141d30; color: #cbd5e1; }

        /* Column headings use the same grid as the rows. */
        .accounts-head {
            display: grid;
            grid-template-columns: var(--account-grid);
            align-items: center;
            column-gap: var(--sp-4);
            padding: var(--sp-3) var(--sp-6);
            background: var(--surface-subtle);
            border-bottom: 1px solid var(--border-subtle);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted);
        }
        /* Account heading spans both the avatar and identity columns. */
        .accounts-head span:first-child { grid-column: 1 / span 2; }

        /* Account row: avatar, identity, account type, date registered. */
        .account-row {
            display: grid;
            grid-template-columns: var(--account-grid);
            align-items: center;
            column-gap: var(--sp-4);
            padding: var(--sp-4) var(--sp-6);
            border-bottom: 1px solid var(--border-subtle);
            transition: background-color 0.12s ease;
        }
        .account-row:last-child { border-bottom: none; }
        .account-row:hover { background: var(--surface-subtle); }
        /* Needed since display: grid above would otherwise override hidden. */
        .account-row[hidden] { display: none; }

        .account-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #251d3a, #3452a5);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        /* Google profile picture, sized to the same cell as the initials circle. */
        .account-photo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            background: var(--surface-subtle);
            border: 1px solid var(--border-subtle);
        }

        .account-identity { min-width: 0; }
        .account-name {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-heading);
            line-height: 1.35;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .account-name.is-unset { font-weight: 500; font-style: italic; color: var(--text-faint); }
        .account-email {
            display: flex;
            align-items: center;
            gap: var(--sp-2);
            margin: 2px 0 0;
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.35;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .account-email i { flex: 0 0 auto; font-size: 0.72rem; color: var(--text-faint); }

        .type-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--sp-1);
            padding: 3px var(--sp-2);
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }
        .type-badge i { font-size: 0.68rem; }
        .type-badge.is-cspc { background: rgba(52, 82, 165, 0.1); color: var(--accent-indigo); }
        .type-badge.is-personal { background: rgba(100, 116, 139, 0.12); color: var(--text-muted); }
        html[data-bs-theme="dark"] .type-badge.is-cspc { background: rgba(109, 150, 255, 0.16); color: #b9cbff; }
        html[data-bs-theme="dark"] .type-badge.is-personal { background: rgba(148, 163, 184, 0.16); color: #cbd5e1; }

        /* Date as the primary value, exact time shown underneath it. */
        .account-registered { text-align: right; }
        .registered-date {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--text-main);
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }
        .registered-time {
            display: block;
            font-size: 0.74rem;
            color: var(--text-faint);
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
            margin-top: 1px;
        }

        /* --- Empty states --- */
        .empty-state {
            padding: var(--sp-8) var(--sp-6);
            text-align: center;
            color: var(--text-faint);
        }
        .empty-state i { font-size: 2rem; opacity: 0.35; margin-bottom: var(--sp-3); }
        .empty-state h5 { font-size: 0.95rem; font-weight: 700; color: var(--text-muted); margin-bottom: var(--sp-1); }
        .empty-state p { font-size: 0.82rem; margin: 0; }

        .accounts-foot {
            padding: var(--sp-3) var(--sp-6);
            border-top: 1px solid var(--border-subtle);
            background: var(--surface-subtle);
            font-size: 0.75rem;
            color: var(--text-faint);
            text-align: center;
        }

        /* On tablet, the right columns shrink before the name column truncates. */
        @media (max-width: 991.98px) {
            :root { --account-grid: 40px minmax(0, 1fr) 118px 132px; }
            .registered-date { font-size: 0.78rem; }
        }

        /* On phone, the type badge and date move under the address instead of the row. */
        @media (max-width: 575.98px) {
            .page-header { padding: var(--sp-5) var(--sp-4); }
            .accounts-toolbar { padding: var(--sp-4); }
            .control-field, .control-field.is-search { flex: 1 1 100%; min-width: 0; }
            .accounts-head { display: none; }
            .account-row {
                grid-template-columns: 40px minmax(0, 1fr);
                row-gap: var(--sp-2);
                padding: var(--sp-4);
            }
            .account-type, .account-registered {
                grid-column: 2;
                text-align: left;
            }
            .account-registered { display: flex; align-items: baseline; gap: var(--sp-2); }
            .registered-time { margin-top: 0; }
            .stat-tile { padding: var(--sp-4); }
        }
    </style>
</head>
<body data-connection-alerts>
<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>
        <script>document.getElementById('pageTitle').innerText = 'User Accounts';</script>

        <div class="page-header">
            <div class="container-fluid d-md-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1 text-white"><i class="fas fa-user-check me-2"></i>Registered User Accounts</h2>
                    <p class="mb-0 page-subtitle">Every account registered on the client side, with the date and time it signed up</p>
                </div>
                <div class="mt-3 mt-md-0">
                    <a href="/dashboard" class="btn btn-back">
                        <i class="fas fa-chevron-left me-2"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>

        <div class="container-fluid px-4">

            <%# Total, then the two halves it splits into, then today's registrations. %>
            <div class="stat-grid">
                <div class="stat-tile">
                    <span class="stat-icon"><i class="fas fa-user-group"></i></span>
                    <span class="stat-text">
                        <span class="stat-value"><%= stats.totalAccounts %></span>
                        <span class="stat-label">Total Accounts</span>
                    </span>
                </div>
                <div class="stat-tile">
                    <span class="stat-icon"><i class="fas fa-graduation-cap"></i></span>
                    <span class="stat-text">
                        <span class="stat-value"><%= stats.cspcAccounts %></span>
                        <span class="stat-label">CSPC Accounts</span>
                    </span>
                </div>
                <div class="stat-tile">
                    <span class="stat-icon"><i class="fas fa-user"></i></span>
                    <span class="stat-text">
                        <span class="stat-value"><%= stats.personalAccounts %></span>
                        <span class="stat-label">Personal Accounts</span>
                    </span>
                </div>
                <div class="stat-tile">
                    <span class="stat-icon"><i class="fas fa-calendar-day"></i></span>
                    <span class="stat-text">
                        <span class="stat-value"><%= stats.todayCount %></span>
                        <span class="stat-label">Registered Today</span>
                    </span>
                </div>
            </div>

            <div class="accounts-card">

                <div class="accounts-toolbar">
                    <div class="accounts-toolbar-title">
                        <h6>Registered Accounts</h6>
                        <p id="accountsSummary"><%= listedCount %> <%= listedCount === 1 ? 'account' : 'accounts' %>, newest registered first</p>
                    </div>

                    <div class="accounts-controls">
                        <div class="control-field is-search">
                            <span class="control-label">Search</span>
                            <label class="search-bar" for="accountSearch">
                                <i class="fas fa-search"></i>
                                <input type="text" id="accountSearch" placeholder="Search by name or email..."
                                       autocomplete="off" title="Search registered accounts">
                            </label>
                        </div>

                        <div class="control-field">
                            <label class="control-label" for="accountSort">Sort by</label>
                            <select class="control-select" id="accountSort" title="Sort registered accounts">
                                <option value="date-desc" selected>Date registered (newest)</option>
                                <option value="date-asc">Date registered (oldest)</option>
                                <option value="name-asc">Name (A&ndash;Z)</option>
                                <option value="name-desc">Name (Z&ndash;A)</option>
                            </select>
                        </div>

                        <div class="control-field">
                            <label class="control-label" for="accountType">Account type</label>
                            <select class="control-select" id="accountType" title="Filter by account type">
                                <option value="all" selected>All accounts</option>
                                <option value="cspc">CSPC accounts</option>
                                <option value="personal">Personal accounts</option>
                            </select>
                        </div>
                    </div>
                </div>

                <% if (listedCount > 0) { %>
                    <div class="accounts-head">
                        <span>Account</span>
                        <span>Type</span>
                        <span class="text-end">Date Registered</span>
                    </div>

                    <div id="accountList">
                        <% accounts.forEach(account => { %>
                            <%
                                // Avatar letter comes from the name, or the email if there's no name.
                                const initialSource = account.hasName ? account.name : (account.email || '?');
                                const initial = initialSource.trim().charAt(0) || '?';
                                const emailText = account.email || 'No email on record';
                            %>
                            <div class="account-row"
                                 data-search="<%= (account.name + ' ' + emailText).toLowerCase() %>"
                                 data-name="<%= account.nameKey %>"
                                 data-date="<%= account.dateKey %>"
                                 data-type="<%= account.isCspc ? 'cspc' : 'personal' %>">
                                <% if (account.photoUrl) { %>
                                    <%# referrerpolicy is required, Google's photo host rejects requests with a referrer set. %>
                                    <img class="account-photo" src="<%= account.photoUrl %>"
                                         alt="" width="40" height="40" loading="lazy"
                                         referrerpolicy="no-referrer" data-initial="<%= initial %>">
                                <% } else { %>
                                    <span class="account-avatar"><%= initial %></span>
                                <% } %>
                                <div class="account-identity">
                                    <p class="account-name<%= account.hasName ? '' : ' is-unset' %>" title="<%= account.name %>"><%= account.name %></p>
                                    <p class="account-email" title="<%= emailText %>">
                                        <i class="fas fa-envelope"></i><span><%= emailText %></span>
                                    </p>
                                </div>
                                <div class="account-type">
                                    <% if (account.isCspc) { %>
                                        <span class="type-badge is-cspc"><i class="fas fa-graduation-cap"></i> CSPC</span>
                                    <% } else { %>
                                        <span class="type-badge is-personal"><i class="fas fa-user"></i> Personal</span>
                                    <% } %>
                                </div>
                                <div class="account-registered" title="Registered <%= account.registeredFull %>">
                                    <span class="registered-date"><%= account.registeredDate %></span>
                                    <span class="registered-time"><%= account.registeredTime %></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="empty-state" id="noResults" hidden>
                        <i class="fas fa-search d-block"></i>
                        <h5>No matching account</h5>
                        <p>Try a different name, email address, or account type.</p>
                    </div>

                    <% if (listedCount >= accountLimit) { %>
                        <div class="accounts-foot">
                            Showing the <%= accountLimit %> most recently registered accounts.
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-user-slash d-block"></i>
                        <h5>No registered accounts yet</h5>
                        <p>Accounts appear here as soon as someone registers on the client side.</p>
                    </div>
                <% } %>

            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>
<%- include('layout/theme-toggle') %>
<script>
    // Search, sort and type filter run over the rows already on the page, no round trip needed.
    (function () {
        const list = document.getElementById('accountList');
        if (!list) return;

        const search = document.getElementById('accountSearch');
        const sortSelect = document.getElementById('accountSort');
        const typeSelect = document.getElementById('accountType');
        const summary = document.getElementById('accountsSummary');
        const noResults = document.getElementById('noResults');

        // Reads each row's data attributes once up front instead of on every comparison.
        const entries = Array.from(list.querySelectorAll('.account-row')).map(row => ({
            row,
            name: row.dataset.name || '',
            date: Number(row.dataset.date) || 0,
            type: row.dataset.type || 'personal',
            search: row.dataset.search || ''
        }));

        // Every sort has a tiebreaker so tied rows still land in a stable order.
        const SORTERS = {
            'date-desc': (a, b) => b.date - a.date || a.name.localeCompare(b.name),
            'date-asc': (a, b) => a.date - b.date || a.name.localeCompare(b.name),
            'name-asc': (a, b) => a.name.localeCompare(b.name) || b.date - a.date,
            'name-desc': (a, b) => b.name.localeCompare(a.name) || b.date - a.date
        };

        const SORT_LABELS = {
            'date-desc': 'newest registered first',
            'date-asc': 'oldest registered first',
            'name-asc': 'sorted by name (A–Z)',
            'name-desc': 'sorted by name (Z–A)'
        };

        function apply() {
            const query = (search ? search.value : '').trim().toLowerCase();
            const wantedType = typeSelect ? typeSelect.value : 'all';
            const sortKey = (sortSelect && SORTERS[sortSelect.value]) ? sortSelect.value : 'date-desc';

            let visible = 0;
            entries.forEach(entry => {
                const matchesQuery = !query || entry.search.includes(query);
                const matchesType = wantedType === 'all' || entry.type === wantedType;
                const show = matchesQuery && matchesType;
                entry.row.hidden = !show;
                if (show) visible++;
            });

            // Reordered in a fragment and reattached in one go, one layout pass instead of many.
            const fragment = document.createDocumentFragment();
            entries.slice().sort(SORTERS[sortKey]).forEach(entry => fragment.appendChild(entry.row));
            list.appendChild(fragment);

            if (summary) {
                const noun = visible === 1 ? ' account' : ' accounts';
                const filtered = !!query || wantedType !== 'all';
                summary.textContent = visible + noun + (filtered ? ' matched, ' : ', ') + SORT_LABELS[sortKey];
            }
            if (noResults) noResults.hidden = visible !== 0;
            list.hidden = visible === 0;
        }

        // Falls back to the initials circle if the saved Google photo URL stops loading.
        list.querySelectorAll('img.account-photo').forEach(img => {
            img.addEventListener('error', () => {
                const fallback = document.createElement('span');
                fallback.className = 'account-avatar';
                fallback.textContent = img.dataset.initial || '?';
                img.replaceWith(fallback);
            }, { once: true });
        });

        if (search) search.addEventListener('input', apply);
        if (sortSelect) sortSelect.addEventListener('change', apply);
        if (typeSelect) typeSelect.addEventListener('change', apply);
    })();
</script>
