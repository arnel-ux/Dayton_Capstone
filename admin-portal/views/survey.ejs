<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <style>
        /* Custom Styles for Survey Management — palette matches the Survey Records page. */
        :root {
            --primary-indigo: #251d3a;
            --primary-indigo-hover: #2a2550;
            --accent-indigo: #3452a5;
            --bg-body: #f4f6fa;
            --text-main: #334155;
            --text-heading: #0f172a;
            --text-muted: #64748b;
            --text-faint: #94a3b8;
            --card-bg: #ffffff;
            --surface-subtle: #f8fafc;
            --border-subtle: #e5e9f0;
            --border-strong: #dde3ec;

            --sp-1: 4px;
            --sp-2: 8px;
            --sp-3: 12px;
            --sp-4: 16px;
            --sp-5: 20px;
            --sp-6: 24px;
            --sp-8: 32px;

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 14px;

            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 6px 16px rgba(15, 23, 42, 0.06);
        }

        html[data-bs-theme="dark"] {
            --bg-body: #0b1526;
            --text-main: #cbd5e1;
            --text-heading: #f1f5f9;
            --text-muted: #94a3b8;
            --text-faint: #64748b;
            --card-bg: #141d30;
            --surface-subtle: #1a2438;
            --border-subtle: #263045;
            --border-strong: #2c3a54;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 6px 16px rgba(0, 0, 0, 0.35);
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
        }

        /* --- Page header (mirrors Survey Records) --- */
        .page-header {
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            color: white;
            padding: var(--sp-6) var(--sp-6);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            margin-bottom: var(--sp-5);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: var(--sp-3);
        }
        .page-header h5 { margin: 0; font-weight: 700; letter-spacing: 0.2px; font-size: 1.2rem; }
        .page-header-left { display: flex; align-items: center; }
        .page-header-note { font-size: 0.82rem; color: rgba(255,255,255,0.72); margin: 0; }

        .back-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.22);
            color: white;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: var(--sp-4);
            cursor: pointer;
            transition: background-color 0.15s ease, color 0.15s ease;
            text-decoration: none;
            flex-shrink: 0;
        }
        .back-btn:hover {
            background-color: white;
            color: var(--primary-indigo);
        }

        .archived-toggle {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: var(--radius-sm);
            padding: var(--sp-2) var(--sp-4);
            color: white;
        }
        .archived-toggle .form-check-label { font-size: 0.82rem; }
        .archived-toggle .form-check-input:checked { background-color: var(--accent-indigo); border-color: var(--accent-indigo); }

        /* --- Section cards --- */
        .content-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            margin-bottom: var(--sp-6);
            overflow: hidden;
            border: 1px solid var(--border-subtle);
        }
        .card-header-title {
            background: var(--surface-subtle);
            padding: var(--sp-4) var(--sp-5);
            border-bottom: 1px solid var(--border-subtle);
            border-left: 4px solid var(--primary-indigo);
            font-weight: 800;
            font-size: 0.9rem;
            color: var(--primary-indigo);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: var(--sp-3);
            flex-wrap: wrap;
        }
        html[data-bs-theme="dark"] .card-header-title { color: #93c5fd; border-left-color: #93c5fd; }

        .btn-add-item {
            background-color: var(--accent-indigo) !important;
            border-color: var(--accent-indigo) !important;
            color: #fff !important;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: none;
            letter-spacing: normal;
            transition: background-color 0.15s ease, transform 0.15s ease;
        }
        .btn-add-item:hover { background-color: var(--primary-indigo-hover) !important; border-color: var(--primary-indigo-hover) !important; transform: translateY(-1px); }

        .table { margin-bottom: 0; color: var(--text-main); }
        .table thead th {
            background-color: var(--card-bg);
            color: var(--text-faint);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--border-subtle);
            border-top: none;
        }
        .table td { vertical-align: middle; border-color: var(--border-subtle); color: var(--text-main); }
        .table tbody tr:hover { background-color: var(--surface-subtle); }
        .table-bordered { border-color: var(--border-subtle); }
        .table-bordered > :not(caption) > * > * { border-color: var(--border-subtle); }

        .archived-row {
            opacity: 0.55;
            background-color: var(--surface-subtle);
        }
        .badge-archived {
            background-color: #fee2e2;
            color: #b91c1c;
            font-weight: 700;
            font-size: 0.66rem;
            letter-spacing: 0.5px;
        }
        html[data-bs-theme="dark"] .badge-archived { filter: brightness(0.92) saturate(0.9); }

        /* --- Icon-only action buttons, tooltip reveals the action on hover/focus --- */
        .action-cell { text-align: right; white-space: nowrap; }
        .btn-icon {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-strong);
            background: var(--card-bg);
            color: var(--text-muted);
            padding: 0;
            font-size: 0.85rem;
            transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
        }
        .btn-icon + .btn-icon { margin-left: var(--sp-2); }
        .btn-icon:hover { transform: translateY(-1px); }
        .btn-icon-edit:hover { background-color: var(--accent-indigo); border-color: var(--accent-indigo); color: #fff; }
        .btn-icon-archive:hover { background-color: #fee2e2; border-color: #fca5a5; color: #b91c1c; }
        .btn-icon-restore:hover { background-color: #dcfce7; border-color: #86efac; color: #15803d; }
        html[data-bs-theme="dark"] .btn-icon { background: var(--surface-subtle); border-color: var(--border-strong); color: var(--text-faint); }

        @media (max-width: 767.98px) {
            .page-header { padding: var(--sp-5) var(--sp-4); }
            .content-card .p-4 { padding: var(--sp-4) !important; }
        }
    </style>
</head>
<body data-connection-alerts>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid px-4 py-4">
            
            <div class="page-header">
                <div class="page-header-left">
                    <a href="/dashboard" class="back-btn" title="Back to Dashboard"><i class="fas fa-chevron-left"></i></a>
                    <div>
                        <h5><i class="fas fa-clipboard-list me-2"></i>Survey Form Management</h5>
                        <p class="page-header-note">Configure the contents and options displayed in the public survey form.</p>
                    </div>
                </div>
                <div class="form-check form-switch archived-toggle mb-0">
                    <input class="form-check-input" type="checkbox" id="showArchivedToggle" title="Show or hide archived items">
                    <label class="form-check-label" for="showArchivedToggle">Show Archived</label>
                </div>
            </div>

            <div class="content-card">
                <div class="card-header-title">
                    <span><i class="fas fa-list-ol me-2"></i> Service Quality Dimensions (SQD) Statements</span>
                    <button class="btn btn-sm btn-add-item" title="Add a new SQD statement" onclick="openModal('add', null, 'sqd')"><i class="fas fa-plus me-1"></i> Add Statement</button>
                </div>
                <div class="p-4">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width:15%">Statement #</th>
                                <th style="width:65%">Statement Description</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-sqd-statements">
                            <% if(typeof settings !== 'undefined' && settings.sqd && settings.sqd.length > 0) { %>
                                <% settings.sqd.forEach((item, index) => { %>
                                    <tr data-id="<%= item.id %>" class="<%= item.is_archived ? 'archived-row item-row-archived' : 'item-row-active' %>">
                                        <td class="px-4 py-3 text-muted fw-bold">SQD<%= index %></td>
                                        <td class="px-4 py-3 item-text">
                                            <%= item.content %>
                                            <% if (item.is_archived) { %>
                                                <span class="badge badge-archived ms-2">ARCHIVED</span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 action-cell">
                                            <button class="btn-icon btn-icon-edit" title="Edit this statement" data-bs-toggle="tooltip" data-bs-placement="top" onclick="openModal('edit', this, 'sqd', <%= item.id %>)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <% if (item.is_archived) { %>
                                                <button type="button" class="btn-icon btn-icon-restore" title="Restore this statement" data-bs-toggle="tooltip" data-bs-placement="top" onclick="restoreItem(<%= item.id %>)">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            <% } else { %>
                                                <button type="button" class="btn-icon btn-icon-archive" title="Archive this statement" data-bs-toggle="tooltip" data-bs-placement="top" onclick="archiveItem(<%= item.id %>)">
                                                    <i class="fas fa-box-archive"></i>
                                                </button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="content-card">
                <div class="card-header-title">
                    <span><i class="fas fa-question-circle me-2"></i> Citizen's Charter (CC) Questions</span>
                    <button class="btn btn-sm btn-add-item" title="Add a new CC question" onclick="openModal('add', null, 'cc')"><i class="fas fa-plus me-1"></i> Add Question</button>
                </div>
                <div class="p-4">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width:15%">Question #</th>
                                <th style="width:65%">Question Description</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tbody-cc">
                            <% if(typeof settings !== 'undefined' && settings.cc && settings.cc.length > 0) { %>
                                <% settings.cc.forEach((item, index) => { %>
                                    <tr data-id="<%= item.id %>" class="<%= item.is_archived ? 'archived-row item-row-archived' : 'item-row-active' %>">
                                        <td class="px-4 py-3 text-muted fw-bold">CC<%= index + 1 %></td>
                                        <td class="px-4 py-3 item-text">
                                            <%= item.content %>
                                            <% if (item.is_archived) { %>
                                                <span class="badge badge-archived ms-2">ARCHIVED</span>
                                            <% } %>
                                        </td>
                                        <td class="px-4 action-cell">
                                            <button class="btn-icon btn-icon-edit" title="Edit this question" data-bs-toggle="tooltip" data-bs-placement="top" onclick="openModal('edit', this, 'cc', <%= item.id %>)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <% if (item.is_archived) { %>
                                                <button type="button" class="btn-icon btn-icon-restore" title="Restore this question" data-bs-toggle="tooltip" data-bs-placement="top" onclick="restoreItem(<%= item.id %>)">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            <% } else { %>
                                                <button type="button" class="btn-icon btn-icon-archive" title="Archive this question" data-bs-toggle="tooltip" data-bs-placement="top" onclick="archiveItem(<%= item.id %>)">
                                                    <i class="fas fa-box-archive"></i>
                                                </button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Manage Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted">Content / Description</label>
                    <textarea id="itemText" class="form-control" rows="3" placeholder="Enter text here..."></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary px-4" onclick="saveItem()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<%- include('layout/footer') %>

<script>
    let myModal;
    let currentMode = 'add';
    let currentCategory = '';
    let currentDbId = null;
    let currentBtn = null;

    document.addEventListener("DOMContentLoaded", function() {
        myModal = new bootstrap.Modal(document.getElementById('itemModal'));

        // Icon-only action buttons rely on Bootstrap tooltips to reveal what each icon does.
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

        // Archived items ay tinatago by default; naka-toggle lang para makita.
        const archivedRows = document.querySelectorAll('.item-row-archived');
        archivedRows.forEach(row => row.style.display = 'none');

        const showArchivedToggle = document.getElementById('showArchivedToggle');
        if (showArchivedToggle) {
            showArchivedToggle.addEventListener('change', function () {
                archivedRows.forEach(row => {
                    row.style.display = this.checked ? '' : 'none';
                });
            });
        }
    });

    function openModal(mode, btn, category, dbId = null) {
        currentMode = mode;
        currentCategory = category;
        currentDbId = dbId;
        currentBtn = btn;
        
        let titleLabel = category === 'sqd' ? 'SQD Statement' : 'CC Question';
        document.getElementById('modalTitle').innerText = mode === 'add' ? `Add New ${titleLabel}` : `Edit ${titleLabel}`;
        
        if (mode === 'edit' && btn) {
            let tr = btn.closest('tr');
            document.getElementById('itemText').value = tr.querySelector('.item-text').innerText;
        } else {
            document.getElementById('itemText').value = '';
        }
        myModal.show();
    }

    // FUNCTION PARA SA DATABASE ADD AT EDIT (FETCH API)
    async function saveItem() {
        const textVal = document.getElementById('itemText').value.trim();
        if (!textVal) return AppAlert.warning('Hindi pwedeng walang laman ang text field!');

        const payload = { category: currentCategory, content: textVal };
        let endpoint = currentMode === 'edit' ? '/settings/edit' : '/settings/add';
        if (currentMode === 'edit') payload.id = currentDbId;

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await response.json();

            if (data.success) {
                window.location.reload(); // I-refresh ang page para mai-render ang binago mula sa DB safely
            } else {
                await AppAlert.error("Nagkaproblema sa pag-save sa database.");
            }
        } catch(err) {
            console.error(err);
            // "Database Error." was wrong twice over: the request never
            // reached the database (it never left the browser), and offline
            // it blamed the server for the user's own lost connection.
            await AppAlert.fromError(err, "Hindi na-save ang pagbabago. Pakisubukan ulit.");
        }
    }

    // FUNCTION PARA SA DATABASE ARCHIVE (SOFT DELETE, FETCH API)
    async function archiveItem(dbId) {
        const confirmed = await AppAlert.confirm('Sigurado ka ba na gusto mong i-archive ang item na ito?', {
            title: 'Archive this item?',
            confirmText: 'Yes, archive it!'
        });
        if (!confirmed) return;

        try {
            const response = await fetch('/settings/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: dbId })
            });
            const data = await response.json();

            if (data.success) {
                window.location.reload();
            } else {
                await AppAlert.error("Hindi na-archive ang item sa database.");
            }
        } catch(err) {
            console.error(err);
            // "Database Error." was wrong twice over: the request never
            // reached the database (it never left the browser), and offline
            // it blamed the server for the user's own lost connection.
            await AppAlert.fromError(err, "Hindi na-save ang pagbabago. Pakisubukan ulit.");
        }
    }

    // FUNCTION PARA SA DATABASE RESTORE (FETCH API)
    async function restoreItem(dbId) {
        const confirmed = await AppAlert.confirm('Sigurado ka ba na gusto mong i-restore ang item na ito?', {
            title: 'Restore this item?',
            confirmText: 'Yes, restore it!'
        });
        if (!confirmed) return;

        try {
            const response = await fetch('/settings/restore', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: dbId })
            });
            const data = await response.json();

            if (data.success) {
                window.location.reload();
            } else {
                await AppAlert.error("Hindi na-restore ang item sa database.");
            }
        } catch(err) {
            console.error(err);
            // "Database Error." was wrong twice over: the request never
            // reached the database (it never left the browser), and offline
            // it blamed the server for the user's own lost connection.
            await AppAlert.fromError(err, "Hindi na-save ang pagbabago. Pakisubukan ulit.");
        }
    }
</script>

</body>
</html>