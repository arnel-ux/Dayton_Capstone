<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Shared CQA report letterhead/footer/pagination rules (views/layout/report-header.ejs,
         views/layout/report-footer.ejs) — see public/css/report.css. -->
    <link rel="stylesheet" href="/css/report.css">

    <style>
        /* ============================================================
           1. DESIGN TOKENS
           ============================================================ */
        :root {
            --primary-gradient: linear-gradient(135deg, #251d3a 0%, #2a2550 100%);
            --bg-body: #f4f6fb;
            --border-soft: rgba(15, 23, 42, 0.06);
            --border-soft-strong: rgba(15, 23, 42, 0.1);
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --text-faint: #94a3b8;
            --card-bg: #ffffff;

            --navy-900: #251d3a;
            --navy-800: #2a2550;
            --navy-700: #2a2550;
            --gold-500: #ffcc00;
            --gold-400: #ffcc00;

            --radius-lg: 20px;
            --radius-md: 14px;
            --radius-sm: 10px;

            --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.03);
            --shadow-card-hover: 0 10px 24px -8px rgba(15, 23, 42, 0.16);
            --shadow-hero: 0 24px 48px -16px rgba(37, 29, 58, 0.4), 0 2px 8px rgba(37, 29, 58, 0.2);

            --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        }

        body { background-color: var(--bg-body); font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-dark); }

        /* ============================================================
           2. PAGE HEADER
           ============================================================ */
        .dash-toolbar {
            padding-bottom: 22px; margin-bottom: 24px; border-bottom: 1px solid var(--border-soft);
        }

        .dash-title { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.03em; color: var(--text-dark); margin: 0; }
        .dash-subtitle { color: var(--text-muted); font-size: 0.92rem; margin: 4px 0 0; max-width: 46ch; }

        .btn-generate-report {
            background: linear-gradient(160deg, var(--navy-900), var(--navy-700)); border: none; color: #fff; font-weight: 700;
            padding: 11px 22px; border-radius: 12px; box-shadow: 0 10px 24px -8px rgba(37, 29, 58, 0.5);
            transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out), background-color 0.2s ease;
            white-space: nowrap;
        }
        .btn-generate-report:hover { color: #fff; transform: translateY(-2px); box-shadow: 0 14px 30px -8px rgba(37, 29, 58, 0.55); }
        .btn-generate-report:focus-visible { outline: 2px solid var(--navy-700); outline-offset: 2px; }

        /* ============================================================
           3. FILTER ROW — period filter on the left, Generate Report
              pinned to the right corner via ms-auto (stays right-aligned
              even if it wraps to its own line on narrow screens).
           ============================================================ */
        .dash-filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
        .dash-filter-row .btn-generate-report { flex-shrink: 0; }
        .filter-bar-v2 {
            background: var(--card-bg); border: 1px solid var(--border-soft); border-radius: var(--radius-md);
            box-shadow: var(--shadow-card); padding: 12px 18px;
            display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
        }
        .filter-bar-v2 .filter-icon {
            width: 34px; height: 34px; border-radius: 9px; background: rgba(37, 29, 58, 0.07);
            color: var(--navy-900); display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .filter-bar-v2 .filter-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 2px; }
        .filter-bar-v2 select.form-select {
            border: 1px solid var(--border-soft-strong); border-radius: 9px; font-weight: 600; font-size: 0.85rem;
            min-width: 190px; transition: border-color 0.2s ease, box-shadow 0.2s ease;
            background-color: #fff; color: var(--text-dark);
        }
        .filter-bar-v2 select.form-select:focus { border-color: var(--navy-700); box-shadow: 0 0 0 3px rgba(37, 29, 58, 0.12); }
        .filter-clear-btn {
            display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 600;
            color: var(--text-muted); background: rgba(15, 23, 42, 0.05); border-radius: 9px; padding: 8px 14px;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .filter-clear-btn:hover { background: rgba(239, 68, 68, 0.1); color: #b91c1c; }

        /* ============================================================
           4. HERO CARD (Institutional Satisfaction)
           ============================================================ */
        .hero-card {
            position: relative; overflow: hidden; border-radius: var(--radius-lg);
            background: linear-gradient(135deg, #251d3a 0%, #2a2550 60%, #2a2550 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #fff; box-shadow: var(--shadow-hero); padding: 18px 22px; height: 100%;
            box-sizing: border-box;
        }
        .hero-card::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(circle at 88% 8%, rgba(255, 204, 0, 0.08), transparent 45%),
                        radial-gradient(circle at 6% 96%, rgba(255, 255, 255, 0.08), transparent 40%);
            pointer-events: none;
        }
        .hero-card::after {
            content: ''; position: absolute; inset: 0; opacity: 0.5; pointer-events: none;
            background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
            background-size: 18px 18px;
            mask-image: linear-gradient(135deg, rgba(0,0,0,0.6), transparent 65%);
            -webkit-mask-image: linear-gradient(135deg, rgba(0,0,0,0.6), transparent 65%);
        }

        .hero-flex { position: relative; z-index: 1; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; height: 100%; }

        .hero-gauge-wrap { position: relative; width: 74px; height: 74px; flex-shrink: 0; }
        .hero-gauge-wrap svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        .hero-gauge-wrap .gauge-track { fill: none; stroke: rgba(255, 255, 255, 0.14); stroke-width: 8; }
        .hero-gauge-wrap .gauge-fill {
            fill: none; stroke: url(#gaugeGradient); stroke-width: 8; stroke-linecap: round;
            stroke-dasharray: 339.29; stroke-dashoffset: 339.29;
            transition: stroke-dashoffset 1.15s var(--ease-out);
        }
        .hero-gauge-center {
            position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        }
        .hero-gauge-center i { font-size: 0.9rem; color: #fff; opacity: 0.9; }

        .hero-info { flex: 1 1 200px; min-width: 180px; }
        .hero-info-eyebrow {
            font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
            color: rgba(255, 255, 255, 0.6); margin-bottom: 2px;
        }
        .hero-score-line { display: flex; align-items: baseline; gap: 3px; line-height: 1; }
        .hero-score-number { font-size: 1.65rem; font-weight: 800; letter-spacing: -0.03em; }
        .hero-score-sign { font-size: 0.85rem; opacity: 0.55; font-weight: 700; }

        .hero-badges { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
        .hero-level-badge {
            display: inline-flex; align-items: center; gap: 5px; background: rgba(34, 197, 94, 0.18);
            color: #86efac; border: 1px solid rgba(134, 239, 172, 0.35); font-weight: 700; font-size: 0.64rem;
            letter-spacing: 0.02em; padding: 4px 9px; border-radius: 999px;
        }
        .hero-period-badge {
            display: inline-flex; align-items: center; gap: 5px; background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.9);
            font-weight: 600; font-size: 0.64rem; padding: 4px 9px; border-radius: 999px;
            backdrop-filter: blur(6px);
        }

        /* ============================================================
           5. SECONDARY STAT CARD (Total Completed Surveys)
           ============================================================ */
        .stat-card {
            background: var(--card-bg); border: 1px solid var(--border-soft); border-radius: var(--radius-lg);
            transition: transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out), border-color 0.22s ease;
            height: 100%; text-decoration: none !important;
            display: flex; flex-direction: column; color: inherit;
            box-shadow: var(--shadow-card);
        }
        .stat-card:hover { border-color: rgba(37, 29, 58, 0.22); box-shadow: var(--shadow-card-hover); transform: translateY(-3px); }
        .stat-card.p-4 { padding: 16px 20px !important; }
        .stat-card .bg-primary.bg-opacity-10 { background: rgba(37, 29, 58, 0.08) !important; }
        .stat-card .text-primary { color: var(--navy-900) !important; }
        .stat-card .progress { background-color: rgba(15, 23, 42, 0.07) !important; }
        .stat-card .progress-bar.bg-primary { background: linear-gradient(90deg, var(--navy-900), var(--navy-700)) !important; }

        .view-details-pill {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(37, 29, 58, 0.08);
            color: var(--navy-900) !important;
            font-weight: 700; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.03em;
            padding: 4px 12px; border-radius: 999px;
            transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }
        .stat-card:hover .view-details-pill { background: var(--navy-900); color: #fff !important; transform: translateX(2px); }

        .count-up { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; color: var(--text-dark); }

        /* ============================================================
           6. INSIGHT CHIPS
           ============================================================ */
        .insight-chip {
            background: var(--card-bg); border: 1px solid var(--border-soft); border-radius: var(--radius-md);
            padding: 14px 16px; display: flex; align-items: center; gap: 12px; height: 100%;
            box-shadow: var(--shadow-card); transition: box-shadow 0.2s ease, transform 0.2s var(--ease-out);
        }
        .insight-chip:hover { box-shadow: var(--shadow-card-hover); transform: translateY(-2px); }
        .insight-chip-icon {
            width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; font-size: 0.85rem;
        }
        .insight-chip-icon.good { background: rgba(16, 185, 129, 0.14); color: #059669; }
        .insight-chip-icon.active { background: rgba(37, 29, 58, 0.08); color: var(--navy-900); }
        .insight-chip-icon.warn { background: rgba(239, 68, 68, 0.12); color: #dc2626; }
        .insight-chip-label { font-size: 0.62rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 2px; }
        .insight-chip-value { font-size: 0.8rem; font-weight: 700; color: var(--text-dark); line-height: 1.3; }
        .insight-chip-sub { font-size: 0.72rem; color: var(--text-muted); }

        /* ============================================================
           8. ANALYTICS CHART
           ============================================================ */
        .chart-container-main {
            background: var(--card-bg); border: 1px solid var(--border-soft);
            border-radius: var(--radius-lg); padding: 28px; box-shadow: var(--shadow-card);
            box-sizing: border-box;
        }

        .section-eyebrow {
            font-size: 0.7rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--navy-700);
        }
        .chart-toggle-group {
            display: inline-flex; background: rgba(15, 23, 42, 0.05); border-radius: 10px; padding: 4px; gap: 4px;
            flex-shrink: 0;
        }
        .chart-toggle-btn {
            border: none; background: transparent; padding: 8px 16px; border-radius: 8px;
            font-size: 0.78rem; font-weight: 700; color: var(--text-muted); cursor: pointer;
            transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
            white-space: nowrap;
        }
        .chart-toggle-btn:hover:not(.active) { background: rgba(15, 23, 42, 0.06); color: var(--text-dark); }
        .chart-toggle-btn.active { background: var(--navy-900); color: #fff; box-shadow: 0 6px 14px -6px rgba(37, 29, 58, 0.5); }
        .chart-toggle-btn:focus-visible { outline: 2px solid var(--navy-700); outline-offset: 2px; }

        /* ============================================================
           9. SIDE PANELS (Sentiment / Topics / Recent)
           ============================================================ */
        .side-panel-card {
            background: var(--card-bg); border: 1px solid var(--border-soft);
            border-radius: var(--radius-lg); padding: 26px; box-shadow: var(--shadow-card); height: 100%;
            box-sizing: border-box;
        }

        .sentiment-badge { font-size: 0.65rem; padding: 4px 12px; border-radius: 999px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; display: inline-block; white-space: nowrap; }
        .bg-sentiment-positive { background-color: #dcfce7; color: #15803d; }
        .bg-sentiment-negative { background-color: #fee2e2; color: #b91c1c; }
        .bg-sentiment-neutral { background-color: #e2e8f0; color: #334155; }

        .sentiment-chart-wrap { position: relative; flex-shrink: 0; width: 190px; }
        .sentiment-center-total {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            text-align: center; pointer-events: none;
        }
        .sentiment-center-total .num { display: block; font-size: 1.6rem; font-weight: 800; color: var(--text-dark); letter-spacing: -0.02em; }
        .sentiment-center-total .lbl { display: block; font-size: 0.65rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

        /* Shared layout for the two donut/pie panels: chart on the left,
           a compact vertical legend on the right — avoids Chart.js's
           auto-wrapping bottom legend, which was the main source of clutter
           in the previous 4-across layout. */
        .split-chart-row { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
        .chart-legend-list { flex: 1 1 160px; min-width: 140px; display: flex; flex-direction: column; gap: 12px; }
        .chart-legend-row { display: flex; align-items: center; gap: 10px; }
        .legend-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }
        .legend-name { font-size: 0.82rem; font-weight: 600; color: var(--text-dark); flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .legend-value { font-size: 0.85rem; font-weight: 800; color: var(--text-dark); }
        .legend-pct { font-size: 0.72rem; color: var(--text-muted); min-width: 34px; text-align: right; }

        .empty-state-mini { text-align: center; padding: 32px 12px; color: var(--text-muted); }
        .empty-state-mini i { font-size: 1.75rem; opacity: 0.3; margin-bottom: 10px; display: block; }
        .empty-state-mini p { margin: 0; font-size: 0.82rem; }


        /* ============================================================
           10. RANKING PANELS (Top / Attention offices)
           ============================================================ */
        .rank-item { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 5px 0; border-bottom: 1px solid var(--border-soft); }
        .rank-item:last-child { border-bottom: none; padding-bottom: 0; }
        .rank-item:first-child { padding-top: 0; }
        .rank-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .rank-badge {
            flex-shrink: 0; width: 18px; height: 18px; border-radius: 5px; display: flex; align-items: center;
            justify-content: center; font-size: 0.52rem; font-weight: 800; background: rgba(15, 23, 42, 0.06); color: var(--text-muted);
        }
        .rank-badge.medal-1 { background: linear-gradient(135deg, #fde68a, #f59e0b); color: #78350f; }
        .rank-badge.medal-2 { background: linear-gradient(135deg, #e2e8f0, #94a3b8); color: #1e293b; }
        .rank-badge.medal-3 { background: linear-gradient(135deg, #fdba74, #c2703d); color: #431407; }
        .rank-badge.warn { background: rgba(239, 68, 68, 0.12); color: #dc2626; }
        .rank-name { font-weight: 700; font-size: 0.62rem; color: var(--text-dark); white-space: normal; word-break: break-word; }
        .rank-sub { font-size: 0.54rem; color: var(--text-muted); }
        .rank-score { font-weight: 800; font-size: 0.66rem; padding: 2px 7px; border-radius: 999px; flex-shrink: 0; white-space: nowrap; }
        .rank-score.good { background: #dcfce7; color: #15803d; }
        .rank-score.bad { background: #fee2e2; color: #b91c1c; }

        /* ============================================================
           11. SCROLL-REVEAL + MOTION SYSTEM
           ============================================================ */
        .reveal-section { opacity: 0; transform: translateY(16px); transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out); }
        .reveal-section.is-visible { opacity: 1; transform: translateY(0); }

        @media (prefers-reduced-motion: reduce) {
            .stat-card, .count-up, [style*="animation"] { animation: none !important; }
            .reveal-section { opacity: 1 !important; transform: none !important; }
            * { transition-duration: 0.001ms !important; }
        }

        /* ============================================================
           12. RESPONSIVE
           ============================================================ */
        @media (max-width: 767.98px) {
            .hero-card { padding: 26px; }
            .hero-score-number { font-size: 2.4rem; }
            .hero-gauge-wrap { width: 108px; height: 108px; }
            .dash-title { font-size: 1.55rem; }
        }

        /* --- REPORT MODAL INTERFACE STYLES --- */
        #reportModal, #dashboardReportModal {
            display: none;
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 9999; overflow-y: auto; padding: 20px;
        }
        .modal-report-container {
            background: white;
            max-width: 900px; margin: 30px auto; border-radius: 15px; padding: 40px; position: relative;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .modal-controls {
            display: flex; gap: 10px; justify-content: flex-end; margin-bottom: 20px;
            padding-bottom: 15px; border-bottom: 1px solid #eee;
        }

        /* Official Document Layout Styles for PDF/Print.
           Letterhead (report-header-block/etc.) and page-footer rules live in
           public/css/report.css, shared with every other SQD report. */
        .print-title { text-align: center; font-weight: bold; font-size: 16px; margin-bottom: 5px; color: #000; text-transform: uppercase; }
        .print-period { text-align: center; font-size: 14px; font-weight: bold; margin-bottom: 20px; color: #000; }

        .print-table { width: 100%; border-collapse: collapse; font-size: 12px; color: #000; margin-top: 15px; }
        .print-table th { background-color: #5B9BD5 !important; color: white !important; border: 1px solid black; padding: 8px; text-align: center; text-transform: uppercase; }
        .print-table td { border: 1px solid black; padding: 6px 8px; vertical-align: middle; }
        .cluster-row { background-color: #D9D9D9 !important; font-weight: bold; }
        .total-row { font-weight: bold; background-color: #f2f2f2 !important; }
        .num-col { text-align: center; width: 50px; }
        .score-col { text-align: center; width: 150px; font-weight: bold; }
        .inter-col { text-align: center; width: 150px; font-weight: bold; }

        .print-footer { margin-top: 40px; display: flex; justify-content: space-between; font-size: 13px; color: #000; }
        .sign-block { width: 45%; }
        .sign-name { font-weight: bold; text-decoration: underline; margin-top: 35px; margin-bottom: 2px; text-transform: uppercase; }

        @media print {
            #wrapper, .modal-controls { display: none !important; }
            /* Only the modal actually opened (inline display:block from JS) prints —
               this rule repositions it for print without forcing the other one open. */
            #reportModal, #dashboardReportModal { position: absolute; background: white; padding: 0; left: 0; top: 0; width: 100%; }
            .modal-report-container { margin: 0; box-shadow: none; max-width: 100%; padding: 0; }
            .print-footer { break-inside: avoid; page-break-inside: avoid; }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }
    </style>
</head>
<body>

<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>

        <div class="container-fluid px-4 py-4">

            <%
                // Derived, non-fabricated insight pointers — computed purely from
                // the arrays the route already provides. Rendered only when the
                // underlying data actually exists.
                let mostActiveCluster = null;
                if (typeof clusterCards !== 'undefined' && clusterCards.length > 0) {
                    mostActiveCluster = clusterCards.reduce((max, c) => (Number(c.respondents) > Number(max.respondents) ? c : max), clusterCards[0]);
                }
                const topOffice = (typeof topOffices !== 'undefined' && topOffices.length > 0) ? topOffices[0] : null;
                const attentionOffice = (typeof bottomOffices !== 'undefined' && bottomOffices.length > 0) ? bottomOffices[0] : null;
            %>

        

            <div class="dash-filter-row">
                <form action="/dashboard" method="GET" class="filter-bar-v2">
                    <div class="filter-icon"><i class="fas fa-sliders-h"></i></div>
                    <div>
                        <label for="periodCovered" class="filter-label mb-0">Period Covered</label>
                        <select id="periodCovered" name="periodCovered" class="form-select form-select-sm" title="Filter records by period covered" onchange="this.form.submit()">
                            <option value="">All Periods</option>
                            <% if (typeof periodOptions !== 'undefined') { %>
                                <% periodOptions.forEach(opt => { %>
                                    <option value="<%= opt.value %>" <%= selectedPeriod === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <% if (typeof hasQueryParam !== 'undefined' && hasQueryParam) { %>
                        <a href="/dashboard" class="filter-clear-btn" title="Clear the period filter"><i class="fas fa-times"></i> Clear</a>
                    <% } %>
                </form>

                <div class="dropdown ms-auto">
                    <button class="btn btn-generate-report dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Generate a printable report">
                        <i class="fas fa-file-invoice me-2"></i> Generate Report
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><a class="dropdown-item" href="#" onclick="openReportModal(); return false;"><i class="fas fa-file-alt me-2 text-muted"></i> Overall Report</a></li>
                        <li><a class="dropdown-item" href="#" onclick="openDashboardReportModal(); return false;"><i class="fas fa-chart-line me-2 text-muted"></i> Dashboard Report</a></li>
                    </ul>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-8 col-lg-7">
                    <div class="hero-card">
                        <div class="hero-flex">
                            <div class="hero-gauge-wrap">
                                <svg viewBox="0 0 120 120">
                                    <defs>
                                        <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                            <stop offset="0%" stop-color="#ffcc00" />
                                            <stop offset="100%" stop-color="#ffcc00" />
                                        </linearGradient>
                                    </defs>
