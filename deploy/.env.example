# Copy to admin-portal/.env on the VM and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# --- Database (Clever Cloud MySQL add-on "cqa-db") ---
# From the add-on's Information tab.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# --- Session ---
SESSION_SECRET=generate-a-long-random-string-here

# --- Google OAuth (Google Cloud Console -> Credentials) ---
# Callback must match an Authorized redirect URI there, using this VM's
# public IP or domain: http://<ip-or-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Survey receipt email (optional — leave blank to disable) ---
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
