<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .bg-blurred {
            position: fixed;
            top: -5%; left: -5%; right: -5%; bottom: -5%;
            background-image: url('https://spims.cspc.edu.ph/assets/img/background.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(1px);
            z-index: -1;
        }

        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(15, 23, 42, 0.6);
            z-index: -1;
        }

        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 1;
            padding: 1rem;
        }

        .header-container {
            text-align: center;
            margin-bottom: 2rem;
            max-width: 800px;
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 2rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }

        .sub-title {
            color: #f8fafc;
            font-weight: 400;
            font-style: italic;
            font-size: 1.1rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 1.2rem;
        }

        .portal-text {
            color: #ffff;
            font-weight: 700;
            font-size: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;
        }

        @media (max-width: 600px) {
            .main-title { font-size: 1.4rem; }
            .sub-title { font-size: 0.9rem; margin-bottom: 1rem; }
            .portal-text { font-size: 1.1rem; }
        }

        .card-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            width: 400px;
            height: auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.5rem 2rem;
        }

        @media (max-width: 420px) {
            .card-custom {
                width: 90vw;
                padding: 1.5rem;
            }
        }

        .form-control:focus {
            border-color: #0a1f44;
            box-shadow: 0 0 0 0.25rem rgba(10, 31, 68, 0.25);
        }

        .form-control[readonly] {
            background-color: #f1f5f9;
            color: #475569;
        }

        .text-xsmall {
            font-size: 0.75rem;
        }

        .btn-home {
            position: fixed;
            top: 1.25rem;
            left: 1.25rem;
            z-index: 10;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50px;
            padding: 0.5rem 1.1rem;
            font-weight: 600;
            font-size: 0.85rem;
            backdrop-filter: blur(6px);
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-home:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <a href="/login" class="btn-home" title="Back to Login">
        <i class="fas fa-arrow-left me-1"></i> Back to Login
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Finish Registration</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-3">
                <% if (typeof photo !== 'undefined' && photo) { %>
                    <img src="<%= photo %>" alt="Google profile photo" referrerpolicy="no-referrer" style="width: 55px; height: 55px; border-radius: 50%; object-fit: cover;" class="mb-2">
                <% } else { %>
                    <img src="/images/cspc-logo.png" alt="CSPC Logo" style="width: 55px; height: auto;" class="mb-2">
                <% } %>
                <h4 class="fw-bold text-dark mb-0">Welcome!</h4>
                <p class="text-muted text-xsmall mb-0">We found your Google account. Set a password to finish creating your account.</p>
            </div>

            <form action="/complete-google-registration" method="POST" id="completeRegistrationForm">
                <div class="mb-2">
                    <label class="text-muted text-xsmall fw-semibold mb-1">Name</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0" value="<%= name %>" readonly title="Name from your Google account">
                    </div>
                </div>

                <div class="mb-2">
                    <label class="text-muted text-xsmall fw-semibold mb-1">Email</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                        <input type="text" class="form-control bg-light border-start-0 ps-0" value="<%= email %>" readonly title="Email from your Google account">
                    </div>
                </div>

                <div class="mb-2">
                    <label class="text-muted text-xsmall fw-semibold mb-1">Create Password</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="password" class="form-control bg-light border-start-0 ps-0" placeholder="At least 8 characters" minlength="8" required title="Create a password for future logins">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted text-xsmall fw-semibold mb-1">Confirm Password</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="confirmPassword" class="form-control bg-light border-start-0 ps-0" placeholder="Re-enter your password" minlength="8" required title="Confirm your password">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2" style="background-color: #0a1f44; border-color: #0a1f44;" title="Create your account">
                    <i class="fas fa-user-plus me-2"></i> Create Account
                </button>

                <p class="text-muted text-xsmall text-center mt-3 mb-0">
                    You'll use this password to log in next time — the standard Email and Password form on the login page.
                </p>
            </form>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const regErrorMsg = new URLSearchParams(window.location.search).get('error');
        if (regErrorMsg) {
            AppAlert.error(regErrorMsg, 'Could Not Create Account');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        document.getElementById('completeRegistrationForm').addEventListener('submit', (e) => {
            const password = e.target.password.value;
            const confirmPassword = e.target.confirmPassword.value;
            if (password.length < 8) {
                e.preventDefault();
                AppAlert.warning('Password must be at least 8 characters long.', 'Password Too Short');
                return;
            }
            if (password !== confirmPassword) {
                e.preventDefault();
                AppAlert.warning('The passwords you entered do not match.', 'Passwords Do Not Match');
            }
        });
    </script>

    <%- include('layout/theme-toggle') %>
</body>
</html>
