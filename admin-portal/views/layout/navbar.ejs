<nav class="top-navbar mb-4">
    <div class="d-flex align-items-center">
        <button type="button" id="sidebarCollapse" class="btn btn-light me-3" title="Hide/show sidebar"><i class="fas fa-bars"></i></button>
        <h5 class="mb-0 fw-semibold text-dark d-none d-md-block" id="pageTitle">Dashboard</h5>
    </div>
    <%
        const _currentAdmin = typeof currentAdmin !== 'undefined' ? currentAdmin : null;
        const _adminDisplayName = _currentAdmin ? _currentAdmin.fullname : 'Admin';
        const _avatarBg = _currentAdmin && _currentAdmin.gender === 'Female' ? 'ec4899' : '0a1f44';
        const _avatarSrc = (_currentAdmin && _currentAdmin.photo_url)
            ? _currentAdmin.photo_url
            : `https://ui-avatars.com/api/?name=${encodeURIComponent(_adminDisplayName)}&background=${_avatarBg}&color=fff`;
    %>
    <div class="navbar-actions">

        <!-- Incoming-survey bell. The feed is survey_responses itself (see
             /api/admin/notifications) — nothing is written per notification, so
             what's listed here is always exactly what's in the records.

             A MODAL, not a dropdown. A dropdown anchors to the bell, which is
             in the top-right corner, so the panel opened into the corner of a
             wide screen — the furthest point from where the admin is actually
             looking — and was capped at 340px wide by the space left beside
             it. Respondent and office names are long enough that nearly every
             row was truncated to an ellipsis inside that width. Centring it
             takes the width cap away, so the rows can show the whole name, and
             puts the panel where the eye already is. The backdrop that comes
             with a modal also makes it unmistakably a thing you are IN and
             then dismiss, rather than something that vanishes on a stray
             click somewhere else on the page. -->
        <div class="notif-bell-wrap">
            <button type="button" id="adminNotifBell" class="notif-bell"
                    data-bs-toggle="modal" data-bs-target="#adminNotifModal"
                    data-admin-key="<%= _currentAdmin && _currentAdmin.id ? _currentAdmin.id : 'admin' %>"
                    title="Incoming surveys" aria-label="Incoming surveys">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" id="adminNotifBadge" hidden>0</span>
            </button>
        </div>

        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                <img src="<%= _avatarSrc %>" width="36" height="36" class="rounded-circle me-2" style="object-fit: cover;">
                <div class="d-none d-sm-block">
                    <strong><%= _adminDisplayName %></strong>
                    <% if (_currentAdmin && _currentAdmin.role) { %>
                        <div class="text-muted" style="font-size: 0.72rem; line-height: 1;"><%= _currentAdmin.role %></div>
                    <% } %>
                </div>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li><a class="dropdown-item" href="/profile"><i class="fas fa-user fa-sm me-2 text-muted"></i> Profile</a></li>
                <li><a class="dropdown-item" href="/password"><i class="fas fa-cogs fa-sm me-2 text-muted"></i>Manage Password</a></li>
                <% if (_currentAdmin && _currentAdmin.role === 'Super Admin') { %>
                    <li><a class="dropdown-item" href="/manage-admins"><i class="fas fa-users-cog fa-sm me-2 text-muted"></i> Manage Admins</a></li>
                <% } %>
                <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#adminLogsModal"><i class="fas fa-history fa-sm me-2 text-muted"></i> Admin Logs</a></li>
                <li><a class="dropdown-item" href="/activity-logs"><i class="fas fa-list-check fa-sm me-2 text-muted"></i> Activity Logs</a></li>

                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout?scope=admin" id="adminLogoutBtn"><i class="fas fa-sign-out-alt fa-sm me-2"></i> Logout</a></li>
            </ul>
        </div>

    </div>
</nav>

<style>
    /* The navbar is justify-content: space-between, so the bell and the admin
       menu share one right-hand group rather than being pushed to opposite
       ends of the bar. */
    .navbar-actions {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .notif-bell-wrap { position: relative; display: flex; }
    .notif-bell {
        position: relative;
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid var(--border-color, #e5e7eb);
        background: transparent;
        color: var(--text-muted, #6b7280);
        font-size: 0.95rem;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }
    .notif-bell:hover,
    .notif-bell.is-open {
        background: var(--primary, #251d3a);
        border-color: var(--primary, #251d3a);
        color: #fff;
    }
    .notif-bell:active { transform: scale(0.94); }
    .notif-bell:focus-visible { outline: 2px solid var(--accent, #ffcc00); outline-offset: 2px; }

    /* Unread state. The badge alone is 18px in the corner of the screen and is
       genuinely easy to walk past; the ring draws the eye to the bell without
       moving anything or making noise. It runs three times and stops — a
       permanent animation in a toolbar becomes furniture within a minute and
       is then just something flickering while you are trying to read the page. */
    .notif-bell.has-unread { color: var(--primary, #251d3a); border-color: rgba(37, 29, 58, 0.35); }
    html[data-bs-theme="dark"] .notif-bell.has-unread { color: #b9cbff; border-color: rgba(185, 203, 255, 0.4); }
    .notif-bell.has-unread::after {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: 50%;
        border: 2px solid #dc3545;
        opacity: 0;
        animation: notifRing 2s ease-out 3;
    }
    @keyframes notifRing {
        0%   { transform: scale(1);    opacity: 0.75; }
        70%  { transform: scale(1.45); opacity: 0; }
        100% { transform: scale(1.45); opacity: 0; }
    }
    .notif-bell.has-unread > i { animation: notifSwing 2s ease-in-out 3; transform-origin: 50% 15%; }
    @keyframes notifSwing {
        0%, 60%, 100% { transform: rotate(0deg); }
        5%  { transform: rotate(13deg); }
        15% { transform: rotate(-11deg); }
        25% { transform: rotate(8deg); }
        35% { transform: rotate(-6deg); }
        45% { transform: rotate(3deg); }
    }
    @media (prefers-reduced-motion: reduce) {
        .notif-bell.has-unread::after,
        .notif-bell.has-unread > i { animation: none; }
        .notif-bell.has-unread::after { opacity: 0.6; }
    }

    /* Rings the badge in the navbar's own background colour so it reads as a
       separate chip sitting on top of the bell, not part of the icon. */
    .notif-badge {
        position: absolute;
        top: -3px;
        right: -3px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: #dc3545;
        color: #fff;
        font-size: 0.66rem;
        font-weight: 700;
        line-height: 18px;
        text-align: center;
        box-shadow: 0 0 0 2px var(--navbar-bg, #fff);
    }
    .notif-badge[hidden] { display: none !important; }

    /* ==================== THE PANEL ====================
       A centred modal (see the markup comment on the bell). Bootstrap's own
       .modal-content is the box; everything below restyles it into a panel
       rather than a form dialog — no bordered header/footer bars, because
       three horizontal rules stacked inside 500px of height is most of what
       you end up seeing. The header carries the brand gradient and the footer
       is one tinted strip, so the panel reads as three bands, not five. */
    .notif-modal .modal-dialog { max-width: 520px; }

    .notif-modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        background: var(--bg-card, #fff);
        box-shadow: 0 24px 60px -18px rgba(15, 23, 42, 0.45);
    }

    /* A touch more travel than Bootstrap's default, plus a scale, so the panel
       reads as coming FORWARD out of the page — which is what tells you it is
       centred on purpose rather than having lost its anchor. */
    .notif-modal.fade .modal-dialog {
        transform: translateY(18px) scale(0.97);
        transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    .notif-modal.show .modal-dialog { transform: none; }
    @media (prefers-reduced-motion: reduce) {
        .notif-modal.fade .modal-dialog { transition: none; transform: none; }
    }

    .notif-head {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 18px 20px;
        background: linear-gradient(135deg, var(--primary, #251d3a), var(--primary-hover, #2a2550));
        color: #fff;
    }
    /* A hairline of brand gold along the bottom of the header — the same accent
       the sidebar and the auth pages use, and the one thing that keeps a flat
       navy band from looking like an unstyled placeholder. */
    .notif-head::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--accent, #ffcc00), rgba(255, 204, 0, 0));
    }

    .notif-head-icon {
        flex: 0 0 auto;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.18);
        font-size: 1rem;
    }

    .notif-head-text { flex: 1 1 auto; min-width: 0; }
    .notif-head-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        color: #fff;
    }
    .notif-head-sub {
        margin: 2px 0 0;
        font-size: 0.75rem;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.72);
    }

    .notif-head-count {
        flex: 0 0 auto;
        font-size: 0.68rem;
        font-weight: 700;
        color: #fff;
        background: #dc3545;
        border-radius: 999px;
        padding: 3px 9px;
        white-space: nowrap;
    }
    .notif-head-count[hidden] { display: none !important; }

    .notif-head-close {
        flex: 0 0 auto;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 0.9rem;
        transition: background-color 0.15s ease;
    }
    .notif-head-close:hover { background: rgba(255, 255, 255, 0.26); color: #fff; }
    .notif-head-close:focus-visible { outline: 2px solid var(--accent, #ffcc00); outline-offset: 2px; }

    /* Capped so the panel stays centred and dismissible on a laptop screen
       rather than filling it; dvh because a phone's address bar eats into vh. */
    .notif-body {
        flex: 1 1 auto;
        overflow-y: auto;
        max-height: min(58vh, 460px);
        max-height: min(58dvh, 460px);
        padding: 8px;
    }

    /* Each row is its own rounded tile with a gap between, rather than a
       full-width row separated by a rule. A dozen hairlines down a scrolling
       list is visual noise; whitespace separates them just as well. */
    .notif-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        text-decoration: none;
        color: inherit;
        transition: background-color 0.15s ease;
    }
    .notif-row { padding-right: 66px; }
    .notif-row:hover { background: var(--bg-light, #f3f4f6); color: inherit; }
    html[data-bs-theme="dark"] .notif-row:hover { background: rgba(255, 255, 255, 0.05); }
    .notif-row:focus-visible { outline: 2px solid var(--primary, #251d3a); outline-offset: -2px; }

    /* Unread rows get a coloured rail down the left edge as well as the tint:
       the tint on its own was a 4.5%-opacity wash that did not survive being
       looked at on a bright screen. */
    .notif-row.is-new {
        background: rgba(220, 53, 69, 0.11);
        box-shadow: inset 3px 0 0 #dc3545;
    }
    html[data-bs-theme="dark"] .notif-row.is-new { background: rgba(220, 53, 69, 0.2); }
    /* An unread row should read as lit-up next to the ones already seen, not
       merely tinted: the title goes to full strength and the whole row sits on
       a soft halo, while seen rows are dimmed slightly to widen the gap. */
    .notif-row.is-new .notif-row-office { color: var(--text-main, #1f2937); font-weight: 800; }
    html[data-bs-theme="dark"] .notif-row.is-new .notif-row-office { color: #fff; }
    .notif-row.is-new .notif-row-sub,
    .notif-row.is-new .notif-row-time { color: var(--text-muted, #6b7280); }
    html[data-bs-theme="dark"] .notif-row.is-new .notif-row-sub,
    html[data-bs-theme="dark"] .notif-row.is-new .notif-row-time { color: #cbd5e1; }
    .notif-row.is-new:hover { background: rgba(220, 53, 69, 0.17); }
    html[data-bs-theme="dark"] .notif-row.is-new:hover { background: rgba(220, 53, 69, 0.26); }
    .notif-row:not(.is-new) { opacity: 0.86; }
    .notif-row:not(.is-new):hover { opacity: 1; }

    /* ---- Toolbar: All/Unread filter + bulk actions ---- */
    .notif-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .notif-filter {
        display: inline-flex;
        gap: 4px;
        padding: 3px;
        border-radius: 999px;
        background: var(--bg-light, #f3f4f6);
    }
    html[data-bs-theme="dark"] .notif-filter { background: rgba(255, 255, 255, 0.06); }
    .notif-filter-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 0;
        background: transparent;
        color: var(--text-muted, #6b7280);
        font-size: 0.74rem;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 999px;
        white-space: nowrap;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .notif-filter-btn:hover { color: var(--text-main, #1f2937); }
    .notif-filter-btn.is-active {
        background: var(--card-bg, #fff);
        color: var(--primary, #251d3a);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    }
    html[data-bs-theme="dark"] .notif-filter-btn.is-active { background: rgba(255, 255, 255, 0.14); color: #fff; }
    .notif-filter-btn:focus-visible { outline: 2px solid var(--primary, #251d3a); outline-offset: 1px; }
    /* The unread tally rides on its own tab, so the number and the list it
       opens can never disagree. */
    .notif-filter-count {
        min-width: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: rgba(220, 53, 69, 0.14);
        color: #dc3545;
        font-size: 0.68rem;
        font-weight: 800;
        line-height: 1.5;
        text-align: center;
    }
    .notif-filter-count.is-zero { background: rgba(148, 163, 184, 0.2); color: var(--text-faint, #9ca3af); }

    .notif-toolbar-actions { display: inline-flex; gap: 6px; flex-wrap: wrap; }
    .notif-tool-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--border-color, #e5e7eb);
        background: var(--card-bg, #fff);
        color: var(--text-muted, #6b7280);
        font-size: 0.72rem;
        font-weight: 700;
        padding: 5px 10px;
        border-radius: 999px;
        white-space: nowrap;
        transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    html[data-bs-theme="dark"] .notif-tool-btn { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.12); color: #cbd5e1; }
    .notif-tool-btn:hover { color: var(--primary, #251d3a); border-color: var(--primary, #251d3a); }
    html[data-bs-theme="dark"] .notif-tool-btn:hover { color: #fff; border-color: rgba(255, 255, 255, 0.4); }
    .notif-tool-btn.is-danger:hover { color: #dc3545; border-color: #dc3545; }
    .notif-tool-btn:disabled { opacity: 0.45; }
    .notif-tool-btn:focus-visible { outline: 2px solid var(--primary, #251d3a); outline-offset: 1px; }

    /* Each row and its own delete button share a wrapper: the button cannot
       live inside the row itself, because the row is a link. */
    .notif-row-wrap { position: relative; }
    .notif-row-wrap + .notif-row-wrap { margin-top: 2px; }
    .notif-row-actions {
        position: absolute;
        top: 8px;
        right: 8px;
        display: inline-flex;
        gap: 2px;
    }
    .notif-row-btn {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text-faint, #9ca3af);
        font-size: 0.78rem;
        opacity: 0;
        transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    }
    .notif-row-wrap:hover .notif-row-btn,
    .notif-row-btn:focus-visible { opacity: 1; }
    .notif-row-read:hover { background: rgba(37, 99, 235, 0.14); color: #2563eb; }
    .notif-row-dismiss:hover { background: rgba(220, 53, 69, 0.14); color: #dc3545; }
    /* Touch screens have no hover, so the buttons must simply always be there. */
    @media (hover: none) {
        .notif-row-btn { opacity: 1; }
    }

    .notif-row-icon {
        flex: 0 0 auto;
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37, 29, 58, 0.08);
        color: var(--primary, #251d3a);
        font-size: 0.85rem;
    }
    html[data-bs-theme="dark"] .notif-row-icon { background: rgba(109, 150, 255, 0.16); color: #b9cbff; }
    .notif-row.is-new .notif-row-icon { background: rgba(220, 53, 69, 0.12); color: #dc3545; }

    .notif-row-body { flex: 1 1 auto; min-width: 0; }

    .notif-row-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-main, #1f2937);
        margin: 0;
        line-height: 1.35;
    }
    /* The office name is the part that can be arbitrarily long, so it is the
       only part allowed to truncate — the label and the NEW tag beside it
       always stay whole. */
    .notif-row-office {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .notif-row-tag {
        flex: 0 0 auto;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #dc3545;
        background: rgba(220, 53, 69, 0.12);
        border-radius: 999px;
        padding: 1px 7px;
    }
    .notif-row-sub {
        font-size: 0.78rem;
        color: var(--text-muted, #6b7280);
        margin: 3px 0 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .notif-row-time {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        color: var(--text-muted, #9ca3af);
        margin: 4px 0 0;
    }

    /* ---- Empty / error state ---- */
    .notif-placeholder {
        padding: 44px 20px;
        text-align: center;
        color: var(--text-muted, #6b7280);
    }
    .notif-placeholder-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        margin-bottom: 14px;
        border-radius: 50%;
        background: var(--bg-light, #f3f4f6);
        color: var(--text-muted, #9ca3af);
        font-size: 1.4rem;
    }
    html[data-bs-theme="dark"] .notif-placeholder-icon { background: rgba(255, 255, 255, 0.05); }
    .notif-placeholder-title { margin: 0; font-size: 0.9rem; font-weight: 700; color: var(--text-main, #1f2937); }
    .notif-placeholder-sub { margin: 5px 0 0; font-size: 0.8rem; line-height: 1.5; }

    /* ---- Loading skeleton ---- */
    .notif-skeleton { padding: 4px; }
    .notif-skeleton-row { display: flex; align-items: center; gap: 12px; padding: 12px 10px; }
    .sk-dot, .sk-line {
        display: block;
        border-radius: 8px;
        background: linear-gradient(90deg, rgba(148, 163, 184, 0.16) 25%, rgba(148, 163, 184, 0.30) 37%, rgba(148, 163, 184, 0.16) 63%);
        background-size: 400% 100%;
        animation: notifShimmer 1.3s ease-in-out infinite;
    }
    .sk-dot { width: 38px; height: 38px; border-radius: 11px; flex: 0 0 auto; }
    .sk-lines { flex: 1 1 auto; display: flex; flex-direction: column; gap: 7px; }
    .sk-line { height: 9px; }
    .sk-line-lg { width: 62%; }
    .sk-line-sm { width: 38%; }
    @keyframes notifShimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }
    @media (prefers-reduced-motion: reduce) { .sk-dot, .sk-line { animation: none; } }

    /* ---- Footer ---- */
    .notif-foot {
        padding: 12px 16px;
        border-top: 1px solid var(--border-color, #e5e7eb);
        background: var(--bg-light, #f9fafb);
    }
    html[data-bs-theme="dark"] .notif-foot { background: rgba(255, 255, 255, 0.03); }
    .notif-foot-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 9px 16px;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 700;
        color: #fff;
        background: var(--primary, #251d3a);
        text-decoration: none;
        transition: filter 0.15s ease, transform 0.15s ease;
    }
    /* In dark mode the button and the strip it sits on are both dark navy, so
       the button loses its edge and reads as a label rather than a control.
       Lifted a shade and outlined, which is the smallest thing that gives it
       one back. */
    html[data-bs-theme="dark"] .notif-foot-btn {
        background: #322c58;
        border: 1px solid rgba(255, 255, 255, 0.14);
    }
    .notif-foot-btn:hover { color: #fff; filter: brightness(1.12); transform: translateY(-1px); }
    .notif-foot-btn:focus-visible { outline: 2px solid var(--accent, #ffcc00); outline-offset: 2px; }

    @media (max-width: 575.98px) {
        .navbar-actions { gap: 8px; }
        /* Full width inside the dialog's own side margin, and a taller body —
           a phone has the height to spare and nothing else competing for it. */
        .notif-modal .modal-dialog { max-width: none; margin: 0.75rem; }
        .notif-head { padding: 14px 16px; gap: 10px; }
        .notif-head-icon { width: 36px; height: 36px; border-radius: 10px; }
        .notif-head-title { font-size: 0.92rem; }
        .notif-head-sub { display: none; }
        .notif-body { max-height: 62dvh; }
    }
</style>

<!-- ===================== INCOMING SURVEYS ===================== -->
<div class="modal fade notif-modal" id="adminNotifModal" tabindex="-1" aria-labelledby="adminNotifModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content notif-modal-content">

            <div class="notif-head">
                <span class="notif-head-icon" aria-hidden="true"><i class="fas fa-bell"></i></span>
                <div class="notif-head-text">
                    <h5 class="notif-head-title" id="adminNotifModalLabel">Incoming Surveys</h5>
                    <p class="notif-head-sub">The most recent responses submitted across all offices</p>
                </div>
                <!-- Sits next to the close button rather than beside the title:
                     it changes on every poll, and a chip that resizes in the
                     middle of a heading drags the heading around with it. -->
                <span class="notif-head-count" id="adminNotifHeadCount" hidden></span>
                <button type="button" class="notif-head-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-xmark"></i>
                </button>
            </div>

            <!-- Toolbar: which rows to list, and the two bulk actions. Kept out
                 of the coloured header because these are controls the admin
                 works with, not part of the panel's title. -->
            <div class="notif-toolbar">
                <div class="notif-filter" role="tablist" aria-label="Filter notifications">
                    <button type="button" class="notif-filter-btn is-active" data-filter="all" role="tab" aria-selected="true">All</button>
                    <button type="button" class="notif-filter-btn" data-filter="unread" role="tab" aria-selected="false">
                        Unread <span class="notif-filter-count" id="adminNotifUnreadCount">0</span>
                    </button>
                </div>
                <div class="notif-toolbar-actions">
                    <button type="button" class="notif-tool-btn" id="adminNotifMarkAll" title="Mark every notification as read">
                        <i class="fas fa-check-double" aria-hidden="true"></i> Mark all read
                    </button>
                    <button type="button" class="notif-tool-btn is-danger" id="adminNotifClearAll" title="Clear every notification from this list">
                        <i class="fas fa-broom" aria-hidden="true"></i> Clear all
                    </button>
                </div>
            </div>

            <div class="notif-body" id="adminNotifList">
                <!-- Skeleton rows, not a spinner: the panel opens at its final
                     height and the real rows land where the grey ones were, so
                     nothing jumps as the fetch resolves. -->
                <div class="notif-skeleton" aria-hidden="true">
                    <div class="notif-skeleton-row"><span class="sk-dot"></span><span class="sk-lines"><span class="sk-line sk-line-lg"></span><span class="sk-line sk-line-sm"></span></span></div>
                    <div class="notif-skeleton-row"><span class="sk-dot"></span><span class="sk-lines"><span class="sk-line sk-line-lg"></span><span class="sk-line sk-line-sm"></span></span></div>
                    <div class="notif-skeleton-row"><span class="sk-dot"></span><span class="sk-lines"><span class="sk-line sk-line-lg"></span><span class="sk-line sk-line-sm"></span></span></div>
                </div>
                <span class="visually-hidden" role="status">Loading notifications…</span>
            </div>

            <div class="notif-foot">
                <a class="notif-foot-btn" href="/survey-records">
                    View all survey records <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="adminLogsModal" tabindex="-1" aria-labelledby="adminLogsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom-0">
                <h5 class="modal-title fw-bold text-dark" id="adminLogsModalLabel">
                    <i class="fas fa-clipboard-list me-2" style="color: #251d3a;"></i> Admin Access Logs
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="adminLogsTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Date</th>
                                <th>Name</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th class="pe-4">Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof adminLogs !== 'undefined' && adminLogs.length > 0) { %>
                                <% adminLogs.forEach(log => { %>
                                    <tr>
                                        <td class="ps-4 text-muted"><small><%= log.login_date %></small></td>
                                        <td><span class="fw-semibold"><%= log.username %></span></td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="fas fa-sign-in-alt me-1"></i> <%= log.login_time_fmt %></span></td>
                                        <% if (log.isActive) { %>
                                            <td><span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25"><i class="fas fa-circle me-1"></i> Active now</span></td>
                                            <td class="pe-4 fw-bold text-secondary live-duration" data-login="<%= log.login_time_iso %>">00m 00s</td>
                                        <% } else if (log.logout_time_fmt) { %>
                                            <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25"><i class="fas fa-sign-out-alt me-1"></i> <%= log.logout_time_fmt %></span></td>
                                            <td class="pe-4 fw-bold text-secondary"><%= log.duration_text %></td>
                                        <% } else { %>
                                            <!-- logout_time not yet written — session went stale (cookie expired, browser closed) and the periodic sweep hasn't caught up to it yet -->
                                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"><i class="fas fa-clock me-1"></i> Session expired</span></td>
                                            <td class="pe-4 fw-bold text-secondary">&mdash;</td>
                                        <% } %>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">Walang naitalang admin session.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light border-top-0">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary px-4" style="background-color: #251d3a; border: none;" onclick="exportAdminLogs()"><i class="fas fa-file-csv me-2"></i>Export Logs</button>
            </div>
        </div>
    </div>
</div>

<script>
    // --- Incoming-survey notification bell ---
    // Polls /api/admin/notifications for the newest canonical survey responses
    // and badges however many arrived since this admin last opened the panel
    // (the server-side watermark — see admins.notifications_seen_at). Opening
    // the panel is what marks them seen, so the badge belongs to this admin
    // alone and clearing it never touches anyone else's.
    (function () {
        var POLL_MS = 30000;

        var bell = document.getElementById('adminNotifBell');
        var badge = document.getElementById('adminNotifBadge');
        var headCount = document.getElementById('adminNotifHeadCount');
        var list = document.getElementById('adminNotifList');
        var modal = document.getElementById('adminNotifModal');
        var clearAllBtn = document.getElementById('adminNotifClearAll');
        var markAllBtn = document.getElementById('adminNotifMarkAll');
        var unreadCountEl = document.getElementById('adminNotifUnreadCount');
        var filterBtns = document.querySelectorAll('.notif-filter-btn');
        if (!bell || !badge || !list || !modal) return;

        var pollTimer = null;

        // Dismissed notifications. The feed IS survey_responses, so there is no
        // notification row to delete -- deleting one here must never delete the
        // survey itself, which still has to show up on /survey-records and in
        // the reports. What is stored is therefore only "this admin has cleared
        // survey #N from their own bell", kept in this browser and keyed by
        // admin id so two admins sharing a machine do not clear each other's.
        var DISMISS_KEY = 'adminNotifDismissed:' + (bell.dataset.adminKey || 'admin');
        var dismissed = (function () {
            try {
                var raw = JSON.parse(localStorage.getItem(DISMISS_KEY));
                return Array.isArray(raw) ? raw.map(Number) : [];
            } catch (e) { return []; }
        })();
        // Whatever the panel last received from the server, before dismissals
        // are applied -- "Clear all" works off this.
        var lastItems = [];

        // Read/unread is tracked HERE, not off the server's isNew flag alone.
        // isNew is derived from the seen watermark, and merely OPENING the panel
        // moves that watermark, so every row would flip to "read" on the next
        // 30s poll whether or not the admin actually dealt with it -- an Unread
        // list built on it would empty itself while the admin was reading it.
        // Instead each notification is classified ONCE, the first time this
        // browser ever sees it: arrived unseen => unread, already seen => read.
        // After that only the admin changes it, via the row's own button or
        // "Mark all read".
        var READ_KEY = 'adminNotifRead:' + (bell.dataset.adminKey || 'admin');
        var KNOWN_KEY = 'adminNotifKnown:' + (bell.dataset.adminKey || 'admin');

        function loadIdSet(key) {
            try {
                var raw = JSON.parse(localStorage.getItem(key));
                return Array.isArray(raw) ? raw.map(Number) : [];
            } catch (e) { return []; }
        }

        var readIds = loadIdSet(READ_KEY);
        var knownIds = loadIdSet(KNOWN_KEY);
        var activeFilter = 'all';

        function saveIdSet(key, ids) {
            try { localStorage.setItem(key, JSON.stringify(ids)); } catch (e) { /* private mode */ }
        }

        // Classifies anything this browser has not seen before, then prunes all
        // three stored sets back to what the feed still returns.
        function reconcileReadState() {
            var live = lastItems.map(function (item) { return Number(item.id); });

            lastItems.forEach(function (item) {
                var id = Number(item.id);
                if (knownIds.indexOf(id) !== -1) return;
                knownIds.push(id);
                if (!item.isNew && readIds.indexOf(id) === -1) readIds.push(id);
            });

            function prune(ids) {
                return ids.filter(function (id) { return live.indexOf(id) !== -1; });
            }
            knownIds = prune(knownIds);
            readIds = prune(readIds);
            saveIdSet(KNOWN_KEY, knownIds);
            saveIdSet(READ_KEY, readIds);
        }

        function isUnread(item) {
            return readIds.indexOf(Number(item.id)) === -1;
        }

        function markRead(id) {
            id = Number(id);
            if (readIds.indexOf(id) === -1) readIds.push(id);
            saveIdSet(READ_KEY, readIds);
            renderList(lastItems);
        }

        function markAllRead() {
            lastItems.forEach(function (item) {
                var id = Number(item.id);
                if (isDismissed(item)) return;
                if (readIds.indexOf(id) === -1) readIds.push(id);
            });
            saveIdSet(READ_KEY, readIds);
            renderList(lastItems);
        }

        function saveDismissed() {
            // Only ids still in the feed are worth keeping: the endpoint returns
            // the newest 20, so anything older can never be listed again and the
            // stored list would otherwise grow without limit.
            var live = lastItems.map(function (item) { return Number(item.id); });
            dismissed = dismissed.filter(function (id) { return live.indexOf(id) !== -1; });
            try { localStorage.setItem(DISMISS_KEY, JSON.stringify(dismissed)); } catch (e) { /* private mode */ }
        }

        function isDismissed(item) {
            return dismissed.indexOf(Number(item.id)) !== -1;
        }

        function dismissOne(id) {
            id = Number(id);
            if (dismissed.indexOf(id) === -1) dismissed.push(id);
            saveDismissed();
            renderList(lastItems);
        }

        function dismissAll() {
            lastItems.forEach(function (item) {
                var id = Number(item.id);
                if (dismissed.indexOf(id) === -1) dismissed.push(id);
            });
            saveDismissed();
            renderList(lastItems);
        }

        function stopPolling() {
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
        }

        // Same shape the rest of the portal uses for recent activity: a short
        // relative age while it's fresh, an actual date once it isn't.
        function relativeTime(iso) {
            if (!iso) return '';
            var then = new Date(iso).getTime();
            if (isNaN(then)) return '';
            var secs = Math.max(0, Math.floor((Date.now() - then) / 1000));
            if (secs < 60) return 'Just now';
            var mins = Math.floor(secs / 60);
            if (mins < 60) return mins + (mins === 1 ? ' minute ago' : ' minutes ago');
            var hrs = Math.floor(mins / 60);
            if (hrs < 24) return hrs + (hrs === 1 ? ' hour ago' : ' hours ago');
            var days = Math.floor(hrs / 24);
            if (days < 7) return days + (days === 1 ? ' day ago' : ' days ago');
            return new Date(then).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // The BELL's badge only. The panel's own header count is set by
        // renderList instead, and the two are deliberately not the same number
        // at the same moment: opening the panel is the "seen" event, so this
        // is driven to zero the instant the modal finishes opening, while the
        // rows on screen keep their "new" highlight until the next poll. A
        // header chip wired to this one read "3 new" for a single frame and
        // then blanked itself while three rows were still visibly marked new.
        function setBadge(count) {
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : String(count);
                badge.hidden = false;
            } else {
                badge.hidden = true;
            }
            // Drives the ring/swing on the bell itself. Only ADDED when the
            // count goes from zero to non-zero: re-adding it on every 30s poll
            // while the count merely stays the same would restart the
            // animation forever, which is the exact "flickering furniture" the
            // three-iteration limit in the CSS exists to avoid.
            var wanted = count > 0;
            if (wanted !== bell.classList.contains('has-unread')) {
                bell.classList.toggle('has-unread', wanted);
            }
        }

        // Built with DOM nodes rather than an HTML string so a respondent name
        // or office name containing markup can never be injected into the page.
        function renderRow(item) {
            var wrap = document.createElement('div');
            wrap.className = 'notif-row-wrap';

            var unread = isUnread(item);

            var row = document.createElement('a');
            row.className = 'notif-row' + (unread ? ' is-new' : '');
            // Opening a notification is also reading it.
            row.addEventListener('click', function () { markRead(item.id); });
            // Straight to the office this response was submitted for: the
            // records page reads ?office= and opens already filtered to it,
            // instead of dropping the admin at the top of every cluster.
            row.href = '/survey-records?office=' + encodeURIComponent(item.office || '');

            var icon = document.createElement('span');
            icon.className = 'notif-row-icon';
            icon.innerHTML = '<i class="fas fa-clipboard-check"></i>';

            var body = document.createElement('div');
            body.className = 'notif-row-body';

            // The office name is its own element so it alone can truncate —
            // the whole line used to be one nowrap string, so a long office
            // name took the words "New survey for" off the end with it and
            // rows could read "New survey for Office of the Regis…".
            var title = document.createElement('p');
            title.className = 'notif-row-title';
            var office = document.createElement('span');
            office.className = 'notif-row-office';
            office.textContent = 'New survey for ' + item.office;
            office.title = 'New survey for ' + item.office;
            title.appendChild(office);
            if (unread) {
                var tag = document.createElement('span');
                tag.className = 'notif-row-tag';
                tag.textContent = 'New';
                title.appendChild(tag);
            }

            var sub = document.createElement('p');
            sub.className = 'notif-row-sub';
            sub.textContent = 'From ' + item.respondent;
            sub.title = item.email || item.respondent;

            var time = document.createElement('p');
            time.className = 'notif-row-time';
            time.innerHTML = '<i class="far fa-clock"></i>';
            time.appendChild(document.createTextNode(relativeTime(item.createdAt)));

            body.appendChild(title);
            body.appendChild(sub);
            body.appendChild(time);
            row.appendChild(icon);
            row.appendChild(body);

            // The row's own buttons, kept OUTSIDE the link so clicking one can
            // never be read as following the link.
            var actions = document.createElement('div');
            actions.className = 'notif-row-actions';

            // Mark as read is only offered while there is something to mark.
            if (unread) {
                var readBtn = document.createElement('button');
                readBtn.type = 'button';
                readBtn.className = 'notif-row-btn notif-row-read';
                readBtn.title = 'Mark as read';
                readBtn.setAttribute('aria-label', 'Mark this notification as read');
                readBtn.innerHTML = '<i class="fas fa-check" aria-hidden="true"></i>';
                readBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    markRead(item.id);
                });
                actions.appendChild(readBtn);
            }

            var del = document.createElement('button');
            del.type = 'button';
            del.className = 'notif-row-btn notif-row-dismiss';
            del.title = 'Delete this notification';
            del.setAttribute('aria-label', 'Delete this notification');
            del.innerHTML = '<i class="fas fa-trash-can" aria-hidden="true"></i>';
            del.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                confirmThen(
                    'Delete this notification from your bell? The survey record itself stays in Survey Records.',
                    'Delete notification?',
                    'Yes, delete',
                    function () { dismissOne(item.id); }
                );
            });
            actions.appendChild(del);

            wrap.appendChild(row);
            wrap.appendChild(actions);
            return wrap;
        }

        // Shared shape for "there is nothing to list" and "we could not
        // reach the server" — same layout, different words, so neither one
        // looks like a broken version of the other.
        function renderPlaceholder(icon, title, sub) {
            list.innerHTML = '';
            var wrap = document.createElement('div');
            wrap.className = 'notif-placeholder';

            var ring = document.createElement('span');
            ring.className = 'notif-placeholder-icon';
            ring.innerHTML = '<i class="' + icon + '"></i>';

            var head = document.createElement('p');
            head.className = 'notif-placeholder-title';
            head.textContent = title;

            var note = document.createElement('p');
            note.className = 'notif-placeholder-sub';
            note.textContent = sub;

            wrap.appendChild(ring);
            wrap.appendChild(head);
            wrap.appendChild(note);
            list.appendChild(wrap);
        }

        // Counts the rows actually marked new, so the chip and the NEW tags
        // beside the rows can never disagree.
        function setHeadCount(newRows) {
            if (!headCount) return;
            if (newRows > 0) {
                headCount.textContent = newRows === 1 ? '1 new' : newRows + ' new';
                headCount.hidden = false;
            } else {
                headCount.hidden = true;
            }
        }

        function renderList(items) {
            lastItems = items || [];
            reconcileReadState();

            var kept = lastItems.filter(function (item) { return !isDismissed(item); });
            var unreadCount = kept.filter(isUnread).length;
            var visible = activeFilter === 'unread' ? kept.filter(isUnread) : kept;

            if (unreadCountEl) {
                unreadCountEl.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
                unreadCountEl.classList.toggle('is-zero', unreadCount === 0);
            }
            if (clearAllBtn) clearAllBtn.disabled = kept.length === 0;
            if (markAllBtn) markAllBtn.disabled = unreadCount === 0;

            if (visible.length === 0) {
                // The Unread tab empties on its own as rows are read, and that is
                // a good outcome, not an error -- it gets its own wording.
                if (activeFilter === 'unread') {
                    renderPlaceholder(
                        'fas fa-check-double',
                        'No unread notifications',
                        'Everything here has been read. Switch to All to see the full list.'
                    );
                    setHeadCount(0);
                    return;
                }
                // Two different empty states: one for "nothing has come in", one
                // for "you cleared what came in" -- the second must not read as
                // though the surveys themselves went missing.
                if (lastItems.length > 0) {
                    renderPlaceholder(
                        'fas fa-check',
                        'All caught up',
                        'You cleared these notifications. The survey records themselves are untouched -- open them any time from the button below.'
                    );
                } else {
                    renderPlaceholder(
                        'far fa-bell-slash',
                        'Nothing new yet',
                        'Survey responses appear here the moment a client submits one.'
                    );
                }
                setHeadCount(0);
                return;
            }
            list.innerHTML = '';
            visible.forEach(function (item) { list.appendChild(renderRow(item)); });
            setHeadCount(unreadCount);
        }

        function loadNotifications() {
            return fetch('/api/admin/notifications', { headers: { 'Accept': 'application/json' } })
                .then(function (res) {
                    // 401 = this admin's session is gone (timed out, or replaced
                    // by a newer login). Polling on would just repeat the same
                    // failure every 30s, so it stops here; the next ordinary page
                    // request is what redirects to /login.
                    if (res.status === 401) { stopPolling(); return null; }
                    if (!res.ok) return null;
                    return res.json();
                })
                .then(function (data) {
                    if (!data || !data.success) {
                        // Only replace what is on screen if there is nothing
                        // real there yet: a failed BACKGROUND poll must not
                        // wipe a list the admin is currently reading.
                        if (!list.querySelector('.notif-row')) {
                            renderPlaceholder(
                                'fas fa-triangle-exclamation',
                                'Could not load notifications',
                                'The list refreshes on its own every 30 seconds.'
                            );
                            setHeadCount(0);
                        }
                        return;
                    }
                    renderList(data.notifications);
                    setBadge(data.unseenCount);
                })
                .catch(function () {
                    /* offline or a blip — the next poll retries */
                    if (!list.querySelector('.notif-row')) {
                        renderPlaceholder(
                            'fas fa-wifi',
                            'You appear to be offline',
                            'Notifications will load again once the connection is back.'
                        );
                        setHeadCount(0);
                    }
                });
        }

        // Opening the panel is the "seen" event. The badge clears immediately
        // rather than waiting for the round trip, and the rows keep their
        // "new" highlight until the next poll so the admin can still see which
        // ones they just caught up on.
        // The panel is a modal now, so these are modal events on the MODAL
        // element — the dropdown events were fired by the bell itself, which
        // no longer opens anything.
        modal.addEventListener('show.bs.modal', function () {
            bell.classList.add('is-open');
            loadNotifications();
        });
        modal.addEventListener('shown.bs.modal', function () {
            setBadge(0);
            fetch('/api/admin/notifications/seen', {
                method: 'POST',
                headers: { 'Accept': 'application/json' }
            }).catch(function () { /* the watermark just stays where it is */ });
        });
        modal.addEventListener('hidden.bs.modal', function () {
            bell.classList.remove('is-open');
        });

        // One asking-first path for every destructive action here. AppAlert is
        // loaded by layout/footer.ejs, below this partial, so it is looked up at
        // click time rather than captured now; if it somehow is not there, the
        // browser's own confirm still asks.
        function confirmThen(message, title, confirmText, run) {
            if (window.AppAlert && AppAlert.confirm) {
                AppAlert.confirm(message, { title: title, confirmText: confirmText, danger: true })
                    .then(function (ok) { if (ok) run(); });
            } else if (window.confirm(message)) {
                run();
            }
        }

        if (clearAllBtn) {
            clearAllBtn.addEventListener('click', function () {
                confirmThen(
                    'Clear all notifications from your bell? The survey records themselves stay exactly where they are.',
                    'Clear all notifications?',
                    'Yes, clear all',
                    dismissAll
                );
            });
        }

        if (markAllBtn) {
            markAllBtn.addEventListener('click', markAllRead);
        }

        // All / Unread. Purely a view over what is already loaded, so switching
        // tabs costs no request and never changes what is stored.
        filterBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                activeFilter = btn.dataset.filter === 'unread' ? 'unread' : 'all';
                filterBtns.forEach(function (other) {
                    var on = other === btn;
                    other.classList.toggle('is-active', on);
                    other.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                renderList(lastItems);
            });
        });

        loadNotifications();
        pollTimer = setInterval(loadNotifications, POLL_MS);

        // A backgrounded tab's interval is throttled by the browser, so its
        // badge can be minutes stale by the time the admin looks at it again.
        // Refreshing on the way back makes it current at the moment it's read.
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden && pollTimer) loadNotifications();
        });
    })();

    // Ticks the "Hours" cell of whichever admin_logs row is still active
    // (no logout_time yet) every second, computed off the real login instant.
    (function () {
        function formatLiveDuration(totalSeconds) {
            const hrs = Math.floor(totalSeconds / 3600);
            const mins = Math.floor((totalSeconds % 3600) / 60);
            const secs = totalSeconds % 60;
            return hrs > 0
                ? `${hrs}h ${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`
                : `${String(mins).padStart(2, '0')}m ${String(secs).padStart(2, '0')}s`;
        }

        function tickLiveDurations() {
            document.querySelectorAll('.live-duration').forEach(el => {
                const loginTime = new Date(el.dataset.login).getTime();
                const totalSeconds = Math.max(0, Math.floor((Date.now() - loginTime) / 1000));
                el.textContent = formatLiveDuration(totalSeconds);
            });
        }

        tickLiveDurations();
        setInterval(tickLiveDurations, 1000);
    })();

    // Exports the currently-listed Admin Access Logs (same rows shown in the modal) to a CSV file.
    function exportAdminLogs() {
        const table = document.getElementById('adminLogsTable');
        if (!table) return;

        const rows = table.querySelectorAll('tr');
        const csv = [];

        rows.forEach(row => {
            const cells = row.querySelectorAll('th, td');
            const rowData = Array.from(cells).map(cell => {
                let text = cell.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim();
                text = text.replace(/"/g, '""');
                return `"${text}"`;
            });
            csv.push(rowData.join(','));
        });

        const csvFile = new Blob([csv.join('\n')], { type: 'text/csv' });
        const downloadLink = document.createElement('a');
        const stamp = new Date().toISOString().slice(0, 10);
        downloadLink.download = `Admin_Access_Logs_${stamp}.csv`;
        downloadLink.href = window.URL.createObjectURL(csvFile);
        downloadLink.style.display = 'none';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
    }

    // Confirm before logging an admin out. This was the only one of the
    // app's three logout buttons with NO confirmation — the office panel
    // (office-approvals/office-history) and the client survey both ask
    // first, so a single stray click in this dropdown ended an admin's
    // session outright while the same click elsewhere did not.
    //
    // Bound on DOMContentLoaded because this partial is rendered in the
    // body but alerts.js is loaded by layout/footer.ejs further down, so
    // AppAlert does not exist yet at parse time. The link keeps its real
    // href, so if this script never runs the button still works — it just
    // logs out without asking, exactly as it did before.
    document.addEventListener('DOMContentLoaded', function () {
        var adminLogoutBtn = document.getElementById('adminLogoutBtn');
        if (!adminLogoutBtn || !window.AppAlert) return;
        adminLogoutBtn.addEventListener('click', function (e) {
            e.preventDefault();
            var href = adminLogoutBtn.getAttribute('href');
            AppAlert.confirm('Are you sure you want to logout?', {
                title: 'Logout?',
                confirmText: 'Yes, logout',
                danger: false
            }).then(function (confirmed) {
                if (confirmed) window.location.href = href;
            });
        });
    });
</script>
