                        <div class="step-label">Terms</div>
                    </div>
                    <div class="progress-step" data-step="2">
                        <div class="step-dot"><span>2</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Client Info</div>
                    </div>
                    <div class="progress-step" data-step="3">
                        <div class="step-dot"><span>3</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Citizen's Charter</div>
                    </div>
                    <div class="progress-step" data-step="4">
                        <div class="step-dot"><span>4</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">SQD Rating</div>
                    </div>
                    <div class="progress-step" data-step="5">
                        <div class="step-dot"><span>5</span><i class="bi bi-check-lg"></i></div>
                        <div class="step-label">Review</div>
                    </div>
                </div>
            </div>

            <form id="surveyForm">

                <div id="stage1" class="page active">
                    <div class="qa-block p-4 text-center mb-4">
                        <h4 class="fw-semibold text-heading mb-3" data-i18n="s1_head">Help us serve you better!</h4>
                        <p class="text-secondary mb-0 fs-6 mobile-section-desc" data-i18n="s1_desc"></p>
                    </div>

                    <div id="terms-box" class="mb-4 bg-white border rounded-4 p-4">
