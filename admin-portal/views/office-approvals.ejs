<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <style>
        body {
            background: #f1f5f9;
            font-family: 'Plus Jakarta Sans', sans-serif;
            min-height: 100vh;
        }

        .topbar {
            background: linear-gradient(135deg, #0a1f44, #12305c);
            color: #ffffff;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 14px -4px rgba(0,0,0,0.3);
        }
        .topbar h1 {
            font-size: 1.1rem;
            font-weight: 700;
            margin: 0;
        }
        .topbar .sub {
            font-size: 0.75rem;
            color: #cbd5e1;
        }
        .btn-logout {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.35);
            color: #fff;
            border-radius: 50px;
            padding: 0.4rem 1rem;
            font-size: 0.82rem;
            font-weight: 600;
            text-decoration: none;
        }
        .btn-logout:hover { background: rgba(255,255,255,0.22); color: #fff; }

        .content-wrap {
            max-width: 960px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .approval-card {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 8px 24px -10px rgba(15, 23, 42, 0.15);
            padding: 1.25rem 1.5rem;
            margin-bottom: 1rem;
        }

        .approval-meta-label {
            font-size: 0.68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #94a3b8;
            margin-bottom: 0.15rem;
        }
        .approval-meta-value {
            font-size: 0.92rem;
            color: #0f172a;
            font-weight: 600;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 1rem;
            color: #64748b;
        }
        .empty-state i { font-size: 2.5rem; color: #94a3b8; margin-bottom: 1rem; }
    </style>
</head>
<body>

    <div class="topbar">
        <div>
            <h1><i class="fas fa-clipboard-check me-2"></i> Survey Approvals</h1>
            <div class="sub"><%= officeName %></div>
        </div>
        <a href="/office-logout" class="btn-logout"><i class="fas fa-sign-out-alt me-1"></i> Logout</a>
    </div>

    <div class="content-wrap">
        <% if (!submissions || submissions.length === 0) { %>
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p class="mb-0 fw-semibold">No pending submissions right now.</p>
                <p class="mb-0" style="font-size: 0.85rem;">New personal-email survey submissions for your office will show up here for verification.</p>
            </div>
        <% } else { %>
            <% submissions.forEach(function(sub) { %>
                <div class="approval-card">
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="approval-meta-label">Respondent</div>
                            <div class="approval-meta-value"><%= sub.respondentName %></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="approval-meta-label">Service Availed</div>
                            <div class="approval-meta-value"><%= sub.serviceAvailed || 'Not specified' %></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="approval-meta-label">Office Visited Time</div>
                            <div class="approval-meta-value"><%= sub.officeVisitedTime || '—' %></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="approval-meta-label">Submitted</div>
                            <div class="approval-meta-value"><%= new Date(sub.createdAt).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
                        </div>
                        <div class="col-12">
                            <div class="approval-meta-label">Google Account</div>
                            <div class="approval-meta-value"><%= sub.googleEmail %></div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <form action="/office-approvals/<%= sub.id %>/approve" method="POST" class="m-0">
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fas fa-check me-1"></i> Approve
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="collapse" data-bs-target="#declineForm<%= sub.id %>">
                            <i class="fas fa-times me-1"></i> Decline
                        </button>
                    </div>

                    <div class="collapse mt-2" id="declineForm<%= sub.id %>">
                        <form action="/office-approvals/<%= sub.id %>/decline" method="POST" class="d-flex gap-2">
                            <input type="text" name="decline_reason" class="form-control form-control-sm" placeholder="Reason (optional)" maxlength="255">
                            <button type="submit" class="btn btn-danger btn-sm text-nowrap">Confirm Decline</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
