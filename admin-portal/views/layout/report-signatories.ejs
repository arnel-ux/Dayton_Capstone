<%
/* Shared bottom section for the PER CLUSTER-style official report (dashboard.ejs's
   report modal, print.ejs): Prepared by / Reviewed by / Noted by signature
   blocks in a 2-column grid (Prepared left, Reviewed right, Noted below
   Prepared, nothing below Reviewed), then the Interpretation of Results
   legend below that — per the user's explicit instruction that the
   signatories sit above the legend here (unlike the SQD report's own footer,
   views/layout/sqd-report-footer.ejs, which puts its legend first).
   These are CSPC's existing official CQA report signatories, already used
   identically on report.ejs / cluster-detail.ejs / survey-records.ejs.
   `showInterpretationLegend` (default true) hides the legend for a report that
   never prints a score/interpretation to begin with — e.g. Summary of Respondents,
   which only counts respondents and has nothing for the 95/90/80/60 scale to
   explain. */
const _showLegend = typeof showInterpretationLegend === 'undefined' || showInterpretationLegend;
%>
<div class="cluster-report-signatures">
    <div class="sig-cell sig-prepared">
        <p class="sig-label">Prepared by:</p>
        <div class="sig-space"></div>
        <p class="sig-name">JUVY M. BUSTAMANTE, JD</p>
        <p class="sig-title">AOV-CQA</p>
    </div>
    <div class="sig-cell sig-reviewed">
        <p class="sig-label">Reviewed by:</p>
        <div class="sig-space"></div>
        <p class="sig-name">JOCELYN O. JINTALAN, DBA</p>
        <p class="sig-title">ISO Chair</p>
    </div>
    <div class="sig-cell sig-noted">
        <p class="sig-label">Noted by:</p>
        <div class="sig-space"></div>
        <p class="sig-name">AMADO A. OLIVA JR., PhD</p>
        <p class="sig-title">SUC President III</p>
    </div>
</div>
<% if (_showLegend) { %>
    <div class="cluster-interpretation-standalone">
        <%- include('interpretation-legend') %>
    </div>
<% } %>
