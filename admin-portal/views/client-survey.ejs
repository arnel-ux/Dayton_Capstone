<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSM Survey - CSPC</title>
    <% if (!offlineMode) { %>
    <script>
        // New-tab auto-login guard: 'client.sid' is a normal browser cookie, so a
        // brand new tab that merely inherited it (typed the URL, duplicated the
        // tab, opened a bookmark) would otherwise land here fully "logged in"
        // without ever having signed in in THAT tab. sessionStorage is scoped per
        // tab (never copied to a freshly opened one), so it's used here purely as
        // a "did this tab actually authenticate" marker: every login flow's
        // redirect tags this page's very next load with ?loggedin=1, which this
        // script converts into the marker before the URL is cleaned up. Loading
        // this page in a tab without that marker bounces straight back to /login.
        // Note: this is a client-side UX guard, not a security boundary — the
        // page markup briefly reaches the browser before this (first) script
        // redirects it away, so it doesn't stop someone with devtools/view-source
        // open on that same already-logged-in machine.
        //
        // Gated to the authenticated (!offlineMode) render only — this same
        // template is also rendered unauthenticated at /survey-offline
        // (offlineMode: true, see server.js), which intentionally has no
        // session and no ?loggedin=1 redirect to ever tag a tab with. Running
        // this guard there unconditionally redirected every offline-survey
        // visit straight to /login?error=..., including while genuinely
        // offline (surfacing as ERR_FAILED, since that URL was never
        // precached and the query string keeps it from matching the cached
        // '/login' entry) — this EJS-level gate is evaluated at render time,
        // before any client-side OFFLINE_MODE constant exists, so it's the
        // only reliable place to keep this script off the public page.
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.has('loggedin')) {
                    sessionStorage.setItem('cqa_client_tab_ok', '1');
                    params.delete('loggedin');
                    var cleanedSearch = params.toString();
                    var cleanedUrl = window.location.pathname + (cleanedSearch ? '?' + cleanedSearch : '') + window.location.hash;
                    window.history.replaceState({}, '', cleanedUrl);
                } else if (sessionStorage.getItem('cqa_client_tab_ok') !== '1') {
                    window.location.replace('/login?error=' + encodeURIComponent('Please log in to continue.'));
                }
            } catch (e) { /* sessionStorage unavailable (privacy mode, etc.) — fail open */ }
        })();
    </script>
    <script>window.__idleLogoutUrl = '/logout?scope=client';</script>
    <script src="/js/idle-logout.js"></script>
    <% } %>
    <script>
        (function () {
            try {
                if (localStorage.getItem('theme') === 'dark') {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>

    <!-- Deliberately no <link rel="manifest">: this project must stay a
         plain website, never an installable PWA (no "Add to Home Screen" /
         install prompt). The service worker below still provides offline
         caching — that's independent of installability, manifest.json is
         what Chrome/Edge actually key the install criteria on. -->
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="/js/offline-db.js"></script>
    <script src="/js/pwa-client.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            /* Brand + neutral palette — refined institutional blue on slate neutrals */
            --bs-primary: #2554c7;
            --bs-primary-rgb: 37, 84, 199;
            --brand: #2554c7;
            --brand-dark: #1c3f9c;
            --brand-light: #4d7ce8;
            --accent: #d4af37;
            --ink-900: #0f172a;
            --ink-800: #1e293b;
            --ink-600: #475569;
            --ink-400: #94a3b8;
            --surface: #ffffff;
            --page-bg: #eef1f6;
            --line: #e2e8f0;
            --line-soft: #edf1f7;
            --ring: rgba(37, 84, 199, 0.15);
            --sidebar-w: 272px;
            --topbar-h: 72px;
            --shadow-soft: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px -12px rgba(15,23,42,.10);
            --shadow-lift: 0 4px 10px -4px rgba(15,23,42,.10), 0 24px 48px -20px rgba(15,23,42,.18);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            scroll-behavior: smooth;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            color: var(--ink-800);
            transition: color 0.3s ease-in-out;
        }

        /* ---- Fixed, blurred campus backdrop (same treatment as the public
           landing page) sitting behind the whole app shell ---- */
        .survey-bg-image {
            position: fixed; inset: 0; z-index: -2;
            /* The CSPC monument sits in the upper half of this photo — on a
               tall mobile viewport, centering it vertically cropped the
               monument almost entirely out of frame. Anchoring to the top
               keeps it in view. */
            background: url('/images/campus-monument.jpg') top center/cover no-repeat;
        }
        .survey-bg-overlay {
            position: fixed; inset: 0; z-index: -1;
            background: linear-gradient(180deg, rgba(15,23,42,0.55) 0%, rgba(10,20,40,0.75) 100%);
        }
        [data-bs-theme="dark"] .survey-bg-overlay {
            background: linear-gradient(180deg, rgba(4,8,18,0.78) 0%, rgba(37, 29, 58,0.88) 100%);
        }

        /* =========================================================
           DASHBOARD SHELL — sidebar + topbar + content
        ========================================================= */
        .app-shell { display: flex; min-height: 100vh; }

        .sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: linear-gradient(190deg, #131c30 0%, var(--ink-900) 55%, #0c1424 100%);
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 1040;
            box-shadow: 4px 0 24px -8px rgba(0,0,0,0.25);
            transition: transform 0.3s ease;
            /* Anchored via top+bottom (not a fixed height), so it already
               tracks the real visual viewport as mobile browser chrome
               shows/hides. overflow-y lets the nav list + footer scroll as a
               unit instead of clipping on a short landscape phone. */
            overflow-y: auto;
        }
        [data-bs-theme="dark"] .sidebar { background: linear-gradient(190deg, #0d1524 0%, #0a101c 55%, #070c16 100%); }

        .sidebar-brand {
            display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.85rem;
            padding: 2.1rem 1.5rem 1.85rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .sidebar-brand-logo-wrap {
            width: 96px; height: 96px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .sidebar-brand img {
            width: 100%; height: 100%; object-fit: contain; display: block;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.35));
        }
        .sidebar-brand-text { line-height: 1.4; }
        .sidebar-brand-text .t1 { font-size: 1.14rem; font-weight: 800; color: #fff; letter-spacing: 0.3px; }
        .sidebar-brand-text .t2 { font-size: 0.82rem; color: #8996ac; margin-top: 0.25rem; }

        .sidebar-nav { flex-grow: 1; padding: 1.5rem 1rem; display: flex; flex-direction: column; gap: 0.3rem; }
        .sidebar-nav-label {
            font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em;
            color: #5b6a85; padding: 0 0.9rem; margin-bottom: 0.6rem;
        }
        .sidebar-nav .nav-item-link {
            display: flex; align-items: center; gap: 0.85rem;
            padding: 0.72rem 0.95rem; border-radius: 11px;
            color: #b6c0d4; text-decoration: none; font-weight: 600; font-size: 0.9rem;
            position: relative;
            transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
        }
        .sidebar-nav .nav-item-link i { font-size: 1.05rem; width: 20px; text-align: center; }
        .sidebar-nav .nav-item-link:hover:not(.disabled) { background: rgba(255,255,255,0.07); color: #fff; transform: translateX(2px); }
        .sidebar-nav .nav-item-link.active {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff; box-shadow: 0 8px 20px -8px rgba(37,84,199,0.8);
        }
        .sidebar-nav .nav-item-link.disabled { color: #55627a; cursor: not-allowed; }
        .sidebar-nav .soon-badge {
            margin-left: auto; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.3px;
            background: rgba(148,163,184,0.15); color: #94a3b8; padding: 0.15rem 0.5rem; border-radius: 50px;
        }

        .sidebar-footer { padding: 1.1rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom, 0px)); border-top: 1px solid rgba(255,255,255,0.08); }
        .sidebar-footer .signed-in-email {
            font-size: 0.72rem; color: #8996ac; margin-bottom: 0.75rem; word-break: break-all;
            display: flex; align-items: center; gap: 0.4rem;
            background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px; padding: 0.55rem 0.7rem;
        }
        .sidebar-footer .btn-logout-side {
            width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
            background: rgba(239,68,68,0.12); color: #fca5a5; border: 1px solid rgba(239,68,68,0.25);
            border-radius: 11px; padding: 0.6rem; font-weight: 600; font-size: 0.82rem; transition: all 0.15s ease;
        }
        .sidebar-footer .btn-logout-side:hover { background: rgba(239,68,68,0.22); color: #fecaca; transform: translateY(-1px); }

        .sidebar-backdrop {
            display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.55);
            z-index: 1035; backdrop-filter: blur(2px);
        }

        .main-content {
            flex-grow: 1; min-width: 0; margin-left: var(--sidebar-w); display: flex; flex-direction: column;
            transition: margin-left 0.35s cubic-bezier(.4,0,.2,1);
        }

        /* Persistent desktop sidebar collapse — same slide-away transform as the
           mobile overlay, but without the backdrop, and it reclaims the space
           instead of overlaying content (so the survey can go truly full-screen). */
        .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
        .app-shell.sidebar-collapsed .main-content { margin-left: 0; }

        .topbar {
            position: sticky; top: 0; z-index: 1020;
            min-height: var(--topbar-h);
            background: var(--surface);
            border-bottom: 1px solid var(--line-soft);
            box-shadow: 0 1px 0 rgba(15,23,42,0.02), 0 6px 18px -14px rgba(15,23,42,0.25);
            display: flex; align-items: center; gap: 1.1rem;
            padding: 0.6rem 1.5rem;
            backdrop-filter: saturate(1.1);
        }
        .topbar-hamburger, .btn-sidebar-toggle {
            display: none; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 11px; border: 1px solid var(--line);
            background: var(--surface); color: var(--ink-800); font-size: 1.1rem;
            transition: all 0.2s ease; flex-shrink: 0;
        }
        .btn-sidebar-toggle { display: inline-flex; }
        .btn-sidebar-toggle:hover { border-color: var(--brand); color: var(--brand); background: var(--ring); }
        .topbar-title { font-weight: 700; color: var(--ink-900); font-size: 1.05rem; margin: 0; letter-spacing: -.01em; }
        .topbar-title small { display: block; font-weight: 500; font-size: 0.72rem; color: var(--ink-600); margin-top: 0.1rem; }
        /* Notification bell + fullscreen. margin-left:auto pushes this (and
           everything after it — .topbar-row2's contents-promoted children,
           see below) to the topbar's right edge, same as the old
           .topbar-actions did. On mobile this group stays put on row 1 —
           it's the one thing that must never drop to row 2 (see the
           ≤576px rules), so nothing there overrides its position, only its
           icon sizing. */
        .topbar-icon-group { margin-left: auto; display: flex; align-items: center; gap: 0.7rem; }
        /* Desktop/default: behaves as if its children (offline pill, language
           toggle) were direct topbar items — i.e. exactly the pre-existing
           desktop look, just reachable through one wrapper instead of two
           separate siblings. Only the ≤576px rule below turns this into a
           real second row. */
        .topbar-row2 { display: contents; }
        .lang-toggle-group { display: flex; gap: 0.4rem; background: var(--page-bg); border: 1px solid var(--line-soft); padding: 0.25rem; border-radius: 50px; }
        .lang-toggle-group .btn { border-radius: 50px !important; padding: 0.35rem 0.9rem; }
        .lang-toggle-group .lang-btn-short { display: none; }

        .btn-fullscreen {
            display: inline-flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 11px;
            border: 1px solid var(--line); background: var(--surface); color: var(--ink-800);
            font-size: 1rem; transition: all 0.2s ease;
        }
        .btn-fullscreen:hover { border-color: var(--brand); color: var(--brand); transform: translateY(-1px); background: var(--ring); }
        .btn-fullscreen:active { transform: translateY(0) scale(0.94); }

        /* Persistent "you're viewing offline" pill — shown in the topbar
           whenever navigator.onLine is false (see updateOfflineIndicator()
           below). Amber, not red: being offline here is a supported,
           expected mode (autosave + auto-sync), not an error state. */
        .offline-pill {
            display: none;
            align-items: center;
            gap: 0.4rem;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }
        [data-bs-theme="dark"] .offline-pill { background: rgba(245,158,11,0.16); color: #fbbf24; border-color: rgba(245,158,11,0.35); }
        .offline-pill.is-visible { display: inline-flex; }
        .offline-pill .dot {
            width: 7px; height: 7px; border-radius: 50%; background: #d97706; flex: none;
            animation: offlinePulse 1.6s ease-in-out infinite;
        }
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

        /* Green (not amber like .offline-pill): this is good news, not the
           "you're on your own" state the amber pill represents. */
        .back-online-banner {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            border-radius: 14px;
            padding: 0.9rem 1.1rem;
            margin-bottom: 1.25rem;
        }
        [data-bs-theme="dark"] .back-online-banner { background: rgba(16,185,129,0.12); color: #6ee7b7; border-color: rgba(16,185,129,0.35); }
        .back-online-banner-title { font-weight: 700; display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.25rem; }
        .back-online-banner-text { margin: 0 0 0.7rem; font-size: 0.88rem; }
        .back-online-banner-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

        /* =========================================================
           ONLINE-SESSION OFFLINE TRANSITION — see the HTML comment on
           #onlineOfflineTransition for what this is and why it exists.
           z-index sits above everything else in this file (notif panel
           1060, Bootstrap modals ~1055) — once this is up, nothing else
           should be reachable underneath it.
        ========================================================= */
        .offline-transition-overlay {
            position: fixed; inset: 0; z-index: 2000;
            background: rgba(15, 23, 42, 0.72);
            backdrop-filter: blur(3px);
            display: flex; align-items: center; justify-content: center;
            padding: 1.25rem;
            padding-top: calc(1.25rem + env(safe-area-inset-top, 0px));
            padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
        }
        .offline-transition-overlay[hidden] { display: none; }
        .offline-transition-card {
            background: var(--surface); border-radius: 20px;
            padding: 2rem 1.85rem; max-width: 380px; width: 100%;
            text-align: center; box-shadow: 0 30px 60px -15px rgba(0,0,0,0.5);
        }
        .offline-transition-icon {
            width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
            background: rgba(245, 158, 11, 0.14); color: #d97706;
        }
        /* Swapped in once connectivity returns — green reads as "good news
           resolved", distinct from the amber "still waiting" state, matching
           the same amber/green convention already used by .offline-pill and
           .back-online-banner elsewhere in this file. */
        .offline-transition-overlay.is-back-online .offline-transition-icon { background: rgba(16,185,129,0.14); color: #059669; }
        .offline-transition-card h4 { font-weight: 700; margin-bottom: 0.5rem; color: var(--ink-900); }
        .offline-transition-card p { color: var(--ink-600); font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem; }
        .offline-transition-actions { display: flex; flex-direction: column; gap: 0.6rem; }
        .offline-transition-actions .btn { width: 100%; min-height: 44px; }
        [data-bs-theme="dark"] .offline-transition-overlay { background: rgba(4,8,18,0.82); }
        /* Reassurance note — only shown when a real in-progress attempt was
           found (see showOfflineTransition()). A quiet green-tinted strip,
           not another alert box, so it reads as "good news" rather than
           adding a second warning on top of "You're Offline". Kept compact
           on purpose (item 3/54: four buttons is already enough for a
           mobile popup — this must not add real height). */
        .offline-transition-progress-note {
            background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25);
            border-radius: 10px; padding: 0.6rem 0.75rem !important;
            font-size: 0.82rem !important; color: #047857 !important;
            margin-bottom: 1rem !important; line-height: 1.4 !important;
        }
        [data-bs-theme="dark"] .offline-transition-progress-note { background: rgba(16,185,129,0.14); border-color: rgba(16,185,129,0.3); color: #6ee7b7 !important; }
        @media (max-width: 480px) {
            .offline-transition-card { padding: 1.5rem 1.25rem; border-radius: 16px; }
            .offline-transition-icon { width: 48px; height: 48px; font-size: 1.25rem; margin-bottom: 0.85rem; }
            .offline-transition-card h4 { font-size: 1.05rem; }
            .offline-transition-card p { font-size: 0.85rem; margin-bottom: 1.25rem; }
            .offline-transition-progress-note { font-size: 0.78rem !important; padding: 0.5rem 0.65rem !important; }
        }

        /* =========================================================
           NOTIFICATION BELL + PANEL — authenticated client pages only
        ========================================================= */
        .notif-bell-wrap { position: relative; }
        .notif-unread-badge {
            position: absolute; top: -2px; right: -2px;
            background: #dc3545; color: #fff; border-radius: 999px;
            font-size: 0.65rem; font-weight: 700; line-height: 1;
            min-width: 16px; height: 16px; padding: 0 3px;
            display: flex; align-items: center; justify-content: center;
        }
        /* Root cause of "the panel gets cut off": .topbar is `position:
           sticky` + `z-index:1020`, which makes it a stacking-context
           boundary — every descendant's z-index (including this panel's,
           however high) is only ever compared to OTHER children of
           .topbar. From outside .topbar, the whole subtree behaves as a
           single unit stacked at z-index:1020, so any sibling of .topbar
           elsewhere in the page that happens to paint after it, or any
           ancestor between .notif-bell-wrap and the page that constrains
           overflow, can still cover or clip it regardless of this panel's
           own z-index number. toggleNotificationPanel() (below, in the
           script section) now portals this element to a direct child of
           <body> the first time it opens and positions it with `position:
           fixed` + inline top/right computed from the bell's real
           on-screen rect — that removes it from .topbar's stacking context
           entirely and from any ancestor's layout/overflow, rather than
           just raising a number and hoping. Base position/right/top here
           are only the pre-JS/no-JS fallback. */
        .notif-panel {
            /* Static fallback only (JS always overrides top/right inline
               the instant it opens — see positionNotifPanel()). Percentage
               offsets don't make sense once this is `position: fixed`
               (they'd resolve against the viewport, not the bell), so this
               is just a reasonable "somewhere under the topbar" default. */
            position: fixed; top: 70px; right: 16px;
            width: 360px; max-width: calc(100vw - 2rem);
            max-height: 70vh; max-height: 70dvh; overflow-y: auto;
            background: var(--bs-body-bg, #fff); color: var(--bs-body-color, #1f2937);
            border: 1px solid rgba(0,0,0,0.1); border-radius: 14px;
            box-shadow: 0 24px 48px -16px rgba(10,20,40,0.35);
            z-index: 1060;
        }
        .notif-panel-header {
            display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem;
            padding: 0.85rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.08);
        }
        .notif-panel-header-actions { display: flex; gap: 0.75rem; font-size: 0.8rem; }
        .notif-list { padding: 0.25rem 0; }
        .notif-item { display: flex; gap: 0.6rem; padding: 0.7rem 1rem; border-bottom: 1px solid rgba(0,0,0,0.05); align-items: flex-start; }
        .notif-item.is-unread { background: rgba(37,84,199,0.06); }
        .notif-item-dot { width: 8px; height: 8px; border-radius: 50%; background: #2554c7; margin-top: 0.4rem; flex: none; }
        .notif-item.is-unread .notif-item-dot { visibility: visible; }
        .notif-item:not(.is-unread) .notif-item-dot { visibility: hidden; }
        .notif-item-body { flex: 1 1 auto; min-width: 0; }
        .notif-item-title { font-weight: 600; font-size: 0.88rem; word-break: break-word; }
        .notif-item-message { font-size: 0.82rem; color: #6b7280; margin: 0.15rem 0; word-break: break-word; }
        .notif-item-time { font-size: 0.72rem; color: #9ca3af; }
        .notif-item-delete { background: none; border: none; color: #9ca3af; padding: 0.25rem; flex: none; min-width: 32px; min-height: 32px; }
        .notif-item-delete:hover { color: #dc3545; }
        .notif-empty { padding: 2rem 1rem; text-align: center; color: #9ca3af; font-size: 0.85rem; }

        @media (max-width: 480px) {
            /* Was previously a bottom sheet (bottom:0/left:0/right:0) — that
               read as disconnected from the bell it opened from and didn't
               match the rest of this app's anchored-popover interactions.
               Anchored near the top instead, just under the mobile topbar,
               horizontally centered so it doesn't hug either edge. See
               positionNotifPanel() — it clears any inline top/right/left
               left over from a wider viewport at this breakpoint so these
               values are the ones that actually apply. */
            .notif-panel {
                position: fixed;
                top: calc(var(--topbar-h) + 10px); bottom: auto;
                left: 50%; right: auto; transform: translateX(-50%);
                width: calc(100vw - 24px); max-width: 420px;
                max-height: calc(100dvh - var(--topbar-h) - 24px);
                border-radius: 16px;
            }
        }

        .content-body { padding: 2rem 1.75rem 3.5rem; flex-grow: 1; }

        /* This outer wrapper's own padding was never reduced for Home/
           Profile/History (only the survey view's :has() override below
           touches it) — 32px top / 28px sides / 56px bottom of desktop
           padding around EVERY view on a 375px phone, on top of whatever
           padding each view's own card already has. That's real, visible
           dead space contributing to the "everything is oversized" feel
           independent of any single card's own sizing. */
        @media (max-width: 767.98px) {
            .content-body { padding: 1.5rem 1.1rem 2.25rem; }
        }
        @media (max-width: 575.98px) {
            .content-body { padding: 1rem 0.85rem 1.75rem; }
        }

        /* =========================================================
           SPA VIEW SWITCHING — Take Survey / Profile / History
        ========================================================= */
        .app-view { display: none; }
        .app-view.active { display: block; animation: fadeIn .4s ease; }

        .view-card {
            border-radius: 22px;
            background: rgba(255,255,255,0.88) !important;
            backdrop-filter: blur(22px) saturate(140%);
            -webkit-backdrop-filter: blur(22px) saturate(140%);
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 24px 60px -20px rgba(10,20,40,0.5);
            max-width: 900px;
            margin: 0 auto;
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        [data-bs-theme="dark"] .view-card {
            background: rgba(15,23,42,0.82) !important;
            border-color: rgba(255,255,255,0.08);
            box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5);
        }

        /* ---- Home view — landing screen shown right after login ---- */
        .home-card { max-width: 1100px; position: relative; overflow: hidden; }
        .home-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
            background: linear-gradient(90deg, var(--brand-dark), var(--brand), var(--accent), var(--brand-light));
            background-size: 200% 100%; animation: heroBarShift 8s linear infinite;
        }
        @media (prefers-reduced-motion: reduce) { .home-card::before { animation: none; } }
        .home-hero { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line-soft); }
        .home-hero .survey-hero-logo { width: 72px; height: 72px; }

        /* ---- Brand intro — round CSPC mark pops in dead-center, then the
           name slides up into frame beneath it (~1s total), before the
           subtitle settles in ---- */
        .brand-intro {
            display: flex; flex-direction: column; align-items: center; text-align: center; margin: 0 auto;
        }
        .brand-intro-mark {
            opacity: 0;
            animation: brandMarkPop 0.35s cubic-bezier(.34,1.56,.64,1) forwards;
        }
        .brand-intro-name {
            opacity: 0; margin-top: 0.75rem;
            animation: brandNameSlide 0.4s ease-out forwards;
            animation-delay: 0.18s;
        }
        .brand-intro-name .survey-hero-eyebrow { justify-content: center; }
        @keyframes brandMarkPop {
            0% { opacity: 0; transform: scale(.5) rotate(-10deg); }
            65% { opacity: 1; transform: scale(1.08) rotate(2deg); }
            100% { opacity: 1; transform: scale(1) rotate(0deg); }
        }
        @keyframes brandNameSlide {
            0% { opacity: 0; transform: translateY(16px); }
            100% { opacity: 1; transform: translateY(0); }
        }
        .home-subtitle-anim {
            opacity: 0;
            animation: homeFadeUp 0.3s ease-out forwards;
            animation-delay: 0.55s;
        }
        @media (prefers-reduced-motion: reduce) {
            .brand-intro-mark, .brand-intro-name, .home-subtitle-anim { animation: none; opacity: 1; }
        }

        .home-info-card {
            height: 100%; position: relative; overflow: hidden;
            background: #f8fafc; border: 1px solid var(--line); border-left: 4px solid var(--brand);
            border-radius: 16px; padding: 1.75rem;
            box-shadow: 0 6px 18px -14px rgba(15,23,42,0.25);
            transition: box-shadow .25s ease, transform .25s ease, border-color .25s ease;
        }
        .home-info-card:hover {
            box-shadow: 0 14px 34px -16px rgba(37,84,199,0.4);
            transform: translateY(-4px);
            border-left-color: var(--accent);
        }
        [data-bs-theme="dark"] .home-info-card { background: #101827; border-left-color: var(--brand-light); }
        .home-info-icon {
            width: 48px; height: 48px; border-radius: 12px; margin-bottom: 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
            background: var(--ring); color: var(--brand);
            transition: transform .3s ease, background .3s ease, color .3s ease;
        }
        .home-info-card:hover .home-info-icon {
            transform: scale(1.1) rotate(-4deg);
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff;
        }
        .home-info-card h5 { font-weight: 700; color: var(--ink-900); margin-bottom: 0.6rem; }
        .home-info-card p { color: var(--ink-600); font-size: 0.92rem; line-height: 1.65; margin-bottom: 0; }

        .home-feature-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
        .home-feature-chip {
            display: inline-flex; align-items: center; gap: 0.4rem;
            font-size: 0.72rem; font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 50px;
            background: var(--ring); color: var(--brand);
            transition: transform .2s ease, background .2s ease, color .2s ease;
        }
        .home-feature-chip:hover {
            background: var(--brand); color: #fff; transform: translateY(-2px);
        }
        [data-bs-theme="dark"] .home-feature-chip { background: rgba(96,141,255,0.15); }

        /* ---- Entrance animation — staggered fade + rise for hero and cards ---- */
        .home-anim { opacity: 0; animation: homeFadeUp .25s ease-out forwards; }
        @keyframes homeFadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @media (prefers-reduced-motion: reduce) { .home-anim { animation: none; opacity: 1; } }

        /* ---- Responsive tuning for smaller screens ---- */
        @media (max-width: 767.98px) {
            .home-hero .survey-hero-logo { width: 60px; height: 60px; }
            .home-hero h2 { font-size: 1.5rem; }
            .home-info-card { padding: 1.35rem; }
        }
        @media (max-width: 575.98px) {
            /* Density pass: 24px/17.6px outer card padding was still in the
               "24-40px oversized mobile card" range this pass targets —
               brought down to the 10-14px ordinary-card norm. */
            .home-card > .card-body { padding: 0.85rem 0.75rem !important; }
            .home-feature-row { gap: 0.4rem; }
            .home-feature-chip { font-size: 0.68rem; padding: 0.35rem 0.65rem; }

            /* A second visual pass found Home still reading as "one heading,
               one paragraph, one oversized card per screen" even with the
               reductions above. The actual driver: the CQA/CSM body
               paragraphs are long institutional text, and paragraph height
               for wrapped text scales with roughly font-size squared (fewer
               chars fit per line at a bigger size, AND each of those extra
               lines is itself taller) — so the 0.92rem/1.65 line-height
               those paragraphs used cost far more height than it looks like
               on a size chart. Trimmed the whole hero+card rhythm down a
               notch instead of just the outer card shell. */
            .home-hero { padding-bottom: 1rem; }
            .home-hero .survey-hero-logo { width: 48px; height: 48px; }
            /* Hero heading/subtitle and the About-card heading/body text had
               all been pushed UNDER their target ranges by the earlier
               compaction passes (20px/13.4px/15.7px/13.1px against
               22-26/14-16/17-19/14-16px targets) — nudged back up into range
               here; the icon (36px, under the 38-44px target) too. Layout
               spacing (padding/margins/gaps) stays as this pass already
               tuned it — only these five undersized text/icon rules move. */
            .home-hero h2 { font-size: 1.4rem; }
            .home-hero .survey-hero-eyebrow { font-size: 0.62rem; margin-bottom: 0.2rem; }
            .home-hero p.home-subtitle-anim { font-size: 0.9rem; line-height: 1.45; margin-top: 0.6rem !important; }
            #view-home .mb-5 { margin-bottom: 0.9rem !important; }
            #view-home .row.g-4 { --bs-gutter-y: 0.6rem; --bs-gutter-x: 0.6rem; }
            .home-info-card { padding: 0.625rem; }
            .home-info-icon { width: 33px; height: 33px; font-size: 0.9rem; margin-bottom: 0.4rem; border-radius: 9px; }
            .home-info-card h5 { font-size: 0.975rem; margin-bottom: 0.3rem; }
            .home-info-card p { font-size: 0.83rem; line-height: 1.4; }
            .home-feature-row { margin-top: 0.7rem; }
        }

        /* =========================================================
           SHARED MOBILE BODY-DESCRIPTION TYPOGRAPHY
           =========================================================
           Root cause of "Help Us Serve You Better" reading larger than
           Terms & Conditions on mobile: the two paragraphs never shared a
           rule. The markup gives them different Bootstrap size utilities to
           start with (fs-6 = 1rem on the qa-block paragraph vs the small
           class = 0.875em on the terms paragraph), and — because each was
           tuned in a separate, later, page-specific mobile pass — they'd
           each picked up their OWN unrelated override: the qa-block
           paragraph got `font-size: 0.85rem` with no line-height override
           (inheriting Bootstrap's body-wide 1.5), while the terms paragraph
           got `font-size: 0.76rem; line-height: 1.42`. Two different
           selectors, two different values, same visual role. Consolidated
           into one shared class both paragraphs now carry, instead of each
           section re-deriving its own number. Headings/bullets/hints keep
           their own sizes on purpose — only the ordinary description-text
           role is unified. */
        @media (max-width: 575.98px) {
            /* Root-cause bug found via real-browser measurement: the
               "Help us serve you better!" paragraph (s1_desc) carries both
               `fs-6` and `mobile-section-desc` in its markup — Bootstrap's
               `.fs-6` utility ships `font-size: 1rem !important`, which
               silently wins over this plain (non-important) rule regardless
               of source order, so that paragraph was STILL rendering at
               16px on a real device — the exact "Help Us Serve You Better
               reads larger than Terms" bug this shared class was written to
               fix, just reintroduced by a utility class neither author
               realized was `!important`. The Terms paragraph never had this
               problem (it uses `.small`, not `.fs-6`, which is why manual
               testing of Terms alone wouldn't have caught it). Needs
               !important itself to actually win. */
            .mobile-section-desc { font-size: 0.84rem !important; line-height: 1.48; }
        }

        /* ---- Terms & Conditions box (stage 1) on phones ----
           #terms-box's Bootstrap p-4 (24px) padding + the bullet list's ps-4
           (24px) indent alone eat ~96px of width on a 320-360px screen
           before any text even starts, and the summary/bullet text at the
           default .small size read as oversized once the box's own padding
           had already shrunk everything else. Bootstrap's utility classes
           ship !important, so the padding/indent overrides need it too. */
        @media (max-width: 575.98px) {
            /* "Help us serve you better!" — the very first thing shown on
               the survey, and still the widest padding + biggest heading on
               the whole step even after the terms-box below it was already
               trimmed. p-4 (24px) is a Bootstrap !important utility, so the
               override needs it too. Its description paragraph's font-size
               now comes from .mobile-section-desc above, not a rule here. */
            #stage1 > .qa-block:first-child { padding: 1rem 0.9rem !important; margin-bottom: 1rem !important; }
            #stage1 > .qa-block:first-child h4 { font-size: 1.1rem; margin-bottom: 0.5rem !important; }
            /* Second pass: still too tall per direct feedback. Pushed padding,
               indent, and every text size down further, and tightened the
               mb-3 gaps between the title/bullets/button/checkbox blocks
               (Bootstrap !important utility, needs !important to move). The
               intro paragraph's size now comes from .mobile-section-desc
               above (shared with the qa-block description) rather than its
               own one-off rule here; the bullet list keeps its own slightly
               smaller size below — itemized fine print is a level down in
               hierarchy from a normal description paragraph, not the same
               role. */
            #terms-box { padding: 0.9rem 0.8rem !important; border-radius: 14px !important; }
            #terms-box .fs-5 { font-size: 0.94rem; }
            #terms-box .mb-3 { margin-bottom: 0.65rem !important; }
            #terms-points-list { padding-left: 1rem !important; font-size: 0.78rem; line-height: 1.42; margin-bottom: 0.65rem !important; }
            #terms-box .btn-sm { padding: 0.5rem 1rem; font-size: 0.8rem; }
            #terms-box .form-check { padding: 0.25rem 0 !important; gap: 0.5rem !important; }
            /* Same `.fs-6 { font-size: 1rem !important }` Bootstrap-utility
               conflict as .mobile-section-desc/#stage2 .form-label above —
               the agreement checkbox's own label markup carries `fs-6`
               alongside this rule, so it was silently staying at 16px
               instead of the intended smaller size. */
            #termsAgreeRow .fs-6 { font-size: 0.88rem !important; }
            #termsModal .modal-header, #termsModal .modal-footer { padding: 0.7rem 0.9rem; }
            #termsModal .modal-body { font-size: 0.78rem !important; line-height: 1.42 !important; padding: 0.9rem; }
            #termsModal .modal-title { font-size: 0.94rem; }

            /* START SURVEY: Bootstrap's py-3 (1rem/16px top+bottom) on top
               of this fw-semibold text's own line-height measured out to
               ~58px real height — over the 44-48px target. py-3 is a
               spacing utility, which Bootstrap 5.3 also ships !important
               (same family of bug as the .fs-6/.py-3 conflicts found
               elsewhere in this pass), so the override needs it too. */
            #btnStartSurvey.py-3 { padding-top: 0.6rem !important; padding-bottom: 0.6rem !important; font-size: 0.95rem; min-height: 44px; }
        }

        /* ---- Touch targets + spacing across the survey flow (client info
           step, terms checkbox, profile, history) ----
           Reuses this file's existing 767.98px tablet/phone breakpoint. */
        @media (max-width: 767.98px) {
            /* "Read the full Terms..." was a small btn-sm (~30px tall). */
            #terms-box .btn-sm { padding: 0.6rem 1.1rem; min-height: 44px; font-size: 0.85rem; }
            /* Native checkbox/switch controls render very small (~16-20px);
               the label text next to each is already clickable via its
               for="" attribute, so growing the row's vertical padding (not
               the tiny control itself) is what actually enlarges the tap
               area without changing how the control looks. */
            #terms-box .form-check { padding: 0.4rem 0; gap: 0.6rem !important; }
            .section-title .form-check.form-switch { padding: 0.35rem 0; }
            /* Male/Female radio rows: each option is a whole clickable
               <label>, but its hit height was just the text line (~24px)
               with only 1.5rem between the two — pad each row taller and
               let them wrap with a visible gap instead of sitting close
               enough to mis-tap the wrong one. */
            #gender-field-group { gap: 1.25rem !important; row-gap: 0.75rem !important; }
            #gender-field-group label { padding: 0.4rem 0; min-height: 44px; }

            /* Profile "Edit" button and history badges/meta text were on the
               small side for a phone (~34px tap height, ~12.5px meta text). */
            .btn-edit-profile { padding: 0.65rem 1.2rem; min-height: 44px; }
            .history-item { padding: 1rem 1.1rem; }
            .history-meta { font-size: 0.82rem; }
            .history-badge { font-size: 0.76rem; padding: 0.35rem 0.85rem; }

            /* Back / Next / Submit at the bottom of every survey step use
               plain, unsized .btn — Bootstrap's default padding leaves them
               only ~36px tall. Every one of these rows is
               ".page .d-flex.justify-content-between", so this catches all
               of them (stage1's full-width Start button already has its own
               py-3 and isn't affected). */
            #stage2 .d-flex.justify-content-between.border-top > .btn,
            #stage3 .d-flex.justify-content-between.border-top > .btn,
            #stage4 .d-flex.justify-content-between.border-top > .btn,
            #stage5 .d-flex.justify-content-between.border-top > .btn {
                /* 0.85rem padding-top+bottom on top of this fw-semibold
                   text's own line-height measured out to ~53px real height
                   — over the 44-48px nav-button target. Trimmed so
                   min-height:44px is doing the real work (a comfortable
                   floor) instead of the padding pushing well past it. */
                padding-top: 0.65rem;
                padding-bottom: 0.65rem;
                min-height: 44px;
            }
        }

        .view-header { text-align: center; padding-bottom: 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid var(--line-soft); }
        .view-header .view-icon {
            width: 56px; height: 56px; border-radius: 16px; margin: 0 auto 1rem;
            display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
            background: var(--ring); color: var(--brand);
        }

        /* ---- Profile view ---- */
        .profile-view-card { overflow: hidden; }

        /* View Profile used to get a min-height/flex "justify-content:
           center" treatment here, on the theory that a short card left a
           dead zone below it worth visually centering into. Root-cause
           mobile audit found that's backwards: centering a shorter-than-
           viewport card pushes EQUAL empty space above it too, i.e. it
           re-creates the exact "big blank gap under the header" complaint
           this pass is fixing on Home/History (which never had this rule
           and don't have that gap) — Profile just had it hidden by
           happening to be a taller card historically. Removed so Profile
           matches Home/History/every other view: content starts immediately
           below the header and simply ends where it ends, no artificial
           vertical centering anywhere. No fixed height added — a taller
           profile (long name, many fields) still just flows/scrolls
           normally, exactly as it already does elsewhere. */
        .profile-hero {
            display: flex; align-items: center; gap: 1.1rem;
            padding: 1.75rem clamp(1.25rem, 4vw, 3rem);
            background: var(--surface);
            border-bottom: 1px solid var(--line-soft);
        }
        .profile-hero-avatar {
            width: 60px; height: 60px; border-radius: 50%; flex-shrink: 0;
            background: var(--ring); color: var(--brand);
            display: flex; align-items: center; justify-content: center; font-size: 1.55rem;
            overflow: hidden;
        }
        .profile-hero-avatar img {
            width: 100%; height: 100%; object-fit: cover; border-radius: 50%;
        }
        .profile-hero-text h3 { margin: 0 0 0.15rem; font-weight: 700; color: var(--ink-900); }
        .profile-hero-text p { margin: 0; color: var(--ink-600); font-size: 0.86rem; }

        .profile-body { padding: clamp(1.25rem, 4vw, 2.5rem); }

        .profile-section-label {
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
            color: var(--ink-400); margin-bottom: 0.9rem;
        }

        .profile-section-header {
            display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem;
        }
        .profile-section-header .profile-section-label { margin-bottom: 0; }

        .btn-edit-profile {
            display: inline-flex; align-items: center; gap: 0.4rem; flex-shrink: 0;
            font-size: 0.82rem; font-weight: 700; padding: 0.45rem 1rem; border-radius: 50px;
            background: transparent; color: var(--brand); border: 1.5px solid var(--brand);
            transition: all .15s ease;
        }
        .btn-edit-profile:hover { background: var(--brand); color: #fff; transform: translateY(-1px); box-shadow: 0 8px 18px -8px rgba(37,84,199,0.6); }
        .btn-edit-profile:active { transform: translateY(0); }

        .profile-info-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
        @media (max-width: 640px) { .profile-info-grid { grid-template-columns: 1fr; } }

        .profile-info-card {
            display: flex; align-items: flex-start; gap: 0.85rem;
            background: var(--surface); border: 1px solid var(--line-soft); border-radius: 14px; padding: 1.1rem 1.2rem;
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .profile-info-card:hover { border-color: var(--line); box-shadow: 0 4px 14px -8px rgba(15,23,42,0.12); }
        [data-bs-theme="dark"] .profile-info-card { background: #101827; }

        /* Name is the prominent, editable field — span both grid columns and give it
           slightly more visual weight than the locked, read-only fields beside it. */
        .profile-info-card-name { grid-column: 1 / -1; background: var(--ring); border-color: transparent; }
        [data-bs-theme="dark"] .profile-info-card-name { background: rgba(37,84,199,0.14); }
        .profile-info-card-name .profile-info-value { font-size: 1.05rem; }

        .profile-info-icon {
            width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            background: var(--ring); color: var(--brand); font-size: 1.05rem;
        }
        .profile-info-card-name .profile-info-icon { background: var(--surface); }
        .profile-info-text { min-width: 0; }
        .profile-info-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; color: var(--ink-400); margin-bottom: 0.25rem; }
        .profile-info-value { font-weight: 600; color: var(--ink-900); word-break: break-word; }

        .profile-edit-card {
            background: var(--surface); border: 1px solid var(--line-soft); border-radius: 16px; padding: 1.6rem;
        }
        .profile-divider { border: none; border-top: 1px solid var(--line-soft); margin: 2.25rem 0; }

        .profile-locked-badge {
            display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.78rem; font-weight: 600;
            color: var(--ink-800);
        }
        .profile-locked-badge i { font-size: 0.7rem; color: var(--ink-400); }
        .profile-unset { color: var(--ink-400); font-style: italic; font-weight: 500; font-size: 0.86rem; }

        /* ---- History view ----
           ROOT CAUSE of the messy/floating "Completed" badge: .history-item
           had exactly two flex children — an unnamed wrapper <div> (office
           name + meta) and the .history-badge span — with align-items:
           center and neither child given min-width:0/flex-shrink rules.
           align-items:center vertically centers each flex item against the
           WHOLE line box, so the moment a long office name wrapped the text
           div onto 2+ lines, the single-line badge got centered against
           that taller box and visually floated halfway between the lines
           instead of sitting at the top. And with no flex-basis/shrink
           rules on either child, which one gave way (title squeezed vs.
           badge dropping to its own row) was left entirely to the browser's
           default flex distribution — inconsistent across office-name
           lengths and viewport widths, which is exactly the "sometimes
           messy" symptom.
           Fix: align-items:flex-start pins the badge to the TOP of the row
           regardless of how many lines the title wraps to; .history-item-
           text gets min-width:0 + flex:1 so it's always the one that
           shrinks/wraps (never the badge); .history-badge gets an explicit
           flex-shrink:0 so it can never be squeezed or wrap internally. No
           fixed card height anywhere here — the card still grows with
           however many lines the title needs. */
        .history-item {
            border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem 1.3rem;
            display: flex; justify-content: space-between; align-items: flex-start; gap: 0.6rem 1rem; flex-wrap: wrap;
            transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
            background: var(--surface);
        }
        .history-item:hover { border-color: var(--brand); box-shadow: 0 8px 20px -12px rgba(37,84,199,0.35); transform: translateY(-2px); }
        .history-item + .history-item { margin-top: 0.9rem; }
        .history-item-text { min-width: 0; flex: 1 1 auto; }
        .history-office { font-weight: 700; color: var(--ink-900); margin-bottom: 0.15rem; word-break: break-word; }
        .history-meta { font-size: 0.78rem; color: var(--ink-600); }
        .history-badge {
            font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 50px;
            background: rgba(34,197,94,0.12); color: #16a34a; white-space: nowrap;
            flex: 0 0 auto; align-self: flex-start;
        }
        [data-bs-theme="dark"] .history-badge { background: rgba(34,197,94,0.18); color: #4ade80; }

        /* ---- View Profile + Survey History on phones ----
           A second visual pass found these two still reading as oversized
           even with .content-body / card padding fixed elsewhere: the
           shared .view-header (History's title block) had NO mobile
           override at all — a 56px icon plus 1.5rem/2rem of
           padding-bottom/margin-bottom below it, before a single history
           row is even reached — and each .profile-info-card/.history-item
           carried desktop padding, a 40px icon, and a full 1rem grid gap
           for what's ultimately one line of text per field/row. Compacted
           without touching the underlying markup, data, or click/edit
           behavior — only sizing. */
        @media (max-width: 575.98px) {
            .view-header { padding-bottom: 0.7rem; margin-bottom: 0.9rem; }
            .view-header .view-icon { width: 34px; height: 34px; font-size: 1rem; margin-bottom: 0.5rem; border-radius: 10px; }
            .view-header h3 { font-size: 1.02rem; margin-bottom: 0.15rem !important; }
            .view-header p { font-size: 0.78rem; }
            #view-history > .card > .card-body { padding: 0.9rem 0.75rem !important; }

            .profile-hero { padding: 1rem 0.9rem; gap: 0.75rem; }
            .profile-hero-avatar { width: 44px; height: 44px; font-size: 1.15rem; }
            .profile-hero-text h3 { font-size: 1.05rem; }
            .profile-hero-text p { font-size: 0.78rem; }
            .profile-body { padding: 0.9rem; }
            .profile-section-label { font-size: 0.66rem; margin-bottom: 0.6rem; }
            .profile-info-grid { gap: 0.6rem; }
            .profile-info-card { padding: 0.7rem 0.85rem; gap: 0.6rem; border-radius: 12px; }
            .profile-info-icon { width: 32px; height: 32px; font-size: 0.9rem; border-radius: 9px; }
            .profile-info-label { font-size: 0.64rem; margin-bottom: 0.15rem; }
            .profile-info-value { font-size: 0.88rem; }
            .profile-info-card-name .profile-info-value { font-size: 0.94rem; }
            .btn-edit-profile { padding: 0.5rem 0.9rem; font-size: 0.76rem; }
            .profile-edit-card { padding: 1.1rem; }
            .profile-divider { margin: 1.5rem 0; }

            /* History: same information, one line per field, in about half
               the vertical space — long office names still wrap naturally
               (no truncation), they just no longer drag the whole card
               taller than it needs to be for a single-line one. Feedback
               after this pass was "better, but still a little too large" —
               one more conservative notch below, not a redesign. */
            .history-item { padding: 0.625rem 0.7rem; gap: 0.35rem 0.55rem; border-radius: 11px; }
            .history-item + .history-item { margin-top: 0.45rem; }
            .history-office { font-size: 0.91rem; margin-bottom: 0.08rem; }
            .history-office i { font-size: 0.82rem; }
            .history-meta { font-size: 0.73rem; line-height: 1.28; }
            /* Round-2 density pass: badge trimmed a further notch while
               staying above the ~28px comfortable-badge-height floor. */
            .history-badge { font-size: 0.68rem; padding: 0.32rem 0.65rem; }
        }

        /* ---- History detail modal ----
           Same flex-child shape (and same floating-badge risk) as
           .history-item above — icon, an unnamed office-name/meta div, and
           a .history-badge.ms-auto — so it gets the same fix: flex-start
           alignment plus min-width:0/flex:1 on the text column. */
        .history-detail-head {
            display: flex; align-items: flex-start; gap: 0.9rem; flex-wrap: wrap;
            padding-bottom: 1.25rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line-soft);
        }
        .history-detail-head > .history-item-text { padding-top: 0.1rem; }
        .history-detail-icon {
            width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.15rem;
            background: var(--ring); color: var(--brand);
        }

        .review-sqd-list { background: #f8fafc; border: 1px solid var(--line); border-radius: 12px; padding: 0.3rem 1rem; }
        [data-bs-theme="dark"] .review-sqd-list { background: #101827; }

        .sqd-rating-badge {
            display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap;
            font-size: 0.78rem; font-weight: 700; padding: 0.3rem 0.75rem 0.3rem 0.4rem; border-radius: 50px;
        }
        .sqd-rating-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 20px; height: 20px; border-radius: 50%; font-size: 0.72rem;
            background: rgba(255,255,255,0.6);
        }
        [data-bs-theme="dark"] .sqd-rating-num { background: rgba(15,23,42,0.35); }
        .sqd-rating-5, .sqd-rating-4 { background: rgba(34,197,94,0.14); color: #16a34a; }
        .sqd-rating-3 { background: rgba(234,179,8,0.16); color: #b45309; }
        .sqd-rating-2, .sqd-rating-1 { background: rgba(239,68,68,0.14); color: #dc2626; }
        [data-bs-theme="dark"] .sqd-rating-5, [data-bs-theme="dark"] .sqd-rating-4 { background: rgba(34,197,94,0.22); color: #4ade80; }
        [data-bs-theme="dark"] .sqd-rating-3 { background: rgba(234,179,8,0.22); color: #fbbf24; }
        [data-bs-theme="dark"] .sqd-rating-2, [data-bs-theme="dark"] .sqd-rating-1 { background: rgba(239,68,68,0.22); color: #f87171; }
        .sqd-rating-na, .sqd-rating-unanswered { background: var(--line-soft); color: var(--ink-600); }

        .empty-state { text-align: center; padding: 3.5rem 1.5rem; color: var(--ink-600); }
        .empty-state i { font-size: 2.75rem; color: var(--ink-400); margin-bottom: 1rem; display: block; }
        .empty-state p { max-width: 360px; margin: 0.5rem auto 0; font-size: 0.9rem; }

        .spinner-block { text-align: center; padding: 3rem 1rem; color: var(--ink-600); }

        /* ---- Review & Confirmation (Stage 5) — presented as an official
           document/report rather than a dashboard of cards: a light "page"
           tray holds a white "paper" sheet, topped by a header that stays
           pinned (position: sticky) just under the topbar while the paper
           content scrolls underneath it. ---- */
        .review-doc { background: var(--page-bg); border-radius: 18px; padding: 1.1rem; }
        [data-bs-theme="dark"] .review-doc { background: #0b1220; }

        .review-doc-paper {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 14px;
            box-shadow: var(--shadow-soft);
            max-width: 760px;
            margin: 0 auto;
            overflow: hidden;
        }

        .review-doc-header {
            position: sticky;
            top: var(--topbar-h);
            z-index: 15;
            background: var(--surface);
            border-bottom: 1px solid var(--line);
            padding: 1.5rem 1.75rem 1.15rem;
        }
        .review-doc-header .section-title { padding-top: 0; padding-bottom: 0; }

        .review-doc-body { padding: 1.6rem 1.75rem 1.9rem; }

        .review-doc-kicker {
            text-align: center;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--ink-900);
            text-transform: uppercase;
            letter-spacing: .06em;
            padding-bottom: 1.35rem;
            margin-bottom: 1.6rem;
            border-bottom: 1px dashed var(--line);
        }

        .review-section { margin-bottom: 1.75rem; }
        .review-section-header {
            display: flex; justify-content: space-between; align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 0.65rem;
            border-bottom: 1.5px solid var(--line);
        }
        .review-section-header h5 { margin: 0; font-weight: 700; color: var(--ink-900); font-size: 0.9rem; text-transform: uppercase; letter-spacing: .05em; }
        .btn-edit-section {
            font-size: 0.75rem; font-weight: 700; padding: 0.3rem 0.85rem; border-radius: 50px;
            background: transparent; color: var(--brand); border: 1px solid var(--line); transition: all .15s ease;
            flex-shrink: 0; white-space: nowrap;
        }
        .btn-edit-section:hover { background: var(--brand); color: #fff; border-color: var(--brand); transform: translateY(-1px); }

        .review-grid { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 2rem; }
        .review-item {
            display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
            padding: 0.55rem 0;
            border-bottom: 1px solid var(--line-soft);
        }
        [data-bs-theme="dark"] .review-item { border-color: var(--line-soft); }
        .review-item .label {
            flex: 0 0 auto; margin-bottom: 0;
            font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--ink-400);
        }
        .review-item .value { flex: 1 1 auto; text-align: right; font-weight: 600; color: var(--ink-900); font-size: 0.9rem; word-break: break-word; }
        .review-item.full {
            grid-column: 1 / -1;
            flex-direction: column; align-items: flex-start; gap: 0.3rem;
        }
        .review-item.full .value { text-align: left; width: 100%; }

        .review-sqd-row {
            display: flex; justify-content: space-between; align-items: center; gap: 0.75rem;
            padding: 0.65rem 0; border-bottom: 1px dashed var(--line);
        }
        .review-sqd-row:last-child { border-bottom: none; }
        .review-sqd-statement { font-size: 0.85rem; color: var(--ink-800); }
        .review-sqd-rating {
            font-size: 0.78rem; font-weight: 700; white-space: nowrap; padding: 0.25rem 0.7rem; border-radius: 50px;
            background: var(--ring); color: var(--brand);
        }

        #terms-box { box-shadow: var(--shadow-soft); }

        /* ---- Thank You / success page ---- */
        .thank-you-card { max-width: 460px; margin: 0 auto; }
        .thank-you-actions { display: inline-flex; gap: 0.75rem; }

        @media (max-width: 576px) {
            .thank-you-card { padding: 0 0.25rem; }
            .thank-you-icon { width: 56px !important; height: 56px !important; margin-bottom: 0.75rem !important; }
            .thank-you-icon .fs-1 { font-size: 1.4rem !important; }
            #thank-you-page.py-5 { padding-top: 1.1rem !important; padding-bottom: 1.5rem !important; }
            #thank-you-page h1 { font-size: 1.2rem; margin-bottom: 0.5rem !important; }
            #thank-you-page p.text-secondary { font-size: 0.86rem; }

            /* Stacked, but deliberately NOT full-viewport-width: the previous
               pass fixed the invisible-border bug (see .btn-outline-primary
               above) and made both buttons full-width, which over-corrected
               into two ~48px-tall, edge-to-edge blocks that dominate the
               card. Constraining to a centered max-width plus a real
               (not desktop px-5/py-3) mobile padding/font-size override
               keeps them clearly tappable without reading as giant. The
               .thank-you-actions .btn selector (0,2,0 specificity) beats the
               single-class px-5/py-3 Bootstrap utilities (0,1,0), both
               !important, so it reliably wins here. */
            .thank-you-actions {
                display: flex; flex-direction: column; align-items: center; width: 100%; gap: 0.6rem;
            }
            .thank-you-actions .btn {
                width: 100%; max-width: 260px; margin: 0 !important;
                padding: 0.65rem 1rem !important;
                font-size: 0.92rem !important;
                min-height: 44px;
            }
        }

        @media (max-width: 576px) {
            /* Root cause of "desktop review squeezed into mobile": FOUR layers
               of horizontal padding compound before any review content is
               reached — .content-body, .survey-card>.card-body, .review-doc
               (this "tray" background), then .review-doc-body — measured at
               ~109px lost combined on a 375px phone, leaving well under 300px
               for actual content. .review-doc is purely decorative padding
               (a colored tray peeking around the white "paper" beneath it);
               it doesn't need its own separate inset once the card above it
               already provides one, so it's trimmed hardest here. */
            .review-doc { padding: 0.3rem; border-radius: 12px; }
            .review-doc-header { padding: 0.9rem 0.85rem 0.75rem; }
            .review-doc-body { padding: 1rem 0.85rem 1.2rem; }
            .review-doc-kicker { font-size: 0.85rem; padding-bottom: 1rem; margin-bottom: 1.1rem; }
            .review-section { margin-bottom: 1.25rem; }
            .review-grid { grid-template-columns: 1fr; }
            .review-item { flex-direction: column; align-items: flex-start; gap: 0.2rem; }
            .review-item .value { text-align: left; width: 100%; }

            /* Per-section "Edit" pill was ~28px tall — the only way back into
               that step's fields from the review screen, so it's worth a
               real tap target. Label/statement text bumped a touch too. */
            .btn-edit-section { padding: 0.55rem 1.1rem; font-size: 0.8rem; min-height: 44px; }
            .review-item .label { font-size: 0.76rem; }
            .review-section-header h5 { font-size: 0.82rem; }

            /* SQD review rows: desktop lays the statement and its rating pill
               out side-by-side (space-between) — measured at only ~110px left
               for the statement on a 375px phone once the pill's own ~114px
               is subtracted, forcing 1-2 words per line next to an
               oddly-floating pill. Stacked instead: full-width statement,
               then the pill on its own line below it, so neither is starved
               of width. Same markup/JS (renderReviewSummary()) — CSS only. */
            .review-sqd-row { flex-direction: column; align-items: flex-start; gap: 0.4rem; padding: 0.75rem 0; }
            .review-sqd-statement { font-size: 0.88rem; line-height: 1.4; }
            .review-sqd-rating { align-self: flex-start; }
        }
        @media (max-width: 400px) {
            .review-doc-header { padding: 0.8rem 0.7rem 0.65rem; }
            .review-doc-body { padding: 0.85rem 0.7rem 1.05rem; }
        }

        @media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); box-shadow: 0 0 40px rgba(0,0,0,0.35); }
            .sidebar.show { transform: translateX(0); }
            .app-shell.sidebar-collapsed .sidebar { transform: translateX(-100%); }
            .sidebar-backdrop.show { display: block; }
            .main-content { margin-left: 0; }
            .topbar-hamburger { display: inline-flex; }
            .btn-sidebar-toggle { display: none; }

            /* ---- Touch targets on the mobile drawer + topbar ----
               The hamburger/fullscreen icon buttons were 40x40 (just under
               the ~44px comfortable minimum) and the drawer's nav links/
               logout button had ~35-40px tap heights with tight spacing
               between stacked items — easy to mis-tap with a thumb. Nothing
               here touches the persistent desktop sidebar's look, since this
               whole block only ever applies once the sidebar has already
               become the slide-over drawer. */
            .topbar-hamburger, .btn-fullscreen { width: 44px; height: 44px; font-size: 1.15rem; }
            .topbar { gap: 0.85rem; padding: 0 1.1rem; }
            .topbar-icon-group { gap: 0.5rem; }
            /* Applies across the whole mobile-drawer range (not just the
               narrowest phones below), so the title can never multi-line
               wrap into 3-4 lines at any width where the drawer/hamburger
               is active — it truncates with an ellipsis instead, which is a
               graceful, single-line degradation rather than a tall header. */
            .topbar-title { min-width: 0; flex: 1 1 auto; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            .topbar-title small { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
            /* Tight topbar real estate on mobile — the label used to be
               hidden outright to avoid crowding the fullscreen button,
               leaving just a bare dot with no visible word. Dropping only
               the "Viewing " prefix keeps "Offline" itself always readable
               while staying narrow enough not to overlap its neighbors. */
            .offline-pill.is-visible { padding: 0.35rem 0.6rem; gap: 0.3rem; }
            .offline-pill .label-full { display: none; }
            .sidebar-nav { gap: 0.4rem; padding: 1.25rem 0.85rem; }
            .sidebar-nav .nav-item-link { padding: 0.85rem 0.95rem; min-height: 44px; }
            .sidebar-footer .btn-logout-side { padding: 0.75rem; min-height: 44px; }
            .lang-toggle-group .btn { padding: 0.5rem 1rem; min-height: 40px; }
        }

        @media (max-width: 576px) {
            /* ---- Mobile header, revised two-row layout ----
               Previous iteration put the bell/fullscreen on row 2 with the
               language toggle, and used abbreviated "EN"/"TL" labels. Per
               updated direction: the bell + fullscreen must always stay on
               row 1, to the right of the title (never a second row), and
               the language toggle now shows full "English"/"Tagalog" labels
               instead of the 2-letter short form — so it needs its own row
               (row 2) together with the offline/online pill, rather than
               sharing row 2 with the icon buttons.

                 Row 1: [hamburger]  [title, truncates]  [bell][fullscreen]
                 Row 2: [Offline pill]  ...space-between...  [English][Tagalog]

               .topbar-icon-group is a direct topbar child now (see markup)
               so it's a normal row-1 flex item and is NEVER pushed to row 2
               by anything here. .topbar-row2 (also a direct topbar child,
               wrapping the offline pill + language toggle) is what gets
               forced onto its own line via flex-basis:100%. */
            /* Measured via real browser render (headless Chromium), not
               hand-calculated — the language toggle's full-word buttons on
               row 2 make this taller than a first-pass estimate suggested. */
            /* --topbar-h recomputed empirically (Playwright, 375px, real
               rendered .topbar rect) after the title/subtitle type scale
               below was brought UP into the 18-20px/12-14px target range
               (was 0.9rem/0.6rem — under the target, not over it): measured
               ~113-114px even after the padding/row-gap trims below, since
               the bigger two-line title (18px + 12.8px subtitle, each with
               their own line-height) costs more than the trimmed padding
               saves. Down slightly from the previous 106px's actual (was
               under-measured before this pass) — kept at a real measured
               value rather than guessed, since var(--topbar-h) drives sticky
               offsets (.review-doc-header, notif panel, scroll-margin-top)
               that break if it doesn't match the true rendered height. */
            /* Density pass: was 114px (two-line title block at 18px/12.8px
               with default 1.5 line-height taller than the 40px row-1
               buttons, plus a full 36px-button language row) — well past
               the 56-64px (row 1) + ~42-46px (row 2) targets. Tightened
               line-heights so the title block no longer out-grows the
               buttons, shrunk row-1 buttons to 38px, and tightened the
               language row below — recomputed total. */
            :root { --topbar-h: 98px; }
            .topbar {
                flex-wrap: wrap;
                align-content: flex-start;
                padding: 0.4rem 0.65rem 0.4rem;
                row-gap: 0.25rem;
                column-gap: 0.4rem;
            }

            /* Row 1 items — 38px keeps row-1 icon buttons within the 36-40px
               target while still comfortably tappable. */
            .topbar-hamburger { width: 38px; height: 38px; font-size: 1.15rem; }
            .topbar-title {
                min-width: 0; flex: 1 1 auto; font-size: 1.1rem; line-height: 1.2;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .topbar-title small {
                font-size: 0.75rem; line-height: 1.2; margin-top: 0.05rem;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .topbar-icon-group { gap: 0.4rem; flex-shrink: 0; }
            .topbar-icon-group .btn-fullscreen { width: 38px; height: 38px; font-size: 1.15rem; }

            /* Row 2: .topbar-row2 stops being display:contents and becomes
               the full-width second row itself, splitting its two (each
               independently optional) children to opposite ends.
               Language toggle now leads (order:-1) on the LEFT, under the
               title — the offline pill (only ever shown while genuinely
               offline) takes whatever's left via margin-left:auto, so it
               still reads as the right-side item on the rare occasion both
               are visible at once, without needing its own flex order
               rule. Neither child depends on the other being present:
               .lang-toggle-group's own margin-left:0/justify-content:
               flex-start (below) is what actually pins it left when it's
               the row's only visible child, which is the common case. */
            .topbar-row2 {
                display: flex; flex-basis: 100%; width: 100%;
                align-items: center; justify-content: flex-start;
                gap: 0.4rem;
            }
            .offline-pill.is-visible { flex: 0 0 auto; padding: 0.25rem 0.55rem; font-size: 0.68rem; margin-left: auto; }

            /* Full "English"/"Tagalog" words now shown at every width (the
               .lang-btn-short/.lang-btn-full swap below is removed) — row 2
               has the full topbar width available, so abbreviating to
               "EN"/"TL" is no longer necessary. Moved to the LEFT (was
               right, via margin-left:auto) so it reads as associated with
               the page title/content area instead of sitting far from it
               next to the offline pill. */
            .lang-toggle-group {
                order: -1;
                flex: 0 0 auto;
                margin-left: 0;
                justify-content: flex-start;
                padding: 0.15rem; gap: 0.25rem;
                border-radius: 18px;
                box-shadow: none;
            }
            /* Container height target 34-38px, button 32-36px: base desktop
               rule (border-radius:50px, padding:0.35rem 0.9rem) reads as an
               oversized "pill" once wrapped in this compact row-2 — capped
               the radius and re-tuned padding/min-height to land in range.
               Bootstrap's own shadow-sm on these buttons is neutralized too
               (much lighter shadow requirement — none reads cleanest here). */
            .lang-toggle-group .btn {
                padding: 0.32rem 0.9rem; font-size: 0.88rem; min-height: 34px;
                border-radius: 18px !important;
                box-shadow: none !important;
            }

            /* Client Profile header + Autofill switch: stay a single row
               (title left, switch right) at every width — the earlier
               stacked/centered attempts all looked worse than just keeping
               them side by side. flex-wrap: nowrap keeps the switch from
               ever dropping to its own line; min-width: 0 + flex: 1 on the
               heading lets IT wrap internally (2 lines for the longer
               Tagalog heading) while align-items: center keeps the switch
               vertically centered next to however tall that makes the row.
               The !importants are needed because the markup also carries
               Bootstrap's d-flex/align-items-center/justify-content-between
               utilities, which ship !important themselves and would
               otherwise win over a plain override regardless of source
               order. */
            #clientProfileHeader {
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                align-items: center !important;
                justify-content: space-between !important;
                gap: 0.6rem !important;
            }
            #clientProfileHeader h4 { font-size: 1.1rem; flex: 1 1 auto; min-width: 0; }
            #clientProfileHeader .form-switch { flex: 0 0 auto; margin-top: 0; white-space: nowrap; }
            #clientProfileHeader.mb-4 { margin-bottom: 1rem !important; }

            /* Client Profile (stage 2) form fields: each input/select is
               already a comfortable touch height, but Bootstrap's g-4
               row gap (1.5rem/24px) between ~10 stacked fields added up to
               a lot of pure whitespace with nothing to do with touch size —
               g-4 only sets these two custom properties, so overriding them
               tightens the gap without touching the inputs themselves. */
            #stage2 .row.g-4 { --bs-gutter-y: 0.6rem; --bs-gutter-x: 0.75rem; }
            /* Labels were fs-6 (1rem) — reasonable on desktop, oversized as
               a field caption on a phone next to a same-height input.
               Reduced the label only; the input/select itself (and its
               touch height) is untouched. */
            /* Root cause found via real-browser measurement: every stage2
               label markup also carries Bootstrap's `.fs-6` utility class,
               which ships `!important` — it was silently defeating this
               rule entirely (labels measured at 16px on a real render, not
               the intended 13.76px), so the "reduce the label only" mobile
               pass documented above never actually took effect. Needs
               !important itself to win. */
            #stage2 .form-label { font-size: 0.88rem !important; margin-bottom: 0.2rem; }
            #stage2 .form-text { font-size: 0.74rem; line-height: 1.3; margin-top: 0.15rem; }
            #stage2 .service-progress-badge { font-size: 0.7rem; }
            #stage2 .availability-notice { padding: 0.3rem 0.6rem; font-size: 0.78rem; margin: 0.25rem 0; }

            /* Inputs/selects were the plain desktop .form-control/.form-select
               rule (.7rem/.95rem padding, no explicit height, 16px font from
               the browser default) — comfortably over the 40-44px height /
               14-15px font targets. #officeSelect and #serviceSelect also
               carry Bootstrap's `.fs-6` utility (font-size:1rem !important),
               which silently wins over a plain override, so those two need
               `!important` here. Right padding widened to 2.1rem so the
               native select arrow never sits on top of long office names. */
            #stage2 .form-control, #stage2 .form-select {
                min-height: 39px;
                padding: 0.42rem 2.1rem 0.42rem 0.65rem;
                font-size: 0.92rem;
            }
            #stage2 input.form-control, #stage2 input[type="date"], #stage2 input[type="datetime-local"] {
                padding-right: 0.65rem;
            }
            #officeSelect.fs-6, #serviceSelect.fs-6 {
                font-size: 0.92rem !important;
                min-height: 39px;
                width: 100%;
                min-width: 0;
            }
            #stage2 .form-check-input { width: 19px; height: 19px; }
            #stage2 .form-check-label, #gender-field-group label { font-size: 0.92rem; }
            #stage2 .lock-icon { font-size: 0.78rem; }
            #stage2 .row.g-4 > * { padding-top: 0.1rem; }

            /* Terms checkbox: show the label text first, checkbox centered
               below it — instead of a left-aligned row whose wrapped 2nd
               line no longer lines up under the checkbox. The markup's own
               "align-items-start" utility ships !important, so a plain
               align-items: center here would lose to it and the checkbox
               would stay pinned to the left edge regardless of this rule. */
            #termsAgreeRow {
                flex-direction: column-reverse !important;
                align-items: center !important;
                text-align: center;
                padding-left: 0;
                gap: 0.6rem !important;
            }
            /* Bootstrap's .form-check pairs padding-left:1.5em on the row with
               margin-left:-1.5em on the input (the classic float-based
               indent hack) so the box sits under the label's first line —
               that negative margin survives the switch to flex and drags
               the checkbox back to the far left even with align-items:
               center. Zero both out once the box is on its own centered row. */
            #termsAgreeRow .form-check-input {
                margin-top: 0 !important;
                margin-left: 0 !important;
                float: none !important;
            }
        }

        #sqd-body td {
            padding-top: 1.1rem;
            padding-bottom: 1.1rem;
        }

        /* Rating cells: the whole cell is the click/tap target, not just the radio
           circle — the label fills the cell so any click inside it toggles the
           radio via native <label>-for-<input> behavior. */
        #sqd-body td.sqd-rating-cell {
            padding: 0;
            cursor: pointer;
        }
        #sqd-body .sqd-rating-option {
            display: flex;
            width: 100%;
            min-height: 52px;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            padding: 1rem 0.5rem;
        }
        /* Hover tint, skipped when the cell is already checked (so it doesn't wash
           out the green/yellow/red selected-state color below) or its radio is
           disabled/locked (a <label> never toggles a disabled radio on click, so
           it shouldn't look clickable either). */
        #sqd-body .sqd-rating-cell:not(:has(.radio-custom:checked)):not(:has(.radio-custom:disabled)):hover .sqd-rating-option {
            background: rgba(37, 84, 199, 0.08);
        }
        [data-bs-theme="dark"] #sqd-body .sqd-rating-cell:not(:has(.radio-custom:checked)):not(:has(.radio-custom:disabled)):hover .sqd-rating-option {
            background: rgba(96, 141, 255, 0.1);
        }
        #sqd-body .sqd-rating-option:has(input:disabled),
        #sqd-body td.sqd-rating-cell:has(input:disabled) {
            cursor: not-allowed;
        }

        /* Text label next to each radio — only meaningful once the table
           below is flattened into cards on small phones, where there's no
           column header left to read the rating name from. Hidden on the
           desktop/tablet table, where the header row already says it. */
        .sqd-rating-text { display: none; }

        .page { display: none; }
        .active { display: block; animation: fadeIn .4s ease; }
        .active.dir-fwd { animation: slideInFwd .45s cubic-bezier(.22,.61,.36,1); }
        .active.dir-back { animation: slideInBack .45s cubic-bezier(.22,.61,.36,1); }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes slideInFwd {
            from { opacity: 0; transform: translateX(28px); }
            to { opacity: 1; transform: translateX(0); }
        }
        @keyframes slideInBack {
            from { opacity: 0; transform: translateX(-28px); }
            to { opacity: 1; transform: translateX(0); }
        }

        /* Short "available again in ..." countdown, beside the Service Availed
           field (see the HTML comment above it for why it sits above the select
           instead of under it). Amber/accent-toned so it reads as an
           informational wait-state, not an error. Kept deliberately terse —
           the timer itself is the point, not a full sentence. */
        .availability-notice {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin: 0.35rem 0;
            padding: 0.4rem 0.75rem;
            background: rgba(212, 175, 55, 0.12);
            border: 1px solid rgba(212, 175, 55, 0.35);
            border-radius: 0.5rem;
            color: var(--ink-800);
            font-size: 0.84rem;
            font-weight: 600;
            line-height: 1.3;
        }
        .availability-notice i {
            color: var(--accent);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        /* "1/3 answered" pill beside the Service Availed label — only shown for
           an office with more than one service, once at least one has been
           answered, so the client sees at a glance how much of that office
           they've already given feedback on. */
        .service-progress-badge {
            font-size: 0.74rem;
            font-weight: 700;
            color: var(--ink-600);
            background: #eef1f6;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 0.15rem 0.65rem;
            white-space: nowrap;
        }

        /* Subtle padlock icon shown next to labels of previously-answered, locked fields */
        .lock-icon {
            font-size: 0.85rem;
            color: var(--ink-400);
            cursor: help;
            vertical-align: middle;
        }

        /* Dim disabled/locked inputs so it's obvious they can't be edited */
        .form-control:disabled,
        .form-select:disabled {
            background-color: #f1f5f9;
            opacity: 0.8;
            cursor: not-allowed;
        }

        /* Grey out offices whose survey is already completed, and mark them
           so the browser's native tooltip (title attr) makes the reason clear */
        #officeSelect option:disabled {
            color: #9ca3af;
            font-style: italic;
            background-color: #f1f5f9;
        }

        .locked-field {
            opacity: 0.75;
        }

        .locked-field .radio-custom {
            cursor: not-allowed;
        }

        .radio-custom {
            width: 19px;
            height: 19px;
            accent-color: var(--brand);
            cursor: pointer;
        }

        /* ---- Card shell — full-screen survey canvas, not a small boxed card ---- */
        /* When the Take Survey view is the active one, drop the content-body's own
           padding so the survey fills the viewport edge-to-edge; Profile/History
           keep their normal padded, centered card look. */
        .content-body:has(#view-survey.active) { padding: 2rem 1.75rem 3.5rem; }
        .survey-card {
            border-radius: 22px;
            background: rgba(255,255,255,0.88) !important;
            backdrop-filter: blur(22px) saturate(140%);
            -webkit-backdrop-filter: blur(22px) saturate(140%);
            border: 1px solid rgba(255,255,255,0.5);
            box-shadow: 0 24px 60px -20px rgba(10,20,40,0.5);
            max-width: 940px;
            width: 100%;
            margin: 0 auto;
            min-height: 0;
            transition: background 0.3s ease-in-out, border-color 0.3s ease-in-out;
        }
        [data-bs-theme="dark"] .survey-card {
            background: rgba(15,23,42,0.82) !important;
            border-color: rgba(255,255,255,0.08);
        }
        /* Inner content still reads comfortably instead of stretching edge-to-edge on wide screens */
        .survey-card > .card-body { max-width: 820px; margin: 0 auto; width: 100%; }

        @media (max-width: 575.98px) {
            .content-body:has(#view-survey.active) { padding: 0.75rem; }
            .survey-card { border-radius: 16px; }
            /* The survey card's OWN card-body still carried Bootstrap's p-4
               (24px) on every stage — Terms, Client Profile, Citizen's
               Charter, SQD, Review — stacked on top of the outer padding
               above. That's real desktop-sized padding around the entire
               survey flow, not just stage 1. p-4/p-md-5 are !important
               utilities, so the override needs it too. */
            .survey-card > .card-body { padding: 1.1rem 0.9rem !important; }
        }

        /* ---- "In progress" survey (Stage 2 onward) ----
           Clicking START SURVEY widens the card to a full working canvas, but
           it always stays a contained, rounded card floating over the campus
           backdrop rather than going edge-to-edge. */
        .app-shell.survey-inprogress .survey-card {
            max-width: 1180px;
            min-height: calc(100vh - var(--topbar-h) - 4rem);
        }
        .app-shell.survey-inprogress .survey-card > .card-body { max-width: 1100px; }

        /* ---- Decorative accent bar + soft color orbs on the card shell ---- */
        .survey-card { position: relative; overflow: hidden; }
        .survey-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 6px;
            background: linear-gradient(90deg, var(--brand-dark), var(--brand), var(--accent), var(--brand-light));
            background-size: 200% 100%; animation: heroBarShift 8s linear infinite;
        }
        @keyframes heroBarShift { 0% { background-position: 0% 0; } 100% { background-position: 200% 0; } }
        .survey-card::after {
            content: ''; position: absolute; top: -120px; right: -120px; width: 320px; height: 320px;
            border-radius: 50%; background: radial-gradient(circle, rgba(37,84,199,0.16), transparent 70%);
            pointer-events: none; z-index: 0;
        }
        .survey-card > .card-body { position: relative; z-index: 1; }
        @media (prefers-reduced-motion: reduce) { .survey-card::before { animation: none; } }

        /* ---- Survey hero header (logo + institution + form title) ---- */
        .survey-hero { padding-bottom: 1.75rem; border-bottom: 1px solid var(--line-soft); }
        .survey-hero-logo-wrap {
            display: flex; align-items: center; justify-content: center;
            width: 100%; margin-bottom: 0.75rem;
        }
        .survey-hero-logo {
            width: 84px; height: 84px; object-fit: contain; display: block; margin: 0 auto;
        }
        .survey-hero-eyebrow {
            display: inline-flex; align-items: center; gap: 0.5rem;
            font-size: 0.72rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;
            color: var(--accent); margin-bottom: 0.35rem;
        }
        .survey-hero-eyebrow::before, .survey-hero-eyebrow::after { content: ''; width: 22px; height: 2px; background: var(--accent); display: inline-block; }
        .survey-hero-title { font-family: 'Playfair Display', serif; letter-spacing: 0.01em; }
        .survey-hero-badge {
            position: relative; display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1.5rem;
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            color: #fff; border-radius: 50px; padding: 0.85rem 2rem;
            box-shadow: 0 10px 28px -10px rgba(37,84,199,0.6);
            overflow: hidden;
        }
        .survey-hero-badge i { font-size: 1.05rem; }
        .survey-hero-badge h4 { color: #fff; letter-spacing: .02em; }

        /* ---- Multi-step progress tracker ---- */
        .survey-progress {
            padding: 1.1rem 1.4rem;
            background: var(--page-bg);
            border: 1px solid var(--line-soft);
            border-radius: 16px;
        }
        .progress-steps { position: relative; display: flex; justify-content: space-between; }
        .progress-track {
            position: absolute; top: 15px; left: 17px; right: 17px; height: 4px;
            border-radius: 50px; background: var(--line); z-index: 0; overflow: hidden;
        }
        .progress-fill {
            position: absolute; top: 0; left: 0; height: 100%; width: 0%;
            background: linear-gradient(90deg, var(--brand), #4d7ce8);
            border-radius: 50px; transition: width 0.5s cubic-bezier(.65,0,.35,1);
        }
        .progress-step { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.45rem; flex: 1; }
        .step-dot {
            width: 34px; height: 34px; border-radius: 50%; background: var(--surface);
            border: 2.5px solid var(--line); color: var(--ink-400);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.85rem; transition: all 0.3s ease;
            box-shadow: 0 2px 6px -2px rgba(15,23,42,0.08);
        }
        .step-dot i { display: none; font-size: 1rem; }
        .step-label {
            font-size: 0.72rem; font-weight: 600; color: var(--ink-400);
            text-align: center; letter-spacing: 0.2px; transition: color 0.3s ease;
        }
        .progress-step.completed .step-dot {
            background: linear-gradient(135deg, var(--brand), var(--brand-light));
            border-color: var(--brand); color: #fff;
            box-shadow: 0 4px 12px -4px rgba(37,84,199,0.55);
        }
        .progress-step.completed .step-dot span { display: none; }
        .progress-step.completed .step-dot i { display: inline-block; }
        .progress-step.completed .step-label { color: var(--ink-800); }
        .progress-step.active .step-dot {
            border-color: var(--brand); color: var(--brand);
            box-shadow: 0 0 0 6px var(--ring);
            animation: stepPulse 1.8s ease-in-out infinite;
        }
        .progress-step.active .step-label { color: var(--brand); font-weight: 700; }

        @keyframes stepPulse {
            0%, 100% { box-shadow: 0 0 0 5px var(--ring); }
            50% { box-shadow: 0 0 0 9px transparent; }
        }

        @media (max-width: 576px) {
            /* Density pass: outer .survey-progress padding (1.1rem/1.4rem =
               17.6px/22.4px) and dot size (34px, 36px active-ring included)
               were both desktop-scaled — tightened to the 10-12px outer
               padding / 28-32px (34px active max) circle targets. */
            .survey-progress { padding: 0.5rem 0.6rem; }
            .progress-steps { margin: 0; }
            .step-label { display: none; }
            .step-dot { width: 27px; height: 27px; font-size: 0.7rem; }
            .step-dot i { font-size: 0.78rem; }
            .progress-step.active .step-dot { width: 29px; height: 29px; box-shadow: 0 0 0 3px var(--ring); }
            .progress-track { top: 13.5px; height: 2.5px; }
        }

        /* ---- Survey hero (institutional logo/title block above the form)
           on phones ----
           The 84px logo, uppercase h3 institution name, and the pill-shaped
           badge underneath it were all sized for a desktop card and never
           had a mobile override, unlike the near-identical Home hero above
           (which already shrinks at 767.98px). */
        @media (max-width: 767.98px) {
            .survey-hero { padding-bottom: 1.25rem; }
            .survey-hero-logo { width: 56px; height: 56px; }
            .survey-hero-logo-wrap { margin-bottom: 0.5rem; }
            .survey-hero-eyebrow { font-size: 0.66rem; letter-spacing: 1.5px; }
            .survey-hero-title { font-size: 1.15rem; }
            /* Banner: reduced padding/border-radius/shadow so the pill reads
               as a compact label instead of a heavy full-size CTA-style
               badge; title text bumped from 0.85rem (13.6px, under the
               16-18px target) up to 1.05rem. */
            .survey-hero-badge {
                padding: 0.55rem 1.1rem; margin-top: 1rem; gap: 0.45rem;
                border-radius: 14px;
                box-shadow: 0 6px 16px -8px rgba(37,84,199,0.45);
            }
            .survey-hero-badge h4 { font-size: 1.05rem; }
            .survey-hero-badge i { font-size: 1rem; }
            .survey-progress { padding: 0.85rem 0.9rem; border-radius: 12px; }
            /* Bootstrap's mb-5/mt-5 (3rem/48px) between the hero, progress
               tracker, and each step's Back/Next row were sized for a full
               desktop card; scoped to the survey view only so Home/Profile/
               History's own spacing is untouched. */
            #view-survey .mb-5 { margin-bottom: 1.5rem !important; }
            #view-survey .mt-5 { margin-top: 1.75rem !important; }
        }

        /* CSM banner ("CLIENT SATISFACTION MEASUREMENT (CSM) SURVEY" pill)
           density pass — the 767.98px block above (padding 8.8px/17.6px,
           border-radius 14px, icon 16px) undershot the border-radius/icon
           targets and overshot the horizontal padding target. Scoped to its
           own 576px block (rather than editing the 767.98 rule in place) so
           the 577-767px tablet range is untouched. Progress tracker's own
           bottom margin (mb-5 = 48px base, already cut to 24px at 768px)
           trimmed again here to the 10-14px vertical-margin target. */
        @media (max-width: 576px) {
            .survey-hero-badge {
                padding: 0.6rem 0.9rem; border-radius: 22px;
            }
            .survey-hero-badge h4 { font-size: 1rem; }
            .survey-hero-badge i { font-size: 1.15rem; }
            #view-survey .survey-progress.mb-5 { margin-bottom: 0.6rem !important; }
        }

        .text-heading { color: var(--ink-900) !important; }
        .text-dark { color: var(--ink-800) !important; }
        .text-secondary, .text-muted { color: var(--ink-600) !important; }

        .section-title {
            border-left: 4px solid var(--brand);
            padding-left: 16px;
            padding-top: 2px;
            padding-bottom: 2px;
        }

        .section-title h4 { letter-spacing: .02em; }
        .section-title p { max-width: 62ch; }

        /* ---- Soft question/info blocks (formerly bg-light) ---- */
        .qa-block {
            background: #f8fafc;
            border: 1px solid var(--line) !important;
            border-left: 4px solid var(--brand) !important;
            border-radius: 16px !important;
            box-shadow: 0 6px 18px -14px rgba(15,23,42,0.25);
            transition: box-shadow .2s ease, transform .2s ease;
        }
        .qa-block:hover { box-shadow: 0 10px 26px -16px rgba(37,84,199,0.35); }
        .qa-block + .qa-block { margin-top: 1.1rem; }
        .qa-block > p:first-child { margin-bottom: 1.1rem; }
        [data-bs-theme="dark"] .qa-block { border-left-color: var(--brand-light) !important; }

        .option-card {
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 16px 18px 16px 16px;
            transition: border-color .15s ease, background .15s ease, box-shadow .15s ease, transform .15s ease;
            cursor: pointer;
            background: var(--surface);
            line-height: 1.45;
            position: relative;
        }

        .option-card:hover {
            background: #f5f8ff;
            border-color: #b6c8f2;
            transform: translateY(-2px) scale(1.005);
            box-shadow: 0 8px 20px -12px rgba(37, 84, 199, 0.35);
        }

        .option-card:has(input:checked) {
            background: #eef3fe;
            border-color: var(--brand);
            box-shadow: 0 0 0 3px var(--ring), 0 8px 20px -10px rgba(37, 84, 199, 0.4);
            transform: scale(1.01);
        }
        .option-card:has(input:checked)::after {
            content: '\f26e'; font-family: 'bootstrap-icons'; position: absolute; top: 10px; right: 12px;
            color: var(--brand); font-size: 1rem; animation: optionPop .25s ease;
        }
        @keyframes optionPop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        [data-bs-theme="dark"] .option-card:has(input:checked) { background: rgba(37,84,199,0.16); }

        .option-card:active { transform: scale(0.99); }

        /* ---- Required-field validation marking ----
           Leaf controls (text/select/date) reuse Bootstrap's own
           .is-invalid/.invalid-feedback (already loaded — no parallel style
           invented). Question GROUPS with no single control to mark
           (gender/CC1-3/SQD0-8 are radio sets) get this custom pair instead:
           the whole container gets a restrained red border/tint — never
           individual radio options — plus one small warning line. Both
           carry scroll-margin-top so scrollToInvalid()'s smooth-scroll never
           leaves the target sitting underneath the sticky topbar, on mobile
           (106px) or desktop (72px) alike, since --topbar-h already tracks
           the right value for either. */
        .invalid-feedback { scroll-margin-top: calc(var(--topbar-h) + 12px); }
        .answer-group-invalid {
            scroll-margin-top: calc(var(--topbar-h) + 12px);
        }
        .qa-block.answer-group-invalid {
            border-color: #dc3545 !important;
            border-left-color: #dc3545 !important;
            background: rgba(220,53,69,0.045) !important;
        }
        .col-md-6.answer-group-invalid {
            border: 1px solid #dc3545;
            border-radius: 12px;
            padding: 0.5rem 0.6rem;
            background: rgba(220,53,69,0.04);
        }
        #sqd-body tr.answer-group-invalid {
            outline: 2px solid #dc3545;
            outline-offset: -1px;
            background: rgba(220,53,69,0.045);
        }
        [data-bs-theme="dark"] .qa-block.answer-group-invalid,
        [data-bs-theme="dark"] .col-md-6.answer-group-invalid,
        [data-bs-theme="dark"] #sqd-body tr.answer-group-invalid { background: rgba(220,53,69,0.12); }
        .answer-group-msg {
            display: flex; align-items: center; gap: 0.35rem;
            color: #dc3545; font-size: 0.82rem; font-weight: 600;
            margin-top: 0.65rem;
        }
        .answer-group-msg::before { content: '\26A0'; font-size: 0.9rem; }
        #sqd-body td.text-start .answer-group-msg { margin-top: 0.4rem; }

        /* ---- Citizen's Charter (CC1/CC2/CC3) on phones ----
           .qa-block (24px padding, unmodified since desktop) and .option-card
           (16-18px padding, Bootstrap default h4/p sizes above them) were
           never given a mobile-specific reduction — on a 360-430px phone
           that reads as a desktop card simply squeezed narrower rather than
           an actual compact mobile layout. Sizes below land inside the
           12-16px option padding / 18-21px heading / 15-17px option-label /
           14-16px supporting-text ranges. Selected-state border/ring/check
           icon and tap-target sizing are untouched — only spacing/type scale
           shrinks. */
        @media (max-width: 576px) {
            .section-title { padding-left: 12px; }
            .section-title h4 { font-size: 1.1rem; }
            .section-title p { font-size: 0.88rem; line-height: 1.4; }

            /* Second density pass: 16px/14.4px card padding and 11-12px
               option padding both still ran over the 10-12px card-padding
               / 8-10px-vertical,10-12px-horizontal option-padding targets;
               question text bumped to a real 600 weight + 1.35 line-height
               (was inheriting the block's normal-weight body text). */
            /* Round-2 density pass: pushed further past round-1's numbers
               per direct phone-screenshot feedback ("still a bit big"). */
            .qa-block { padding: 0.55rem 0.55rem !important; }
            .qa-block + .qa-block { margin-top: 0.7rem; }
            .qa-block > p:first-child {
                font-size: 0.89rem; font-weight: 600; line-height: 1.3;
                margin-bottom: 0.5rem !important;
            }

            .option-card { padding: 7px 9px; border-radius: 9px; min-height: 36px; }
            .option-card span { font-size: 0.85rem; }
            .option-card:has(input:checked)::after { top: 7px; right: 9px; font-size: 0.85rem; }
            /* Selected state: border/shadow both dialed back — the desktop
               values (1px border relying on color alone, a 3px solid ring)
               read as a heavy "giant rounded card" highlight once cards are
               this compact. Border-width now explicit (1.5px) and the ring
               shadow narrowed + softened. */
            .option-card:has(input:checked) {
                border-width: 1.5px;
                box-shadow: 0 0 0 2px rgba(37,84,199,0.18), 0 2px 8px -6px rgba(37,84,199,0.3);
            }
            /* CC1 uses a `.d-grid.gap-3` stack, CC2/CC3 use `.row.g-3` —
               both resolve to 1rem (16px) between options, wider than the
               5-6px round-2 target and one more source of "everything is a
               little too spaced out" on a phone. Bootstrap's gap/gutter
               utilities are plain custom-property assignments (not
               !important here), so a scoped override is enough without
               touching desktop. */
            #stage3 .d-grid.gap-3 { gap: 0.35rem !important; }
            #stage3 .row.g-3 { --bs-gutter-y: 0.35rem; --bs-gutter-x: 0.35rem; }
        }
        @media (max-width: 400px) {
            .qa-block { padding: 0.5rem 0.5rem !important; }
            .option-card { padding: 6px 8px; min-height: 34px; }
        }

        .form-check-input {
            transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        }
        .form-check-input:checked {
            transform: scale(1.08);
        }

        /* ---- Form controls ---- */
        .form-control, .form-select {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: .7rem .95rem;
            color: var(--ink-800);
            background-color: var(--surface);
            transition: border-color .15s ease, box-shadow .15s ease;
        }
        .row.g-4 > * { padding-top: 0.15rem; }
        .form-label { margin-bottom: .5rem; font-size: .88rem; letter-spacing: .01em; }

        .form-control:focus, .form-select:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 4px var(--ring);
            outline: none;
        }

        .form-check-input {
            border: 1.5px solid var(--ink-400);
            border-radius: 5px;
        }

        /* The generic border-radius above squares off Bootstrap's pill-shaped
           switch knob (e.g. the Autofill toggle) — restore it here so the
           switch still renders/slides like a switch instead of a checkbox. */
        .form-switch .form-check-input {
            border-radius: 2em;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 4px var(--ring);
            border-color: var(--brand);
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .form-label { color: var(--ink-800); }

        /* ---- Buttons ---- */
        .btn {
            border-radius: 50px;
            font-weight: 600;
            transition: transform .12s ease, box-shadow .15s ease, background-color .15s ease, border-color .15s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--brand), var(--brand-dark));
            border: 1.5px solid var(--brand-dark);
            box-shadow: 0 4px 12px -4px rgba(37, 84, 199, 0.45);
        }

        .btn-primary:hover, .btn-primary:focus {
            background: linear-gradient(135deg, var(--brand-dark), var(--brand-dark));
            border: 1.5px solid var(--brand-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px -8px rgba(37, 84, 199, 0.6);
        }
        .btn-primary:active { transform: translateY(0); }

        /* ---- ROOT CAUSE of the "Submit Again button disappears" bug ----
           This rule used to apply the SAME muted styling to both variants:
           border-color: var(--line) (#e2e8f0 in light mode — a near-white
           gray) and color: var(--ink-800) (dark slate text), with NO
           background fill (outline buttons are transparent by default).
           That reads fine for .btn-outline-secondary (Back/Cancel-style
           actions, meant to look quiet) but for .btn-outline-primary — the
           "Submit Again" button on the Thank You page — a near-invisible
           light-gray 1.5px border on a white card, with no fill, visually
           IS just floating text with no perceptible button container.
           Split the two: secondary keeps its quiet neutral look;
           primary gets a real, visible brand-colored border + text (and a
           filled hover/active state), same brand color already used by
           .btn-primary elsewhere, so it reads as a real (if lighter-weight)
           call-to-action button instead of an accidentally-invisible one. */
        .btn-outline-secondary {
            border-color: var(--line);
            color: var(--ink-800);
        }
        .btn-outline-primary {
            border: 1.5px solid var(--brand);
            color: var(--brand);
            background: var(--surface);
        }

        .btn-outline-secondary:hover {
            transform: translateY(-1px);
        }
        .btn-outline-primary:hover, .btn-outline-primary:focus {
            background: var(--brand);
            color: #fff;
            border-color: var(--brand);
            transform: translateY(-1px);
        }
        .btn-outline-primary:active { transform: translateY(0); }

        .btn:disabled { transform: none; }

        /* ---- SQD table ---- */
        .table td, .table th { vertical-align: middle; }
        textarea { resize: none; }

        #sqd-table-wrap {
            border: 1px solid var(--line) !important;
            border-radius: 16px !important;
            /* overflow: hidden here (an ID selector) was silently overriding
               Bootstrap's .table-responsive overflow-x: auto — the table
               could never actually scroll horizontally, so the last column
               (N/A) was permanently clipped off-screen on any viewport too
               narrow for all 7 columns, not just small phones. Only clip
               vertically now (still rounds the table's square corners to
               match this wrapper's border-radius), let horizontal scroll
               through. */
            overflow-x: auto;
            overflow-y: hidden;
        }

        #sqd-table-wrap table { margin-bottom: 0; }

        #sqd-table-wrap thead th {
            background: var(--ink-900);
            color: #f1f5f9;
            font-weight: 600;
            border-color: var(--ink-900);
            padding: 0.9rem 0.6rem;
        }

        #sqd-body td.text-start {
            font-size: 0.9rem;
            line-height: 1.45;
            padding-left: 1.25rem;
            padding-right: 1rem;
            color: var(--ink-800);
        }

        #sqd-body tr { transition: background 0.15s ease; }
        #sqd-body tr:nth-child(even) { background: rgba(37, 84, 199, 0.025); }
        #sqd-body tr:hover { background: rgba(37, 84, 199, 0.06); }
        [data-bs-theme="dark"] #sqd-body tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }
        [data-bs-theme="dark"] #sqd-body tr:hover { background: rgba(96, 141, 255, 0.08); }

        #sqd-body .radio-custom { width: 20px; height: 20px; transition: transform 0.15s ease; }
        #sqd-body .radio-custom:hover { transform: scale(1.2); }
        #sqd-body .radio-custom:checked { transform: scale(1.25); }

        #sqd-table-wrap thead th { transition: background 0.15s ease, transform 0.15s ease; cursor: default; }
        #sqd-table-wrap thead th:not(:first-child):hover { transform: scale(1.06); }

        #sqd-body td:not(.text-start) { transition: background 0.2s ease; border-radius: 6px; }
        #sqd-body td:not(.text-start):has(.radio-custom:checked) { background: rgba(37, 84, 199, 0.1); }
        #sqd-body td:has(input[value="5"]:checked),
        #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.14) !important; }
        #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.16) !important; }
        #sqd-body td:has(input[value="2"]:checked),
        #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.14) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="5"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="4"]:checked) { background: rgba(34, 197, 94, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="3"]:checked) { background: rgba(234, 179, 8, 0.22) !important; }
        [data-bs-theme="dark"] #sqd-body td:has(input[value="2"]:checked),
        [data-bs-theme="dark"] #sqd-body td:has(input[value="1"]:checked) { background: rgba(239, 68, 68, 0.22) !important; }

        /* --- DARK MODE STYLES --- */
        [data-bs-theme="dark"] {
            --page-bg: #0b1220;
            --surface: #161f2e;
            --line: #2a3444;
            --line-soft: #22293a;
            --ink-900: #f1f5f9;
            --ink-800: #e2e8f0;
            --ink-600: #94a3b8;
            --ink-400: #64748b;
            --ring: rgba(96, 141, 255, 0.25);
        }
        [data-bs-theme="dark"] body { color: var(--ink-800); }
        [data-bs-theme="dark"] .survey-card { box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.5); }
        [data-bs-theme="dark"] .qa-block { background: #101827; }
        [data-bs-theme="dark"] .bg-white { background-color: var(--surface) !important; }
        [data-bs-theme="dark"] .option-card { background: #101827; color: var(--ink-800); }
        [data-bs-theme="dark"] .option-card:hover { background: #17233a; border-color: var(--brand); }
        [data-bs-theme="dark"] .option-card:has(input:checked) { background: #17233a; }
        [data-bs-theme="dark"] .bg-primary-subtle { background-color: rgba(37, 84, 199, 0.18) !important; }
        [data-bs-theme="dark"] .form-select, [data-bs-theme="dark"] .form-control { background-color: #101827; color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] .table { --bs-table-bg: transparent; --bs-table-color: var(--ink-800); border-color: var(--line); }
        [data-bs-theme="dark"] #sqd-table-wrap thead th { background: #050a13; }
        [data-bs-theme="dark"] #terms-box { background-color: var(--surface) !important; border-color: var(--line) !important; }
        [data-bs-theme="dark"] .review-doc-paper { background: var(--surface); border-color: var(--line); }
        [data-bs-theme="dark"] .review-doc-header { background: var(--surface); }
        [data-bs-theme="dark"] .survey-progress { background: #101827; border-color: var(--line); }

        summary { list-style: none; outline: none; }
        summary::-webkit-details-marker { display: none; }

        /* ---- SQD rating table on small phones ----
           7 columns (statement + 5 ratings + N/A) crammed into a phone
           screen meant the last column(s) were only ever readable by
           scrolling the table sideways — awkward on a form, and easy to
           submit without ever having seen "Strongly Disagree" or "N/A" at
           all. Below 700px the table stops being a table visually: each
           row becomes its own card (statement as a heading, then every
           rating option stacked as a full-width tappable row with its own
           emoji + label), so nothing is ever off-screen. The radios/values/
           name attributes are untouched — same form, same JS, same
           renderSQD() — this is purely a CSS reflow. */
        @media (max-width: 700px) {
            #sqd-table-wrap { overflow-x: visible; border-radius: 0 !important; border: none !important; background: transparent !important; }
            #sqd-table-wrap table,
            #sqd-table-wrap thead,
            #sqd-table-wrap tbody,
            #sqd-table-wrap tr,
            #sqd-table-wrap td { display: block; width: 100%; }
            #sqd-table-wrap thead { display: none; }

            #sqd-body tr {
                background: var(--surface);
                border: 1px solid var(--line);
                border-radius: 14px;
                margin-bottom: 1rem;
                overflow: hidden;
            }
            #sqd-body tr:last-child { margin-bottom: 0; }
            #sqd-body tr:nth-child(even) { background: var(--surface); }

            #sqd-body td.text-start {
                font-weight: 600;
                font-size: 0.92rem;
                padding: 0.95rem 1rem;
                border-bottom: 1px solid var(--line-soft);
                background: var(--page-bg);
            }

            #sqd-body td.sqd-rating-cell { border-top: none; border-radius: 0 !important; }
            #sqd-body td.sqd-rating-cell + td.sqd-rating-cell { border-top: 1px solid var(--line-soft); }

            #sqd-body .sqd-rating-option {
                justify-content: flex-start;
                gap: 0.75rem;
                padding: 0.85rem 1rem;
                min-height: 48px;
            }
            .sqd-rating-text {
                display: inline-block;
                font-size: 0.88rem;
                font-weight: 600;
                color: var(--ink-800);
                text-align: left;
            }
            #sqd-body .radio-custom { width: 20px; height: 20px; flex-shrink: 0; }
        }

        /* ---- SQD cards, further compacted on true phones ----
           The ≤700px reflow above (statement heading + stacked rating rows)
           already prevents horizontal overflow, but its padding/type scale
           was still desktop-derived and reads as oversized on a 360-430px
           phone specifically — same complaint category as the CC cards.
           Applies to every SQD0-SQD8 row identically since renderSQD()
           builds every row from the same ratingCell()/markup, so nothing
           here can apply unevenly across questions. Touch targets stay
           ≥42-44px; only spacing/type shrinks further. */
        @media (max-width: 576px) {
            #sqd-body tr { border-radius: 12px; margin-bottom: 0.55rem; }
            /* Round-2 density pass: pushed past round-1's numbers per
               direct phone-screenshot feedback. */
            #sqd-body td.text-start { font-size: 0.88rem; line-height: 1.3; padding: 0.5rem 0.6rem; }
            #sqd-body .sqd-rating-option { padding: 0.3rem 0.6rem; min-height: 36px; gap: 0.4rem; }
            .sqd-rating-text { font-size: 0.83rem; }
            #sqd-body .radio-custom { width: 19px; height: 19px; }
            /* Mobile rating rows rely on the text label ("Strongly Agree",
               "N/A", ...) plus the checked/selected styling already applied
               to the row — the decorative emoji face next to it is dropped
               here so the option reads as clean text, not text+icon.
               Desktop keeps its emoji (table header, untouched by this
               breakpoint since the header is display:none below 700px
               anyway). renderSQD() still emits the emoji in its own span
               (see js) — this just hides it visually on phones. */
            .sqd-emoji { display: none; }
        }
        @media (max-width: 400px) {
            /* 375px (an explicitly required test width) falls inside this
               breakpoint too — text sizes are intentionally left matching
               the ≤576px rule above (15-16px / 14-15px targets) here; only
               padding/min-height trims further for the very tightest phones. */
            #sqd-body td.text-start { padding: 0.45rem 0.5rem; }
            #sqd-body .sqd-rating-option { padding: 0.26rem 0.5rem; min-height: 34px; gap: 0.35rem; }
        }

        /* ---- SweetAlert2 dialogs (logout confirmation, profile/history
           error alerts, etc.) on phones ----
           SweetAlert2's defaults (32em/512px popup, a large 5em icon, big
           title/margins) were designed for desktop and read as a full-page
           takeover on a 360-430px phone even for a two-line "Are you sure
           you want to logout?" prompt. Compacted down to a normal mobile
           confirmation-dialog size; the dimmed backdrop (.swal2-container's
           own overlay) is untouched. */
        @media (max-width: 480px) {
            .swal2-popup {
                width: calc(100vw - 2.5rem) !important;
                max-width: 340px;
                padding: 1.1rem 1.1rem 1.35rem !important;
                border-radius: 18px !important;
            }
            .swal2-icon {
                width: 3.2em !important; height: 3.2em !important;
                margin: 0.5em auto 0.85em !important;
            }
            .swal2-title { font-size: 1.05rem !important; padding: 0 0.4rem; margin-bottom: 0.3rem !important; }
            .swal2-html-container { font-size: 0.86rem !important; margin: 0.4rem 0.5rem 0 !important; }
            .swal2-actions { margin-top: 1.1rem !important; gap: 0.6rem; }
            .swal2-styled { padding: 0.6rem 1rem !important; font-size: 0.86rem !important; min-height: 40px; }
        }
    </style>
</head>

<body>

<div class="survey-bg-image"></div>
<div class="survey-bg-overlay"></div>

<div class="app-shell">

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="clientSidebar">
        <div class="sidebar-brand">
            <div class="sidebar-brand-logo-wrap">
                <img src="/images/cspc-logo.png" alt="CSPC Logo">
            </div>
            <div class="sidebar-brand-text">
                <div class="t1">CQA Client Portal</div>
                <div class="t2">CSPC Nabua, Cam. Sur</div>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="#" data-view="home" class="nav-item-link active" onclick="return switchView('home');"><i class="bi bi-house-door-fill"></i> Home</a>
            <a href="#" data-view="survey" class="nav-item-link" onclick="return switchView('survey');"><i class="bi bi-clipboard2-check-fill"></i> Take Survey</a>
            <% if (!offlineMode) { %>
            <a href="#" data-view="profile" class="nav-item-link" onclick="return switchView('profile');"><i class="bi bi-person-fill"></i> Profile</a>
            <a href="#" data-view="history" class="nav-item-link" onclick="return switchView('history');"><i class="bi bi-clock-history"></i> History</a>
            <% } else { %>
            <!-- Offline entry point only — the authenticated survey already has
                 its own Home view for this; this exists only because /survey-offline
                 has no "Home" concept of its own to return to. -->
            <a href="/" class="nav-item-link" id="offlineBackToDashboardLink" onclick="return confirmLeaveOfflineSurvey('/', event);"><i class="bi bi-house-door"></i> Back to Dashboard</a>
            <% } %>
        </nav>

        <div class="sidebar-footer">
            <% if (offlineMode) { %>
            <div class="signed-in-email" title="Not yet verified — your account is checked once you're back online">
                <i class="bi bi-wifi-off me-1"></i>Unverified — Offline
            </div>
            <% } else { %>
            <div class="signed-in-email" title="Signed in with Google">
                <i class="bi bi-google me-1"></i><%= typeof clientEmail !== 'undefined' ? clientEmail : '' %>
            </div>
            <button type="button" class="btn-logout-side" onclick="logout()"><i class="bi bi-box-arrow-right"></i> Logout</button>
            <% } %>
        </div>
    </aside>

    <div class="main-content">

        <header class="topbar">
            <button type="button" class="topbar-hamburger" onclick="toggleSidebar()" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>
            <button type="button" id="btn-sidebar-collapse" class="btn-sidebar-toggle" onclick="toggleSidebarCollapse()" title="Collapse sidebar — focus on the survey" aria-label="Collapse sidebar">
                <i class="bi bi-list"></i>
            </button>
            <div class="topbar-title">
                Home
                <small data-i18n="gov_rep">Republic of the Philippines</small>
            </div>
            <!-- Notification bell + fullscreen: a direct topbar child (not nested
                 inside topbar-row2 below) so it ALWAYS stays on row 1, to the
                 right of the title — on every width, including mobile. This is
                 the one group that must never drop to a second row. -->
            <div class="topbar-icon-group">
                <% if (!offlineMode) { %>
                <!-- Authenticated only — an anonymous /survey-offline visitor has no
                     account session to fetch notifications for. -->
                <div class="notif-bell-wrap">
                    <button id="btn-notif-bell" type="button" class="btn-fullscreen" title="Notifications" aria-label="Notifications" onclick="toggleNotificationPanel()">
                        <i class="bi bi-bell"></i>
                        <span id="notifUnreadBadge" class="notif-unread-badge" hidden>0</span>
                    </button>
                    <div id="notifPanel" class="notif-panel" hidden>
                        <div class="notif-panel-header">
                            <span class="fw-semibold">Notifications</span>
                            <div class="notif-panel-header-actions">
                                <button type="button" class="btn btn-link btn-sm p-0" onclick="markAllNotificationsRead()">Mark all read</button>
                                <button type="button" class="btn btn-link btn-sm p-0 text-danger" onclick="clearAllNotifications()">Clear all</button>
                            </div>
                        </div>
                        <div id="notifList" class="notif-list"></div>
                    </div>
                </div>
                <% } %>
                <button id="btn-fullscreen" type="button" onclick="toggleFullscreen()" class="btn-fullscreen" title="Toggle full screen" aria-label="Toggle full screen">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
            </div>
            <!-- Offline status + language toggle: on desktop this behaves exactly
                 like a normal topbar item (display:contents — see CSS), same as
                 before. On mobile (≤576px) it becomes a real second row, since
                 neither of these belongs next to the bell/fullscreen anymore —
                 see the ≤576px topbar rules. Either child can independently be
                 hidden (offline pill only shown while offline; language toggle
                 only shown on the survey view) without leaving a lopsided row. -->
            <div class="topbar-row2">
                <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection — your answers are saved on this device and will sync automatically once you're back online.">
                    <span class="dot"></span><span class="label"><span class="label-full">Viewing </span>Offline</span>
                </span>
                <div class="lang-toggle-group d-none" id="lang-toggle-group">
                    <button id="btn-en" type="button" onclick="setLanguage('en')" class="btn btn-primary btn-sm fw-semibold shadow-sm" aria-label="English" title="English">
                        <span class="lang-btn-full">English</span><span class="lang-btn-short">EN</span>
                    </button>
                    <button id="btn-tl" type="button" onclick="setLanguage('tl')" class="btn bg-transparent border btn-sm fw-semibold shadow-sm text-body" aria-label="Tagalog" title="Tagalog">
                        <span class="lang-btn-full">Tagalog</span><span class="lang-btn-short">TL</span>
                    </button>
                </div>
            </div>
        </header>

        <div class="content-body">

        <% if (offlineMode) { %>
        <!-- Shown by showBackOnlineBanner() (pwa-client.js-adjacent script below)
             when the 'online' event fires on THIS page. Deliberately never
             auto-navigates or reloads — see confirmLeaveOfflineSurvey() — so an
             in-progress survey, the RAM-only password, and any already-queued
             IndexedDB records all survive regardless of what the user picks. -->
        <div id="backOnlineBanner" class="back-online-banner" hidden>
            <div class="back-online-banner-title"><i class="bi bi-wifi"></i> You're Back Online</div>
            <p class="back-online-banner-text">Your internet connection has been restored. Offline responses will synchronize automatically when eligible.</p>
            <div class="back-online-banner-actions">
                <button type="button" class="btn btn-sm btn-primary" onclick="confirmLeaveOfflineSurvey('/')">Go to Dashboard</button>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="confirmLeaveOfflineSurvey('/login')">Login</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="dismissBackOnlineBanner()">Stay Here</button>
            </div>
        </div>
        <% } %>

        <div class="app-view active" id="view-home">
        <div class="card border-0 view-card home-card">
        <div class="card-body p-4 p-md-5">

            <div class="home-hero text-center mb-5">
                <div class="brand-intro">
                    <div class="brand-intro-mark">
                        <img src="/images/cspc-logo.png" alt="CSPC Logo" class="survey-hero-logo">
                    </div>
                    <div class="brand-intro-name">
                        <div class="survey-hero-eyebrow" data-i18n="gov_rep">Republic of the Philippines</div>
                        <h2 class="fw-bold text-heading survey-hero-title mb-0" data-i18n="home_title">Center for Quality Assurance</h2>
                    </div>
                </div>
                <p class="text-secondary mb-0 mt-3 home-subtitle-anim" data-i18n="home_subtitle">Public Transparency &amp; Client Satisfaction Portal — Camarines Sur Polytechnic Colleges</p>
            </div>

            <div class="row g-4 mb-2">
                <div class="col-12 col-lg-6">
