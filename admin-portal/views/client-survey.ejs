                </div>
            </div>

            <form id="surveyForm">

                <div id="stage1" class="page active">
                    <div class="qa-block p-4 text-center mb-4">
                        <h4 class="fw-semibold text-heading mb-3" data-i18n="s1_head">Help us serve you better!</h4>
                        <p class="text-secondary mb-0 fs-6 mobile-section-desc" data-i18n="s1_desc"></p>
                    </div>

                    <div id="terms-box" class="mb-4 bg-white border rounded-4 p-4">
                        <div class="text-center mb-3">
                            <span class="fw-semibold text-heading fs-5" data-i18n="terms_title">Terms and Conditions</span>
                            <p class="text-secondary small mb-0 mt-2 mobile-section-desc" data-i18n="terms_summary"></p>
                        </div>

                        <ul id="terms-points-list" class="text-secondary small mb-3 ps-4"></ul>

                        <div class="text-center mb-3">
                            <button type="button" class="btn btn-outline-primary btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#termsModal" title="Read the full Terms and Conditions / Privacy Policy">
                                <span data-i18n="terms_read_btn"></span>
                            </button>
                        </div>

                        <div id="termsAgreeRow" class="form-check d-flex align-items-start gap-2 justify-content-center border-top pt-3">
                            <input class="form-check-input mt-1" type="checkbox" id="agreeTermsStage1">
                            <label class="form-check-label text-dark fs-6" for="agreeTermsStage1">
                                <span data-i18n="terms_checkbox">I Agree to the Terms &amp; Conditions and Privacy Policy</span>
                            </label>
                        </div>
                    </div>

                    <button type="button" id="btnStartSurvey" onclick="navigate(2)" class="btn btn-primary w-100 py-3 fw-semibold" disabled>
                        <span data-i18n="btn_start"></span>
                    </button>
                </div>

                <div id="stage2" class="page">
                    <div id="clientProfileHeader" class="section-title mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <h4 class="fw-semibold text-heading text-uppercase mb-0" data-i18n="client_prof">Client Profile</h4>
                        <div class="form-check form-switch mb-0" title="Fill in Name, Sex, Age, and Region from your account's previous answers">
                            <input class="form-check-input" type="checkbox" role="switch" id="switchAutofillProfile" onchange="toggleAutofillClientProfile(this.checked)">
                            <label class="form-check-label fw-semibold text-dark" for="switchAutofillProfile">Autofill</label>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- IDINAGDAG: Pangalan -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_name">Name (Optional)</label>
                            <input type="text" name="respondent_name" class="form-control" data-i18n-placeholder="ph_name" placeholder="Optional — leave blank to remain anonymous">
                        </div>

                        <% if (offlineMode) { %>
                        <!-- Offline mode: there is no authenticated session to pull an email
                             from, so this is a plain required field instead of the hidden/
                             readonly one below — see §5 in server.js's verify-and-sync route
                             for why "email," never "username." Nothing here is verified yet;
                             that only happens once back online. -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" for="offlineEmailInput">Registered CSPC Email / Gmail</label>
                            <input type="email" name="email" id="offlineEmailInput" class="form-control" placeholder="e.g. juan.delacruz@my.cspc.edu.ph" required>
                            <p class="field-hint mb-0 mt-1" style="font-size:0.78rem;color:var(--ink-600);">Your account will be verified securely once an internet connection is available.</p>
                        </div>
                        <!-- Deliberately no `name` attribute — this field must never be able to
                             enter the survey's FormData/payload object, even by accident. The
                             password is read directly from this input by submitAll() and kept
                             only in page memory (see rememberOfflineCredential in pwa-client.js);
                             it is never written to IndexedDB, localStorage, sessionStorage, a
                             cookie, or any request body other than the one verify-and-sync call
                             made once connectivity returns. -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" for="offlinePasswordInput">Password</label>
                            <input type="password" id="offlinePasswordInput" class="form-control" autocomplete="current-password" placeholder="Your account password" required>
                            <p class="field-hint mb-0 mt-1" style="font-size:0.78rem;color:var(--ink-600);">Your password is used only to verify your registered account when internet connectivity becomes available. It is never permanently stored.</p>
                        </div>
                        <div class="col-12">
                            <div id="offlineVerifyFailedBanner" hidden style="background:#fff3f3;border:1px solid #f5c2c2;border-radius:8px;padding:0.6rem 0.9rem;font-size:0.85rem;color:#7a1f1f;"></div>
                        </div>
                        <!-- Terminal eligibility_conflict state (see updateEligibilityConflictBanner
                             in pwa-client.js) — NOT an authentication problem (password already
                             verified), so this is deliberately styled/worded differently from the
                             verify-failed banner above and never offers a password retry. -->
                        <div class="col-12">
                            <div id="offlineEligibilityConflictBanner" hidden style="background:#fff8e6;border:1px solid #f0d9b5;border-radius:8px;padding:0.6rem 0.9rem;font-size:0.85rem;color:#6b5a1e;"></div>
                        </div>
                        <!-- Filled in by applyOfflineAccountContext() once the email field
                             loses focus — reports whether this device has a cached profile/
                             eligibility snapshot for that account (from a prior authenticated
                             online session), never a list of other accounts ever used here. -->
                        <div class="col-12">
                            <div id="offlineAccountContextNote" style="background:#eef2ff;border:1px solid #c7d2fe;border-radius:8px;padding:0.6rem 0.9rem;font-size:0.82rem;color:#3730a3;"></div>
                        </div>
                        <% } else { %>
                        <!-- Signed-in Google account (used to enforce 1 survey per office). Visually hidden
                             per design request — the value is still bound, readonly, and submitted with the
                             form normally; `d-none` only removes it from layout/view, not from FormData. -->
                        <div class="col-md-6 d-none">
                            <label class="form-label fw-semibold text-dark fs-6">Google Account</label>
                            <input type="email" name="email" class="form-control" value="<%= typeof clientEmail !== 'undefined' ? clientEmail : '' %>" readonly>
                        </div>
                        <% } %>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_client_type"></label>
                            <!-- IDINAGDAG ANG name="client_type" AT value="" -->
                            <select name="client_type" class="form-select">
                                <option value="" disabled selected data-i18n="opt_select_client_type"></option>
                                <option value="Citizen" data-i18n="opt_citizen"></option>
                                <option value="Business" data-i18n="opt_business"></option>
                                <option value="Government" data-i18n="opt_gov"></option>
                                <option value="Student" data-i18n="opt_student"></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_sex"></label>
                            <i id="gender-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <select name="gender" class="form-select">
                                <option value="" disabled selected data-i18n="opt_select_gender"></option>
                                <option value="Male" data-i18n="lbl_male"></option>
                                <option value="Female" data-i18n="lbl_female"></option>
                                <option value="Prefer not to say" data-i18n="lbl_prefer_not_say"></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_age"></label>
                            <i id="age-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <!-- IDINAGDAG ANG name="age" AT value="" SA MGA OPTIONS -->
                            <select name="age" class="form-select">
                                <option value="" selected disabled data-i18n="opt_sel_age"></option>
                                <option value="18 and below" data-i18n="opt_18_below"></option>
                                <option value="19-24">19-24</option>
                                <option value="25-39">25-39</option>
                                <option value="40-59">40-59</option>
                                <option value="60 and above" data-i18n="opt_60_above"></option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_date"></label>
                            <input type="date" id="surveyDate" name="survey_date" class="form-control" readonly onkeydown="return false;" style="background-color: var(--line-soft); cursor: not-allowed;">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark fs-6" for="officeVisitedTime" data-i18n="lbl_office_visited_time"></label>
                            <input type="datetime-local" id="officeVisitedTime" name="office_visited_time" class="form-control" required>
                            <div class="form-text" data-i18n="hint_office_visited_time"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_region"></label>
                            <i id="region-lock-note" class="bi bi-lock-fill lock-icon d-none" data-bs-toggle="tooltip" data-bs-placement="top" title="You have already answered this section. It is now locked."></i>
                            <!-- IDINAGDAG ANG name="region" AT value="" SA MGA OPTIONS -->
                            <select name="region" class="form-select">
                                <option value="" disabled selected data-i18n="opt_select_region"></option>
                                <option value="NCR - National Capital Region">NCR - National Capital Region</option>
                                <option value="CAR - Cordillera Administrative Region">CAR - Cordillera Administrative Region</option>
                                <option value="Region I - Ilocos Region">Region I - Ilocos Region</option>
                                <option value="Region II - Cagayan Valley">Region II - Cagayan Valley</option>
                                <option value="Region III - Central Luzon">Region III - Central Luzon</option>
                                <option value="Region IV-A - CALABARZON">Region IV-A - CALABARZON</option>
                                <option value="MIMAROPA Region">MIMAROPA Region</option>
                                <option value="Region V - Bicol Region">Region V - Bicol Region</option>
                                <option value="Region VI - Western Visayas">Region VI - Western Visayas</option>
                                <option value="Region VII - Central Visayas">Region VII - Central Visayas</option>
                                <option value="Region VIII - Eastern Visayas">Region VIII - Eastern Visayas</option>
                                <option value="Region IX - Zamboanga Peninsula">Region IX - Zamboanga Peninsula</option>
                                <option value="Region X - Northern Mindanao">Region X - Northern Mindanao</option>
                                <option value="Region XI - Davao Region">Region XI - Davao Region</option>
                                <option value="Region XII - SOCCSKSARGEN">Region XII - SOCCSKSARGEN</option>
                                <option value="Region XIII - Caraga">Region XIII - Caraga</option>
                                <option value="BARMM - Bangsamoro">BARMM - Bangsamoro Autonomous Region in Muslim Mindanao</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark fs-6" data-i18n="lbl_office"></label>
                            <select id="officeSelect" name="office_id" class="form-select fs-6" required>
                                <option value="" selected disabled data-i18n="s1_ph">Select Office...</option>
                                <% if (typeof offices !== 'undefined') { %>
                                    <% offices.forEach(office => { %>
                                        <option value="<%= office.id %>"><%= office.office_name %> (<%= office.cluster_name %>)</option>
                                    <% }); %>
                                <% } %>
                            </select>
                        </div>

                        <div class="col-12">
                            <!--
                                The badge/notice row sits ABOVE the select, beside its label, on
                                purpose: a native <select>'s open option list overlays whatever
                                sits directly below it, so anything placed under the dropdown
                                would be invisible for as long as it's open — exactly when
                                someone is looking at it to see why a service is disabled.
                            -->
