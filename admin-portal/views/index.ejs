            tabsWrap.querySelectorAll('.cluster-tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    activeClusterIndex = parseInt(btn.dataset.index, 10);
                    tabsWrap.querySelectorAll('.cluster-tab-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    renderServicesAccordion();
                });
            });
        }

        // Level 2 (Office) + level 3 (Services) for whichever cluster tab is active.
        function renderServicesAccordion() {
            const wrap = document.getElementById('servicesAccordion');
