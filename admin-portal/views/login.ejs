<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        /* Reset and Base Styles */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden; /* Para walang lumabas na scrollbar */
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* 1. The Blurred Background Image */
        .bg-blurred {
            position: fixed; 
            top: -5%; left: -5%; right: -5%; bottom: -5%; 
            background-image: url('https://spims.cspc.edu.ph/assets/img/background.jpg'); 
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(1px);
            z-index: -1;
        }

        /* 2. The Dark Overlay */
        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(15, 23, 42, 0.6); /* Dark navy tint */
            z-index: -1;
        }

        /* 3. Perfect Centering Wrapper */
        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column; /* Para magpatong ang titles at card */
            align-items: center;    /* Centers vertically/horizontally */
            justify-content: center;   
            z-index: 1;
            padding: 1rem;
        }

        /* --- BAGONG DAGDAG NA HEADER STYLES & ANIMATIONS --- */
        
        /* Keyframes para sa Fade & Slide Up Animation */
        @keyframes fadeSlideUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-container {
            text-align: center;
            margin-bottom: 2rem;
            max-width: 800px; /* Para hindi masyadong humaba sa malaking screen */
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 2rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
            
            /* Apply animation (Mauuna) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #f8fafc;
            font-weight: 400;
            font-style: italic; /* Ibang style as requested */
            font-size: 1.1rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 1.2rem;
            
            /* Apply animation (Pangalawa, may delay na 0.3s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            color: #ffff; /* Distinct gold/yellow color para sa Admin Portal */
            font-weight: 700;
            font-size: 1.25rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;
            
            /* Apply animation (Pangatlo, may delay na 0.6s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        /* Responsive para sa Titles */
        @media (max-width: 600px) {
            .main-title {
                font-size: 1.4rem;
            }
            .sub-title {
                font-size: 0.9rem;
                margin-bottom: 1rem;
            }
            .portal-text {
                font-size: 1.1rem;
            }
        }
        /* -------------------------------------- */

        /* 4. Card Styling (Square at mas maliit - walang binago) */
        .card-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            
            /* Dito natin ginawang Square */
            width: 380px;
            height: auto;
            
            /* Para mag-center ang content sa loob ng square */
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.5rem 2rem; 
        }

        /* Responsive para sa mobile card */
        @media (max-width: 400px) {
            .card-custom {
                width: 90vw;
                height: 90vw; /* Keep it square on mobile */
                padding: 1.5rem;
            }
        }

        /* Google Button Styling */
        .btn-google {
            background-color: #ffffff;
            color: #475569;
            border: 1px solid #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            font-size: 0.9rem; 
            transition: all 0.3s ease;
        }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .btn-google img {
            width: 18px; 
            height: 18px;
        }

        /* Form Inputs Focus Effect */
        .form-control:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.25);
        }

        /* Extra small text helper */
        .text-xsmall {
            font-size: 0.75rem;
        }

        /* Home button (top-left, floating over the blurred background) */
        .btn-home {
            position: fixed;
            top: 1.25rem;
            left: 1.25rem;
            z-index: 10;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50px;
            padding: 0.5rem 1.1rem;
            font-weight: 600;
            font-size: 0.85rem;
            backdrop-filter: blur(6px);
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-home:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <a href="/" class="btn-home" title="Return to Home Page">
        <i class="fas fa-home me-1"></i> Home
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Login Portal</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-3">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" style="width: 55px; height: auto;" class="mb-2">
                <h4 class="fw-bold text-dark mb-0">CQA Portal Login</h4>
                <p class="text-muted text-xsmall mb-0">Sign in to your account</p>
            </div>

            <!-- UNIFIED LOGIN FORM (POST REQUEST) -->
            <form action="/auth-login" method="POST" id="loginForm">
                <div class="mb-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                        <input type="text" name="username" id="usernameInput" class="form-control bg-light border-start-0 ps-0" placeholder="Enter your username or email" required title="Username or Email">
                    </div>
                    <p class="text-muted text-xsmall mt-1 mb-0">Registered clients: enter the email and password you set up when you first signed in with Google.</p>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-end mb-1">
                        <a href="#" class="text-decoration-none fw-semibold text-xsmall" style="color: #4f46e5;" title="Reset your password">Forgot Password?</a>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                        <input type="password" name="password" class="form-control bg-light border-start-0 ps-0" placeholder="Enter your password" required title="Password">
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold py-2" style="background-color: #4f46e5; border-color: #4f46e5;" title="Sign in to your account">
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </form>

            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1">
                <span class="px-2 text-muted text-xsmall">OR</span>
                <hr class="flex-grow-1">
            </div>

            <!-- GOOGLE SIGN-IN (Clients) -->
            <a href="/auth/google" class="btn btn-google btn-sm w-100 fw-bold py-2" title="Sign in as a client with your Google account">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google">
                Sign in with Google
            </a>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script>
        const loginQueryParams = new URLSearchParams(window.location.search);
        const loginErrorMsg = loginQueryParams.get('error');
        const googleExists = loginQueryParams.get('googleExists');
        const googleExistsEmail = loginQueryParams.get('email');

        if (loginErrorMsg) {
            AppAlert.error(loginErrorMsg, 'Login Failed');
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (googleExists) {
            if (googleExistsEmail) {
                document.getElementById('usernameInput').value = googleExistsEmail;
            }
            AppAlert.info('Your account is already registered. Please log in using your Email and Password below.', 'Account Already Registered');
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    </script>
</body>
</html>