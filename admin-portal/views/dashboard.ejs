                            <div class="split-chart-row">
                                <div style="height: 190px; width: 190px; position: relative; flex-shrink: 0;">
                                    <canvas id="clusterShareChart"></canvas>
                                </div>
                                <div class="chart-legend-list" id="clusterShareLegend"></div>
