            p2: { overall: [0, 0], clusterSat: [0, 0, 0, 0], clusterResp: [0, 0, 0, 0], officeSat: [0, 0, 0, 0, 0, 0, 0], officeResp: [0, 0, 0, 0, 0, 0, 0], ccAware: [0, 0, 0], ccOffice: [0, 0, 0, 0, 0, 0, 0] }
        }) %>;

        let clusterLabels = <%- typeof clusterList !== 'undefined' ? JSON.stringify(clusterList) : JSON.stringify(['OP', 'A&F', 'RIC', 'Academic']) %>;
        let officeLabels = <%- typeof officeList !== 'undefined' ? JSON.stringify(officeList) : JSON.stringify(['Admin', 'CCS', 'CEA', 'CHS', 'CTHBM', 'CTDE', 'CAS']) %>;

        // Full (un-shortened) names, parallel-indexed to clusterLabels/officeLabels —
        // used only to show the full name in the tooltip when hovering a bar whose
        // axis label got shortened to an acronym (e.g. "RICC").
        let clusterFullNames = clusterLabels.slice();
        let officeFullNames = officeLabels.slice();

        // Parallel-indexed to officeList/officeLabels — the (unshortened) cluster
        // name each office belongs to. Powers the "Satisfaction By Office" cluster
        // filter dropdown so selecting a cluster narrows the chart to its offices.
        let officeClusterMap = [];
        let activeOfficeClusterFilter = 'all';

        function getVisibleOfficeIndices() {
            const allIdx = officeLabels.map((_, i) => i);
            if (activeOfficeClusterFilter === 'all') return allIdx;
            return allIdx.filter(i => officeClusterMap[i] === activeOfficeClusterFilter);
        }

        function populateOfficeClusterFilter() {
            const uniqueClusters = Array.from(new Set(clusterFullNames.filter(Boolean)));
            const optionsHtml = ['<option value="all">All Clusters</option>']
                .concat(uniqueClusters.map(c => `<option value="${c.replace(/"/g, '&quot;')}">${c}</option>`))
                .join('');
            document.querySelectorAll('.office-cluster-select').forEach(sel => {
                sel.innerHTML = optionsHtml;
                sel.value = activeOfficeClusterFilter;
            });
        }

        function setOfficeClusterFilter(value) {
            activeOfficeClusterFilter = value;
            document.querySelectorAll('.office-cluster-select').forEach(sel => {
                if (sel.value !== value) sel.value = value;
            });
            ['c3', 'c3_clone'].forEach(rawId => {
                if (activeCharts[rawId]) {
                    const backBtn = document.getElementById(rawId + '-back');
                    if (backBtn) backBtn.classList.add('d-none');
                    const canvasEl = document.getElementById(rawId);
                    const container = canvasEl ? canvasEl.closest('.canvas-container') : null;
                    if (container) {
                        container.classList.add('chart-transitioning');
                        setTimeout(() => {
                            loadChart(rawId, 'main');
                            requestAnimationFrame(() => container.classList.remove('chart-transitioning'));
                        }, 220);
                    } else {
                        loadChart(rawId, 'main');
                    }
                }
            });
        }

        // Shortens long office/cluster names to compact acronyms so chart labels never overlap.
        function shortenLabel(label) {
            if (!label || label.length <= 12) return label;
            const words = label.replace(/[()]/g, '').split(/\s+/).filter(w => w.length > 0);
            if (words.length === 1) return label.substring(0, 10) + '…';
            const skip = new Set(['of', 'the', 'and', 'for', 'de', '&']);
            const acronym = words.filter(w => !skip.has(w.toLowerCase())).map(w => w[0].toUpperCase()).join('');
            return acronym.length >= 2 ? acronym : label.substring(0, 10) + '…';
        }

        // True once the period dropdown has been built from the server's real
        // period list and defaulted to whichever period covers today. Later polls
        // (the real-time refresh below) skip rebuilding it so a period the visitor
        // picked manually isn't silently reset back to the default every refresh.
        let hasLoadedPeriodOptions = false;

        // Cached separately from CLIENT_HISTORY_CACHE_KEY/CLIENT_PROFILE_CACHE_KEY
        // in client-survey.ejs (this is public data, not per-account) — lets the
        // dashboard still show real numbers offline instead of the all-zero
        // placeholder `datasets` above, which is all a fresh page load has until
        // the first successful fetch.
        const DASHBOARD_CACHE_KEY = 'cspc_public_dashboard_cache';

        function applyDashboardData(dynamicData, fromCache) {
            if (dynamicData.clusterList && dynamicData.clusterList.length > 0) {
                clusterFullNames = dynamicData.clusterList;
                clusterLabels = dynamicData.clusterList.map(shortenLabel);
            }
            if (dynamicData.officeList && dynamicData.officeList.length > 0) {
                officeFullNames = dynamicData.officeList;
                officeLabels = dynamicData.officeList.map(shortenLabel);
            }
            if (dynamicData.officeCluster) {
                officeClusterMap = dynamicData.officeCluster;
            }
            if (dynamicData.chartData) {
                datasets = dynamicData.chartData;
            }

            populateOfficeClusterFilter();

            // Period select is built once from the real, exact period list — this
            // is what makes the dashboard "real-time": it defaults to whichever
            // period actually covers today's date (dynamicData.currentPeriod), so
            // it flips from Jan-Jun to Jul-Dec on its own once the calendar rolls
            // over. Only done on the first load — see hasLoadedPeriodOptions.
            if (!hasLoadedPeriodOptions && dynamicData.periodOptions && dynamicData.periodOptions.length > 0) {
                const periodSelect = document.getElementById('periodSelect');
                const defaultPeriod = dynamicData.currentPeriod || dynamicData.periodOptions[0].value;
                periodSelect.innerHTML = dynamicData.periodOptions.map(opt =>
                    `<option value="${opt.value}"${opt.value === defaultPeriod ? ' selected' : ''}>${opt.label}</option>`
                ).join('');
                activePeriod = defaultPeriod;
                hasLoadedPeriodOptions = true;
            }

            const offlineNoteEl = document.getElementById('dashboardOfflineNote');
            if (offlineNoteEl) offlineNoteEl.classList.toggle('d-none', !fromCache);

            changePeriod();
        }

        async function fetchDynamicDashboardData() {
            try {
                // Timeout-guarded: on a flaky connection a bare fetch() can hang far
                // longer than this dashboard's own 15s poll interval, effectively
                // stacking up pending requests instead of ever falling back to the
                // cached data below.
                const response = await fetchWithTimeout('/api/public-dashboard', {}, 5000);
                if (response.ok) {
                    const dynamicData = await response.json();
                    try { localStorage.setItem(DASHBOARD_CACHE_KEY, JSON.stringify(dynamicData)); } catch (e) { /* localStorage unavailable — offline fallback just won't apply */ }
                    applyDashboardData(dynamicData, false);
                }
            } catch (error) {
                console.error("Error fetching dynamic dashboard data, falling back to cache:", error);
                let cached = null;
                try { cached = JSON.parse(localStorage.getItem(DASHBOARD_CACHE_KEY) || 'null'); } catch (e) { /* corrupt/unavailable cache */ }
                if (cached) applyDashboardData(cached, true);
            }
        }

        fetchDynamicDashboardData();

        // Public dashboard is meant to be a live, real-time view of the database —
        // clients are watching it without reloading, so it re-polls the API on its
        // own instead of only ever fetching once at page load. Any survey submitted
        // in the meantime shows up here within this interval.
        setInterval(fetchDynamicDashboardData, 15000);

        let activePeriod = 'p1';
        let activeCharts = {};
        let chartState = {};

        function getChartConfig(rawId, view, index) {
            // Charts float directly on the hero backdrop (no card behind them), which
            // is always dark, so they always render with the light-on-dark palette —
            // independent of the site's own light/dark toggle.
            const isDark = true;
            const gridColor = 'rgba(255,255,255,0.12)';
            const textColor = isDark ? '#cbd5e1' : '#64748b';
            const dataP = datasets[activePeriod] || datasets['p1'];

            const id = rawId.replace('_clone', '');
            // Real office indices currently visible in c3's main view, given the
            // active cluster filter — chart-local (filtered) indices map through
            // this back to the real index in officeLabels/dataP.officeSat.
            const officeIndexMap = getVisibleOfficeIndices();

            let baseOptions = {
                responsive: true, maintainAspectRatio: false,
                animation: { duration: 900, easing: 'easeOutExpo' },
                plugins: {
                    legend: { labels: { color: textColor, font: { family: 'Inter', weight: '600', size: 12.5 }, usePointStyle: true, boxWidth: 8, boxHeight: 8, padding: 16 }, position: 'bottom', display: id === 'c2' || id === 'c3' ? false : true },
                    tooltip: {
                        backgroundColor: isDark ? 'rgba(15,23,42,0.97)' : 'rgba(255,255,255,0.97)',
                        titleColor: isDark ? '#f8fafc' : '#251d3a', bodyColor: isDark ? '#cbd5e1' : '#475569',
                        titleFont: { family: 'Inter', weight: '700', size: 13 }, bodyFont: { family: 'Inter', weight: '500', size: 12.5 },
                        borderColor: isDark ? 'rgba(255, 204, 0,0.25)' : 'rgba(37, 29, 58,0.08)', borderWidth: 1,
                        cornerRadius: 12, padding: 14, boxPadding: 6, caretSize: 6, displayColors: false,
                        callbacks: {
                            // Shows the full cluster/office name in the tooltip title when
                            // hovering a bar whose axis label was shortened to an acronym
                            // (e.g. "RICC" -> "Research, Innovation and Collaboration Cluster").
                            title: function(items) {
                                if (!items || items.length === 0) return '';
                                const chartId = items[0].chart.canvas.id.replace('_clone', '');
                                const idx = items[0].dataIndex;
                                // Only the main bar view's x-axis is a cluster/office name — the
                                // drilldown doughnut's labels are "Satisfied"/"Needs Improvement".
                                if (view === 'main' && chartId === 'c2' && clusterFullNames[idx]) return clusterFullNames[idx];
                                if (view === 'main' && chartId === 'c3' && officeFullNames[officeIndexMap[idx]]) return officeFullNames[officeIndexMap[idx]];
                                return items[0].label || '';
                            },
                            label: function(context) {
                                let pData = datasets[activePeriod];
                                let val = context.raw;
                                let chartId = context.chart.canvas.id.replace('_clone', '');

                                if (chartId === 'c1') {
                                    let total = pData.overall[0] + pData.overall[1];
                                    let pct = Math.round((val / total) * 100) || 0;
                                    return [`${context.label}: ${pct}%`, `Respondents: ${val}`];
                                }

                                if ((chartId === 'c2' || chartId === 'c3') && context.dataset.label && context.dataset.label.includes('Satisfaction')) {
                                    // Real percent, not context.raw — the bar's actual drawn
                                    // height is nudged up from 0 so a real (but 0%) result is
                                    // still visible, but the tooltip must report the true value.
                                    let totalResp, realPercent;
                                    if (chartId === 'c2') {
                                        totalResp = pData.clusterResp[context.dataIndex];
                                        realPercent = pData.clusterSat[context.dataIndex];
                                    } else {
                                        const realIdx = officeIndexMap[context.dataIndex];
                                        totalResp = pData.officeResp[realIdx];
                                        realPercent = pData.officeSat[realIdx];
                                    }
                                    if (realPercent === null) return ['No ratings yet', `Respondents: ${totalResp}`];
                                    let satResp = Math.round((realPercent / 100) * totalResp) || 0;
                                    return [`Satisfaction: ${realPercent}%`, `Respondents: ${satResp}`];
                                }

                                let label = context.dataset.label || context.label || '';
                                return `${label}: ${val}` + (chartId === 'c4' && context.dataset.label ? '%' : '');
                            }
                        }
                    }
                }
            };

            if (id === 'c1') {
                let sat = dataP.overall[0] || 0, dissat = dataP.overall[1] || 0, total = sat + dissat;
                let percent = total === 0 ? 0 : Math.round((sat / total) * 100);
                if (view === 'main') {
                    return { type: 'pie', data: { labels: ['Satisfied', 'Dissatisfied'], datasets: [{ data: dataP.overall, backgroundColor: ['#4ADE80', '#F87171'], borderWidth: 3, borderColor: isDark ? '#1e293b' : '#ffffff', hoverOffset: 15 }] }, options: baseOptions }
                } else {
                    return { type: 'doughnut', data: { labels: ['Satisfied', 'Dissatisfied'], datasets: [{ data: [sat, dissat], backgroundColor: ['#4ADE80', isDark ? '#334155' : '#eef1f6'], borderWidth: 0, cutout: '75%', hoverOffset: 8 }] }, options: { ...baseOptions, elements: { center: { text: percent + '%', subText: 'Total Overall Rating', subText2: `${sat} / ${total} Satisfied` } } } };
                }
            }

            const barScales = {
                x: { grid: { display: false }, border: { display: false }, ticks: { color: textColor, font: { family: 'Inter', weight: '600', size: 11.5 } } },
                y: { min: 0, max: 100, grid: { color: gridColor }, border: { display: false }, ticks: { color: textColor, font: { family: 'Inter', weight: '500', size: 11 }, callback: v => v + '%' } }
            };

            const noRatingColor = isDark ? 'rgba(148,163,184,0.35)' : 'rgba(148,163,184,0.45)';
            const noRatingHoverColor = isDark ? 'rgba(148,163,184,0.5)' : 'rgba(148,163,184,0.6)';

            if (id === 'c2') {
                if (view === 'main') {
                    // A real result of 0% would render as a 0px-tall bar, indistinguishable
                    // from a cluster with no responses at all — nudge it to a barely-visible
                    // sliver instead. null means respondents exist but all marked every SQD
                    // question N/A — also nudged visible, but colored gray, not blue.
                    const clusterBarData = dataP.clusterSat.map((v, i) => (v === null || (v <= 0 && dataP.clusterResp[i] > 0)) ? 1.5 : v);
                    return { type: 'bar', data: { labels: clusterLabels, datasets: [{ label: 'Satisfaction (%)', data: clusterBarData, backgroundColor: (c) => dataP.clusterSat[c.dataIndex] === null ? noRatingColor : barGradient(c, 'rgba(37, 29, 58,0.75)', 'rgba(90,124,214,0.9)'), hoverBackgroundColor: (c) => dataP.clusterSat[c.dataIndex] === null ? noRatingHoverColor : barGradient(c, 'rgba(37, 29, 58,0.9)', 'rgba(90,124,214,1)'), borderRadius: 10, borderSkipped: false, maxBarThickness: 46, categoryPercentage: 0.65, barPercentage: 0.75 }] }, options: { ...baseOptions, scales: barScales } };
                } else {
                    let percent = dataP.clusterSat[index], totalResp = dataP.clusterResp[index] || 0;
                    if (percent === null) {
                        return { type: 'doughnut', data: { labels: ['No Ratings Yet'], datasets: [{ data: [totalResp || 1], backgroundColor: [isDark ? '#334155' : '#eef1f6'], borderWidth: 0, cutout: '75%', hoverOffset: 8 }] }, options: { ...baseOptions, elements: { center: { text: 'N/A', subText: 'Cluster Rating', subText2: `${totalResp} Respondent(s) — No SQD Ratings` } } } };
                    }
                    let satResp = Math.round((percent / 100) * totalResp) || 0;
                    return { type: 'doughnut', data: { labels: ['Satisfied', 'Needs Improvement'], datasets: [{ data: [satResp, totalResp - satResp], backgroundColor: ['#4ADE80', isDark ? '#334155' : '#eef1f6'], borderWidth: 0, cutout: '75%', hoverOffset: 8 }] }, options: { ...baseOptions, elements: { center: { text: percent + '%', subText: 'Cluster Rating', subText2: `${satResp} / ${totalResp} Satisfied` } } } };
                }
            }

            if (id === 'c3') {
                if (view === 'main') {
                    const labels = officeIndexMap.map(i => officeLabels[i]);
                    // Same 0%-but-real-data nudge as c2 above, applied per visible office.
                    const data = officeIndexMap.map(i => {
                        const v = dataP.officeSat[i];
                        return (v === null || (v <= 0 && dataP.officeResp[i] > 0)) ? 1.5 : v;
                    });
                    const config = { type: 'bar', data: { labels, datasets: [{ label: 'Satisfaction (%)', data, backgroundColor: (c) => dataP.officeSat[officeIndexMap[c.dataIndex]] === null ? noRatingColor : barGradient(c, 'rgba(37, 29, 58,0.75)', 'rgba(90,124,214,0.9)'), hoverBackgroundColor: (c) => dataP.officeSat[officeIndexMap[c.dataIndex]] === null ? noRatingHoverColor : barGradient(c, 'rgba(37, 29, 58,0.9)', 'rgba(90,124,214,1)'), borderRadius: 10, borderSkipped: false, maxBarThickness: 40, categoryPercentage: 0.65, barPercentage: 0.75 }] }, options: { ...baseOptions, scales: barScales } };
                    config._officeIndexMap = officeIndexMap;
                    return config;
                } else {
                    let percent = dataP.officeSat[index], totalResp = dataP.officeResp[index] || 0;
                    if (percent === null) {
                        return { type: 'doughnut', data: { labels: ['No Ratings Yet'], datasets: [{ data: [totalResp || 1], backgroundColor: [isDark ? '#334155' : '#eef1f6'], borderWidth: 0, cutout: '75%', hoverOffset: 8 }] }, options: { ...baseOptions, elements: { center: { text: 'N/A', subText: 'Office Rating', subText2: `${totalResp} Respondent(s) — No SQD Ratings` } } } };
                    }
                    let satResp = Math.round((percent / 100) * totalResp) || 0;
                    return { type: 'doughnut', data: { labels: ['Satisfied', 'Needs Improvement'], datasets: [{ data: [satResp, totalResp - satResp], backgroundColor: ['#4ADE80', isDark ? '#334155' : '#eef1f6'], borderWidth: 0, cutout: '75%', hoverOffset: 8 }] }, options: { ...baseOptions, elements: { center: { text: percent + '%', subText: 'Office Rating', subText2: `${satResp} / ${totalResp} Satisfied` } } } };
                }
            }

            if (id === 'c4') {
                 if (view === 'main') {
                     return {
                         type: 'pie',
                         data: {
                             labels: ['Aware', 'Not Aware', 'Saw CC'],
                             datasets: [{ data: dataP.ccAware, backgroundColor: ['#5B8DEF', '#B8C2D6', '#FBBF24'], borderWidth: 3, borderColor: isDark ? '#1e293b' : '#ffffff', hoverOffset: 15 }]
                         },
                         options: baseOptions
                     }
                 } else {
                     return {
                         type: 'bar',
                         data: {
                             labels: officeLabels,
                             datasets: [{ label: '% Aware', data: dataP.ccOffice, backgroundColor: (c) => barGradient(c, 'rgba(255, 204, 0,0.65)', 'rgba(251,191,36,0.95)'), hoverBackgroundColor: (c) => barGradient(c, 'rgba(255, 204, 0,0.85)', 'rgba(251,191,36,1)'), borderRadius: 10, borderSkipped: false, maxBarThickness: 40, categoryPercentage: 0.65, barPercentage: 0.75 }]
                         },
                         options: { ...baseOptions, scales: barScales }
                     }
                 }
            }

        }

        // Chart.js only tooltips data points, not axis tick labels — but c2/c3's
        // tick labels are shortened acronyms (e.g. "RICC"), so hovering directly
        // over a tick should still reveal the full cluster/office name. Binds the
        // mousemove listener once per canvas; the chart instance and name-lookup
        // function are refreshed on every reload via canvas._axisChart/_axisFullNameGetter.
        function ensureAxisLabelTooltip(canvas) {
            if (canvas.dataset.axisTooltipBound) return;
            canvas.dataset.axisTooltipBound = '1';
            canvas.addEventListener('mousemove', (e) => {
                const chart = canvas._axisChart;
                const getFullName = canvas._axisFullNameGetter;
                if (!chart || !getFullName || !chart.scales || !chart.scales.x || !chart.chartArea) { canvas.title = ''; return; }
                const xScale = chart.scales.x;
                if (e.offsetY < chart.chartArea.bottom) { canvas.title = ''; return; }
                let closestIdx = -1, closestDist = Infinity;
                (xScale.ticks || []).forEach((tick, i) => {
                    const dist = Math.abs(xScale.getPixelForTick(i) - e.offsetX);
                    if (dist < closestDist) { closestDist = dist; closestIdx = i; }
                });
                canvas.title = closestIdx >= 0 ? (getFullName(closestIdx) || '') : '';
            });
            canvas.addEventListener('mouseleave', () => { canvas.title = ''; });
        }

        function loadChart(rawId, view, index = null) {
            chartState[rawId] = { view, index };
            const titleElem = document.getElementById(rawId + '-title');
            const id = rawId.replace('_clone', '');

            if (titleElem) {
                if (view === 'main') titleElem.innerText = titleElem.getAttribute('data-main');
                else {
                    let dTitle = titleElem.getAttribute('data-drill');
                    if (id === 'c2') dTitle = clusterLabels[index] + " Rating";
                    if (id === 'c3') dTitle = officeLabels[index] + " Rating";
                    titleElem.innerText = dTitle;
                }
            }

            const ctx = document.getElementById(rawId).getContext('2d');
            const config = getChartConfig(rawId, view, index);

            config.options.onClick = (e, elements) => {
                if (view === 'main' && elements.length > 0) {
                    let clickedIndex = elements[0].index;
                    if (id === 'c3' && config._officeIndexMap) clickedIndex = config._officeIndexMap[clickedIndex];
                    const baseId = rawId.replace('_clone', '');
                    const cloneId = baseId + '_clone';

                    loadChart(baseId, 'drill', clickedIndex);
                    if(document.getElementById(cloneId)) loadChart(cloneId, 'drill', clickedIndex);

                    document.getElementById(baseId + '-back').classList.remove('d-none');
                    const cloneBack = document.getElementById(cloneId + '-back');
                    if(cloneBack) cloneBack.classList.remove('d-none');
                }
            };

            if (activeCharts[rawId]) activeCharts[rawId].destroy();
            activeCharts[rawId] = new Chart(ctx, config);

            bindAxisTooltip(rawId, id, view, config);
        }

        // Wires (or rewires) the axis-label hover tooltip for a chart instance —
        // shared by loadChart (new chart) and changePeriod/refresh (same chart,
        // new data), since the latter can shift office indices without recreating
        // the Chart.js instance.
        function bindAxisTooltip(rawId, id, view, config) {
            const canvasEl = document.getElementById(rawId);
            if (!canvasEl) return;
            if (view === 'main' && (id === 'c2' || id === 'c3')) {
                ensureAxisLabelTooltip(canvasEl);
                canvasEl._axisChart = activeCharts[rawId];
                const idxMap = config._officeIndexMap;
                canvasEl._axisFullNameGetter = id === 'c2'
                    ? (i) => clusterFullNames[i]
                    : (i) => officeFullNames[idxMap ? idxMap[i] : i];
            } else {
                canvasEl._axisChart = null;
                canvasEl._axisFullNameGetter = null;
            }
        }

        function updateKpiStrip() {
            const dataP = datasets[activePeriod];
            if (!dataP) return;

            const sat = dataP.overall[0] || 0, dissat = dataP.overall[1] || 0;
            const total = typeof dataP.totalRespondents === 'number' ? dataP.totalRespondents : (sat + dissat);
            const satPct = (sat + dissat) > 0 ? Math.round((sat / (sat + dissat)) * 100) : 0;
            const awareTotal = (dataP.ccAware[0] || 0) + (dataP.ccAware[1] || 0) + (dataP.ccAware[2] || 0);
            const awarePct = awareTotal > 0 ? Math.round(((dataP.ccAware[0] || 0) + (dataP.ccAware[2] || 0)) / awareTotal * 100) : 0;
            const officesEvaluated = typeof dataP.officesEvaluated === 'number' ? dataP.officesEvaluated : 0;

            document.getElementById('kpiRespondents').innerText = total.toLocaleString();
            document.getElementById('kpiSatisfaction').innerText = satPct + '%';
            document.getElementById('kpiOffices').innerText = officesEvaluated.toLocaleString();
            document.getElementById('kpiAware').innerText = awarePct + '%';
        }

        function changePeriod() {
            activePeriod = document.getElementById('periodSelect').value;

            Object.keys(activeCharts).forEach(rawId => {
                const state = chartState[rawId];
                const newConfig = getChartConfig(rawId, state.view, state.index);
                delete activeCharts[rawId].centerAnim;
                activeCharts[rawId].data = newConfig.data;
                if(newConfig.options.elements && newConfig.options.elements.center) {
                    activeCharts[rawId].config.options.elements.center = newConfig.options.elements.center;
                }
                activeCharts[rawId].update();

                const id = rawId.replace('_clone', '');
                bindAxisTooltip(rawId, id, state.view, newConfig);
            });

            updateKpiStrip();
        }

        function goBack(rawId) {
            const baseId = rawId.replace('_clone', '');
            const cloneId = baseId + '_clone';

            delete activeCharts[baseId]?.centerAnim;
            delete activeCharts[cloneId]?.centerAnim;

            loadChart(baseId, 'main');
            if(document.getElementById(cloneId)) loadChart(cloneId, 'main');

            document.getElementById(baseId + '-back').classList.add('d-none');
            const cloneBack = document.getElementById(cloneId + '-back');
            if(cloneBack) cloneBack.classList.add('d-none');
        }

        document.addEventListener('themechange', function () {
            Object.keys(activeCharts).forEach(rawId => {
                const state = chartState[rawId];
                loadChart(rawId, state.view, state.index);
            });
        });

        // =========================================================================
        // "ANTI-GRAVITY" MOTION LAYER — every tween below touches ONLY transform
        // and opacity, so the compositor handles it without triggering layout or
        // paint. Scrolling itself is the browser's plain native scroll (no smooth-
        // scroll library adding lag/resistance) — anchor nav just uses the native
        // `html { scroll-behavior: smooth }` + each section's `scroll-margin-top`
        // to land in the right spot under the fixed header. GSAP ScrollTrigger
        // drives reveals/parallax straight off that native scroll.
        // =========================================================================
        gsap.ticker.lagSmoothing(0);

        // Mobile browsers resize the visual viewport every time the address bar
        // slides away, and ScrollTrigger's default response is to recompute every
        // trigger position mid-scroll. That recalculation is what used to leave
        // [data-reveal] elements stranded at their `opacity: 0` start state on
        // phones ("ghosted text" / big blank gaps), and why the reveals were
        // previously switched off below 62rem entirely.
        //
        // ignoreMobileResize is GSAP's own switch for exactly this: it tells
        // ScrollTrigger to ignore those address-bar-sized height changes instead
        // of refreshing on them. With it on, the same reveals that always ran on
        // desktop now run on phones and tablets too, so this no longer needs a
        // per-device branch at all.
        // (applied in the DOMContentLoaded block below, right after
        // gsap.registerPlugin, so it can never run before the plugin exists)

        function initScrollReveals() {
            document.querySelectorAll('[data-reveal]').forEach(el => {
                const type = el.dataset.reveal;
                const delay = parseFloat(el.dataset.revealDelay || 0) / 1000;
                const fromVars = { opacity: 0 };
                if (type === 'fade-up') fromVars.y = 40;
                if (type === 'fade-right') fromVars.x = -40;
                if (type === 'fade-left') fromVars.x = 40;
                if (type === 'zoom-in') fromVars.scale = 0.95;

                gsap.from(el, {
                    ...fromVars,
                    duration: 1.2,
                    delay,
                    ease: 'expo.out',
                    scrollTrigger: {
                        trigger: el,
                        // 88% sat far enough down that a short phone viewport could
                        // scroll an element fully into view before its trigger line
                        // was crossed; 92% fires it as it genuinely enters.
                        start: 'top 92%',
                        toggleActions: 'restart none restart none',
                        invalidateOnRefresh: true
                    }
                });
            });

            revealSafetyNet();
        }

        // Hard guarantee that no content can end up permanently invisible.
        //
        // The reveals above start every element at opacity 0 and rely on a
        // ScrollTrigger firing to bring it back. That is a single point of
        // failure: if a trigger's position is ever miscomputed (a late-loading
        // font or image reflowing the page, an orientation flip, a browser whose
        // scroll metrics GSAP reads differently), the element just stays blank
        // with no way to recover. This sweeps for anything that is on screen yet
        // still transparent and forces it visible — animation is a nice-to-have,
        // readable content is not.
        function revealSafetyNet() {
            const rescue = () => {
                document.querySelectorAll('[data-reveal]').forEach(el => {
                    const rect = el.getBoundingClientRect();
                    const onScreen = rect.top < window.innerHeight && rect.bottom > 0;
                    if (!onScreen) return;
                    if (parseFloat(getComputedStyle(el).opacity) < 0.05) {
                        gsap.set(el, { opacity: 1, x: 0, y: 0, scale: 1 });
                    }
                });
            };
            // After first paint, once more when late assets have settled, and
            // again whenever the viewport geometry actually changes.
            requestAnimationFrame(rescue);
            setTimeout(rescue, 1200);
            window.addEventListener('load', () => { ScrollTrigger.refresh(); rescue(); });
            window.addEventListener('orientationchange', () => {
                setTimeout(() => { ScrollTrigger.refresh(); rescue(); }, 300);
            });
        }

        // Hero entrance is pure CSS (see .hero-eyebrow/.hero-title/.hero-subtitle/
        // .hero-cta-group/.hero-scroll-cue @keyframes heroFadeUp rules) — no JS
        // needed for it at all, so there is nothing to initialize here anymore.

        // Scrollspy — lights up whichever nav link matches the section currently
        // centered in the viewport. rootMargin shrinks the observed area to a thin
        // band around the vertical middle of the screen, so the "active" section is
        // whichever one is actually in focus, not just barely peeking into view.
        function initScrollSpy() {
            const navLinks = document.querySelectorAll('.site-nav a[data-nav-link]');
            if (!navLinks.length) return;

            const linksBySectionId = {};
            navLinks.forEach(link => {
                const id = link.getAttribute('href').slice(1);
                linksBySectionId[id] = link;
            });

            const sections = Object.keys(linksBySectionId)
                .map(id => document.getElementById(id))
                .filter(Boolean);
            if (!sections.length) return;

            function setActive(id) {
                navLinks.forEach(link => link.classList.toggle('active', link === linksBySectionId[id]));
            }

            const spyObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) setActive(entry.target.id);
                });
            }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });

            sections.forEach(section => spyObserver.observe(section));
        }

        function initMagneticButtons() {
            document.querySelectorAll('.magnetic').forEach(btn => {
                const setX = gsap.quickSetter(btn, 'x', 'px');
                const setY = gsap.quickSetter(btn, 'y', 'px');
                let targetX = 0, targetY = 0, currentX = 0, currentY = 0, raf = null;

                function tick() {
                    currentX += (targetX - currentX) * 0.18;
                    currentY += (targetY - currentY) * 0.18;
                    setX(currentX);
                    setY(currentY);
                    if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
                        raf = requestAnimationFrame(tick);
                    } else {
                        raf = null;
                    }
                }

                btn.addEventListener('mousemove', (e) => {
                    const rect = btn.getBoundingClientRect();
                    targetX = (e.clientX - rect.left - rect.width / 2) * 0.35;
                    targetY = (e.clientY - rect.top - rect.height / 2) * 0.35;
                    if (!raf) raf = requestAnimationFrame(tick);
                });
                btn.addEventListener('mouseleave', () => {
                    targetX = 0; targetY = 0;
                    if (!raf) raf = requestAnimationFrame(tick);
                });
            });
        }

        function initGlowCards() {
            let raf = null, lastEvent = null;
            document.addEventListener('mousemove', (e) => {
                if (!e.target.closest('.glow-card')) return;
                lastEvent = e;
                if (raf) return;
                raf = requestAnimationFrame(() => {
                    raf = null;
                    const card = lastEvent.target.closest('.glow-card');
                    if (!card) return;
                    const rect = card.getBoundingClientRect();
                    card.style.setProperty('--mx', (lastEvent.clientX - rect.left) + 'px');
                    card.style.setProperty('--my', (lastEvent.clientY - rect.top) + 'px');
                });
            }, { passive: true });
        }

        function initChartsMarquee() {
            const viewport = document.querySelector('.dashboard-container');
            const track = document.getElementById('chartsTrack');
            const originalCards = Array.from(track.querySelectorAll('.chart-card'));

            originalCards.forEach((card) => {
                const canvasId = card.querySelector('canvas').id;
                if (!activeCharts[canvasId]) loadChart(canvasId, 'main');
            });

            setTimeout(() => {
                originalCards.forEach(card => {
                    const clone = card.cloneNode(true);
                    const baseCardId = card.id;
                    clone.id = baseCardId + '_clone';

                    const originalCanvas = clone.querySelector('canvas');
                    const baseId = originalCanvas.id;
                    originalCanvas.id = baseId + '_clone';

                    const backBtn = clone.querySelector('.btn-back-custom');
                    if (backBtn) {
                        backBtn.id = baseId + '_clone-back';
                        backBtn.setAttribute('onclick', `goBack('${baseId}_clone')`);
                    }

                    const title = clone.querySelector('.chart-title');
                    if (title) title.id = baseId + '_clone-title';

                    track.appendChild(clone);
                    loadChart(originalCanvas.id, 'main');
                });

                populateOfficeClusterFilter();

                const firstCard = originalCards[0];
                const firstClone = document.getElementById(firstCard.id + '_clone');
                const resetPoint = firstClone.offsetLeft - firstCard.offsetLeft;

                const setX = gsap.quickSetter(track, 'x', 'px');
                let isInteracting = false;
                let scrollPos = 0;
                let isDragging = false;
                let dragStartX = 0;
                let dragStartScroll = 0;
                const speed = 1.1;

                function wrapAndApply() {
                    if (scrollPos >= resetPoint) scrollPos -= resetPoint;
                    if (scrollPos < 0) scrollPos += resetPoint;
                    setX(-scrollPos);
                }

                // Only an actual press/tap on the track stops the auto-scroll — hovering
                // over it without pressing does not, and releasing resumes immediately.
                viewport.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    isInteracting = true;
                    scrollPos += e.deltaY;
                    wrapAndApply();
                    clearTimeout(viewport.interactionTimeout);
                    viewport.interactionTimeout = setTimeout(() => isInteracting = false, 1500);
                }, { passive: false });

                viewport.addEventListener('pointerdown', (e) => {
                    isDragging = true;
                    dragStartX = e.clientX;
                    dragStartScroll = scrollPos;
                    viewport.setPointerCapture(e.pointerId);
                });
                viewport.addEventListener('pointermove', (e) => {
                    if (!isDragging) return;
                    scrollPos = dragStartScroll + (dragStartX - e.clientX);
                    wrapAndApply();
                });
                viewport.addEventListener('pointerup', () => { isDragging = false; });
                viewport.addEventListener('pointercancel', () => { isDragging = false; });

                // The marquee used to keep spinning — and re-triggering each chart's
                // 8s canvas reveal animation every time a card crossed the intersection
                // threshold — even while the dashboard was scrolled out of view. That
                // endless background canvas work was stealing main-thread time from the
                // browser's own scroll/paint pipeline, which is what produced the
                // "speeds up / slows down" stutter while scrolling anywhere on the page.
                // Fixed by: (1) only pausing scrollPos advancement while the section is
                // actually on screen, and (2) only ever replaying a chart's reveal
                // animation once per card.
                let dashboardOnScreen = true;
                const dashboardVisibilityObserver = new IntersectionObserver((entries) => {
                    dashboardOnScreen = entries[0].isIntersecting;
                }, { threshold: 0 });
                dashboardVisibilityObserver.observe(viewport);

                function autoScrollTrack() {
                    if (dashboardOnScreen && !isInteracting && !isDragging) {
                        scrollPos += speed;
                        wrapAndApply();
                    }
                    requestAnimationFrame(autoScrollTrack);
                }
                autoScrollTrack();

                const cardObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        const card = entry.target;
                        const canvas = card.querySelector('canvas');

                        if (entry.isIntersecting) {
                            card.classList.add('visible');
                            if (!card.dataset.revealed && canvas && activeCharts[canvas.id]) {
                                card.dataset.revealed = '1';
                                const chart = activeCharts[canvas.id];
                                delete chart.centerAnim;
                                chart.reset();
                                chart.update();
                            }
                        } else {
                            card.classList.remove('visible');
                        }
                    });
                }, { root: viewport, threshold: 0.1 });

                document.querySelectorAll('.chart-card').forEach(card => cardObserver.observe(card));

                ScrollTrigger.refresh();
            }, 200);
        }

        // Mobile hamburger: toggles .site-nav open/closed, syncs the icon and
        // aria-expanded, closes again on a link tap (single-page anchor nav) or
        // a tap anywhere outside the menu.
        function initMobileNav() {
            const btn = document.getElementById('navHamburgerBtn');
            const nav = document.getElementById('siteNavList');
            const header = document.getElementById('siteHeader');
            if (!btn || !nav || !header) return;

            // The open menu is a full-viewport overlay (.nav-open-header expands
            // the fixed header to 100vh) rather than content the page reflows
            // around, so there's no spacer height to resync here — that's what
            // made this behave differently depending on scroll position before.
            // Body scroll is locked instead, so the page underneath can't move
            // while the overlay is open, and unlocked again on close.
            function closeNav() {
                nav.classList.remove('nav-open');
                header.classList.remove('nav-open-header');
                document.body.style.overflow = '';
                btn.setAttribute('aria-expanded', 'false');
                btn.innerHTML = '<i class="fas fa-bars"></i>';
            }
            function openNav() {
                nav.classList.add('nav-open');
                header.classList.add('nav-open-header');
                document.body.style.overflow = 'hidden';
                btn.setAttribute('aria-expanded', 'true');
                btn.innerHTML = '<i class="fas fa-times"></i>';
            }

            // stopPropagation here means this click can never reach the
            // document-level "close on outside click" listener below at
            // all — on some mobile browsers a tap's synthetic click event
            // and the resulting DOM changes (innerHTML swap below) land in
            // a way where that listener's own exclusion check
            // (e.target !== btn) intermittently missed, immediately
            // re-closing the menu the instant it opened — which is exactly
            // what read as "needs multiple taps to actually open."
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                nav.classList.contains('nav-open') ? closeNav() : openNav();
            });
            nav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNav));
            document.addEventListener('click', (e) => {
                if (nav.classList.contains('nav-open') && !nav.contains(e.target)) {
                    closeNav();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            syncHeaderSpacer();

            gsap.registerPlugin(ScrollTrigger);
            ScrollTrigger.config({ ignoreMobileResize: true });
            initScrollReveals();
            initMagneticButtons();
            initGlowCards();
            initScrollSpy();
            initMobileNav();

            renderClusterTabs();
            renderServicesAccordion();

            initChartsMarquee();
        });
    </script>

    <script>
        // Connectivity is owned by /js/connection-prompt.js — see that file
        // for what counts as an unusable connection and why navigator.onLine
        // alone got it wrong in both directions. This page only says what its
        // own chips and its "Take Survey Offline" button should do for each
        // state it is handed.
        //
        // The local checkServerHealth()/weakConnectionDetected pair that used
        // to live here is gone: it ran a second, independent /api/health probe
        // against the shared module's, so the two could disagree about the
        // same connection and the chip could contradict the dialog.
        // The button and the chips are all position:fixed, so this can work in
        // plain viewport coordinates and stays correct while the page scrolls.
        // Measured rather than assumed: the slow-connection banner's height
        // depends on how its sentence wrapped at this width, which no CSS
        // constant can know in advance.
        function syncOfflineStackPosition() {
            const btn = document.getElementById('offlineSurveyBtn');
            if (!btn) return;
            const pills = Array.prototype.slice.call(
                document.querySelectorAll('.offline-pill.is-visible')
            );
            if (!pills.length) {
                btn.style.top = '';
                return;
            }
            let lowest = 0;
            pills.forEach(function (pill) {
                const bottom = pill.getBoundingClientRect().bottom;
                if (bottom > lowest) lowest = bottom;
            });
            btn.style.top = Math.round(lowest + 10) + 'px';
        }

        function updateOfflineIndicator() {
            const offline = !navigator.onLine;
            const el = document.getElementById('offlineIndicator');
            if (el) el.classList.toggle('is-visible', offline);

            const offlineSurveyBtn = document.getElementById('offlineSurveyBtn');
            // offerOfflineRoute(), NOT isUnusable(): once this page load has
            // seen a connection too weak to reach the survey, the route stays
            // on offer. Choosing "Stay Online" in the dialog must not be the
            // thing that closes the door it just showed you — the dialog asks
            // once, the button keeps standing. The amber notice above still
            // follows the live state, because that one is a claim rather than
            // an option.
            const offer = window.ConnectionPrompt ? ConnectionPrompt.offerOfflineRoute() : offline;
            if (offlineSurveyBtn) offlineSurveyBtn.classList.toggle('d-none', !offer);

            // After the class flips, so the chips have their final layout.
            syncOfflineStackPosition();
        }
        window.addEventListener('resize', syncOfflineStackPosition);
        window.addEventListener('online', updateOfflineIndicator);
        window.addEventListener('offline', function () {
            // Retract the amber notice here rather than waiting for the state
            // machine: a probe already in flight when the network dies used to
            // land afterwards and leave "slow or unstable" sitting next to the
            // "Viewing Offline" chip, two claims about one connection. The
            // module makes the same correction; this just makes it immediate.
            setServerNotice(null);
            updateOfflineIndicator();
        });
        updateOfflineIndicator();

        function setServerNotice(kind, message) {
            const notice = document.getElementById('serverUnavailableNotice');
            const icon = document.getElementById('serverUnavailableNoticeIcon');
            const text = document.getElementById('serverUnavailableNoticeText');
            if (!notice) return;
            if (!kind) {
                notice.classList.remove('is-visible');
                return;
            }
            notice.classList.add('is-visible');
            notice.classList.toggle('is-error', kind === 'error');
            if (icon) icon.className = kind === 'error' ? 'fas fa-circle-exclamation' : 'fas fa-wifi';
            if (text) text.textContent = message;
        }

        // Kept as a named global because #serverUnavailableNotice's Retry
        // button calls it inline.
        function checkServerHealth() {
            if (window.ConnectionPrompt) ConnectionPrompt.probe();
        }

        if (window.ConnectionPrompt) {
            ConnectionPrompt.init({
                context: 'landing',
                // This page is permanently navy — see .wc-theme-dark.
                theme: 'dark',
                onState: function (state) {
                    if (state === ConnectionPrompt.STATE_WEAK) {
                        // Short on purpose: this sits in a floating chip on a
                        // phone, and the dialog that comes with the weak state
                        // is where the explanation belongs.
                        setServerNotice('warning', 'Slow connection — some features may take longer to load.');
                    } else if (state === ConnectionPrompt.STATE_SERVER_DOWN) {
                        setServerNotice('error', 'The service is temporarily unavailable. Please try again shortly.');
                    } else {
                        // STATE_OK and STATE_OFFLINE both land here. Offline
                        // deliberately shows no amber notice and no dialog:
                        // the "Viewing Offline" chip and the "Take Survey
                        // Offline" button below it are the whole offline
                        // state, and they say it more precisely on their own.
                        setServerNotice(null);
                    }
                    updateOfflineIndicator();
                }
            });
        }

        // Finishes a server-side logout that couldn't complete while the
        // client portal was offline (see attemptPendingClientLogout() in
        // offline-db.js, and client-survey.ejs's showBackOnlineTransition()
        // for the fuller explanation). This is the public landing page, so
        // it's one of the pages most likely to be the first thing loaded
        // after a "Back to Dashboard" choice from the offline overlay. The
        // marker is non-sensitive (a timestamp) and never treated as
        // authentication — attempting it here is harmless even if nothing
        // was ever pending.
        if (navigator.onLine && typeof hasPendingClientLogout === 'function' && hasPendingClientLogout()) {
            attemptPendingClientLogout();
        }
        window.addEventListener('online', function () {
            if (typeof hasPendingClientLogout === 'function' && hasPendingClientLogout()) attemptPendingClientLogout();
        });

        // This public landing page is what cqacapstone.me's bare domain
        // serves, and is the very first page most visitors ever load — so
        // it's the page that has to register the service worker for the
        // whole origin (scope '/'). Without this, a visitor who only ever
        // opens the root URL never gets the survey app's offline support
        // installed at all, since a service worker can never intercept a
        // page's own first-ever load.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }

        // REMOVED: this used to bounce offline visitors with a cached
        // cspc_client_session straight to /client-survey. That's exactly
        // what made the offline overlay's own "Back to Dashboard" button
        // "blink and do nothing" (and what turned /survey-offline's own
        // "Back to Dashboard" into a loop back to the same overlay):
        // navigating here while offline immediately redirected right back
        // to /client-survey's cached shell, which shows that same overlay
        // again on its own regardless. A cached client-side flag was never
        // proof the live authenticated portal is usable offline — this page
        // (the one thing "Back to Dashboard" is supposed to reliably reach)
        // now just stays put, precached and offline-safe on its own terms.
    </script>
</body>
</html>
