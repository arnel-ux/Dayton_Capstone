// Places the ring over the target and the card beside it, on whichever side has room.
function positionOnboarding(step) {
    const ring = document.getElementById('obRing');
    const card = document.getElementById('obCard');
    if (!ring || !card) return;
    const vw = window.innerWidth, vh = window.innerHeight, gap = 16, m = 12;
    const el = step.target ? document.querySelector(step.target) : null;
    const r = el ? el.getBoundingClientRect() : null;
    const usable = r && r.width > 0 && r.height > 0;
    const cw = card.offsetWidth, ch = card.offsetHeight;
    let top, left;

    if (usable) {
        const pad = 6;
        ring.classList.add('has-target');
        ring.style.top = (r.top - pad) + 'px';
        ring.style.left = (r.left - pad) + 'px';
        ring.style.width = (r.width + pad * 2) + 'px';
        ring.style.height = (r.height + pad * 2) + 'px';

        const room = { bottom: vh - r.bottom, top: r.top, right: vw - r.right, left: r.left };
        let side = 'bottom';
        if (room.right >= cw + gap + m && (r.height < 90 || room.bottom < ch + gap)) side = 'right';
        else if (room.bottom >= ch + gap + m) side = 'bottom';
        else if (room.top >= ch + gap + m) side = 'top';
        else if (room.left >= cw + gap + m) side = 'left';

        if (side === 'right')      { left = r.right + gap; top = r.top + r.height / 2 - ch / 2; }
        else if (side === 'left')  { left = r.left - gap - cw; top = r.top + r.height / 2 - ch / 2; }
        else if (side === 'top')   { top = r.top - gap - ch; left = r.left + r.width / 2 - cw / 2; }
        else                       { top = r.bottom + gap; left = r.left + r.width / 2 - cw / 2; }
    } else {
        // No target, so a zero-size ring in the middle still dims the whole page.
        ring.classList.remove('has-target');
        ring.style.top = '50%'; ring.style.left = '50%';
        ring.style.width = '0px'; ring.style.height = '0px';
        top = (vh - ch) / 2; left = (vw - cw) / 2;
    }
    card.style.left = Math.min(Math.max(left, m), Math.max(m, vw - cw - m)) + 'px';
    card.style.top = Math.min(Math.max(top, m), Math.max(m, vh - ch - m)) + 'px';
}

async function renderOnboardingStep() {
    const run = ++onboardingRunId;
    buildOnboardingDots();
    const step = ONBOARDING_STEPS[onboardingCurrentStep - 1];
    const card = document.getElementById('obCard');

    // 1) Fades the old copy out and pauses the tracker so it doesn't snap to a stale target.
    onboardingGliding = true;
    document.getElementById('onboardingWizard').classList.remove('ob-nofx');
    card.classList.add('is-swapping');
    await new Promise(res => setTimeout(res, 180));
    if (run !== onboardingRunId) return;

    // 2) Swaps the copy while invisible so the card is already its new height on arrival.
    document.getElementById('obCount').textContent = 'Step ' + onboardingCurrentStep + ' of ' + ONBOARDING_STEP_COUNT;
    document.getElementById('obIcon').className = 'bi ' + step.icon;
    document.getElementById('obTitle').textContent = step.title;
    document.getElementById('obText').innerHTML = step.text;
    document.querySelectorAll('.onboarding-dot').forEach(el => {
        el.classList.toggle('active', Number(el.getAttribute('data-dot')) === onboardingCurrentStep);
    });
    const backBtn = document.getElementById('onboardingBackBtn');
    const nextBtn = document.getElementById('onboardingNextBtn');
    backBtn.hidden = onboardingCurrentStep === 1;
    nextBtn.textContent = onboardingCurrentStep === ONBOARDING_STEP_COUNT ? 'Get Started' : 'Next';
    nextBtn.setAttribute('aria-label', nextBtn.textContent + ' (step ' + onboardingCurrentStep + ' of ' + ONBOARDING_STEP_COUNT + ')');

    // Gets the target on screen before measuring it.
    if (step.view && typeof switchView === 'function') switchView(step.view);
    onboardingSetSidebar(!!step.sidebar);
    const el = step.target ? document.querySelector(step.target) : null;
    if (el && !step.sidebar) el.scrollIntoView({ block: 'center', inline: 'nearest' });
    // Waits for the mobile sidebar's slide-in animation to settle before measuring.
    await new Promise(res => setTimeout(res, step.sidebar && onboardingIsMobile() ? 340 : (step.view ? 420 : 30)));
    if (run !== onboardingRunId) return;

    // Glides to the target once, then onboardingTrack() snaps to it without easing after that.
    onboardingLastRect = '';
    positionOnboarding(step);
    setTimeout(() => { if (run === onboardingRunId) onboardingGliding = false; }, 650);
    // Text fades back in while the card is mid-glide, not after it stops.
    setTimeout(() => { if (run === onboardingRunId) card.classList.remove('is-swapping'); }, 180);
    nextBtn.focus({ preventScroll: true });
}

function onboardingStep(delta) {
    const next = onboardingCurrentStep + delta;
    if (next > ONBOARDING_STEP_COUNT) {
        finishOnboarding();
        return;
    }
    onboardingCurrentStep = Math.min(Math.max(next, 1), ONBOARDING_STEP_COUNT);
    renderOnboardingStep();
}

function onboardingKeydown(e) {
    if (e.key === 'ArrowRight' || e.key === 'Enter') { e.preventDefault(); onboardingStep(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); onboardingStep(-1); }
    else if (e.key === 'Escape') { e.preventDefault(); finishOnboarding(); }
}
function onboardingReposition() { positionOnboarding(ONBOARDING_STEPS[onboardingCurrentStep - 1]); }

// Keeps the ring glued to its target as the page shifts around it. Only acts when the
// rect actually changed, and drops easing so the ring follows instead of lagging.
let onboardingGliding = false;
let onboardingLastRect = '';
let onboardingTrackId = 0;
function onboardingTrack() {
    const step = ONBOARDING_STEPS[onboardingCurrentStep - 1];
    const el = step && step.target ? document.querySelector(step.target) : null;
    const r = el ? el.getBoundingClientRect() : null;
    const key = (r ? [r.top, r.left, r.width, r.height].map(Math.round).join(',') : 'none') + '|' + window.innerWidth + 'x' + window.innerHeight;
    if (key !== onboardingLastRect && !onboardingGliding) {
        const root = document.getElementById('onboardingWizard');
        if (root && !root.hidden) {
            root.classList.add('ob-nofx');
            positionOnboarding(step);
            onboardingLastRect = key;
        }
    }
    onboardingTrackId = requestAnimationFrame(onboardingTrack);
}

// Called on Finish and Skip Tour alike, both mean "don't show this again". Best-effort,
// the tour still closes even if the request fails.
async function finishOnboarding() {
    onboardingRunId++;
    cancelAnimationFrame(onboardingTrackId);
    document.removeEventListener('keydown', onboardingKeydown);
    window.removeEventListener('resize', onboardingReposition);
    onboardingSetSidebar(false);
    if (typeof switchView === 'function') switchView('home');
    const root = document.getElementById('onboardingWizard');
    if (root) root.hidden = true;
    try {
        await fetch('/api/onboarding-complete', { method: 'POST' });
    } catch (e) { /* best-effort */ }
}

<% if (showOnboarding) { %>
// Called directly since this script block sits right before </body>, after #onboardingWizard.
(function () {
    const root = document.getElementById('onboardingWizard');
    if (!root) return;
    root.hidden = false;
    document.addEventListener('keydown', onboardingKeydown);
    window.addEventListener('resize', onboardingReposition);
    renderOnboardingStep();
    onboardingTrack();
})();
<% } %>

// Initial Load Setup
setLanguage('en');
applyLockedProfile();
updateProgressStepper(1);
updateFullscreenButton();

</script>

<%- include('layout/theme-toggle') %>
</body>
</html>