<%
/* Office portal shell with the topbar and sidebar, shared by Dashboard, Pending and History.
   Locals: officeName (full office name), officeNameShort (abbreviated, used when the full name doesn't fit),
   activeNav (dashboard, report, pending, or history), pendingCount and historyCount (sidebar badges). */
    var _officeName = (typeof officeName !== 'undefined' && officeName) ? officeName : 'Office';
    var _officeShort = (typeof officeNameShort !== 'undefined' && officeNameShort) ? officeNameShort : _officeName;
    var _active = (typeof activeNav !== 'undefined' && activeNav) ? activeNav : '';
    var _pending = (typeof pendingCount !== 'undefined' && pendingCount) ? pendingCount : 0;
    var _history = (typeof historyCount !== 'undefined' && historyCount) ? historyCount : 0;
%>
<header class="topbar">
    <div class="topbar-side topbar-side-start">
        <button type="button" class="topbar-hamburger" id="sidebarToggleBtn" aria-label="Toggle sidebar menu" aria-expanded="false" aria-controls="officeSidebar">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <div class="topbar-brand">
        <div class="topbar-brand-logo-wrap">
            <img src="/images/cspc-logo.png" alt="CSPC Logo">
        </div>
        <div class="topbar-brand-text">
            <!-- Renders both the full and short office name, hiding one based on viewport width. -->
            <div class="t1 office-title" id="officeBrandTitle" title="<%= _officeName %>">
                <span class="office-name-full"><%= _officeName %></span><span class="office-name-short"><%= _officeShort %></span>
            </div>
            <div class="t2">
                <span class="brand-cqa-full">Center for Quality Assurance</span><span class="brand-cqa-short">CQA</span> Office Portal
            </div>
        </div>
    </div>

    <!-- Notification bell and full screen toggle. The bell's badge shows the office's pending count. -->
    <div class="topbar-side topbar-side-end topbar-icon-group">
        <div class="topbar-bell-wrap">
            <button type="button" id="officeNotifBell" class="topbar-icon-btn" title="Notifications" aria-label="Notifications" aria-haspopup="dialog" aria-expanded="false" aria-controls="officeNotifPanel">
                <i class="far fa-bell"></i>
                <span class="topbar-notif-badge" id="officeNotifBadge" hidden>0</span>
            </button>
            <!-- Notification panel with All/Unread tabs, mark all read, clear all, and per row actions. Delete only dismisses locally, it never touches the survey itself. -->
            <div class="notif-panel" id="officeNotifPanel" role="dialog" aria-label="Notifications" hidden>
                <div class="notif-panel-header">
                    <div class="notif-panel-header-top">
                        <span class="notif-panel-title">Notifications</span>
                        <span id="officeNotifHeadCount" class="notif-panel-count" hidden>0 new</span>
                        <button type="button" class="notif-panel-close" id="officeNotifClose" aria-label="Close notifications"><i class="fas fa-times"></i></button>
                    </div>
                    <div class="notif-panel-toolbar">
                        <div class="notif-tabs" role="tablist" aria-label="Filter notifications">
                            <button type="button" class="notif-tab is-active" role="tab" aria-selected="true" data-notif-filter="all">All <span class="notif-tab-count" id="officeNotifCountAll">0</span></button>
                            <button type="button" class="notif-tab" role="tab" aria-selected="false" data-notif-filter="unread">Unread <span class="notif-tab-count" id="officeNotifCountUnread">0</span></button>
                        </div>
                        <div class="notif-panel-header-actions">
                            <button type="button" id="officeNotifMarkAll" class="notif-action" aria-label="Mark all as read" title="Mark all as read"><i class="fas fa-check-double"></i><span>Mark all read</span></button>
                            <button type="button" id="officeNotifClearAll" class="notif-action is-danger" aria-label="Clear all notifications" title="Clear all notifications"><i class="fas fa-trash-can"></i><span>Clear all</span></button>
                        </div>
                    </div>
                </div>
                <div id="officeNotifList" class="notif-list"></div>
                <a href="/office-approvals" class="notif-panel-footer" id="officeNotifFooter"><i class="fas fa-hourglass-half"></i> Review pending surveys</a>
            </div>
        </div>
        <button type="button" id="officeFullscreenBtn" class="topbar-icon-btn" title="Toggle full screen" aria-label="Toggle full screen" aria-pressed="false">
            <i class="fas fa-expand"></i>
        </button>
    </div>
</header>

<!-- Floating "Viewing Offline" chip, fixed and centered just under the header. -->
<span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection — showing the last data loaded while you were connected.">
    <span class="dot"></span><span class="label">Viewing Offline</span>
</span>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="office-sidebar" id="officeSidebar">
    <div class="sidebar-brand">
        <div class="sidebar-brand-logo-wrap">
            <img src="/images/cspc-logo.png" alt="CSPC Logo">
        </div>
        <div class="sidebar-brand-text">
            <!-- Always shows the full office name here, even when the header falls back to the acronym. -->
            <div class="t1"><%= _officeName %></div>
            <div class="t2">CQA Office Portal</div>
        </div>
        <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close sidebar menu">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <nav class="sidebar-nav">
        <a href="/office-dashboard" class="sidebar-link<%= _active === 'dashboard' ? ' active' : '' %>">
            <i class="fas fa-chart-column"></i> Dashboard
        </a>
        <a href="/office-report" class="sidebar-link<%= _active === 'report' ? ' active' : '' %>">
            <i class="fas fa-file-lines"></i> Report
        </a>
        <a href="/office-approvals" class="sidebar-link<%= _active === 'pending' ? ' active' : '' %>">
            <i class="fas fa-hourglass-half"></i> Pending
            <span class="sidebar-count" id="sidebarPendingCount"><%= _pending %></span>
        </a>
        <a href="/office-approvals/history" class="sidebar-link<%= _active === 'history' ? ' active' : '' %>">
            <i class="fas fa-clock-rotate-left"></i> History
            <span class="sidebar-count" id="sidebarHistoryCount"><%= _history %></span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <span class="signed-in-office"><i class="fas fa-building me-1"></i><%= _officeName %></span>
        <!-- The id is required, office-approvals.ejs and office-history.ejs use it to attach the logout confirmation. -->
        <a href="/office-logout" id="officeLogoutBtn" class="btn-logout-side"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</aside>

<script>
    // Header office name fit check. Measures whether the full name fits and swaps to the acronym if it doesn't.
    (function () {
        var title = document.getElementById('officeBrandTitle');
        if (!title) return;

        var desktop = window.matchMedia('(min-width: 992px)');

        function fit() {
            // Desktop always shows the full name.
            if (desktop.matches) { title.classList.remove('is-short'); return; }

            // Always re-measures the full spelling so it can grow back after being shortened.
            title.classList.remove('is-short');
            // +1 accounts for sub-pixel rounding.
            if (title.scrollWidth > title.clientWidth + 1) title.classList.add('is-short');
        }

        fit();
        // Re-checks once the frame is actually laid out.
        if (window.requestAnimationFrame) window.requestAnimationFrame(fit);
        window.addEventListener('resize', fit);
        window.addEventListener('orientationchange', fit);
        // A webfont swapping in can change the text width.
        if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
            document.fonts.ready.then(fit).catch(function () { /* Measurement stays as is. */ });
        }
    })();
</script>

<script>
    // Header bell panel and full screen toggle. Reads the pending count the live watch below paints into the sidebar badge.
    (function () {
        var bell = document.getElementById('officeNotifBell');
        var panel = document.getElementById('officeNotifPanel');
        var badge = document.getElementById('officeNotifBadge');
        var closeBtn = document.getElementById('officeNotifClose');
        var fsBtn = document.getElementById('officeFullscreenBtn');
        var list = document.getElementById('officeNotifList');
        var headCount = document.getElementById('officeNotifHeadCount');
        var countAll = document.getElementById('officeNotifCountAll');
        var countUnread = document.getElementById('officeNotifCountUnread');
        var markAllBtn = document.getElementById('officeNotifMarkAll');
        var clearAllBtn = document.getElementById('officeNotifClearAll');
        var tabs = document.querySelectorAll('#officeNotifPanel .notif-tab');
        if (!bell || !panel || !list) return;

        // Read and dismissed state lives in this browser, per office. Deleting a notification only hides it here, it never touches the actual submission.
        var who = <%- JSON.stringify(_officeName) %>;
        var READ_KEY = 'officeNotifRead:' + who;
        var DISMISS_KEY = 'officeNotifDismissed:' + who;
        function loadIds(key) {
            try { var raw = JSON.parse(localStorage.getItem(key)); return Array.isArray(raw) ? raw.map(Number) : []; }
            catch (e) { return []; }
        }
        function saveIds(key, ids) {
            try { localStorage.setItem(key, JSON.stringify(ids)); } catch (e) { /* private mode */ }
        }
        var readIds = loadIds(READ_KEY);
        var dismissed = loadIds(DISMISS_KEY);
        var items = [];
        var filter = 'all';
        var loaded = false;

        function isRead(it) { return readIds.indexOf(Number(it.id)) !== -1; }
        function isDismissed(it) { return dismissed.indexOf(Number(it.id)) !== -1; }
        function kept() { return items.filter(function (it) { return !isDismissed(it); }); }

        function persist() {
            // Drops ids that already left the queue.
            var live = items.map(function (it) { return Number(it.id); });
            readIds = readIds.filter(function (id) { return live.indexOf(id) !== -1; });
            dismissed = dismissed.filter(function (id) { return live.indexOf(id) !== -1; });
            saveIds(READ_KEY, readIds);
            saveIds(DISMISS_KEY, dismissed);
        }

        function relTime(iso) {
            var then = new Date(iso).getTime();
            if (!iso || isNaN(then)) return '';
            var s = Math.max(0, Math.floor((Date.now() - then) / 1000));
            if (s < 60) return 'Just now';
            var m = Math.floor(s / 60);
            if (m < 60) return m + (m === 1 ? ' minute ago' : ' minutes ago');
            var h = Math.floor(m / 60);
            if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
            var d = Math.floor(h / 24);
            if (d < 7) return d + (d === 1 ? ' day ago' : ' days ago');
            return new Date(then).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function confirmThen(message, title, confirmText, run) {
            if (window.AppAlert && AppAlert.confirm) {
                AppAlert.confirm(message, { title: title, confirmText: confirmText, danger: true })
                    .then(function (ok) { if (ok) run(); });
            } else if (window.confirm(message)) { run(); }
        }

        function iconBtn(cls, label, icon, fn) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = cls;
            b.title = label;
            b.setAttribute('aria-label', label);
            b.innerHTML = '<i class="fas ' + icon + '" aria-hidden="true"></i>';
            b.addEventListener('click', function (e) { e.stopPropagation(); fn(); });
            return b;
        }

        function renderItem(it) {
            var unread = !isRead(it);
            var row = document.createElement('div');
            row.className = 'notif-item' + (unread ? ' is-unread' : '');

            var icon = document.createElement('span');
            icon.className = 'notif-item-icon';
            icon.innerHTML = '<i class="fas fa-hourglass-half"></i>';

            var body = document.createElement('div');
            body.className = 'notif-item-body';
            // Opening a notification marks it read and links to where the work is.
            var link = document.createElement('a');
            link.className = 'notif-item-title-row';
            link.href = '/office-approvals';
            link.addEventListener('click', function () {
                if (readIds.indexOf(Number(it.id)) === -1) readIds.push(Number(it.id));
                saveIds(READ_KEY, readIds);
            });
            var title = document.createElement('span');
            title.className = 'notif-item-title';
            title.textContent = 'New survey from ' + it.respondent + ' is waiting for your review.';
            link.appendChild(title);

            var meta = document.createElement('div');
            meta.className = 'notif-item-meta';
            var time = document.createElement('span');
            time.className = 'notif-item-time';
            time.textContent = (it.service ? it.service + ' · ' : '') + relTime(it.createdAt);
            var status = document.createElement('span');
            status.className = 'notif-status ' + (unread ? 'is-new' : 'is-read');
            status.textContent = unread ? 'New' : 'Read';
            meta.appendChild(time);
            meta.appendChild(status);
            body.appendChild(link);
            body.appendChild(meta);

            row.appendChild(icon);
            row.appendChild(body);
            if (unread) {
                row.appendChild(iconBtn('notif-item-delete notif-item-read', 'Mark as read', 'fa-check', function () {
                    readIds.push(Number(it.id)); saveIds(READ_KEY, readIds); render();
                }));
            }
            row.appendChild(iconBtn('notif-item-delete', 'Delete notification', 'fa-trash-can', function () {
                confirmThen(
                    'Delete this notification from your bell? The survey stays in Pending until it is reviewed.',
                    'Delete notification?', 'Yes, delete',
                    function () { dismissed.push(Number(it.id)); persist(); render(); }
                );
            }));
            return row;
        }

        function render() {
            var all = kept();
            var unread = all.filter(function (it) { return !isRead(it); });
            var visible = filter === 'unread' ? unread : all;

            countAll.textContent = String(all.length);
            countUnread.textContent = String(unread.length);
            headCount.textContent = unread.length + ' new';
            headCount.hidden = unread.length === 0;
            markAllBtn.disabled = unread.length === 0;
            clearAllBtn.disabled = all.length === 0;
            markAllBtn.toggleAttribute('disabled', unread.length === 0);
            clearAllBtn.toggleAttribute('disabled', all.length === 0);

            badge.textContent = unread.length > 99 ? '99+' : String(unread.length);
            badge.hidden = unread.length === 0;
            bell.classList.toggle('has-unread', unread.length > 0);

            list.innerHTML = '';
            if (visible.length === 0) {
                var empty = document.createElement('div');
                empty.className = 'notif-empty';
                empty.innerHTML = '<i class="far fa-bell-slash"></i>';
                empty.appendChild(document.createTextNode(
                    filter === 'unread' ? 'No unread notifications.' : 'No pending surveys right now.'
                ));
                list.appendChild(empty);
                return;
            }
            visible.forEach(function (it) { list.appendChild(renderItem(it)); });
        }

        function load() {
            return fetch('/office-approvals/notifications', {
                credentials: 'same-origin', headers: { 'Accept': 'application/json' }, cache: 'no-store'
            }).then(function (res) {
                if (!res.ok || res.redirected) return null;
                if ((res.headers.get('content-type') || '').indexOf('application/json') === -1) return null;
                return res.json().catch(function () { return null; });
            }).then(function (data) {
                if (!data || !data.success) return null;
                items = data.notifications || [];
                loaded = true;
                persist();
                render();
                return items;
            }).catch(function () { return null; });
        }

        function setOpen(open) {
            panel.hidden = !open;
            bell.setAttribute('aria-expanded', open ? 'true' : 'false');
            bell.classList.toggle('is-active', open);
            if (open) load();
        }

        bell.addEventListener('click', function (e) { e.stopPropagation(); setOpen(panel.hidden); });
        if (closeBtn) closeBtn.addEventListener('click', function () { setOpen(false); });
        document.addEventListener('click', function (e) {
            if (!panel.hidden && !panel.contains(e.target)) setOpen(false);
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

        tabs.forEach(function (t) {
            t.addEventListener('click', function () {
                filter = t.getAttribute('data-notif-filter') === 'unread' ? 'unread' : 'all';
                tabs.forEach(function (o) {
                    o.classList.toggle('is-active', o === t);
                    o.setAttribute('aria-selected', o === t ? 'true' : 'false');
                });
                render();
            });
        });
        markAllBtn.addEventListener('click', function () {
            kept().forEach(function (it) { if (!isRead(it)) readIds.push(Number(it.id)); });
            persist(); render();
        });
        clearAllBtn.addEventListener('click', function () {
            confirmThen(
                'Clear all notifications from your bell? The surveys stay in Pending until they are reviewed.',
                'Clear all notifications?', 'Yes, clear all',
                function () {
                    kept().forEach(function (it) { dismissed.push(Number(it.id)); });
                    persist(); render();
                }
            );
        });

        // Refreshes this list whenever the live watch below repaints the sidebar's Pending badge.
        var sidebarCount = document.getElementById('sidebarPendingCount');
        if (sidebarCount && window.MutationObserver) {
            new MutationObserver(function () { load(); }).observe(sidebarCount, { childList: true, characterData: true, subtree: true });
        }

        // Login alert. Shows once after a fresh login (via ?welcome=1) whether anything is pending.
        var welcome = false;
        try {
            var params = new URLSearchParams(window.location.search);
            if (params.has('welcome')) {
                welcome = true;
                params.delete('welcome');
                var qs = params.toString();
                window.history.replaceState({}, '', window.location.pathname + (qs ? '?' + qs : '') + window.location.hash);
            }
        } catch (e) { /* No URL API, the alert is a bonus. */ }

        // Also shown once per tab or app window, tracked in sessionStorage, so switching between pages doesn't repeat it.
        var ANNOUNCE_KEY = 'cqa_office_open_alert';
        function alreadyAnnounced() {
            try { return sessionStorage.getItem(ANNOUNCE_KEY) === '1'; } catch (e) { return false; }
        }
        function markAnnounced() {
            try { sessionStorage.setItem(ANNOUNCE_KEY, '1'); } catch (e) { /* Storage blocked, may repeat, harmless. */ }
        }

        // Builds its own popup card instead of using AppAlert, so it doesn't depend on that library being ready.
        function ensurePopupStyles() {
            if (document.getElementById('officePendingPopupCss')) return;
            var css = document.createElement('style');
            css.id = 'officePendingPopupCss';
            css.textContent =
                '.opp-backdrop{position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(15,10,35,.55);backdrop-filter:blur(2px);animation:oppFade .18s ease}' +
                '.opp-card{width:100%;max-width:420px;max-height:90vh;overflow:auto;background:#fff;color:#1a1436;border-radius:20px;padding:26px 24px 20px;text-align:center;box-shadow:0 30px 70px -20px rgba(15,10,35,.55);animation:oppPop .22s ease}' +
                '.opp-icon{width:64px;height:64px;margin:0 auto 14px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.6rem;color:#fff;background:linear-gradient(135deg,#f59e0b,#f97316);box-shadow:0 10px 24px -10px rgba(249,115,22,.8)}' +
                '.opp-title{font-size:1.2rem;font-weight:800;margin:0 0 6px}' +
                '.opp-msg{font-size:.92rem;color:#64748b;margin:0 0 14px}' +
                '.opp-msg strong{color:#ea580c;font-size:1.05rem}' +
                '.opp-list{list-style:none;margin:0 0 16px;padding:0;text-align:left;border:1px solid #e5e7f0;border-radius:12px;overflow:hidden}' +
                '.opp-list li{padding:9px 12px;font-size:.84rem;border-bottom:1px solid #eef0f6;display:flex;justify-content:space-between;gap:10px}' +
                '.opp-list li:last-child{border-bottom:0}' +
                '.opp-list .n{font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}' +
                '.opp-list .s{color:#94a3b8;white-space:nowrap;font-size:.76rem;align-self:center}' +
                '.opp-more{padding:8px 12px;font-size:.78rem;color:#94a3b8;text-align:center;background:rgba(148,163,184,.08)}' +
                '.opp-actions{display:flex;gap:10px}' +
                '.opp-actions button{flex:1;min-height:44px;border-radius:12px;font-weight:700;font-size:.9rem;cursor:pointer}' +
                '.opp-later{background:transparent;border:1.5px solid #cbd5e1;color:#475569}' +
                '.opp-go{background:#2d1f57;border:1.5px solid #2d1f57;color:#fff}' +
                '.opp-go:hover{background:#4b3a86}' +
                'html[data-bs-theme="dark"] .opp-card{background:#1f1b33;color:#f1f0f8}' +
                'html[data-bs-theme="dark"] .opp-msg{color:#a9a5c2}' +
                'html[data-bs-theme="dark"] .opp-list{border-color:#3a3556}' +
                'html[data-bs-theme="dark"] .opp-list li{border-color:#332e4d}' +
                'html[data-bs-theme="dark"] .opp-later{border-color:#4a4468;color:#d6d3ea}' +
                'html[data-bs-theme="dark"] .opp-go{background:#6d5bd0;border-color:#6d5bd0}' +
                '@keyframes oppFade{from{opacity:0}to{opacity:1}}' +
                '@keyframes oppPop{from{opacity:0;transform:translateY(12px) scale(.96)}to{opacity:1;transform:none}}';
            document.head.appendChild(css);
        }

        function showPendingPopup(list) {
            if (document.getElementById('officePendingPopup')) return;
            ensurePopupStyles();
            var count = list.length;
            var wrap = document.createElement('div');
            wrap.className = 'opp-backdrop';
            wrap.id = 'officePendingPopup';
            var card = document.createElement('div');
            card.className = 'opp-card';
            card.setAttribute('role', 'alertdialog');
            card.setAttribute('aria-modal', 'true');
            card.setAttribute('aria-labelledby', 'oppTitle');

            var icon = document.createElement('div');
            icon.className = 'opp-icon';
            icon.innerHTML = '<i class="fas fa-hourglass-half"></i>';
            var title = document.createElement('h3');
            title.className = 'opp-title';
            title.id = 'oppTitle';
            title.textContent = 'Pending Surveys';
            var msg = document.createElement('p');
            msg.className = 'opp-msg';
            msg.innerHTML = 'You have <strong></strong> waiting for your review.';
            msg.querySelector('strong').textContent = count + (count === 1 ? ' pending survey' : ' pending surveys');

            var ul = document.createElement('ul');
            ul.className = 'opp-list';
            list.slice(0, 3).forEach(function (it) {
                var li = document.createElement('li');
                var n = document.createElement('span'); n.className = 'n'; n.textContent = it.respondent;
                var s = document.createElement('span'); s.className = 's'; s.textContent = relTime(it.createdAt);
                li.appendChild(n); li.appendChild(s); ul.appendChild(li);
            });
            if (count > 3) {
                var more = document.createElement('li');
                more.className = 'opp-more';
                more.textContent = '+ ' + (count - 3) + ' more';
                ul.appendChild(more);
            }

            var actions = document.createElement('div');
            actions.className = 'opp-actions';
            var later = document.createElement('button');
            later.type = 'button'; later.className = 'opp-later'; later.textContent = 'Later';
            var go = document.createElement('button');
            go.type = 'button'; go.className = 'opp-go';
            go.textContent = ACTIVE_PAGE === 'pending' ? 'Got it' : 'Review now';
            actions.appendChild(later); actions.appendChild(go);

            [icon, title, msg, ul, actions].forEach(function (n) { card.appendChild(n); });
            wrap.appendChild(card);
            document.body.appendChild(wrap);

            function close() {
                document.removeEventListener('keydown', onKey);
                if (wrap.parentNode) wrap.parentNode.removeChild(wrap);
            }
            function onKey(e) { if (e.key === 'Escape') close(); }
            document.addEventListener('keydown', onKey);
            later.addEventListener('click', close);
            wrap.addEventListener('click', function (e) { if (e.target === wrap) close(); });
            go.addEventListener('click', function () {
                close();
                if (ACTIVE_PAGE !== 'pending') window.location.href = '/office-approvals';
            });
            go.focus();
        }

        // Announces what's waiting once per tab or app window, and always right after a fresh login.
        function announceOnLogin(list) {
            if (!list || list.length <= 0) return;
            if (!welcome && alreadyAnnounced()) return;
            markAnnounced();
            showPendingPopup(list);
        }
        var ACTIVE_PAGE = <%- JSON.stringify(_active) %>;

        // AppAlert loads in layout/footer.ejs, parsed after this script.
        function boot() {
            load().then(function (list2) {
                if (list2) announceOnLogin(list2);
            });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
        else boot();

        // Full screen toggle. Hidden on browsers without the API, like iPhone Safari.
        function fsElement() {
            return document.fullscreenElement || document.webkitFullscreenElement || null;
        }
        function paintFs() {
            if (!fsBtn) return;
            var on = !!fsElement();
            fsBtn.innerHTML = on ? '<i class="fas fa-compress"></i>' : '<i class="fas fa-expand"></i>';
            fsBtn.title = on ? 'Exit full screen' : 'Toggle full screen';
            fsBtn.setAttribute('aria-label', fsBtn.title);
            fsBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (fsBtn) {
            var root = document.documentElement;
            var canFs = !!(root.requestFullscreen || root.webkitRequestFullscreen);
            if (!canFs) {
                fsBtn.hidden = true;
            } else {
                fsBtn.addEventListener('click', function () {
                    try {
                        var result = fsElement()
                            ? (document.exitFullscreen || document.webkitExitFullscreen).call(document)
                            : (root.requestFullscreen || root.webkitRequestFullscreen).call(root);
                        if (result && typeof result.catch === 'function') result.catch(function () {});
                    } catch (e) { /* Blocked, the panel still works windowed. */ }
                });
                document.addEventListener('fullscreenchange', paintFs);
                document.addEventListener('webkitfullscreenchange', paintFs);
            }
        }
    })();
</script>

<script>
    // Live pending watch, shared by Dashboard, Pending and History.
    // Polls the server for what's waiting, keeps sidebar badges and the tab title current, and refreshes the page when needed.
    (function () {
        var ACTIVE = <%- JSON.stringify(_active) %>;
        var POLL_MS = 10000;
        // Gives enough time to read the "new submission" notice before the page refreshes.
        var REFRESH_DELAY_MS = 3500;
        // Decides what counts as stale per page: dashboard on any change, pending on queue changes, history on finished reviews only.
        function isStale(before, now) {
            if (ACTIVE === 'dashboard') return signature(before) !== signature(now);
            if (ACTIVE === 'pending') return before.pending !== now.pending || before.latestPendingId !== now.latestPendingId;
            if (ACTIVE === 'history') return before.history !== now.history;
            return false;
        }

        // Everything the panel draws, as one comparable string.
        function signature(d) {
            return [d.pending, d.latestPendingId, d.history, d.responses].join('|');
        }
        // Carries the reload notice message across the page refresh.
        var NOTICE_KEY = 'cqa_office_pending_notice';

        var baseline = null;      // The data as of the last look.
        var stopped = false;
        var wantsRefresh = null;  // The message to show after a pending refresh.
        var toldAboutWait = false;
        var titleBase = document.title;

        function el(id) { return document.getElementById(id); }

        // A new submission gets a message that waits for acknowledgment. A page just catching up gets a quieter note.
        function notify(message, opts) {
            opts = opts || {};
            if (window.AppAlert && AppAlert.toastInfo) {
                AppAlert.toastInfo(message, {
                    title: opts.title || 'New Pending Survey',
                    autoClose: opts.quiet === true
                });
            } else if (window.console) {
                console.info('[office] ' + message);
            }
        }

        // Checks whether a reload would destroy work in progress. If not safe, the refresh is postponed rather than cancelled.
        function safeToReload() {
            // A modal counts as busy, but a toast doesn't, both live in the same container so they need to be told apart.
            var containers = document.querySelectorAll('.swal2-container');
            for (var i = 0; i < containers.length; i++) {
                if (!containers[i].querySelector('.swal2-toast')) return false;
            }
            if (document.querySelector('.decline-panel.show, .decline-panel[style*="block"]')) return false;
            var a = document.activeElement;
            if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.tagName === 'SELECT' || a.isContentEditable)) return false;
            return true;
        }

        function refreshNow(notice) {
            // Hands the notice message across the reload so it survives.
            try { sessionStorage.setItem(NOTICE_KEY, JSON.stringify(notice)); } catch (e) { /* The toast is a bonus, the refresh is the point. */ }
            window.location.reload();
        }

        function setBadge(node, value) {
            if (node && node.textContent !== String(value)) node.textContent = String(value);
        }

        function paint(data) {
            setBadge(el('sidebarPendingCount'), data.pending);
            setBadge(el('sidebarHistoryCount'), data.history);
            // Puts the count in the tab title so it's visible even from another tab.
            document.title = data.pending > 0 ? '(' + data.pending + ') ' + titleBase : titleBase;
        }

        function poll() {
            if (stopped || !navigator.onLine) return;

            fetch('/office-approvals/status', {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' },
                cache: 'no-store'
            }).then(function (res) {
                // An expired session redirects to login instead of returning JSON, so polling stops and the staffer is sent to log back in.
                if (res.redirected) {
                    stopped = true;
                    window.location.href = '/login?status=session_expired';
                    return null;
                }
                if (!res.ok) return null;
                // Ignores any non JSON response, such as a captive portal sign in page.
                if ((res.headers.get('content-type') || '').indexOf('application/json') === -1) return null;
                return res.json().catch(function () { return null; });
            }).then(function (data) {
                if (!data || data.success !== true) return;
                paint(data);

                // The first poll only sets the baseline, it never announces anything.
                if (baseline === null) { baseline = data; return; }

                var before = baseline;
                if (signature(before) === signature(data)) return;   // Nothing moved.
                baseline = data;

                // A new submission is announced on every page, even History, which doesn't refresh for it.
                var arrived = data.latestPendingId > before.latestPendingId;
                if (arrived) {
                    notify(data.pending === 1
                        ? 'A new survey submission is waiting for your review.'
                        : data.pending + ' survey submissions are waiting for your review.');
                }

                if (!isStale(before, data)) return;   // Changed, but not on this page.

                // Anything else is a transaction that already finished elsewhere, so the page just refreshes with a short note.
                wantsRefresh = arrived
                    ? { text: 'A new survey submission is waiting for your review.', quiet: false }
                    : { text: 'Updated — the records for this office changed just now.', quiet: true, title: 'Page Updated' };

                // Gives the toast a moment to be read before refreshing.
                setTimeout(tick, REFRESH_DELAY_MS);
            }).catch(function () {
                // Offline or a dropped connection, the next tick tries again.
            });
        }

        function tick() {
            // A hidden tab doesn't poll or reload, it just catches up once it's looked at again.
            if (document.visibilityState !== 'visible') return;
            if (wantsRefresh && safeToReload()) return refreshNow(wantsRefresh);
            if (wantsRefresh && !toldAboutWait) {
                // Tells the staffer once that a refresh is waiting on them.
                toldAboutWait = true;
                notify('This page updates as soon as you finish what you are doing.', { title: 'Page Updated', quiet: true });
            }
            // Keeps polling even with a refresh queued, so new submissions still get announced.
            poll();
        }

        function start() {
            // Shows any notice left over from a reload this script triggered.
            try {
                var carried = sessionStorage.getItem(NOTICE_KEY);
                if (carried) {
                    sessionStorage.removeItem(NOTICE_KEY);
                    var notice = JSON.parse(carried);
                    notify(notice.text, notice);
                }
            } catch (e) { /* Private mode, or an older notice format, the reload still happened. */ }

            poll();
            setInterval(tick, POLL_MS);
            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible') tick();
            });
            // Polls right away when the connection comes back instead of waiting out the interval.
            window.addEventListener('online', tick);
        }

        // AppAlert loads in layout/footer.ejs, parsed after this, so DOMContentLoaded is the first safe moment.
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
        else start();
    })();
</script>
