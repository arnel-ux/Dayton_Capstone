// I-render ang SQD Table na may tamang value (5, 4, 3, 2, 1, 0) para sa Database
function renderSQD() {
    const tbody = document.getElementById('sqd-body');
    tbody.innerHTML = '';
    
    i18n[currentLang].sqd_items.forEach((item, index) => {
        tbody.innerHTML += `
            <tr>
                <td class="text-start">${item}</td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="5" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="4" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="3" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="2" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="1" class="radio-custom"></td>
                <td class="text-center"><input type="radio" name="sqd${index}" value="0" class="radio-custom"></td>
            </tr>
        `;
    });
}

// Renders the bulleted Terms & Conditions summary points for the current language
function renderTermsPoints() {
    const list = document.getElementById('terms-points-list');
    if (!list) return;
    list.innerHTML = '';
    (i18n[currentLang].terms_points || []).forEach(point => {
        const li = document.createElement('li');
        li.textContent = point;
        list.appendChild(li);
    });
}

function updateTranslations() {
    document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (i18n[currentLang][key]) {
            el.innerHTML = i18n[currentLang][key];
        }
    });
}

function setLanguage(lang) {
    currentLang = lang;
    document.getElementById('btn-en').className = lang === 'en' ? 'btn btn-primary btn-sm fw-semibold shadow-sm' : 'btn bg-transparent border btn-sm fw-semibold shadow-sm text-body';
    document.getElementById('btn-tl').className = lang === 'tl' ? 'btn btn-primary btn-sm fw-semibold shadow-sm' : 'btn bg-transparent border btn-sm fw-semibold shadow-sm text-body';
    updateTranslations();
    renderSQD();
    renderTermsPoints();

    // Re-apply the current stage's Next-button label in the new language —
    // covers both the normal "Next"/"Susunod" text and the Smart Edit
    // "Save & Return to Review" label, which isn't part of the data-i18n scan above.
    const activePage = document.querySelector('#surveyForm .page.active');
    if (activePage) updateNextButtonLabel(parseInt(activePage.id.replace('stage', ''), 10));
}

// =====================================
// STAGE 5 — REVIEW & CONFIRMATION SUMMARY
// =====================================
// Reads whatever is currently sitting in the (untouched) form fields and
// mirrors it into the read-only review cards. Never touches submitAll()'s own
// FormData collection below — this is purely a preview built from the same DOM.
function renderReviewSummary() {
    const val = (sel) => { const el = document.querySelector(sel); return el ? el.value : ''; };
    const selectedText = (sel) => {
        const el = document.querySelector(sel);
        return (el && el.selectedOptions && el.selectedOptions[0]) ? el.selectedOptions[0].textContent.trim() : '—';
    };
    const checkedLabelText = (name) => {
        const checked = document.querySelector(`input[name="${name}"]:checked`);
        if (!checked) return '—';
        const span = checked.closest('label') ? checked.closest('label').querySelector('span') : null;
        return span ? span.textContent.trim() : checked.value;
    };

    document.getElementById('rv-name').textContent = val('input[name="respondent_name"]').trim() || 'Anonymous';
    document.getElementById('rv-email').textContent = val('input[name="email"]') || '—';
    document.getElementById('rv-clienttype').textContent = selectedText('select[name="client_type"]');
    document.getElementById('rv-gender').textContent = checkedLabelText('gender');
    document.getElementById('rv-age').textContent = selectedText('select[name="age"]');
    document.getElementById('rv-date').textContent = val('input[name="survey_date"]') || '—';
    document.getElementById('rv-region').textContent = selectedText('select[name="region"]');
    document.getElementById('rv-office').textContent = selectedText('select[name="office_id"]');
    document.getElementById('rv-service').textContent = selectedText('select[name="service_availed"]');

    document.getElementById('rv-cc1').textContent = checkedLabelText('cc1');
    document.getElementById('rv-cc2').textContent = checkedLabelText('cc2');
    document.getElementById('rv-cc3').textContent = checkedLabelText('cc3');

    const ratingLabels = {
        '5': i18n[currentLang].th_sa, '4': i18n[currentLang].th_a, '3': i18n[currentLang].th_n,
        '2': i18n[currentLang].th_d, '1': i18n[currentLang].th_sd, '0': 'N/A'
    };
    const sqdList = document.getElementById('rv-sqd-list');
    sqdList.innerHTML = '';
    i18n[currentLang].sqd_items.forEach((item, index) => {
        const checked = document.querySelector(`input[name="sqd${index}"]:checked`);
        const ratingText = checked ? (ratingLabels[checked.value] || checked.value) : '—';
        const row = document.createElement('div');
        row.className = 'review-sqd-row';
        row.innerHTML = `<span class="review-sqd-statement">${item}</span><span class="review-sqd-rating">${ratingText}</span>`;
        sqdList.appendChild(row);
    });

    document.getElementById('rv-comments').textContent = val('textarea[name="comments"]').trim() || '—';
}

// =====================================
// FORM SUBMISSION PAPUNTA SA SERVER.JS
// =====================================
function submitAll(event) {
    if (event) event.preventDefault();

    // Re-validate every stage (Terms, Profile, CC, SQD) before allowing submission
    for (let stage = 1; stage <= 4; stage++) {
        if (!validateStage(stage)) {
            navigate(stage);
            return;
        }
    }

    const formElement = document.getElementById('surveyForm');
    const formData = new FormData(formElement);
    const data = Object.fromEntries(formData.entries());

    // 2. Magbigay ng default value kung blangko ang tinype o hindi sinagutan ang dropdown
    data.respondent_name = data.respondent_name?.trim() || 'Anonymous';
    data.email = data.email?.trim() || 'Not Specified';
    data.client_type = data.client_type || 'Citizen';
    data.age = data.age || 'Not Specified';
    data.gender = data.gender || 'Not Specified';
    data.region = data.region || 'Not Specified';
    data.topic = 'General'; 

    data.cc1 = data.cc1 || '';
    data.cc2 = data.cc2 || '';
    data.cc3 = data.cc3 || '';

    // Siguraduhing may default number kapag walang nai-check sa table
    for(let i=0; i<=8; i++) {
        data[`sqd${i}`] = parseInt(data[`sqd${i}`] || 5);
    }

    // Offline: skip the network call entirely and queue the survey locally —
    // it will be replayed automatically once the connection returns.
    if (!navigator.onLine) {
        queueSurveyOffline(data, data.email).then(showThankYou);
        return;
    }

    // 3. IPAPASA ANG MGA SAGOT DIREKTA SA API
    fetch('/submit-survey', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(resData => {
        if (resData.success) {
            showThankYou();
        } else {
            AppAlert.error("Nagkaroon ng problema: " + (resData.message || 'Database error'));
        }
    })
    .catch(err => {
        // A rejected fetch here (as opposed to a JSON error response above) means
        // the request never reached the server — most likely a lost connection.
        console.error("Error submitting survey:", err);
        queueSurveyOffline(data, data.email).then(showThankYou);
    });
}

// Confetti + swap to the Thank You page — shared by both the normal
// (online) success path and the offline-queued path above.
function showThankYou() {
    const duration = 3000;
    const animationEnd = Date.now() + duration;
    const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };
    const interval = setInterval(function(){
        const timeLeft = animationEnd - Date.now();
        if(timeLeft <= 0) return clearInterval(interval);
        const particleCount = 50 * (timeLeft / duration);
        confetti({ ...defaults, particleCount, origin: { x: Math.random() * 0.3, y: Math.random() - 0.2 } });
        confetti({ ...defaults, particleCount, origin: { x: 0.7 + Math.random() * 0.3, y: Math.random() - 0.2 } });
    }, 250);

    document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
    document.getElementById('thank-you-page').classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });

    const progressEl = document.getElementById('surveyProgress');
    if (progressEl) progressEl.style.display = 'none';
    exitFullscreen();
}

async function logout(){
    const confirmed = await AppAlert.confirm("Are you sure you want to logout?", {
        title: 'Logout?',
        confirmText: 'Yes, logout'
    });
    if (confirmed) {
        try { localStorage.removeItem(CLIENT_SESSION_KEY); } catch (e) {}
        // Hits the server's /logout route so the session (req.session.clientEmail /
        // passport user) is actually cleared — otherwise the Back button could
        // still land on the survey without signing in again.
        window.location.href = '/logout';
    }
}

