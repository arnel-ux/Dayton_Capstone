<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <style>
        /* Reset and Base Styles */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden; /* Para walang lumabas na scrollbar */
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        /* 1. Background Image — same photo + treatment as the public landing
           page (index.ejs .bg-image): full-bleed, no blur, so the two pages
           read as one consistent backdrop. */
        .bg-blurred {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url('/images/campus-monument.jpg');
            background-size: cover;
            /* The CSPC monument (seal/torch/globe) sits in the upper half
               of this photo. On a tall mobile viewport, "cover" scales the
               image up enough that centering it vertically cropped the
               monument almost entirely out of frame, leaving mostly sky and
               pavement — anchoring to the top keeps it in view. */
            background-position: top center;
            background-repeat: no-repeat;
            z-index: -2;
        }

        /* 2. Overlay — same navy gradient as the landing page's .bg-overlay,
           instead of a flat tint, so the two pages match. */
        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(180deg, rgba(37, 29, 58,0.92) 0%, rgba(37, 29, 58,0.85) 100%);
            z-index: -1;
        }

        /* 3. Header-anchored wrapper — the header sits at a FIXED offset from the
           top of the viewport (not vertically centered as one block with the
           card below it). Centering the whole [header + card] group made the
           header land at a different height on every auth page depending on
           how tall that page's card happened to be (e.g. login's card with
           reCAPTCHA vs. forgot-password's shorter card) — pinning the header
           instead is what keeps it at the exact same spot across every page
           that shares this block (login.ejs, forgot-password.ejs,
           reset-password.ejs, complete-google-registration.ejs). */
        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            max-height: 100vh;
            display: flex;
            flex-direction: column; /* Para magpatong ang titles at card */
            align-items: center;    /* Centers horizontally */
            justify-content: flex-start;
            padding: 1rem;
            padding-top: clamp(1.5rem, 9vh, 4rem);
            padding-bottom: 5rem;
            z-index: 1;
            overflow-y: auto; /* Safety fallback: scroll instead of clipping on short viewports */
        }

        /* --- BAGONG DAGDAG NA HEADER STYLES & ANIMATIONS --- */
        
        /* Keyframes para sa Fade & Slide Up Animation */
        @keyframes fadeSlideUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-container {
            text-align: center;
            margin-bottom: 1.1rem;
            max-width: 800px; /* Para hindi masyadong humaba sa malaking screen */
            flex-shrink: 0;
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.5rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.35rem;
            letter-spacing: 0.3px;
            line-height: 1.25;

            /* Apply animation (Mauuna) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #e2e8f0;
            font-weight: 400;
            font-style: italic; /* Ibang style as requested */
            font-size: 0.85rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.6rem;

            /* Apply animation (Pangalawa, may delay na 0.3s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #ffffff; /* Distinct gold/yellow color para sa Admin Portal */
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2.2px;
            padding: 0.3rem 0.9rem;
            background: rgba(255, 204, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            backdrop-filter: blur(6px);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;

            /* Apply animation (Pangatlo, may delay na 0.6s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        /* Responsive para sa Titles */
        @media (max-width: 600px) {
            .main-title {
                font-size: 1.15rem;
            }
            .sub-title {
                font-size: 0.78rem;
                margin-bottom: 0.5rem;
            }
            .portal-text {
                font-size: 0.65rem;
            }
        }
        /* -------------------------------------- */

        /* 4. Card Styling — refined glassmorphism, soft layered shadow */
        .card-custom {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 1.75rem;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;

            /* Dito natin ginawang Square */
            width: 400px;
            height: auto;
            flex-shrink: 0;

            /* Para mag-center ang content sa loob ng square */
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.5rem 2.25rem;
            opacity: 0;
            animation: fadeSlideUp 0.7s ease-out 0.15s forwards;
        }

        /* Responsive para sa mobile card
           NOTE: the fixed 400px card width above (plus the wrapper's 1rem/16px
           side padding) needs >= 432px of viewport to avoid overflowing —
           but common phones (375/390/393/412/414/428/430px) are ALL narrower
           than that, and html/body has overflow:hidden, so on every real phone
           the card was getting clipped off-screen on the sides instead of
           shrinking. Raised the breakpoint from 400px to 480px so it now
           covers every phone width, including the larger Pro Max/Android
           sizes the old 400px cutoff missed. */
        @media (max-width: 480px) {
            .card-custom {
                width: 92vw;
                height: auto;
                padding: 1.35rem 1.5rem;
            }
            /* Google's reCAPTCHA checkbox widget is a fixed 304x78px iframe —
               wider than the card's content area on every phone (92vw card
               minus its own side padding leaves ~280-300px). Scaling it down
               and shrinking its layout box by the same factor keeps it fully
               inside the card instead of poking out past the edge. */
            .g-recaptcha {
                transform: scale(0.85);
                transform-origin: 0 0;
                width: 258px;
                height: 66px;
            }

            /* ---- Touch targets + readability ----
               The text inputs were ~34px tall with a 14.08px font — under the
               ~44px comfortable tap-height guideline, and critically, any
               input with a font-size below 16px makes iOS Safari auto-zoom
               the whole page on focus (jarring layout jump, easy to trigger
               here since these are the very first fields a phone user taps).
               16px input text avoids that zoom outright. */
            .input-modern .form-control {
                font-size: 16px;
                padding: 0.8rem 0.85rem 0.8rem 0;
            }
            .input-modern .input-icon { width: 2.8rem; font-size: 1rem; }
            .field-group { margin-bottom: 1rem; }
            .field-label { font-size: 0.74rem; margin-bottom: 0.4rem; }
            .field-hint { font-size: 0.74rem; margin-top: 0.4rem; }

            /* Buttons: taller padding brings both to a comfortable >=44px tap
               height; unchanged font stayed readable but the old padding made
               them feel like a thin bar to tap on a phone. */
            .btn-login, .btn-google {
                padding: 0.9rem 1rem;
                font-size: 0.95rem;
            }

            /* "Forgot Password?" sits inline next to the Password label —
               it's a short link with almost no hit area beyond its own text
               height. Padding it (and giving the row more gap) turns it into
               a real tap target and keeps a thumb from clipping the label
               next to it. */
            .forgot-link {
                padding: 0.35rem 0;
                margin: -0.35rem 0;
                font-size: 0.8rem;
            }
            .field-group .d-flex.justify-content-between { gap: 0.75rem; }

            .divider-or { margin: 1.1rem 0; }

            /* Subtitle/eyebrow text was down at 12.48px/10.4px — bump both
               into comfortably-readable territory on a phone screen. */
            .sub-title { font-size: 0.85rem; }
            .portal-text { font-size: 0.7rem; padding: 0.35rem 1rem; }

        }

        .card-custom .cqa-logo {
            width: 46px;
            height: auto;
        }

        .card-custom h4 {
            color: #0f172a;
            font-size: 1.05rem;
            letter-spacing: 0.2px;
        }

        .card-custom .divider-soft {
            width: 36px;
            height: 3px;
            background: #ffcc00;
            border-radius: 50px;
            margin: 0.4rem auto 0.55rem;
        }

        /* Form field wrapper + label */
        .field-group {
            margin-bottom: 0.75rem;
        }

        .field-label {
            display: block;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 0.3rem;
        }

        /* Modern input group styling */
        .input-modern {
            position: relative;
            display: flex;
            align-items: center;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .input-modern:focus-within {
            border-color: #251d3a;
            background: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(37, 29, 58, 0.15);
        }

        .input-modern .input-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.6rem;
            flex-shrink: 0;
            color: #94a3b8;
            font-size: 0.9rem;
            transition: color 0.2s ease;
        }

        .input-modern:focus-within .input-icon {
            color: #251d3a;
        }

        .input-modern .form-control {
            border: none;
            background: transparent;
            padding: 0.55rem 0.85rem 0.55rem 0;
            font-size: 0.88rem;
            box-shadow: none !important;
        }

        .input-modern .form-control:focus {
            outline: none;
            box-shadow: none;
        }

        .field-hint {
            font-size: 0.68rem;
            color: #94a3b8;
            margin-top: 0.3rem;
            line-height: 1.35;
        }

        .forgot-link {
            font-size: 0.75rem;
            font-weight: 600;
            color: #251d3a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: #3730a3;
            text-decoration: underline;
        }

        /* Primary login button */
        .btn-login {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border: none;
            border-radius: 0.75rem;
            padding: 0.6rem 1rem;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.2px;
            color: #ffffff;
            box-shadow: 0 8px 18px -6px rgba(37, 29, 58, 0.55);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

        .btn-login:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 12px 22px -6px rgba(37, 29, 58, 0.6);
            color: #ffffff;
        }

        .btn-login:active {
            transform: translateY(0);
        }

        /* Divider */
        .divider-or {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0.9rem 0;
        }

        .divider-or hr {
            flex: 1;
            margin: 0;
            border-top: 1px solid #e2e8f0;
            opacity: 1;
        }

        .divider-or span {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #94a3b8;
        }

        /* Google Button Styling */
        .btn-google {
            background-color: #ffffff;
            color: #334155;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1rem;
            transition: all 0.25s ease;
        }
        .btn-google.disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #251d3a;
            box-shadow: 0 6px 16px -4px rgba(37, 29, 58, 0.25);
            transform: translateY(-1px);
        }

        .btn-google:active {
            transform: translateY(0);
        }

        .btn-google img {
            width: 18px;
            height: 18px;
        }

        /* Extra small text helper */
        .text-xsmall {
            font-size: 0.75rem;
        }

        /* Home button (top-left, floating over the blurred background) */
        /* Home button — floating circular icon button, centered at the
           bottom of the viewport so it reads as a proper mobile-friendly
           FAB instead of a text pill competing with the header above it. */
        .btn-home {
            position: fixed;
            bottom: 1.25rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            font-size: 1.05rem;
            backdrop-filter: blur(6px);
            box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.45);
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-home:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            transform: translateX(-50%) translateY(-2px);
        }

        /* Same "viewing offline" pill as client-login.ejs / index.ejs —
           centered (not pinned to the top-right corner) so it reads as a
           deliberate status banner rather than a notification badge, and
           matches index.ejs's centered placement under its header. */
        .offline-pill {
            display: none;
            align-items: center;
            gap: 0.4rem;
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 20;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .offline-pill.is-visible { display: inline-flex; }
        .offline-pill .dot {
            width: 7px; height: 7px; border-radius: 50%; background: #d97706; flex: none;
            animation: offlinePulse 1.6s ease-in-out infinite;
        }
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

    </style>
</head>
<body>

    <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection.">
        <span class="dot"></span><span class="label">Viewing Offline</span>
    </span>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <a href="/" class="btn-home" title="Return to Home Page" aria-label="Return to Home Page">
        <i class="fas fa-home"></i>
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Login Portal</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-2">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                <h4 class="fw-bold text-dark mb-0">CQA Portal Login</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Sign in to your account</p>
            </div>

            <!-- UNIFIED LOGIN FORM (POST REQUEST) -->
            <form action="/auth-login" method="POST" id="loginForm">
                <div class="field-group">
                    <label class="field-label" for="usernameInput">Username or Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" name="username" id="usernameInput" class="form-control" placeholder="Enter your username or email" required title="Username or Email" autocomplete="off" list="usernameSuggestions">
                        <datalist id="usernameSuggestions"></datalist>
                    </div>
                    <p class="field-hint mb-0">Registered clients: enter the email and password you set up when you first signed in with Google.</p>
                </div>

                <div class="field-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="field-label mb-0" for="passwordInput">Password</label>
                        <a href="/forgot-password" class="forgot-link" title="Reset your password">Forgot Password?</a>
                    </div>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required title="Password">
                    </div>
                </div>

                <% if (recaptchaSiteKey) { %>
                <div class="field-group d-flex justify-content-center" id="recaptchaWrap">
                    <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>" data-callback="enableLoginSubmit" data-expired-callback="disableLoginSubmit" data-error-callback="disableLoginSubmit"></div>
                </div>
                <% } %>

                <!-- RECAPTCHA_SITE_KEY unset (e.g. local dev without it configured yet):
                     the widget above never renders, so the button starts enabled instead
                     of being permanently stuck disabled with no way to ever pass a check
                     that isn't even shown. Once a real key is set in .env, this reverts to
                     the normal disabled-until-verified behavior. -->
                <button type="submit" class="btn btn-login w-100" id="loginSubmitBtn" <%= recaptchaSiteKey ? 'disabled' : '' %> title="Sign in to your account">
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </form>

            <div class="divider-or">
                <hr>
                <span>OR</span>
                <hr>
            </div>

            <!-- GOOGLE SIGN-IN (Clients) -->
            <a href="/auth/google" class="btn btn-google w-100" id="googleSignInBtn" title="Sign in as a client with your Google account">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google">
                Sign in with Google
            </a>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        // The Login button stays disabled until the "I'm not a robot" checkbox
        // is checked (grecaptcha calls these on the global scope by name).
        function enableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = false;
        }
        function disableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = true;
        }
    </script>
    <script>
        const loginQueryParams = new URLSearchParams(window.location.search);
        let loginErrorMsg = loginQueryParams.get('error');

        // session_expired is a plain status code (not a human-readable message) —
        // set when login_token no longer matches admins.login_token, i.e. this
        // account logged in from another tab/device and this session was displaced.
        if (loginErrorMsg === 'session_expired') {
            loginErrorMsg = 'You have been logged out because this account was signed in from another tab or device.';
        }

        if (loginErrorMsg) {
            AppAlert.error(loginErrorMsg, 'Login Failed');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Native browser autofill remembers every value ever typed into a text
        // input (including plain admin usernames), so it's disabled above via
        // autocomplete="off". Instead we keep our own suggestion list that only
        // ever stores values that look like an email (i.e. contain '@'), so
        // admin usernames never show up as a suggestion here.
        (function () {
            const STORAGE_KEY = 'cqa_username_suggestions';
            const MAX_SUGGESTIONS = 10;

            function loadSuggestions() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    const list = raw ? JSON.parse(raw) : [];
                    return Array.isArray(list) ? list.filter(v => typeof v === 'string' && v.includes('@')) : [];
                } catch (e) {
                    return [];
                }
            }

            function saveSuggestion(value) {
                if (!value || !value.includes('@')) return;
                const list = loadSuggestions().filter(v => v.toLowerCase() !== value.toLowerCase());
                list.unshift(value);
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_SUGGESTIONS)));
                } catch (e) { /* ignore storage errors */ }
            }

            function renderDatalist() {
                const datalist = document.getElementById('usernameSuggestions');
                if (!datalist) return;
                datalist.innerHTML = '';
                loadSuggestions().forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    datalist.appendChild(option);
                });
            }

            renderDatalist();

            const form = document.getElementById('loginForm');
            const usernameInput = document.getElementById('usernameInput');
            if (form && usernameInput) {
                form.addEventListener('submit', function () {
                    saveSuggestion(usernameInput.value.trim());
                });
            }
        })();

        // Pressing Enter while in the username field moves focus to the
        // password field instead of submitting the form right away.
        (function () {
            const usernameInput = document.getElementById('usernameInput');
            const passwordInput = document.getElementById('passwordInput');
            if (usernameInput && passwordInput) {
                usernameInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        passwordInput.focus();
                    }
                });
            }
        })();
    </script>

    <script>
        // reCAPTCHA is a live, external Google script — it simply can't load
        // with no internet, so the widget is swapped for the form's own
        // offline path below instead of being left as a broken/blank iframe.
        function updateOfflineIndicator() {
            const offline = !navigator.onLine;

            const pill = document.getElementById('offlineIndicator');
            if (pill) pill.classList.toggle('is-visible', offline);

            const recaptchaWrap = document.getElementById('recaptchaWrap');
            if (recaptchaWrap) recaptchaWrap.classList.toggle('d-none', offline);

            // Online: normal behavior — button starts disabled until the
            // reCAPTCHA checkbox is checked (enableLoginSubmit()/
            // disableLoginSubmit() above). Offline: reCAPTCHA is hidden, so
            // there's nothing to wait on — the button is enabled up front
            // and submitting takes the offline path below instead of a POST.
            const submitBtn = document.getElementById('loginSubmitBtn');
            if (submitBtn && offline) submitBtn.disabled = false;
        }
        window.addEventListener('online', updateOfflineIndicator);
        window.addEventListener('offline', updateOfflineIndicator);
        updateOfflineIndicator();

        // OFFLINE SIGN-IN: a real password check against the database is
        // impossible with no network — there's no server to ask. What this
        // verifies instead is device history: did THIS browser already cache
        // a session for the email being entered, from a previous successful
        // ONLINE login (password or Google, both cache the same
        // cspc_client_session — see client-survey.ejs)? If so, the browser
        // already has that account's authenticated survey page cached by the
        // service worker, so redirecting there works with zero network
        // requests. If the typed email doesn't match anything cached on this
        // device, there is nothing to fall back to — no combination of
        // client code can verify a password without reaching the server, so
        // that case is reported plainly rather than silently failing.
        function attemptOfflineLogin(event) {
            if (navigator.onLine) return true; // let the normal online POST proceed

            event.preventDefault();

            const emailInput = (document.getElementById('usernameInput').value || '').trim().toLowerCase();
            let cached = null;
            try { cached = JSON.parse(localStorage.getItem('cspc_client_session') || 'null'); } catch (e) { /* no cached session */ }

            console.log('[Offline Login] typed email:', emailInput, '| cached session:', cached);

            if (cached && cached.email && cached.email.toLowerCase() === emailInput) {
                window.location.href = '/client-survey';
                return false;
            }

            const message = cached
                ? 'This device\'s saved offline session is for a different account (' + cached.email + '). Connect to the internet and sign in as ' + emailInput + ' at least once first.'
                : 'This device has no offline session saved yet. Connect to the internet and sign in once first — after that, this same account can sign in offline here.';

            // Never let a failure to load the SweetAlert2 CDN library (itself
            // possible while offline, e.g. this is the very first page ever
            // opened in this browser) leave the user staring at a form that
            // silently did nothing — an uncaught error inside an event
            // listener shows nothing on screen. window.alert() has zero
            // dependencies and always works.
            try {
                if (window.AppAlert) {
                    AppAlert.error(message, "Can't Sign In Offline");
                } else {
                    window.alert(message);
                }
            } catch (err) {
                console.error('[Offline Login] AppAlert failed, falling back to window.alert:', err);
                window.alert(message);
            }
            return false;
        }
        document.getElementById('loginForm').addEventListener('submit', attemptOfflineLogin);

        // Landing here already offline with a cached session on this device —
        // skip the form entirely instead of making them click Login first.
        (function () {
            if (navigator.onLine) return;
            try {
                const cached = JSON.parse(localStorage.getItem('cspc_client_session') || 'null');
                if (cached && cached.email) {
                    window.location.href = '/client-survey';
                }
            } catch (e) { /* no cached session — stay on the login form */ }
        })();

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }
    </script>
</body>
</html>