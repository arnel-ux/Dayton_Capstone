[Unit]
Description=CQA Admin Portal (Node/Express + AI model server)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
# venv/bin first so Node's spawn('python', ...) resolves to the venv's
# interpreter (with torch/transformers installed), not the bare system python3.
Environment=PATH=__VENV_DIR__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
# The Python model server loads ~1GB of transformer weights on top of Node —
# give it real headroom.
MemoryMax=3G

[Install]
WantedBy=multi-user.target
