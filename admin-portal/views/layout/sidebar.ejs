<%
    // Set globally in server.js via res.locals.currentPath.
    const _path = typeof currentPath !== 'undefined' ? currentPath : '';
    const isClusterPage = _path.startsWith('/cluster');
    const isReportPage = _path.startsWith('/report');
    // Comes from ensureAdminAuth, pulled fresh from the clusters table each request.
    const _sidebarClusters = typeof sidebarClusters !== 'undefined' ? sidebarClusters : [];
    const clusterLinks = _sidebarClusters.map(c => ({
        href: '/cluster/' + c.id, icon: 'fa-layer-group', label: c.cluster_name
    }));
    const _currentAdmin = typeof currentAdmin !== 'undefined' ? currentAdmin : null;
    // Profile, Manage Password, and Manage Admins live in the navbar dropdown instead.
    const mainLinks = [
        { href: '/dashboard', icon: 'fa-th-large', label: 'Dashboard' },
        { href: '/survey', icon: 'fa-clipboard-list', label: 'Survey Management' },
        { href: '/offices', icon: 'fa-building', label: 'Manage Offices' },
        { href: '/user-accounts', icon: 'fa-user-check', label: 'User Accounts' }
    ];
    // Dashboard (mainLinks[0]) is rendered separately below, slice(1) covers the rest.
    const reportLinks = [
        { href: '/report', icon: 'fa-file-export', label: 'Overall Report' },
        { href: '/report/dashboard', icon: 'fa-chart-line', label: 'Dashboard Report' }
    ];
%>
<nav id="sidebar">
    <div class="sidebar-header d-flex flex-column align-items-center text-center pt-4 pb-3 border-bottom border-secondary">
        <img src="/images/cspc-logo.png" class="sidebar-logo mb-2" width="64" height="64" alt="CSPC Logo">
        <div>
            <h4 class="m-0 fw-bold text-white">CQA PORTAL</h4>
            <small class="sidebar-subtitle">Admin System</small>
        </div>
    </div>

    <ul class="list-unstyled components mt-3">
        <li class="nav-item">
            <a href="/dashboard" title="Dashboard" class="d-flex align-items-center<%= _path === '/dashboard' ? ' active' : '' %>">
                <i class="fas fa-th-large me-3"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <li class="nav-item">
            <a href="#statisticsSubmenu" title="All Cluster" data-bs-toggle="collapse" aria-expanded="<%= isClusterPage ? 'true' : 'false' %>" class="dropdown-toggle d-flex align-items-center<%= isClusterPage ? ' active' : '' %>">
                <i class="fas fa-chart-pie me-3"></i>
                <span>All Cluster</span>
                <i class="fas fa-chevron-down ms-auto rotate-icon"></i>
            </a>
            <ul class="collapse list-unstyled submenu-bg<%= isClusterPage ? ' show' : '' %>" id="statisticsSubmenu">
                <li class="flyout-label d-none">All Cluster</li>
                <% clusterLinks.forEach(link => { %>
                    <li>
                        <a href="<%= link.href %>" title="<%= link.label %>" class="d-flex align-items-center<%= _path === link.href ? ' active' : '' %>">
                            <i class="fas <%= link.icon %> submenu-icon"></i>
                            <span><%= link.label %></span>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </li>

        <% mainLinks.slice(1).forEach(link => { %>
            <li class="nav-item">
                <a href="<%= link.href %>" title="<%= link.label %>" class="d-flex align-items-center<%= _path === link.href ? ' active' : '' %>">
                    <i class="fas <%= link.icon %> me-3"></i> <span><%= link.label %></span>
                </a>
            </li>
        <% }) %>

    </ul>
</nav>

<!-- Mobile backdrop, shown under 768px while the sidebar is open. Closing it is wired in main.js. -->
<div id="sidebar-overlay" aria-hidden="true"></div>

<script>
    // Runs immediately, not deferred, so the collapsed rail is restored before first paint.
    (function () {
        try {
            if (window.innerWidth > 768 && localStorage.getItem('sidebarCollapsed') === '1') {
                document.getElementById('sidebar').classList.add('collapsed');
            }
        } catch (e) {}
    })();
</script>

<style>
    /* Header stays put, ul.components is the only part that scrolls internally. */
    #sidebar .sidebar-header {
        padding: 20px;
        background: rgba(0, 0, 0, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        flex-shrink: 0;
    }
    #sidebar ul.components {
        padding: 20px 0;
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    #sidebar ul.components::-webkit-scrollbar {
        display: none;
    }

    #sidebar ul li a {
        padding: 12px 20px;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.92rem;
        font-weight: 500;
        transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease, transform 180ms ease;
        border-left: 3px solid transparent;
    }
    #sidebar ul li a:focus-visible {
        outline: 2px solid var(--accent, #ffcc00);
        outline-offset: -2px;
    }

    .sidebar-logo {
        width: 64px;
        height: 64px;
        background: radial-gradient(circle, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0) 72%);
        object-fit: contain;
    }

    .sidebar-subtitle {
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.75rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .rotate-icon {
        font-size: 0.75rem;
        transition: transform 0.3s ease;
    }
    #sidebar ul li a[aria-expanded="true"] .rotate-icon {
        transform: rotate(180deg);
    }

    .submenu-bg {
        background: rgba(0, 0, 0, 0.18);
    }

    #statisticsSubmenu li a {
        padding: 9px 12px 9px 48px !important;
        font-size: 0.85rem;
        background: transparent;
        border-left: none;
    }

    .submenu-icon {
        width: 18px;
        margin-right: 12px;
        text-align: center;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.8rem;
    }

    .nav-item i {
        width: 18px;
        text-align: center;
        font-size: 0.9rem;
    }

    #sidebar ul li a:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        transform: translateX(2px);
    }

    /* Highlights the current page or cluster. */
    #sidebar ul li a.active {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        border-left-color: var(--accent, #ffcc00);
        font-weight: 600;
    }
    #statisticsSubmenu li a.active {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
    }

    /* Collapsed icon rail state, desktop only. */
    /* One transition rule covers both the desktop rail collapse and the mobile drawer slide. */
    #sidebar {
        transition: min-width 0.28s ease-out, max-width 0.28s ease-out, margin-left 0.3s ease-out;
    }
    #sidebar.collapsed {
        min-width: 76px;
        max-width: 76px;
    }
    /* Turns off scrolling in collapsed mode so the flyout submenus aren't clipped. */
    #sidebar.collapsed {
        overflow: visible;
    }
    #sidebar.collapsed ul.components {
        overflow: visible;
    }
    #sidebar.collapsed .sidebar-header h4,
    #sidebar.collapsed .sidebar-header small,
    #sidebar.collapsed ul.components > li > a span,
    #sidebar.collapsed ul.components > li > a .rotate-icon {
        display: none;
    }
    #sidebar.collapsed .sidebar-logo { width: 40px; height: 40px; }
    #sidebar.collapsed ul.components > li > a {
        justify-content: center;
        padding: 12px 0;
    }
    #sidebar.collapsed .nav-item i { margin-right: 0 !important; }

    /* Submenus become a flyout panel on hover instead of an inline dropdown,
       since there's no room to show sub-labels in the 76px rail. */
    #sidebar.collapsed .nav-item { position: relative; }
    #sidebar.collapsed .nav-item:hover > ul.collapse {
        display: block !important;
        position: absolute;
        left: 100%;
        top: 0;
        min-width: 230px;
        background: var(--navy-800, #2a2550);
        border-radius: 0 12px 12px 0;
        box-shadow: 0 12px 28px rgba(0,0,0,0.4);
        padding: 8px 0;
        z-index: 1100;
        animation: flyoutIn 0.15s ease-out;
    }
    #sidebar.collapsed .nav-item:hover > ul.collapse .flyout-label {
        display: block !important;
        padding: 6px 16px 8px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.45);
    }
    #sidebar.collapsed .nav-item:hover > ul.collapse li a {
        padding: 9px 16px !important;
    }
    @keyframes flyoutIn {
        from { opacity: 0; transform: translateX(-4px); }
        to { opacity: 1; transform: translateX(0); }
    }

    @media (max-width: 768px) {
        #sidebar.collapsed { min-width: var(--sidebar-width); max-width: var(--sidebar-width); }
        #sidebar.collapsed .sidebar-header h4,
        #sidebar.collapsed .sidebar-header small,
        #sidebar.collapsed ul.components > li > a span,
        #sidebar.collapsed ul.components > li > a .rotate-icon { display: revert; }
        #sidebar.collapsed ul.components > li > a { justify-content: flex-start; padding: 12px 20px; }
        #sidebar.collapsed .nav-item i { margin-right: 12px !important; }
    }

    /* prefers-reduced-motion is already handled globally in style.css. */
</style>
