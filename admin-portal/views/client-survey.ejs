    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    htmlElement.setAttribute('data-bs-theme', newTheme);

    const themeBtn = document.getElementById('btn-theme');
    if (newTheme === 'dark') {
        themeBtn.innerHTML = '☀️ Light';
    } else {
        themeBtn.innerHTML = '🌙 Dark';
    }
}

