<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header', { forceLightMode: true }) %>
    <style>
        /* Reset and Base Styles */
        html, body {
            height: 100vh;
            margin: 0;
            padding: 0;
            overflow: hidden; /* Para walang lumabas na scrollbar */
            font-family: 'Plus Jakarta Sans', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        /* 1. Background Image — same photo + treatment as the public landing
           page (index.ejs .bg-image): full-bleed, no blur, so the two pages
           read as one consistent backdrop. */
        .bg-blurred {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url('<%- heroImageUrl %>');
            background-size: cover;
            /* The CSPC monument (seal/torch/globe) sits in the upper half
               of this photo. On a tall mobile viewport, "cover" scales the
               image up enough that centering it vertically cropped the
               monument almost entirely out of frame, leaving mostly sky and
               pavement — anchoring to the top keeps it in view. */
            background-position: top center;
            background-repeat: no-repeat;
            z-index: -2;
        }

        /* 2. Overlay — same navy gradient as the landing page's .bg-overlay,
           instead of a flat tint, so the two pages match. */
        .bg-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(180deg, rgba(37, 29, 58,0.92) 0%, rgba(37, 29, 58,0.85) 100%);
            z-index: -1;
        }

        /* 3. Header-anchored wrapper — the header sits at a FIXED offset from the
           top of the viewport (not vertically centered as one block with the
           card below it). Centering the whole [header + card] group made the
           header land at a different height on every auth page depending on
           how tall that page's card happened to be (e.g. login's card with
           reCAPTCHA vs. forgot-password's shorter card) — pinning the header
           instead is what keeps it at the exact same spot across every page
           that shares this block (login.ejs, forgot-password.ejs,
           reset-password.ejs, complete-google-registration.ejs). */
        .login-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            max-height: 100vh;
            display: flex;
            flex-direction: column; /* Para magpatong ang titles at card */
            align-items: center;    /* Centers horizontally */
            justify-content: flex-start;
            padding: 1rem;
            padding-top: clamp(1.5rem, 9vh, 4rem);
            padding-bottom: 5rem;
            z-index: 1;
            overflow-y: auto; /* Safety fallback: scroll instead of clipping on short viewports */
        }

        /* --- BAGONG DAGDAG NA HEADER STYLES & ANIMATIONS --- */
        
        /* Keyframes para sa Fade & Slide Up Animation */
        @keyframes fadeSlideUp {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header-container {
            text-align: center;
            margin-bottom: 1.1rem;
            max-width: 800px; /* Para hindi masyadong humaba sa malaking screen */
            flex-shrink: 0;
        }

        .main-title {
            color: #ffffff;
            font-weight: 800;
            font-size: 1.5rem;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.35rem;
            letter-spacing: 0.3px;
            line-height: 1.25;

            /* Apply animation (Mauuna) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out forwards;
        }

        .sub-title {
            color: #e2e8f0;
            font-weight: 400;
            font-style: italic; /* Ibang style as requested */
            font-size: 0.85rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
            margin-bottom: 0.6rem;

            /* Apply animation (Pangalawa, may delay na 0.3s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.3s forwards;
        }

        .portal-text {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #ffffff; /* Distinct gold/yellow color para sa Admin Portal */
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 2.2px;
            padding: 0.3rem 0.9rem;
            background: rgba(255, 204, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 50px;
            backdrop-filter: blur(6px);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 0;

            /* Apply animation (Pangatlo, may delay na 0.6s) */
            opacity: 0;
            animation: fadeSlideUp 0.8s ease-out 0.6s forwards;
        }

        /* Responsive para sa Titles */
        @media (max-width: 600px) {
            /* Density pass: hero title (18.4px) and subtitle (12.48px) both
               ran under the 22-26px / 14-16px targets — bumped into range.
               Badge text/padding tuned via .portal-text's min-height below. */
            .main-title {
                font-size: 1.4rem;
            }
            .sub-title {
                font-size: 0.9rem;
                margin-bottom: 0.5rem;
            }
            .portal-text {
                font-size: 0.68rem;
                min-height: 36px;
                padding: 0.4rem 0.9rem;
            }
        }
        /* -------------------------------------- */

        /* 4. Card Styling — refined glassmorphism, soft layered shadow */
        .card-custom {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(18px) saturate(160%);
            -webkit-backdrop-filter: blur(18px) saturate(160%);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 1.75rem;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;

            /* Dito natin ginawang Square */
            width: 400px;
            height: auto;
            flex-shrink: 0;

            /* Para mag-center ang content sa loob ng square */
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 1.5rem 2.25rem;
            opacity: 0;
            animation: fadeSlideUp 0.7s ease-out 0.15s forwards;
        }

        /* Responsive para sa mobile card
           NOTE: the fixed 400px card width above (plus the wrapper's 1rem/16px
           side padding) needs >= 432px of viewport to avoid overflowing —
           but common phones (375/390/393/412/414/428/430px) are ALL narrower
           than that, and html/body has overflow:hidden, so on every real phone
           the card was getting clipped off-screen on the sides instead of
           shrinking. Raised the breakpoint from 400px to 480px so it now
           covers every phone width, including the larger Pro Max/Android
           sizes the old 400px cutoff missed. */
        @media (max-width: 480px) {
            /* Round-2: hero-to-card gap trimmed further. */
            .header-container { margin-bottom: 0.7rem; }
            /* Density pass: card was 92vw with 21.6/24px padding on a 28px
               desktop border-radius — resized to the calc(100% - 24px) /
               18-20px-padding / 22-26px-radius login-card targets, logo
               bumped from an under-target 46px, and the "CQA Portal Login"
               heading (16.8px, unchanged since desktop) brought up into the
               21-23px target. */
            .card-custom {
                width: calc(100% - 24px);
                margin-inline: 12px;
                height: auto;
                padding: 1rem 1rem;
                border-radius: 22px;
            }
            .card-custom .cqa-logo { width: 50px; }
            .card-custom h4 { font-size: 1.35rem; }
            .card-custom p.text-xsmall { font-size: 0.92rem; }
            /* Google's reCAPTCHA checkbox widget is a fixed 304x78px iframe —
               wider than the card's content area on every phone (the card's
               own side padding leaves well under 304px). Scaling it down
               and shrinking its layout box by the same factor keeps it fully
               inside the card instead of poking out past the edge. */
            .g-recaptcha {
                transform: scale(0.85);
                transform-origin: 0 0;
                width: 258px;
                height: 66px;
            }

            /* ---- Touch targets + readability ----
               The text inputs were ~34px tall with a 14.08px font — under the
               ~44px comfortable tap-height guideline, and critically, any
               input with a font-size below 16px makes iOS Safari auto-zoom
               the whole page on focus (jarring layout jump, easy to trigger
               here since these are the very first fields a phone user taps).
               16px input text avoids that zoom outright — kept at 16px even
               though it sits slightly above the general 14-15px mobile input
               target, since regressing to 14-15px would reintroduce the
               auto-zoom bug this fix was written for. Vertical padding
               trimmed instead so overall input height lands at ~44px (was
               ~48px), inside the 42-46px target. */
            .input-modern .form-control {
                font-size: 16px;
                padding: 0.5rem 0.85rem 0.5rem 0;
                min-height: 41px;
            }
            .input-modern .input-icon { width: 2.6rem; font-size: 1.1rem; }
            .field-group { margin-bottom: 0.6rem; }
            .field-label { font-size: 0.8rem; margin-bottom: 0.3rem; }
            .field-hint { font-size: 0.74rem; margin-top: 0.35rem; }

            /* Buttons: kept >=40px tap height, unchanged legible font. */
            .btn-login, .btn-google {
                padding: 0.6rem 1rem;
                font-size: 0.95rem;
                min-height: 40px;
            }

            /* "Forgot Password?" sits inline next to the Password label —
               it's a short link with almost no hit area beyond its own text
               height. Padding it (and giving the row more gap) turns it into
               a real tap target and keeps a thumb from clipping the label
               next to it. */
            .forgot-link {
                padding: 0.35rem 0;
                margin: -0.35rem 0;
                font-size: 0.85rem;
            }
            .field-group .d-flex.justify-content-between { gap: 0.75rem; }

            .divider-or { margin: 0.6rem 0; }

            /* Subtitle/eyebrow text was down at 12.48px/10.4px — bump both
               into comfortably-readable territory on a phone screen. */
            .sub-title { font-size: 0.9rem; }
            .portal-text { font-size: 0.7rem; padding: 0.4rem 0.9rem; min-height: 36px; }

        }

        /* Narrowest phones (320-375px): the reCAPTCHA's 0.85 scale above
           (258px effective width) can still run past the card's content
           width once the card itself has shrunk to calc(100% - 24px) with
           its own side padding subtracted — measured as low as ~226px on a
           320px-wide viewport. Scaled down further here, without hiding any
           of Google's own widget text/warnings (same iframe, smaller box). */
        @media (max-width: 375px) {
            .g-recaptcha {
                transform: scale(0.74);
                transform-origin: 0 0;
                width: 225px;
                height: 58px;
            }
        }

        .card-custom .cqa-logo {
            width: 46px;
            height: auto;
        }

        .card-custom h4 {
            color: #0f172a;
            font-size: 1.05rem;
            letter-spacing: 0.2px;
        }

        .card-custom .divider-soft {
            width: 36px;
            height: 3px;
            background: #ffcc00;
            border-radius: 50px;
            margin: 0.4rem auto 0.55rem;
        }

        /* Form field wrapper + label */
        .field-group {
            margin-bottom: 0.75rem;
        }

        .field-label {
            display: block;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 0.3rem;
        }

        /* Modern input group styling */
        .input-modern {
            position: relative;
            display: flex;
            align-items: center;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        }

        .input-modern:focus-within {
            border-color: #251d3a;
            background: #ffffff;
            box-shadow: 0 0 0 0.2rem rgba(37, 29, 58, 0.15);
        }

        .input-modern .input-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.6rem;
            flex-shrink: 0;
            color: #94a3b8;
            font-size: 0.9rem;
            transition: color 0.2s ease;
        }

        .input-modern:focus-within .input-icon {
            color: #251d3a;
        }

        .input-modern .form-control {
            border: none;
            background: transparent;
            padding: 0.55rem 0.85rem 0.55rem 0;
            font-size: 0.88rem;
            box-shadow: none !important;
        }

        .input-modern .form-control:focus {
            outline: none;
            box-shadow: none;
        }

        .field-hint {
            font-size: 0.68rem;
            color: #94a3b8;
            margin-top: 0.3rem;
            line-height: 1.35;
        }

        .forgot-link {
            font-size: 0.75rem;
            font-weight: 600;
            color: #251d3a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: #3730a3;
            text-decoration: underline;
        }

        /* Primary login button */
        .btn-login {
            background: linear-gradient(135deg, #251d3a, #2a2550);
            border: none;
            border-radius: 0.75rem;
            padding: 0.6rem 1rem;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 0.2px;
            color: #ffffff;
            box-shadow: 0 8px 18px -6px rgba(37, 29, 58, 0.55);
            transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

        .btn-login:hover {
            filter: brightness(1.06);
            transform: translateY(-1px);
            box-shadow: 0 12px 22px -6px rgba(37, 29, 58, 0.6);
            color: #ffffff;
        }

        .btn-login:active {
            transform: translateY(0);
        }

        /* Divider */
        .divider-or {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin: 0.9rem 0;
        }

        .divider-or hr {
            flex: 1;
            margin: 0;
            border-top: 1px solid #e2e8f0;
            opacity: 1;
        }

        .divider-or span {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            color: #94a3b8;
        }

        /* Google Button Styling */
        .btn-google {
            background-color: #ffffff;
            color: #334155;
            border: 1.5px solid #e2e8f0;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0.6rem 1rem;
            transition: all 0.25s ease;
        }
        .btn-google.disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

        .btn-google:hover {
            background-color: #f8fafc;
            border-color: #251d3a;
            box-shadow: 0 6px 16px -4px rgba(37, 29, 58, 0.25);
            transform: translateY(-1px);
        }

        .btn-google:active {
            transform: translateY(0);
        }

        .btn-google img {
            width: 18px;
            height: 18px;
        }

        /* Extra small text helper */
        .text-xsmall {
            font-size: 0.75rem;
        }

        /* Home button (top-left, floating over the blurred background) */
        /* Home button — floating circular icon button, centered at the
           bottom of the viewport so it reads as a proper mobile-friendly
           FAB instead of a text pill competing with the header above it. */
        .btn-home {
            position: fixed;
            bottom: 1.25rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            width: 3rem;
            height: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            font-size: 1.05rem;
            backdrop-filter: blur(6px);
            box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.45);
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-home:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
            transform: translateX(-50%) translateY(-2px);
        }

        /* Same "viewing offline" pill as client-login.ejs / index.ejs —
           centered (not pinned to the top-right corner) so it reads as a
           deliberate status banner rather than a notification badge, and
           matches index.ejs's centered placement under its header. */
        .offline-pill {
            display: none;
            align-items: center;
            gap: 0.4rem;
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 20;
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            font-size: 0.78rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .offline-pill.is-visible { display: inline-flex; }
        .offline-pill .dot {
            width: 7px; height: 7px; border-radius: 50%; background: #d97706; flex: none;
            animation: offlinePulse 1.6s ease-in-out infinite;
        }
        @keyframes offlinePulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

        .offline-login-notice {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: #fef3c7;
            color: #92400e;
            border: 1px solid #fde68a;
            border-radius: 10px;
            padding: 0.65rem 0.85rem;
            font-size: 0.82rem;
            font-weight: 600;
            line-height: 1.4;
            margin-bottom: 0.85rem;
        }
        /* Genuine server-side failure (a real response came back, just not an
           ok one) is visually distinct from the amber "your connection is
           slow" case above — red reads as "something is actually wrong",
           amber reads as "hang tight". */
        .offline-login-notice.is-error {
            background: #fee2e2;
            color: #991b1b;
            border-color: #fecaca;
        }
        .offline-login-notice span { flex: 1 1 auto; }
        .offline-login-notice .notice-retry-btn {
            flex: 0 0 auto;
            background: rgba(255,255,255,0.55);
            border: 1px solid currentColor;
            color: inherit;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            padding: 0.25rem 0.7rem;
            min-height: 30px;
        }
        .offline-login-notice .notice-retry-btn:hover { background: rgba(255,255,255,0.85); }

    </style>
</head>
<body>

    <span id="offlineIndicator" class="offline-pill" role="status" title="No internet connection.">
        <span class="dot"></span><span class="label">Viewing Offline</span>
    </span>

    <div class="bg-blurred"></div>
    <div class="bg-overlay"></div>

    <a href="/" class="btn-home" title="Return to Home Page" aria-label="Return to Home Page">
        <i class="fas fa-home"></i>
    </a>

    <div class="login-wrapper">

        <div class="header-container">
            <h1 class="main-title">Office Of Center For Quality Assurance (CQA)</h1>
            <p class="sub-title">Digital Client Satisfaction Survey of Camarines Sur Polytechnic Colleges</p>
            <h2 class="portal-text">Login Portal</h2>
        </div>

        <div class="card-custom">

            <div class="text-center mb-2">
                <img src="/images/cspc-logo.png" alt="CSPC Logo" class="cqa-logo mb-1" width="46" height="46">
                <h4 class="fw-bold text-dark mb-0">CQA Portal Login</h4>
                <div class="divider-soft"></div>
                <p class="text-muted text-xsmall mb-0">Sign in to your account</p>
            </div>

            <!-- Blocks starting a NEW login while an old session's server-
                 side logout is still unresolved — see the race condition
                 explained on guardLoginAgainstPendingLogout() below. Reuses
                 the same .offline-login-notice/.notice-retry-btn styling as
                 #serverUnavailableNotice (an existing reusable pattern, not
                 a new one) rather than introducing another notice design. -->
            <div id="pendingLogoutNotice" class="offline-login-notice d-none">
                <i id="pendingLogoutNoticeIcon" class="fas fa-hourglass-half"></i>
                <span id="pendingLogoutNoticeText">Finishing your previous session…</span>
                <button type="button" id="pendingLogoutRetryBtn" class="notice-retry-btn d-none">Retry</button>
            </div>

            <div id="serverUnavailableNotice" class="offline-login-notice d-none">
                <i id="serverUnavailableNoticeIcon" class="fas fa-triangle-exclamation"></i>
                <span id="serverUnavailableNoticeText">Server temporarily unavailable. Please try again.</span>
                <button type="button" class="notice-retry-btn" onclick="checkServerHealth()">Retry</button>
            </div>

            <!-- Offline: signing in for real always needs the server (there is
                 no way to check a password with zero network access), so this
                 replaces the login form entirely rather than pretending it can
                 still work. Leads to the unauthenticated /survey-offline flow,
                 whose own account/password verification happens once back
                 online — see offline-db.js / pwa-client.js. -->
            <a href="/survey-offline" id="offlineSurveyBtn" class="btn btn-login w-100 d-none text-decoration-none mb-3" title="Complete the survey now — your account is verified once you're back online">
                <i class="fas fa-clipboard-list me-2"></i> Take Survey Offline
            </a>

            <!-- UNIFIED LOGIN FORM (POST REQUEST) -->
            <form action="/auth-login" method="POST" id="loginForm">
                <div class="field-group">
                    <label class="field-label" for="usernameInput">Username or Email</label>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-user"></i></span>
                        <input type="text" name="username" id="usernameInput" class="form-control" placeholder="Enter your username or email" required title="Username or Email" autocomplete="off" list="usernameSuggestions">
                        <datalist id="usernameSuggestions"></datalist>
                    </div>
                    <p class="field-hint mb-0">Registered clients: enter the email and password you set up when you first signed in with Google.</p>
                </div>

                <div class="field-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="field-label mb-0" for="passwordInput">Password</label>
                        <a href="/forgot-password" class="forgot-link" title="Reset your password">Forgot Password?</a>
                    </div>
                    <div class="input-modern">
                        <span class="input-icon"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Enter your password" required title="Password">
                    </div>
                </div>

                <% if (recaptchaSiteKey) { %>
                <div class="field-group d-flex justify-content-center" id="recaptchaWrap">
                    <div class="g-recaptcha" data-sitekey="<%= recaptchaSiteKey %>" data-callback="enableLoginSubmit" data-expired-callback="disableLoginSubmit" data-error-callback="disableLoginSubmit"></div>
                </div>
                <% } %>

                <!-- RECAPTCHA_SITE_KEY unset (e.g. local dev without it configured yet):
                     the widget above never renders, so the button starts enabled instead
                     of being permanently stuck disabled with no way to ever pass a check
                     that isn't even shown. Once a real key is set in .env, this reverts to
                     the normal disabled-until-verified behavior. -->
                <button type="submit" class="btn btn-login w-100" id="loginSubmitBtn" <%= recaptchaSiteKey ? 'disabled' : '' %> title="Sign in to your account">
                    <i class="fas fa-sign-in-alt me-2"></i> Login
                </button>
            </form>

            <div class="divider-or">
                <hr>
                <span>OR</span>
                <hr>
            </div>

            <!-- GOOGLE SIGN-IN (Clients) -->
            <a href="/auth/google" class="btn btn-google w-100" id="googleSignInBtn" title="Sign in as a client with your Google account">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google">
                Sign in with Google
            </a>

        </div>
    </div>

    <script>
        // Marks a real landing on the login page in THIS browser tab (sessionStorage
        // is tab-scoped, so this can never bleed into a different tab or a different
        // admin's browser) so that if the user later presses Forward, the shared
        // bfcache guard (public/js/main.js) redirects back here instead of letting
        // the browser silently restore a previously-cached authenticated admin page.
        // Deliberately NOT done by destroying the server-side session here — see the
        // "must NOT destroy any session" comment on the /login route in server.js:
        // admin.sid is shared by every tab in the browser, so that would log out
        // every OTHER open admin tab too.
        try { sessionStorage.setItem('__loginBoundary', window.location.pathname); } catch (e) {}
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/alerts.js"></script>
    <script src="/js/offline-db.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        // The Login button stays disabled until the "I'm not a robot" checkbox
        // is checked (grecaptcha calls these on the global scope by name).
        function enableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = false;
        }
        function disableLoginSubmit() {
            const btn = document.getElementById('loginSubmitBtn');
            if (btn) btn.disabled = true;
        }
    </script>
    <script>
        const loginQueryParams = new URLSearchParams(window.location.search);
        const loginErrorMsg = loginQueryParams.get('error');

        // Freeform error text (invalid credentials, server errors, the
        // new-tab auth guards in header.ejs/client-survey.ejs/office-approvals.ejs) —
        // unrelated to the semantic session states below, untouched.
        if (loginErrorMsg) {
            AppAlert.error(loginErrorMsg, 'Login Failed');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Explicit semantic session states — one flash param, one accurate
        // message each, shared by both the Admin and Client login flows on
        // this same page. Deliberately NOT collapsed into the freeform
        // `error` message above: manual logout, session expiration, login-
        // required, and a real cross-device/tab session replacement are four
        // different events (see ensureAdminAuth/ensureClientAuth/`/logout`
        // in server.js) and must never share one ambiguous flag or wording —
        // in particular, an ordinary session timeout must never be reported
        // as "logged in on another device," which requires actual evidence
        // (a real newer login) to say, not just "the old session is gone."
        const loginStatus = loginQueryParams.get('status');
        const STATUS_MESSAGES = {
            logged_out: { type: 'success', title: 'Logged Out', text: 'You have been logged out successfully.' },
            session_expired: { type: 'warning', title: 'Session Expired', text: 'Your session has expired. Please log in again.' },
            login_required: { type: 'info', title: 'Login Required', text: 'Please log in to continue.' },
            session_replaced: { type: 'warning', title: 'Signed In Elsewhere', text: 'Your session ended because this account was signed in from another device or browser.' }
        };
        if (loginStatus && STATUS_MESSAGES[loginStatus]) {
            const s = STATUS_MESSAGES[loginStatus];
            // logged_out reuses the same AppAlert toast design as the Client
            // Profile "updated successfully" notification; the other three
            // are less routine/more worth reading, so they use the standard
            // (non-auto-dismissing until acknowledged for warning/info)
            // AppAlert modal instead of a corner toast.
            if (s.type === 'success') {
                AppAlert.toastSuccess(s.text, { title: s.title });
            } else {
                AppAlert[s.type](s.text, s.title);
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // Native browser autofill remembers every value ever typed into a text
        // input (including plain admin usernames), so it's disabled above via
        // autocomplete="off". Instead we keep our own suggestion list that only
        // ever stores values that look like an email (i.e. contain '@'), so
        // admin usernames never show up as a suggestion here.
        (function () {
            const STORAGE_KEY = 'cqa_username_suggestions';
            const MAX_SUGGESTIONS = 10;

            function loadSuggestions() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    const list = raw ? JSON.parse(raw) : [];
                    return Array.isArray(list) ? list.filter(v => typeof v === 'string' && v.includes('@')) : [];
                } catch (e) {
                    return [];
                }
            }

            function saveSuggestion(value) {
                if (!value || !value.includes('@')) return;
                const list = loadSuggestions().filter(v => v.toLowerCase() !== value.toLowerCase());
                list.unshift(value);
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(list.slice(0, MAX_SUGGESTIONS)));
                } catch (e) { /* ignore storage errors */ }
            }

            function renderDatalist() {
                const datalist = document.getElementById('usernameSuggestions');
                if (!datalist) return;
                datalist.innerHTML = '';
                loadSuggestions().forEach(value => {
                    const option = document.createElement('option');
                    option.value = value;
                    datalist.appendChild(option);
                });
            }

            renderDatalist();

            const form = document.getElementById('loginForm');
            const usernameInput = document.getElementById('usernameInput');
            if (form && usernameInput) {
                form.addEventListener('submit', function () {
                    saveSuggestion(usernameInput.value.trim());
                });
            }
        })();

        // Pressing Enter while in the username field moves focus to the
        // password field instead of submitting the form right away.
        (function () {
            const usernameInput = document.getElementById('usernameInput');
            const passwordInput = document.getElementById('passwordInput');
            if (usernameInput && passwordInput) {
                usernameInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        passwordInput.focus();
                    }
                });
            }
        })();
    </script>

    <script>
        // Connectivity indicator: purely navigator.onLine. This is the ONLY
        // signal that controls the "Take Survey Offline" button — kept
        // strictly decoupled from the /api/health probe below, which drives
        // a separate "server unavailable" notice for the very different case
        // of the browser being online but unable to reach this app's server.
        // The normal login form (username/password + reCAPTCHA) is never
        // touched by either state — a real sign-in always needs the network
        // regardless of which of these two things is failing, so there is no
        // "offline login" shortcut here anymore; see /survey-offline instead.
        function updateOfflineIndicator() {
            const offline = !navigator.onLine;

            const pill = document.getElementById('offlineIndicator');
            if (pill) pill.classList.toggle('is-visible', offline);

            const offlineSurveyBtn = document.getElementById('offlineSurveyBtn');
            if (offlineSurveyBtn) offlineSurveyBtn.classList.toggle('d-none', !offline);
        }
        window.addEventListener('online', updateOfflineIndicator);
        window.addEventListener('offline', updateOfflineIndicator);
        updateOfflineIndicator();

        // Independent of navigator.onLine: the browser can report "online"
        // while this app's own server is unreachable (down for maintenance,
        // a network path issue between here and the server, etc). Only
        // checked when navigator.onLine is true, since there's no point
        // asking the server whether it's reachable when the OS already says
        // there's no network at all — that case is already covered above.
        // Three distinct outcomes here, not one — conflating them all into a
        // single "server unavailable" message is exactly what made testers on
        // merely slow connections think the deployed server itself was down:
        //   1. A response actually came back and it wasn't ok -> the server
        //      itself is genuinely failing.
        //   2. fetchWithTimeout rejected (our own 4s abort, or the request
        //      failed outright) while navigator.onLine still says "online" ->
        //      a flaky/slow client-side connection, not proof the server is
        //      down.
        //   3. res.ok -> nothing to report.
        function setServerNotice(kind, message) {
            const notice = document.getElementById('serverUnavailableNotice');
            const icon = document.getElementById('serverUnavailableNoticeIcon');
            const text = document.getElementById('serverUnavailableNoticeText');
            if (!notice) return;
            if (!kind) {
                notice.classList.add('d-none');
                return;
            }
            notice.classList.remove('d-none');
            notice.classList.toggle('is-error', kind === 'error');
            if (icon) icon.className = kind === 'error' ? 'fas fa-circle-exclamation' : 'fas fa-wifi';
            if (text) text.textContent = message;
        }

        async function checkServerHealth() {
            if (!navigator.onLine) {
                setServerNotice(null);
                return;
            }
            try {
                const res = await fetchWithTimeout('/api/health', {}, 4000);
                if (res.ok) {
                    setServerNotice(null);
                } else {
                    setServerNotice('error', 'The service is temporarily unavailable. Please try again shortly.');
                }
            } catch (err) {
                setServerNotice('warning', 'Your internet connection is slow or unstable. Some features may take longer to load.');
            }
        }
        window.addEventListener('online', checkServerHealth);
        checkServerHealth();

        // ==========================================
        // PENDING-LOGOUT / NEW-LOGIN RACE GUARD
        //
        // The race this closes: an old session goes offline, gets flagged
        // pending (cspc_client_pending_logout, set in client-survey.ejs),
        // and the /logout confirmation fails on a flaky reconnect — the
        // marker correctly stays set. If the user could start a brand new
        // login on THIS page in that window, and the stale pending
        // /logout call finally reached the server AFTER the new session
        // was created, it would destroy the NEW session instead of the old
        // one — /logout?scope=client just destroys whatever session the
        // request's client.sid cookie currently points to, and by then
        // that cookie is the new login's, not the old one. There is no way
        // to tell "old" and "new" apart from the cookie alone.
        //
        // The fix is to never let a new login start while the marker is
        // unresolved: Google sign-in and the password form are both
        // blocked until attemptPendingClientLogout() (offline-db.js)
        // positively confirms the old session is gone, at which point the
        // marker is cleared and it's safe to authenticate. This also means
        // a stale marker can no longer coexist with a freshly-created
        // session by the time /client-survey is reached — so its own
        // existing showBackOnlineTransition()/attemptPendingClientLogout()
        // handling (unchanged) never sees that combination either.
        // ==========================================
        (function () {
            const notice = document.getElementById('pendingLogoutNotice');
            const icon = document.getElementById('pendingLogoutNoticeIcon');
            const text = document.getElementById('pendingLogoutNoticeText');
            const retryBtn = document.getElementById('pendingLogoutRetryBtn');
            const googleBtn = document.getElementById('googleSignInBtn');
            const loginForm = document.getElementById('loginForm');
            let blocked = false;

            function setNotice(kind, message, showRetry) {
                if (!notice) return;
                notice.classList.toggle('d-none', !message);
                notice.classList.toggle('is-error', kind === 'error');
                if (icon) icon.className = kind === 'error' ? 'fas fa-triangle-exclamation' : 'fas fa-hourglass-half';
                if (text) text.textContent = message || '';
                if (retryBtn) retryBtn.classList.toggle('d-none', !showRetry);
            }

            function setBlocked(isBlocked) {
                blocked = isBlocked;
                if (googleBtn) googleBtn.classList.toggle('disabled', isBlocked);
            }

            function warnBlocked(e) {
                if (!blocked) return;
                e.preventDefault();
                if (window.AppAlert) AppAlert.warning('Please wait until your previous session finishes closing before signing in.', 'One Moment');
            }

            function attempt() {
                if (typeof hasPendingClientLogout !== 'function' || !hasPendingClientLogout()) {
                    setBlocked(false);
                    setNotice(null, '', false);
                    return;
                }
                if (!navigator.onLine) {
                    setBlocked(true);
                    setNotice('warning', "You're offline. Reconnect to finish closing your previous session before signing in.", false);
                    return;
                }
                setBlocked(true);
                setNotice('warning', 'Finishing your previous session…', false);
                attemptPendingClientLogout().then(function (success) {
                    if (success) {
                        setBlocked(false);
                        setNotice(null, '', false);
                    } else {
                        // Does NOT claim the old session is gone — it isn't,
                        // yet. Stays blocked; no automatic retry loop, just
                        // the Retry button plus the next 'online' event.
                        setNotice('error', "We couldn't close your previous session because the connection is unstable. Please retry once your connection improves.", true);
                    }
                });
            }

            if (retryBtn) retryBtn.addEventListener('click', attempt);
            if (googleBtn) googleBtn.addEventListener('click', warnBlocked);
            if (loginForm) loginForm.addEventListener('submit', warnBlocked);
            window.addEventListener('online', attempt);

            attempt();
        })();

        // REMOVED: this used to bounce straight to /client-survey while
        // offline whenever a cached cspc_client_session existed — meant as
        // a convenience ("resume the survey app instead of re-deciding
        // between Login and Take Survey Offline"). That convenience is what
        // made the offline overlay's own Login/Dashboard buttons "blink and
        // do nothing": clicking either one navigates here (or to /), and
        // this redirect immediately bounced right back to /client-survey's
        // cached shell, whose own load-time check re-shows the exact same
        // "You're Offline" overlay — a loop, not a shortcut. And since
        // landing on /client-survey while offline shows that same overlay
        // immediately anyway (see client-survey.ejs), this redirect never
        // actually saved a step even in the cases it didn't loop — it only
        // ever added one. A cached client-side session flag was never proof
        // the live authenticated portal is usable while offline; removing
        // this is what lets this page (and /) stay reachable on their own
        // terms, as the offline overlay's Login/Dashboard buttons require.

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js')
                    .catch((err) => console.error('[PWA] Service worker registration failed:', err));
            });
        }
    </script>
</body>
</html>