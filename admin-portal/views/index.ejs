            if (spacer) spacer.style.height = header.offsetHeight + 'px';
            // The floating offline chip sits just under that same header, and
            // this header's height changes with the viewport (the nav wraps),
            // so it is measured here rather than guessed at in CSS.
            document.documentElement.style.setProperty('--offline-pill-top', (header.offsetHeight + 10) + 'px');
