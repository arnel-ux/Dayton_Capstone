<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('layout/header') %>
    <style>
        .act-badge { font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; text-transform: capitalize; white-space: nowrap; }
        .act-add     { background: rgba(25, 135, 84, 0.12);  color: #198754; }
        .act-edit    { background: rgba(13, 110, 253, 0.12); color: #0d6efd; }
        .act-archive { background: rgba(255, 193, 7, 0.18);  color: #b58105; }
        .act-restore { background: rgba(13, 202, 240, 0.15); color: #0a8ca5; }
        .act-delete  { background: rgba(220, 53, 69, 0.12);  color: #dc3545; }
        html[data-bs-theme="dark"] .act-archive { color: #ffd561; }
        html[data-bs-theme="dark"] .act-restore { color: #6edff6; }
        html[data-bs-theme="dark"] .act-edit    { color: #8bb9fe; }
        html[data-bs-theme="dark"] .act-add     { color: #75b798; }
        html[data-bs-theme="dark"] .act-delete  { color: #ea868f; }
        .act-details { max-width: 340px; }
    </style>
</head>
<body data-connection-alerts>
<div id="wrapper">
    <%- include('layout/sidebar') %>

    <div id="content">
        <%- include('layout/navbar') %>
        <script>document.getElementById('pageTitle').innerText = 'Activity Logs';</script>

        <%
            const actions = ['add', 'edit', 'archive', 'restore', 'delete'];
            const entities = ['Cluster', 'Office', 'Service', 'Survey Setting', 'Period Covered', 'Survey Response', 'Admin Account'];
            const pageUrl = (p) => {
                const qs = new URLSearchParams();
                if (filters.action) qs.set('action', filters.action);
                if (filters.entity) qs.set('entity', filters.entity);
                if (filters.q) qs.set('q', filters.q);
                qs.set('page', p);
                return '/activity-logs?' + qs.toString();
            };
        %>

        <div class="container-fluid p-0">
            <div class="card card-custom">
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                        <h6 class="fw-bold mb-0">Admin Activity <span class="text-muted fw-normal">(<%= total %>)</span></h6>
                    </div>
                    <form method="GET" action="/activity-logs" class="row g-2">
                        <div class="col-12 col-md-3">
                            <select name="action" class="form-select form-select-sm">
                                <option value="">All actions</option>
                                <% actions.forEach(a => { %>
                                    <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>><%= a.charAt(0).toUpperCase() + a.slice(1) %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <select name="entity" class="form-select form-select-sm">
                                <option value="">All records</option>
                                <% entities.forEach(e => { %>
                                    <option value="<%= e %>" <%= filters.entity === e ? 'selected' : '' %>><%= e %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-12 col-md-4">
                            <input type="text" name="q" value="<%= filters.q %>" class="form-control form-control-sm" placeholder="Search admin, record or details">
                        </div>
                        <div class="col-12 col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary btn-sm flex-fill"><i class="fas fa-filter me-1"></i> Filter</button>
                            <a href="/activity-logs" class="btn btn-outline-secondary btn-sm" title="Clear filters"><i class="fas fa-xmark"></i></a>
                        </div>
                    </form>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-custom table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">Date &amp; Time</th>
                                    <th class="py-3">Admin</th>
                                    <th class="py-3">Action</th>
                                    <th class="py-3">Record</th>
                                    <th class="py-3">Name</th>
                                    <th class="px-4 py-3">Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (activities.length > 0) { %>
                                    <% activities.forEach(a => { %>
                                        <tr>
                                            <td class="px-4 py-2 text-nowrap">
                                                <div><%= a.date_fmt %></div>
                                                <small class="text-muted"><%= a.time_fmt %></small>
                                            </td>
                                            <td class="fw-semibold"><%= a.admin_name %></td>
                                            <td><span class="act-badge act-<%= a.action %>"><%= a.action %></span></td>
                                            <td><%= a.entity_type %></td>
                                            <td><%= a.entity_name || '—' %></td>
                                            <td class="px-4 text-muted act-details"><small><%= a.details || '' %></small></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">No activity recorded yet.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <% if (totalPages > 1) { %>
                    <div class="card-footer bg-white border-0 p-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Page <%= page %> of <%= totalPages %></small>
                        <div class="btn-group">
                            <a class="btn btn-sm btn-outline-secondary <%= page <= 1 ? 'disabled' : '' %>" href="<%= pageUrl(page - 1) %>"><i class="fas fa-chevron-left"></i> Prev</a>
                            <a class="btn btn-sm btn-outline-secondary <%= page >= totalPages ? 'disabled' : '' %>" href="<%= pageUrl(page + 1) %>">Next <i class="fas fa-chevron-right"></i></a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<%- include('layout/footer') %>
</body>
</html>
