# Copy this to admin-portal/.env and fill in real values before starting the
# service. See deploy/setup.sh — it copies this automatically on first run,
# but does NOT fill in the secrets below; that step is manual.

# --- Server ---
PORT=3000
SESSION_SECRET=

# --- MySQL (Clever Cloud or any external instance) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cqa_db
DB_SSL=false
DB_CONNECTION_LIMIT=4

# --- Google OAuth (client login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Mail (nodemailer) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- reCAPTCHA ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- AI comment analysis (Gemini) ---
# Required — the AI model server (ai_scripts/model_server.py) fails to start
# without this, and server.js falls back to per-comment analysis until it's
# set. Get a free key (no billing needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_MODEL_SERVER_PORT=8765
