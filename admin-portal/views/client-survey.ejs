<% if (offlineMode) { %>
<!-- BACK-ONLINE PROMPT — /survey-offline only, the mirror image of the
     offline transition below: that one covers the screen when connectivity
     is LOST, this one when it RETURNS.

     Was an inline green banner at the top of .content-body. The problem with
     that: it only exists on a page the user is actively filling in, and by
     the time the connection comes back they are usually scrolled well down
     it (SQD, stage 4 of 5) — so the one notice telling them their internet
     is back, and offering the choice of where to go, sat off-screen above
     them and was routinely never seen. As an overlay it is unmissable at the
     moment it matters, which is the whole point of it.

     Reuses .offline-transition-overlay/.offline-transition-card and its
     existing .is-back-online green variant rather than a second popup
     design, so both connectivity transitions look like the same system.

     Still never auto-navigates or reloads — see confirmLeaveOfflineSurvey() —
     so an in-progress survey, the RAM-only password, and any already-queued
     IndexedDB records all survive regardless of what the user picks. Unlike
     the offline overlay this one IS dismissable ("Stay Here", Escape, or a
     tap on the backdrop): being back online takes nothing away, so trapping
     the user here would be wrong. -->
<div id="backOnlineBanner" class="offline-transition-overlay is-back-online" hidden role="dialog" aria-modal="true" aria-labelledby="backOnlineTitle">
    <div class="offline-transition-card">
        <div class="offline-transition-icon"><i class="bi bi-wifi"></i></div>
        <h4 id="backOnlineTitle">You're Back Online</h4>
        <p>Your internet connection has been restored. Offline responses will synchronize automatically when eligible.</p>
        <div class="offline-transition-actions">
            <!-- This button leads and is the only visually-primary action: it
                 is the one choice that costs the user nothing. The others
                 navigate away from a survey that may be half-answered, and
                 the RAM-only password does not survive that navigation — so
                 the safe option is the one that should be easiest to hit, and
                 the one focus lands on when this opens. Reconnecting is not a
                 reason to leave the page; it just means the queued responses
                 can sync.

                 Labelled "Continue Survey" everywhere, never "Stay Here":
                 this is the same action the authenticated page's offline
                 overlay already calls Continue Survey, and one wording for
                 one action is what keeps the two connectivity dialogs
                 readable as the same system. "Stay Here" also understates it
                 mid-attempt — what the user gets back is their part-filled
                 form, not merely the current page. -->
            <button type="button" class="btn btn-primary fw-semibold" onclick="dismissBackOnlineBanner()">Continue Survey</button>
            <button type="button" class="btn btn-outline-primary fw-semibold" onclick="confirmLeaveOfflineSurvey('/')">Go to Dashboard</button>
            <!-- Hidden while the survey view is open. /survey-offline needs no
                 sign-in to work — the account is verified at sync time from
                 the email/password typed into the form itself — so offering
                 Login mid-attempt only advertises a route that abandons the
                 answers already entered for no gain. It stays available from
                 the Home view, where nothing is at stake and "just log in
                 properly now that I'm online" is a reasonable choice. -->
            <button type="button" id="backOnlineLoginBtn" class="btn btn-outline-secondary fw-semibold" onclick="confirmLeaveOfflineSurvey('/login')">Login</button>
        </div>
    </div>
</div>
<% } %>

<% if (!offlineMode) { %>
<!-- ONLINE-SESSION OFFLINE TRANSITION — authenticated /client-survey only.
     /survey-offline (offlineMode) already has its own "you were always
     offline" UI (the back-online overlay above) and never had a real online
     session to lose in the first place, so this doesn't apply there.

     Why this exists: this page's session cookie (client.sid) is httpOnly —
     no client-side script can ever read, write, or clear it — and the
     account's actual login state lives entirely in server-side session
     storage. So while genuinely offline, there is no way to really destroy
     the login: the honest options are (a) leave the authenticated UI up and
     let every action fail against an unreachable server, or (b) stop
     presenting it as usable and make that explicit. This overlay is (b) —
     a full-screen, opaque cover (not a teardown of the underlying DOM) that
     blocks interaction with and visually hides account-specific content
     (name/email/history/notifications) the instant navigator.onLine goes
     false, and offers only routes that work without a session: the public
     dashboard, /login, and the offline survey — never a way back into the
     authenticated view without actually reaching the server again. See the
     script block near the end of body for how it's driven. -->
<div id="onlineOfflineTransition" class="offline-transition-overlay" hidden role="alertdialog" aria-modal="true" aria-labelledby="offlineTransitionTitle">
    <div class="offline-transition-card">
        <div class="offline-transition-icon"><i id="offlineTransitionIcon" class="bi bi-wifi-off"></i></div>
        <h4 id="offlineTransitionTitle">You're Offline</h4>
        <p id="offlineTransitionDesc">Your internet connection has been lost. Online account features are temporarily unavailable.</p>
        <!-- Shown only when hasUnsavedSurveyProgress() is true at the moment
             the overlay opens — see showOfflineTransition(). -->
        <p id="offlineTransitionProgressNote" class="offline-transition-progress-note" hidden>Your current survey progress has been saved on this device. You can continue answering it offline.</p>
        <div class="offline-transition-actions">
            <!-- Primary action when a real in-progress attempt exists —
                 dismisses the overlay in place. The survey form's own DOM/JS
                 state was never touched by the overlay appearing, so there is
                 nothing to "restore" here; the autosave below only matters
                 for a refresh/reopen while this stays hidden. -->
            <button type="button" id="continueSurveyBtn" class="btn btn-primary fw-semibold" onclick="dismissOfflineTransitionForContinue()" hidden>Continue Survey</button>
            <!-- leaveFromOfflineOverlay (defined below), NOT the general
                 confirmLeaveOfflineSurvey: these three go straight to their
                 destination with no extra prompt. showOfflineTransition()
                 has already run autosaveActiveSurveyDraftNow() before this
                 overlay was ever shown, which is exactly what the green note
                 above promises — so asking "this may discard the unfinished
                 form" here contradicted that note and was simply untrue.
                 None of these three destinations require a live session:
                 '/' and '/survey-offline' are both precached by the service
                 worker for exactly this situation, and '/login' works
                 offline too (it just can't complete a sign-in without
                 connectivity). -->
            <a href="/" class="btn btn-outline-primary fw-semibold" onclick="return leaveFromOfflineOverlay('/', event);">Back to Dashboard</a>
            <a href="/survey-offline" id="offlineTransitionGoOfflineSurveyBtn" class="btn btn-primary fw-semibold" onclick="return leaveFromOfflineOverlay('/survey-offline', event);">Go to Offline Survey</a>
            <a href="/login" class="btn btn-outline-secondary fw-semibold" onclick="return leaveFromOfflineOverlay('/login', event);">Login</a>
        </div>
    </div>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
<% if (!offlineMode) { %>
// BFCache guard: if the browser restores this page from its back/forward cache
// (e.g. the user logged out, then hit Back) instead of requesting it fresh from
// the server, force a hard reload so /client-survey's server-side session check
// and no-cache headers actually run again rather than being bypassed entirely.
//
// Gated to the authenticated (!offlineMode) render only — /survey-offline has
// no server-side session check for this to re-run, and forcing a reload there
// would destroy the RAM-only credential store and any in-progress offline
// answers for no benefit (see rememberOfflineCredential in pwa-client.js).
// '__loginBoundary' (set by client-login.ejs the moment it's actually
// rendered) marks that THIS TAB has, at some point, navigated back to the
// login page. Once set, a Back/Forward-triggered pageshow here sends the
// user straight back to that login page instead of merely reloading — a
// plain reload would legitimately re-show the real survey page if the
// still-alive server session allows it (visiting /login/client-login
// deliberately never destroys the session — it's shared by every tab in the
// browser, see server.js), which is technically correct but lets Forward
// "resurrect" the authenticated view after the user already stepped back
// through the login page in this tab. Cleared the moment this page actually
// loads for real (persisted:false) — that only happens after the server-side
// session check already approved a fresh request.
window.addEventListener('pageshow', function (event) {
    var navEntries = (window.performance && performance.getEntriesByType) ? performance.getEntriesByType('navigation') : [];
    var isBackForwardNav = navEntries.length > 0 && navEntries[0].type === 'back_forward';
    var loginBoundary = null;
    try { loginBoundary = sessionStorage.getItem('__loginBoundary'); } catch (e) {}

    if (event.persisted || isBackForwardNav) {
        if (loginBoundary) {
            window.location.replace(loginBoundary);
        } else {
            window.location.reload();
        }
    } else if (loginBoundary) {
        try { sessionStorage.removeItem('__loginBoundary'); } catch (e) {}
    }
});

// Belt-and-suspenders for the guard above: under rapid repeated Back/Forward
// clicks, a reload() triggered by pageshow can itself get cancelled by the
// NEXT click before it finishes, so the browser can end up silently settling
// on a frozen bfcache snapshot that never re-ran the reload (and therefore
// never re-hit the server's session check). A no-op 'unload' listener is the
// standard cross-browser signal that opts THIS page out of bfcache entirely,
// so every Back/Forward to it is forced to be a real network request from
// the start — no reload-after-the-fact race to lose no matter how fast the
// buttons are clicked.
window.addEventListener('unload', function () {});
<% } %>

document.getElementById('surveyDate').valueAsDate = new Date();

// Caps the office-visit picker at "now" (no future visits) and defaults it
// to now when empty; the visit's own date can still be moved back to an
// earlier day than today, independent of the survey submission date.
function initDefaultOfficeVisitedTime() {
    const dtInput = document.getElementById('officeVisitedTime');
    if (!dtInput) return;
    const now = new Date();
    const localNow = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    dtInput.max = localNow;
    if (!dtInput.value) dtInput.value = localNow;
}
initDefaultOfficeVisitedTime();
let currentLang = 'en';

// The "Home" view is active by default on load (no switchView() call fires
// for it) — the sidebar stays expanded, matching switchView()'s own
// behavior for every view other than "survey".

// =====================================
// DEPENDENT "SERVICE AVAILED" DROPDOWN
// =====================================
// Built server-side in the /client-survey route (server.js) from the
// `services` table, keyed by office_id — e.g. { "3": ["Service A", ...] }.
const officeServices = <%- JSON.stringify(typeof officeServices !== 'undefined' ? officeServices : {}) %>;
// "officeId::serviceName" -> message, for services this account can't (yet)
// re-survey — built server-side from each service's resubmission cadence
// (see isEligibleForResubmission in server.js). Not blocked = not in this map.
const blockedCombos = <%- JSON.stringify(typeof blockedCombos !== 'undefined' ? blockedCombos : {}) %>;
// "officeId::serviceName" -> epoch ms this account becomes eligible again,
// for cadence-based services only (see nextEligibleTimestamp in server.js).
// A combo can be in blockedCombos without a matching entry here — still
// pending office review, or a one-time-only service — in which case the
// countdown UI falls back to the static blockedCombos message instead of
// ticking down. Drives the live countdown next to the Office/Service
// fields (see updateAvailabilityNotice below).
const blockedUntil = <%- JSON.stringify(typeof blockedUntil !== 'undefined' ? blockedUntil : {}) %>;
// "officeId::serviceName" -> the admin-configured cadence string (daily/
// weekly/monthly/yearly) or null/absent for a one-time-only service — from
// the `services` table (see /client-survey in server.js). Lets a just-
// submitted service show its REAL countdown immediately (see
// markServiceAsTaken below) instead of a placeholder message, without
// waiting for a page reload to re-derive blockedUntil from the server.
const serviceAvailability = <%- JSON.stringify(typeof serviceAvailability !== 'undefined' ? serviceAvailability : {}) %>;

function populateServiceSelect(officeId) {
    const serviceSelect = document.getElementById('serviceSelect');
    if (!serviceSelect) return;

    serviceSelect.innerHTML = '';

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select Service...';
    placeholder.disabled = true;
    placeholder.selected = true;
    serviceSelect.appendChild(placeholder);

    const services = officeServices[officeId] || [];
    services.forEach(service => {
        const opt = document.createElement('option');
        opt.value = service;
        const blockedMessage = blockedCombos[officeId + '::' + service];
        if (blockedMessage) {
            opt.disabled = true;
            opt.title = blockedMessage;
            opt.textContent = '✓ ' + service;
        } else {
            opt.textContent = service;
        }
        serviceSelect.appendChild(opt);
    });

    serviceSelect.disabled = services.length === 0;
}

// =====================================
// LIVE "AVAILABLE AGAIN IN..." COUNTDOWN
// =====================================
// Ticks down to blockedUntil[officeId::service] once a second so the client
// sees exactly when they can retake a survey for this office/service without
// reloading the page. Falls back to the static blockedCombos message (still
// pending office review, or a permanently one-time-only service) when
// there's no timestamp to count down to — those never reach zero on their
// own. Per-account and per-office/service by construction: blockedUntil and
// blockedCombos were both built server-side from THIS signed-in client's own
// submission history (see /client-survey in server.js), so a different
// account — or the same account after answering a different service —
// always gets its own independent countdown.
let availabilityCountdownTimer = null;

function formatCountdown(msRemaining) {
    const totalSeconds = Math.max(0, Math.floor(msRemaining / 1000));
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    if (days > 0) return `${days}d ${hours}h ${minutes}m`;
    if (hours > 0) return `${hours}h ${minutes}m ${seconds}s`;
    if (minutes > 0) return `${minutes}m ${seconds}s`;
    return `${seconds}s`;
}

// Collapses the longer, precise blockedCombos strings (used elsewhere as a
// tooltip/title, where the extra detail is worth keeping) down to a short
// phrase for the notice line itself — the countdown next to it is the part
// that actually matters, this is just a label for it.
function shortAvailabilityText(message) {
    if (/Awaiting the office/.test(message)) return 'Pending office review';
    if (/already evaluated/i.test(message)) return 'Already evaluated';
    return message;
}

// "1/3 answered" pill beside the Service Availed label — office-wide (not
// tied to whichever service happens to be selected), so it stays visible
// the moment an office with more than one service is picked.
function updateServiceProgressBadge(officeId) {
    const badge = document.getElementById('serviceProgressBadge');
    if (!badge) return;

    const services = officeServices[officeId] || [];
    if (services.length <= 1) {
        badge.classList.add('d-none');
        return;
    }

    const answered = services.filter(s => blockedCombos[officeId + '::' + s]).length;
    if (answered === 0) {
        badge.classList.add('d-none');
        return;
    }

    badge.textContent = `${answered}/${services.length} answered`;
    badge.classList.remove('d-none');
}

function updateAvailabilityNotice() {
    if (availabilityCountdownTimer) {
        clearInterval(availabilityCountdownTimer);
        availabilityCountdownTimer = null;
    }

    const notice = document.getElementById('availabilityNotice');
    const noticeText = document.getElementById('availabilityNoticeText');
    const officeSelect = document.getElementById('officeSelect');
    const serviceSelect = document.getElementById('serviceSelect');
    if (!notice || !noticeText || !officeSelect || !serviceSelect) return;

    const officeId = officeSelect.value;
    updateServiceProgressBadge(officeId);

    const services = officeServices[officeId] || [];

    // A single-service office has nothing else to pick, so its availability
    // is surfaced as soon as the office itself is chosen. An office with
    // multiple services only surfaces it once the client has actually
    // picked the (blocked) service they want to see.
    const service = services.length === 1 ? services[0] : serviceSelect.value;
    if (!officeId || !service) {
        notice.classList.add('d-none');
        return;
    }

    const key = officeId + '::' + service;
    const untilTs = blockedUntil[key];
    const message = blockedCombos[key];

    if (untilTs) {
        const tick = () => {
            const remaining = untilTs - Date.now();
            if (remaining <= 0) {
                clearInterval(availabilityCountdownTimer);
                availabilityCountdownTimer = null;
                // Countdown just hit zero — unblock live instead of making
                // the client reload to see it.
                delete blockedUntil[key];
                delete blockedCombos[key];
                populateServiceSelect(officeId);
                updateAvailabilityNotice();
                return;
            }
            noticeText.textContent = `Available again in ${formatCountdown(remaining)}`;
        };
        tick();
        availabilityCountdownTimer = setInterval(tick, 1000);
        notice.classList.remove('d-none');
    } else if (message) {
        noticeText.textContent = shortAvailabilityText(message);
        notice.classList.remove('d-none');
    } else {
        notice.classList.add('d-none');
    }
}

document.getElementById('officeSelect').addEventListener('change', function () {
    populateServiceSelect(this.value);
    updateAvailabilityNotice();
});

document.getElementById('serviceSelect').addEventListener('change', updateAvailabilityNotice);

// Handle the case where the browser restores a previously-selected office_id
// (e.g. back/forward navigation, or a locked/pre-filled value) without a
// fresh "change" event firing.
(function initServiceSelectState() {
    const officeSelect = document.getElementById('officeSelect');
    if (officeSelect && officeSelect.value) {
        populateServiceSelect(officeSelect.value);
        updateAvailabilityNotice();
    }
})();

// Demographics saved from this account's FIRST-EVER survey submission (Region, Age, Sex).
// Once set, these are pre-filled and locked so the client can never change them again.
// JSON.stringify doesn't escape "/", so a stored field containing the
// literal sequence "<" + "/script>" would otherwise close this tag early
// (browsers scan raw bytes for that sequence inside <script>, even inside a
// comment or string) and let injected markup after it execute — .replace
// guards that even though server-side (see
// server.js's VALID_AGE_BRACKETS/VALID_GENDERS/VALID_REGIONS allowlists)
// should already keep these fields to known-safe values.
const savedClientProfile = <%- JSON.stringify(typeof clientProfile !== 'undefined' && clientProfile ? clientProfile : null).replace(/\//g, '\\u002f') %>;

// Reaching this page means the server already confirmed an active session
// (ensureClientAuth). Cache that identity so client-login.ejs can recognize a
// still-valid session and skip straight back here while offline — the actual
// page markup itself is served from the service worker's cache in that case.
const CLIENT_SESSION_KEY = 'cspc_client_session';
const currentClientEmail = <%- JSON.stringify(typeof clientEmail !== 'undefined' ? clientEmail : null) %>;

// True only on /survey-offline — no authenticated session exists on this
// page at all, so submitAll() below must never attempt a direct
// /submit-survey POST (it would just 401): every submission here queues
// for POST /api/offline-surveys/verify-and-sync instead, which performs
// real server-side password verification once back online. See
// runOfflineVerificationFlow in pwa-client.js.
const OFFLINE_MODE = <%- JSON.stringify(!!offlineMode) %>;

if (currentClientEmail) {
    try {
        localStorage.setItem(CLIENT_SESSION_KEY, JSON.stringify({ email: currentClientEmail, cachedAt: Date.now() }));
    } catch (e) { /* localStorage unavailable — offline session bypass just won't apply */ }
}

// ==========================================
// ONLINE-SESSION OFFLINE TRANSITION — authenticated /client-survey only
// (every function below no-ops under OFFLINE_MODE; declared at top level,
// not inside an `if`, so logout() further down can always call them safely
// regardless of hoisting semantics). See the HTML comment on
// #onlineOfflineTransition for the full "why".
//
// Driven purely by navigator.onLine / the 'online'+'offline' events — never
// by any individual fetch()'s success/failure. That's deliberate: a single
// slow request or a genuine 5xx from the server must NOT be treated as "the
// device is offline" (see the login.ejs/index.ejs checkServerHealth pattern
// elsewhere in this codebase for that same distinction) — only the
// browser's own connectivity signal drives this transition.
//
// The pending-server-logout marker itself (set/read/cleared, and the actual
// /logout attempt) lives in offline-db.js as setPendingClientLogout() /
// hasPendingClientLogout() / attemptPendingClientLogout() — shared with
// login.ejs, index.ejs, and client-login.ejs, since the user can leave this
// page (choosing Login or Dashboard while still offline) before
// connectivity actually returns, and whichever page they land on when it
// does needs to finish the job. See those pages' own scripts for the other
// callers, and the comment on attemptPendingClientLogout() for exactly what
// counts as a confirmed success vs. a failure worth retrying later.
// ==========================================

// ==========================================
// ACTIVE ONLINE SURVEY DRAFT — autosave/restore bridge between the normal
// online survey form and the existing offline outbox infrastructure.
// Authenticated (!OFFLINE_MODE) only: /survey-offline is a different,
// already-unauthenticated flow with its own separate save-on-submit
// behavior (queueUnverifiedOfflineSurvey), untouched by any of this.
//
// One survey attempt = one ID, generated once (the first time there's
// something worth saving) and reused for every autosave, the eventual
// outbox record if Submit happens offline, and a restore after a refresh —
// never regenerated by a stage change, a reconnect, or a reload that finds
// an existing draft.
// ==========================================
let activeSurveyDraftId = null;
let activeSurveyDraftRestored = false;
// Set when showBackOnlineTransition() silently ran the sync-then-logout
// sequence without interrupting an in-progress Continue Survey attempt —
// checked by showThankYou() and switchView() to surface the "please sign
// in again" screen once that's no longer disruptive.
let backOnlinePromptSuppressed = false;

function currentSurveyStageNumber() {
    const activePage = document.querySelector('#surveyForm .page.active');
    return activePage ? parseInt(activePage.id.replace('stage', ''), 10) : 1;
}

// Same allowlist-then-collect approach submitAll() already uses for a real
// submission (FormData -> buildSafeOfflineSurveyPayload, both already
// shared with the outbox) — no second field schema.
function collectDraftableSurveyValues() {
    const form = document.getElementById('surveyForm');
    if (!form) return {};
    return buildSafeOfflineSurveyPayload(Object.fromEntries(new FormData(form).entries()));
}

// Immediate (non-debounced) save — used right before the offline overlay
// appears (item 5: answers must be safe before the popup even shows) and
// when restoring/discarding. Ordinary typing/selecting uses the debounced
// wrapper further below instead, so autosave doesn't run on every keystroke.
function autosaveActiveSurveyDraftNow() {
    if (OFFLINE_MODE || !currentClientEmail) return;
    if (!hasUnsavedSurveyProgress()) return; // opening the form and touching nothing is not "progress"
    if (!activeSurveyDraftId) {
        activeSurveyDraftId = (typeof crypto !== 'undefined' && crypto.randomUUID) ? crypto.randomUUID() : generateOfflineSubmissionId();
    }
    saveActiveSurveyDraft(currentClientEmail, {
        draftId: activeSurveyDraftId,
        stage: currentSurveyStageNumber(),
        values: collectDraftableSurveyValues(),
        termsAccepted: true, // hasUnsavedSurveyProgress() already implies stage > 1, i.e. Terms was passed
        language: typeof currentLang !== 'undefined' ? currentLang : 'en',
        createdOrUpdatedAt: new Date().toISOString()
    }).catch(err => console.error('[Survey Draft] Autosave failed:', err));
}

let autosaveDraftTimer = null;
function autosaveActiveSurveyDraftDebounced() {
    if (OFFLINE_MODE) return;
    clearTimeout(autosaveDraftTimer);
    autosaveDraftTimer = setTimeout(autosaveActiveSurveyDraftNow, 800);
}

// Wired to the whole form rather than individual fields — one place covers
// every text input, select, radio, and the comments textarea, matching the
// "input/change/radio/select/comment edits" list this needs to autosave on.
if (!OFFLINE_MODE) {
    const surveyFormEl = document.getElementById('surveyForm');
    if (surveyFormEl) {
        surveyFormEl.addEventListener('input', autosaveActiveSurveyDraftDebounced);
        surveyFormEl.addEventListener('change', autosaveActiveSurveyDraftDebounced);
    }
}

// Only ever called once the draft has become a real queued/synced
// submission, or the user explicitly starts over — never merely because
// connectivity changed or a sync attempt began.
function discardActiveSurveyDraft() {
    activeSurveyDraftId = null;
    if (!OFFLINE_MODE && currentClientEmail) {
        clearActiveSurveyDraft(currentClientEmail).catch(err => console.error('[Survey Draft] Failed to clear draft:', err));
    }
}

// Restoring an in-progress draft found on page load. navigate(stage) only
// validates the stage it's LEAVING (see navigate()'s own logic), so jumping
// straight to e.g. stage 4 requires Stage 1's terms checkbox to already be
// checked — true here since the draft only ever exists at all once
// hasUnsavedSurveyProgress() was true (stage > 1) when it was saved.
function restoreActiveSurveyDraftIntoForm(draft) {
    const values = draft.values || {};
    Object.keys(values).forEach(name => {
        const field = document.querySelector(`#surveyForm [name="${CSS.escape(name)}"]`);
        if (!field) return;
        if (field.type === 'radio' || field.type === 'checkbox') {
            const target = document.querySelector(`#surveyForm [name="${CSS.escape(name)}"][value="${CSS.escape(String(values[name]))}"]`);
            if (target) target.checked = true;
        } else {
            field.value = values[name];
        }
    });

    if (draft.termsAccepted) {
        const termsBox = document.getElementById('agreeTermsStage1');
        if (termsBox) termsBox.checked = true;
        const startBtn = document.getElementById('btnStartSurvey');
        if (startBtn) startBtn.disabled = false;
    }

    activeSurveyDraftId = draft.draftId || null;
    activeSurveyDraftRestored = true;
    const targetStage = draft.stage && draft.stage > 1 ? draft.stage : 1;
    if (targetStage > 1) navigate(targetStage);

    // Office -> Service is a dependent dropdown (populateServiceSelect only
    // runs on the office <select>'s own change event) — restoring
    // office_id's value directly doesn't repopulate or re-select the
    // service list, so that has to happen explicitly here.
    if (values.office_id) {
        populateServiceSelect(values.office_id);
        if (values.service_availed) {
            const serviceSelect = document.getElementById('serviceSelect');
            if (serviceSelect) serviceSelect.value = values.service_availed;
        }
        updateAvailabilityNotice();
    }

    if (window.AppAlert) AppAlert.toastInfo('Your saved survey has been restored.');
}

if (!OFFLINE_MODE && currentClientEmail) {
    getActiveSurveyDraft(currentClientEmail).then(draft => {
        if (draft && draft.values && Object.keys(draft.values).length) {
            restoreActiveSurveyDraftIntoForm(draft);
        }
    }).catch(err => console.error('[Survey Draft] Restore failed:', err));
}

// Shows the "You're offline" state and marks the pending-logout marker, so
// a later reload (still offline, or online again with the marker still
// set) — on THIS page or any other one that checks it — knows to
// re-evaluate instead of silently treating the account as still logged in.
//
// Item 5's ordering is deliberate: the draft is captured and persisted
// BEFORE the overlay is ever shown, so the user's answers are already safe
// on disk the instant this runs — they never have to click anything for
// that to be true.
function showOfflineTransition() {
    if (OFFLINE_MODE) return;
    autosaveActiveSurveyDraftNow();

    const overlay = document.getElementById('onlineOfflineTransition');
    if (!overlay) return;
    setPendingClientLogout();
    overlay.classList.remove('is-back-online');
    const icon = document.getElementById('offlineTransitionIcon');
    const title = document.getElementById('offlineTransitionTitle');
    const desc = document.getElementById('offlineTransitionDesc');
    const progressNote = document.getElementById('offlineTransitionProgressNote');
    const continueBtn = document.getElementById('continueSurveyBtn');
    const goOfflineSurveyBtn = document.getElementById('offlineTransitionGoOfflineSurveyBtn');
    if (icon) icon.className = 'bi bi-wifi-off';
    if (title) title.textContent = "You're Offline";
    if (desc) desc.textContent = 'Your internet connection has been lost. Online account features are temporarily unavailable.';

    // "Continue Survey" only when there's real unfinished progress (item 4)
    // — opening the survey and answering nothing does not count.
    const hasRealProgress = hasUnsavedSurveyProgress();
    if (progressNote) progressNote.hidden = !hasRealProgress;
    if (continueBtn) continueBtn.hidden = !hasRealProgress;
    // Keep exactly one visually-primary action: Continue Survey when it's
    // available, "Go to Offline Survey" otherwise (its original role).
    if (goOfflineSurveyBtn) {
        goOfflineSurveyBtn.classList.toggle('btn-primary', !hasRealProgress);
        goOfflineSurveyBtn.classList.toggle('btn-outline-primary', hasRealProgress);
    }

    overlay.hidden = false;
}

// Dismisses the overlay without navigating anywhere — the survey form's own
// DOM/JS state was never altered by the overlay appearing, so "continuing"
// is simply making the form visible/interactive again. The pending-logout
// marker set by showOfflineTransition() is untouched: choosing to keep
// answering offline doesn't resolve it, and it still gets attempted the
// next time connectivity actually returns (from this page or any other).
function dismissOfflineTransitionForContinue() {
    const overlay = document.getElementById('onlineOfflineTransition');
    if (overlay) overlay.hidden = true;
}

// Connectivity is back, but a server-side logout is still pending (this
// load, or a prior one on this or another page that never got resolved) —
// per the "log in again after reconnecting" security choice, this never
// silently drops the user back into the authenticated view, regardless of
// whether the logout attempt below actually succeeds. The wording
// deliberately does NOT claim the previous session has been terminated —
// only attemptPendingClientLogout() confirming a real server response gets
// to make that true, and even then only clears the marker, not this
// overlay's message (the overlay itself never invites the user back into
// the authenticated view either way).
async function showBackOnlineTransition() {
    if (OFFLINE_MODE) return;
    const overlay = document.getElementById('onlineOfflineTransition');
    if (!overlay) return;

    // ---- Step 1: best-effort sync attempt ----
    // Any survey queued while this session was offline (queueSurveyOffline,
    // mode:'authenticated') syncs via POST /sync-surveys, which requires
    // THIS still-valid session (ensureClientAuth) — attemptPendingClientLogout()
    // further down destroys that same session. Attempting sync first means a
    // queued survey gets its chance on the session that's actually valid for
    // it, before that session goes away.
    if (typeof window.syncOfflineSurveysFromPage === 'function') {
        try { await window.syncOfflineSurveysFromPage(); } catch (e) { /* swallowed below regardless — see the outbox check that follows */ }
    }

    // ---- Step 2: confirm the queue is ACTUALLY clear before logging out ----
    // syncOfflineSurveysFromPage() (pwa-client.js) always resolves — it
    // wraps runOfflineSurveySync() in its own try/catch purely to avoid an
    // unhandled promise rejection, and returns normally either way. A
    // resolved await above is therefore NOT proof every queued survey
    // synced: it resolves identically whether nothing was queued, everything
    // synced, or the whole /sync-surveys request failed outright (network
    // error, timeout, 5xx before any JSON body). The outbox itself is the
    // only reliable signal — runOfflineSurveySync() only removes a record
    // once the server gave it an explicit per-item verdict (synced, or a
    // permanent rejection like "already evaluated this office"); a record
    // can only still be sitting here if the whole request never completed.
    // If anything authenticated remains queued, this session is still
    // needed to eventually sync it — logout is deliberately left unresolved
    // (pending-logout marker untouched, queued survey untouched) rather than
    // risk stranding that survey behind a session that's about to be
    // destroyed. No retry timer is started: the next 'online' event or page
    // load (both already wired elsewhere) re-runs this whole function,
    // including this check, from scratch.
    if (typeof getAuthenticatedOutboxSurveys === 'function') {
        try {
            const stillQueued = await getAuthenticatedOutboxSurveys();
            if (stillQueued && stillQueued.length > 0) return;
        } catch (e) {
            return; // can't confirm the queue is actually clear — don't log out yet
        }
    }

    // ---- Step 3: safe to proceed — no authenticated survey depends on this
    // session anymore. Decide what the user sees, then log out. ----
    // If the user dismissed the overlay via Continue Survey and is actively
    // mid-attempt (item 34: reconnecting must not restart/discard/interrupt
    // that), don't pop the full "please sign in again" screen back over
    // their form. If they finish and hit Submit after the session is gone,
    // the 401 fallback in submitAll() queues it safely; the reconnect screen
    // still shows normally once they leave the form (any other view, or
    // before Continue Survey was ever clicked).
    const continuingSurvey = overlay.hidden && activeSurveyDraftId && document.querySelector('#view-survey.active');
    if (continuingSurvey) {
        // Surfaced later instead — see showThankYou() and switchView(),
        // which re-check this once the interrupted attempt is actually
        // finished or the user leaves the survey view on their own.
        backOnlinePromptSuppressed = true;
    } else {
        overlay.classList.add('is-back-online');
        const icon = document.getElementById('offlineTransitionIcon');
        const title = document.getElementById('offlineTransitionTitle');
        const desc = document.getElementById('offlineTransitionDesc');
        if (icon) icon.className = 'bi bi-wifi';
        if (title) title.textContent = "You're Back Online";
        if (desc) desc.textContent = 'For your security, please sign in again to continue using your account.';
        overlay.hidden = false;
    }

    attemptPendingClientLogout();
}

if (!OFFLINE_MODE) {
    window.addEventListener('offline', showOfflineTransition);
    window.addEventListener('online', function () {
        // A plain reconnect blip on a page that was never actually put into
        // the offline transition (e.g. a brief Wi-Fi handoff nobody
        // noticed) shouldn't summon this at all.
        if (hasPendingClientLogout()) showBackOnlineTransition();
    });

    // Page load/reload must re-evaluate current state, not just wait for the
    // next 'offline'/'online' event — e.g. refreshing this page while
    // already offline (Scenario F) must show the transition immediately
    // instead of rendering the authenticated portal first and failing
    // every request afterward. Checking hasPendingClientLogout() here (not
    // just navigator.onLine) is what catches the case where the user left
    // this page while offline and has now come back online (or straight
    // back to this same page) with the marker still unresolved.
    if (!navigator.onLine) {
        showOfflineTransition();
    } else if (hasPendingClientLogout()) {
        showBackOnlineTransition();
    }
}

// Silently refreshes this account's offline-context snapshot (registered
// profile + office/service eligibility) into IndexedDB — see
// buildClientOfflineContext in server.js and saveOfflineAccountContext in
// offline-db.js. Authenticated-only (needs a real session to call the
// endpoint); /survey-offline never calls this itself, it only ever READS
// what a prior authenticated visit already cached. Silent by design — no
// user-facing loading state, no failure toast; skipped entirely offline or
// if IndexedDB/the endpoint is unavailable, since the existing cached
// snapshot (if any) simply stays as-is.
function refreshOfflineAccountContext() {
    if (OFFLINE_MODE || !currentClientEmail || !navigator.onLine) return;
    if (typeof saveOfflineAccountContext !== 'function') return;
    fetchWithTimeout('/api/client/offline-context', {}, 8000)
        .then(res => res.json())
        .then(data => {
            if (data && data.success) return saveOfflineAccountContext(data);
        })
        .catch(err => console.error('[Offline Context] Refresh failed:', err));
}
if (!OFFLINE_MODE) {
    window.addEventListener('load', refreshOfflineAccountContext);
}

// ==========================================
// NOTIFICATION BELL — authenticated client pages only. Real server-backed
// notifications (GET/PATCH/DELETE /api/client/notifications*, all
// ensureClientAuth'd and scoped by session email server-side) — this code
// only renders what the server returns and never trusts/sends any
// client-asserted identity for authorization.
// ==========================================
function timeAgo(isoString) {
    const then = new Date(isoString).getTime();
    if (isNaN(then)) return '';
    const diffSec = Math.max(0, Math.floor((Date.now() - then) / 1000));
    if (diffSec < 60) return 'Just now';
    const diffMin = Math.floor(diffSec / 60);
    if (diffMin < 60) return diffMin + (diffMin === 1 ? ' minute ago' : ' minutes ago');
    const diffHr = Math.floor(diffMin / 60);
    if (diffHr < 24) return diffHr + (diffHr === 1 ? ' hour ago' : ' hours ago');
    const diffDay = Math.floor(diffHr / 24);
    if (diffDay === 1) return 'Yesterday';
    if (diffDay < 7) return diffDay + ' days ago';
    return new Date(isoString).toLocaleDateString('en-PH', { dateStyle: 'medium' });
}

// Panel state kept client-side so switching the All/Unread filter re-renders
// from what we already have instead of round-tripping to the server, and so a
// refresh (after mark-read / delete) can restore which rows the user had
// expanded rather than collapsing the whole list under them.
const notifState = { items: [], filter: 'all', expanded: new Set() };

let notifRenderedSignature = '';
function renderNotifications(notifications) {
    notifState.items = Array.isArray(notifications) ? notifications : [];
    // The 45s poll calls this on every tick. Re-rendering an open panel that
    // hasn't actually changed would reset the list's scroll position out from
    // under someone mid-read, so unchanged payloads are a no-op.
    const signature = notifState.items.map(n => n.id + ':' + (n.is_read ? 1 : 0)).join(',');
    if (signature === notifRenderedSignature) return;
    notifRenderedSignature = signature;
    // An id that no longer exists (deleted / cleared) is dropped from the
    // expanded set so it cannot leak into a later render.
    const alive = new Set(notifState.items.map(n => String(n.id)));
    notifState.expanded.forEach(id => { if (!alive.has(id)) notifState.expanded.delete(id); });
    renderNotifList();
}

function renderNotifList() {
    const list = document.getElementById('notifList');
    if (!list) return;

    const all = notifState.items;
    const unreadCount = all.filter(n => !n.is_read).length;
    updateNotifPanelChrome(all.length, unreadCount);

    // Unread-first ordering inside "All": the whole point of opening the bell
    // is the things you haven't seen, so they sit at the top instead of being
    // scattered through the date-ordered list. Server order is preserved
    // within each group (it already returns newest first).
    const visible = notifState.filter === 'unread'
        ? all.filter(n => !n.is_read)
        : all.slice().sort((a, b) => Number(!!a.is_read) - Number(!!b.is_read));

    if (!visible.length) {
        const empty = document.createElement('div');
        empty.className = 'notif-empty';
        const icon = document.createElement('i');
        icon.className = notifState.filter === 'unread' ? 'bi bi-check2-circle' : 'bi bi-bell-slash';
        empty.appendChild(icon);
        empty.appendChild(document.createTextNode(
            notifState.filter === 'unread'
                ? (all.length ? "You're all caught up — nothing unread." : 'No notifications yet.')
                : 'No notifications yet.'
        ));
        list.replaceChildren(empty);
        return;
    }

    list.replaceChildren(...visible.map(buildNotifItem));
}

function buildNotifItem(n) {
    const id = String(n.id);
    const isUnread = !n.is_read;
    const isExpanded = notifState.expanded.has(id);

    const item = document.createElement('div');
    item.className = 'notif-item' + (isUnread ? ' is-unread' : '') + (isExpanded ? ' expanded' : '');

    // Read state is carried by four stacked cues (rail, tint, icon, pill) so
    // it survives whichever one a given viewer is least sensitive to.
    const icon = document.createElement('span');
    icon.className = 'notif-item-icon';
    icon.setAttribute('aria-hidden', 'true');
    icon.innerHTML = isUnread ? '<i class="bi bi-bell-fill"></i>' : '<i class="bi bi-check2"></i>';
    item.appendChild(icon);

    const body = document.createElement('div');
    body.className = 'notif-item-body';

    const titleRow = document.createElement('button');
    titleRow.type = 'button';
    titleRow.className = 'notif-item-title-row';
    titleRow.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
    titleRow.addEventListener('click', () => {
        const nowExpanded = !item.classList.contains('expanded');
        item.classList.toggle('expanded', nowExpanded);
        titleRow.setAttribute('aria-expanded', nowExpanded ? 'true' : 'false');
        if (nowExpanded) notifState.expanded.add(id); else notifState.expanded.delete(id);
        if (!n.is_read) {
            // Flip the local copy first so the row's read styling and the
            // tab counts update on the tap, not a network round-trip later.
            n.is_read = 1;
            notifRenderedSignature = notifState.items.map(x => x.id + ':' + (x.is_read ? 1 : 0)).join(',');
            markNotificationRead(n.id);
            item.classList.remove('is-unread');
            icon.innerHTML = '<i class="bi bi-check2"></i>';
            const pill = item.querySelector('.notif-status');
            if (pill) { pill.className = 'notif-status is-read'; pill.textContent = 'Read'; }
            updateNotifPanelChrome(notifState.items.length, notifState.items.filter(x => !x.is_read).length);
        }
    });

    const title = document.createElement('span');
    title.className = 'notif-item-title';
    title.textContent = n.title;
    titleRow.appendChild(title);

    const chevron = document.createElement('i');
    chevron.className = 'bi bi-chevron-down notif-item-chevron';
    chevron.setAttribute('aria-hidden', 'true');
    titleRow.appendChild(chevron);

    body.appendChild(titleRow);

    const message = document.createElement('div');
    message.className = 'notif-item-message';
    const messageInner = document.createElement('div');
    messageInner.textContent = n.message;
    message.appendChild(messageInner);
    body.appendChild(message);

    const meta = document.createElement('div');
    meta.className = 'notif-item-meta';
    const status = document.createElement('span');
    status.className = 'notif-status ' + (isUnread ? 'is-new' : 'is-read');
    status.textContent = isUnread ? 'New' : 'Read';
    meta.appendChild(status);
    const time = document.createElement('span');
    time.className = 'notif-item-time';
    time.textContent = timeAgo(n.created_at);
    meta.appendChild(time);
    body.appendChild(meta);

    item.appendChild(body);

    const delBtn = document.createElement('button');
    delBtn.type = 'button';
    delBtn.className = 'notif-item-delete';
    delBtn.setAttribute('aria-label', 'Delete notification');
    delBtn.innerHTML = '<i class="bi bi-trash3"></i>';
    delBtn.addEventListener('click', (e) => { e.stopPropagation(); deleteNotification(n.id); });
    item.appendChild(delBtn);

    return item;
}

// Header count pill, both tab counts, and whether the bulk actions are even
// applicable — all derived from the same two numbers in one place.
function updateNotifPanelChrome(total, unread) {
    const headerCount = document.getElementById('notifHeaderCount');
    if (headerCount) {
        headerCount.textContent = unread + ' new';
        headerCount.hidden = unread === 0;
    }
    const allCount = document.getElementById('notifTabCountAll');
    if (allCount) allCount.textContent = String(total);
    const unreadTabCount = document.getElementById('notifTabCountUnread');
    if (unreadTabCount) unreadTabCount.textContent = String(unread);
    const markAll = document.getElementById('notifMarkAllBtn');
    if (markAll) markAll.disabled = unread === 0;
    const clearAll = document.getElementById('notifClearAllBtn');
    if (clearAll) clearAll.disabled = total === 0;
}

function setNotificationFilter(filter) {
    notifState.filter = filter === 'unread' ? 'unread' : 'all';
    document.querySelectorAll('.notif-tab').forEach(tab => {
        const active = tab.getAttribute('data-notif-filter') === notifState.filter;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    renderNotifList();
    const list = document.getElementById('notifList');
    if (list) list.scrollTop = 0;
}

function updateNotifBadge(count) {
    const badge = document.getElementById('notifUnreadBadge');
    if (!badge) return;
    if (count > 0) {
        badge.textContent = count > 99 ? '99+' : String(count);
        badge.hidden = false;
    } else {
        badge.hidden = true;
    }
}

let notificationsLoaded = false;
function loadNotifications() {
    if (OFFLINE_MODE || !navigator.onLine) return;
    fetchWithTimeout('/api/client/notifications', {}, 8000)
        .then(res => res.json())
        .then(data => {
            if (!data || !data.success) return;
            notificationsLoaded = true;
            renderNotifications(data.notifications || []);
            updateNotifBadge(data.unreadCount || 0);
        })
        .catch(err => console.error('[Notifications] Failed to load:', err));
}

// Moves #notifPanel (and its backdrop) to direct children of <body> the first
// time it opens — see the CSS comment on .notif-panel for why: nested inside
// .topbar (a sticky + z-indexed stacking-context boundary), the panel's own
// z-index only ever wins against OTHER things inside .topbar, so it could be
// covered/clipped by unrelated page content regardless of how high that number
// is set. Living at <body> level with `position: fixed` sidesteps every
// ancestor's stacking context and overflow entirely. Positioning is computed
// from the bell's live bounding rect rather than CSS-anchoring to a small icon,
// so it also survives the sidebar/topbar layout changing underneath it.
function getNotifBackdrop() {
    let backdrop = document.getElementById('notifBackdrop');
    if (!backdrop) {
        backdrop = document.createElement('div');
        backdrop.id = 'notifBackdrop';
        backdrop.className = 'notif-backdrop';
        backdrop.hidden = true;
        backdrop.addEventListener('click', closeNotificationPanel);
        document.body.appendChild(backdrop);
    }
    return backdrop;
}

function positionNotifPanel(panel, bell) {
    if (panel.parentElement !== document.body) {
        document.body.appendChild(panel);
    }
    // The ≤576px sheet layout anchors to the viewport edges via CSS
    // (top/left/right) — clear any leftover inline coordinates from a wider
    // viewport so that CSS wins instead of a stale inline style.
    if (window.innerWidth <= 576) {
        panel.style.top = '';
        panel.style.right = '';
        panel.style.left = '';
        return;
    }
    const gap = 8;
    const rect = bell ? bell.getBoundingClientRect() : null;
    const bottom = rect ? rect.bottom : 64;
    const right = rect ? Math.max(16, window.innerWidth - rect.right) : 16;
    panel.style.top = Math.round(bottom + gap) + 'px';
    panel.style.right = Math.round(right) + 'px';
    panel.style.left = 'auto';
}

function repositionNotifPanelIfOpen() {
    const panel = document.getElementById('notifPanel');
    if (!panel || panel.hidden) return;
    positionNotifPanel(panel, document.getElementById('btn-notif-bell'));
}

function openNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel) return;
    positionNotifPanel(panel, bell);
    const backdrop = getNotifBackdrop();
    backdrop.hidden = false;
    // Next frame so the opacity transition actually runs from 0.
    requestAnimationFrame(() => backdrop.classList.add('is-open'));
    panel.hidden = false;
    if (bell) bell.classList.add('is-active');
    bell && bell.setAttribute('aria-expanded', 'true');
    document.body.classList.add('notif-panel-open');
    // Open always starts on "All" — otherwise a filter left on "Unread" from
    // a previous open shows an empty panel once those have been read.
    setNotificationFilter('all');
    // setNotificationFilter() already painted what we have; refresh behind it
    // (the 45s poll may be up to 45s stale at the moment of the tap).
    loadNotifications();
}

function closeNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel || panel.hidden) return;
    panel.hidden = true;
    const backdrop = document.getElementById('notifBackdrop');
    if (backdrop) { backdrop.classList.remove('is-open'); backdrop.hidden = true; }
    if (bell) { bell.classList.remove('is-active'); bell.setAttribute('aria-expanded', 'false'); }
    document.body.classList.remove('notif-panel-open');
}

function toggleNotificationPanel() {
    const panel = document.getElementById('notifPanel');
    if (!panel) return;
    if (panel.hidden) openNotificationPanel(); else closeNotificationPanel();
}
// Passive, lightweight listeners kept registered permanently (not added/
// removed per open/close) — repositionNotifPanelIfOpen() itself is a no-op
// whenever the panel is hidden, so there's no ongoing cost while closed.
window.addEventListener('resize', repositionNotifPanelIfOpen);
window.addEventListener('scroll', repositionNotifPanelIfOpen, true);

document.addEventListener('click', (e) => {
    const panel = document.getElementById('notifPanel');
    const bell = document.getElementById('btn-notif-bell');
    if (!panel || panel.hidden) return;
    if (panel.contains(e.target) || (bell && bell.contains(e.target))) return;
    closeNotificationPanel();
});

document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const panel = document.getElementById('notifPanel');
    if (panel && !panel.hidden) closeNotificationPanel();
});

function markNotificationRead(id) {
    fetchWithTimeout('/api/client/notifications/' + encodeURIComponent(id) + '/read', { method: 'PATCH' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to mark read:', err));
}

function markAllNotificationsRead() {
    fetchWithTimeout('/api/client/notifications/read-all', { method: 'PATCH' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to mark all read:', err));
}

async function deleteNotification(id) {
    let confirmed;
    if (window.AppAlert && typeof AppAlert.confirm === 'function') {
        confirmed = await AppAlert.confirm('Delete this notification?', { title: 'Delete Notification?', confirmText: 'Delete' });
    } else {
        confirmed = window.confirm('Delete this notification?');
    }
    if (!confirmed) return;
    fetchWithTimeout('/api/client/notifications/' + encodeURIComponent(id), { method: 'DELETE' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to delete:', err));
}

async function clearAllNotifications() {
    let confirmed;
    const text = 'This will remove notifications from your notification inbox. It will NOT delete your surveys or change their status.';
    if (window.AppAlert && typeof AppAlert.confirm === 'function') {
        confirmed = await AppAlert.confirm(text, { title: 'Clear all notifications?', confirmText: 'Clear All' });
    } else {
        confirmed = window.confirm('Clear all notifications? ' + text);
    }
    if (!confirmed) return;
    fetchWithTimeout('/api/client/notifications', { method: 'DELETE' }, 8000)
        .then(() => loadNotifications())
        .catch(err => console.error('[Notifications] Failed to clear all:', err));
}

if (!OFFLINE_MODE) {
    window.addEventListener('load', loadNotifications);
    // Reasonable poll while the page stays open and authenticated — no
    // WebSocket/realtime infrastructure exists to push these instead.
    // Paused while the tab is hidden so a backgrounded tab doesn't keep
    // polling needlessly.
    setInterval(() => {
        if (document.visibilityState === 'visible') loadNotifications();
    }, 45000);
}

// ==========================================
// /survey-offline ONLY — applies a cached offlineAccountContext (see
// offline-db.js) once the user types a registered email this device has
// previously seen during an authenticated online session. Purely a UX
// improvement: the server is the only thing that ever actually enforces
// the registered profile or current cooldown state (resolveLockedField /
// checkResubmissionEligibilityAsync in server.js, re-run at sync time) — a
// manipulated or stale cache here can only ever make the offline form less
// convenient, never let an ineligible/incorrect submission through.
// ==========================================
let offlineContextInjectedKeys = [];

function clearInjectedOfflineEligibility() {
    offlineContextInjectedKeys.forEach(key => {
        delete blockedCombos[key];
        delete blockedUntil[key];
    });
    offlineContextInjectedKeys = [];
}

function setOfflineAccountContextNote(text) {
    const note = document.getElementById('offlineAccountContextNote');
    if (note) note.textContent = text;
}

function applyOfflineAccountContext(identifier) {
    if (!OFFLINE_MODE) return;
    if (typeof getOfflineAccountContext !== 'function') return;

    clearInjectedOfflineEligibility();
    unlockProfileFields();

    if (!identifier) {
        setOfflineAccountContextNote('');
        return;
    }

    getOfflineAccountContext(identifier).then(context => {
        // The email field may have changed again while this lookup was in
        // flight — only apply a result that still matches what's currently
        // typed, so a slow lookup for an old keystroke can never clobber a
        // newer one (and never mix two different accounts' context).
        const currentIdentifier = (document.getElementById('offlineEmailInput')?.value || '').trim().toLowerCase();
        if (currentIdentifier !== identifier) return;

        if (!context) {
            // Explicitly reassures a RETURNING user (who has a real
            // registered profile the server already has) that anything
            // typed below is only for this offline response — it can never
            // overwrite their registered account, which resolveLockedField
            // (server.js) already guarantees at sync time regardless of
            // what this device sends.
            setOfflineAccountContextNote(
                'Account information is not available offline on this device. You may complete the required profile information for this offline response. ' +
                'When internet connectivity returns, your registered account will be verified, and any existing profile information saved in your registered account will take precedence.'
            );
            return;
        }

        if (context.profile) {
            applyLockedProfile({ region: context.profile.region, age: context.profile.age, sex: context.profile.sex });
        }

        (context.services || []).forEach(svc => {
            if (svc.eligible) return;
            const key = svc.officeId + '::' + svc.serviceName;
            blockedCombos[key] = svc.cooldownUntil ? 'Available again soon.' : 'Currently unavailable for another response.';
            if (svc.cooldownUntil) {
                const ts = new Date(svc.cooldownUntil).getTime();
                if (!isNaN(ts)) blockedUntil[key] = ts;
            }
            offlineContextInjectedKeys.push(key);
        });

        const officeSelect = document.getElementById('officeSelect');
        if (officeSelect && officeSelect.value) {
            populateServiceSelect(officeSelect.value);
        }
        updateAvailabilityNotice();

        const cachedDate = context.cachedAt ? new Date(context.cachedAt) : null;
        const cachedText = cachedDate && !isNaN(cachedDate.getTime())
            ? ' (last updated ' + cachedDate.toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) + ')'
            : '';
        setOfflineAccountContextNote(
            'Account information found on this device' + cachedText + '. Your profile is shown read-only below, and known unavailable services are disabled — both are re-verified against the server once you\'re back online.'
        );
    }).catch(err => {
        console.error('[Offline Context] Lookup failed:', err);
    });
}

if (OFFLINE_MODE) {
    const offlineEmailInput = document.getElementById('offlineEmailInput');
    if (offlineEmailInput) {
        // 'blur' covers the normal desktop tab-away case; 'change' is added
        // alongside it because some mobile keyboards/browsers don't reliably
        // fire a timely blur when the user taps a different on-screen
        // control (e.g. the next form field) without the OS keyboard itself
        // losing focus first. Deliberately NOT bound to 'input' — this must
        // never query IndexedDB on every keystroke.
        const handleEmailFieldSettled = function () {
            applyOfflineAccountContext(this.value.trim().toLowerCase());
        };
        offlineEmailInput.addEventListener('blur', handleEmailFieldSettled);
        offlineEmailInput.addEventListener('change', handleEmailFieldSettled);
    }
}

// Persistent "Viewing Offline" pill — reflects navigator.onLine live, not
// just at page load, so it flips the instant the connection drops/returns
// (same signal the autosave/auto-sync logic below already relies on).
function updateOfflineIndicator() {
    const el = document.getElementById('offlineIndicator');
    if (el) el.classList.toggle('is-visible', !navigator.onLine);
}
window.addEventListener('online', updateOfflineIndicator);
window.addEventListener('offline', updateOfflineIndicator);
document.addEventListener('DOMContentLoaded', updateOfflineIndicator);
updateOfflineIndicator();

// ==========================================
// BACK-ONLINE PROMPT — offlineMode only. Deliberately never reloads or
// auto-navigates: an automatic redirect could discard unfinished answers,
// the current step, or the RAM-only credential. The user decides.
// ==========================================
function showBackOnlineBanner() {
    if (!OFFLINE_MODE) return;
    const banner = document.getElementById('backOnlineBanner');
    if (!banner || !banner.hidden) return;

    // Login is the only choice that varies: it's dropped once the survey view
    // is open — see the HTML comment on that button for why. Re-evaluated on
    // every open, not once at load, because the user can move between Home
    // and the survey view while this page stays open.
    const loginBtn = document.getElementById('backOnlineLoginBtn');
    if (loginBtn) loginBtn.hidden = !!document.querySelector('#view-survey.active');

    banner.hidden = false;
    // Move focus into the dialog so it's announced to a screen reader and
    // the first action is keyboard-reachable, instead of focus staying on
    // whichever survey field was being filled in behind the overlay.
    const firstBtn = banner.querySelector('.offline-transition-actions .btn');
    if (firstBtn) firstBtn.focus();
}
function dismissBackOnlineBanner() {
    const banner = document.getElementById('backOnlineBanner');
    if (banner) banner.hidden = true;
}

// Backdrop tap and Escape both mean "Stay Here" — the safe, non-destructive
// choice that leaves the half-finished survey untouched. Only valid because
// THIS overlay is dismissable; the offline one deliberately is not (there,
// dismissing would hand back an authenticated UI that cannot work). The
// click test is on the overlay itself, so a tap inside the card never
// closes it.
(function () {
    const banner = document.getElementById('backOnlineBanner');
    if (!banner) return;
    banner.addEventListener('click', function (e) {
        if (e.target === banner) dismissBackOnlineBanner();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !banner.hidden) dismissBackOnlineBanner();
    });
})();

// Heuristic for "there is unfinished, unsubmitted survey information worth
// warning about before navigating away" — past Stage 1 (Terms) counts,
// since nothing has been entered yet at Stage 1 itself.
function hasUnsavedSurveyProgress() {
    const activePage = document.querySelector('#surveyForm .page.active');
    if (!activePage) return false;
    const stage = parseInt(activePage.id.replace('stage', ''), 10);
    return stage > 1;
}

// Used by both the sidebar's "Back to Dashboard" link and the back-online
// banner's "Go to Dashboard"/"Login" buttons. `event` is only passed by the
// <a> (to synchronously block its default navigation while the confirm — if
// shown — is still pending); plain <button>s have no default action to
// prevent. Never touches the RAM password or IndexedDB outbox itself — a
// real navigation away would drop the in-memory password regardless of
// this function, which is exactly why it asks first instead of trying to
// persist it.
function confirmLeaveOfflineSurvey(url, event) {
    if (event) event.preventDefault();
    (async () => {
        try {
            if (hasUnsavedSurveyProgress()) {
                let confirmed;
                if (window.AppAlert && typeof AppAlert.confirm === 'function') {
                    confirmed = await AppAlert.confirm(
                        'You have unfinished survey information. Leaving this page may discard the unfinished form.',
                        { title: 'Leave Offline Survey?', confirmText: 'Leave' }
                    );
                } else {
                    confirmed = window.confirm('You have unfinished survey information. Leaving this page may discard the unfinished form.');
                }
                if (!confirmed) return;
            }
        } catch (err) {
            // The click already had its default navigation cancelled above,
            // so a throw anywhere in the prompt would leave the user on a
            // dead button with no way forward and nothing on screen. Failing
            // open (navigating anyway) is the safe direction here: the draft
            // is autosaved to IndexedDB either way.
            console.error('[Offline Nav] Leave confirmation failed, navigating anyway:', err);
        }
        window.location.href = url;
    })();
    return false;
}

// The "You're Offline" overlay's own navigation (Back to Dashboard / Go to
// Offline Survey / Login). Separate from confirmLeaveOfflineSurvey above on
// purpose: by the time that overlay is on screen, showOfflineTransition()
// has ALREADY autosaved the in-progress draft, so there is nothing left to
// warn about and the user has already made their choice by picking one of
// four clearly-labelled buttons. Adding a second prompt on top of that both
// contradicted the overlay's own "your progress has been saved" note and —
// because the confirm rendered underneath the overlay's own backdrop — made
// these buttons look completely dead.
function leaveFromOfflineOverlay(url, event) {
    if (event) event.preventDefault();
    // Defensive re-save: cheap, idempotent, and guarantees the very latest
    // answers are on disk even if something was typed between the overlay
    // opening and this click.
    try { autosaveActiveSurveyDraftNow(); } catch (err) {
        console.error('[Offline Nav] Draft autosave before leaving failed:', err);
    }
    window.location.href = url;
    return false;
}

if (OFFLINE_MODE) {
    // Two ways to end up here with connectivity already restored:
    // (1) a genuine reconnect while this tab stays open — the 'online'
    //     event below — or (2) the user is on this same offline page,
    //     online already, and reloads it (e.g. after Stay Here on a
    //     previous visit, or just re-opening a bookmarked/PWA-cached copy).
    // Only listening for the 'online' event misses case (2) entirely: that
    // event only fires on an actual offline->online transition, never on a
    // page load where the browser was already online the whole time — so a
    // refresh here used to silently and permanently lose the recovery UI
    // even though both conditions (still viewing the offline page, internet
    // available) still hold. Re-evaluating navigator.onLine at load time
    // covers case (2); no persisted "already dismissed" flag is used here,
    // so a page reload always re-checks fresh — the banner is only ever
    // absent for the remainder of THIS load after Stay Here is clicked, not
    // permanently.
    if (navigator.onLine) showBackOnlineBanner();
    window.addEventListener('online', showBackOnlineBanner);

    // This page (/survey-offline) is legitimately usable with no account
    // session at all, but the pending-logout marker isn't scoped to "was
    // THIS visit authenticated" — it means "the server may still think a
    // previous session is valid" (e.g. the user chose Go to Offline Survey
    // from the authenticated page's offline overlay while still offline).
    // Retry it here too on the same terms as everywhere else: fire-and-
    // forget, cleared only on a confirmed server response, never touching
    // the offline survey form, IndexedDB outbox, or sync logic below.
    if (navigator.onLine && hasPendingClientLogout()) attemptPendingClientLogout();
    window.addEventListener('online', function () {
        if (hasPendingClientLogout()) attemptPendingClientLogout();
    });
}

// Local, client-side fallback autofill. Independent of the server's
// client_accounts lookup (which only has data for users whose account row
// exists) — this simply remembers what THIS ACCOUNT last typed/selected for
// Name, Client Type, Age, and Region, and reuses it the next time THIS
// account clicks Autofill. Keyed per-account (by email) so a different
// person signing in on the same browser never sees someone else's answers.
const CLIENT_AUTOFILL_KEY = currentClientEmail
    ? 'cspc_client_autofill_profile_' + currentClientEmail.toLowerCase()
    : null;

function saveAutofillProfile(data) {
    if (!CLIENT_AUTOFILL_KEY) return;
    try {
        localStorage.setItem(CLIENT_AUTOFILL_KEY, JSON.stringify({
            respondent_name: data.respondent_name || '',
            client_type: data.client_type || '',
            age: data.age || '',
            region: data.region || ''
        }));
    } catch (e) { /* localStorage unavailable — autofill just won't persist */ }
}

// Fills Name/Client Type/Age/Region from this account's last locally-saved
// answers. Only ever called from the Autofill switch's handler — never on
// page load — so the Name field starts blank for every sign-in. Never
// overwrites a field that already has a value or is locked/disabled (e.g.
// by applyLockedProfile from a prior server-confirmed submission).
//
// `opts.skipName` — set by toggleAutofillClientProfile() whenever the live
// /api/client-profile request actually succeeded (even if it came back with
// no name at all). The server is the one authoritative source for the Name
// field specifically once it has answered at all — falling through to this
// account's possibly months-old locally-cached name in that case would
// silently show a stale name instead of the current (possibly since-edited,
// or genuinely still-blank) profile value. This local fallback is only
// meant for when the server genuinely couldn't be reached — see the catch
// branch below.
function applyAutofillFromLocalStorage(opts) {
    opts = opts || {};
    if (!CLIENT_AUTOFILL_KEY) return;
    let saved;
    try { saved = JSON.parse(localStorage.getItem(CLIENT_AUTOFILL_KEY)); } catch (e) { saved = null; }
    if (!saved) return;

    if (!opts.skipName) {
        const nameInput = document.querySelector('input[name="respondent_name"]');
        if (nameInput && !nameInput.disabled && !nameInput.value && saved.respondent_name) {
            nameInput.value = saved.respondent_name;
        }
    }

    const clientTypeSelect = document.querySelector('select[name="client_type"]');
    if (clientTypeSelect && !clientTypeSelect.disabled && !clientTypeSelect.value && saved.client_type) {
        clientTypeSelect.value = saved.client_type;
    }

    const ageSelect = document.querySelector('select[name="age"]');
    if (ageSelect && !ageSelect.disabled && !ageSelect.value && saved.age) {
        ageSelect.value = saved.age;
    }

    const regionSelect = document.querySelector('select[name="region"]');
    if (regionSelect && !regionSelect.disabled && !regionSelect.value && saved.region) {
        regionSelect.value = saved.region;
    }
}

// `profile` defaults to the server-rendered savedClientProfile (the
// authenticated /client-survey case). /survey-offline has no server-
// rendered profile (no session exists yet to look one up from) — it calls
// this with a profile read from IndexedDB's offlineAccountContext store
// instead, once the user types an email this device has cached context
// for (see applyOfflineAccountContext below). Either way the server is the
// one that actually enforces this precedence at sync time (resolveLockedField
// in server.js) — this function only ever affects what the form displays.
function applyLockedProfile(profile) {
    profile = profile || savedClientProfile;
    if (!profile) return;

    // Name is intentionally NOT prefilled here (and never was meant to be
    // silently populated just because the account is logged in) — a survey
    // respondent should stay anonymous by default. It's now filled ONLY by
    // the explicit Autofill switch, via toggleAutofillClientProfile() below,
    // which the user has to deliberately turn on.

    if (profile.region) {
        const regionSelect = document.querySelector('select[name="region"]');
        if (regionSelect) {
            regionSelect.value = profile.region;
            regionSelect.disabled = true;
        }
        const note = document.getElementById('region-lock-note');
        if (note) note.classList.remove('d-none');
    }

    if (profile.age) {
        const ageSelect = document.querySelector('select[name="age"]');
        if (ageSelect) {
            ageSelect.value = profile.age;
            ageSelect.disabled = true;
        }
        const note = document.getElementById('age-lock-note');
        if (note) note.classList.remove('d-none');
    }

    // Offline context uses `sex` (matches the offline-profile spec's own
    // schema); the authenticated savedClientProfile uses `gender` (matches
    // the client_accounts column name) — accept either.
    const genderValue = profile.gender || profile.sex;
    if (genderValue) {
        const genderSelect = document.querySelector('select[name="gender"]');
        if (genderSelect) {
            genderSelect.value = genderValue;
            genderSelect.disabled = true;
        }
        const note = document.getElementById('gender-lock-note');
        if (note) note.classList.remove('d-none');
    }

    // Activate Bootstrap tooltips on any lock icons just revealed
    document.querySelectorAll('.lock-icon:not(.d-none)').forEach(el => {
        bootstrap.Tooltip.getOrCreateInstance(el);
    });
}

// Reverses applyLockedProfile — used only in offline mode, when the typed
// email is changed to one this device has no (or different) cached context
// for. Never used in authenticated mode: there, a lock reflects the actual
// signed-in account's permanent database profile and must never be undone
// client-side.
function unlockProfileFields() {
    const regionSelect = document.querySelector('select[name="region"]');
    if (regionSelect) regionSelect.disabled = false;
    document.getElementById('region-lock-note')?.classList.add('d-none');

    const ageSelect = document.querySelector('select[name="age"]');
    if (ageSelect) ageSelect.disabled = false;
    document.getElementById('age-lock-note')?.classList.add('d-none');

    const genderSelect = document.querySelector('select[name="gender"]');
    if (genderSelect) genderSelect.disabled = false;
    document.getElementById('gender-lock-note')?.classList.add('d-none');
}

// Snapshot of Name/Sex/Age/Region taken right before the switch is turned on,
// restored if it's turned back off. Only ever applied to fields that aren't
// already disabled/locked from a prior submission.
let autofillSnapshot = null;

// After an Autofill attempt (server profile, then the local fallback) has
// had its chance to fill Name, tell the client plainly if neither source had
// one — rather than silently leaving the field blank with no explanation,
// or (the actual bug this replaces) ever writing a literal "undefined" /
// "null" string into it.
function notifyIfNoAutofillName() {
    const nameInput = document.querySelector('input[name="respondent_name"]');
    if (nameInput && !nameInput.value && window.AppAlert && typeof AppAlert.toastInfo === 'function') {
        AppAlert.toastInfo('No name is saved in your profile.');
    }
}

// Toggling on fills Name, Sex, Age, and Region from this account's saved profile
// (same source as applyLockedProfile). Toggling off restores whatever those
// fields held before the switch was turned on.
function toggleAutofillClientProfile(enabled) {
    if (enabled) {
        autofillSnapshot = {
            respondent_name: document.querySelector('input[name="respondent_name"]')?.value ?? '',
            region: document.querySelector('select[name="region"]')?.value ?? '',
            age: document.querySelector('select[name="age"]')?.value ?? '',
            gender: document.querySelector('select[name="gender"]')?.value ?? ''
        };

        fetchWithTimeout('/api/client-profile', {}, 5000)
            .then(res => res.json())
            .then(data => {
                const p = (data.success && data.profile) ? data.profile : {};

                const nameInput = document.querySelector('input[name="respondent_name"]');
                if (nameInput && !nameInput.disabled && p.respondent_name) nameInput.value = p.respondent_name;

                const regionSelect = document.querySelector('select[name="region"]');
                if (regionSelect && !regionSelect.disabled && p.region) regionSelect.value = p.region;

                const ageSelect = document.querySelector('select[name="age"]');
                if (ageSelect && !ageSelect.disabled && p.age) ageSelect.value = p.age;

                const genderSelect = document.querySelector('select[name="gender"]');
                if (genderSelect && !genderSelect.disabled && p.gender) genderSelect.value = p.gender;

                // Fall back to this account's own locally-remembered answers
                // for Client Type/Age/Region only where the server didn't
                // already provide one — the request DID succeed, so Name
                // specifically is not re-guessed from a possibly-stale local
                // copy (see the skipName comment on the function itself).
                applyAutofillFromLocalStorage({ skipName: true });
                notifyIfNoAutofillName();
            })
            .catch(err => {
                console.error('Error autofilling profile:', err);
                // Server genuinely unreachable — THIS is the one case where
                // falling back to a locally-cached name from a past
                // submission on this browser is an acceptable substitute.
                applyAutofillFromLocalStorage();
                notifyIfNoAutofillName();
            });
    } else if (autofillSnapshot) {
        const nameInput = document.querySelector('input[name="respondent_name"]');
        if (nameInput && !nameInput.disabled) nameInput.value = autofillSnapshot.respondent_name;

        const regionSelect = document.querySelector('select[name="region"]');
        if (regionSelect && !regionSelect.disabled) regionSelect.value = autofillSnapshot.region;

        const ageSelect = document.querySelector('select[name="age"]');
        if (ageSelect && !ageSelect.disabled) ageSelect.value = autofillSnapshot.age;

        const genderSelect = document.querySelector('select[name="gender"]');
        if (genderSelect && !genderSelect.disabled) genderSelect.value = autofillSnapshot.gender;

        autofillSnapshot = null;
    }
}

// Mobile sidebar toggle — slides the dashboard sidebar in/out with a backdrop
function toggleSidebar() {
    document.getElementById('clientSidebar').classList.toggle('show');
    document.getElementById('sidebarBackdrop').classList.toggle('show');
}

function closeSidebarOnMobile() {
    if (window.innerWidth < 992) {
        document.getElementById('clientSidebar').classList.remove('show');
        document.getElementById('sidebarBackdrop').classList.remove('show');
    }
}

// Desktop-only persistent sidebar collapse — lets the client hide the sidebar
// entirely to focus on the survey full-screen. Reuses the same slide transform
// as the mobile overlay, but toggled on .app-shell (no backdrop, reclaims the
// space instead of covering content) so it's purely a layout change.
function setSidebarCollapsed(collapsed) {
    const shell = document.querySelector('.app-shell');
    shell.classList.toggle('sidebar-collapsed', collapsed);
    const btn = document.getElementById('btn-sidebar-collapse');
    if (btn) {
        btn.innerHTML = '<i class="bi bi-list"></i>';
        btn.title = collapsed ? 'Show sidebar' : 'Collapse sidebar — focus on the survey';
    }
}

function toggleSidebarCollapse() {
    const shell = document.querySelector('.app-shell');
    setSidebarCollapsed(!shell.classList.contains('sidebar-collapsed'));
}

// =====================================
// SPA VIEW SWITCHING — Take Survey / Profile / History
// =====================================
const VIEW_TITLES = {
    home: 'Home',
    survey: 'Client Satisfaction Survey',
    profile: 'My Profile',
    history: 'Survey History'
};

let profileLoaded = false;
let historyLoaded = false;

// Swaps the visible app-view and the active sidebar link without a page
// reload. Lazily fetches Profile/History data the first time each tab is
// opened. Returns false so it can be used directly as an <a>'s onclick to
// suppress the default "#" navigation.
function switchView(view) {
    document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active'));
    const target = document.getElementById('view-' + view);
    if (target) target.classList.add('active');

    document.querySelectorAll('.sidebar-nav .nav-item-link').forEach(a => a.classList.remove('active'));
    const navLink = document.querySelector(`.sidebar-nav .nav-item-link[data-view="${view}"]`);
    if (navLink) navLink.classList.add('active');

    // The header no longer renames itself per view — it carries the portal's
    // identity, the same one the sidebar header shows, and each view states
    // its own name inside its card (.view-page-title). The view name still
    // goes somewhere useful: the browser tab/history entry, which is where a
    // per-view name actually helps once several tabs are open.
    const viewTitle = VIEW_TITLES[view] || '';
    document.title = viewTitle ? viewTitle + ' — CQA Client Portal' : 'CQA Client Portal';

    if (view === 'profile' && !profileLoaded) loadProfileView();
    if (view === 'history' && !historyLoaded) loadHistoryView();

    // (The English/Tagalog switch used to be shown/hidden from here, back
    // when it lived in the app header and had to be suppressed on every
    // view but this one. It now sits inside the survey card itself, so it
    // comes and goes with that view and needs no handling here.)

    // Auto-hide the sidebar while taking the survey (topbar stays visible);
    // auto-restore it on Profile/History. Desktop-only persistent-collapse
    // behavior (see setSidebarCollapsed's own comment) — applying it on
    // mobile leaves .sidebar-collapsed stuck on .app-shell, which permanently
    // out-specificities the mobile show/hide toggle (see navigate()'s comment
    // on the same issue).
    if (window.innerWidth >= 992) setSidebarCollapsed(view === 'survey');

    closeSidebarOnMobile();
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Now that the switch is actually done, leaving the survey view is a
    // safe, natural point to surface a "please sign in again" screen that
    // showBackOnlineTransition() held back earlier so it wouldn't interrupt
    // an in-progress Continue Survey attempt — see backOnlinePromptSuppressed.
    if (view !== 'survey' && backOnlinePromptSuppressed) {
        backOnlinePromptSuppressed = false;
        if (typeof showBackOnlineTransition === 'function') showBackOnlineTransition();
    }

    return false;
}

// Cache key is per-account, same convention as CLIENT_HISTORY_CACHE_KEY, so
// a different person signing in on this browser never sees someone else's
// cached profile.
const CLIENT_PROFILE_CACHE_KEY = currentClientEmail
    ? 'cspc_client_profile_cache_' + currentClientEmail.toLowerCase()
    : null;

function renderProfileView(p, fromCache) {
            // Server has nothing yet (no client_accounts row) — fall back to what
            // this browser last saved locally, so the page isn't stuck on
            // "Not set yet" for someone who has, in fact, answered before.
            let localSaved = null;
            try { localSaved = JSON.parse(localStorage.getItem(CLIENT_AUTOFILL_KEY)); } catch (e) { /* ignore */ }

            const respondentName = p.respondent_name || (localSaved && localSaved.respondent_name) || '';
            const region = p.region || (localSaved && localSaved.region) || '';
            const age = p.age || (localSaved && localSaved.age) || '';
            const gender = p.gender || '';

            const resolvedEmail = p.email || currentClientEmail || '—';
            document.getElementById('pf-email').textContent = resolvedEmail;
            document.getElementById('pf-name-display').textContent = respondentName || 'Not set yet';
            document.getElementById('pf-name-input').value = respondentName;

            // The hero used to read "My Profile", which the app header already
            // says — it shows who is signed in instead.
            const heroNameEl = document.getElementById('pf-hero-name');
            const heroEmailEl = document.getElementById('pf-hero-email');
            if (heroNameEl) heroNameEl.textContent = respondentName || 'Welcome';
            if (heroEmailEl) heroEmailEl.textContent = resolvedEmail;

            // An account created purely through Google sign-in may not have a
            // password yet, so the panel has to ask to SET one rather than to
            // change one (and must not demand a current password that doesn't
            // exist). /api/client-password applies the same rule server-side.
            applyPasswordPanelMode(p.has_password !== false);

            // Google account photo, when we have one on file (captured at Google sign-in —
            // see /auth/google/callback). Falls back to the generic person icon otherwise
            // (e.g. an account that only ever used email/password login).
            const avatarEl = document.getElementById('pf-avatar');
            if (avatarEl) {
                avatarEl.innerHTML = p.photo_url
                    ? `<img src="${p.photo_url}" alt="Google profile photo" referrerpolicy="no-referrer">`
                    : '<i class="bi bi-person-fill"></i>';
            }

            const lockedOrUnset = (value, locked, iconTitle) => value
                ? (locked
                    ? `<span class="profile-locked-badge" title="${iconTitle}"><i class="bi bi-lock-fill"></i> ${value}</span>`
                    : `<span>${value}</span>`)
                : `<span class="profile-unset">Not set yet — captured on your first survey submission</span>`;

    document.getElementById('pf-region').innerHTML = lockedOrUnset(region, !!p.region, 'Locked after your first survey');
    document.getElementById('pf-age').innerHTML = lockedOrUnset(age, !!p.age, 'Locked after your first survey');
    document.getElementById('pf-gender').innerHTML = lockedOrUnset(gender, !!p.gender, 'Locked after your first survey');

    const offlineNoteEl = document.getElementById('profileOfflineNote');
    if (offlineNoteEl) offlineNoteEl.classList.toggle('d-none', !fromCache);

    document.getElementById('profileLoading').classList.add('d-none');
    document.getElementById('profileContent').classList.remove('d-none');
}

function loadProfileView() {
    fetchWithTimeout('/api/client-profile', {}, 5000)
        .then(res => res.json())
        .then(data => {
            if (!data.success) throw new Error(data.message || 'Failed to load profile.');
            profileLoaded = true;
            const p = data.profile || {};

            if (CLIENT_PROFILE_CACHE_KEY) {
                try { localStorage.setItem(CLIENT_PROFILE_CACHE_KEY, JSON.stringify(p)); } catch (e) { /* localStorage unavailable — offline fallback just won't apply */ }
            }

            renderProfileView(p, false);
        })
        .catch(err => {
            console.error('Error loading profile, falling back to cache:', err);

            let cached = null;
            if (CLIENT_PROFILE_CACHE_KEY) {
                try { cached = JSON.parse(localStorage.getItem(CLIENT_PROFILE_CACHE_KEY) || 'null'); } catch (e) { /* corrupt/unavailable cache */ }
            }

            if (cached) {
                // Deliberately leave profileLoaded false so reopening this
                // view retries the network once connectivity returns.
                renderProfileView(cached, true);
                return;
            }

            document.getElementById('profileLoading').innerHTML =
                '<p class="text-danger mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Could not load your profile. Please try again.</p>';
        });
}

// Switches the profile view from static "View Mode" into editable "Edit Mode".
// Only the Name field is editable (see the comment above #profileEditMode), so
// this just swaps which of the two wrapper divs is visible.
function enterProfileEditMode() {
    document.getElementById('pf-name-input').value = document.getElementById('pf-name-display').textContent.trim();
    document.getElementById('profileViewMode').classList.add('d-none');
    document.getElementById('profileEditMode').classList.remove('d-none');
    document.getElementById('pf-name-input').focus();
}

// Discards any unsaved edits and returns to View Mode without calling the API.
function exitProfileEditMode() {
    document.getElementById('profileEditMode').classList.add('d-none');
    document.getElementById('profileViewMode').classList.remove('d-none');
}

// ==========================================
// PROFILE — Password management
// ==========================================
// `hasPassword` false means this account signed up through Google and has
// never set a password, so the whole panel becomes "set" rather than "change"
// and the Current Password field is removed (there is nothing to prove).
let clientHasPassword = true;

function applyPasswordPanelMode(hasPassword) {
    clientHasPassword = hasPassword !== false;

    const currentField = document.getElementById('currentPasswordField');
    const currentInput = document.getElementById('pf-current-password');
    const btnText = document.getElementById('btnTogglePasswordText');
    const hint = document.getElementById('pf-password-hint');
    const saveBtn = document.getElementById('pf-password-save-btn');

    if (currentField) currentField.classList.toggle('d-none', !clientHasPassword);
    // Cleared as well as hidden, so a stale value can never be posted.
    if (currentInput) {
        currentInput.required = clientHasPassword;
        if (!clientHasPassword) currentInput.value = '';
    }
    if (btnText) btnText.textContent = clientHasPassword ? 'Change Password' : 'Set Password';
    if (saveBtn) saveBtn.innerHTML = clientHasPassword
        ? '<i class="bi bi-check2-circle me-1"></i> Update Password'
        : '<i class="bi bi-check2-circle me-1"></i> Set Password';
    if (hint) {
        hint.innerHTML = clientHasPassword
            ? '<i class="bi bi-info-circle me-1"></i> Used to sign in with your email on the login page.'
            : '<i class="bi bi-info-circle me-1"></i> You signed in with Google. Set a password to also sign in with your email.';
    }
}

// `force` lets Cancel close the panel unconditionally; omitted, it toggles.
function togglePasswordPanel(force) {
    const form = document.getElementById('passwordForm');
    if (!form) return;
    const willOpen = typeof force === 'boolean' ? force : form.classList.contains('d-none');

    form.classList.toggle('d-none', !willOpen);
    if (!willOpen) {
        form.reset();
        // reset() restores the default value but fires no `input` event, so the
        // injected strength meter would keep showing the old level — nudge it.
        const newPw = document.getElementById('pf-new-password');
        if (newPw) newPw.dispatchEvent(new Event('input', { bubbles: true }));
        const mismatch = document.getElementById('pf-password-mismatch');
        if (mismatch) mismatch.classList.add('d-none');
    } else {
        const first = clientHasPassword
            ? document.getElementById('pf-current-password')
            : document.getElementById('pf-new-password');
        if (first) first.focus();
    }
}

function saveClientPassword(event) {
    event.preventDefault();

    const currentPassword = (document.getElementById('pf-current-password') || {}).value || '';
    const newPassword = document.getElementById('pf-new-password').value;
    const confirmPassword = document.getElementById('pf-confirm-password').value;
    const mismatchEl = document.getElementById('pf-password-mismatch');
    const saveBtn = document.getElementById('pf-password-save-btn');

    // Inline (not a modal) — it's a field-level problem the user fixes right
    // where they are.
    const mismatch = newPassword !== confirmPassword;
    if (mismatchEl) mismatchEl.classList.toggle('d-none', !mismatch);
    if (mismatch) {
        document.getElementById('pf-confirm-password').focus();
        return false;
    }
    if (newPassword.length < 8) {
        AppAlert.warning('Your new password must be at least 8 characters long.', 'Password Too Short');
        return false;
    }

    const originalHtml = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving…';

    fetch('/api/client-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
    })
        .then(async (res) => {
            // Not every response to this POST is JSON. A session that expired
            // mid-edit redirects to the HTML login page, and an unmatched route
            // (server running older code than this page) hits Express's default
            // HTML 404 — blindly calling res.json() on either surfaces as the
            // useless 'Unexpected token <, "<!DOCTYPE"... is not valid JSON'
            // rather than telling the user what actually went wrong.
            const contentType = res.headers.get('content-type') || '';
            if (!contentType.includes('application/json')) {
                if (res.status === 404) {
                    throw new Error('This feature isn\'t available on the server yet. Please refresh the page, or contact your administrator if it keeps happening.');
                }
                if (res.status === 401 || res.status === 403 || res.redirected) {
                    throw new Error('Your session has expired. Please sign in again and retry.');
                }
                throw new Error('The server returned an unexpected response. Please try again.');
            }
            return res.json();
        })
        .then(data => {
            if (!data.success) throw new Error(data.message || 'Could not update your password.');
            // The account definitely has one now, so a later open of this panel
            // asks for the current password even if it didn't before.
            applyPasswordPanelMode(true);
            togglePasswordPanel(false);
            AppAlert.success(data.message || 'Your password has been updated.', 'Password Updated');
        })
        .catch(err => {
            AppAlert.error(err.message || 'Could not update your password. Please try again.', 'Update Failed');
        })
        .finally(() => {
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalHtml;
        });

    return false;
}

function saveProfile(event) {
    if (event) event.preventDefault();
    const nameInput = document.getElementById('pf-name-input');
    const name = nameInput.value.trim();
    if (!name) {
        markLeafInvalid(nameInput, 'Please enter your name.');
        AppAlert.warning('Please enter your name.');
        nameInput.focus();
        return false;
    }
    clearLeafInvalid(nameInput);

    if (!navigator.onLine) {
        AppAlert.warning('You are offline. Profile name changes need a connection — please try again once you\'re back online.', 'Offline');
        return false;
    }

    const btn = document.getElementById('pf-save-btn');
    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving…';

    fetch('/api/client-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ respondent_name: name })
    })
        .then(res => res.json())
        .then(data => {
            if (!data.success) throw new Error(data.message || 'Could not save your profile.');
            document.getElementById('pf-name-display').textContent = name;
            exitProfileEditMode();
            AppAlert.success('Profile updated successfully.');
        })
        .catch(err => {
            console.error('Error saving profile:', err);
            AppAlert.error(err.message || 'Could not save your profile. Please try again.');
        })
        .finally(() => {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        });

    return false;
}

// Cache key is per-account, same convention as CLIENT_AUTOFILL_KEY, so a
// different person signing in on this browser never sees someone else's
// cached history.
const CLIENT_HISTORY_CACHE_KEY = currentClientEmail
    ? 'cspc_client_history_cache_' + currentClientEmail.toLowerCase()
    : null;

function renderHistoryList(history, fromCache) {
    document.getElementById('historyLoading').classList.add('d-none');

    if (history.length === 0) {
        document.getElementById('historyEmpty').classList.remove('d-none');
        return;
    }

    const listEl = document.getElementById('historyList');
    listEl.innerHTML = (fromCache ? '<div class="history-meta mb-2"><i class="bi bi-wifi-off me-1"></i>Viewing offline — showing your last-loaded history.</div>' : '')
        + history.map(row => {
                const isApproved = row.status === 'approved';
                const isDeclined = row.status === 'declined';
                const badge = isApproved
                    ? '<span class="history-badge"><i class="bi bi-check-circle-fill me-1"></i> Completed</span>'
                    : isDeclined
                        ? '<span class="history-badge bg-danger-subtle text-danger"><i class="bi bi-x-circle-fill me-1"></i> Declined</span>'
                        : '<span class="history-badge bg-warning-subtle text-warning"><i class="bi bi-hourglass-split me-1"></i> Pending Review</span>';
                // Only approved submissions have reviewed answers to show —
                // pending/declined rows aren't clickable into the detail modal.
                const clickAttrs = isApproved
                    ? `role="button" tabindex="0" title="Click to view your answers" onclick="openHistoryDetail(${row.id})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openHistoryDetail(${row.id});}"`
                    : '';
                return `
                <div class="history-item" ${clickAttrs}>
                    <div class="history-item-text">
                        <div class="history-office"><i class="bi bi-building me-1"></i> ${escapeHtml(row.office_name)}</div>
                        <div class="history-meta">${escapeHtml(row.cluster_name || 'General')} &middot; ${escapeHtml(row.formatted_date)}</div>
                        ${isDeclined && row.decline_reason ? `<div class="history-meta text-danger">${escapeHtml(row.decline_reason)}</div>` : ''}
                    </div>
                    ${badge}
                </div>
            `;
            }).join('');
    listEl.classList.remove('d-none');
}

function loadHistoryView() {
    fetchWithTimeout('/api/client-history', {}, 5000)
        .then(res => res.json())
        .then(data => {
            if (!data.success) throw new Error(data.message || 'Failed to load history.');
            historyLoaded = true;
            const history = data.history || [];

            // Cache a fresh copy for the next time this view loads offline —
            // see the fetch failure branch below.
            if (CLIENT_HISTORY_CACHE_KEY) {
                try { localStorage.setItem(CLIENT_HISTORY_CACHE_KEY, JSON.stringify(history)); } catch (e) { /* localStorage unavailable — offline fallback just won't apply */ }
            }

            renderHistoryList(history, false);
        })
        .catch(err => {
            console.error('Error loading history, falling back to cache:', err);

            let cached = null;
            if (CLIENT_HISTORY_CACHE_KEY) {
                try { cached = JSON.parse(localStorage.getItem(CLIENT_HISTORY_CACHE_KEY) || 'null'); } catch (e) { /* corrupt/unavailable cache */ }
            }

            if (cached) {
                // Deliberately leave historyLoaded false so reopening this
                // view retries the network once connectivity returns.
                renderHistoryList(cached, true);
                return;
            }

            document.getElementById('historyLoading').innerHTML =
                '<p class="text-danger mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Could not load your survey history. Please try again.</p>';
        });
}

const sqdRatingLabels = {
    '5': 'Strongly Agree', '4': 'Agree', '3': 'Neutral',
    '2': 'Disagree', '1': 'Strongly Disagree', '0': 'N/A'
};

function openHistoryDetail(id) {
    const modalEl = document.getElementById('historyDetailModal');
    const bodyEl = document.getElementById('historyDetailBody');
    bodyEl.innerHTML = `
        <div class="spinner-block">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 mb-0">Loading your answers…</p>
        </div>
    `;
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    fetchWithTimeout('/api/client-history/' + encodeURIComponent(id), {}, 5000)
        .then(res => res.json())
        .then(data => {
            if (!data.success) throw new Error(data.message || 'Failed to load this survey.');
            const s = data.survey;
            const sqdItems = (i18n[currentLang] && i18n[currentLang].sqd_items) ? i18n[currentLang].sqd_items : i18n.en.sqd_items;

            const sqdRows = sqdItems.map((label, idx) => {
                const val = s['sqd' + idx];
                let badge;
                if (val === null || val === undefined) {
                    badge = `<span class="sqd-rating-badge sqd-rating-unanswered">—</span>`;
                } else if (Number(val) === 0) {
                    badge = `<span class="sqd-rating-badge sqd-rating-na">N/A</span>`;
                } else {
                    const text = sqdRatingLabels[String(val)] || val;
                    badge = `<span class="sqd-rating-badge sqd-rating-${val}"><span class="sqd-rating-num">${escapeHtml(String(val))}</span> ${escapeHtml(text)}</span>`;
                }
                return `
                    <div class="review-sqd-row">
                        <span class="review-sqd-statement">${escapeHtml(label)}</span>
                        ${badge}
                    </div>
                `;
            }).join('');

            const ccItem = (label, value) => `
                <div class="review-item full">
                    <div class="label">${label}</div>
                    <div class="value">${escapeHtml(value || '—')}</div>
                </div>
            `;

            bodyEl.innerHTML = `
                <div class="history-detail-head">
                    <div class="history-detail-icon"><i class="bi bi-building"></i></div>
                    <div class="history-item-text">
                        <div class="history-office">${escapeHtml(s.office_name)}</div>
                        <div class="history-meta">${escapeHtml(s.cluster_name || 'General')} &middot; ${escapeHtml(s.formatted_date)}</div>
                    </div>
                    <span class="history-badge ms-auto"><i class="bi bi-check-circle-fill me-1"></i> Completed</span>
                </div>

                <div class="review-section">
                    <div class="review-section-header"><h5><i class="bi bi-file-earmark-text-fill me-1"></i> Citizen's Charter</h5></div>
                    <div class="review-grid">
                        ${ccItem('CC1', s.cc1)}
                        ${ccItem('CC2', s.cc2)}
                        ${ccItem('CC3', s.cc3)}
                    </div>
                </div>

                <div class="review-section">
                    <div class="review-section-header"><h5><i class="bi bi-star-fill me-1"></i> Service Quality Dimensions</h5></div>
                    <div class="review-sqd-list">${sqdRows}</div>
                </div>

                <div class="review-section mb-0">
                    <div class="review-section-header"><h5><i class="bi bi-chat-left-text-fill me-1"></i> Suggestions / Comments</h5></div>
                    <div class="review-item full">
                        <div class="value">${escapeHtml(s.comments && s.comments !== 'N/A' ? s.comments : 'No comments provided.')}</div>
                    </div>
                </div>
            `;
        })
        .catch(err => {
            console.error('Error loading survey detail:', err);
            bodyEl.innerHTML = '<p class="text-danger mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Could not load your answers. Please try again.</p>';
        });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str == null ? '' : String(str);
    return div.innerHTML;
}

// =====================================
// FULL SCREEN MODE
// =====================================
function getFullscreenElement() {
    return document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement || null;
}

// Requests full screen on the whole page. Browsers require a user gesture and
// may still reject silently (iOS Safari, embedded webviews, etc.) — the
// rejection is swallowed so the survey keeps working normally either way.
function enterFullscreen() {
    if (getFullscreenElement()) return;
    const el = document.documentElement;
    const request = el.requestFullscreen || el.webkitRequestFullscreen || el.msRequestFullscreen;
    if (!request) return;
    try {
        const result = request.call(el);
        if (result && typeof result.catch === 'function') {
            result.catch(() => { /* blocked by browser/permissions — ignore, survey still works */ });
        }
    } catch (e) { /* Fullscreen API unsupported or blocked — ignore */ }
}

function exitFullscreen() {
    if (!getFullscreenElement()) return;
    const exit = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen;
    if (!exit) return;
    try {
        const result = exit.call(document);
        if (result && typeof result.catch === 'function') result.catch(() => {});
    } catch (e) { /* ignore */ }
}

function toggleFullscreen() {
    if (getFullscreenElement()) exitFullscreen();
    else enterFullscreen();
}

function updateFullscreenButton() {
    const btn = document.getElementById('btn-fullscreen');
    if (!btn) return;
    const isFs = !!getFullscreenElement();
    btn.innerHTML = isFs ? '<i class="bi bi-fullscreen-exit"></i>' : '<i class="bi bi-arrows-fullscreen"></i>';
    btn.title = isFs ? 'Exit full screen' : 'Toggle full screen';
}

['fullscreenchange', 'webkitfullscreenchange', 'msfullscreenchange'].forEach(evt => {
    document.addEventListener(evt, updateFullscreenButton);
});

// =====================================
// PROGRESS TRACKER
// =====================================
function updateProgressStepper(stage) {
    const totalStages = 5;
    const fill = document.getElementById('progressFill');
    if (fill) fill.style.width = (((stage - 1) / (totalStages - 1)) * 100) + '%';

    document.querySelectorAll('.progress-step').forEach(el => {
        const s = parseInt(el.getAttribute('data-step'), 10);
        el.classList.remove('active', 'completed');
        if (s < stage) el.classList.add('completed');
        else if (s === stage) el.classList.add('active');
    });
}

// Validation messages per language.
// Previously `profile`/`cc`/`sqd` each spelled out every field/question by
// name ("Client Type, Sex, Age, Date, Region, Office Visited, and Service
// Availed" / "CC1, CC2, and CC3" / "SQD0 to SQD8") inside the popup itself —
// exactly the "giant list of everything you forgot" behavior this was
// changed to remove. There is now ONE shared generic alert
// (requiredIncomplete) for every stage; which field/question was actually
// missed is instead shown ON THE PAGE, at the field itself (see
// markLeafInvalid/markGroupInvalid below) — the user finds out what they
// missed from the form, not from the alert text.
//
// The alert does carry HOW MANY were missed (see buildIncompleteAlert) —
// that is a single number, not the list this was changed to remove, and
// without it someone who skipped four SQD questions couldn't tell they had
// four left rather than one.
const validationMessages = {
    en: {
        terms: "Please check the box to agree to the Terms & Conditions and Privacy Policy before proceeding.",
        requiredIncomplete: "Please complete the required information before proceeding.",
        fieldRequired: "This field is required.",
        answerRequired: "Please select an answer.",
        // {n} is substituted with the count. Still no list of WHICH ones —
        // that stays on the page, at each question.
        countTitleOne: "1 item left",
        countTitleMany: "{n} items left",
        answersMissingOne: "1 question has not been answered yet. It is marked below — answer it to continue.",
        answersMissingMany: "{n} questions have not been answered yet. They are marked below — answer them to continue.",
        fieldsMissingOne: "1 required field is still empty. It is marked below — fill it in to continue.",
        fieldsMissingMany: "{n} required fields are still empty. They are marked below — fill them in to continue."
    },
    tl: {
        terms: "Paki-check ang kahon para sumang-ayon sa Terms & Conditions at Privacy Policy bago magpatuloy.",
        requiredIncomplete: "Pakikumpleto ang mga kinakailangang impormasyon bago magpatuloy.",
        fieldRequired: "Kinakailangan ang impormasyong ito.",
        answerRequired: "Pumili ng sagot.",
        countTitleOne: "1 ang natitira",
        countTitleMany: "{n} ang natitira",
        answersMissingOne: "May 1 tanong na hindi pa nasasagutan. Nakamarka ito sa ibaba — sagutan ito para makatuloy.",
        answersMissingMany: "May {n} tanong na hindi pa nasasagutan. Nakamarka ang mga ito sa ibaba — sagutan ang mga ito para makatuloy.",
        fieldsMissingOne: "May 1 kinakailangang impormasyon na wala pang laman. Nakamarka ito sa ibaba — punan ito para makatuloy.",
        fieldsMissingMany: "May {n} kinakailangang impormasyon na wala pang laman. Nakamarka ang mga ito sa ibaba — punan ang mga ito para makatuloy."
    }
};

// Builds the count-carrying alert for a failed stage. The COUNT is the point:
// skipping 3 or 4 SQD questions used to produce the same one sentence as
// skipping one, so the user had no way of knowing how many were left and had
// to hunt them down one at a time. The number goes in the title, where it
// reads at a glance next to the warning icon, with the sentence underneath.
// Which ones were missed still lives on the page at each question (the red
// border + "Please select an answer"), never as a list inside the popup.
// `kind` is 'answers' for question groups (CC/SQD) and 'fields' for the
// profile inputs, so the wording matches what the user is actually looking
// at. A count of 0 can't happen on this path, but falls back to the old
// generic sentence rather than saying "0 items left" if it ever did.
function buildIncompleteAlert(kind, count) {
    const t = validationMessages[currentLang] || validationMessages.en;
    const n = Math.max(0, count || 0);
    if (!n) return { title: undefined, text: t.requiredIncomplete };
    const many = n > 1;
    const title = (many ? t.countTitleMany : t.countTitleOne).replace('{n}', String(n));
    const key = kind === 'fields'
        ? (many ? 'fieldsMissingMany' : 'fieldsMissingOne')
        : (many ? 'answersMissingMany' : 'answersMissingOne');
    return { title: title, text: (t[key] || t.requiredIncomplete).replace('{n}', String(n)) };
}

// ---- Inline required-field marking ----
// Two shapes of "required thing" on this survey: a leaf control (text/select/
// date input — Bootstrap's own .is-invalid/.invalid-feedback, already loaded,
// reused as-is rather than inventing a parallel style), and a question GROUP
// with no single control to mark (gender/CC1-3/SQD0-8 are radio sets — the
// spec calls for marking the question's container, never individual radio
// options). Both clear themselves live via the single delegated listener
// below, so nothing has to be re-wired after SQD's renderSQD() rebuilds its
// radios on every language switch.
function markLeafInvalid(el, message) {
    if (!el) return;
    el.classList.add('is-invalid');
    el.setAttribute('aria-invalid', 'true');
    let feedback = el.nextElementSibling;
    if (!feedback || !feedback.classList.contains('invalid-feedback')) {
        feedback = document.createElement('div');
        feedback.className = 'invalid-feedback';
        feedback.id = 'err-' + (el.id || el.name || Math.random().toString(36).slice(2));
        el.insertAdjacentElement('afterend', feedback);
    }
    feedback.textContent = message;
    el.setAttribute('aria-describedby', feedback.id);
}
function clearLeafInvalid(el) {
    if (!el) return;
    el.classList.remove('is-invalid');
    el.removeAttribute('aria-invalid');
    el.removeAttribute('aria-describedby');
}
// `messageTarget` lets the visible warning line live somewhere valid inside
// `container` even when `container` itself can't directly hold a <div> (an
// SQD row is a <tr> — the message goes in its first <td> instead; see
// validateStage's stage-4 branch).
function markGroupInvalid(container, message, messageTarget) {
    if (!container) return;
    container.classList.add('answer-group-invalid');
    container.setAttribute('aria-invalid', 'true');
    const target = messageTarget || container;
    let msgEl = target.querySelector(':scope > .answer-group-msg');
    if (!msgEl) {
        msgEl = document.createElement('div');
        msgEl.className = 'answer-group-msg';
        target.appendChild(msgEl);
    }
    msgEl.textContent = message;
}
function clearGroupInvalid(container, messageTarget) {
    if (!container) return;
    container.classList.remove('answer-group-invalid');
    container.removeAttribute('aria-invalid');
    const target = messageTarget || container;
    const msgEl = target.querySelector(':scope > .answer-group-msg');
    if (msgEl) msgEl.remove();
}

// Scrolls/focuses the FIRST invalid field found (visual order), landing it
// clear of the sticky mobile header via scroll-margin-top on the invalid
// classes themselves (see the CSS). Only actual form controls get focus()
// — a question-group container (a <div>/<tr>) isn't a focusable control,
// scrolling it into view is enough per spec.
function scrollToInvalid(el) {
    if (!el) return;
    // Centering is right for a normal field, but a question block taller
    // than the viewport (CC1 with its five long options on a phone, an SQD
    // card in portrait) gets its TOP cut off when centred — which is the
    // half carrying the question text and the red "Please select an answer"
    // line. Anything over ~80% of the viewport is aligned to its top
    // instead, so the user lands on the question itself rather than on its
    // tail. scroll-margin-top on the invalid classes keeps either alignment
    // clear of the sticky header, on any screen size.
    let block = 'center';
    try {
        const h = el.getBoundingClientRect().height;
        const vh = window.innerHeight || document.documentElement.clientHeight || 0;
        if (vh && h > vh * 0.8) block = 'start';
    } catch (e) { /* keep 'center' */ }
    // behavior:'auto', not 'smooth'. A smooth scroll is still animating for
    // hundreds of ms after this returns, and any other programmatic scroll
    // in that window (the closing modal restoring its own position) cancels
    // it outright — which is exactly how the user ended up looking at the
    // bottom of the page instead of the question. An instant landing has no
    // such window: the page is on the field before anything else can run.
    el.scrollIntoView({ behavior: 'auto', block: block });
    focusInvalid(el);
}

// Focus has to land on the missed field too, not just the scroll position:
// with the alert's own focus-restore turned off (see reportStageInvalid),
// whatever gets focused here is where a keyboard user's next Tab, and a
// screen reader's cursor, resumes from. A form control takes focus
// directly. A question GROUP (a <div>/<tr> holding a radio set) isn't
// focusable on its own, so it's given tabindex="-1" — programmatically
// focusable, never reachable by tabbing, standard practice for exactly
// this. preventScroll everywhere, so focusing never fights the scroll above.
function focusInvalid(el) {
    if (!el || typeof el.focus !== 'function') return;
    if (el.tagName !== 'INPUT' && el.tagName !== 'SELECT' && el.tagName !== 'TEXTAREA') {
        if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
    }
    try { el.focus({ preventScroll: true }); } catch (e) { try { el.focus(); } catch (e2) {} }
}

// Holds the page on the missed field for a short window after the scroll.
// Closing a modal can move the scroll on its own — SweetAlert2 restores the
// body scroll position it saved when it opened (and its iOS body-fixed
// workaround does the same on iPhone/iPad), and either can land after our
// scroll. Re-asserting the position for ~700ms outlasts every one of those
// without the survey needing to know which engine, browser or device is in
// play. It gives up the moment the user scrolls, touches, or uses the
// keyboard — if they choose to look elsewhere, the page must not drag them
// back.
const REVEAL_HOLD_MS = 700;
function holdScrollOn(el) {
    if (!el || typeof requestAnimationFrame !== 'function') return;
    const start = Date.now();
    let cancelled = false;
    const cancel = () => {
        cancelled = true;
        ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((evt) => {
            window.removeEventListener(evt, cancel, { capture: true });
        });
    };
    ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach((evt) => {
        window.addEventListener(evt, cancel, { capture: true, passive: true });
    });
    // The position we landed on, as an offset from the top of the viewport.
    // Re-asserting against THIS (rather than against "is it still on screen
    // somewhere") is what catches a restore that scrolls the page only part
    // of a screen — enough to leave the user staring at the tail of the
    // question instead of the question, while the element technically stayed
    // in view. Any drift past a few pixels is put straight back.
    // Captured synchronously, not on the first animation frame: a scroll
    // restore landing in between would otherwise be recorded AS the anchor,
    // and the hold would then faithfully hold the wrong position. Callers
    // run this immediately after scrollToInvalid, so "now" is the position
    // we actually want.
    let anchorTop = null;
    try { anchorTop = el.getBoundingClientRect().top; } catch (e) { anchorTop = null; }
    const DRIFT_PX = 8;
    const tick = () => {
        if (cancelled) return;
        if (Date.now() - start > REVEAL_HOLD_MS) { cancel(); return; }
        try {
            const rect = el.getBoundingClientRect();
            if (anchorTop === null) {
                anchorTop = rect.top;
            } else if (Math.abs(rect.top - anchorTop) > DRIFT_PX) {
                const vh = window.innerHeight || document.documentElement.clientHeight || 0;
                el.scrollIntoView({ behavior: 'auto', block: (vh && rect.height > vh * 0.8) ? 'start' : 'center' });
            }
        } catch (e) { cancel(); return; }
        requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
}

// Shakes EVERY still-unanswered field (not just the first), so one glance
// down the stage shows all of them. The class is removed and re-added after
// a forced reflow so a second failed "Next" re-runs the animation instead of
// doing nothing because the class is already on the element.
const SHAKE_CLASS = 'validation-shake';
const SHAKE_MS = 700; // covers the longer reduced-motion pulse too

// Picks what actually moves, per element, on whatever device is running:
// a <tr> laid out as a real table-row can't be transformed reliably, so its
// cells move; the SAME <tr> as a display:block card (narrow screens) moves
// as one piece, because that card is overflow:hidden and would clip cells
// sliding around inside it. Asking for the computed display means phones,
// tablets, desktops, landscape/portrait flips, browser zoom and split-screen
// windows all get the right target without this code knowing any breakpoint.
// getComputedStyle can throw / return null on a detached node, so it falls
// back to shaking the element itself.
function shakeTargets(el) {
    if (!el || el.tagName !== 'TR') return [el];
    let display = '';
    try {
        const cs = window.getComputedStyle(el);
        display = cs ? cs.display : '';
    } catch (e) { display = ''; }
    if (display === 'table-row' || display === 'table-row-group') {
        // el.children (not a :scope selector) — the cells are always direct
        // children, and this works on the older Android WebViews some
        // clients fill this survey in on.
        const cells = Array.prototype.filter.call(el.children, (c) => c.tagName === 'TD' || c.tagName === 'TH');
        if (cells.length) return cells;
    }
    return [el];
}

function shakeInvalid(elements) {
    (elements || []).forEach((el) => {
        if (!el || !el.classList) return;
        shakeTargets(el).forEach((target) => {
            if (!target || !target.classList) return;
            target.classList.remove(SHAKE_CLASS);
            void target.offsetWidth;
            target.classList.add(SHAKE_CLASS);
            setTimeout(() => target.classList.remove(SHAKE_CLASS), SHAKE_MS + 60);
        });
    });
}

// The single path every stage takes when it fails validation: show the alert,
// and only once the user has acknowledged it (OK/dismiss/Esc alike — hence
// both promise branches) scroll to the first missed field and shake them all.
// The shake trails the scroll slightly so the field isn't already moving as
// it arrives. If AppAlert can't hand back a promise (no SweetAlert, native-
// alert fallback), the reveal still runs — it just runs immediately.
function reportStageInvalid(message, firstInvalid, invalidEls, title) {
    // The promise can settle while the popup is still animating out, and
    // its teardown (body scroll restore, iOS body-fixed undo, focus
    // handling) runs after that. Waiting a frame plus the close animation
    // means this scroll is the LAST one to run, rather than the first of
    // several; holdScrollOn then covers anything that still slips through.
    const reveal = () => {
        const run = () => {
            scrollToInvalid(firstInvalid);
            holdScrollOn(firstInvalid);
            setTimeout(() => shakeInvalid(invalidEls), 160);
        };
        if (typeof requestAnimationFrame === 'function') {
            requestAnimationFrame(() => setTimeout(run, 160));
        } else {
            setTimeout(run, 180);
        }
    };
    let result;
    try {
        // returnFocus:false — otherwise the alert hands focus back to the
        // "Next" button that opened it, and focusing a button at the bottom
        // of the stage scrolls the page down to it, dropping the user past
        // the question they actually missed. AppAlert honours this on both
        // of its engines (SweetAlert2 online, the dependency-free fallback
        // offline), so the behavior is identical either way; focus is moved
        // onto the missed field by focusInvalid() instead.
        // `title` undefined keeps AppAlert's own default ("Warning"); the
        // count-carrying stages pass their own ("3 items left").
        result = AppAlert.warning(message, title, { returnFocus: false });
    } catch (e) { result = null; }
    if (result && typeof result.then === 'function') result.then(reveal, reveal);
    else reveal();
}

const REQUIRED_STAGE2_SELECTORS = [
    'select[name="client_type"]',
    'select[name="gender"]',
    'select[name="age"]',
    'input[name="survey_date"]',
    'input[name="office_visited_time"]',
    'select[name="region"]',
    'select[name="office_id"]',
    'select[name="service_availed"]'
];

// Delegated (not per-control) so it keeps working after SQD's renderSQD()
// tears down and rebuilds every radio on a language switch, and after the
// office/service selects get repopulated — nothing here needs re-attaching.
(function initValidationClearing() {
    const form = document.getElementById('surveyForm');
    if (!form) return;
    const clearLeafIfFilled = (el) => {
        if (REQUIRED_STAGE2_SELECTORS.some(sel => el.matches(sel)) && el.value && el.value.trim()) {
            clearLeafInvalid(el);
        }
    };
    form.addEventListener('input', (e) => { if (e.target.matches) clearLeafIfFilled(e.target); });
    form.addEventListener('change', (e) => {
        const el = e.target;
        if (!el.matches) return;
        clearLeafIfFilled(el);
        if (el.matches('input[name="cc1"], input[name="cc2"], input[name="cc3"]')) {
            clearGroupInvalid(el.closest('.qa-block'));
        }
        const sqdMatch = /^sqd(\d)$/.exec(el.name || '');
        if (sqdMatch) {
            const row = el.closest('tr');
            clearGroupInvalid(row, row ? row.querySelector('td.text-start') : null);
        }
        if (el.id === 'agreeTermsStage1' && el.checked) {
            clearLeafInvalid(el);
        }
    });

    // Client Profile's own name input lives outside #surveyForm (a different
    // app-view entirely), so it needs its own tiny listener rather than
    // relying on the delegation above.
    const pfNameInput = document.getElementById('pf-name-input');
    if (pfNameInput) {
        pfNameInput.addEventListener('input', () => {
            if (pfNameInput.value.trim()) clearLeafInvalid(pfNameInput);
        });
    }
})();

// Validates the fields belonging to a given stage. Returns true if the stage
// is complete. `scroll` (default true) is set to false by submitAll()'s
// pre-submit sweep, which may be checking a stage that ISN'T the currently
// visible one — scrolling into a hidden page does nothing, so that caller
// navigates to the stage first, then re-validates (with scroll) once it's
// actually on screen.
function validateStage(stageNum, scroll) {
    if (scroll === undefined) scroll = true;
    const t = validationMessages[currentLang] || validationMessages.en;

    if (stageNum === 1) {
        const terms = document.getElementById('agreeTermsStage1');
        if (!terms || !terms.checked) {
            markLeafInvalid(terms, t.terms);
            // Gated on `scroll` for the same reason as stages 2-4: submitAll()'s
            // silent detection pass (scroll=false) must not raise this before
            // its own second, post-navigate call does — one failure, one alert.
            if (scroll) {
                reportStageInvalid(t.terms, terms, [terms]);
            }
            return false;
        }
        clearLeafInvalid(terms);
        return true;
    }

    if (stageNum === 2) {
        let firstInvalid = null;
        const invalidEls = [];
        REQUIRED_STAGE2_SELECTORS.forEach((sel) => {
            const el = document.querySelector(sel);
            if (!el || !el.value || !el.value.trim()) {
                markLeafInvalid(el, t.fieldRequired);
                if (el) invalidEls.push(el);
                if (!firstInvalid) firstInvalid = el;
            } else {
                clearLeafInvalid(el);
            }
        });
        if (firstInvalid) {
            // Gated on `scroll` too (not just used to conditionally scroll):
            // submitAll()'s silent detection pass over a stage that isn't
            // currently visible would otherwise show this generic alert
            // once, then show it AGAIN when it re-validates the same stage
            // (with scroll) right after navigating to it — one real
            // validation failure must produce exactly one alert.
            if (scroll) {
                const a = buildIncompleteAlert('fields', invalidEls.length);
                reportStageInvalid(a.text, firstInvalid, invalidEls, a.title);
            }
            return false;
        }
        return true;
    }

    if (stageNum === 3) {
        let firstInvalid = null;
        const invalidEls = [];
        for (const name of ['cc1', 'cc2', 'cc3']) {
            const anyOption = document.querySelector(`input[name="${name}"]`);
            const block = anyOption ? anyOption.closest('.qa-block') : null;
            if (!document.querySelector(`input[name="${name}"]:checked`)) {
                markGroupInvalid(block, t.answerRequired);
                if (block) invalidEls.push(block);
                if (!firstInvalid) firstInvalid = block;
            } else {
                clearGroupInvalid(block);
            }
        }
        if (firstInvalid) {
            // Gated on `scroll` too (not just used to conditionally scroll):
            // submitAll()'s silent detection pass over a stage that isn't
            // currently visible would otherwise show this generic alert
            // once, then show it AGAIN when it re-validates the same stage
            // (with scroll) right after navigating to it — one real
            // validation failure must produce exactly one alert.
            if (scroll) {
                const a = buildIncompleteAlert('answers', invalidEls.length);
                reportStageInvalid(a.text, firstInvalid, invalidEls, a.title);
            }
            return false;
        }
        return true;
    }

    if (stageNum === 4) {
        let firstInvalid = null;
        const invalidEls = [];
        for (let i = 0; i <= 8; i++) {
            const anyOption = document.querySelector(`input[name="sqd${i}"]`);
            const row = anyOption ? anyOption.closest('tr') : null;
            const msgTarget = row ? row.querySelector('td.text-start') : null;
            if (!document.querySelector(`input[name="sqd${i}"]:checked`)) {
                markGroupInvalid(row, t.answerRequired, msgTarget);
                if (row) invalidEls.push(row);
                if (!firstInvalid) firstInvalid = row;
            } else {
                clearGroupInvalid(row, msgTarget);
            }
        }
        if (firstInvalid) {
            // Gated on `scroll` too (not just used to conditionally scroll):
            // submitAll()'s silent detection pass over a stage that isn't
            // currently visible would otherwise show this generic alert
            // once, then show it AGAIN when it re-validates the same stage
            // (with scroll) right after navigating to it — one real
            // validation failure must produce exactly one alert.
            if (scroll) {
                const a = buildIncompleteAlert('answers', invalidEls.length);
                reportStageInvalid(a.text, firstInvalid, invalidEls, a.title);
            }
            return false;
        }
        return true;
    }

    return true;
}

// Navigation Function — validates the current stage before allowing forward movement
// =====================================
// SMART EDIT — Stage 5 "Edit" jumps straight to a stage; that stage's "Next"
// button then turns into "Save & Return to Review" and jumps straight back,
// bypassing whatever intermediate stages sit between them.
// =====================================
let editReturnTarget = null;

// New short label only — does NOT touch the protected i18n dictionary above/below.
const UX_LABELS = {
    en: { save_return: 'Save & Return to Review' },
    tl: { save_return: 'I-save at Bumalik sa Review' }
};

function goEditStage(stage) {
    editReturnTarget = 5;
    navigate(stage);
}

// Used by the Stage 2/3/4 "Next" buttons. Normal flow: goes to normalTarget.
// If the user got here via an Edit link from Stage 5: goes straight back to
// Stage 5 instead, and clears the flag so the button reverts to normal next time.
function goNext(normalTarget) {
    if (editReturnTarget) {
        const target = editReturnTarget;
        editReturnTarget = null;
        navigate(target);
    } else {
        navigate(normalTarget);
    }
}

function updateNextButtonLabel(stage) {
    const btnIds = { 2: 'btnNextStage2', 3: 'btnNextStage3', 4: 'btnNextStage4' };
    const btn = document.getElementById(btnIds[stage]);
    if (!btn) return;

    if (editReturnTarget) {
        const label = (UX_LABELS[currentLang] || UX_LABELS.en).save_return;
        btn.innerHTML = '<i class="bi bi-arrow-return-left me-1"></i> ' + label;
    } else {
        btn.innerHTML = '<span data-i18n="btn_next"></span>';
        const span = btn.querySelector('[data-i18n]');
        if (span && i18n[currentLang] && i18n[currentLang].btn_next) span.textContent = i18n[currentLang].btn_next;
    }
}

function navigate(stage) {
    const activePage = document.querySelector('#surveyForm .page.active');
    const currentStage = activePage ? parseInt(activePage.id.replace('stage', ''), 10) : null;

    if (currentStage && stage > currentStage) {
        if (!validateStage(currentStage)) return;
    }

    // Entering Stage 2 (Profile) is the natural "survey has started" moment —
    // request full screen here so it fires whether the user clicked
    // START SURVEY or arrived via any other path that calls navigate(2).
    if (stage === 2) enterFullscreen();

    // From Stage 2 onward the survey drops its boxed/contained card look and
    // goes edge-to-edge — sidebar tucked away — so it reads as a full-screen
    // form instead of content sitting inside a small rectangle. Stage 1
    // (Terms) keeps the centered hero-card presentation.
    const shell = document.querySelector('.app-shell');
    if (shell) shell.classList.toggle('survey-inprogress', stage >= 2);
    // setSidebarCollapsed is the desktop-only persistent collapse (see its own
    // comment) — applying it below 992px stacks .sidebar-collapsed on top of
    // the mobile show/hide overlay mechanism, and .app-shell.sidebar-collapsed
    // .sidebar's higher specificity permanently wins over .sidebar.show, so
    // the hamburger toggle looked like it stopped working (backdrop appears,
    // panel never slides in) for the rest of the survey. Desktop only.
    if (stage >= 2 && window.innerWidth >= 992) setSidebarCollapsed(true);

    // Entering the Review stage — rebuild the summary from whatever is
    // currently in the form so "Edit" + coming back always reflects the latest answers.
    if (stage === 5) renderReviewSummary();

    const direction = currentStage && stage < currentStage ? 'dir-back' : 'dir-fwd';

    document.querySelectorAll('.page').forEach(page => page.classList.remove('active', 'dir-fwd', 'dir-back'));
    const targetPage = document.getElementById('stage' + stage);
    targetPage.classList.add('active', direction);

    updateProgressStepper(stage);
    updateNextButtonLabel(stage);
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Stage changes are an explicit "meaningful progress" moment (item 6) —
    // saved immediately rather than waiting for the debounce, so a stage
    // change followed immediately by a refresh/offline event never loses
    // the transition itself. No-ops on OFFLINE_MODE/no session/no progress.
    if (typeof autosaveActiveSurveyDraftNow === 'function') autosaveActiveSurveyDraftNow();
}

